oto.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9687689"}, {"article_id": "9684672", "title": "日職／林安可手感正好卻受傷 西武死守A段班傷兵潮來得不是時候", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/31/34815827.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684672"}]}, {"name": "最新文章", "articles": [{"article_id": "9696707", "title": "棒球／42年前洛杉磯奧運老國手亮相 林華韋對新一代國手有話說", "summary": "攸關2028年洛杉磯奧運棒球賽門票的兩大國際賽，包括明年世界12強賽預、複賽，以及奧運最終資格賽都將在台北市進行，1984年洛杉磯奧運銅牌多名國手今天出席記者會，喚起不少老球迷的回憶，中華棒球協會副理事長林華韋說：「希望有機會再去現場看球。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237862.jpg&M=1&s=Y&x=0&y=0&sw=1230&sh=820&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:57", "link": "/news/story/7001/9696707"}, {"article_id": "9696660", "title": "TPBL／徵選近三百人報名 戰神啦啦隊公告4名新成員加入", "summary": "台新育樂今宣布台北台新戰神啦啦隊Taishin Wonders迎來四位新成員，本屆徵選吸引近三百人報名，僅25人挺進決選，最終由具職籃啦啦隊經歷的芭蕾女孩小馨、歷經兩年培訓轉為正式成員的Momo，以及擁有 17年舞齡、曾擔任王心凌演唱會舞者的小樂Ｍ與選秀節目舞蹈組冠軍Josh脫穎而出，四人將發揮不同舞蹈與表演專長，為新賽季帶來更多元的舞台演出。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237763.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:34", "link": "/news/story/7003/9696660"}, {"article_id": "9696647", "title": "棒球／中華隊12強賽若進奧運 棒協證實6搶1資格賽仍在北市", "summary": "中華棒球協會獲得明年世界12強賽預賽、複賽，以及後年奧運最終資格賽主辦權，都將在台北市進行比賽，今天舉行兩大國際賽舉辦權發布記者會，棒協秘書長林宗成表示，中華隊若在12強賽就取得後年洛杉磯奧運參賽權，奧運資格賽仍會在北市進行，這是和世界棒壘球總會談好的條件。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237745.jpg&M=1&s=Y&x=0&y=0&sw=1247&sh=831&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:30", "link": "/news/story/7001/9696647"}, {"article_id": "9696640", "title": "匹克球／林志穎任賽事大使 AEPL亞洲菁英聯盟月底開戰", "summary": "匹克球成為全球人氣極高的運動，亞洲菁英匹克球聯盟（Asia Elite Pickleball League，簡稱AEPL）5月宣告正式成立，今天在台北車站多功能展演空間舉辦創始賽季賽前記者會，知名藝人林志穎也現身擔任賽事大使，號召全民一起拿起球拍感受這項新興運動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237734.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:27", "link": "/news/story/7005/9696640"}, {"article_id": "9696586", "title": "NBA／坦言未打電話召募詹皇 康寧漢：他應該不想聽我說什麼", "summary": "NBA巨星詹姆斯（LeBron James）今夏自由市場動向掀起全聯盟熱潮，不少球隊與球員都親自出面招募這名「41歲老漢」。不過，對於詹姆斯是否可能加盟底特律，活塞當家球星康寧漢（Cade Cunningham）坦言，自己其實沒有太關注這件事，更沒有打電話試圖說服詹姆斯來到汽車城。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237674.jpg&M=1&s=Y&x=46&y=49&sw=1088&sh=725&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:08", "link": "/news/story/7002/9696586"}, {"article_id": "9696545", "title": "棒球／中華隊挑戰衛冕明年12強賽搶奧運資格 蔣萬安透露大巨蛋10場比賽", "summary": "中華棒球隊挑戰2028年洛杉磯奧運，攸關參賽門票的兩項賽事，包括明年世界12強賽預、複賽，以及奧運最終資格賽都將在台北市舉辦，亞洲棒球總會會長、世界棒壘球總會（WBSC）副會長辜仲諒說：「感謝WBSC排除萬難，以及相關團隊共同努力，讓我們好不容易爭取到這個機會。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237624.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-17 14:46", "link": "/news/story/7001/9696545"}, {"article_id": "9696463", "title": "MLB／明星賽後狂挨11轟成警訊！ 道奇左投羅布勒斯基手臂發炎進傷兵名單", "summary": "道奇26歲左投羅布勒斯基因前臂發炎進傷兵名單；明星賽後近26局挨11轟、防禦率6.92，後續定位可能轉往牛棚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237479.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 14:33", "link": "/news/story/6999/9696463"}, {"article_id": "9696387", "title": "中職／兄弟重砲許基宏動刀修復右膝半月板 手術成功IG報平安", "summary": "中信兄弟主砲許基宏因右膝半月板破損接受關節鏡修復手術，17日透過IG報平安，表示手術順利，將積極復健盼重返球場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237344.jpg&M=1&s=Y&x=0&y=241&sw=1108&sh=739&exp=3600&sl=W&fw=360", "date": "2026-08-17 13:50", "link": "/news/story/7001/9696387"}, {"article_id": "9696336", "title": "NBA／杜蘭特選MVP勝過冠軍戒 直言「人人都想成為MVP」", "summary": "NBA超級球星杜蘭特（Kevin Durant）職業生涯成就豐富，不僅曾兩度贏得總冠軍和FMVP，也獲得過年度MVP、奧運金牌等榮耀。不過，當被問到總冠軍戒指與MVP獎項哪一項更有價值時，杜蘭特卻是毫不猶豫選擇了MVP。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237264.jpg&M=1&s=Y&x=0&y=29&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-17 13:28", "link": "/news/story/7002/9696336"}, {"article_id": "9696338", "title": "NBA／當對手之前先合體 詹姆斯和里夫斯高球場揮桿", "summary": "「小皇帝」詹姆斯（LeBron James）雖離開湖人隊，和前隊友關係仍密切，他在夏天最後的假期尾聲和里夫斯（Austin Reaves）及兒子布朗尼（Bronny James）合體，三人一起在高球場揮桿。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237279.jpg&M=1&s=Y&x=0&y=96&sw=1199&sh=799&exp=3600&sl=W&fw=360", "date": "2026-08-17 13:25", "link": "/news/story/7002/9696338"}, {"article_id": "9696264", "title": "NBA／初生之犢不畏虎 勇士首輪新秀嗆：我要狠狠修理「惡棍狄龍」", "summary": "勇士首輪新秀倫德伯格直播放話，要在新球季對決太陽布魯克斯時「狠狠修理他」；他夏聯率隊奪冠，兩隊首度交手預計10月24日登場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:56", "link": "/news/story/7002/9696264"}, {"article_id": "9696059", "title": "中職／陳鏞基生涯最終台東場賽事 獅隊雄鷹合作送紀念明信片", "summary": "中職統一7-ELEVEn獅隊本週客場到台東與台鋼雄鷹交手，也是43歲老將陳鏞基職棒球員生涯最後一次台東場出賽，19日獅隊...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237095.jpg&M=1&s=Y&x=0&y=64&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:33", "link": "/news/story/7001/9696059"}, {"article_id": "9696178", "title": "MLB／挽救生涯的TJ手術 從黃平洋到「不死鳥」數十名台灣選手走過重建路", "summary": "大聯盟傳奇左投湯米約翰享壽83歲辭世；他1974年接受首例TJ手術，影響投手生涯，也讓黃平洋、郭泓志等數十名台灣球員走過韌帶重建路。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237123.jpg&M=1&s=Y&x=13&y=46&sw=1253&sh=807&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:25", "link": "/news/story/7001/9696178"}, {"article_id": "9696184", "title": "NBA／2029名人堂眾星璀璨 保羅、衛少、羅瑞三大控衛有望攜手入選", "summary": "2029年奈史密斯籃球名人堂（Naismith Basketball Hall of Fame）可能迎來一場令人難忘的「控衛大團聚」，曾在2010年代共同定義NBA控衛版圖的3大名將衛斯特布魯克（Russell Westbrook）、保羅（Chris Paul）與羅瑞（Kyle Lowry），有望在同一年攜手踏入籃球最高殿堂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237076.jpg&M=1&s=Y&x=0&y=14&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:24", "link": "/news/story/7002/9696184"}, {"article_id": "9696191", "title": "排球／U17世青賽奪第四平隊史最佳 中華隊教頭肯定球員成長", "summary": "中華隊今天迎接2026年世界U17女子排球錦標賽最終日賽程，銅牌戰和中國隊的對決中，中華隊首局在「丟士」中先下一城，可惜後三局沒能再追加局數，終場以28：26、15：25、19：25、22：25錯過登上頒獎台的機會，以追平上屆的隊史最佳第四名作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237068.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:21", "link": "/news/story/7005/9696191"}, {"article_id": "9696058", "title": "高球／LPGA波特蘭菁英賽最終回合 徐薇淩繳71桿並列第51", "summary": "台灣女子職業高爾夫好手徐薇淩，今天在LPGA波特蘭菁英賽最終回合抓4博蒂、吞3柏忌繳出71桿，以4天低於標準6桿的282...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236911.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 11:41", "link": "/news/story/7005/9696058"}, {"article_id": "9696032", "title": "MiLB／「費仔」轟再見兩分砲 林昱珉對決5局好投無關勝敗", "summary": "美國職棒小聯盟3A響尾蛇隊台灣好手林昱珉今天先發投5局失2分、無關勝敗，與水手隊陣中台美混血好手費爾柴德對決2打席、投出1...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236873.jpg&M=1&s=Y&x=0&y=0&sw=1131&sh=754&exp=3600&sl=W&fw=360", "date": "2026-08-17 11:34", "link": "/news/story/6999/9696032"}, {"article_id": "9696006", "title": "MLB／道奇不想掉入外卡系列賽 教頭批評近況不振失去水準", "summary": "道奇隊今天在主場又以2：6不敵釀酒人隊，打完4連戰只拿1勝，美國媒體ESPN指出，道奇總教練羅伯茲（Dave Roberts）賽後批評球隊近期的低迷表現，這場失利導致爭奪季後賽主場優勢處於劣勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236789.jpg&M=1&s=Y&x=7&y=1&sw=1145&sh=763&exp=3600&sl=W&fw=360", "date": "2026-08-17 11:15", "link": "/news/story/6999/9696006"}, {"article_id": "9696011", "title": "NBA／冠軍戒、婚戒皆到手！唐斯辦婚禮 尼克隊友、「甜茶」都來了", "summary": "尼克隊中鋒唐斯（Karl-Anthony Towns）不只可以戴上NBA冠軍戒，今年夏天還多了一枚戒指，他和伴侶伍茲（Jordyn Woods）上周末在加州海濱城市馬里布（Malibu）完婚，唐斯的冠軍隊友哈特（Josh Hart）、布朗森（Jalen Brunson）、阿努諾比（OG Anunoby）、艾爾瓦拉多（Jose Alvarado）和麥克布萊德（Miles McBride）都親自出席，婚宴還有專著規範，賓客都穿上黑色服裝出席。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236805.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 11:12", "link": "/news/story/7002/9696011"}, {"article_id": "9695981", "title": "藤球／全國排名賽檢視場地 為來年全運會暖身", "summary": "115年第二次全國藤球排名賽昨天（16日）在屏東縣佳冬高農落幕。由於明年全國運動會將由屏東縣主辦，藤球也首次選辦進競賽項目，本次排名賽特別選在曾於113年全民運承辦藤球賽事的佳冬高農舉行，除了能檢視選手的競技表現，也透過實際辦賽提前為全運會暖身。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236752.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 11:00", "link": "/news/story/7005/9695981"}, {"article_id": "9695935", "title": "MLB／前一晚壓制大谷、自由人 釀酒人火球男賽前無私指點佐佐木朗希", "summary": "釀酒人火球男米蕭洛斯基賽前現身道奇陣營，無私指點佐佐木朗希，友好互動引發外界關注；他前役壓制大谷翔平與弗里曼，助隊擊敗道奇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236683.jpg&M=1&s=Y&x=83&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-17 10:54", "link": "/news/story/6999/9695935"}, {"article_id": "9695869", "title": "MLB／韓德森投贏史庫柏創罕見紀錄 釀酒人官網慶幸沒和老虎交易", "summary": "釀酒人隊24歲右投韓德森（Logan Henderson）今天主宰戰場，對道奇隊先發7局失1分，優質表現領軍6：2獲勝，4連戰帶著3勝離開洛杉磯；釀酒人官網指出，為期17天、共打17場比賽的魔鬼賽程畫下句點，在此期間取得10勝7敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236557.jpg&M=1&s=Y&x=0&y=12&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 10:46", "link": "/news/story/6999/9695869"}, {"article_id": "9695933", "title": "自行車／百位車友「騎見光復」 徐行縱谷深度走入濕地、森林與部落", "summary": "為持續推廣花東縱谷自行車旅遊，交通部觀光署花東縱谷國家風景區管理處15日於花蓮光復舉辦「2026徐行縱谷－騎見光復」自行車活動，吸引超過百位民眾熱情參與，其中更有20多位來自光復國小與光復國中在地學生加入騎行行列。參與車友不僅來自光復及花東地區，更有許多民眾特別從台灣各地前來，以自行車穿梭光復的濕地、森林、糖業文化與部落聚落，深度感受花東縱谷豐富而多元的自然與人文魅力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://