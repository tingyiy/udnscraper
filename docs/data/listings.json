s://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174679.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9653800"}, {"article_id": "9651858", "title": "中職／挖東牆補西牆 樂天桃猿犧牲洋投換雙洋砲政策潛藏風險", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171748.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9651858"}, {"article_id": "9651873", "title": "日本／藤川球兒都難以辦到 栗林良吏轉型後更華麗", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171765.jpg&M=1&s=Y&x=0&y=49&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9651873"}, {"article_id": "9650499", "title": "詹姆斯決定4.0「關鍵密碼」 選擇76人拚冠才是生涯首次抱團 ！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35169863.jpg&M=1&s=Y&x=0&y=67&sw=1096&sh=731&exp=3600&w=300", "link": "/news/story/122629/9650499"}, {"article_id": "9646736", "title": "把明星賽變成「趣味競賽」沒問題 那就把規則訂清楚吧！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164366.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9646736"}]}, {"name": "最新文章", "articles": [{"article_id": "9656362", "title": "中職／打6年最不穩定的1季 非典型李凱威卡在失投球掌握", "summary": "長年以穩定著稱的味全龍隊「低調人」李凱威，本季挑戰連續球季百安進度出現小難關，儘管逐月狀態都在往上走，但他也直言感受到今年的自己沒有那麼穩定，在打擊上還有一些小細節，自己還在持續尋找解答。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178339.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 18:10", "link": "/news/story/7001/9656362"}, {"article_id": "9656329", "title": "NBA／錯過詹姆斯後轉向德羅展！ 傳熱火、金塊、騎士3隊都想搶", "summary": "根據報導，6屆全明星前鋒德羅展（DeMar DeRozan）在遭國王釋出後，已吸引熱火、金塊與騎士追求。這3支球隊都在自由市場錯過詹姆斯（LeBron James）後，將德羅展視為能補強進攻火力的重要老將選項。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178307.jpg&M=1&s=Y&x=0&y=24&sw=1245&sh=829&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:59", "link": "/news/story/7002/9656329"}, {"article_id": "9656305", "title": "NBA／傳鵜鶘要求3首輪+潛力戰將 勇士追求墨菲遭「獅子大開口」", "summary": "金州勇士幾個月來持續對紐奧良鵜鶘側翼墨菲（Trey Murphy III）有興趣，但多次提出報價都遭拒絕。根據《ClutchPoints》記者席格爾（Brett Siegel）報導，勇士最近曾向鵜鶘開出2個首輪選秀權，希望換來墨菲，但鵜鶘仍不願接受。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178272.jpg&M=1&s=Y&x=40&y=62&sw=1142&sh=761&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:47", "link": "/news/story/7002/9656305"}, {"article_id": "9656303", "title": "中職／陽岱鋼21年職棒生涯未駐足台灣 葉總點選秀制度是卻步原因", "summary": "旅日傳奇球星陽岱鋼昨天拋出引退消息，選手生涯確定沒有中華職棒這一站，味全龍隊總教練葉君璋今天被問到陽岱鋼引退一事，提出觀點，直言現行選秀制度是這些頂尖旅外對中職卻步的原因，在制度上應該可以有更好的修正。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178359.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:45", "link": "/news/story/7001/9656303"}, {"article_id": "9656258", "title": "中職／祝福表哥引退快樂 張奕也好奇陽岱鋼下一階段計畫", "summary": "旅日傳奇台將陽岱鋼確定本季打完告別選手生涯，效力富邦悍將隊的表弟張奕對此表達祝福，回想自己當初追隨他的腳步跨向日本挑戰，他說：「有這樣的緣分，才有現在的自己。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178223.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:30", "link": "/news/story/7001/9656258"}, {"article_id": "9656257", "title": "中職／威戈神扣掉挨轟都不錯 後藤光尊指出觀察點：室外球場表現", "summary": "富邦悍將隊洋投威戈神前天繳出6局失2分優質先發，於昨天降下二軍，除非有人將要註銷，否則本周仍是3位洋投作戰。對於降下威戈神的原因，總教練後藤光尊表示，是希望每個洋投都可以在狀況好的時候輪替上來。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178222.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:30", "link": "/news/story/7001/9656257"}, {"article_id": "9656043", "title": "渣男！3小時同地前後約會兩女友 澳洲球星被傳交往400女人", "summary": "澳洲橄欖球明星史密斯被指控在同一地點3小時內先後約會兩名女性，引發熱烈討論。女友在Tiktok上爆料，聲稱他同時交往多達400名女子。對此，史密斯則未做正面回應，引發網友熱議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177939.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:25", "link": "/news/story/7005/9656043"}, {"article_id": "9656215", "title": "NBA／詹姆斯烏龍加盟熱火事件 原因曝光竟是員工休假前先備稿", "summary": "詹姆斯（LeBron James）最終選擇加盟費城76人，但邁阿密熱火先前卻曾一度在官方YouTube頻道上出現「詹姆斯加盟記者會」直播頁面，引發外界誤以為熱火提前洩漏詹姆斯回歸消息。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178170.jpg&M=1&s=Y&x=55&y=0&sw=1172&sh=782&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:11", "link": "/news/story/7002/9656215"}, {"article_id": "9656220", "title": "中職／下半季為何變「貧打邦」？光總有超犀利見解", "summary": "富邦悍將隊上半季的神勇戰績，目前並未複製在下半季，遭團隊打擊拖累，打擊率0.194居末位，總教練後藤光尊對此有獨到見解，坦言過去悍將打到這個階段排名大多已無競爭力，選手在全力以赴後的能力或許還沒那麼好。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178169.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:11", "link": "/news/story/7001/9656220"}, {"article_id": "9656195", "title": "NBA／湖人新援效仿曼巴精神 要苦練「百萬顆三分」輔佐唐西奇", "summary": "洛杉磯湖人今年休賽季目標明確，就是在詹姆斯（LeBron James）離開後圍繞超級球星唐西奇（Luka Doncic）重建陣容，除了續留里夫斯（Austin Reaves）外，更要補進可靠的禁區門神。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178094.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 17:02", "link": "/news/story/7002/9656195"}, {"article_id": "9656180", "title": "NBA／勇士24歲後衛「戒糖果」求健康 有望補上袋棍球巨星離隊空缺", "summary": "勇士隊24歲控衛克萊耶（L.J. Cryer）上賽季傷勢不斷，他透露新賽季為了保持身體健康，戒掉糖果和調整睡眠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178072.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 16:51", "link": "/news/story/7002/9656180"}, {"article_id": "9656147", "title": "MLB／30秒就消失的證據！ESPN記者深夜神秘接頭 揭開大谷翔平事件真相", "summary": "大谷翔平遭前翻譯水原一平盜用近1700萬美元案，再度掀起討論。《ESPN》即將推出全新《30 for 30》六集節目《大谷翔平的背叛》，首次完整還原這起震驚全美的事件調查過程，並曝光《ESPN》調查記者湯普森（Tisha Thompson）如何在深夜停車場與神秘消息人士接頭，取得首批將大谷銀行帳戶與非法簽賭集團連結在一起的關鍵證據。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178044.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 16:46", "link": "/news/story/6999/9656147"}, {"article_id": "9656115", "title": "MLB／紅襪新援首秀掛彩！米德慘遭球吻難掩失望：希望不會有太大問題", "summary": "紅襪隊昨日把台灣好手鄭宗哲下放3A，向國民交易來澳洲工具人米德（Curtis Mead）加強打線火力，不過他今日披上紅襪戰袍的首場比賽就因觸身球提前退場，讓球隊再添傷兵隱憂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177997.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 16:46", "link": "/news/story/6999/9656115"}, {"article_id": "9656126", "title": "MLB／李灝宇連12場敲安是現存最長紀錄 老虎教頭談交易大限", "summary": "台灣好手李灝宇今天再度擊出安打，連續12場是目前大聯盟現存最長紀錄。不過老虎隊終場以5：8輸給金鶯隊，苦吞3連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178021.jpg&M=1&s=Y&x=0&y=255&sw=1083&sh=723&exp=3600&sl=W&fw=360", "date": "2026-07-28 16:34", "link": "/news/story/6999/9656126"}, {"article_id": "9656108", "title": "MLB／聽了起雞皮疙瘩！ESPN公開水原冒充大谷匯款恐怖錄音", "summary": "洛杉磯道奇二刀流球星大谷翔平，遭前翻譯水原一平盜用近1700萬美元案再度掀起討論。《ESPN》即將推出的《30 for 30》節目《大谷翔平的背叛》更首度公開一段關鍵錄音，內容正是水原一平冒充大谷本人，致電美國銀行授權匯款的過程，聽了令人細思極恐、雞皮疙瘩。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177982.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 16:28", "link": "/news/story/6999/9656108"}, {"article_id": "9656078", "title": "TPBL／匈牙利全能長人 洛斯柯從日職轉戰海神", "summary": "高雄全家海神隊今天宣布簽下匈牙利裔的美籍禁區大將洛斯柯（Rosco Allen），身高208公分，曾是匈牙利國家隊成員，主打4、5號位置，同時擁有西班牙、日本職籃經驗，在日本B聯盟更累積8年資歷；洛斯柯表示，已迫不及待加入海神，期待與團隊及神隊友在港都相見。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177934.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-28 16:06", "link": "/news/story/7003/9656078"}, {"article_id": "9656066", "title": "中職／無緣登上明星賽投手丘 郭泓志說明原因、自嘲是「愛心卡」", "summary": "今年中華職棒明星賽上演「傳奇卡」橋段，許多傳奇球星上場比賽，但「不死鳥」郭泓志無緣登板投球，他也在個人YouTube頻道上說明原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177925.jpg&M=1&s=Y&x=303&y=76&sw=721&sh=481&exp=3600&sl=W&fw=360", "date": "2026-07-28 16:05", "link": "/news/story/7001/9656066"}, {"article_id": "9655929", "title": "世足賽／曾用垃圾袋當窗簾！卡布拉爾勇奪世界盃「最佳進球」母親激動落淚昏倒", "summary": "國際足總今日公布2026年世界盃「最佳進球」得主，最終由維德角後衛卡布拉爾（Sidny Lopes Cabral）在對阿根廷一役轟出的世界波獲選，而這位3年前還在德國第五級聯賽打拚的23歲球員，也完成了足球生涯最勵志的逆襲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177757.jpg&M=1&s=Y&x=0&y=132&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 15:18", "link": "/news/story/123107/9655929"}, {"article_id": "9655917", "title": "世足賽／維德角再寫奇蹟！窮小子打敗名將梅西、姆巴佩獲本屆「最佳進球」", "summary": "維德角在2026年首次世界盃之旅再添歷史性一頁，國際足總今日正式公布，維德角後衛卡布拉爾（Sidny Lopes Cabral）憑藉對阿根廷一役轟出的驚天世界波，獲選為2026年世界盃「最佳進球」得主，成為本屆賽事最令人難忘的經典畫面之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177750.jpg&M=1&s=Y&x=0&y=0&sw=1243&sh=829&exp=3600&sl=W&fw=360", "date": "2026-07-28 15:17", "link": "/news/story/123107/9655917"}, {"article_id": "9655937", "title": "MLB／朴贊浩領軍「Team61」入股運動家 BTS成員也參與投資", "summary": "前大聯盟韓國投手朴贊浩領軍的投資團隊「Team61」宣布，將投入7000萬美元（約新台幣22.7億元）取得運動家隊部分股權，成為大聯盟史上首度具韓國資本背景的球團投資案。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177736.jpg&M=1&s=Y&x=0&y=16&sw=1256&sh=837&exp=3600&sl=W&fw=360", "date": "2026-07-28 15:16", "link": "/news/story/6999/9655937"}, {"article_id": "9655919", "title": "MLB／控球又暴走只投0.2局就退場 今井達也：還是非常不甘心", "summary": "太空人隊日籍右投今井達也又控球大暴走，0.2局投出4保送就被換下場，太空人最終在9局上狂攻5分，終場以6：4逆轉擊敗天使隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177712.jpg&M=1&s=Y&x=602&y=0&sw=678&sh=452&exp=3600&sl=W&fw=360", "date": "2026-07-28 15:07", "link": "/news/story/6999/9655919"}, {"article_id": "9655729", "title": "MLB／小熊季後賽功臣遭DFA 隊友不捨告別：合作過最棒的隊友", "summary": "隨著小熊先發投手泰隆（Jameson Taillon）本季表現持續低迷，球團今天正式宣布將他指定讓渡（DFA），結束雙方近3年的合作。小熊總教練康索（Craig Counsell）也在賽前受訪時坦言，這是一個相當艱難的決定。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177392.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 14:47", "link": "/news/story/6999/9655729"}, {"article_id": "9655816", "title": "NBA／詹姆斯效應引爆76人熱度 全美轉播場次將暴增、票價也飆漲", "summary": "詹姆斯（LeBron James）正式簽約76人不僅視帶來戰力上的大幅升級，將奪冠希望拉抬到高點，就經營層面來說，詹皇的到來更是立刻改變76人的市場熱度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177571.jpg&M=1&s=Y&x=2&y=0&sw=1273&sh=849&exp=3600&sl=W&fw=360", "date": "2026-07-28 14:42", "link": "/news/story/7002/9655816"}, {"article_id": "9655814", "title": "NBA／灌籃王拉文來台！交流賽會雲豹球員", "summary": "「2026桃園珍珠海岸國際音樂節」將於8月1日起一連兩天在桃園竹圍漁港盛大登場，曾兩度奪下NBA灌籃大賽冠軍的飛人級球星拉文（Zach LaVine）將來台參與，出席結合音樂節舉辦的「國際職籃球星交流賽」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35177517.jpg&M=1&s=Y&x=0&y=494&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 14:25", "link": "/news/story/7003/9655814"}]}, {"name": "棒球", "articles": [{"article_id": "9656220", "title": "中職／下半季為何變「貧打邦」？光總有超犀利見解", "date": "2026-07-28 17:11", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178169.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9656220"}, {"article_id": "9655105", "title": "中職／蔡其昌拜訪大聯盟主席 MLB海外賽、ABS運作全都聊", "date": "2026-07-28 10:29", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35176314.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9655105"}, {"article_id": "9656362", "title": "中職／打6年最不穩定的1季 非典型李凱威卡在失投球掌握", "date": "2026-07-28 18:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178339.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9656362"}, {"article