": [{"article_id": "9816842", "title": "中職／史上首度龍象爭霸 年度第五兄弟能奪冠創歷史新紀錄？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35423690.jpg&M=1&s=Y&x=39&y=0&sw=1241&sh=827&exp=3600&w=300", "link": "/news/story/122629/9816842"}, {"article_id": "9817674", "title": "有扳倒西區列強能力！「范喬丹」回歸補齊漏洞 新火箭快速升空", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427797.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9817674"}, {"article_id": "9814666", "title": "釀酒人鐵牛棚成道奇最大噩夢 五大主將共組季後賽後援天團", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35420333.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9814666"}, {"article_id": "9814618", "title": "棒球／鄭乃介接任高苑教頭首重態度 完成父親未竟之夢", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35420223.jpg&M=1&s=Y&x=0&y=106&sw=1169&sh=779&exp=3600&w=300", "link": "/news/story/122629/9814618"}, {"article_id": "9812748", "title": "中職／味全洋投優勢難展現 中信兄弟有望再度以下剋上", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35417319.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9812748"}, {"article_id": "9812765", "title": "MLB先發投手重要性逐漸式微？現代棒球投打價值天秤正在失衡", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35417351.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9812765"}]}, {"name": "最新文章", "articles": [{"article_id": "9821721", "title": "NBA／選秀狀元還沒開季就扭傷腳踝 巫師教頭謹慎面對", "summary": "備受期待的NBA選秀狀元迪班薩（AJ Dybantsa），昨天熱身賽碰鵜鶘隊時卻因腳踝受傷提前退場，巫師教頭基夫（Brian Keefe）透露傷勢不嚴重，謹慎以對下讓狀元郎先休息，接續會再評估迪班薩狀況。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430962.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 10:10", "link": "/news/story/7002/9821721"}, {"article_id": "9821720", "title": "MLB／釀酒人休7天是史上第2長 官網：近年相關數據明顯不利", "summary": "釀酒人隊前天在國聯冠軍賽第4戰淘汰道奇隊，暌違44年重返世界大賽，還在等待守護者、光芒隊的贏家，大聯盟官網引用過去16年數字，率先鎖定聯盟冠軍的球隊，共有12次輸掉世界大賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430961.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 10:08", "link": "/news/story/6999/9821720"}, {"article_id": "9821701", "title": "橫跨3世代登頒獎台！中華隊世界快艇衝浪賽勇奪3金2銅 部長李洋親發賀電鼓勵", "summary": "2026年IWWF世界快艇衝浪錦標賽10月12日至17日在中國杭州湘湖舉行，中華代表隊傳出捷報，13名選手參加9個組別、14個項次的競爭，最終奪下3金2銅、共5面獎牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430941.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 09:59", "link": "/news/story/7005/9821701"}, {"article_id": "9821680", "title": "中職／獅獅變龍象 梅賽鍶、菲力士前隊友同場過招今拚G2", "summary": "中職總冠軍賽今晚上演第二戰，開門紅的味全龍隊挑戰2連勝，中信兄弟隊力拚扳平戰線，兩隊推出去年都在統一獅隊的洋投梅賽鍶、菲力士同場交鋒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430874.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 09:42", "link": "/news/story/7001/9821680"}, {"article_id": "9821656", "title": "MLB／大谷翔平帶傷敲30轟還被扣分 美媒無情評分「F」質疑傷勢管理", "summary": "道奇隊賽季慘痛落幕，在國聯冠軍賽4戰不敵釀酒人隊，「加州郵報」為陣中打者逐一打分，給予大谷翔平是無情的「F」，關鍵在於健康管理失當，認為若擁有健康的大谷，道奇的賽季可能呈現不同樣貌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430847.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-18 09:21", "link": "/news/story/6999/9821656"}, {"article_id": "9821638", "title": "羽球／提早佈局國際賽！台灣小將勇奪首面世青賽男雙金牌", "summary": "台灣小將在埃及開羅舉行的世界青年羽球錦標賽（BWF World Junior Championships）寫下羽壇新頁，來自中租大同的李威霆／陳秉軒，昨天男雙決賽以15：10、15：9拍下日本組合奧真尋／山城政人，以一局不失的完美表現登頂，摘下台灣史上第一面世青男雙金牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430811.jpg&M=1&s=Y&x=0&y=509&sw=1110&sh=740&exp=3600&sl=W&fw=360", "date": "2026-10-18 09:04", "link": "/news/story/7005/9821638"}, {"article_id": "9821475", "title": "運動人生／趙豐邦 開創撞球黃金年代", "summary": "扭轉撞球是「壞囝仔」在玩的刻板印象，是世界撞球冠軍趙豐邦最大的貢獻，也造就了「漂亮寶貝」陳純甄、「阿美」柳信美、「泰山小子」吳珈慶、「撞球之子」楊清順等球星。\n\n趙豐邦說，世界第一很好，但他更在乎的是台灣撞球到底能不能有更長遠的未來？", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430520.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-18 00:00", "link": "/news/story/7005/9821475"}, {"article_id": "9821479", "title": "運動人生／難忘「神仙打架」 那局球無人能重現", "summary": "「二○○一年『冠中冠』邀請賽冠軍戰，到現在我閉上眼睛都還能重播一次。」趙豐邦回憶，那場球，他每一桿出手前都默念著「我是趙豐邦，我一定要把球打進去。」最終總算如願。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430524.jpg&M=1&s=Y&x=0&y=0&sw=1206&sh=804&exp=3600&sl=W&fw=360", "date": "2026-10-18 00:00", "link": "/news/story/7005/9821479"}, {"article_id": "9821480", "title": "運動人生／改革選拔 趙豐邦期待2030亞運契機", "summary": "「台灣不是沒有好選手，而是量不夠多，近兩年歐洲崛起許多實力強大的選手，競爭越來越激烈」。中華民國撞球總會會長趙豐邦憂心撞球人才斷層，他認為後起之秀除了需要天分，更需要長時間訓練並累積國際參賽經驗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430876.jpg&M=1&s=Y&x=12&y=0&sw=1268&sh=845&exp=3600&sl=W&fw=360", "date": "2026-10-18 00:00", "link": "/news/story/7005/9821480"}, {"article_id": "9821393", "title": "全民運爭議 桃市抗議金牌遭沒收", "summary": "二○二六全民運動會昨在桃園巨蛋開幕，但部分賽事已先進行。桃園代表隊在男子四百公尺水面蹼泳接力拿下第一名，但頒獎前夕被取消名次，現場譁然。桃園市體育局昨表達不滿，強調選手沒有違規，反倒是大會審判過程不透明，將爭取選手權益。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430452.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-18 00:00", "link": "/news/story/7005/9821393"}, {"article_id": "9821346", "title": "2026全民運動會聖火點燃 1.3萬人齊聚桃園競技交流", "summary": "2026全民運動會今晚在桃園巨蛋開幕，本屆賽事以「全民運動，桃戰巔峰」為主軸，不僅是國內非亞奧運動項目的最高層級賽事，更是推廣全民運動的重要盛會。為期五天賽程將有1.3萬名選手齊聚競技，精采程度可期，總統賴清德、行政院長卓榮泰與桃園市長張善政都出席活動，預祝選手奪得佳績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430414.jpg&M=1&s=Y&x=100&y=0&sw=1079&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-17 22:37", "link": "/news/story/7005/9821346"}, {"article_id": "9821333", "title": "中職／台灣大賽G2兩隊續由洋投先發 龍派梅賽鍶、兄弟派菲力士", "summary": "中職總冠軍賽（台灣大賽）味全龍今天以3比0搶下首勝，明天第2戰兩隊繼續派出洋投先發，龍隊梅賽鍶先發盼延續勝場，兄弟派出菲...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430395.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 22:29", "link": "/news/story/7001/9821333"}, {"article_id": "9821331", "title": "中職／兄弟台灣大賽G1吞敗盼有學習 平野勉：帶著不甘心續拚", "summary": "中職中信兄弟今天台灣大賽首戰以0比3不敵味全龍，總教練平野惠一表示，無論攻守、對手都有很多值得學習的地方，輸球也一定要拿...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430393.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 22:25", "link": "/news/story/7001/9821331"}, {"article_id": "9821270", "title": "中職／外野象迷喊聲太震撼 張政禹：感覺有風往我後面來", "summary": "中職總冠軍賽「龍象大戰」首戰，味全龍隊在台北大巨蛋4萬人滿場的局面下，以3：0完封中信兄弟奪下首勝。中信兄弟雖是客場，但球迷將外野染成黃潮，連龍隊內野手張政禹都直呼，「他們喊聲的時候，感覺有風往我後面來。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430307.jpg&M=1&s=Y&x=0&y=107&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:50", "link": "/news/story/7001/9821270"}, {"article_id": "9821263", "title": "中職／「換掉我是很棒的調度」 蔣銲未挑戰完封笑答：讓終結者有事做", "summary": "味全龍隊王牌蔣銲真的超悍！今天面對中信兄弟隊繳出8局無失分好投，幫助龍隊以3：0收下總冠軍賽首戰勝利。賽後被問到第九局是否想過挑戰完封，他說相信教練團的決定，更笑答：「你不能讓我們的終結者只是坐在下面，他總得有點事情做。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430298.jpg&M=1&s=Y&x=1&y=161&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:44", "link": "/news/story/7001/9821263"}, {"article_id": "9821255", "title": "TPBL／沃許本被擊中太陽穴傷退成轉機 洪志善讚肯刀爾像年輕曼尼高", "summary": "新北國王今天在TPBL新賽季開幕戰，於開賽被對手打出10：0攻勢，還發生洋將沃許本被打中太陽穴，疑似腦震盪送醫的情況下，最終卻在延長賽成功逆轉擊敗地主福爾摩沙夢想家，總教練洪志善賽後也稱讚拿下全場最高33分的洋將肯刀爾，就像是年輕版的曼尼高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430276.jpg&M=1&s=Y&x=1&y=208&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:36", "link": "/news/story/7003/9821255"}, {"article_id": "9821247", "title": "中職／龍隊不見休兵12天生疏感 葉總：找業餘霸主比賽效果不錯", "summary": "味全龍隊在台灣大賽旗開得勝，今天以3：0擊敗中信兄弟隊，不見休兵12天的生澀感，總教練葉君璋坦言自己一開始也是擔心，「但今天看起來是還不錯，大家很像有進入狀況。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430268.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:30", "link": "/news/story/7001/9821247"}, {"article_id": "9821245", "title": "中職／勝騎士被朱育賢纏鬥10球敲安成關鍵 平野稱龍隊打出「好範本」", "summary": "中信兄弟今天在總冠軍賽首戰對上味全龍隊，攻勢完全遭封鎖，全場僅2支安打，以0：3遭完封，總教練平野惠一認為，勝騎士在第5局被攻破，也是最關鍵的原因，並稱讚龍隊打者能用各種方式上壘，「打出很好的範本」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430262.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:27", "link": "/news/story/7001/9821245"}, {"article_id": "9821242", "title": "中職／陳子豪敲關鍵安喊每次第一場都好緊張 葉總早已嗅到他會發威", "summary": "台灣大賽首次上演龍象爭冠，身披過兩隊球衣的陳子豪，在首戰就有關鍵貢獻，第五局以二壘打幫助味全龍隊先馳得點，在龍隊3：0擊敗中信兄弟隊賽後，總教練葉君璋也透露，早在例行賽的最後10幾天，就很期待看到陳子豪在今年總冠軍賽會有表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430241.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:24", "link": "/news/story/7001/9821242"}, {"article_id": "9821238", "title": "TPVL／開幕戰天鷹漢佳尬前東家拿25分搶鏡 難擋連莊穩紮穩打奪開門紅", "summary": "台灣職業排球聯盟今天正式展開新賽季，開幕戰在元年冠軍，台鋼天鷹的主場鳳山體育館進行，而這場比賽的對手，是上個賽季例行賽的王者台中連莊，天鷹新援漢佳面對前東家個人表現精彩，拿下全場最高25分，然而天鷹的團隊失誤較多，讓連莊整場比賽都處於優勢，最終是連莊25：21、25：17、24：26、25：22，總局數3：1新賽季旗開得勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430287.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:14", "link": "/news/story/7005/9821238"}, {"article_id": "9821236", "title": "中職／總冠軍賽初登場攻守立功 林辰勳評蔣銲表現100分、自己70分", "summary": "味全龍隊今天在總冠軍賽首戰以3：0完封中信兄弟，捕手林辰勳扛起首戰先發蹲捕重任，攻、守端都有貢獻，賽後他替龍隊先發投手蔣銲8局無失分的表現打下「100分」滿分的評價，對自己則是給了70分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430230.jpg&M=1&s=Y&x=0&y=232&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:11", "link": "/news/story/7001/9821236"}, {"article_id": "9821232", "title": "圖輯／中職冠軍賽首戰 味全龍3：0獲勝", "summary": "中職總冠軍賽第一場今天在大巨蛋登場，雙方前四局並未有得分，五局下味全龍朱育賢擊出一壘安打，隨後陳子豪擊出二壘安打，攻佔二三壘，接著靠著林辰勳、劉俊緯連續兩隻高飛犧牲打攻下兩分，六局下劉基鴻也敲出一發帶有一分打點的安打，最後味全龍以3：0獲勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430217.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 20:03", "link": "/news/story/7001/9821232"}, {"article_id": "9821227", "title": "TPBL／高柏鎧犯滿、霍爾曼扭傷 夢想家衛冕之路首戰就踢鐵板", "summary": "TPBL新賽季開幕戰今天在台中洲際迷你蛋點燃戰火，並由上賽季冠軍賽對戰組合福爾摩沙夢想家出戰新北國王，賽前升起隊史首面冠軍錦旗的夢想家，儘管上半場一度領先到雙位數，但下半場國王團隊火力全開逆轉戰局，並在延長賽以112：106成功踢館，拿下新賽季首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430207.jpg&M=1&s=Y&x=0&y=0&sw=1167&sh=778&exp=3600&sl=W&fw=360", "date": "2026-10-17 19:59", "link": "/news/story/7003/9821227"}, {"article_id": "9821185", "title": "中職／兄弟亞軍訊號出現…僅敲2安打遭完封 締造隊史G1最慘紀錄", "summary": "中信兄弟隊去年在總冠軍賽全面潰敗，今年捲土重來，首戰又有失意開局，以0：3遭到味全龍隊完封，對兄弟來說有如泥淖，因為隊史過去7次在台灣大賽首戰吞敗，結局全數都是亞軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/17/35430148.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-17 19:28", "link": "/news/story/7001/9821185"}]}, {"name": "棒球", "articles": [{"article_id": "9821680", "title": "中職／獅獅變龍象 梅賽鍶、菲力士前隊友同場過招今拚G2", "date": "2026-10-18 09:42", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35430874.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9821680"}, {"article_id": "9821247", "title": "中職／龍隊不見休兵12天生疏感 葉總：找業餘霸主比賽效果不錯", "date": "2026-10-17 20:30", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.c