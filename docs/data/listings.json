oto.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35106681.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9608248"}, {"article_id": "9608223", "title": "世足攻略／英格蘭對抗地主魔鬼高原 凱恩有望再扮致勝功臣", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35106655.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9608223"}, {"article_id": "9608218", "title": "世足攻略／哈蘭德挑戰森巴軍團 挪威歷史對戰沒輸過有爆冷可能", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35106646.jpg&M=1&s=Y&x=20&y=59&sw=1101&sh=733&exp=3600&w=300", "link": "/news/story/122629/9608218"}]}, {"name": "最新文章", "articles": [{"article_id": "9611222", "title": "NBA／美媒：八村壘加盟快艇 同意2年8.9億元合約", "summary": "美國多家媒體今天報導，日本前鋒八村壘（Rui Hachimura）已同意與美國職籃NBA洛杉磯快艇簽下2年2800萬美元...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/07/35110957.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-07 03:21", "link": "/news/story/7002/9611222"}, {"article_id": "9611203", "title": "世足賽／美國前鋒吞紅牌仍可上場 比利時足協提異議", "summary": "比利時足球協會今天表示，已對美國前鋒巴洛根（Folarin Balogun）獲准參加與比利時的世界盃足球賽16強賽提出異...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/07/35110890.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-07 01:46", "link": "/news/story/123107/9611203"}, {"article_id": "9611189", "title": "世足賽／原本不知紅牌是什麼…川普談美前鋒免禁賽：裁判當初判罰很糟糕", "summary": "2026年世界盃足球賽正在美加墨三國火熱開踢，紐約時報5日引述三名知情人士透露，美國總統川普7月1日致電國際足球總會主席英凡提諾，要求重審美國隊前鋒巴洛根的紅牌處分，隨後國際足總5日罕見暫緩禁賽令，巴洛根獲准出戰6日對戰比利時的16強賽事。英國天空新聞報導，川普6日談論巴洛根暫緩競賽令，稱他認為裁判的判罰很糟，他原本不知道紅牌是什麼，了解過後認為裁判居然有權決定隊伍裡最棒的球員下周或下一場比賽無法上場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/07/35110842.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-07 00:37", "link": "/news/story/123107/9611189"}, {"article_id": "9611024", "title": "世足賽／川普喬到巴洛根免禁賽 比利時：今天愚人節？", "summary": "加拿大、墨西哥在本屆世足賽十六強賽先後出局，最後一支地主隊美國今天將迎戰比利時。有媒體報導美國總統川普致電國際足球總會（ＦＩＦＡ）主席英凡提諾，要求重審美國主力前鋒巴洛根的紅牌處分，促使ＦＩＦＡ暫緩執行令，允許巴洛根對比利時之戰出賽，成為本屆賽事至今最大爭議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/07/35110779.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-07 00:04", "link": "/news/story/123107/9611024"}, {"article_id": "9611021", "title": "世足賽／英轟破墨不敗紀錄 突破「阿茲特克魔咒」", "summary": "英格蘭昨天在客場頂住龐大壓力，突破「阿茲特克魔咒」，世足賽十六強賽靠貝林漢「梅開二度」、凱恩十二碼罰球破網，終場以三比二擊敗墨西哥，連續三屆賽事闖進八強，也揮別四十年前不敵阿根廷傳奇球星馬拉度納「上帝之手」的夢魘。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110699.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-07 00:02", "link": "/news/story/123107/9611021"}, {"article_id": "9611013", "title": "世足賽／內馬爾流下英雄淚：我在這開始 也在這結束", "summary": "五度世界盃登頂笑傲群雄，「森巴軍團」巴西今年美加墨世界盃再被視為奪冠熱門，不料晉級路昨天就被挪威終結，一比二吞敗後十六強就淘汰，除寫下卅六年來最差成績，連六屆沒能奪冠也寫下隊史最長「冠軍荒」，賽後隊史進球王內馬爾直接跪地痛苦，用眼淚和最後一次國家隊告別。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/07/35110778.jpg&M=1&s=Y&x=0&y=225&sw=1013&sh=675&exp=3600&sl=W&fw=360", "date": "2026-07-07 00:01", "link": "/news/story/123107/9611013"}, {"article_id": "9611003", "title": "世足賽／哈蘭德獨進2球踢垮巴西 進球數追上梅西", "summary": "暌違廿八年重返世界盃的挪威，在超級球星「進球機器」哈蘭德領軍下不斷踢出驚奇，昨天十六強賽碰五度奪冠的「森巴軍團」巴西，哈蘭德下半場連中兩元，幾乎以一人之力撕裂巴西防線，率隊以二比一爆冷淘汰這支冠軍熱門軍。在挪威皇室見證下，隊史首度挺進世界盃最後八強，讓本屆賽會已有七顆進球的哈蘭德都感動落淚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110683.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-07 00:00", "link": "/news/story/123107/9611003"}, {"article_id": "9611016", "title": "煮茶論戰／球風不搭 森巴軍團失去靈魂", "summary": "巴西這次十六強輸給挪威，等於從二○○六年開始都無法奪冠，且連六屆都是敗給歐洲球隊。整體來看，巴西的困境並非單一選手和教練問題，從比賽的心態、傷病、人才結構的斷層和教練的打法的無法融合，造成最後結果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110749.jpg&M=1&s=Y&x=0&y=0&sw=1021&sh=681&exp=3600&sl=W&fw=360", "date": "2026-07-07 00:00", "link": "/news/story/122629/9611016"}, {"article_id": "9611056", "title": "世足賽／美前鋒紅牌免禁賽 川普：我親自要FIFA主席重審 不覺得有犯規", "summary": "美國總統川普6日表示，他親自要求國際足總（FIFA）主席英凡提諾（Gianni Infantino），重新審查對美國隊明星前鋒巴洛根（Folarin Balogun）被判紅牌並禁賽一場的決定。這項非比尋常的介入，已在世界盃引發大量爭議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110712.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 23:04", "link": "/news/story/123107/9611056"}, {"article_id": "9610827", "title": "世界盃男籃／南韓逆轉日本攜手晉級 中華隊墊底淘汰", "summary": "2027年世界盃籃球賽亞洲區資格賽第三階段最終戰，中華隊今天錯失兩次晉級機會，先是下午關鍵戰以74：92敗給中國大陸隊，沒能自立晉級，晚上南韓隊又上演11分逆轉勝，以81：79扳倒龍頭日本隊，搭上晉級末班車，也讓中華隊世界盃旅程畫下句點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110517.jpg&M=1&s=Y&x=0&y=0&sw=1046&sh=697&exp=3600&sl=W&fw=360", "date": "2026-07-06 20:52", "link": "/news/story/7003/9610827"}, {"article_id": "9610809", "title": "溫網／寶島內戰 梁恩碩拍下謝淑薇勇闖8強", "summary": "溫布頓女雙4度奪冠的我國「一姊」謝淑薇，今天溫網女雙第三輪和上月剛在金恩盃當隊友的「小鋼炮」梁恩碩隔網對決，「寶島內戰」激戰超過2小時，列13種子的梁恩碩／日本青山修子頂住法網前冠軍的反撲，以6：3、4：6、6：2晉級8強，延續黑馬旅程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110510.jpg&M=1&s=Y&x=0&y=42&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 20:41", "link": "/news/story/124935/9610809"}, {"article_id": "9610791", "title": "世足賽／美國前鋒吞紅牌仍可上陣 歐洲足總批國際足總越紅線", "summary": "美國總統川普要求檢討美國隊前鋒巴洛根在世足前一戰吞下紅牌的處分後，國際足總暫緩執行巴洛根的禁賽。對此，歐洲足總砲轟國際足...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110467.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 20:29", "link": "/news/story/123107/9610791"}, {"article_id": "9610617", "title": "MLB／大谷明星賽球員票不敵史瓦伯 費城球迷得意：懂棒球的人都知道", "summary": "今年大聯盟明星賽指定打擊部門的球員間投票結果出爐，洛杉磯道奇球星大谷翔平雖然在球迷票選中拿下兩聯盟最高票，早早確定以先發身分出賽，但在球員間投票中，他以些微差距不敵費城費城人強打史瓦伯（Kyle Schwarber），引發美國球迷討論，費城球迷更對結果相當自豪。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110351.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 19:14", "link": "/news/story/6999/9610617"}, {"article_id": "9610558", "title": "韓職／為什麼王彥程可以！合照TWICE娜璉 田中將大表情符號笑翻網友", "summary": "效力韓職韓華鷹的台灣左投王彥程（Wang Yan-cheng）日前在客場出戰LG雙子時，意外迎來追星成功的夢幻時刻。身為TWICE粉絲「ONCE」的他，剛好遇到TWICE成員娜璉（Nayeon）擔任開球嘉賓，賽後把握機會與偶像合照，並在IG寫下「Twice&Once」，貼文一出立刻引發隊友與球迷熱烈討論。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110301.jpg&M=1&s=Y&x=0&y=0&sw=981&sh=654&exp=3600&sl=W&fw=360", "date": "2026-07-06 18:47", "link": "/news/story/7001/9610558"}, {"article_id": "9610510", "title": "日職／徐若熙傷勢狀況不樂觀？軟銀投教：我想應該是這樣", "summary": "效力軟銀鷹隊的台灣投手徐若熙，傷勢狀況未明，投手教練倉野信次今天坦言，目前還不是很清楚實際狀況，要等接下來的相關報告。被問到是否代表狀況不樂觀，他回應：「現在還沒辦法投球，我想應該就是這樣吧！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110233.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 18:12", "link": "/news/story/7001/9610510"}, {"article_id": "9610444", "title": "世足賽／哈蘭德裸上身被挪威公主抱抱秒害羞臉紅 對手巴西也來致意", "summary": "挪威在當家球星「魔人普烏」哈蘭德（Erling Haaland）梅開二度帶領下，以2：1擊敗5屆冠軍巴西，隊史首度闖進世界盃8強。這場勝利也讓人想起1998年世界盃小組賽挪威爆冷擊敗巴西的經典戰役，相隔28年後，挪威再度用震撼表現撼動世界足壇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110183.jpg&M=1&s=Y&x=39&y=0&sw=1148&sh=766&exp=3600&sl=W&fw=360", "date": "2026-07-06 18:06", "link": "/news/story/123107/9610444"}, {"article_id": "9610363", "title": "世足攻略／美國巴洛根獲「免死金牌」加地主優勢 有望逼平比利時", "summary": "美國在世足16強賽中面對實力強勁的比利時，雖然數據劣勢明顯，但主場優勢可能提升他們的士氣，逼平或小輸1球的機會仍在。美國主帥採用高強度逼搶戰術，巴洛根或成關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110051.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 17:32", "link": "/news/story/122629/9610363"}, {"article_id": "9610384", "title": "NBA／湖人傳不會續留八村壘 補強重心轉向庫明加、替補長人", "summary": "隨著詹姆斯（LeBron James）告別紫金軍團，湖人休賽季進入一個重整陣容的積極面，陸續補進了多名球員，不過近幾季的重要輪替球員八村壘（Rui Hachimura）卻是傳出不會回到陣中。根據報導指出，湖人已經告知八村壘，球隊下季將不會續留他。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110044.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 17:28", "link": "/news/story/7002/9610384"}, {"article_id": "9610389", "title": "影／李洋視察雲林匹克球場小露兩手 奧運名將英姿贏得滿場喝采", "summary": "雲林縣麥寮鄉北區缺乏球場，公所計畫利用台61線快速道路施厝段下方空地，活化為籃球場。運動部長李洋今天會勘並視察土庫鎮匹克球場，還下場以球會友小露兩手，允諾會全力協助推廣非競技的社區運動，提升國人健康。他表示，會全力協助地方提供更好的運動環境。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110038.png&M=1&s=Y&x=0&y=0&sw=1203&sh=802&exp=3600&sl=W&fw=360", "date": "2026-07-06 17:25", "link": "/news/story/7005/9610389"}, {"article_id": "9610320", "title": "世足攻略／伊比利半島內戰有著23歲之差雙星較量 看好西班牙小勝", "summary": "西班牙在世足16強中對決葡萄牙，預計將主導控球並以2：1小勝。西班牙防守穩定，傳控優勢明顯，歷史對戰稍占上風；而葡萄牙則依賴反擊和球星個人能力。中場控制與最後傳球效率將是關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35109959.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 17:00", "link": "/news/story/122629/9610320"}, {"article_id": "9610253", "title": "射箭／世界盃馬德里站登場 總教練盼為亞運做準備", "summary": "射箭世界盃西班牙馬德里站將於明天登場，中華代表隊派出包括亞運選手在內共男、女16名箭客出賽；總教練廖健男表示，希望藉由這...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35109909.jpg&M=1&s=Y&x=113&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-07-06 16:46", "link": "/news/story/7005/9610253"}, {"article_id": "9610255", "title": "世足運彩／亞馬爾強勢崛起力拚C羅最後一舞搶晉級 推西班牙不讓分", "summary": "西班牙在世足16強淘汰賽中，將面對宿敵葡萄牙，勝者晉級8強。西班牙目前保持全勝，防線零失球，葡萄牙則憑藉經驗與C羅的威脅不容小覷。此役關鍵在於兩隊的控球與進攻策略。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35109837.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 16:42", "link": "/news/story/123105/9610255"}, {"article_id": "9610178", "title": "世界盃男籃／半場落後26分 中華隊晉級關鍵戰18分不敵中國", "summary": "2027年世界盃籃球賽亞洲區資格賽第三階段最終戰，中華隊只要奪勝就能自立晉級，但碰中國隊幾乎全場落後，在上半場僅拿28分下一路苦追，林庭謙雖攻下全場最高28分，中華隊仍以74：92吞敗，想晉級只能寄望晚上日本隊擊敗南韓隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35109424.jpg&M=1&s=Y&x=59&y=0&sw=963&sh=642&exp=3600&sl=W&fw=360", "date": "2026-07-06 15:59", "link": "/news/story/7003/9610178"}, {"article_id": "9610129", "title": "世足賽／淘汰墨西哥終結主場0敗紀錄 英格蘭奪冠機率超越阿根廷", "summary": "英格蘭今天在世界盃16強靠著貝林漢（Jude Bellingham）梅開二度加上隊長凱恩（Harry Kane）12碼罰球挹注火力，最終以3：2在阿茲特克體育場艱難擊敗地主隊墨西哥。本屆世界盃英格蘭一路高歌猛進，在贏下這場被英媒稱為「隊史最偉大的比賽之一」後，球隊奪冠機率也正式超過上屆冠軍阿根廷成為第二名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35109619.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 15:38", "link": "/news/story/123107/9610129"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9611056", "title": "世足賽／美前鋒紅牌免禁賽 川普：我親自要FIFA主席重審 不覺得有犯規", "date": "2026-07-06 23:04", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35110712.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9611056"}, {"article_id": "9611189", "title": "世足賽／原本不知紅牌是什麼…川普談美前鋒免禁賽：裁判當初判罰很糟糕", "date": "2026-07-07 00:37", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/07/35110842.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9611189"}, {"article_id": "9609400", "title": "世足賽／貝林漢梅開二度創罕見紀錄 凱恩率英格蘭淘汰墨西哥再進8強", "date": "2026-07-06 11:15", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35108359.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/123107/9609400"}, {"article_id": "9608905", "title": "世足賽／森巴軍團擋不下哈蘭德！進球機器兩度破門率挪威2比1淘汰巴西", "date": "2026-07-06 06:05", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35107537.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/