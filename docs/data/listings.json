 "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224197.jpg&M=1&s=Y&x=0&y=142&sw=930&sh=620&exp=3600&w=300", "link": "/news/story/122629/9687416"}, {"article_id": "9687689", "title": "去年塞揚史肯斯本季大幅衰退 原來原因這麼多！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9687689"}, {"article_id": "9684672", "title": "日職／林安可手感正好卻受傷 西武死守A段班傷兵潮來得不是時候", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/31/34815827.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684672"}, {"article_id": "9685328", "title": "中職／全季排名戰局詭譎富邦還在線！831大限成突圍關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35219029.jpg&M=1&s=Y&x=0&y=0&sw=1107&sh=738&exp=3600&w=300", "link": "/news/story/122629/9685328"}]}, {"name": "最新文章", "articles": [{"article_id": "9692681", "title": "瓊斯盃／中華藍首秀飆24分 宋昕澔盼用拚勁帶動年輕球員", "summary": "瓊斯盃中華藍隊今年以年輕球員組成，並在首場比賽面對日本就陷入苦戰，在最多19分領先的情況下，卻在第四節一度遭到逆轉，不過最終仍是靠著首度入選中華藍隊的宋昕澔攻下24分並完成關鍵罰球，以4分差距險勝，賽後總教練圖奇也直言，球員都展現十足的積極性，但也因此導致失誤。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231686.jpg&M=1&s=Y&x=0&y=864&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-14 23:24", "link": "/news/story/7003/9692681"}, {"article_id": "9692576", "title": "中職／兄弟7：0大勝下半季衝上第3 賞雄鷹本季最長6連敗", "summary": "中信兄弟今天在台中洲際棒球場迎戰台鋼雄鷹，勝騎士先發7局無失分帶頭，與吳俊偉、曾品洋聯手以7：0完封台鋼雄鷹，對戰雄鷹5連勝，且近9場拿7勝，下半季戰績衝上第3；雄鷹則是苦吞近兩年最長6連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231604.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 22:46", "link": "/news/story/7001/9692576"}, {"article_id": "9692546", "title": "中職／劉俊緯敲再見安笑認自帶英雄命 葉總讚：真的很不容易", "summary": "味全龍隊本周連續3場賽事逆轉對手，今天在台北大巨蛋靠著劉俊緯在9局下敲出生涯首支再見安打，以2：1打下勝利，是否具備英雄命？劉俊緯賽後笑說：「我自己覺得我有一點，不管有沒有成功，至少先有站在上面的機會。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231565.jpg&M=1&s=Y&x=0&y=232&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 22:21", "link": "/news/story/7001/9692546"}, {"article_id": "9692538", "title": "瓊斯盃／宋昕澔豪取24分加關鍵罰球 中華藍4分險勝日本", "summary": "瓊斯盃男子組賽事今天在新莊體育館點燃戰火，地主中華藍隊在首戰遭遇日本，儘管首節就靠著陳將双火力全開一度取得15分領先，但後三節中華隊火力盡失，讓日本逐步縮小差距甚至逆轉戰局，但比賽最後階段靠著游艾喆與宋昕澔連續4罰俱中，以70：66險勝日本。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231545.jpg&M=1&s=Y&x=0&y=438&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 22:18", "link": "/news/story/7003/9692538"}, {"article_id": "9692527", "title": "中職／劉俊緯敲生涯首支再見安 龍隊再登下半季首位", "summary": "下半季龍頭之爭，樂天桃猿隊今天作客台北大巨蛋對上味全龍隊，洋投艾菩樂先發7局飆9K封鎖龍隊打線，但牛棚沒能守住球隊的1分領先；龍隊在8局下先將戰局扳平，9局下靠劉俊緯敲出生涯首支再見安打，以2：1勝出，收下3連勝，下半季戰績超越猿隊登上第一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231528.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 22:06", "link": "/news/story/7001/9692527"}, {"article_id": "9692475", "title": "中職／艾菩樂7局無失分退場 桃猿雙洋砲首度同場亮相", "summary": "樂天桃猿隊「雙洋砲」本季首次同場亮相，今天在台北大巨蛋對上味全龍隊之戰，洋砲威克擔任先發第3棒，而洋投艾璞樂投完7局收工後，第2名洋砲道威聖在8局上登場代打，擊出飛球出局，單場啟用3名洋將。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231469.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 21:24", "link": "/news/story/7001/9692475"}, {"article_id": "9692413", "title": "瓊斯盃／松山兩代最強高中生首度合作 高國豪、林現惟直呼開心", "summary": "瓊斯盃中華白隊今天在首日賽程遭遇美國加州大學爾灣分校，雖然最終以21分差距吞敗，但松山高中兩代「最強高中生」高國豪與林現惟今天分別有21分、7籃板與10分、3籃板進帳表現亮眼，談到這次中華白是兩人首次見面與合作，高國豪也大讚學弟林現惟的表現與天賦。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231403.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 20:41", "link": "/news/story/7003/9692413"}, {"article_id": "9692326", "title": "瓊斯盃／高國豪21分難越高牆 中華白首戰不敵加州大學爾灣分校", "summary": "瓊斯盃男子組賽事今天在新莊體育館點燃戰火，首日中華藍、白兩隊就相繼登場，其中中華白遭遇美國加州大學爾灣分校，儘管上半場還一度與對手拉鋸，但第三節美國一口氣拉開比分，最終以88：67擊敗中華白。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231279.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 19:34", "link": "/news/story/7003/9692326"}, {"article_id": "9692312", "title": "中職／賴威誠二軍好投球速飆破150 初登一軍盼「一直待到球季結束」", "summary": "樂天桃猿隊本周牛棚多添生力軍，20歲新秀投手賴威誠今年在二軍繳好投，球速飆到生涯新高的151公里，上周獲註冊，並在12日等到生涯首度升一軍的機會，有望在台北大巨蛋迎接生涯初登板。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231261.jpg&M=1&s=Y&x=0&y=0&sw=1246&sh=830&exp=3600&sl=W&fw=360", "date": "2026-08-14 19:23", "link": "/news/story/7001/9692312"}, {"article_id": "9692254", "title": "中職／梅賽鍶鼠蹊部不適降二軍 葉總：本土投手機會來了", "summary": "味全龍隊今起迎接和樂天桃猿隊的下半季的龍頭之爭，卻出現突發狀況，洋投梅賽鍶因鼠蹊部不適，今天被降二軍休息，加上昨天才降二軍的蔣銲，接下來15天將少一名洋投可用，總教練葉君璋笑說：「本土投手機會來了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231256.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 18:55", "link": "/news/story/7001/9692254"}, {"article_id": "9692237", "title": "桌球／WTT瑞典大滿貫 林昀儒、鄭怡靜不敵中國組合無緣爭冠", "summary": "WTT瑞典大滿貫賽混雙4強賽今天登場，我國組合林昀儒／鄭怡靜今天遭遇中國大陸強敵林詩棟／蒯曼，最終以5：11、5：11、9：11直落三敗下陣來，無緣爭冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231185.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 18:38", "link": "/news/story/7005/9692237"}, {"article_id": "9692205", "title": "中職／桃猿啟用「雙洋砲」下周排出4土投 曾總點名3人有機會先發", "summary": "樂天桃猿隊昨天將洋砲道威聖拉上一軍，今天碰上味全龍隊，準備正式啟用「雙洋砲」陣形，如此一來，下周先發輪值也將再拉上一名本土投手，總教練曾豪駒點名莊孟源、邱駿威、邱緯綸3人都有機會上一軍先發。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221230.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 18:14", "link": "/news/story/7001/9692205"}, {"article_id": "9692068", "title": "MiLB／百大新秀被道奇交易到老虎後27支1 引兩派球迷爭執", "summary": "老虎隊交易大限將王牌投手史庫柏（Tarik Skubal）送去道奇隊，換來百大新秀第28的霍普（Zyhir Hope）、第66的萊恩（River Ryan）和史密斯（Brady Smith）。這包的主菜霍普最近陷入打擊低潮，引起球迷討論。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230988.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 17:11", "link": "/news/story/6999/9692068"}, {"article_id": "9692034", "title": "NBA／湖人新老闆上任佩林卡恐遭撤換？名嘴點名「勇士4冠功臣」接班", "summary": "湖人在短短14個月內接連迎來經營權與球隊核心的大幅變動，在結束巴斯家族長達數十年掌舵後，如今又將以125億美元易主，並在詹姆斯離隊後正式邁入唐西奇時代。對此，知名球評史密斯（Stephen A. Smith）甚至直接預測，新老闆上任後可能撤換佩林卡（Rob Pelinka），並將目標鎖定昔日打造勇士王朝的前總管邁爾斯（Bob Myers）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230949.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 17:01", "link": "/news/story/7002/9692034"}, {"article_id": "9691911", "title": "亞運棒球／總教練安排上軟銀一軍卻受傷 張峻瑋是否參賽出現變數", "summary": "日職軟銀鷹隊20歲台灣火球男張峻瑋剛奪下二軍單月最佳投手，就傳出壞消息，因右手肘出現不適進入復健組，代表中華隊參加名古屋亞運恐產生變數。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230791.jpg&M=1&s=Y&x=206&y=70&sw=706&sh=471&exp=3600&sl=W&fw=360", "date": "2026-08-14 16:02", "link": "/news/story/124981/9691911"}, {"article_id": "9691895", "title": "日職／樂天金鷲戰績墊底 宋家豪睽暌違近2個月重返一軍", "summary": "日職樂天金鷲隊目前戰績排名太平洋聯盟墊底，今天將33歲牛棚投手宋家豪重新登錄一軍，是他相隔近2個月後重新回到一軍賽場，也成為目前日職一軍除了火腿隊投手孫易磊外的第二位台將。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230788.jpg&M=1&s=Y&x=315&y=152&sw=846&sh=564&exp=3600&sl=W&fw=360", "date": "2026-08-14 15:51", "link": "/news/story/7001/9691895"}, {"article_id": "9691805", "title": "MLB／小號一響噩夢登場！道奇總教練仍力挺22億「發球機」：給一些時間", "summary": "道奇休賽季砸下3年6900萬美元（約新台幣22億）簽下明星終結者迪亞茲（Edwin Díaz），原本期待熟悉的「小號聲」能成為9局勝利即將到手的象徵，沒想到如今每當小號聲響起，對道奇球迷而言，似乎反而逐漸變成「警報聲」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230624.jpg&M=1&s=Y&x=412&y=52&sw=820&sh=546&exp=3600&sl=W&fw=360", "date": "2026-08-14 15:25", "link": "/news/story/6999/9691805"}, {"article_id": "9691757", "title": "MLB／道奇球場全壘打王誕生！原紀錄保持人親眼見證孟西改寫歷史", "summary": "今日道奇與國聯龍頭釀酒人的對決中，35歲重砲孟西（Max Muncy）用一發極具戲劇性的全壘打，正式改寫道奇球場歷史，也讓原紀錄保持人卡洛斯（Eric Karros）坐在轉播席上，親眼見證自己的紀錄被超越。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230547.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 15:19", "link": "/news/story/6999/9691757"}, {"article_id": "9691795", "title": "排球／企業排球聯賽新軍成立 三福產業結合台灣體大加入戰局", "summary": "三福產業集團將與台灣體大合作， 進軍國內企業排球聯賽男子組賽事，成為新球季生力軍，球隊以台灣體大男排隊為班底，並以三福產業男子排球隊為名（SUNFORD Volleyball Team）加入今年球季的戰場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230593.jpg&M=1&s=Y&x=0&y=399&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-14 15:02", "link": "/news/story/7005/9691795"}, {"article_id": "9691786", "title": "籃網球／2026亞洲錦標賽 中華隊分組準決賽不敵泰國將爭第3名", "summary": "在香港舉行的2026亞洲籃網球錦錦標賽，今天進行盃組和盤組二個分組的準決賽，中華隊在盤組準決賽對上泰國，兩隊隊中都有一位身高超過190公分以上的主要射手，兩隊開賽籃下互飆得分，不過中華隊只在第一節打出不錯的氣勢，第二節後被拉開比數，終場泰國以65：42擊敗中華隊，晉級盤組冠軍戰，中華隊只能爭盤組第3。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230580.jpg&M=1&s=Y&x=1&y=417&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-14 15:01", "link": "/news/story/7005/9691786"}, {"article_id": "9691751", "title": "NBA／湯普森稱詹姆斯是最難守球員 歷史最佳陣容有Kobe沒喬丹", "summary": "湯普森（Klay Thompson）效力勇士隊時，連4年在總冠軍賽遭遇詹姆斯（LeBron James）領軍的騎士隊，雖勇士3度奪冠，但湯普森仍說詹姆斯是最難守的球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230532.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 14:49", "link": "/news/story/7002/9691751"}, {"article_id": "9691496", "title": "亞運棒球／劉致榮移地訓練交流賽好表現 有機會遞補誠正選球員", "summary": "名古屋亞運棒球項目培訓隊赴日移地訓練，具旅美資歷投手劉致榮交流賽中繼登板共5局無失分、最速153公里，好表現有機會遞補成...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230315.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 13:51", "link": "/news/story/124981/9691496"}, {"article_id": "9691609", "title": "NBA／不是勇士「浪花兄弟」柯瑞？湯普森最親近隊友選格林", "summary": "獨行俠隊神射手湯普森（Klay Thompson）今天在直播上被問到，誰是NBA生涯中最親近的人。結果答案竟然不是「浪花兄弟」柯瑞（Stephen Curry），而是同樣一起在勇士隊打拼多年的「嘴綠」格林（Draymond Green）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230307.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-14 13:50", "link": "/news/story/7002/9691609"}, {"article_id": "9691580", "title": "三菱重工空調首創《一起跑上太空》路跑 9月13日登陸台南南瀛天文館", "summary": "三菱重工空調今年打破家電與運動的邊界，宣佈將於9月13日於台南南瀛天文館舉辦三菱重工空調《一起跑上太空》太空任務路跑，將隱藏於空調心臟裡的「航太 DNA」實體化，打造全台首場主題式太空任務路跑，賽事即日起正式開放報名，全台限量500位，額滿為止。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35230267.png&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-14 13:40", "link": "/news/story/7005/9691580"}]}, {"name": "棒球", "articles": [{"article_id": "9692205", "title": "中職／桃猿啟用「雙洋砲」下周排出4土投 曾總點名3人有機會先發", "date": "2026-08-14 18:14", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221230.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9692205"}, {"article_id": "9692576", "title": "中職／兄弟7：0大勝下半季衝上第3 賞雄鷹本季最長6連敗", "date": "2026-08-14 22:46", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231604.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9692576"}, {"article_id": "9692546", "title": "中職／劉俊緯敲再見安笑認自帶英雄命 葉總讚：真的很不容易", "date": "2026-08-14 22:21", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35231565.jpg&M=1&s=Y&x=0&y=232&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9692546"}, {"article_id": "9692527", "title": "中職／劉俊緯敲生涯首支再見安 龍隊再登下半季首位", "dat