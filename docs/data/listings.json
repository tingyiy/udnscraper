ary": "中華職棒樂天桃猿隊投手曾家輝過去3年在一軍合計投16局，今年開季至今投超過60局，儼然成為主力戰將，曾家輝說：「能夠給自...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168549.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 21:22", "link": "/news/story/7001/9649478"}, {"article_id": "9649419", "title": "日職／林安可轟2分砲連4場安打 西武3：7不敵軟銀", "summary": "日職西武隊今起在主場和軟銀隊展開3連戰，台灣外野手林安可此戰被排為先發第5棒、指定打擊，3打數敲出一發2分全壘打，一度幫助西武隊追平比數，但軟銀隊單場揮出13支安打，包括2支全壘打，終場以7：3打下勝利，收下3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168470.jpg&M=1&s=Y&x=0&y=84&sw=929&sh=619&exp=3600&sl=W&fw=360", "date": "2026-07-24 20:19", "link": "/news/story/7001/9649419"}, {"article_id": "9649395", "title": "中職／威克神之一轟！生涯首打數開轟 成史上第14人", "summary": "樂天桃猿隊外籍野手威克「開箱」首戰就打出洋砲價值，生涯首打數敲出兩分砲，狙擊本季最強土投李東洺，為中職史上第14人，前一人為2021年11月9日富邦悍將隊王苡丞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168439.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:58", "link": "/news/story/7001/9649395"}, {"article_id": "9649375", "title": "桌球／日本桌球T聯賽將登場 張本美和來台想喝很多珍奶", "summary": "日本職業桌球聯賽T.LEAGUE將於明天下午在新竹縣立體育館舉行史上首次海外開幕戰，這次跟著女子隊神奈川木下Abyell...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168408.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:35", "link": "/news/story/7005/9649375"}, {"article_id": "9649227", "title": "桌球／日本桌球T聯賽台灣開幕戰 林昀儒推薦隊友吃牛肉麵", "summary": "日本職業桌球聯賽T.LEAGUE將於25日在台灣舉行2026-27賽季海外開幕戰，身為地主選手的林昀儒笑說，在家鄉比賽的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168387.jpg&M=1&s=Y&x=27&y=0&sw=1253&sh=835&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:13", "link": "/news/story/7005/9649227"}, {"article_id": "9649150", "title": "中職／味全龍8月「龍星大樂主題日」 邀NMIXX、鄭中基演出", "summary": "中職味全龍隊發布新聞稿，8月14至16日台北大巨蛋主場「龍星大樂主題日」，除之前公布的韓國女團NMIXX外，還邀請「情歌...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168385.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:12", "link": "/news/story/7001/9649150"}, {"article_id": "9649317", "title": "中職／近4次「瘋狗式完封」蹲捕3次 林岱安緊擁教頭道謝", "summary": "中華職棒最近4場「麥達克斯完封」，富邦悍將捕手林岱安就蹲了3場，跨度包含效力前東家統一7-ELEVEn獅隊時期，他賽後緊...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168379.jpg&M=1&s=Y&x=0&y=24&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:10", "link": "/news/story/7001/9649317"}, {"article_id": "9649229", "title": "棒球／火球男劉致榮加入亞運培訓 久違實戰飆152公里", "summary": "名古屋亞運棒球項目培訓隊17日恢復集訓，具旅外資歷投手劉致榮加入培訓隊，近日練習賽睽違超過1年的實戰登板，飆速152公里", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168373.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:08", "link": "/news/story/7001/9649229"}, {"article_id": "9649225", "title": "亞青棒球賽／饒又語改4分之3出手增位移 亞青培訓看能走到哪", "summary": "穀保家商投手饒又語遞補入亞洲青棒錦標賽集訓名單，藍白賽好表現續留22人名單；降低出手點至4分之3、讓變化球位移更好，對於...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168371.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:07", "link": "/news/story/7001/9649225"}, {"article_id": "9649345", "title": "NBA／巴特勒ACL復健傳跨過關卡 勇士期待下季中回歸延續爭冠希望", "summary": "金州勇士今年休賽季持續關注巴特勒（Jimmy Butler）的傷勢恢復情況，而最新消息顯示，這名明星前鋒在右膝前十字韌帶撕裂傷勢的復健過程中，已經取得明顯進展。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168356.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-24 19:01", "link": "/news/story/7002/9649345"}, {"article_id": "9649324", "title": "NBA／自美國隊後與凱斯勒再相逢 里夫斯狂讚：打球聰明又能影響比賽", "summary": "洛杉磯湖人今年休賽季重塑陣容，特別引進中鋒凱斯勒（Walker Kessler），將其視為未來發展新核心之一，這也讓後衛里夫斯（Austin Reaves）相當期待能與這名長人在洛杉磯重聚。過去兩人曾在2023年FIBA世界盃一同代表美國隊出賽，讓里夫斯對凱斯勒的場上能力與個性都已有一定熟悉度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168326.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 18:51", "link": "/news/story/7002/9649324"}, {"article_id": "9649273", "title": "日職／林安可炸本季第6轟、7月第4轟！ 對軟銀敲追平2分砲", "summary": "西武隊台灣外野手林安可本季第6轟出爐！今天在主場對上軟銀隊，4局下第二打席轟出一發2分全壘打，一棒將比數扳成3：3平手，這也是他回歸一軍後在7月敲出的第4發全壘打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168266.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 18:13", "link": "/news/story/7001/9649273"}, {"article_id": "9649248", "title": "中職／「雙洋砲實驗室」最快8月8日才能開 曾總談時間緊迫認為還好", "summary": "樂天桃猿隊預計本周末啟用的雙洋砲計畫，因為道威聖降下二軍調整而暫緩，如今實驗室最快開啟時間要到8月8日，被問到是否時間緊迫，總教練曾豪駒認為是還好、都在規畫當中，「要走雙洋砲，也要兩個狀態都維持好，才能產生好的效益。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168234.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 18:07", "link": "/news/story/7001/9649248"}, {"article_id": "9649181", "title": "韓職／KT巫師「水原女神」金吉娜台灣首場生日會 神秘嘉賓祝賀影片瞬間落淚", "summary": "韓籍啦啦隊員金吉娜於台北舉辦首場生日會，特派女保鑣提供全天候維安。活動吸引50名粉絲參加，並獲得多位朋友的祝福，金吉娜感動落淚。安全管理團隊細心檢查禮物，確保活動安全無虞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168172.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 18:06", "link": "/news/story/7001/9649181"}, {"article_id": "9649213", "title": "MLB／不急讓大谷翔平重返投手丘 羅伯茲直言：現在作為打者價值更大", "summary": "根據韓國媒體《OSEN》報導，洛杉磯道奇總教練羅伯茲（Dave Roberts）近日受訪時坦言，球隊目前不急著讓「超級球星」大谷翔平恢復投手身分，主因正是他作為打者對球隊打線的價值更大。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168182.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:58", "link": "/news/story/6999/9649213"}, {"article_id": "9649203", "title": "桌球／暌違多時「回家」作戰 林昀儒、鄭怡靜盼重溫熱情加油聲", "summary": "日本桌球職業聯賽T聯賽明天將在新竹縣首次舉行海外開幕戰，吸引眾多國內球迷關注，台灣桌球「沉默刺客」林昀儒與一姊鄭怡靜今天受訪時皆表達對在「主場」出賽的興奮與期待。鄭怡靜更直言，能在家鄉出賽彷彿重溫2017年台北世大運時全場熱烈加油的感動；林昀儒則期許發揮最佳表現，並以接下來的名古屋亞運奪牌為最大目標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168175.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:54", "link": "/news/story/7005/9649203"}, {"article_id": "9649194", "title": "中職／瘋狗系捕手！林岱安有光總給的攻略 「讓仕朋舒服就好」", "summary": "富邦悍將隊左投陳仕朋的完封勝已不算罕見，但過去3場用球數全數都在118球以上，昨天在捕手林岱安引導下，催化生涯首場「瘋狗級完封」。陳仕朋昨天稱這一勝對自己很重要，其實對林岱安來說也是一樣，林岱安也不諱言，兩人今年都遇到辛苦的一年。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168162.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:50", "link": "/news/story/7001/9649194"}, {"article_id": "9649159", "title": "中職／坐擁土投先發最難打數據 陳克羿好投終於不再覺得只是運氣好", "summary": "樂天桃猿隊投手陳克羿本季投出蛻變數據，至目前為止被打擊率只有0.212，更優於10勝級最強土投李東洺。對於今年展現出的壓制力，陳克羿也有感差異，以前就算好投，總有種自己只是運氣好的感覺，今年才是他第一次感受到自己是能壓制打者的。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168111.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:32", "link": "/news/story/7001/9649159"}, {"article_id": "9649144", "title": "桌球／T聯賽首次海外開幕戰新竹登場 林昀儒坦言緊張加倍特訓", "summary": "日本最高層級職業桌球聯賽「Nojima T.LEAGUE」2026-2027賽季迎來歷史性突破，由台灣品牌「蛋牌（the egg）」促成的聯盟史上首場海外開幕戰，將於明天在新竹縣立體育館震撼登場。在今天賽前記者會中，T聯賽理事長坂井一也與蛋牌總經理陳昱成共同敲開象徵賽事起點的「蛋」型裝置，揭曉主視覺「初陣」，宣告台日桌球交流邁入新篇章。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168101.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:29", "link": "/news/story/7005/9649144"}, {"article_id": "9649139", "title": "中職／洋砲能否適應需觀察多久？後藤光尊：至少100打席", "summary": "樂天桃猿隊為下半季戰情部署洋砲，道威聖在出賽6場後降下二軍，接下來輪到威克今天「開箱」。富邦悍將隊今年也曾嘗試外籍野手，被問到觀察一名洋砲能否適應中職需要多少時間，總教練後藤光尊給出的答案是「至少100打席」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168094.jpg&M=1&s=Y&x=0&y=0&sw=627&sh=418&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:26", "link": "/news/story/7001/9649139"}, {"article_id": "9649112", "title": "NBA／獲得主帥柯爾信任？ 勇士首輪新秀有望新賽季扛先發重任", "summary": "在拉斯維加斯夏季聯賽發揮出色的勇士首輪第11順位新秀倫德伯格（Yaxel Lendeborg），據悉已經贏得教練團的信任，有機會在新賽季直接進入先發陣容。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168080.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:23", "link": "/news/story/7002/9649112"}, {"article_id": "9649073", "title": "MLB／永遠不要再投球！美媒名嘴勸大谷放棄「二刀流」引發爭議", "summary": "道奇日籍二刀流球星大谷翔平本季一度被看好有機會挑戰國聯MVP、賽揚獎雙料殊榮，不過受到左膝持續不適及登板數不足影響，雙冠夢已提前破滅。儘管他近日順利完成牛棚練投，仍有評論員語出驚人，直言大谷應該「永遠不要再投球」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-24 17:04", "link": "/news/story/6999/9649073"}, {"article_id": "9649065", "title": "MLB／道奇艾德曼火燙+赫南德茲歸隊 韓媒憂：金慧成被遺忘了", "summary": "南韓好手金慧成在道奇隊已被邊緣化，由於道奇韓裔工具人艾德曼（Tommy Edman）傷癒復出後繳出頂級成績，金慧成回大聯盟的機會更加渺茫。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168015.jpg&M=1&s=Y&x=284&y=0&sw=843&sh=562&exp=3600&sl=W&fw=360", "date": "2026-07-24 16:57", "link": "/news/story/6999/9649065"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9648053", "title": "世足賽／球星身價榜更新！哈蘭德和亞馬爾並列第1、姆巴佩第3", "date": "2026-07-24 10:27", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35166324.jpg&M=1&s=Y&x=0&y=48&sw=920&sh=613&exp=3600&w=300", "link": "/news/story/123107/9648053"}, {"article_id": "9647820", "title": "世足賽／亞軍背對冠軍失禮？近20年僅2隊留場內：2014、2026阿根廷", "date": "2026-07-24 09:35", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35166017.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9647820"}, {"article_id": "9647372", "title": "世足賽／世界盃落幕 瑞士政界質疑FIFA稅務待遇與管理機制", "date": "2026-07-24 03:17", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35166064.j