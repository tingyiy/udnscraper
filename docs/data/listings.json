o.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309129.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9742489"}, {"article_id": "9741923", "title": "國聯塞揚獎還有懸念！37歲「拍賣哥」塞爾球速為何能再進化？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35308375.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9741923"}]}, {"name": "最新文章", "articles": [{"article_id": "9748933", "title": "NBA／對西蒙斯還有期待？騎士冠軍前鋒：具備成為DPOY天賦", "summary": "現年30歲的西蒙斯（Ben Simmons）上季沒打籃球，而是轉戰職業釣魚聯盟，今年休賽季他重返NBA加入國王隊，前NBA球員傑佛森（Richard Jefferson）認為，西蒙斯仍具備全明星實力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318979.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 16:17", "link": "/news/story/7002/9748933"}, {"article_id": "9748736", "title": "桌球／鄭怡靜苦戰47分鐘惜敗 WTT澳門冠軍賽止步16強", "summary": "WTT澳門冠軍賽今天進行的女單16強，台灣好手鄭怡靜在苦戰47分鐘後，仍以9比11、12比10、14比16、11比8、9...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318951.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 16:07", "link": "/news/story/7005/9748736"}, {"article_id": "9748821", "title": "MLB／與隆巴德共寫史上首見紀錄 洋基沃爾普：以為再也回不了大聯盟", "summary": "洋基隊沃爾普（Anthony Volpe）重返大聯盟首戰就轟滿貫砲，彷彿浴火重生。賽後沃爾普有感而發，「我原本以為自己可能再也回不了大聯盟，所以現在只想把握好這次機會。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318820.jpg&M=1&s=Y&x=0&y=45&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-11 15:40", "link": "/news/story/6999/9748821"}, {"article_id": "9748832", "title": "500萬好宅得主你在哪？ 「峮力衝榜拚好宅」揭曉大獎 峮峮公開喊話尋人", "summary": "歷時一年的「峮力衝榜拚好宅」活動迎來最終高潮！時來運轉運動彩券再度回到一年前的活動起點SPORTS NATION台北大巨蛋店，舉辦年度贈獎儀式，邀請代言人峮峮與Passion Sisters女孩畇二&沛婕一同現身，與現場會員及球迷共同見證得獎名單揭曉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318871.jpg&M=1&s=Y&x=244&y=206&sw=797&sh=532&exp=3600&sl=W&fw=360", "date": "2026-09-11 15:40", "link": "/news/story/7001/9748832"}, {"article_id": "9748830", "title": "NBA／無禮拒絕路人球迷合照 約柯奇：大家像在看動物園的動物", "summary": "金塊3屆MVP約柯奇（Nikola Jokic）近年可謂聯盟第1人，也收穫大量粉絲，但他卻對名氣與光環感到厭倦，在日前一檔節目中，更坦承自己對路人合照的要求都越來越沒有禮貌，並呼籲年輕一代不要把球星當成人生榜樣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318836.jpg&M=1&s=Y&x=0&y=0&sw=1236&sh=824&exp=3600&sl=W&fw=360", "date": "2026-09-11 15:28", "link": "/news/story/7002/9748830"}, {"article_id": "9748766", "title": "NBA／庫明加選明尼蘇達是因「贏球文化」 湖人球迷批：灰狼0冠欸", "summary": "今年休賽季庫明加（Jonathan Kuminga）拒絕湖人更高報價，以2年1300萬美元（約台幣4.11億）合約加盟灰狼。而對於選擇「北大荒」的決定，這位23歲前鋒在記者會提到是為了「贏球文化」，不料卻引發爭議，被外界認為在暗諷湖人，更遭到紫金球迷反嗆「去隊史0冠的球隊談贏球文化。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318739.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 15:03", "link": "/news/story/7002/9748766"}, {"article_id": "9748680", "title": "排球／187公分温逸凱「帥臉」紅到國外！泰國球迷嗨喊：太犯規了", "summary": "中華男排9日在亞洲男子排球錦標賽，總局數2：3輸給地主泰國，不過中華隊「77號」温逸凱因帥氣外型成為話題人物，他在場上撥頭髮的畫面，於泰國社群平台被瘋傳，影片流量突破百萬，連日本人都注意到，IG人數更是從4.1萬衝上4.8萬。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318570.jpg&M=1&s=Y&x=0&y=50&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 14:32", "link": "/news/story/7005/9748680"}, {"article_id": "9748646", "title": "亞運／重賞下必有勇夫！印尼總統祭出超狂獎勵 每面金牌送30億印尼盾", "summary": "2026名古屋亞運即將到來，各國為了激勵自家運動員奪牌士氣，紛紛提出超吸睛「重賞」。印尼總統普拉伯沃（Prabowo Subianto）日前也宣布，選手拿下金牌就能夠得到30億印尼盾（約台幣539萬元）獎金，並且不是「算人頭」，而是每面金牌都能得一次獎金。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318510.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 14:10", "link": "/news/story/124981/9748646"}, {"article_id": "9748566", "title": "MiLB／亞運國手林昱珉中繼5局失1分 飆速150公里奪第8勝", "summary": "旅美亞利桑那響尾蛇隊投手林昱珉為今年亞運代表隊成員，今天在小聯盟3A出賽，中繼5局投出6次三振失1分，最快球速150公里...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318385.jpg&M=1&s=Y&x=0&y=136&sw=968&sh=646&exp=3600&sl=W&fw=360", "date": "2026-09-11 13:49", "link": "/news/story/6999/9748566"}, {"article_id": "9748606", "title": "體操／放棄世錦賽遞補爭議 運動部要求體操協會公開道歉並撤免秘書長", "summary": "針對中華民國體操協會處理2026年世界競技體操錦標賽遞補參賽資格不當，致兩名選手錯失參賽機會一事，運動部今天表示，本案已實質影響選手參賽權益，且協會於事件發生後之說明、究責及處理迄今仍未符合應有之治理責任。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318395.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 13:49", "link": "/news/story/7005/9748606"}, {"article_id": "9748600", "title": "MLB／寧可拉2A新秀上大聯盟 韓媒怒批道奇邊緣金慧成：當初幹嘛簽約", "summary": "道奇日籍巨星大谷翔平因左膝與右上臂二頭肌不適，進入15天傷兵名單，球團決定從2A將農場頭號新秀、百大新秀第6的德保拉（Josue De Paula）拉上大聯盟，而不是本季長時間在3A的韓籍內野手金慧成，讓韓國媒體感到不滿，更質疑「當初究竟為什麼要簽下他？」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318407.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 13:46", "link": "/news/story/6999/9748600"}, {"article_id": "9748595", "title": "企業射箭／例行賽最終戰前進西湖渡假村 協會青年衝擊季後賽仍有望", "summary": "2026第8年企業射箭聯賽例行賽最後一周的第五周賽程將於12、13日進行，這次的比賽地點別出心裁，眾家射手將前進苗栗縣知名景點「西湖渡假村」，也是名古屋亞運前最後一場賽事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318361.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 13:45", "link": "/news/story/7005/9748595"}, {"article_id": "9748583", "title": "亞運卡巴迪／理事長發加菜金以及允諾奪牌激勵金 盼亞運能再創佳績", "summary": "名古屋亞運即將在19日開幕，連續兩屆奪牌的卡巴迪代表隊預計18日出發，女子隊目標鎖定擊敗印度隊摘下隊史首金，男子隊放在保牌為主。理事長林茂榮今日特別南下國家訓練中心勉勵兩支代表隊選手、教練和防護員，除了頒發加菜金外，更許諾亞運會上奪金選手額外給2000美金、銀牌1000美金、銅牌600美金，選手和教練都有，期盼能激發選手們的鬥志，向目標勇於前進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318345.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 13:42", "link": "/news/story/124981/9748583"}, {"article_id": "9748541", "title": "NBA／忘了勇士柯瑞、CP3？庫明加稱讚球三傳球發言被炎上", "summary": "今年休賽季庫明加（Jonathan Kuminga）以2年1300萬美元合約加入灰狼隊，金額遠低外界預期。灰狼今天為他舉辦加盟記者會，他直呼從沒和小鮑爾（LaMelo Ball）這麼會傳球的隊友配合過，引發不少球迷反感。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318266.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 13:29", "link": "/news/story/7002/9748541"}, {"article_id": "9748452", "title": "美網／芮芭奇娜逆轉高芙晉級決賽 將與莎芭蓮卡上演前後任球后對決", "summary": "美國網球公開賽女單四強賽今天上演頂尖對決，賽會第2種子、哈薩克好手芮芭奇娜（Elena Rybakina）在先失一盤的劣勢下，展開頑強反撲，最終以3：6、6：4、6：4上演大逆轉，擊敗在地希望高芙（Coco Gauff）。芮芭奇娜不僅順利搶下決賽門票，更確定會在下周首度登頂女單世界球后，決賽將與被她擠下球后寶座的莎芭蓮卡（Aryna Sabalenka）正面交鋒，上演當今網壇最強對決。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318149.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 12:49", "link": "/news/story/121623/9748452"}, {"article_id": "9748415", "title": "MLB／不能不信邪！白襪迷大喊「你無安打欸」 海盜瓊斯下1球就破功", "summary": "棒球場上，真的不能不信邪！今天七局下、兩出局，白襪隊的安打欄還是「0」，白襪主場球迷在觀眾席上大喊「嘿！你現在還是無安打比賽耶！」海盜隊投手瓊斯（Jared Jones）下一球，隨即被蒙哥馬利（Colson Montgomery）敲出二壘打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318135.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 12:27", "link": "/news/story/6999/9748415"}, {"article_id": "9748397", "title": "TPBL／新賽季10月17日台中燃戰火 海神狀元賀丹隔日首秀對戰夢想家", "summary": "TPBL今天公布2026–27賽季例行賽賽程，將於10月17日傍晚五點，由福爾摩沙夢想家隊在洲際迷你蛋迎戰新北國王隊，正式翻開新篇章，七支球隊的主場開幕戰將自10月17日起陸續登場，聖誕節與情人節焦點對決也同步揭曉，邀請球迷提前圈選觀賽日期，用場邊應援回應場上的全力以赴。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318065.jpg&M=1&s=Y&x=1&y=30&sw=1023&sh=682&exp=3600&sl=W&fw=360", "date": "2026-09-11 12:20", "link": "/news/story/7003/9748397"}, {"article_id": "9748365", "title": "日職／「界外球王者」中島卓也引退！曾和大谷翔平、陽岱鋼奪日本一", "summary": "日本火腿隊35歲內野手中島卓也宣布退休，結束18年職業生涯。中島卓也以穩健守備和「碰球打法」聞名，生涯只有2發全壘打，曾在2016年與大谷翔平和陽岱鋼等球員，攜手奪下日本一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317994.jpg&M=1&s=Y&x=0&y=561&sw=1081&sh=721&exp=3600&sl=W&fw=360", "date": "2026-09-11 12:06", "link": "/news/story/7001/9748365"}, {"article_id": "9748341", "title": "亞運棒球／台韓戰可能掛帥先發 王彥程：期待金牌戰見", "summary": "王彥程有機會21日亞運棒球台韓首戰先發，盼台韓共同晉級冠軍賽；他效力韓職韓華鷹，先發22場拿下11勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317990.jpg&M=1&s=Y&x=200&y=50&sw=1058&sh=652&exp=3600&sl=W&fw=360", "date": "2026-09-11 12:00", "link": "/news/story/124981/9748341"}, {"article_id": "9748247", "title": "MLB／頂級選球+長打破壞力 專家看道奇大物天花板是大空人強打", "summary": "道奇日前將大谷翔平放進15天傷兵名單，並從2A將農場頭號新秀、百大新秀第6的德保拉（Josue De Paula）拉上大聯盟，官網新秀專家卡利斯（Jim Callis）也撰文預測這位年輕新星的未來模板，更提到他有可能連續多個賽季，繳出單季至少30轟。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317811.jpg&M=1&s=Y&x=0&y=65&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-11 11:31", "link": "/news/story/6999/9748247"}, {"article_id": "9748206", "title": "中職／陳鏞基台南引退賽 613台無人機詮釋「台灣轟炸機」故事", "summary": "統一7-ELEVEN獅隊「鏞不止步」陳鏞基引退系列賽，將於下周末（9月19日、20日）於亞太成棒主球場登場，球團將於兩日賽後再次安排大型無人機展演，透過夜空中的光影變化，帶領球迷重新認識、再次走進屬於陳鏞基的棒球故事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317699.png&M=1&s=Y&x=105&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-11 11:18", "link": "/news/story/7001/9748206"}, {"article_id": "9748200", "title": "MLB／3A邦茲！洋基沃爾普回歸首戰就轟滿貫 夢迴世界大賽對道奇", "summary": "洋基隊沃爾普（Anthony Volpe）今天重返大聯盟，擔任先發第9棒二壘手，7局下轟出滿貫砲，單場3安猛打賞，幫助洋基以10：3擊垮洛磯隊，系列賽完成橫掃。洋基贏球，同時光芒隊輸給勇士隊，雙方勝差只剩3場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317684.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 11:17", "link": "/news/story/6999/9748200"}, {"article_id": "9748133", "title": "亞運男籃／床太小、餐廳漏水！韓媒陸媒砲轟貨櫃屋選手村惡劣", "summary": "名古屋亞運男籃項目率先開打，韓媒和陸媒都指出，花園碼頭貨櫃屋選手村環境惡劣的問題，當地還下起暴雨，導致餐廳漏水的情況。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317589.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 10:53", "link": "/news/story/124981/9748133"}, {"article_id": "9748129", "title": "MLB／PCA本季10WAR領跑MVP！ 大谷最強二刀流賽季也沒達成", "summary": "小熊「PCA」阿姆斯壯（Pete Crow-Armstrong）本賽季打擊、跑壘跟守備實力超群，幾乎預訂拿下國聯MVP。且這位明星外野手的WAR值高達10.0，超越大谷翔平二刀流表現最佳的賽季，若成功奪得MVP有望創下睽違24年超狂紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317560.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 10:46", "link": "/news/story/6999/9748129"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9748133", "title": "亞運男籃／床太小、餐廳漏水！韓媒陸媒砲轟貨櫃屋選手村惡劣", "date": "2026-09-11 10:53", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317589.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9748133"}, {"article_id": "9748341", "title": "亞運棒球／台韓戰可能掛帥先發 王彥程：期待金牌戰見", "date": "2026-09-11 12:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317990.jpg&M=1&s=Y&x=200&y=50&sw=1058&sh=652&exp=3600&w=300", "link": "/news/story/124981/9748341"}, {"article_id": "9748015", "title": "亞運男籃／陳盈駿指聲明不符事實 籃協：賽程落幕再說明始末", "date": "2026-09-11 10:07", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317385.jpg&M=1&s=Y&x=0&y=73&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9748015"}, {"article_id": "9748646", "title": "亞運／重賞下必有勇夫！印尼總統祭出超狂獎勵 每面金牌送30億印尼盾", "date": "2026-09-11 14:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318510.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9748646"}, {"article_id": "9748583", "title": "亞運卡巴迪／理事長發加菜金以及允諾奪牌激勵金 盼亞運能再創佳績", "date": "2026-09-11 13:42", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35318345.jpg&M=1&s=Y&x=0&y=0