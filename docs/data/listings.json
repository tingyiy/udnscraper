ail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35184921.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9658615"}, {"article_id": "9656701", "title": "中職／兄弟扭轉戰局只能大破大立 下半季或可直接練兵看未來", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178825.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9656701"}, {"article_id": "9656339", "title": "詹姆斯空降費城 老皇帝「Last Decision」的盤算與負重", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178319.jpg&M=1&s=Y&x=0&y=13&sw=1073&sh=715&exp=3600&w=300", "link": "/news/story/122629/9656339"}, {"article_id": "9656390", "title": "湖人不惜梭哈也要得手 凱斯勒是唐西奇遇過最好禁區搭檔！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178373.jpg&M=1&s=Y&x=0&y=53&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9656390"}]}, {"name": "最新文章", "articles": [{"article_id": "9666562", "title": "棒球／女性黑馬…周玲妏 當選棒協理事長", "summary": "中華棒球協會昨進行第十四屆理事長選舉，中信育樂公司副總經理周玲妏確定當選，成為棒協首位女領導人，接下原任理事長辜仲諒的重任，最近動作十分積極的經濟部前部長、科技企業家郭智輝「吊車尾」獲選理事，無緣更上一層樓，坦然接受事實。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193464.jpg&M=1&s=Y&x=0&y=297&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-08-03 00:00", "link": "/news/story/7001/9666562"}, {"article_id": "9666583", "title": "棒球／體壇政治…爭棒協、籃協 總統牌連番失靈", "summary": "經濟部前部長郭智輝在中華棒球協會理事長之爭中落選，賴清德姪子、基隆市議會議長童子瑋日前競選中華籃球協會理事長也失利，兩人都與賴清德總統有親近關係，接連爭取體育協會龍頭都未果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193503.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 00:00", "link": "/news/story/7001/9666583"}, {"article_id": "9666586", "title": "棒球／棒協改選配票得宜 新任理事多中信體系", "summary": "近來頻頻造勢的經濟部前部長郭智輝昨天在中華棒球協會理事長改選失利，選舉結果說明棒協改選仍由中信掌控大局，新任理事幾乎都是中信體系，原任理事長辜仲諒提拔的人是最後贏家。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_3.jpg", "date": "2026-08-03 00:00", "link": "/news/story/7001/9666586"}, {"article_id": "9666590", "title": "棒球／棒協交棒獲聘名譽理事長 辜仲諒爭取WBSC會長", "summary": "中華棒球協會理事長昨天改選，中信育樂公司副總經理周玲妏接下重任，原任理事長辜仲諒完成八年任期，未來兩大目標除了連任亞洲棒球總會會長，也期待有機會在二○二九年更上一層樓，成為世界棒壘球總會（ＷＢＳＣ）會長，成為全球業餘棒壇最高領導人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193481.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-03 00:00", "link": "/news/story/7001/9666590"}, {"article_id": "9666592", "title": "棒球／出掌棒協… 周玲妏找資源一流", "summary": "中華民國棒球協會昨天舉行理監事改選，中國信託育樂公司副總經理周玲妏當選新任理事長，周曾連任四屆高雄市議員，二○一八年連任失利後轉任旅遊業，二○二○年陳其邁補選上任高雄市長後，延攬周擔任觀光局長，周不拘小節，好友都習慣稱她「周董」，被評價「找資源能力一流」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193510.jpg&M=1&s=Y&x=149&y=269&sw=926&sh=642&exp=3600&sl=W&fw=360", "date": "2026-08-03 00:00", "link": "/news/story/7001/9666592"}, {"article_id": "9666523", "title": "桌球／幫擴！「學姊」鄭怡靜行李機場遺失 內有比賽用品", "summary": "東京奧運奪下混雙銅牌的我國桌球「一姊」鄭怡靜，今天飛往日本準備參加4日登場的WTT橫濱冠軍賽，不料卻發生行李遺失意外，教練鄭佳奇晚間透過Threads求助，希望拿錯行李的黃姓旅客能歸還裝有重要比賽用品的行李。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_6.jpg", "date": "2026-08-02 23:10", "link": "/news/story/7005/9666523"}, {"article_id": "9666399", "title": "等不到對手…桃園盃籃球賽爆「AI幽靈球隊」！廠商認灌水、體育局怒喊求償", "summary": "第十屆桃園盃全國三對三籃球賽周末登場，卻爆出「AI幽靈球隊」爭議。多名參賽選手質疑，大量隊伍未報到，導致不少球隊苦等數小時卻因對手棄權直接晉級。桃園市體育局今表示，承辦廠商已坦承確有報名灌水造假情事，市府將提報不良廠商，並追究詐欺責任及求償。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193261.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 21:23", "link": "/news/story/7003/9666399"}, {"article_id": "9666327", "title": "日職／張峻瑋優質先發飆速156公里 奪二軍本季第5勝", "summary": "日職福岡軟銀鷹隊投手張峻瑋成為正式球員後首場二軍出賽，今天6局失1分優質先發、飆速156公里，隊友火力支援，球隊以13比...", "thumbnail": "https://pgw.udn.com.tw/