, "articles": [{"article_id": "9675473", "title": "76人比2017年KD的「宇宙勇士」強？老詹年輕10歲才有可能", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35207017.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9675473"}, {"article_id": "9674902", "title": "中職／熱昏了！韓職取消比賽 聯盟也應及早訂定高溫規定", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35206059.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9674902"}, {"article_id": "9672404", "title": "交易大限5大Win Now贏家 道奇奪史庫柏、教士迎麥茲最成功", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35202794.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9672404"}, {"article_id": "9671568", "title": "續約杜倫難解又沒第二持球點 活塞無作為的休賽季打什麼算盤？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200680.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9671568"}, {"article_id": "9671549", "title": "中職／擴編選秀CP值最高球員！ 陳文杰蛻變雄鷹王牌球星", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200626.jpg&M=1&s=Y&x=0&y=49&sw=1055&sh=703&exp=3600&w=300", "link": "/news/story/122629/9671549"}, {"article_id": "9668253", "title": "中職／至今找不到第4名可用洋投 中信洋投海戰術面臨失敗", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35196038.jpg&M=1&s=Y&x=0&y=33&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9668253"}]}, {"name": "最新文章", "articles": [{"article_id": "9680513", "title": "中職／張皓崴不擔心首打點遲到 追隨陳傑憲軌跡成長", "summary": "中華職棒統一7-ELEVEn獅隊野手張皓崴在生涯第43場出賽，終於敲出首打點，他坦言目前不急於追求長打，以陳傑憲為學習目...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214458.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 18:18", "link": "/news/story/7001/9680513"}, {"article_id": "9680514", "title": "NBA／勇士搶不到大咖氣氛仍輕鬆 巴特勒惡搞柯瑞照片引本尊笑回", "summary": "金州勇士過去幾個月雖然沒能如願補進多名鎖定的大咖球星，但球隊內部氣氛似乎並未受到太大影響。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214443.jpg&M=1&s=Y&x=171&y=27&sw=1018&sh=678&exp=3600&sl=W&fw=360", "date": "2026-08-09 17:58", "link": "/news/story/7002/9680514"}, {"article_id": "9680456", "title": "NBA／「休賽季之王」再度登場！西蒙斯曬腹肌照宣告：我已經準備好了", "summary": "前NBA選秀狀元西蒙斯（Ben Simmons）似乎再次向外界釋出準備重返聯盟的訊號。今日他在社群媒體曬出一張自己站在籃框旁曬出腹肌，看起來相當精壯的照片，並強調自己不會改變一路走來的任何故事，更直言已經準備好迎接下一段旅程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214339.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 17:45", "link": "/news/story/7002/9680456"}, {"article_id": "9680501", "title": "NBA／後詹皇時代培養新湖人化學效應 里夫斯放話高爾夫打爆唐西奇", "summary": "洛杉磯湖人即將前往斯洛維尼亞舉行季前迷你訓練營，里夫斯（Austin Reaves）已經迫不及待要和唐西奇（Luka Doncic）展開另類對決。他日前出席個人2026年籃球訓練營媒體活動時開玩笑表示，自己這趟旅程最期待的事情之一，就是在高爾夫球場上擊敗唐西奇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214417.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 17:44", "link": "/news/story/7002/9680501"}, {"article_id": "9680461", "title": "MLB／哥吉拉出沒！52歲松井秀喜狂轟大號全壘打 球迷驚呼：洋基打線需要你", "summary": "曾效力讀賣巨人與紐約洋基的日本傳奇強打松井秀喜，今天參加在洋基球場舉行的年度OB賽「Old-Timers' Day」，再度披上熟悉的條紋戰袍登場，讓現場球迷陷入回憶殺。這位2009年世界大賽MVP不只在活動中亮相，更在打擊練習與比賽中展現昔日長打威力，讓不少球迷驚呼：「他現在看起來還是能打。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214409.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 17:40", "link": "/news/story/6999/9680461"}, {"article_id": "9680423", "title": "MLB／長達110天12連勝遭國民粉碎 紅人官網形容伯恩斯罕見失常", "summary": "紅人隊新生代強投伯恩斯（Chase Burns），今天在客場對國民隊之戰先發5.1局失5分，超過3個半月的驚人12勝紀錄，終於畫下句點，吞下本季第2敗，紅人終場2：8落敗，輸掉3連戰前兩戰，僅是明星賽後7個系列賽第2次處於劣勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214307.jpg&M=1&s=Y&x=204&y=0&sw=908&sh=605&exp=3600&sl=W&fw=360", "date": "2026-08-09 16:41", "link": "/news/story/6999/9680423"}, {"article_id": "9680376", "title": "MLB／罕見怒吼宣洩！崔爾10局成功關門：這是我最激動的一次", "summary": "道奇在苦吞本季最長7連敗後，今日終於止住持續超過一周的低潮，只是這一勝來得格外驚險。球隊不僅整場進攻依舊低迷，甚至連續第2天在9局遭終結者迪亞茲（Edwin Díaz）砸鍋，所幸延長10局靠著大谷翔平敲出超前內野安打，加上崔爾（Jack Dreyer）守住最後半局，最終以2比1險勝響尾蛇，拿下8月首勝，也讓這場得來不易的勝利成為全隊如釋重負的一晚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214254.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 16:28", "link": "/news/story/6999/9680376"}, {"article_id": "9680396", "title": "中職／瑪帝斯來台已5度因雨延賽 悍將隊友封「雨男」", "summary": "中華職棒富邦悍將新洋投瑪帝斯，在一軍連2次預定先發都因雨延賽；他笑說自己習慣了，包含二軍已5次遇到，二軍隊友更直接幫他取...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214266.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 16:08", "link": "/news/story/7001/9680396"}, {"article_id": "9680364", "title": "MLB／道奇止7連敗險創罕見難堪紀錄 羅伯茲坦言：贏得一點都不好看", "summary": "道奇今日在驚濤駭浪中終於結束連敗。儘管終結者狄亞茲（Edwin Díaz）連續第2天在9局、球隊僅領先1分的情況下救援失敗，但這次道奇沒有再讓勝利溜走，靠著大谷翔平延長10局敲出超前內野安打，最終以2比1險勝，終結本季最長7連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214265.jpg&M=1&s=Y&x=0&y=32&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 16:08", "link": "/news/story/6999/9680364"}, {"article_id": "9680390", "title": "網球／3月排名還在百大外 西班牙19歲小將闖蒙特婁名人賽8強", "summary": "西班牙網壇江山代有人才出，傳奇「西班牙蠻牛」納達爾（Rafael Nadal）雖已退休，「小蠻牛」阿爾卡拉斯（Carlos Alcaraz）又因腕傷暫別球場，但19歲的霍達爾（Rafael Jodar）持續拍下驚奇，3月世界排名還在百大外的西班牙小將，今天以兩個6：3拍下捷克好手萊赫茨卡（Jiri Lehecka），晉級蒙特婁名人賽最終8強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214263.jpg&M=1&s=Y&x=0&y=61&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 16:04", "link": "/news/story/7005/9680390"}, {"article_id": "9680372", "title": "中職／悍將4新人將前往二軍 狀元陳柏凱仍待球團公布", "summary": "職棒富邦悍將今年選秀會挑進9位新人，已確定4人近期將前往二軍報到，不過外界關注的「狀元」游擊手陳柏凱還不在其中，副領隊林...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214257.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 16:02", "link": "/news/story/7001/9680372"}, {"article_id": "9680375", "title": "日職／火腿有原航平首見連兩戰完封勝 達標生涯1000K", "summary": "北海道日本火腿今天和東北樂天金鷲上演一場投手大戰，靠著先發有原航平的強勢表現，以及萬波中正的適時一擊，最終1比0獲勝。有原航平全場用了118球，被敲6支安打，投出1次觸身球、送出11次三振，沒有失分，取得本季第4勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214250.jpg&M=1&s=Y&x=17&y=0&sw=1061&sh=707&exp=3600&sl=W&fw=360", "date": "2026-08-09 15:59", "link": "/news/story/7001/9680375"}, {"article_id": "9680335", "title": "MLB／狄亞茲救援砸鍋又絕處逢生 道奇教頭「灌雞湯」：他太想追求完美", "summary": "洛杉磯道奇今天在延長賽以2：1險勝，總算中止近期7連敗低潮。不過，終結者狄亞茲（Edwin Díaz）連兩天救援砸鍋也引發熱議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214190.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-09 15:18", "link": "/news/story/6999/9680335"}, {"article_id": "9680337", "title": "籃網球／2026亞洲錦標賽 中華隊不敵日本隊 苦吞2連敗", "summary": "2026亞洲籃網球錦標賽中華隊今天（9日）在分組預賽第二場出戰日本隊，日本隊今年加入了5名外援，實力大獲提升，終場以44：35擊敗中華隊。中華隊預賽第三場，明天（10日）與南韓隊交手，爭取預賽首場勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214189.jpg&M=1&s=Y&x=0&y=402&sw=747&sh=498&exp=3600&sl=W&fw=360", "date": "2026-08-09 15:14", "link": "/news/story/7005/9680337"}, {"article_id": "9680320", "title": "日職／林安可左膝疼痛西武抹消登錄 日媒感嘆：好事多磨", "summary": "日本職棒埼玉西武獅隊台灣野手林安可今天被抹消一軍登錄，原因是左膝疼痛，日本媒體報導時以「好事多磨」為標題，為7月打出破3...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/31/34815827.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 15:12", "link": "/news/story/7001/9680320"}, {"article_id": "9680322", "title": "MLB／近100英里伸卡球挨轟 守護者王牌盛讚村上宗隆了不起", "summary": "白襪隊重砲村上宗隆連續兩天開轟，今天6局下陽春砲帶動全隊5分攻勢，以6：3逆轉勝守護者隊，終止本季最長4連敗，還有46場比賽要打，拿到60勝已經追平去年勝場紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214171.jpg&M=1&s=Y&x=0&y=11&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 14:56", "link": "/news/story/6999/9680322"}, {"article_id": "9680294", "title": "MLB／村上宗隆連兩天開轟追上大谷翔平 美球評狂讚打擊力量太強了", "summary": "芝加哥白襪日籍強打村上宗隆再度用全壘打帶動球隊反攻。村上在主場面對克里夫蘭守護者的第6局轟出本季第26號全壘打，帶動白襪單局狂灌5分一口氣逆轉戰局，最終以6比3中止近期4連敗，穩住美聯中區龍頭位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214136.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 14:37", "link": "/news/story/6999/9680294"}, {"article_id": "9680274", "title": "日職／陳睦衡二軍奪勝照自己步調續成長 穿歐力士92號盼創造歷史", "summary": "日職歐力士猛牛隊20歲台灣投手陳睦衡，7月底轉正式球員，成為歐力士球團史首名背號92號的球員，他表示，希望可以創造歷史，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2026/01/22/98/34267799.jfif&s=Y&x=81&y=8&sw=461&sh=307&exp=3600&sl=W&fw=360", "date": "2026-08-09 14:35", "link": "/news/story/7001/9680274"}, {"article_id": "9680289", "title": "中職／新莊悍將、獅隊之戰也不打了 兄弟尋求3連戰橫掃雄鷹", "summary": "中華職棒原定下午5點在新莊棒球進行的統一獅、富邦悍將隊之戰，受到雨勢影響，無法進行比賽，將延到補賽周在原場地進行，目前補賽日期未定。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214139.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 14:28", "link": "/news/story/7001/9680289"}, {"article_id": "9680223", "title": "MLB／身體狀況無礙遺憾沒再多投幾局 山本由伸無緣勝投「贏球最重要」", "summary": "道奇隊日籍山本由伸今天先發出戰響尾蛇隊，主投5.2局無失分，但打線依舊不挺，無緣本季第12勝，好在道奇最終仍在延長賽以2：1拿下勝利，終止本季最長7連敗，山本由伸鬆一口氣地說：「總之，能夠贏球就是最重要的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214055.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 13:33", "link": "/news/story/6999/9680223"}, {"article_id": "9680221", "title": "足球／梅西喪父缺席比賽 粉絲、隊友、對手教練都送暖", "summary": "阿根廷當家球星「獅王」梅西的父親老梅西（Jorge Messi），昨晚在一家醫療診所病逝，享壽68歲，梅西也因此缺席和蒙特雷在聯盟盃（Leagues Cup）的對陣，不過除賽前兩隊默哀1分鐘，體育場上螢幕秀出老梅西名字、梅西所屬的邁阿密國際球員戴上黑色臂章，球迷在比賽第10分鐘更展開旗幟，為梅西加油。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214044.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 13:32", "link": "/news/story/7005/9680221"}, {"article_id": "9680085", "title": "MLB／WWE巨星不爽綽號被搶 釀酒人火球男笑喊：那就打一場吧", "summary": "釀酒人火球男米蕭洛斯基（Jacob Misiorowski）本季在大聯盟投出亮眼成績，不過近日他卻因自己的綽號，意外與WWE知名摔角巨星「The Miz」米茲（Mike Mizanin）隔空槓上，甚至笑稱乾脆登上WWE擂台打一場，決定究竟誰能繼續使用「The Miz」這個名字。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35213851.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 13:28", "link": "/news/story/6999/9680085"}, {"article_id": "9680205", "title": "MLB／光芒不到半小時跟進道奇 美聯首支70勝球隊穩居龍頭", "summary": "美聯戰績最強的光芒隊，今天在西雅圖對水手隊之戰，6局上靠帕拉修斯（Richie Palacios）關鍵安打攻下兩分打點，成為致勝一擊，終場以3：2獲勝，最近拚出5連勝，成為美聯首支拿到70勝的球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214018.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-09 13:20", "link": "/news/story/6999/9680205"}, {"article_id": "9680154", "title": "中職／桃園風雨影響連兩天打不成 猿龍下半季龍頭之爭宣布延賽", "summary": "受到白海豚颱風外圍環流影響，中華職棒賽事持續受影響，在桃園棒球場進行的樂天桃猿隊與味全龍隊賽事，連續兩天打不成，原訂今天下午5點05分進行的比賽，受整日的風雨影響，賽事將延至補賽周進行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214056.jpg&M=1&s=Y&x=108&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-09 12:56", "link": "/news/story/7001/9680154"}]}, {"name": "棒球", "articles": [{"article_id": "9680320", "title": "日職／林安可左膝疼痛西武抹消登錄 日媒感嘆：好事多磨", "date": "2026-08-09 15:12", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/31/34815827.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9680320"}, {"article_id": "9680513", "title": "中職／張皓崴不擔心首打點遲到 追隨陳傑憲軌跡成長", "date": "2026-08-09 18:18", "thumbnail": "https://pgw.ud