/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35161103.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9644710"}, {"article_id": "9641759", "title": "中職／「蝦輝」轉換身分貢獻更大 助陣悍將外野不再瞎揮", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35156672.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9641759"}, {"article_id": "9640253", "title": "日職／不像火腿留得住大谷翔平 軟銀又一個第一指名變空氣", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154117.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9640253"}, {"article_id": "9640269", "title": "鄭宗哲能在紅襪站穩嗎？三成打擊率背後真正的考驗才剛開始", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154156.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9640269"}]}, {"name": "最新文章", "articles": [{"article_id": "9647286", "title": "中職／陳仕朋94球飆首場無四死球完封勝 悍將6：0對戰獅隊5連勝", "summary": "富邦悍將隊左投陳仕朋相隔超過2個月重返一軍，今天在台南亞太棒球場對上統一獅隊，以94球投出生涯首場9局無四死球完封勝，也是首場「麥達克斯（Greg Maddux）完封勝」，有悍將打線和守備的幫忙，加上張育成本季第12轟加持，率領悍將以6：0打下二連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35165235.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 21:41", "link": "/news/story/7001/9647286"}, {"article_id": "9647192", "title": "日職／林安可對決北山亘基揮雙安敲長打 西武2：11不敵火腿", "summary": "日職西武獅隊昨天在延長賽擊敗火腿隊，今天2連戰第2場交手，反被火腿的強大火力狙擊，火腿單場敲3轟，以11：2拿下勝利；西武隊台灣外野手林安可此戰先發上陣，敲雙安還有長打表現、跑回全隊第1分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35165140.jpg&M=1&s=Y&x=0&y=102&sw=1275&sh=850&exp=3600&sl=W&fw=360", "date": "2026-07-23 20:30", "link": "/news/story/7001/9647192"}, {"article_id": "9647167", "title": "韓職／王彥程7局失2分優質先發、賞7K飆152公里 收下本季8勝", "summary": "效力於韓職韓華鷹隊的台灣左投王彥程，今天首度前進光州，客場出戰起亞虎隊，繳出7局僅失2分的優質先發、送出7次三振，本季第2度投滿7局，最快球速則飆到赴韓後最速的152公里；「愛彥程打線」此戰也給予強大的火力支援，最終韓華以9：3拿下勝利，王彥程收下本季第8勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35165203.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 20:20", "link": "/news/story/7001/9647167"}, {"article_id": "9647116", "title": "網球／連五場超級搶十奪勝 詹皓晴布拉格逆轉闖4強", "summary": "我國網球女將詹皓晴上一站在雅典女網賽終結超過27個月「冠軍荒」，和日本搭檔加藤未唯轉戰布拉格延續勝場，名列第3種子的台日組合今天碰波蘭法爾科夫絲卡（Weronika Falkowska）／美國史密絲（Alana Smith）雖失去首盤，但演出逆轉勝，跨站連5場都打到「超級搶10」出線，挺進布拉格女網賽最終4強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35165023.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 19:56", "link": "/news/story/7005/9647116"}, {"article_id": "9647060", "title": "亞運／網球隊總教練謝政瀛捲場外風波 網協強調不預設立場", "summary": "2026年名古屋亞洲運動會網球代表隊總教練謝政瀛，近日捲入場外私領域風波引發話題，中華網協在今天也發出聲明強調，在與謝政瀛聯繫後他否認相關指控，事件具體事實及相關責任仍有待權責機關進一步釐清，網協將不會預設立場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_1.jpg", "date": "2026-07-23 19:20", "link": "/news/story/7005/9647060"}, {"article_id": "9647059", "title": "足球／亞運女足分組出爐 足協理事長：新教練領軍衝擊4強", "summary": "名古屋亞運女足分組抽籤結果今天出爐，中華女足本屆與強敵日本、泰國、越南同組，中華足協理事長張璨今天受訪時指出，雖然同組有勁敵日本，但在分組態勢與新任比利時籍總教練帶領下，球隊呈現出與過往截然不同的新氣象，將以衝擊4強為目標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164898.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 19:18", "link": "/news/story/7005/9647059"}, {"article_id": "9647025", "title": "桌球／WTT烏蘭巴托支線賽 16歲洪哲硯男單奪冠", "summary": "台灣16歲小將洪哲硯，今天在世界桌球職業大聯盟（WTT）烏蘭巴托支線賽男單決賽，以12比10、12比10、11比9擊敗新...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164887.jpg&M=1&s=Y&x=0&y=402&sw=1108&sh=739&exp=3600&sl=W&fw=360", "date": "2026-07-23 19:11", "link": "/news/story/7005/9647025"}, {"article_id": "9646875", "title": "亞運／葉芝妤成首名電競亞運女國手 背後是媽媽不設限支持", "summary": "從幼稚園就開始接觸電競的葉芝妤，如今將代表中華隊征戰名古屋亞運，締造隊史首名女選手里程碑，而追夢背後正是媽媽給予全力支持，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164655.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 17:57", "link": "/news/story/7005/9646875"}, {"article_id": "9646790", "title": "世足賽／控冠軍戰裁判「被收買」 阿根廷6萬球迷發起連署要求重賽", "summary": "2026美加墨世界盃足球賽日前落幕，冠軍戰由西班牙以1：0擊敗阿根廷，不過有一名阿根廷球迷桑契斯（Gisela Sánchez）發起連署，目前5.9萬名阿根廷人加入連署，抗議世界盃決賽裁判表現「充滿爭議且腐敗」，要求國際足總（FIFA）考慮重賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164452.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 17:04", "link": "/news/story/123107/9646790"}, {"article_id": "9646729", "title": "NBA／鮑爾爆湖人昔日內幕！教練竟要求藍道「只准擋人搶籃板」", "summary": "前湖人榜眼鮑爾（Lonzo Ball）近日在自家節目分享生涯趣事，其中，他便回憶當年效力湖人時，曾親眼看到教練團要求藍道（Julius Randle）「只要擋人、搶籃板，其他什麼都不要做」，讓他直呼難以理解，認為這樣反而會限制球員成長。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164305.jpg&M=1&s=Y&x=0&y=15&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-23 16:49", "link": "/news/story/7002/9646729"}, {"article_id": "9646669", "title": "世足賽／FIFA調查冠軍賽後衝突 阿根廷助理教練公開致歉", "summary": "阿根廷助理教練艾雅拉今天針對他在世界盃冠軍賽後，跟西班牙隊中場球員奧爾莫發生的肢體衝突致歉，國際足球總會（FIFA）正對...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164239.jpg&M=1&s=Y&x=63&y=0&sw=1217&sh=811&exp=3600&sl=W&fw=360", "date": "2026-07-23 16:17", "link": "/news/story/123107/9646669"}, {"article_id": "9646685", "title": "足球／安聯小小世界盃決賽8月北田登場 首辦U15國際邀請賽", "summary": "全台規模最大、最具國際視野的基層足球盛宴「2026安聯小小世界盃」，歷經全國八大賽區、長達三個月的激烈預賽後，最終70支菁英隊伍脫穎而出，將於8月1日至2日在台北市立田徑場展開總決賽爭霸。今年賽事除吸引1185隊熱情參與，更迎來全新里程碑，首度舉辦「U15國際足球友誼邀請賽」，開創台灣基層足球國際交流新頁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164237.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 16:15", "link": "/news/story/7005/9646685"}, {"article_id": "9646581", "title": "世足賽／不花一分錢行銷！內褲公司靠亞馬爾「脫褲」一下就爆紅", "summary": "西班牙球星亞馬爾在世足賽中多次露出內褲品牌「6PM」，讓該公司在沒有投放廣告的情況下爆紅。該品牌的內褲迅速熱銷，兩件僅售30歐元，受艾馬爾的影響，已為全球廣為人知。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164056.jpg&M=1&s=Y&x=0&y=282&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-23 16:12", "link": "/news/story/123107/9646581"}, {"article_id": "9646663", "title": "MLB／「3分砲就是0好3壞出棒的理由」 李灝宇獲小熊主帥和右投稱讚", "summary": "台灣好手李灝宇今天在0好3壞情況下轟出3分砲，幫助老虎隊終場以5：1拿下勝利，也讓小熊總教練康索（Craig Counsell）也對李灝宇印象深刻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164201.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-23 16:09", "link": "/news/story/6999/9646663"}, {"article_id": "9646618", "title": "MLB／紅襪無緣隊史16連勝仍創驚奇！康崔拉斯喊話：我們可以擊敗任何球隊", "summary": "紅襪雖然無緣改寫隊史16連勝紀錄，但15連勝已為開季低迷的狀態注入強心針。代理總教練崔西（Chad Tracy）、康崔拉斯（Willson Contreras）與格雷（Sonny Gray）賽後都鼓勵全隊放下失利，強調球隊已經證明有能力擊敗任何對手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164120.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-23 15:56", "link": "/news/story/6999/9646618"}, {"article_id": "9646567", "title": "MLB／欣慰李灝宇打球更放鬆 老虎教頭讚：擊球強度不輸任何人", "summary": "台灣好手李灝宇今天敲出3分砲，幫助老虎隊以5：1擊敗小熊隊。老虎總教練辛區（A.J. Hinch）對於李灝宇的進步感到欣慰，也談到自己信任李灝宇的原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164003.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-23 15:40", "link": "/news/story/6999/9646567"}, {"article_id": "9646572", "title": "世足賽／拿完金球獎完成大滿貫 西班牙隊長將動刀", "summary": "「無敵艦隊」西班牙在本屆世界盃足球賽冠軍戰以1：0擊敗衛冕軍阿根廷，奪下隊史第2冠，且包辦三大獎，年僅19歲的庫巴西（Pau Cubarsi）獲得最佳年輕球員（Best Young Player）、門將西蒙（Unai Simon）奪下金手套獎（Golden Glove），隊長羅德里（Rodri）拿下金球獎（Golden Ball），不過羅德里結束世界盃後將動手術，且還沒復出時間表。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164012.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 15:30", "link": "/news/story/123107/9646572"}, {"article_id": "9646480", "title": "MLB／李灝宇解釋0好3壞出棒 洋基柯爾幫助打右投更有信心", "summary": "老虎隊台灣好手李灝宇今天敲出3分砲，幫助球隊以4：1拿下勝利，他賽後受訪時提到為何重返大聯盟後表現變好，以及0好3壞揮棒的原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35163820.jpg&M=1&s=Y&x=22&y=27&sw=827&sh=551&exp=3600&sl=W&fw=360", "date": "2026-07-23 15:07", "link": "/news/story/6999/9646480"}, {"article_id": "9646426", "title": "MLB／道奇捕手怒吼跑者登熱搜！拉辛：X的滾回去", "summary": "道奇年輕捕手拉辛（Dalton Rushing）日前才因與大谷翔平的互動引發外界討論，如今又因場上一段激動喊話成為焦點。今日拉辛在費城人之戰完成精彩守備後，當場朝跑者史考特（Bryon Scott）怒吼，「給我他X的滾回去」，火爆畫面也迅速在社群媒體瘋傳。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35163647.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 14:43", "link": "/news/story/6999/9646426"}, {"article_id": "9646453", "title": "NBA／詹姆斯會加入勇士？大兒子笑回：如果去會很瘋狂", "summary": "詹姆斯（LeBron James）下一步究竟要去哪，仍是今年NBA休賽季最大謎團，就連詹姆斯的大兒子布朗尼（Bronny James）都不知道。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35163707.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 14:39", "link": "/news/story/7002/9646453"}, {"article_id": "9646377", "title": "中國羽賽／周天成闖8強 明戰地主球王石宇奇", "summary": "我國羽球「一哥」周天成今天在中國公開賽直落2拍下日本好手奈良岡功大，8強門票到手，明天將對決地主「世界球王」石宇奇，爭取4強資格。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35163606.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-23 14:07", "link": "/news/story/7005/9646377"}, {"article_id": "9646215", "title": "MiLB／3A台灣內戰林昱珉投5.1局奪勝 費爾柴德選保送", "summary": "美國職棒小聯盟（MiLB）3A今天上演台灣隊內戰，響尾蛇隊投手林昱珉5.1局失3分拿下勝投，與水手隊野手費爾柴德2度對決1...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35163464.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-23 13:59", "link": "/news/story/6999/9646215"}, {"article_id"