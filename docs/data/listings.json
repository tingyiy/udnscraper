e_id": "9671549", "title": "中職／擴編選秀CP值最高球員！ 陳文杰蛻變雄鷹王牌球星", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200626.jpg&M=1&s=Y&x=0&y=49&sw=1055&sh=703&exp=3600&w=300", "link": "/news/story/122629/9671549"}, {"article_id": "9671568", "title": "續約杜倫難解又沒第二持球點 活塞無作為的休賽季打什麼算盤？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200680.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9671568"}, {"article_id": "9668253", "title": "中職／至今找不到第4名可用洋投 中信洋投海戰術面臨失敗", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35196038.jpg&M=1&s=Y&x=0&y=33&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9668253"}, {"article_id": "9667721", "title": "史庫柏交易看似離譜 實則是豪門與小市場球隊現實差距", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35195501.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9667721"}, {"article_id": "9668273", "title": "綠衫軍想掀交易大浪？勇士FA市場零補強又浪費柯瑞一季", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35196090.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9668273"}, {"article_id": "9665984", "title": "中職／江坤宇挑戰游擊金手套7連霸 先跨過張政禹這一關", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192909.jpg&M=1&s=Y&x=32&y=0&sw=1226&sh=817&exp=3600&w=300", "link": "/news/story/122629/9665984"}]}, {"name": "最新文章", "articles": [{"article_id": "9672246", "title": "MLB／近27場豪取24勝！紅襪單場狂敲15安、4轟血洗白襪", "summary": "開季前幾個月，紅襪全壘打數一度在大聯盟敬陪末座，不過近期打線火力大爆發，球隊先在客場3連戰橫掃道奇，今日更狂敲15支安打、轟出4支全壘打，最終以14比2大勝美中龍頭白襪。球隊近兩場比賽累積高達8轟，自明星賽後更累積30發全壘打，高居大聯盟第2，僅次於勇士。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201833.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-05 14:15", "link": "/news/story/6999/9672246"}, {"article_id": "9672301", "title": "中職／中信兄弟《決戰無限城》主題日9月登台北大巨蛋 門票6日開賣", "summary": "中信兄弟將在9月18日至20日於台北大巨蛋與話題動漫作品《鬼滅之刃》攜手，舉辦《決戰無限城》主題日，今天率先公開活動主視覺，並同步揭曉全新聯名球衣及限定入場贈品。門票將於8月6日正式開賣，邀請球迷一同踏入《決戰無限城》，感受棒球與《鬼滅之刃》交織出的熱血魅力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201929.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-05 14:08", "link": "/news/story/7001/9672301"}, {"article_id": "9672250", "title": "TPBL／中信特攻洋將戰力大洗牌 禁區長人強斯加盟", "summary": "新北中信特攻隊持續完善新賽季戰力佈局，球團今天宣佈與美國籍禁區長人強斯（Marvin Jones）簽約，預計八月下旬抵台，未來將披上17號黃衫戰袍，成為特務軍團禁區的重要戰力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201831.png&M=1&s=Y&x=0&y=171&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-05 13:54", "link": "/news/story/7003/9672250"}, {"article_id": "9672153", "title": "世足賽／維德角40歲門神月薪智利第2高！足協開特例可使用「沃齊尼亞」", "summary": "維德角40歲門神沃齊尼亞（Vozinha）在世界盃足球賽成名，最終決定加盟智利豪門科洛科洛體育會，這是一份6個月短約，附帶延長1年選項，月薪約4700萬智利披索（約4.5萬歐元），在該聯賽僅次智利巨星比達爾（Arturo Vidal）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201695.jpg&M=1&s=Y&x=0&y=17&sw=1140&sh=760&exp=3600&sl=W&fw=360", "date": "2026-08-05 13:34", "link": "/news/story/7005/9672153"}, {"article_id": "9672036", "title": "TPBL／雲豹續約洋將米勒 全力衝擊冠軍", "summary": "桃園台啤永豐雲豹隊今天宣布，與主力洋將米勒（Malcolm Miller）完成續約。米勒上季在攻防兩端的卓越影響力有目共睹，是球隊不可或缺的靈魂人物，總經理顏行書說：「續約關鍵在於米勒是團隊上一個賽季防守的大腦核心，其防守效率與對團隊防守的影響力有目共睹，因而獲得所有教練團一致認同。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201486.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 12:41", "link": "/news/story/7003/9672036"}, {"article_id": "9672003", "title": "NBA／因熱火時期詹姆斯開始打球 埃奇庫姆談新隊友：以為教練在騙我", "summary": "76人隊在這個休賽季迎來震撼聯盟的重量級補強，超級巨星詹姆斯（LeBron James）宣布加盟，讓陣中年輕新星埃奇庫姆（VJ Edgecombe）直呼不可思議，近日受訪時透露，當初在訓練時得知消息還以為教練在開玩笑，直到球隊後勤群起奔告並看到社群推文證實，才確定啟蒙偶像真要變成隊友。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201456.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 12:28", "link": "/news/story/7002/9672003"}, {"article_id": "9671950", "title": "TPBL／國王續約沃許本攜手湯瑪士捍衛禁區 5洋將迎新賽季", "summary": "新北國王隊今天宣布繼續與禁區大將沃許本（Jason Washburn）合作，搭配日前宣布回鍋的湯瑪士，以及新加入的坦克夫、肯刀爾和克雷格，將以5位洋將陣容迎接新賽季。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201351.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-05 12:11", "link": "/news/story/7003/9671950"}, {"article_id": "9671890", "title": "MLB／道奇5連敗還傳壞消息！捕手拉辛UCL撕裂恐無法傳球", "summary": "道奇隊傳出壞消息，25歲捕手拉辛（Dalton Rushing）傷勢確定是尺側副韌帶（UCL）撕裂，將停止傳球數周。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201260.jpg&M=1&s=Y&x=0&y=0&sw=1170&sh=780&exp=3600&sl=W&fw=360", "date": "2026-08-05 12:01", "link": "/news/story/6999/9671890"}, {"article_id": "9671901", "title": "桌球／WTT冠軍賽橫濱站 林昀儒化解2賽末點仍輸球無緣16強", "summary": "WTT冠軍賽橫濱站今天展開32強賽程，我國一哥林昀儒遭遇南韓林鐘勳，在第4、5局兩度面臨對手賽末點的情況下，林昀儒雖然成功化解前2個賽末點，但仍是以11：9、9：11、7：11、13：11、9：11敗下陣來，苦吞對戰3連敗，無緣16強賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201310.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:57", "link": "/news/story/7005/9671901"}, {"article_id": "9671809", "title": "MLB／狂賭4100萬美元！地下組頭直言水原一平瘋狂到不可思議", "summary": "2025年大谷翔平前專屬翻譯水原一平震撼爆出盜用巨額資金案。近日，與水原合作經營非法地下簽賭的組頭鮑耶（Mathew Bowyer）首度公開更多細節，直言水原的賭博行為「簡直瘋狂到不可思議」，甚至坦言自己「從沒看過這種人」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201158.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:52", "link": "/news/story/6999/9671809"}, {"article_id": "9671744", "title": "MLB／準備看《蜘蛛人：重生日》卻變離別日！拉契曼進戲院前遭交易沒心情看了", "summary": "金鶯日前震撼將當家明星捕手拉契曼（Adley Rutschman）交易至紅襪，而這位3屆明星捕手得知消息時，竟不是在球場，而是在電影院，原本準備和隊友一起欣賞《蜘蛛人：重生日》，卻因一通電話徹底改變了這一天。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200947.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:45", "link": "/news/story/6999/9671744"}, {"article_id": "9671789", "title": "NBA／尼克奪冠班底少一人！26歲中鋒傑米森轉戰暴龍", "summary": "據知名記者海恩斯（Chris Haynes）報導，上季效力尼克隊的中鋒傑米森（Trey Jemison）與暴龍隊達成協議，簽下雙向合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201092.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:28", "link": "/news/story/7002/9671789"}, {"article_id": "9671781", "title": "網球／持續休養腕傷 阿爾卡拉斯放棄大賽衛冕、美網也打問號", "summary": "西班牙前球王「小蠻牛」阿爾卡拉斯（Carlos Alcaraz）已經因手腕傷勢缺席溫布頓和法網，硬地賽程也受影響，確定缺席今年的辛辛納提名人賽，能否趕上月底登場的美網打上問號。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35201167.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:23", "link": "/news/story/7005/9671781"}, {"article_id": "9671753", "title": "全台首創森林、湖泊、海岸三大場域 台東首辦定向越野10月登場", "summary": "台東縣政府首度推出「2026台東定向越野－換個節奏野台東」，打造全台唯一結合森林、湖泊與海岸三大場域的定向越野活動，縣長饒慶鈴今公布活動將於10月3日在森林公園舉行，邀請民眾呼朋引伴報名，一起體驗融合運動、觀光與地方文化的全新旅遊方式。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200957.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:15", "link": "/news/story/7005/9671753"}, {"article_id": "9671741", "title": "TPBL／從桃園轉戰新竹 雙十製造機迪亞洛加盟攻城獅", "summary": "新竹御嵿攻城獅球團今天宣布與迪亞洛（Cheick Diallo）完成簽約，迪亞洛現年29歲，身高203公分、體重99公斤，上賽季效力桃園台啤永豐雲豹隊，新賽季將改披上紫色33號戰袍。迪亞洛上季在TPBL例行賽共出賽24場，場均能貢獻19分、11.6 籃板的「雙十」成績。其中更有13場比賽得分突破20分大關，並在6場賽事中搶下至少15籃板，展現穩定的攻防影響力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200938.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:12", "link": "/news/story/7003/9671741"}, {"article_id": "9671729", "title": "TPBL／遭CBA天津隊提前「官宣」 林庭謙傳返台加盟台新戰神", "summary": "在中國男子職業籃球聯賽（CBA）效力長達6個賽季的我國明星後衛林庭謙，確定結束旅外生涯，今天天津榮鋼籃球俱樂部發表官方聲明，證實與林庭謙的合約已正式到期，儘管球團開出最高規格的「滿額頂薪」極力挽留，但在考量個人生涯規劃後，林庭謙最終選擇重返台灣職籃，甚至爆料他確定加盟TPBL台北台新戰神隊，為國內籃壇震撼彈再添一筆。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200932.jpg&M=1&s=Y&x=376&y=263&sw=854&sh=570&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:07", "link": "/news/story/7003/9671729"}, {"article_id": "9671704", "title": "MLB／史庫柏轉隊首戰6局失2分 大谷連8場安打都救不了道奇5連敗", "summary": "道奇隊在交易大限前網羅兩屆美聯塞揚獎強投史庫柏（Tarik Skubal），今天披上道奇戰袍第一場先發，儘管繳出6局失2分的優質先發，也沒能幫助球隊走出近期的低潮，道奇全場僅4安、大谷翔平4支1，終場以1：5不敵小熊隊，吞下本季最長5連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200891.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 11:00", "link": "/news/story/6999/9671704"}, {"article_id": "9671644", "title": "NBA／KD吹捧76人更踩勇士舊隊友！K湯、格林開酸：忘了切小帳嗎？", "summary": "杜蘭特（Kevin Durant）日前一句「現在的76人紙面陣容比2016-17賽季勇士更強」，不僅引發球迷熱議，就連昔日勇士冠軍隊友湯普森（Klay Thompson）與格林（Draymond Green）也忍不住開酸，甚至調侃杜蘭特是不是忘了切換自己的「小帳」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200765.jpg&M=1&s=Y&x=0&y=0&sw=1156&sh=771&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:57", "link": "/news/story/7002/9671644"}, {"article_id": "9671695", "title": "網球／周杰倫曾參賽、葛蘭喬安娜勇闖決賽 一分大滿貫明年重返澳網", "summary": "今年澳網開打前的「一分大滿貫（1 Point Slam）」，我國女將葛蘭喬安娜一路挺進決賽，這項充滿話題的賽事確定明年持續舉辦。澳網今天宣布，這項受到觀眾喜愛的賽事，明年將於正式賽程前再次舉行，且會先舉行資格賽，正式賽程的獎金高達100萬澳幣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200868.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:56", "link": "/news/story/7005/9671695"}, {"article_id": "9671594", "title": "NBA／76人戰力超越2017宇宙勇士？格林不認同KD「得分至上」看法", "summary": "76人今夏成功簽下NBA歷史得分王詹姆斯（LeBron James）後，外界也將這次組隊與杜蘭特（Kevin Durant）2016年加盟勇士相提並論。對此，勇士老將格林（Draymond Green）近日在自己的節目中表示，雖然尊重杜蘭特的看法，但他並不認為如今76人的紙面陣容比2016-17賽季的勇士更強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200769.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:44", "link": "/news/story/7002/9671594"}, {"article_id": "9671632", "title": "中職／為何「財富自由」還要當教練？徐展元曝王建民4字回應", "summary": "知名主播徐展元日前重返中職轉播台，在現場與中信兄弟隊投手教練王建民相見歡，聊天過程中得知，為何王建民已財富自由還要工作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200754.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:37", "link": "/news/story/7001/9671632"}, {"article_id": "9671568", "title": "續約杜倫難解又沒第二持球點 活塞無作為的休賽季打什麼算盤？", "summary": "活塞隊在休賽季面臨續約中鋒杜倫的僵局，儘管他在例行賽表現出色，但季後賽表現不佳令他未能把握頂薪機會。球隊需要專注於增強陣容深度，尤其是尋找合格的二號持球點以支援康寧漢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200680.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:32", "link": "/news/story/122629/9671568"}, {"article_id": "9671549", "title": "中職／擴編選秀CP值最高球員！ 陳文杰蛻變雄鷹王牌球星", "summary": "陳文杰在中職台鋼雄鷹成功蛻變，打擊率超過3成，守備獲金手套，入選明星賽，成為隊伍核心。曾在二軍榮獲九項獎項的他，透過擴編選秀迎接轉折，展現出色表現，成為看板球星。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200626.jpg&M=1&s=Y&x=0&y=49&sw=1055&sh=703&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:08", "link": "/news/story/122629/9671549"}, {"article_id": "9671485", "title": "MLB／洋基游擊新希望？隆巴德初登場就開轟助隊完封紅雀", "summary": "洋基隊農場頭號大物隆巴德（George Lombard Jr.）生涯初登場，成為全場球迷焦點，歡呼聲響徹整座洋基球場，隆巴德沒讓球迷失望，不只上演美技守備，還擊出生涯首轟，幫助洋基終場以2：0完封紅雀隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200561.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:00", "link": "/news/story/6999/9671485"}]}, {"name": "棒球", "articles": [{"article_id": "9671632", "title": "中職／為何「財富自由」還要當教練？徐展元曝王建民4字回應", "date": "2026-08-05 10:37", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/p