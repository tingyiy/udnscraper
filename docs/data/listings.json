o.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35184921.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9658615"}, {"article_id": "9656701", "title": "中職／兄弟扭轉戰局只能大破大立 下半季或可直接練兵看未來", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178825.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9656701"}, {"article_id": "9656339", "title": "詹姆斯空降費城 老皇帝「Last Decision」的盤算與負重", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178319.jpg&M=1&s=Y&x=0&y=13&sw=1073&sh=715&exp=3600&w=300", "link": "/news/story/122629/9656339"}, {"article_id": "9656390", "title": "湖人不惜梭哈也要得手 凱斯勒是唐西奇遇過最好禁區搭檔！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178373.jpg&M=1&s=Y&x=0&y=53&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9656390"}]}, {"name": "最新文章", "articles": [{"article_id": "9664658", "title": "NBA／結束30年婚姻 籃網隊老闆蔡崇信與妻子宣布離婚", "summary": "阿里巴巴集團主席蔡崇信與結縭30年的妻子吳明華宣布離婚。蔡崇信另身兼美國職籃NBA布魯克林籃網隊老闆，而吳明華則是美國女...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190751.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 14:06", "link": "/news/story/7002/9664658"}, {"article_id": "9664657", "title": "MLB／本季0勝8敗、防禦率8.66 千賀滉大談臨時先發：有一點害怕", "summary": "大都會隊今天臨時取消佩洛塔（Freddy Peralta）先發，日本33歲右投千賀滉大臨危授命登板，主投4局丟3分，大都會最終以2：5輸給馬林魚隊，千賀苦吞本季第8敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190707.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 13:52", "link": "/news/story/6999/9664657"}, {"article_id": "9664639", "title": "圖輯／台北羽賽楊博軒、胡綾芳台灣內戰勝出 明力拼混雙冠軍", "summary": "台北羽球公開賽混雙四強賽上演台灣內戰，楊博軒與胡綾芳組合以26：24、21：17擊敗李佳馨與吳冠勳組合，晉級冠軍賽。兩人曾於2024年台北公開賽闖進冠軍賽，可惜最終以亞軍作收，明天將再度挑戰，力拼終結台灣混雙在台北羽賽的冠軍荒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190670.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-01 13:41", "link": "/news/story/7005/9664639"}, {"article_id": "9664632", "title": "台北羽賽／拍退混雙情侶檔 楊博軒／胡綾芳晉級決賽明拚紀錄", "summary": "BWF超級300的台北羽球公開賽今天展開4強賽程，其中混雙賽場上也上演台灣內戰，由第二種子的楊博軒／胡綾芳出戰情侶檔吳冠勳／李佳馨，最終由楊博軒／胡綾芳以26：24、21：17搶下決賽門票，明天將有機會問鼎賽會首對台灣純本土混雙冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190650.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 13:38", "link": "/news/story/7005/9664632"}, {"article_id": "9664614", "title": "圖輯／台北羽賽黃宥薰直落二不敵印度選手 止步女單四強", "summary": "台北羽球公開賽女子組單打四強賽，我國好手黃宥薰以17：21、11：21不敵印度選手坦維夏爾馬（Tanvi Sharma），雖然止步四強，但仍創下個人在台北羽球公開賽的最佳成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190617.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 13:32", "link": "/news/story/7005/9664614"}, {"article_id": "9664596", "title": "自由車／96聯賽首度前進上海 葉軒佑、謝昊軒奪冠滿載而歸", "summary": "台灣指標性自由車賽事「96聯賽」今年首度跨出台灣，將海外交流站納入年度賽事版圖，首站前進上海崇明島，分別舉行個人計時賽與公路繞圈賽。台灣U23好手謝昊軒在個人計時賽奪冠、葉軒佑獲得亞軍；兩人隨後於公路繞圈賽互換名次，由葉軒佑拿下冠軍、謝昊軒位居第二。除了賽事成績亮眼，台灣年輕選手也透過與上海當地及青訓隊伍交流，體驗不同的競賽強度、戰術思維與培訓環境，為96聯賽首次海外交流寫下成功的一頁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190593.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 13:17", "link": "/news/story/7005/9664596"}, {"article_id": "9664572", "title": "MLB／今永昇太6.2局挨2轟苦等不到火力 小熊慘遭洋基完封", "summary": "小熊與洋基3連戰系列賽首戰，交給前面兩次登板皆無失分、近況出色的日籍投手今永昇太先發主投，雖然他繳出6.2局僅被敲4支安打、失2分，送出6次三振且沒有保送的優質內容，但小熊打線全場受制，最終以0：2遭到洋基完封。今永昇太吞下本季第9敗，戰績來到7勝9敗，防禦率則是3.67。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190554.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 13:14", "link": "/news/story/6999/9664572"}, {"article_id": "9664547", "title": "NBA／33歲浪人後衛宣布退休 10年生涯效力6隊：我已毫無遺憾", "summary": "33歲的浪人後衛理查森（Josh Richardson）正式宣布結束球員生涯，這名身高6呎5吋（約196公分）的老將，在NBA一共征戰10個賽季，分別效力過6支球隊後。上季他曾有部分時間轉往西班牙打球，如今透過個人社群平台確認退休消息。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190511.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 12:55", "link": "/news/story/7002/9664547"}, {"article_id": "9664542", "title": "「2026第十屆桃園盃全國三對三籃球賽」 結合珍珠海岸音樂季籃下開戰", "summary": "「2026第十屆桃園盃全國三對三籃球賽」今（1）日上午於竹圍漁港天幕廣場盛大開幕，由桃園市長張善政親自出席開幕儀式，並宣布賽事正式開打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190493.jpg&M=1&s=Y&x=0&y=71&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 12:54", "link": "/news/story/7003/9664542"}, {"article_id": "9664533", "title": "MiLB／鄭宗哲有長打單場雙安 鄧愷威滿壘登板連飆2K", "summary": "紅襪隊台灣內野手鄭宗哲日前被下放到3A，今天擊出雙安。被太空人隊下放至3A的台灣鄧愷威滿壘拆彈，主投0.2局0失分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190471.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 12:41", "link": "/news/story/6999/9664533"}, {"article_id": "9664513", "title": "MLB／老虎21歲頭號新秀初登場就猛打賞 李灝宇2打數0安被換代打", "summary": "老虎隊台灣內野手李灝宇前役中斷連12場安打，之後連兩場出賽打擊熄火，今天對上運動家隊2打數沒有安打、吞下1K，之後就被換代打退場，打擊率稍降至2成69，而老虎在比賽後段打擊大爆發，最後兩局豪取11分，終場以13：1大勝收場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190461.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 12:29", "link": "/news/story/6999/9664513"}, {"article_id": "9664481", "title": "MLB／金鶯給卡諾2年合約 將先發右投克里莫交易至雙城", "summary": "金鶯隊今天續約牛棚右投卡諾（Yennier Cano），接著又將先發右投克里莫（Dean Kremer）交易至雙城隊，換回小聯盟外野手雷耶斯（Jhomnardo Reyes）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190402.jpg&M=1&s=Y&x=0&y=142&sw=1067&sh=711&exp=3600&sl=W&fw=360", "date": "2026-08-01 12:09", "link": "/news/story/6999/9664481"}, {"article_id": "9664475", "title": "MLB／大谷翔平重返先發敲超前2分砲！擊球初速180公里怪力轟", "summary": "道奇隊日籍二刀流球星大谷翔平因膝傷休息1天後，今天對上紅襪隊系列賽首戰重返先發陣容，並在5局下轟出一發逆轉2分砲，本季第24轟出爐，也是他近3場出賽敲的第2轟，助道奇以4：3超前比數。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190464.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 12:02", "link": "/news/story/6999/9664475"}, {"article_id": "9664321", "title": "高球／LPGA英國公開賽第二輪 徐薇淩並列第45名晉級、曾雅妮遭淘汰", "summary": "台灣女子職業高爾夫好手徐薇淩今天在LPGA英國女子公開賽第2回合沒有博蒂入袋，另吞3柏忌繳出74桿，仍以2天高於標準3桿...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190321.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 11:44", "link": "/news/story/7005/9664321"}, {"article_id": "9664410", "title": "MLB／被太空人教頭調往牛棚 今井達也：當初以先發身分簽我", "summary": "太空人隊總教練艾斯帕達（Joe Espada）今天宣布，將日本28歲右投今井達也調往牛棚，今井達也受訪時表示，接受這個安排。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190297.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 11:30", "link": "/news/story/6999/9664410"}, {"article_id": "9664387", "title": "日職／接受身體衰退現實！陽岱鋼淚灑引退記者會 稻葉篤紀驚喜現身", "summary": "效力Oisix新潟的台灣外野手陽岱鋼今天在新潟市內飯店舉行引退記者會，正式說明本季結束後結束現役球員生涯的決定。這名曾效力北海道日本火腿鬥士與讀賣巨人的39歲老將，從台灣赴日追夢，在異鄉展開長達21年的職棒旅程，如今帶著眼淚與感謝向球場告別。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190259.jpg&M=1&s=Y&x=0&y=0&sw=955&sh=637&exp=3600&sl=W&fw=360", "date": "2026-08-01 11:18", "link": "/news/story/7001/9664387"}, {"article_id": "9664375", "title": "PLG／富邦勇士與莫巴耶續約 許晉哲期許扛起未來核心責任", "summary": "台北富邦勇士隊今天宣布，正式與球員莫巴耶（Mouhamed Lamine Mbaye）完成續約，雙方將攜手迎接新賽季，持續朝更高目標邁進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190247.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-01 11:09", "link": "/news/story/7003/9664375"}, {"article_id": "9664347", "title": "MLB／村上宗隆6天4轟趕進度 攜手白襪辦慈善拍賣援助家鄉熊本", "summary": "芝加哥白襪日籍重砲村上宗隆今天面對坦帕灣光芒之戰敲出相隔2場後的本季第24轟，不只追平藍鳥的日本同袍岡本和真保持的日本球員大聯盟新人年全壘打紀錄，也幫助白襪以6：1拿下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190220.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 10:54", "link": "/news/story/6999/9664347"}, {"article_id": "9664340", "title": "MLB／李灝宇表現超乎預期！美作家分析打擊型態和未來定位", "summary": "老虎隊台灣好手李灝宇最近打擊手感火燙，美媒《Just Baseball》作家史諾登（Clay Snowden）撰文分析李灝宇站穩大聯盟的關鍵，以及未來在球隊的定位。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190213.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 10:51", "link": "/news/story/6999/9664340"}, {"article_id": "9664328", "title": "MLB／村上宗隆近6戰4轟趕進度 本季24轟追上岡本和真新人紀錄", "summary": "白襪隊日籍重砲村上宗隆今天敲出本季第24發全壘打，近6場比賽敲4轟趕進度，追平藍鳥隊岡本和真日前寫下的大聯盟日籍球員菜鳥球季最多轟紀錄，終場白襪也以6：1擊敗光芒隊，續居美聯中區龍頭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190207.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 10:42", "link": "/news/story/6999/9664328"}, {"article_id": "9664326", "title": "陳彥博挑戰天山山脈傳捷報 勇奪吉爾吉斯200km超馬總冠軍", "summary": "極地超級馬拉松運動員陳彥博昨天於「吉爾吉斯200公里高山超馬分站賽」傳回捷報，儘管賽前因水土不服出現腹痛與過敏反應等身體不適，陳彥博自首日起便展現強大策略與配速，克服水土不服與高強度的體能消耗，最終以累計總時間37小時13分鐘57秒順利完成賽事，勇奪本屆賽事總冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190187.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-01 10:39", "link": "/news/story/7005/9664326"}, {"article_id": "9664317", "title": "NBA／續約黑衫軍後再獲球鞋長約 溫班亞瑪將推Nike專屬簽名鞋", "summary": "在日前剛與黑衫軍馬刺隊簽下一份5年2.52億美元（約台幣82.6億元）的頂級續約後，馬刺溫班亞瑪（Victor Wembanyama）也再度展現自己的商業價值，據美國媒體今天報導，這名年僅22歲的法國天才長人已與運動品牌Nike達成長期續約協議，並將推出個人首款專屬簽名球鞋。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/01/35190210.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-01 10:34", "link": "/news/story/7002/966