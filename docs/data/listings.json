le_id": "9897021", "title": "向下沈淪一言難盡 墨瑞喊「賣我」成壓垮鵜鶘最後稻草", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546242.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9897021"}, {"article_id": "9894619", "title": "中職／3大年輕「台製潛水艇」國際賽發光 壓制左打未來才能發熱", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542170.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9894619"}, {"article_id": "9894636", "title": "道奇用兩名普通球員就換來雙城前狀元 這帳是怎麼算的？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542228.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9894636"}]}, {"name": "最新文章", "articles": [{"article_id": "9902186", "title": "UBA／健行驚奇續命 OT斷台藝大4連勝", "summary": "115學年度UBA富邦人壽大專籃球聯賽男一級預賽第一階段，今天上演5天來最血脈賁張的一役，健行科大一度領先10分，但第四節被上季第三臺藝大拉出11：2攻勢，反以66：71落後，靠大一菜鳥射手余玄胤三分彈、廖本謙切入，最後5.9秒陳威宇抄球上籃，回敬7：2，新外援賈馬爾壓哨火鍋，封阻臺藝的切入，73：73進入延長賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35554012.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 22:12", "link": "/news/story/7003/9902186"}, {"article_id": "9902185", "title": "TPBL／賽前吊點滴又趕回執教 簡浩談夢想家連敗：傷兵多少有影響", "summary": "TPBL衛冕軍福爾摩沙夢想家可說是屋漏偏逢連夜雨，不僅近期傷兵滿營，總教練簡浩還在今天主場出戰新竹御嵿攻城獅前，因為身體不適前去吊點滴，儘管他仍趕回執教，但夢想家最終仍是以5分差距不敵攻城獅，苦吞4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35554011.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 22:12", "link": "/news/story/7003/9902185"}, {"article_id": "9902184", "title": "HBL／相隔292天！188公分中鋒喬麗爾歸隊助永仁開胡", "summary": "115學年度HBL女子組12強預賽第2日，今年2月初受傷左膝十字韌帶撕裂傷的永仁高中188公分中鋒喬麗爾，終於在相隔292天後重新踏上聯賽舞台，即便上場不到5分鐘，2次出手皆落空，但抓下1顆籃板，並在一對一防守時展現牽制力，幫助永仁高中最後以99：67大勝淡水商工。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35554010.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 22:11", "link": "/news/story/7003/9902184"}, {"article_id": "9902118", "title": "TPBL／衛冕軍夢想家輸到止不住 不敵攻城獅苦吞4連敗", "summary": "開季前5場比賽僅拿下1勝，其中包括近期3連敗的TPBL衛冕軍福爾摩沙夢想家，今天繼續在主場迎戰新竹御嵿攻城獅，第四節攻城獅一度領先達到18分，儘管夢想家在比賽最後9分鐘一度吹起反攻號角追到1分差距，但卻在比賽最後4分鐘熄火，最終就以78：83苦吞4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553947.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=787&exp=3600&sl=W&fw=360", "date": "2026-11-25 21:37", "link": "/news/story/7003/9902118"}, {"article_id": "9902030", "title": "亞太天主教大學運動會輔大男足6球完勝西江大學 不只拚冠軍更重交流", "summary": "輔大男足以6：0擊敗韓國西江大學，傅鼎睿梅開二度；明日出戰冠軍戰，教練盼兼顧爭冠與國際交流，並讓年輕球員累積經驗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553744.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 20:37", "link": "/news/story/7005/9902030"}, {"article_id": "9901923", "title": "UBA／台師大飆分破百 退台科大止敗", "summary": "115學年度UBA富邦人壽大專籃球聯賽公開男一級預賽第一階段持續在文化大學進行，臺灣師大今天碰台灣科大飆分破百，最終以104：77輕取相隔兩季重返一級的臺科大，第二勝終於入袋，累計2勝3敗。臺師大教練李秉鴻說，26及27日最後2戰依序對中原大學和地主文化大學，務必要拿下，4勝3敗進入三及四階段，力拚重回八強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553638.jpg&M=1&s=Y&x=2&y=371&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-25 19:44", "link": "/news/story/7003/9901923"}, {"article_id": "9901912", "title": "羽球／國防部中將領軍出擊 兩隊晉級中央機關盃四強賽", "summary": "「115年中央機關盃羽球、匹克球大賽」今天進入第三天賽程，各組競爭日趨白熱化，羽球男子團體組及混合團體組四強隊伍正式出爐，女子團體組也將於26日進行分組冠軍交叉決賽，爭奪最後冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553626.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 19:34", "link": "/news/story/7005/9901912"}, {"article_id": "9901820", "title": "足球／招標流程、規劃未周全 足協宣佈暫停企甲轉播、菁英計畫2.0", "summary": "中華民國足球協會今天宣布，即日起暫停台灣企業甲級足球聯賽（企甲聯賽）轉播，待招標程序完成後，足協將依招標結果調整轉播規格，並另行公告後續轉播安排。另也將暫停辦理「菁英計畫2.0」所有活動，原訂於11月28日當天及其後舉行的活動均暫停。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553517.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 18:31", "link": "/news/story/7005/9901820"}, {"article_id": "9901818", "title": "日職／兩聯盟年度MVP揭曉 佐藤輝明二連霸、栗原陵矢首度獲獎", "summary": "日本職棒今天舉行頒獎典禮，兩聯盟年度MVP揭曉，中央聯盟由準備挑戰大聯盟的阪神隊強打佐藤輝明完成二連霸；太平洋聯盟則是由軟銀隊好手栗原陵矢首度獲獎，一口氣帶走4座獎項。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553515.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 18:31", "link": "/news/story/7001/9901818"}, {"article_id": "9901615", "title": "棒球／台灣看不到！李珠珢、邊荷律夢幻合體一起應援 網喊：太犯規", "summary": "在台灣擁有超高人氣的韓籍啦啦隊女神李珠珢、邊荷律、河智媛與金娜妍等人，即將在韓國同台應援，將在12月6日（週日）晚間6點30分（台灣時間5點30分），現身首爾高尺天空巨蛋舉行的「The Generation Match」，這也是「珠珠」李珠珢久違在韓國主場應援，令球迷直呼，「這組合太犯規！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553105.png&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-11-25 17:34", "link": "/news/story/7001/9901615"}, {"article_id": "9901593", "title": "NBA／戴維斯奪單周最佳球員 傳勇士等3隊有興趣交易", "summary": "巫師隊明星長人戴維斯（Anthony Davis）本季狀態不錯，上周率巫師隊3連勝，奪下單周最佳球員。有報導指出勇士、暴龍和老鷹對戴維斯有興趣，但巫師目前沒有交易打算。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553050.jpg&M=1&s=Y&x=451&y=44&sw=819&sh=546&exp=3600&sl=W&fw=360", "date": "2026-11-25 17:05", "link": "/news/story/7002/9901593"}, {"article_id": "9901542", "title": "亞太天主教大學運動會適應運動路跑登場 輔大推動運動平權", "summary": "「2026亞太天主教大學運動會適應運動路跑」今天清晨於輔仁大學田徑場登場，本賽會共有9個國家／地區、20所大專校院組團參賽，賽程現已進入第四天，各項競賽正持續熱烈進行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552961.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:47", "link": "/news/story/7005/9901542"}, {"article_id": "9901515", "title": "黑豹旗／饒又語傷後復出5.1局完美表現 穀保重返4強下一戰強碰平鎮", "summary": "穀保家商今天在黑豹旗16強賽對上高苑工商，饒又語先發5.1局連續解決16名打者，但傷後登板僅用58局收工，吳昊翔登板後被敲安打「完全比賽」破功，但仍替球隊守住勝利，穀保打線則在6局下猛攻6分大局，終場以7：0完封對手，重返4強，下一戰就要強碰衛冕軍平鎮高中。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552932.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:40", "link": "/news/story/7001/9901515"}, {"article_id": "9901508", "title": "NBA／金塊對獨行俠打得荒腔走板 穆雷痛批：本季打最爛一戰", "summary": "獨行俠隊今天在NBA盃分組賽以120：101成功踢館金塊隊主場，賽後獨行俠前鋒佛雷格（Cooper Flagg）盛讚球隊面對強敵仍堅持執行賽前計畫，並特別向傷癒歸隊的華盛頓（P.J. Washington）致敬；反觀主場吞敗的金塊氣氛低迷，後衛穆雷（Jamal Murray）直言這是球隊本季表現最糟的一戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552927.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:37", "link": "/news/story/7002/9901508"}, {"article_id": "9901495", "title": "MLB／把證據刪掉！守護者明星投手涉假球案 妻子簡訊曝光成關鍵證物", "summary": "前守護者投手歐提茲（Luis Ortiz）與明星終結者克拉塞（Emmanuel Clase），被控收錢投出指定球路，讓賭客在單球玩法上獲利後，近日兩人在布魯克林聯邦法院受審時，檢方又提出一項關鍵證物，竟是歐提茲妻子傳給他的簡訊，內容直接要他「把證據刪掉」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552906.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:36", "link": "/news/story/6999/9901495"}, {"article_id": "9901251", "title": "棒球／吳丞顥U23世界盃收穫多 加盟美職藍鳥盼證明不輸人", "summary": "吳丞顥結束U23世界盃棒球賽事後，與美職多倫多藍鳥隊正式簽約，他表示首度國家隊磨練收穫多；將與平鎮隊友蔡辰瀧、U23隊友...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552911.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:34", "link": "/news/story/7001/9901251"}, {"article_id": "9901497", "title": "高球／未來之星冬季賽 邱子睿、江曉春暫居領先", "summary": "2026未來之星系列賽冬季賽今天於苗栗全國花園鄉村俱樂部進行第二回合賽事，秋季賽冠軍邱子睿繳出75（+3）桿，以兩回合152（+8）桿躍居男子組單獨領先；田佾弘76桿，以155桿暫居第二，鄭以樂同樣以76桿完賽，累計156桿排名第三；首輪領先者譚傑升則打出82桿，兩輪158桿滑落至第四位。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552907.jpg&M=1&s=Y&x=0&y=0&sw=1191&sh=794&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:33", "link": "/news/story/7003/9901497"}, {"article_id": "9901473", "title": "MLB／前大都會投手、好萊塢男星陳屍樓梯間！警方報告竟「死因成謎」", "summary": "前白襪、大都會投手布洛威（Lance Broadway）退休轉戰好萊塢後，2013年以《全面攻佔：倒數救援》踏上大銀幕，也參與影集《路西法》與《神盾局特工》的演出。然而這位前選秀首輪投手日前被發現死在德州達拉斯一處公寓的樓梯間，享年43歲，死因至今仍未查明。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552840.jpg&M=1&s=Y&x=0&y=136&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:24", "link": "/news/story/6999/9901473"}, {"article_id": "9901434", "title": "NBA／湖人官方宣布與Kalshi合作 球迷痛批：賭博真噁心", "summary": "湖人隊今天宣布，與預測市場平台Kalshi建立合作夥伴關係。76人隊與NBA官方已在上個月宣布與Kalshi達成類似合作協議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552769.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 16:07", "link": "/news/story/7002/9901434"}, {"article_id": "9901388", "title": "MLB／史庫柏天價合約加盟大都會「不是為了錢！」 父親稱想奪冠遭美媒狠酸", "summary": "史庫柏以9年4.5億美元天價合約加盟大都會並刷新投手合約紀錄，父親稱為爭冠非為錢，惟美媒質疑球隊戰績與奪冠條件。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552703.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 15:59", "link": "/news/story/6999/9901388"}, {"article_id": "9901389", "title": "NBA／奪冠魔咒！唐西奇使用率嚴重超標 馬刺前球員唱衰指奪冠機率0", "summary": "湖人本季開局以15勝3敗戰績並列西區龍頭，唐西奇（Luka Doncic）更一度以場均38.1分，有望超越「籃球之神」喬丹（Michael Jordan），成為1976年NBA與ABA合併以來最高單季場均得分。然而曾在1999年隨馬刺奪冠的前球星艾略特（Sean Elliott），卻在馬刺擊敗國王後的轉播中，毫不客氣地唱衰湖人，直言湖人不會拿總冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552707.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 15:55", "link": "/news/story/7002/9901389"}, {"article_id": "9901330", "title": "NBA／哈登歷史地位超越魔術強森？白色巧克力：任何隊都能轟50分", "summary": "「大鬍子」哈登（James Harden）日前對陣溜馬隊狂砍51分，生涯第26場單場至少50分，超越布萊恩（Kobe Bryant）登歷史第3。騎士隊總教練亞特金森（Kenny Atkinson）受訪時稱讚哈登是歷史前十等級的球員。傳奇球星「白色巧克力」威廉斯（Jason Williams）最近在節目上更表示，哈登地位比魔術強森（Magic Johnson）還高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552579.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 15:32", "link": "/news/story/7002/9901330"}, {"article_id": "9901314", "title": "日職／加盟歐力士解鎖生涯第一次出國 「I人」許宸緯異鄉打拚一夕長大", "summary": "年僅18歲的右投許宸緯靠著高中三年身高、球速「暴衝」，為自己贏得畢業後旅日發展的機會，10月加盟歐力士隊，且生涯第一次搭飛機就是赴日簽約、秋訓，從獨自出國到參與秋訓的每個過程，都讓他快速成長並直呼「大開眼界」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552524.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 15:18", "link": "/news/story/7001/9901314"}, {"article_id": "9901219", "title": "MLB／塞揚強投變「相撲選手」史肯斯公主抱體操女神閃瞎粉絲", "summary": "海盜王牌史肯斯（Paul Skenes）平常在投手丘上對決的是大聯盟頂尖打者，這次休賽季卻化身「相撲選手」，跑到日本和相撲力士過招。根據《MLB.com》報導，2025年國聯塞揚得主史肯斯日前與辣模女友、前體操選手鄧恩（Livvy Dunne）一同造訪日本，行程從勞軍、觀光一路排到指導小球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552331.jpg&M=1&s=Y&x=192&y=0&sw=960&sh=640&exp=3600&sl=W&fw=360", "date": "2026-11-25 14:53", "link": "/news/story/6999/9901219"}]}, {"name": "棒球", "articles": [{"article_id": "9901615", "title": "棒球／台灣看不到！李珠珢、邊荷律夢幻合體一起應援 網喊：太犯規", "date": "2026-11-25 17:34", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553105.png&M=1&x=&y=&sw=&sh=&exp=3600&w=300", "link": "/news/story/7001/9901615"}, {"article_id": "9901084", "title": "黑豹旗／平鎮淘汰南英闖4強 龔永仁高一扛先發游擊敲關鍵一擊", "date": "2026-11-25 13:59", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35552092.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9901084"}, {"article_id": "9901818", "title": "日職／兩聯盟年度MVP揭曉 佐藤輝明二連霸、栗原陵矢首度獲獎", "date": "2026-11-25 18:31", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35553515.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9901818"}, {"article_id": "9901515", "title": "黑豹旗／饒又語傷後復出5.1局完美表現 穀保重返