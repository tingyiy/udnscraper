//uc.udn.com.tw/photo/t3/2026/07/29/35182174.jpg&M=1&s=Y&x=0&y=70&sw=1130&sh=753&exp=3600&sl=W&fw=360", "date": "2026-07-29 18:11", "link": "/news/story/7001/9658816"}, {"article_id": "9658749", "title": "中職／等了一年回一軍 黃恩賜一球未投又傷及右腳跟腱赴醫院檢查", "summary": "中信兄弟去年上半季的牛棚大將黃恩賜，進行骨刺手術後歷經一年才在本月26日重返一軍，不料一場未投，今天又賽前練習又出意外，因右腳跟腱疼痛突然被背下場，並且已赴醫院進行檢查。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35182028.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 17:52", "link": "/news/story/7001/9658749"}, {"article_id": "9658715", "title": "台北羽賽／金球拍幸運物加持 林俊易拍下奧運銅牌", "summary": "今年打下全英公開賽的「左手重砲」林俊易，今天以台北公開賽第二種子身份登場，面對東京奧運奪銅的印尼好手金廷（Anthony Sinisuka Ginting）以直落二過關，奪勝後開心舞動雙手慶祝的他也分享，脖子上有一個小四帶到現在的金球拍、羽球，是陪伴他走過低潮的幸運物。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181958.jpg&M=1&s=Y&x=0&y=0&sw=867&sh=578&exp=3600&sl=W&fw=360", "date": "2026-07-29 17:37", "link": "/news/story/7003/9658715"}, {"article_id": "9658620", "title": "田徑／中華田徑潛優隊熊本遇強震 教練：選手皆平安", "summary": "日本熊本縣昨天下午發生規模7.1強震，台灣田徑潛優代表隊當時正好在機場。隨隊教練陳鴻傑表示，「雖然是天災無可避免，小朋友...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181884.jpg&M=1&s=Y&x=0&y=73&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 17:21", "link": "/news/story/7005/9658620"}, {"article_id": "9658541", "title": "TPBL／充實禁區戰力 海神找來義大利國手", "summary": "高雄全家海神隊今天宣布簽下義大利裔的美籍球員貝西里（Grant Basile），現年26歲、身高206公分，主打禁區4、5號位置，上季效力義大利甲級聯賽坎圖籃球俱樂部（Acqua S.Bernardo Cantu）及波多黎各職業聯賽，並曾披上義大利國家隊戰袍，具有三分投射能力，同時具備高度防守意識。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181665.jpg&M=1&s=Y&x=1&y=291&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-29 16:19", "link": "/news/story/7003/9658541"}, {"article_id": "9658533", "title": "台北羽賽／目標「活久一點」 林湘緹喊要和邱品蒨會師決賽", "summary": "去年台北公開賽闖進女單8強，我國好手林湘緹今年成為女單「地主希望」，以第2種子身分出賽，坦言嘴上說沒壓力，心裡難免有，但仍希望能和頭號種子邱品蒨會師決賽，為地主留下好成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181647.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-29 16:16", "link": "/news/story/7005/9658533"}, {"article_id": "9658361", "title": "TPVL／台中連莊「小魔女啦啦隊」全員被Thank you 球迷超傻眼", "summary": "TPVL臺中連莊排球隊宣布，2025-26賽季「小魔女啦啦隊」及團長ㄚ璇將結束合作，引發球迷熱議。球隊感謝他們的付出，未來是否重整應援陣容仍待進一步公告。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181436.jpg&M=1&s=Y&x=0&y=631&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 15:50", "link": "/news/story/7005/9658361"}, {"article_id": "9658376", "title": "台北羽賽／重返8年前奪冠福地 李梓嘉曝高姐暖心舉動", "summary": "2018年台北公開賽奪冠嶄露頭角，馬來西亞好手李梓嘉最高世界排名曾高居第2，2024年巴黎奧運還打下男單銅牌，但近年飽受傷病困擾，今天回到「福地」台北打下3局大戰勝利；他表示，還是想堅持在球場上，我國「一哥」周天成的護理治療師高敏珊給過一句鼓勵的話，對他也有很大影響。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181607.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 15:21", "link": "/news/story/7005/9658376"}, {"article_id": "9658216", "title": "中職／李珠珢大巨蛋應援遭男粉「戳背」嚇一跳！ 影片流出引網怒：汶汶事件學不乖嗎？", "summary": "富邦悍將啦啦隊成員李珠珢在大巨蛋應援時遭男粉絲「戳背」，影片引發安全討論。網友質疑防護不足，呼籲加強管制措施，並警惕類似事件重演。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181080.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 14:25", "link": "/news/story/7001/9658216"}, {"article_id": "9658061", "title": "NBA／不怪詹皇改投76人！ 阿德巴約私訊放話：下次碰面我一定狠狠打爆", "summary": "詹姆斯選擇加盟76人引發熱火中鋒阿德巴約的回應，他尊重詹姆斯的決定，並發出挑釁言論，表示下次對決將「狠狠打爆他」。阿德巴約強調東區競爭將激烈，期待新賽季的精彩表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180830.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 13:31", "link": "/news/story/7002/9658061"}, {"article_id": "9657881", "title": "MLB／機會來了！取代鄭宗哲的紅襪內野手一先發就遭球吻骨折", "summary": "紅襪內野手米德在加盟後首場先發即遭球吻，確認左手腕骨折，已進入傷兵名單。他原本抱持樂觀態度，但最終仍需進一步醫療處置。這筆交易剛進行，球隊期待他提升內野戰力，如今受到打擊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180557.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 13:11", "link": "/news/story/6999/9657881"}, {"article_id": "9657970", "title": "MLB／「經歷過所以知道那有多可怕」 村上宗隆盼為故鄉熊本帶來力量", "summary": "效力於大聯盟白襪隊的26歲日籍重砲村上宗隆，10年前曾遭遇2016年熊本地震，親身經歷過強震帶來的恐懼，對於昨天家鄉熊本再次發生強震，他人在美國仍十分擔心，「希望自己能盡可能帶來一些力量。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180681.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-29 12:48", "link": "/news/story/6999/9657970"}, {"article_id": "9657915", "title": "高中體總會長交接 胡劍峯交棒陳勝利", "summary": "高中體總上月底完成第七屆會長、理事、監事選舉，由桃園市立龍潭高級中等學校校長陳勝利當選第七屆會長，高中體總今天舉辦會長交接典禮，卸任會長桃園市永平工商校長胡劍峯將印信交接給新會長陳勝利，代表高中體總進入新里程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180599.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 12:32", "link": "/news/story/7005/9657915"}, {"article_id": "9657870", "title": "MLB／林睿杰走過投球失憶旅美雙城 球團看好模板是王牌萊恩", "summary": "林睿杰成功簽約明尼蘇達雙城隊，簽約金達30萬美元，成為首位旅美成功大學球員。他克服投球障礙，經歷三度落選中職，最終在MLB選秀聯盟中脫穎而出，展現成熟心態與投球潛力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180564.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-29 12:31", "link": "/news/story/6999/9657870"}, {"article_id": "9657776", "title": "MLB／「騎滑板車」又傷到同一腳 巨人金手套外野手已是累犯！", "summary": "舊金山巨人外野手貝德因左腳足底筋膜炎缺陣超過兩個月，近日騎滑板車再度傷到同一隻腳，復健計畫受到影響。球團已安排進一步檢查以確定傷勢，復出時間充滿不確定性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180358.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 12:17", "link": "/news/story/6999/9657776"}, {"article_id": "9657860", "title": "TPBL／小火車回來了！創隊大將湯瑪士重返國王", "summary": "新北國王隊今天正式宣布，球隊成立首季的禁區核心洋將湯瑪士（Thomas Welsh）正式重返，不僅為禁區注入更強的防守能量與籃板守護，更期盼能與老戰友再次擦出火花，向總冠軍發起衝擊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180501.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 12:13", "link": "/news/story/7003/9657860"}, {"article_id": "9657512", "title": "LPGA／英國公開賽將登場 曾雅妮、徐薇淩力拚冠軍獎盃並備戰亞運", "summary": "LPGA年度五大戰最後一場英國女子公開賽將於明天開打，台灣僅曾雅妮、徐薇淩2人參賽，除了力拚冠軍獎盃外，也要為即將到來的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180451.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 12:07", "link": "/news/story/7005/9657512"}, {"article_id": "9657334", "title": "棒球／台新新光金支持基層棒球 挺德芙蘭少棒隊奪冠", "summary": "為力挺基層棒球，台新新光金支持台中市德芙蘭少棒隊參與世界軟式少棒錦標賽，日前少棒隊勇奪世界冠軍返台，進一步宣布將舉辦慶功...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180440.jpg&M=1&s=Y&x=169&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-07-29 12:05", "link": "/news/story/7005/9657334"}, {"article_id": "9657554", "title": "NBA／嘴綠分析詹姆斯拒絕勇士原因 歷史恩怨太深、怕被說閒話", "summary": "詹姆斯夏季選擇加盟76人而非勇士，勇士老將格林指出，歷史恩怨和外界輿論壓力是關鍵因素。他認為詹姆斯無法完全放下過去的交鋒，選擇勇士會引發質疑，影響其歷史地位。雖然雙方有深厚交情，但詹姆斯的決定反映了全盤考量。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35179940.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 11:42", "link": "/news/story/7002/9657554"}, {"article_id": "9657683", "title": "PLG／勇士複數年約留洪楷傑 許晉哲盼成後場核心", "summary": "台北富邦勇士隊今天宣布與洪楷傑完成續約，雙方簽下複數年合約，勇士期許他未來持續成長，成為球隊後場的重要戰力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180167.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-07-29 11:25", "link": "/news/story/7003/9657683"}, {"article_id": "9657658", "title": "MLB／岡本和真再開砲 本季24轟追平藍鳥隊史新人紀錄", "summary": "藍鳥隊日籍重砲岡本和真再寫新猷，今天客場出戰國民隊替補上場，5局上轟出陽春全壘打，本季第24轟出爐，不僅持續堆高自己保持的大聯盟日籍新人最多轟紀錄，也追平藍鳥隊史新人單季最多轟紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180175.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 11:18", "link": "/news/story/6999/9657658"}, {"article_id": "9657599", "title": "棒球／郭智輝肯定辜仲諒重要貢獻 參選理事長強調秉持承先啟後精神", "summary": "中華棒球協會將於8月2日舉行第14屆理事長改選，經濟部前部長、科技企業家郭智輝已經宣布參選，他最近接受專訪表示，現任棒協理事長辜仲諒近年在基層棒球、國際賽事及棒球外交上的投入，對台灣棒球發展具有重要貢獻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35180012.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-29 10:58", "link": "/news/story/7001/9657599"}]}, {"name": "棒球", "articles": [{"article_id": "9658216", "title": "中職／李珠珢大巨蛋應援遭男粉「戳背」嚇一跳！ 影片流出引網怒：汶汶事件學不乖嗎？", "date": "2026-07-29 14:25", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35181080.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9658216"}, {"article_id": "9658749", "title": "中職／等了一年回一軍 黃恩賜一球未投又傷及右腳跟腱赴醫院檢查", "date": "2026-07-29 17:52", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35182028.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9658749"}, {"article_id": "9658789", "title": "中職／林家勝下二軍調細節 李吳永勤回一軍補強牛棚左投", "date": "2026-07-29 18:15", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35182131.jpg&M=1&s=Y&x=0&y=0&sw=1248&sh=832&exp=3600&w=300", "link": "/news/story/7001/9658789"}, {"article_id": "9658778", "title": "中職／林逸達術後球速拉至150公里 有望睽違2年回一軍", "date": "2026-07-29 18:13", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35182130.jpg&M=1&s=Y&x=0&y=90&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9658778"}, {"article_id": "9658816", "title": "中職／和「同世代」的陽岱鋼曾一起打球 平野惠一：想對他說聲辛苦了", "date": "2026-07-29 18:11", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/29/35182174.jpg&M=1&s=Y&x=0&y=70&sw=1130&sh=753&exp=3600&w=300", "link": "/news/story