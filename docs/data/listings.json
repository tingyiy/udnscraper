//pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397874.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 11:43", "link": "/news/story/7005/9799811"}, {"article_id": "9799881", "title": "NBA／澳門球館慘遭獨行俠「拆家」？馬歇爾灌爆籃框、坐壞椅子笑喊：我太壯了", "summary": "隨著新賽季即將開打，獨行俠本周前往澳門與火箭進行2場熱身賽，不過前鋒馬歇爾（Naji Marshall）在練習過程中不僅將籃框灌壞，甚至又坐壞場邊折疊椅，讓他自己都忍不住開玩笑向澳門道歉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397864.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 11:40", "link": "/news/story/7002/9799881"}, {"article_id": "9799909", "title": "中職／陳文杰再4天滿29歲 史上最年輕「東山再起獎」得主", "summary": "中華職棒今天公布本季「東山再起獎」得主，台鋼雄鷹隊陳文杰出賽97場，363個打數敲出100支安打，打擊率2成75、全壘打3支、打點35分、盜壘成功8次、守備率百分之百，挺過漫長復健之路，以攻守俱佳的表現獲獎。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397788.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-07 11:23", "link": "/news/story/7001/9799909"}, {"article_id": "9799873", "title": "MLB／道奇闖進國聯冠軍賽穩了？過去相同戰況晉級機率72%", "summary": "道奇隊今天在國聯分區系列賽G3以3：1擊退勇士隊，取得2：1聽牌優勢，數據顯示，道奇晉級機率高達72%。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397718.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 11:14", "link": "/news/story/6999/9799873"}, {"article_id": "9799766", "title": "NBA／雷霆新秀「反斑馬專武」準雙十、3火鍋 教頭看見巨大進步", "summary": "被封為「斑馬專武」的雷霆首輪新秀瑪拉（Aday Mara）於今日亮相，上陣18分鐘，繳出12分、9籃板、3助攻、3火鍋，正負值＋13為全隊第二高，儘管最終以110：116敗給鵜鶘，賽前雷霆總教練戴格諾（Mark Daigneault）就透露，從夏聯一路到訓練營，瑪拉已出現相當顯著的成長。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397606.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 10:58", "link": "/news/story/7002/9799766"}, {"article_id": "9799773", "title": "MLB／三振數創個人新高、日本第3人 山本由伸談危機：保送也沒關係", "summary": "道奇隊日籍強投山本由伸今天繳出7局只失1分好投，狂飆10K創個人季後賽生涯新高，幫助道奇以3：1擊敗勇士隊，系列賽取得2：1聽牌。山本賽後受訪時談到第5局面臨危機時的心態。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397528.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-07 10:45", "link": "/news/story/6999/9799773"}, {"article_id": "9799751", "title": "MLB／李灝宇進美媒2026前50大新秀榜 定位打擊型工具人", "summary": "美國媒體Bleacher Report評價美國職棒大聯盟（MLB）2026年前50大新秀，效力底特律老虎隊的李灝宇排在第...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397512.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 10:41", "link": "/news/story/6999/9799751"}, {"article_id": "9799693", "title": "NBA／現代「籃0王」回歸！公鹿庫茲瑪熱身賽6投0中 叫球迷冷靜遭千人開酸", "summary": "昨日公鹿迎來新賽季熱身賽首戰，其中庫茲瑪（Kyle Kuzma）的表現再度成為球迷砲火焦點，全場6投0中僅拿1分，球隊更以97：116不敵灰狼。面對社群上的批評，庫茲馬賽後也親自回應，但結果並沒有平息球迷怒火，反而讓留言區更加熱鬧。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397496.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 10:38", "link": "/news/story/7002/9799693"}, {"article_id": "9799662", "title": "NBA／回母校打復出戰 哈利伯頓自掏腰包買票送學弟妹", "summary": "溜馬隊本季第一場季前熱身賽明天將在愛荷華州立大學舉行，當家後衛哈利伯頓（Tyrese Haliburton）想確保該學弟、妹可以到場觀戰，直接自掏腰包買了學生區的門票，學校透過抽選方式讓幸運兒可以免費進場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397343.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-07 10:11", "link": "/news/story/7002/9799662"}, {"article_id": "9799657", "title": "MLB／教士陷淘汰邊緣終結者卻請陪產假 網：球員不該1月有性行為", "summary": "教士隊在國聯分區系列賽前兩戰都不敵釀酒人隊，再輸1場就被淘汰，沒想到今天G3開打前傳出震撼消息，教士終結者米勒（Mason Miller）被放進陪產假名單，無法出賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397327.jpg&M=1&s=Y&x=395&y=31&sw=885&sh=590&exp=3600&sl=W&fw=360", "date": "2026-10-07 10:10", "link": "/news/story/6999/9799657"}, {"article_id": "9799561", "title": "NBA／76人噩耗 冠軍中鋒熱身賽受傷賽季直接報銷", "summary": "76人隊昨天和尼克隊在季前熱身賽碰頭，但開賽不到5分鐘，76人替補中鋒胡克波提（Ariel Hukporti）右腳就出現傷勢，被迫提前離場，今天MRI檢查結果出爐更是壞消息，胡克波提右腳阿基里斯腱撕裂，賽季直接報銷。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397151.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 09:34", "link": "/news/story/7002/9799561"}, {"article_id": "9799541", "title": "MLB／關鍵時刻靠山本由伸！7局狂飆10K助道奇退勇士系列賽聽牌", "summary": "道奇與勇士隊的國聯分區系列賽G3今天登場，道奇靠山本由伸7局狂飆10K只失1分好投，加上第3局兩轟加持，終場以3：1險勝勇士，系列賽取得2：1聽牌優勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397116.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 09:26", "link": "/news/story/6999/9799541"}, {"article_id": "9799465", "title": "北極羽賽／挑戰3連霸！周天成北歐拚冠今上陣", "summary": "我國「一哥」周天成、名古屋亞運奪下與球隊唯一獎牌的混雙組合葉宏蔚／詹又蓁等寶島羽將，本周齊聚芬蘭萬塔，從北極公開賽開啟一連4站的歐洲賽事，亞運奪銅的葉詹配首輪打滿3局驚險過關，尋求男單3連霸的小天將在今天第二日賽程上陣，首戰將碰法國梅克爾（Arnaud Merkle）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35397072.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-07 08:45", "link": "/news/story/7005/9799465"}, {"article_id": "9798956", "title": "中職／年度第五對第二還保送一勝 半季冠軍制有bug該修正", "summary": "中職今年出現年度第五中信兄弟挾半季冠軍與保送1勝，挑戰年度第二統一獅的情況，半季獎勵與全年戰績權重引發制度檢視。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35396453.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 07:00", "link": "/news/story/122629/9798956"}, {"article_id": "9798142", "title": "連兩年強拉尾盤翻轉戰局 低調強權守護者再成美中之霸", "summary": "克里夫蘭守護者連兩年逆轉封王，完成美聯中區三連霸，以美聯第二種子晉級季後賽；低薪自養陣容靠深厚投打戰力維持競爭力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395218.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-07 07:00", "link": "/news/story/122629/9798142"}, {"article_id": "9798946", "title": "怎麼會打擊突然爛到家？洋基、守護者季後賽都站在懸崖邊緣", "summary": "洋基、守護者季後賽連敗陷淘汰危機，前兩戰打擊熄火成主因，洋基第二戰更出現四次失誤，第三戰須背水一戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.