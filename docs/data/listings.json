l": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235095.jpg&M=1&s=Y&x=135&y=0&sw=1078&sh=718&exp=3600&sl=W&fw=360", "date": "2026-08-17 07:00", "link": "/news/story/122629/9694944"}, {"article_id": "9695498", "title": "四大極地納米比亞沙漠7日賽首站 Team Taiwan A林義傑與李銘峰居官方團體組第一", "summary": "2026四大極地納米比亞站41.5公里賽事，男子54號、女子89號分列個人組領先；Team Taiwan A以5小時51分41秒團體居首。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35236017.jpg&M=1&s=Y&x=0&y=84&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 06:37", "link": "/news/story/7005/9695498"}, {"article_id": "9695445", "title": "足球／C羅受訪暗示告別足壇：很可能是最後一年踢球", "summary": "葡萄牙足球巨星「C羅」羅納度透露迄今為止最明確暗示，表示他可能會在本賽季結束時告別足壇。他說，「這很可能是我的最後一年」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35235916.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-17 01:12", "link": "/news/story/7005/9695445"}, {"article_id": "9695198", "title": "日職／讀賣巨人舉辦引退儀式 陽岱鋼感謝球迷：非常幸福", "summary": "宣布今年球季結束引退的旅日39歲好手陽岱鋼，前東家讀賣巨人隊今天為他舉行引退儀式，陽岱鋼致詞時回顧巨人隊時期，很感謝球迷...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235721.jpg&M=1&s=Y&x=0&y=54&sw=562&sh=375&exp=3600&sl=W&fw=360", "date": "2026-08-16 22:39", "link": "/news/story/7001/9695198"}, {"article_id": "9695192", "title": "NBA／巨星詹姆斯開YouTube頻道 記錄打高爾夫歷程", "summary": "美國職籃NBA巨星詹姆斯已經在影音網站YouTube開設個人高爾夫球頻道並發布了一段影片，可以看到他和2016年克里夫蘭...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235732.jpg&M=1&s=Y&x=0&y=85&sw=262&sh=175&exp=3600&sl=W&fw=360", "date": "2026-08-16 22:29", "link": "/news/story/7002/9695192"}, {"article_id": "9695242", "title": "瓊斯盃／白隊比較強？高國豪有信心贏中華藍", "summary": "中華白今天瓊斯盃第三日賽程以66：64擊敗約旦隊，累積2勝1敗戰居分組第2，連三場得分20分的高國豪自信說，若能對上中華藍，有信心可以奪勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235700.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-16 22:25", "link": "/news/story/7003/9695242"}, {"article_id": "9695239", "title": "瓊斯盃／224公分巨神兵輕鬆拿雙10 菲律賓19分大勝中華藍", "summary": "224公分的NBA塞爾維亞籍「巨神兵」中鋒馬揚諾維奇（Boban Marjanovic）今年隨菲律賓俱樂部球隊SGA來台參加瓊斯盃，今天碰中華藍大殺四方，上場20分鐘就有14分、10籃板演出，加上阿基（Tajuan Agee）和皮內羅（Isaiah Pineiro）都有19分貢獻，助隊以97：78擊敗地主。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235692.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 22:21", "link": "/news/story/7003/9695239"}, {"article_id": "9695185", "title": "瓊斯盃／約旦教練才上任一星期 對白曜誠印象深刻", "summary": "中華白隊今天克服最多10分落後，在高國豪20分、白曜誠15分領軍下以66：64險勝約旦，連約旦新任總教練托雷斯（Luis Guil Torres）都點名「小白」，還說知道他是在同胞卡米諾斯執教的桃園璞園領航猿就有很好表現，有今天的發揮並不意外。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235457.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 21:20", "link": "/news/story/7003/9695185"}, {"article_id": "9695171", "title": "瓊斯盃／小學當觀眾上電視 林韋愷成球員喊美夢成真", "summary": "小學就曾進場看瓊斯盃，林韋愷今年入選中華白隊，讓他直呼「夢想成真」，尤其今天碰約旦還有快攻投進追平三分球的演出，助隊以66：64奪勝後讓他笑說奇妙，「以前是看傑哥（林志傑）、駿哥（陳盈駿），現在是我自己在上面。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235371.jpg&M=1&s=Y&x=0&y=91&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 21:01", "link": "/news/story/7003/9695171"}, {"article_id": "9695030", "title": "中職／悍將雙轟打退獅隊 江國豪5局6K睽違6年對獅奪勝", "summary": "富邦悍將隊昨天在台南亞太棒球場慘遭統一獅隊狙擊，今天找回火力還以顏色，全場敲出15支安打，包括王苡丞、張育成的2發全壘打，先發打線全員安打，終場悍將以8：2打下勝利；本土投手江國豪先發5局失1分、送6K，拿下勝投、終止對戰獅隊9連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235264.jpg&M=1&s=Y&x=0&y=0&sw=1265&sh=844&exp=3600&sl=W&fw=360", "date": "2026-08-16 19:46", "link": "/news/story/7001/9695030"}, {"article_id": "9695027", "title": "瓊斯盃／高國豪連三場20分！致勝罰球助中華白逆轉約旦", "summary": "中華白和約旦隊今天瓊斯盃第三日賽程激戰到最後一刻，中華白在高國豪最後17.9秒罰進超前分、連三場得分20分發揮下，驚險以66：64收下2連勝，約旦則是吞下3連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235256.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 19:40", "link": "/news/story/7003/9695027"}, {"article_id": "9695021", "title": "中職／龍隊三呎線判決提挑戰 曾總也好奇：當下會在每個play上爭取", "summary": "樂天桃猿隊今天以5：1擊敗味全龍隊，三呎線能否挑戰之謎，再度於第三局掀起討論，就連猿隊教頭曾豪駒也一度上場了解。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235249.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 19:26", "link": "/news/story/7001/9695021"}, {"article_id": "9694991", "title": "中職／台灣女團HUR+獅隊開球 隊長利善榛父親是少棒國手", "summary": "中職統一7-ELEVEn獅今天邀請台灣唱跳女團HUR+到場演出及開球，隊長利善榛透露，父親曾是少棒國手，從小看父親打球的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235227.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 19:10", "link": "/news/story/7001/9694991"}, {"article_id": "9694992", "title": "中職／「猿」來雙洋砲要這樣用 聯手4安躲過被龍隊橫掃", "summary": "樂天桃猿隊的雙洋砲，找到「使用說明書」，威克3安打、道威聖也貢獻1支二壘打，猿隊終場以5：1擊敗味全龍隊，避免在3連戰遭到橫掃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235200.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 18:48", "link": "/news/story/7001/9694992"}, {"article_id": "9694976", "title": "NBA／溜馬吃定心丸！哈利伯頓親曝健康狀態：現在就能上場打球", "summary": "溜馬當家後衛哈利伯頓（Tyrese Haliburton）已經迫不及待迎接新賽季到來。他近日出席溜馬基金會慈善壘球賽時表示，自己目前身體狀況良好，已經準備好回到NBA賽場，甚至直言如果新賽季今天就開打，他也能立刻上場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235176.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-16 18:34", "link": "/news/story/7002/9694976"}, {"article_id": "9694975", "title": "中職／龍隊3連戰90045人進場本季第二賣座 只輸悍將G!POP主題日", "summary": "味全龍隊本周末在台北大巨蛋作東，舉辦「龍星大樂」主題日，3天湧入90045人，為今年第二賣座系列賽，僅次於5月底富邦悍將隊G!POP流行音樂節的10萬6510人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235172.jpg&M=1&s=Y&x=1&y=147&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 18:18", "link": "/news/story/7001/9694975"}, {"article_id": "9694973", "title": "定向越野／一張地圖走進全民生活 北極星串聯山林探索與貓空茶文化", "summary": "中華民國定向越野協會今天（16日）舉辦「台北大縱走第七段─山林定向探索體能訓練」，由山域嚮導專家廖登山帶領親子家庭、年輕上班族及退休族群，自政治大學走入政大後山、飛龍步道、樟樹步道、貓空與指南宮。活動結合地圖判讀、手機定位、文化任務及AR擴增實境，讓健行不只是跟著隊伍前進，更是一場主動觀察、思考與認識土地的探索。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235169.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 18:13", "link": "/news/story/7005/9694973"}, {"article_id": "9694971", "title": "中職／6局吵好球帶、7局已經印好 本後龍迷高舉全彩K-Zone", "summary": "味全龍、樂天桃猿隊今天續戰台北大巨蛋，龍隊六局下的攻勢中「滿壘計」，林辰勳滿球數情況下面對1顆偏低的球未出棒遭判決好球三振，龍隊陣營情緒激動，內野守備教練陳志偉手比「2」激動抗議，儘管並未釀成大場面，但本壘後方隨後出現球迷高舉全彩列印K-Zone畫面。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 18:12", "link": "/news/story/7001/9694971"}, {"article_id": "9694951", "title": "中職／林辰勳以為保送變三振滿壘成空 龍隊教練手比「2」激動抗議", "summary": "味全龍、樂天桃猿隊今天續戰台北大巨蛋，龍隊六局下的攻勢中「滿壘計」，林辰勳滿球數情況下面對1顆偏低的球未出棒遭判決好球三振，龍隊陣營情緒激動，內野守備教練陳志偉手比「2」激動抗議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235135.jpg&M=1&s=Y&x=0&y=0&sw=1272&sh=848&exp=3600&sl=W&fw=360", "date": "2026-08-16 17:51", "link": "/news/story/7001/9694951"}, {"article_id": "9694949", "title": "中職／洲際球場賽前下大雨 兄弟雄鷹之戰因雨延至10月4日", "summary": "中信兄弟隊今天原訂在台中洲際棒球場與台鋼雄鷹隊交手，但賽前現場突然下起大雨，經等待後雨勢仍未停歇，比賽宣布延賽，將移至10月4日17：05於原場地進行補賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235156.jpg&M=1&s=Y&x=0&y=90&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-16 17:49", "link": "/news/story/7001/9694949"}, {"article_id": "9694946", "title": "NBA／詹姆斯笑稱布朗尼已成「前隊友」 父子同隊歷史轉為難忘回憶", "summary": "詹姆斯（LeBron James）如今仍在適應一個相當特別的新現實，那就是他的長子布朗尼（Bronny James）已經不只是他的兒子，也正式成為他NBA生涯中的「前隊友」。", "thumbn