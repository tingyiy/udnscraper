}, {"article_id": "9879447", "title": "NBA／得分掛蛋又被冰板凳 衛冕軍功臣他坦言「心情不好」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/15/35518994.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600", "link": "/news/story/7002/9879447"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9874875", "title": "中職／連3年帶隊闖台灣大賽 平野惠一會續約迎更大挑戰嗎？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35457524.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&w=300", "link": "/news/story/122629/9874875"}, {"article_id": "9875108", "title": "馬刺10連勝比上季更強？ 溫班亞瑪主宰攻守+3控衛先發完美共存", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/12/35512323.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9875108"}, {"article_id": "9871915", "title": "棒球／中華隊力拚U23世界盃 3名投手被看好有旅外潛力", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507246.jpg&M=1&s=Y&x=64&y=0&sw=1216&sh=811&exp=3600&w=300", "link": "/news/story/122629/9871915"}, {"article_id": "9871984", "title": "佐藤輝明靠村神拉抬身價 有望打破李政厚亞洲野手入札紀錄", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507521.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9871984"}, {"article_id": "9872315", "title": "亞冠賽／熱身賽開轟手感火燙 林安可西武隊友成中華隊警戒重點", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507928.jpg&M=1&s=Y&x=0&y=52&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9872315"}, {"article_id": "9870300", "title": "中職／契約保留名單不夠用 近90人成FA將掀搶人之戰", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/10/35504806.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9870300"}]}, {"name": "最新文章", "articles": [{"article_id": "9879447", "title": "NBA／得分掛蛋又被冰板凳 衛冕軍功臣他坦言「心情不好」", "summary": "尼克隊昨天在NBA盃以104：106不敵溜馬隊，上季奪冠功臣之一的哈特（Josh Hart）全場得分掛蛋，第四節更被冰在板凳上，讓他坦言「心情不好」，無法直接說明自身出了什麼狀況。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/15/35518994.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-15 09:03", "link": "/news/story/7002/9879447"}, {"article_id": "9879422", "title": "NBA／76人禁區沒大人要到詹皇頂？安比德在內3中鋒都休", "summary": "76人台灣時間明天將和溜馬隊交手，球團今天宣布，當家中鋒安比德（Joel Embiid）因右腳足底筋膜炎，確定缺陣一場，大個子波納（Adem Bona）和巴洛（Dominick Barlow）也持續缺陣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/06/35492843.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-15 08:22", "link": "/news/story/7002/9879422"}, {"article_id": "9879267", "title": "運動人生／球賽讀秒…卻聽不見觀眾的吶喊 吳啟道站上聽奧投身教育", "summary": "打籃球讓吳啟道聽力惡化，但籃球也讓他擁有耀眼人生。二○二四年，聽障籃球員吳啟道代表中華隊在爭取聽奧門票的關鍵一役投出致勝絕殺球，沒聽見掌聲，只看到隊友朝他奔來，「世界很安靜，內心卻洶湧澎湃。」他說，既然世界上有這樣的舞台，就想試試看。這一試就是十年。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518727.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-15 00:15", "link": "/news/story/7005/9879267"}, {"article_id": "9879270", "title": "運動人生／吳啟道寂靜人生 更懂得學習與人溝通", "summary": "「田徑、游泳等個人項目的聽障選手可以專注在自己的身體、節奏與技術，籃球、排球等團隊運動，隊員們少了聲音溝通後，所有配合都只能靠一次又一次的練習堆壘出來」。吳啟道說，聽障選手參與團隊競技運動更不容易。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518736.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-15 00:14", "link": "/news/story/7005/9879270"}, {"article_id": "9879268", "title": "運動人生／傳承遇困境 下一位聽障聽障教練在哪裡", "summary": "「台灣聽障籃球真正難解的問題不是『聽不到』，而是許多選手離開國家隊後，缺乏固定球隊可讓他們繼續練習」。中華聽障籃球隊教練鄧碧珍、鄧碧雲姊妹除了道出國內發展聽障籃球困境，更憂心「下一位聽障籃球教練在哪裡」？", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_9.jpg", "date": "2026-11-15 00:13", "link": "/news/story/7005/9879268"}, {"article_id": "9879162", "title": "亞冠賽／金倒永繼經典賽後再轟中華隊 敲致勝轟卻說身體狀況未到位", "summary": "南韓隊主砲金倒永在預賽前兩戰8打數只有1支一壘打，甚至遭南韓球迷酸「國內限定」，今天在關鍵戰役開砲，第五局的陽春砲成為此役致勝轟，率領南韓隊以6：4擊敗中華隊，挺進亞冠賽冠軍賽。金倒永賽後透露，自己的身體狀況感覺並不是很好，「但比賽還沒結束，我會持續設法調整到更好的狀態。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518633.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 22:53", "link": "/news/story/7001/9879162"}, {"article_id": "9879091", "title": "徐生明少棒賽開打 「台日友好」布條讓謝榮瑤落淚", "summary": "第14屆徐生明國際少棒錦標賽今天在高雄開打，32支隊伍競技交流爭取榮譽外，還有溫馨場景，日本武藏府中隊在選手之夜展示出台...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518539.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 22:02", "link": "/news/story/7001/9879091"}, {"article_id": "9879074", "title": "TPBL／杭特傷癒歸隊繳「雙十」 高雄全家海神浪掀特攻復仇", "summary": "高雄全家海神今天作客新北中信特攻主場，迎回傷癒歸隊的洋將杭特，團隊以速度及準心彌補籃板落後，終場前2分鐘洛斯柯連拿4分，加上于煥亞罰球貢獻關鍵分，以106：104險勝特攻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518485.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 21:24", "link": "/news/story/7003/9879074"}, {"article_id": "9879061", "title": "亞冠賽／敲3轟還是絕望…中華隊不敵南韓無緣爭冠 明與澳洲打季軍戰", "summary": "中華隊力拚隊史首度前進亞冠賽冠軍賽，3支全壘打帶來無窮希望，但結局還是一場空，投手群也栽在南韓隊長程砲管之下，中華隊終場以4：6輸球，比較對戰優質率（TQB）後由南韓隊收下冠軍賽門票，連3屆都上演日韓爭冠，中華隊將在明天早上10點（台灣時間）與澳洲隊打季軍戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518470.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 20:55", "link": "/news/story/7001/9879061"}, {"article_id": "9879052", "title": "輪椅網球／永達盃圓滿落幕 荒井大輔、利沃娃獲男女公開組金牌", "summary": "「2026第10屆永達盃高雄國際輪椅網球公開賽暨輪椅匹克球邀請賽」，今天在高雄市橋頭區輪椅夢公園竹林網球場圓滿閉幕，本屆吸引來自歐洲、美洲及亞洲等10個國家、共56位選手參賽，其中11位選手名列世界排名前30名，最終日本荒井大輔及來自俄羅斯的利沃娃（Viktoriia Lvova）分獲男、女公開組金牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518441.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 20:37", "link": "/news/story/7005/9879052"}, {"article_id": "9879051", "title": "總統盃街舞大賽全國決賽落幕 卓榮泰鼓勵以街舞展現台灣活力", "summary": "由運動部及全民運動署主辦的「2026全民運動賽事—總統盃街舞大賽」於今天在總統府前凱達格蘭大道舉行全國決賽，來自各分區晉級的頂尖舞者齊聚總統府前，爭取 All Style 排舞、All Style Battle 及霹靂舞（Breaking）三大項目的最高榮耀。行政院院長卓榮泰出席頒獎典禮頒發前三名獎項，並肯定參賽舞者於比賽過程展現的精湛舞技與創意。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518440.jpg&M=1&s=Y&x=0&y=0&sw=1227&sh=818&exp=3600&sl=W&fw=360", "date": "2026-11-14 20:37", "link": "/news/story/7005/9879051"}, {"article_id": "9879039", "title": "TPBL／于煥亞繳出全能發揮 海神客場險勝特攻", "summary": "台灣職業籃球大聯盟TPBL高雄全家海神今天靠著射手于煥亞繳出19分、8助攻、5抄截的全能演出，搭配洋將洛斯柯挹注全隊最高...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518432.jpg&M=1&s=Y&x=0&y=95&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 20:32", "link": "/news/story/7003/9879039"}, {"article_id": "9879038", "title": "亞冠賽／隊史第一人！曾聖安對南韓敲雙響砲 「台版Soto」東蛋發光", "summary": "在中職總冠軍賽用全壘打改變戰局的男人曾聖安，來到亞冠賽舞台後繼續發光，今天面對南韓隊前3打席已敲2發全壘打，成為中華隊史上第一位在亞冠賽演出單場雙響砲的選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518426.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 20:21", "link": "/news/story/7001/9879038"}, {"article_id": "9879035", "title": "PLG／首次對位數據戰績雙輸 高國豪讚車侑城：隊友讓他更有信心", "summary": "開季拉出3連勝的台鋼獵鷹，今天作客台北富邦勇士主場卻踢到鐵板，最終以31分差距吞下賽季首敗，其中替補後衛高國豪也在首次與富邦勇士華裔後衛車侑城的對壘中屈居下風，賽後他也稱讚車侑城在隊友幫助下，打得更有信心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518416.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 20:17", "link": "/news/story/7003/9879035"}, {"article_id": "9879027", "title": "PLG／首秀助蔡文誠奪執教首勝和比賽用球 車侑城：他值得", "summary": "PLG台北富邦勇士今天迎來新賽季首戰以及華裔後衛車侑城的主場首秀，最終在他全場18分助陣下，助明天將舉行引退儀式的執行教練蔡文誠收下執教首勝，賽後團隊也將比賽用球送給了蔡文誠，對此，車侑城也直言，「他值得這顆球。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518401.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 20:04", "link": "/news/story/7003/9879027"}, {"article_id": "9879012", "title": "亞冠賽／葉總和平野愛徒都開轟！中華隊短暫追平又失守 前5局3:4落後", "summary": "中華隊力拚隊史首度前進亞冠賽冠軍賽，今天碰上南韓隊，第三局因徐翔聖的控球危機陷入麻煩，單局丟掉3分，中華隊展現長打魅力，五局上曾聖安陽春砲、張仁瑋兩分砲齊發，然而短暫追平戰局，韓職全壘打王金倒永就在五局下敲出陽春砲，中華隊打完前5局處於3：4落後。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518371.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 19:49", "link": "/news/story/7001/9879012"}, {"article_id": "9878999", "title": "PLG／車侑城首秀替補狂飆18分 富邦勇士大勝獵鷹31分", "summary": "PLG台北富邦勇士今天迎接新球季主場開幕戰，並在賽前舉行「野獸」林志傑背號引退儀式，面對來訪台鋼獵鷹，富邦勇士今天火力全開，尤其是首度在PLG登場的車侑城替補上陣攻下18分，幫助富邦勇士最終以109：78擊敗獵鷹，", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518358.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 19:33", "link": "/news/story/7003/9878999"}, {"article_id": "9878958", "title": "TPBL／克服18分落後逆境 雲豹主場開幕戰逆轉延長賽退攻城獅", "summary": "桃園台啤永豐雲豹隊今天在桃園巨蛋進行新賽季主場首戰，與新竹御嵿攻城獅隊交手，雲豹在此戰共有4933名球迷加油下，雖在前3節皆落後，但在末節奮起直追，最終「金牌特務」林信寬在延長賽投進關鍵3分球，助球隊以100：95逆轉擊敗攻城獅。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518292.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-14 18:33", "link": "/news/story/7003/9878958"}, {"article_id": "9878939", "title": "MLB／還沒到自己巔峰期 今永昇太想在「非比尋常的世界」待久一點", "summary": "33歲日籍左投今永昇太今年季後成為自由球員，面對超過10支大聯盟球隊提出的報價，會如何選擇下一個落腳處？今永昇太表示，目前離自己的「巔峰期」還很遠，希望能選擇一支能幫助自己達到巔峰狀態的球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518279.jpg&M=1&s=Y&x=164&y=20&sw=1116&sh=743&exp=3600&sl=W&fw=360", "date": "2026-11-14 18:20", "link": "/news/story/6999/9878939"}, {"article_id": "9878873", "title": "亞冠賽／中華隊力拚首次前進冠軍賽 抗韓打線啟用雙獅首度先發", "summary": "亞冠賽今晚進行台韓大戰，要決定第二張冠軍賽門票，中華隊先發打線出爐，一壘首度啟用林子豪先發，捕手宋嘉翔昨天傷退，今天改由張翔擔綱先發投手，與旅日投手徐翔聖搭檔，力拚擊敗南韓隊、搶下冠軍賽席次。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518188.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 18:00", "link": "/news/story/7001/9878873"}, {"article_id": "9878910", "title": "熊本羽賽／不敵「羽球女神」志田千陽與新搭檔 許尹鏸／林芝昀止步4強", "summary": "BWF超級500的日本熊本名人賽今天展開4強賽程，我國女雙組合許尹鏸／林芝昀，今天遭遇平本梨梨菜／志田千陽，最終以21：23、15：21敗下陣來，無緣爭冠，台將賽程也全數落幕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518255.jpg&M=1&s=Y&x=11&y=0&sw=1071&sh=714&exp=3600&sl=W&fw=360", "date": "2026-11-14 17:54", "link": "/news/story/7005/9878910"}, {"article_id": "9878783", "title": "NBA／心態崩了…勇士菜鳥首扛主攻13投1中：我整場都很慌", "summary": "勇士菜鳥倫德伯格（Yaxel Lendeborg）在柯瑞（Stephen Curry）傷缺後首度扛起主攻重任，然而全場13投1中僅拿3分，勇士也以85：123慘敗馬刺。賽後，倫德伯格也坦言自己心態已經整個崩了。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518097.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-14 17:33", "link": "/news/story/7002/9878783"}, {"article_id": "9878796", "title": "NBA／湖人開局強勢還想補強！ 唐西奇老戰友華盛頓、瓊斯都在名單中", "summary": "湖人開季打出11勝2敗、聯盟最佳戰績的強勢開局，不過根據NBA記者希德利（Evan Sidery）報導，湖人補強腳步似乎並未停下，預計將再度探詢獨行俠前鋒華盛頓（P.J. Washington）的交易可能，而獨行俠的態度似乎也開始鬆動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518233.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 17:27", "link": "/news/story/7002/9878796"}, {"article_id": "9878834", "title": "MLB／為了鈴木誠也改讓塔提斯回內野？ 網友直呼：「史上最蠢點子」", "summary": "教士今年休賽季積極尋求打線補強，棒球事務總裁普瑞勒（A.J. Preller）日前也在總管會議上坦言，塔提斯（Fernando Tatis Jr.）明年可能成為球隊的主力二壘手，好替一名具影響力的外野手騰出位置，而外界點名的人選正是小熊自由球員鈴木誠也。然而，這項計畫卻引來不少質疑，節目《Foul Territory》的主持群也表態，右外野才是小塔提斯最好的位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518193.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-11-14 17:23", "link": "/news/story/6999/9878834"}]}, {"name": "棒球", "arti