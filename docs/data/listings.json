hp?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317593.jpg&M=1&s=Y&x=0&y=0&sw=1156&sh=771&exp=3600&w=300", "link": "/news/story/122629/9746578"}, {"article_id": "9745547", "title": "讓楚奧特喊「我好興奮阿」！ 天使新老闆經營球隊是奪冠專業戶", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35313616.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9745547"}, {"article_id": "9744469", "title": "中職／前4名球隊都有人去打亞運 樂天爭冠少了陳晨威最傷", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312011.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9744469"}, {"article_id": "9742489", "title": "中職／光總快手調度不復見 悍將晉級路岌岌可危", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309129.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9742489"}, {"article_id": "9741923", "title": "國聯塞揚獎還有懸念！37歲「拍賣哥」塞爾球速為何能再進化？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35308375.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9741923"}]}, {"name": "最新文章", "articles": [{"article_id": "9750892", "title": "排球／豐原高商輸2追3大逆轉苑裡高中 率先晉級登峰造極高中男子組冠軍戰", "summary": "豐原高商五局逆轉苑裡高中，於2026登峰造極青年排球邀請賽高中男子組以19比17拿下決勝局，率先晉級14日冠軍戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35322172.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 22:37", "link": "/news/story/7005/9750892"}, {"article_id": "9750868", "title": "U18亞青／吳昊翔對韓8球吞敗 對日後援登板不重蹈覆轍", "summary": "U18亞洲青棒錦標賽左投吳昊翔預賽對韓國中繼登板僅投8球就退場吞敗，他表示不算挫折，只是難過沒幫助球隊，今天對日本後援登...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35322113.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 22:07", "link": "/news/story/7001/9750868"}, {"article_id": "9750844", "title": "U18亞青／中華隊落入季軍戰教頭扛責 「選手真的很認真」", "summary": "中華隊在本屆U18亞洲青棒錦標賽確定無緣爭冠，總教練楊孝承賽後扛責、紅了眼眶，也提及選手從7月12日集訓至今練球都很認真，盼國人繼續支持選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35322041.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 21:28", "link": "/news/story/7001/9750844"}, {"article_id": "9750837", "title": "日職／林安可12局代打亮相 對決火腿「二刀流」柴田獅子敲飛球出局", "summary": "日職西武隊今天在主場迎戰火腿隊，兩戰熬戰12局最終以3：3握手言和，台灣外野手林安可此戰沒有先發，12局下被換上場代打，對決火腿「二刀流」新星柴田獅子敲出左外野飛球出局；火腿隊孫易磊則沒有登板亮相。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35322042.jpg&M=1&s=Y&x=0&y=54&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-12 21:20", "link": "/news/story/7001/9750837"}, {"article_id": "9750834", "title": "影／U18亞青棒中華隊不敵日本 無緣晉級冠軍戰", "summary": "U18亞洲青棒錦標賽台日大戰上演王牌對決，兩隊都在首局把握對方先發投手不穩得分，劉任右先發4.2局失2分、送出7次三振，織田翔希飆6局失1分，中華隊終場以1：2不敵日本隊，無緣晉級冠軍戰，日本隊則將在明天與韓國隊爭冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35322024.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 21:19", "link": "/news/story/7001/9750834"}, {"article_id": "9750825", "title": "U18亞青／連碰日韓大魔王都繳好投 劉任右卻哭了：就差一點", "summary": "中華隊今天以1：2不敵日本隊，在本屆U18亞洲青棒錦標賽無緣冠軍賽，先發投手劉任右賽後流下眼淚，「就差一點…」、「我們真的有機會贏」。本屆賽會連續遭遇日、韓強敵，也讓他收穫滿滿，此役從織田翔希身上學的一課，已經記下筆記，劉任右說：「他的均速保持很好，回去後要納入我的課題。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35322018.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 21:10", "link": "/news/story/7001/9750825"}, {"article_id": "9750787", "title": "U18亞青／惜敗…中華隊1分差不敵日本隊衛冕夢碎 明與菲爭季軍", "summary": "U18亞洲青棒錦標賽「台日大戰」王牌對決，劉任右先發4.2局失2分、送出7次三振，織田翔希飆6局失1分，兩軍都在首局攻略後停滯火力，中華隊終場以1：2不敵日本隊。至此決賽戲碼出爐，日本隊將與南韓隊爭冠，中華隊無緣尋求衛冕，明天將與菲律賓隊在季軍戰交手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321952.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-12 20:29", "link": "/news/story/7001/9750787"}, {"article_id": "9750770", "title": "中職／鄭浩均飆生涯最長先發8局無失分 率兄弟6：0完封桃猿", "summary": "中信兄弟本土投手鄭浩均睽違超過一個月重返一軍先發，今天繳出8局無失分的生涯代表作，強壓樂天桃猿隊本土投手陳克羿，率領兄弟以6：0完封對手，終止近期2連敗，也斬斷猿隊3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321940.jpg&M=1&s=Y&x=0&y=0&sw=1056&sh=704&exp=3600&sl=W&fw=360", "date": "2026-09-12 20:01", "link": "/news/story/7001/9750770"}, {"article_id": "9750735", "title": "影／U18亞青棒台日大戰 上演王牌對決", "summary": "U18亞洲青棒錦標賽今晚在台北大巨蛋上演台日大戰，日本隊派出王牌織田翔希擔任先發投手，中華隊則由首戰登板的劉任右先發，上演王牌對決。中華隊1局上靠著野手選擇先馳得點，日本隊則在1局下靠著串連安打得到2分超前。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321906.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 19:29", "link": "/news/story/7001/9750735"}, {"article_id": "9750734", "title": "中職／威鳳山初登板5局失3分奪勝 台鋼7連敗後對悍將2連勝", "summary": "台鋼雄鷹終止7連敗後，今天移師澄清湖棒球場再戰富邦悍將，新洋投威鳳山「開箱」，繳出5局失3分（2責失）表現，打線則是前兩局就將悍將洋投悍里歐打退場，前5局局局得分，終場以8：3擊敗悍將，兩隊下半季無勝差並列墊底。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321905.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 19:26", "link": "/news/story/7001/9750734"}, {"article_id": "9750633", "title": "U18亞青／迎戰日本王牌織田翔希 總教練要前兩棒多觀察掌握狀況", "summary": "U18亞洲青棒錦標賽台灣今天與日本爭冠軍戰門票，台灣隊由王牌左投劉任右先發、打序不變，總教練楊孝承表示，日本王牌織田翔希...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35319748.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 18:10", "link": "/news/story/7001/9750633"}, {"article_id": "9750663", "title": "企業射箭／「西湖之戰」亞運國手單日11戰9勝 李彩綺：大家目標一致", "summary": "2026第8年企業射箭聯賽例行賽第五周、也是最後一周賽程今天在苗栗縣知名景點西湖渡假村進行，即將啟程名古屋亞運的眾家國手幾乎都拿出亮眼表現，準備為國、也為自己爭光。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321768.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 18:07", "link": "/news/story/7005/9750663"}, {"article_id": "9750646", "title": "U18亞青／南韓昨靠演技成就美技只能臨場發揮 中華隊教頭：這不好教", "summary": "南韓隊昨天以3：2擊敗日本隊一戰，中外野手朴甫乘以演技沒收日本隊的安打，在沒有重播輔助判決的情況下變成撲接美技，中華隊教頭楊孝承也認為是昨天比賽的一個關鍵。被問到「演技」是否教得來，笑答：「這不好教欸！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321750.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-12 17:53", "link": "/news/story/6999/9750646"}, {"article_id": "9750629", "title": "U18亞青／迎戰日本王牌！中華隊秘密武器出馬 發球機直送大巨蛋", "summary": "中華隊能否連4屆闖進U18亞洲青棒錦標賽冠軍賽，就看今晚與日本隊一戰，碰上日本王牌織田翔希，中華隊搬出秘密武器，將穀保家商的發球機運至台北大巨蛋，調到最快球速、距離拉近，總教練楊孝承笑說：「第一次出門比賽帶發球機，如果幫助我們贏球，幫它重新上漆。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35319571.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 17:32", "link": "/news/story/7001/9750629"}, {"article_id": "9750609", "title": "MLB／傳道奇內部悲觀評估 大谷翔平回歸打季後賽機率僅50%", "summary": "洛杉磯道奇二刀流巨星大谷翔平11日因右上臂二頭肌發炎，被球團放進15天傷兵名單（IL），並回溯至8日生效。若恢復順利，他最快可在23日主場對教士之戰復出，但道奇內部人士對情況並不樂觀，甚至坦言：「他可能連季後賽都很難出賽。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321716.jpg&M=1&s=Y&x=0&y=14&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 17:29", "link": "/news/story/6999/9750609"}, {"article_id": "9750586", "title": "NBA／「綠咖哩」竟差點拆夥？ 格林曝3年前曾想離開勇士：我當時是認真的", "summary": "生涯至今都效力勇士的老將格林（Draymond Green），近日透露早在2023年，他差點離開待了一輩子的灣區，而且灰熊當時開出的價碼，甚至每年比勇士多出1000萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321683.jpg&M=1&s=Y&x=0&y=92&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-12 17:12", "link": "/news/story/7002/9750586"}, {"article_id": "9750558", "title": "蓋洛普調查：美國人最愛美式足球！籃球居次、足球創新高逼近棒球", "summary": "美式足球長期穩坐美國最受歡迎觀賞運動寶座，但最新民調顯示，這項霸主地位雖然仍然穩固，吸引力卻可能正在鬆動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321634.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 16:57", "link": "/news/story/7005/9750558"}, {"article_id": "9750549", "title": "MLB／「38轟重砲」vs.「生涯0轟快腿」 史上最怪打擊王之爭！", "summary": "今年美聯打擊王之爭，出現了大聯盟史上極為罕見的畫面。一邊是本季狂轟38發全壘打、挑戰「三冠王」的太空人重砲艾瓦瑞茲（Yordan Alvarez）；另一邊卻是生涯937打數至今「0轟」、OPS甚至不到.700的光芒快腿辛普森（Chandler Simpson），兩種完全相反的打擊型態，如今兩人打擊率竟只相差4個百分點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321612.jpg&M=1&s=Y&x=95&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-12 16:48", "link": "/news/story/6999/9750549"}, {"article_id": "9750527", "title": "MLB／日職173公分小巨人能飆160公里火球 美媒點名身價挑戰破億", "summary": "美國體育媒體《ESPN》知名記者帕桑（Jeff Passan）日前撰文分析今冬自由球員市場，其中針對西武獅投手平良海馬給出相當高的評價，認為他雖然在市場定位上仍有競爭者，但已被部分人士視為「除了史庫柏（Tarik Skubal）之外，自由球員市場中有機會成為最佳先發投手的人選」，甚至可能具備成為頂級先發投手的潛力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321586.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-12 16:14", "link": "/news/story/6999/9750527"}, {"article_id": "9750506", "title": "U18亞青／大讚台灣棒球進步很多 韓教頭被問冠軍賽先發「聽不懂」", "summary": "南韓隊先一步進入U18亞洲青棒錦標賽冠軍賽，等待晚間「台日大戰」誕生對手，總教練鄭狁鎮被問到明天先發投手，中文回應「聽不懂」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35319749.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 15:58", "link": "/news/story/7001/9750506"}, {"article_id": "9750445", "title": "TPBL／湯瑪士重披國王戰袍更進化 笑稱懷念台灣牛肉麵", "summary": "台灣職業籃球大聯盟TPBL新北國王新賽季將迎來昔日禁區核心洋將湯瑪士「鳳還巢」，經理毛加恩認為湯瑪士的整體實力完全進化，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321532.jpg&M=1&s=Y&x=0&y=28&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-12 15:55", "link": "/news/story/7003/9750445"}, {"article_id": "9750499", "title": "2026極點慢旅「富貴騎跡 極北點富貴角騎遊」逾500名車友暢遊北海岸", "summary": "今天（12日）由交通部觀光署北海岸及觀音山國家風景區管理處主辦的「2026極點慢旅-富貴騎跡 極北點富貴角騎遊」於台灣極北點富貴角燈塔熱鬧登場，吸引來自全台各地超過500名自行車愛好者齊聚北海岸，以雙輪串聯白沙灣、淺水灣、中角灣、野柳等經典景點，沿途迎著海風、欣賞山海景致，感受北海岸自然風光、地方特色與慢旅魅力，在騎乘與探索之間留下專屬自己的「富貴騎跡」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321529.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 15:54", "link": "/news/story/7005/9750499"}, {"article_id": "9750403", "title": "TPBL／周儀翔拒絕酒測事件後重返職籃 毛加恩爆料會搭公車練球", "summary": "暫別2年職籃舞台的周儀翔，本季將披上台灣職業籃球大聯盟TPBL新北國王戰袍，總經理毛加恩爆料，現在周儀翔會搭公車練球，期...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321527.jpg&M=1&s=Y&x=0&y=406&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-12 15:53", "link": "/news/story/7003/9750403"}, {"article_id": "9750483", "title": "NBA／ 老爸曾與艾佛森搭檔！卡特「0出賽」慘遭老鷹裁掉", "summary": "根據《Yahoo》記者費雪（Jake Fischer）報導，老鷹決定裁掉今年休賽季透過交易換來的24歲後衛卡特（Devin Carter），顯示當初這筆交易的主要目的，很可能是為了取得2033年次輪選秀權，而非將卡特視為長期戰力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321477.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-12 15:47", "link": "/news/story/7002/9750483"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9750467", "title": "亞運男籃／「死亡之組」拚淨勝分太吃虧 中華隊搶8強門票只能贏卡達", "date": "2026-09-12 15:14", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321425.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/124981/9750467"}, {"article_id": "9750279", "title": "亞運棒球／王彥程15日為韓華鷹先發！「中五日」有望銜接台韓大戰", "date": "2026-09-12 13:42", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321178.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9750279"}, {"article_id": "9750118", "title": "名古屋開幕式在即 日本破例讓北韓選手入境", "date": "2026-09-12 13:02", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321051.jpg&M=1&s=Y&x=0&y=0&sw=1262&sh=841&exp=3600&w=300", "link": "/news/story/124981/9750118"}, {"article_id":