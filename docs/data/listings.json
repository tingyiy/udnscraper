: "/news/story/7005/9697959"}, {"article_id": "9698044", "title": "NBA／裁掉5天後簽回？太陽「先裁後簽」海史密斯藏玄機", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239269.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/7002/9698044"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9696645", "title": "台灣球員首度在大聯盟單季敲80、甚至90安 就看今年李灝宇", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237780.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9696645"}, {"article_id": "9696821", "title": "高國豪圈粉！瓊斯盃是台灣籃壇世紀資產 不是世代悲歌", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238035.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&w=300", "link": "/news/story/122629/9696821"}, {"article_id": "9696801", "title": "日職／一軍表現佳、成正式球員 孫易磊等小將本季已收穫滿滿", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237990.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9696801"}, {"article_id": "9694944", "title": "日職／30轟100打點二人組有望成形 加速軟銀霸業", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235095.jpg&M=1&s=Y&x=135&y=0&sw=1078&sh=718&exp=3600&w=300", "link": "/news/story/122629/9694944"}, {"article_id": "9689384", "title": "中職／主審好壞球頻遭抗議 聯盟實施ABS務必做好相關配套", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227113.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9689384"}, {"article_id": "9689680", "title": "控衛「總統山」有四個不動傳奇 無冕王衛少足以列名史上前五", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35229289.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9689680"}]}, {"name": "最新文章", "articles": [{"article_id": "9698182", "title": "帕運羽球國手蔡奕琳代言長庚永慶盃 挑戰自我極限", "summary": "罹患先天性軟骨發育不全症，身高與四肢條件與一般選手不同的蔡奕琳，從未讓疾病阻擋運動夢，不僅拿起球拍，更一路打進帕運殿堂，成為台灣首位取得帕運羽球女子單打短肢組參賽資格的選手。她今年受邀擔任「2026長庚永慶盃路跑」代言人，以自身經歷向民眾喊話：「我都可以堅持運動了，你也可以！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239502.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 10:50", "link": "/news/story/7005/9698182"}, {"article_id": "9698126", "title": "NBA／鵜鶘今夏最大補強！290萬美元簽上季繳「大三元」瓦特佛", "summary": "根據《ESPN》記者查拉尼亞（Shams Charania）報導，鵜鶘將與身高6呎8吋的前鋒瓦特佛（Trendon Watford）簽下一紙1年290萬美元的底薪合約，這也將是瓦特佛生涯第6個NBA賽季。隨著他的加入，鵜鶘目前陣中也將來到完整的15份正式合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239414.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 10:50", "link": "/news/story/7002/9698126"}, {"article_id": "9698108", "title": "MLB／太強！李灝宇首度猛打賞、5上壘 安打超車夜逢張育成生日", "summary": "張育成31歲生日的這一天，李灝宇用屬於自己的紀錄之夜超越前輩，今天3打數敲3安打，另有2次保送，貢獻2分打點，單場3安打、5度上壘都是他的生涯第一次，而本季累積57支安打，超越張育成2021年的54安，將大聯盟史上台將單季最多安打紀錄推向新高度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239387.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 10:31", "link": "/news/story/6999/9698108"}, {"article_id": "9698044", "title": "NBA／裁掉5天後簽回？太陽「先裁後簽」海史密斯藏玄機", "summary": "根據《ESPN》記者查拉尼亞（Shams Charania）報導，距離太陽在裁掉海史密斯（Haywood Highsmith）僅僅5天後，今日又重新簽回這名以防守見長的鋒線球員，並簽下一紙1年合約，而這筆看似「裁掉又簽回」的操作，很可能是太陽希望重新調整合約結構，替球隊保留更多薪資與名單彈性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239269.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 10:26", "link": "/news/story/7002/9698044"}, {"article_id": "9698060", "title": "羽球世錦賽／周天成輕鬆過頭關 林俊易、麟榤配接續登場", "summary": "2026年羽球世錦賽昨天在印度新德里點燃戰火，首日賽程就爆出大冷門，中國「世界球王」石宇奇3局大戰以14：21、21：13、19：21敗給世界排名22的地主謝提（Ayush Shetty）；列男單第6種子的我國「一哥」周天成首輪沒遇太大阻礙，碰世界排名126的菲律賓維拉弗爾（Clarence Villaflor）只花34分鐘就以兩個21：12過關。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239354.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-18 10:20", "link": "/news/story/7005/9698060"}, {"article_id": "9697983", "title": "MLB／曾單換李灝宇、經典賽封鎖美國 義大利明星右投遭洛磯DFA", "summary": "洛磯隊34歲先發右投羅倫佐（Michael Lorenzen）今天出賽26場，防禦率高達7.08，今天被洛磯指定讓渡（DFA）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239190.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 10:02", "link": "/news/story/6999/9697983"}, {"article_id": "9697959", "title": "辛辛那提女網／超級搶十不敵頭號種子 吳芳嫺首輪止步", "summary": "辛辛那提女網賽壓軸登場的我國女將吳芳嫺，今天和克羅埃西亞搭檔尤拉克（Darija Jurak-Schreiber）對決頭號種子捷克絲妮柯娃（Katerina Siniakova）／美國湯森（Taylor Townsend），台克組合將戰局逼到「超級搶10」，可惜差3分無緣晉級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239173.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 09:41", "link": "/news/story/7005/9697959"}, {"article_id": "9697881", "title": "MLB／3小時前還有更新IG 響尾蛇球星飛抵客場卻搞失蹤缺席原因成謎", "summary": "響尾蛇隊今天在客場面對紅襪隊，賽前久候不到自家球星馬提（Ketel Marte），繳不出先發打線，直到開賽前8分鐘才確定打線安排，馬提則被放進限制名單，缺席原因仍然是謎團，等待賽後說明。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35239057.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 08:50", "link": "/news/story/6999/9697881"}, {"article_id": "9697829", "title": "MLB／超越張育成！李灝宇只用2球敲單季第55安、56安 寫台灣首見紀錄", "summary": "李灝宇正式將台灣紀錄單獨掛上自己的名字，今天首局就在一、三壘有人時敲出安打，本季第55支安打出爐，第三局又火速補上第56支安打，超越張育成在2021年締造的54安紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35238998.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-18 08:05", "link": "/news/story/6999/9697829"}, {"article_id": "9696645", "title": "台灣球員首度在大聯盟單季敲80、甚至90安 就看今年李灝宇", "summary": "李灝宇本季追平張育成的台灣野手單季54安紀錄，若維持使用率，季末估可達82至90安，挑戰大聯盟80安、90安新高；選球與守備是明年爭取先發的關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237780.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-18 07:00", "link": "/news/story/122629/9696645"}, {"article_id": "9696801", "title": "日職／一軍表現佳、成正式球員 孫易磊等小將本季已收穫滿滿", "summary": "台灣旅日小將本季表現亮眼，火腿孫易磊拿下日職生涯首勝，軟銀張峻瑋、歐力士陳睦衡也升為正式球員，展現二軍磨練成果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237990.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&sl=W&fw=360", "date": "2026-08-18 07:00", "link": "/news/story/122629/9696801"}, {"article_id": "9696821", "title": "高國豪圈粉！瓊斯盃是台灣籃壇世紀資產 不是世代悲歌", "summary": "第45屆瓊斯盃8月14日在新莊體育館登場，文章肯定其台灣籃球資產地位，並關注「中日之戰」觀眾明顯減少，籲籃協強化投入與傳承。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238035.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&sl=W&fw=360", "date": "2026-08-18 07:00", "link": "/news/story/122629/9696821"}, {"article_id": "9697511", "title": "選手轉戰半導體…資格放寬？運動部：年底通盤檢討", "summary": "運動部前身教育部體育署，自民國一一二年委託國立高雄大學推動「選手前進半導體培訓計畫」，運動部表示，計畫推動迄今已建立招募、職涯諮詢、企業媒合及在職培訓的完整運作模式，參與企業皆給予高度肯定，至於是否尋求其他輔導運動員轉職的作法，將通盤檢視本計畫辦理情形，再評估。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-08-18 00:00", "link": "/news/story/7005/9697511"}, {"article_id": "9697513", "title": "合庫、土銀支持選手轉型 退役國手變經理", "summary": "公股行庫長年支持球隊，並且提供球員轉型為銀行員的管道，以合庫、土銀為例，相關制度已運作超過四十年。合庫負責培訓的主管觀察，選手的忠誠度高、團隊精神佳，抗壓力也比一般行員有過之而無不及，加上運動員天性較為開朗，與客戶接洽也有優勢，因此對銀行具有正面加乘效果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_3.jpg", "date": "2026-08-18 00:00", "link": "/news/story/7005/9697513"}, {"article_id": "9697488", "title": "納米比亞沙漠7日賽第二站「沙丘之路」 林義傑與李銘峰奮戰續保官方團體組第一", "summary": "Team Taiwan勇奪賽事第二天冠軍，暫居官方團體組總排第一；賽事在濃霧與巨型沙丘中激戰，明日將迎戰38公里沙地賽程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238699.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 23:28", "link": "/news/story/7227/9697488"}, {"article_id": "9697478", "title": "羽球世錦賽／首日賽程大冷門 球王石宇奇不敵地主64強就出局", "summary": "2026年羽球世錦賽今天將在印度新德里點燃戰火，首日賽程就爆出大冷門，中國「世界球王」石宇奇3局大戰敗給世界排名22的地主謝提（Ayush Shetty），以14：21、21：13、19：21出局，讓現場球迷歡聲雷動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238673.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 22:45", "link": "/news/story/7005/9697478"}, {"article_id": "9697300", "title": "舉重／郭婞淳接任原住民族舉協副理事長！第二屆原住民族舉重賽高雄登場", "summary": "第二屆原住民族舉重錦標賽17日至19日在高雄鼓山高中舉行，郭婞淳當選協會副理事長，49單位、170名選手參賽，展現原住民族舉重實力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238558.jpg&M=1&s=Y&x=0&y=78&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 21:22", "link": "/news/story/7005/9697300"}, {"article_id": "9697208", "title": "鋼鐵進城！台北101水舞廣場百人夜訓秒殺 全球極限體能大賽10月台中熱血開戰", "summary": "台北101水舞廣場百人夜訓名額迅速額滿，2026全球極限體能鋼鐵大賽將於10月17、18日在台中市府廣場登場，兩組報名至8月23日。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238467.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 20:20", "link": "/news/story/7005/9697208"}, {"article_id": "9697087", "title": "NBA／誰是西洋棋之王？ 字母哥隔空向溫班亞瑪下戰帖", "summary": "過去3個賽季，安戴托昆波（Giannis Antetokounmpo）與溫班亞瑪（Victor Wembanyama）多次在籃球場正面交鋒，每當兩人碰頭，都成為備受矚目的焦點對決。不過這一次，安戴托昆波似乎想將兩人的較量從籃球場延伸到棋盤上。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238367.jpg&M=1&s=Y&x=54&y=14&sw=1128&sh=752&exp=3600&sl=W&fw=360", "date": "2026-08-17 18:57", "link": "/news/story/7002/9697087"}, {"article_id": "9697015", "title": "中職／陳鏞基連2週回家鄉台東出賽 18日雄鷹派黃子鵬先發", "summary": "中職統一7-ELEVEn獅隊明天起作客台東棒球場與台鋼雄鷹2連戰，將是43歲老將陳鏞基球員生涯最後一次在家鄉出賽，雄鷹隊...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238281.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 18:10", "link": "/news/story/7001/9697015"}, {"article_id": "9697022", "title": "NBA／加入小鮑爾灰狼展現新氣象 愛德華放話：能擊敗雷霆、馬刺", "summary": "儘管球隊陣容今夏面臨不小變動，但灰狼當家少主愛德華（Anthony Edwards）對於新賽季的前景依然充滿信心，他甚至直言，灰狼有能力在競爭激烈的西區擊敗目前最具威脅的兩支球隊─雷霆和馬刺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238274.jpg&M=1&s=Y&x=92&y=24&sw=1072&sh=714&exp=3600&sl=W&fw=360", "date": "2026-08-17 18:07", "link": "/news/story/7002/9697022"}, {"article_id": "9696922", "title": "中職／富邦悍將Thank You日籍投手阿部雄大 返日延續球季", "summary": "富邦悍將宣布，日籍投手阿部雄大提前終止合約返日延續球季；他本季一軍出賽10場、拿下3勝，球團祝福並盼未來再合作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238154.jpg&M=1&s=Y&x=112&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-17 17:33", "link": "/news/story/7001/9696922"}, {"article_id": "9696707", "title": "棒球／42年前洛杉磯奧運老國手亮相 林華韋對新一代國手有話說", "summary": "攸關2028年洛杉磯奧運棒球賽門票的兩大國際賽，包括明年世界12強賽預、複賽，以及奧運最終資格賽都將在台北市進行，1984年洛杉磯奧運銅牌多名國手今天出席記者會，喚起不少老球迷的回憶，中華棒球協會副理事長林華韋說：「希望有機會再去現場看球。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237862.jpg&M=1&s=Y&x=0&y=0&sw=1230&sh=820&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:57", "link": "/news/story/7001/9696707"}, {"article_id": "9696673", "title": "棒球／12強、奧運資格賽在北市 蔣萬安：讓台北大巨蛋變世界大巨蛋", "summary": "中華棒球隊挑戰2028年洛杉磯奧運，攸關參賽門票的兩項賽事，包括明年世界12強賽預、複賽，以及奧運最終資格賽都將在台北市舉辦，亞洲棒球總會會長、世界棒壘球總會副會長辜仲諒說：「感謝WBSC排除萬難，以及相關團隊共同努力，讓我們好不容易爭取到這個機會。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237794.jpg&M=1&s=Y&x=0&y=0&sw=1022&sh=681&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:42", "link": "/news/story/7001/9696673"}]}, {"name": "棒球", "articles": [{"article_id": "9697015", "title": "中職／陳鏞基連2週回家鄉台東出賽 18日雄鷹派黃子鵬先發", "date": "2026-08-17 18:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238281.jpg&M=1&s=Y&x=0&y