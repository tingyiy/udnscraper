il": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332284.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9755985"}]}, {"name": "最新文章", "articles": [{"article_id": "9766825", "title": "棒球開打今晚迎台韓大戰 中華奇兵對戰南韓王牌投手", "summary": "名古屋亞運棒球賽事今天點燃戰火，中華隊要力拚暌違廿年的棒球金牌，預賽首戰就要迎接眾所矚目的「台韓大戰」。台灣時間今晚五點卅分在岡崎棒球場開打，雙方先發亮牌，中華隊出奇兵，由廿歲業餘投手林佾葳扛重任；南韓昨宣布先發投手為韓職斗山熊郭彬，被視為本屆韓國隊王牌投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-09-21 00:00", "link": "/news/story/124981/9766825"}, {"article_id": "9766828", "title": "花3年雪恥 簡慧萱亞運兩次眼淚 兩種心情", "summary": "名古屋亞運中華代表團第一面獎牌，昨天在空手道賽場出爐，台灣女將簡慧萱第二度征戰亞運，在女子個人「型」奪下銅牌，一掃三年前因錯失獎牌而爆哭的遺憾，她昨感謝各方的協助，也謝謝自己的努力，賽後更忍不住喜極而泣，兩次的眼淚代表不同心情。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35347174.jpg&M=2&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-21 00:00", "link": "/news/story/124981/9766828"}, {"article_id": "9766823", "title": "首日告捷 軟網克韓輸日 男女團賽奪2銀", "summary": "名古屋亞運昨天首個獎牌日就傳捷報，軟式網球代表隊昨天在男、女團雙雙於四強賽擊退南韓闖進決賽，但在金牌戰都不敵強敵地主日本，最後收下兩面銀牌，加上空手道女子個人「型」簡慧萱也奪下一面銅牌，成功為代表團開出紅盤，首日拿下二銀、一銅。運動部長李洋賽後轉交總統賀電，代表團長蔡家福與總領隊廖裕輝頒發獎勵金，肯定軟網隊奮戰精神。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35347171.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 00:00", "link": "/news/story/124981/9766823"}, {"article_id": "9766831", "title": "台灣人壽董字輩 帶頭「泳」闖日月潭", "summary": "台灣人壽連續三年「泳」闖日月潭，董字輩「泳」士首度出任務，台灣人壽獨立董事林建智、董事暨中國信託產險董事長王志誠與保險顧問組隊參賽，挑戰長泳日月潭，台灣人壽總經理莊中慶與吉祥物台灣阿龍擔任「泳渡大使」，應援泳士們，以行動力挺國際級運動、投資健康資產。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35347181.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 00:00", "link": "/news/story/7005/9766831"}, {"article_id": "9766829", "title": "名古屋隨筆／軟網重返發源地 台選手變球星", "summary": "名古屋亞運昨天展開首個獎牌日賽事，我國「獎牌庫」軟式網球代表隊隨即傳回捷報，一舉進帳兩面團體賽獎牌。這項在國內長年被貼上「冷門」標籤的運動，回到發源地日本後卻展現驚人魅力；記者現場直擊，賽事不僅吸引大批地主球迷湧入，台灣選手賽後更被日本小粉絲團團包圍索取簽名，享受如球星般的待遇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-09-21 00:00", "link": "/news/story/124981/9766829"}, {"article_id": "9766758", "title": "中職／陳鏞基引退淚別球迷 告誡年輕球員：千萬千萬要自愛", "summary": "中華職棒統一7-ELEVEn獅隊球星陳鏞基今年球季結束即將引退，今天在台南亞太棒球場舉辦的引退儀式上，陳鏞基一致詞就忍不...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35347121.jpg&M=1&s=Y&x=0&y=371&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 22:33", "link": "/news/story/7001/9766758"}, {"article_id": "9766790", "title": "亞運棒球／不畏強敵「來什麼擋什麼」 林昱珉：我狀況很好也想丟韓國", "summary": "歷經20小時的旅途，效力於響尾蛇隊的左投林昱珉昨晚飛抵日本名古屋，今天晚間參與首次官方練球，明天就要迎接亞運預賽首戰，在對南韓之戰先發未亮牌之前，林昱珉也在接受台、韓媒體訪問時笑說：「我狀況很好，我也想丟韓國隊！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/02/34722789.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-20 22:32", "link": "/news/story/124981/9766790"}, {"article_id": "9766755", "title": "亞運棒球／韓華隊友下戰帖「文賢彬說他想打安打」 王彥程：場上見！", "summary": "效力於韓職韓華鷹的台灣左投王彥程，前天從南韓飛抵日本名古屋向中華隊會合，明天名古屋亞運預賽首戰就要迎接台韓大戰，也將有望對決他的韓華隊友，王彥程笑說：「大家都準備好了，那就⋯⋯場上見。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2025/04/16/98/31873064.jpg&s=Y&x=0&y=0&sw=1277&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-20 22:09", "link": "/news/story/124981/9766755"}, {"article_id": "9766723", "title": "籃球／峰造極大專組開打 胡晉豪投進致勝3分球國體險勝上海交大", "summary": "登峰造極大專組開打，國立體大靠胡晉豪最後48.2秒投進致勝三分球，以55比51險勝上海交大；臺藝、文化分別擊敗健行與臺師。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35347023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 21:51", "link": "/news/story/7003/9766723"}, {"article_id": "9766687", "title": "亞運／女排8強戰中華不敵日本 續拚5-8排名賽", "summary": "名古屋亞運女子排球賽8強戰今天舉行，中華隊面對強敵日本隊逐漸展現對抗性，但仍以12比25、16比25、19比25落敗，未...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346973.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-20 21:11", "link": "/news/story/124981/9766687"}, {"article_id": "9766648", "title": "亞運／開幕第2天 中華隊重戲男子體操登場、棒球預賽首戰韓國", "summary": "名古屋亞運進入開幕後第2天，中華代表隊獎牌已經開胡，明天將有競技體操男子隊登場，靠唐嘉鴻、李智凱雙王牌打出氣勢，而棒球隊...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346968.jpg&M=1&s=Y&x=0&y=124&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 21:03", "link": "/news/story/124981/9766648"}, {"article_id": "9766637", "title": "亞運棒球／「台韓大戰」先發亮牌 中華隊20歲業餘投手林佾葳對決郭彬", "summary": "名古屋亞運棒球賽明天開打，中華隊將在首戰對上南韓，先發出奇兵，將由20歲業餘投手林佾葳扛先發重任，對決南韓王牌郭彬。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346947.jpg&M=1&s=Y&x=0&y=159&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 20:40", "link": "/news/story/124981/9766637"}, {"article_id": "9766628", "title": "亞運男籃／逆轉日本奪金！南韓免役致勝功臣哭了", "summary": "亞運男籃金牌戰今晚登場，地主日本隊首度和南韓在最終戰正面對決，以二軍出征的日本第二節曾取得7分領先，南韓半場打完先將比分追平，第三節再靠8投6中的三分球表現超前比分，最終以67：56奪下隊史第4面亞運男籃金牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346959.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 20:36", "link": "/news/story/124981/9766628"}, {"article_id": "9766615", "title": "中職／余德龍3安猛打助猿狂電雄鷹 終於等到本季首次單場MVP", "summary": "樂天桃猿隊昨天在桃園主場被狂攻11分吞敗，今天再戰台鋼雄鷹隊，全隊揮出14支安打狂攻10分，終場以10：1大勝，終止最近3連敗，余德龍4打數3安打（1支三壘打），攻下3分打點、跑回3分、盜壘成功1次，本季首次獲選單場MVP。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346911.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-20 20:26", "link": "/news/story/7001/9766615"}, {"article_id": "9766580", "title": "亞運綜合格鬥／「最狠女人」林郁芬右膝韌帶撕裂 抱憾出局", "summary": "「最狠女人」的台灣女子綜合格鬥好手林郁芬，今天帶著右膝韌帶撕裂傷勢，在亞運女子傳統組60公斤級8強，以0比3不敵烏茲別克...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346894.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 20:17", "link": "/news/story/124981/9766580"}, {"article_id": "9766571", "title": "亞運棒球／首戰南韓隊 中華隊先發暫定出奇兵可能由業餘投手先發", "summary": "名古屋亞運棒球賽事今天點燃戰火，中華隊要力拚睽違20年的棒球金牌，預賽首戰就要迎接眾所矚目的「台韓大戰」。台灣時間今晚五點卅分在岡崎棒球場開打，雙方先發亮牌，中華隊預料會出奇兵，由廿歲業餘投手林佾葳扛重任。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346879.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 20:08", "link": "/news/story/124981/9766571"}, {"article_id": "9766554", "title": "中職／陳鏞基引退賽爆滿球迷歡呼 獅隊被范國宸3分砲、4分打點擊沉", "summary": "富邦悍將隊作客台南亞太棒球場，今天再度和統一獅隊交手，范國宸砲火凶猛，全場4打數2安打，包括4局上3分全壘打，以及8局上安打攻下致勝分，領軍悍將4：3獲勝，賽後獲單場MVP，獅隊中斷亞太主場5連勝紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346852.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-20 19:53", "link": "/news/story/7001/9766554"}, {"article_id": "9766549", "title": "亞運游泳／5台將挺進決賽 林姵彣50公尺蛙式第6寫單日台灣最佳", "summary": "名古屋亞運今天展開游泳賽程，首日台將7人登場、5人進入決賽，以「台灣蛙后」林姵彣在女子50公尺蛙式排名第6成績最佳。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346847.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-20 19:40", "link": "/news/story/124981/9766549"}, {"article_id": "9766541", "title": "中職／通知「脫掉」準備代打 高宇杰再見一擊遭平野強吻：調皮！", "summary": "中信兄弟隊今天以2：1擊敗味全龍隊，又是一場再見勝，龍隊九局下「5人內野」失敗收場，高宇杰代打以再見高飛犧牲打終結戰線。高宇杰收到準備通知時人在牛棚看電視，突然聽到叫自己名字，「叫我脫掉護具、先熱起來。」當英雄瞬間，總教練平野惠一把他壓在地上親，讓高宇杰也受不了，「亂親！調皮！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346916.jpg&M=1&s=Y&x=0&y=76&sw=1167&sh=778&exp=3600&sl=W&fw=360", "date": "2026-09-20 19:29", "link": "/news/story/7001/9766541"}, {"article_id": "9766521", "title": "亞運軟網／陳郁勲左腳骨折重返球場 男團奪銀感動落淚", "summary": "名古屋亞運中華軟式網球男子團體今天在金牌戰以直落二敗給日本，連續兩屆拿到銀牌，不過對於傷癒復出的陳郁勲而言，這面獎牌得來...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346827.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 19:11", "link": "/news/story/124981/9766521"}, {"article_id": "9766528", "title": "中職／已預判打得淺郭天信也會跑 曾頌恩關鍵助殺腦中已擬好", "summary": "中信兄弟隊的再見勝，連三拉三，今天再以2：1擊敗味全龍隊，推進7連勝，曾頌恩八局上的關鍵助殺擋下對手超前分，九局下延續攻勢的安打，獲選為單場MVP。談到用雷射肩幫助球隊，曾頌恩透露早已預判，打到自己這邊的機率高，且就算打得很淺，郭天信也會起跑，「我應該算上面外野三個臂力最不好的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346816.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 19:05", "link": "/news/story/7001/9766528"}, {"article_id": "9766524", "title": "亞運桌球／17歲郭冠宏處女秀開紅盤 中華男團奪分組龍頭", "summary": "名古屋亞運桌球團體賽今天登場，中華隊女團、男團首戰都連拿3點旗開得勝，女團第二戰碰北韓以1：3失守，男團面對巴林再以直落三取勝，提前鎖定分組第一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346830.jpg&M=1&s=Y&x=0&y=79&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 18:59", "link": "/news/story/124981/9766524"}, {"article_id": "9766518", "title": "日月潭萬人泳渡導入GPS即時定位 科技守護身障與視障泳者水域安全", "summary": "2026年日月潭萬人泳渡圓滿落幕，今年活動持續強化水域安全與科技應用，除導入泳者下水雙晶片管理機制，協助掌握泳者進出水域狀況，也可透過晶片識別協助尋回遺失魚雷浮標。台灣運動科技公司快樂島股份有限公司今年並將GPS即時定位技術應用於泳渡安全服務，協助掌握身障選手及視障運動員在開放水域中的移動位置與泳渡軌跡。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346789.png&M=1&s=Y&x=0&y=0&sw=1079&sh=719&exp=3600&sl=W&fw=360", "date": "2026-09-20 18:50", "link": "/news/story/7005/9766518"}, {"article_id": "9766515", "title": "MLB／大谷翔平季後賽恢復神勇？官網：最多只剩5場重新適應節奏", "summary": "道奇隊今天以10：4大勝巨人隊，例行賽只剩最後7場比賽，總教練羅伯茲（Dave Roberts）賽後被問到大谷翔平何回歸的問題，他說：「很有可能在下個系列賽見到他。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346787.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 18:40", "link": "/news/story/6999/9766515"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9766637", "title": "亞運棒球／「台韓大戰」先發亮牌 中華隊20歲業餘投手林佾葳對決郭彬", "date": "2026-09-2