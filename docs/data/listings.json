photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332223.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 10:09", "link": "/news/story/6999/9757477"}, {"article_id": "9757445", "title": "NBA／到綠衫軍開啟第20賽季 康利盼與喬治一起終結冠軍荒", "summary": "38歲的後衛康利（Mike Conley）將在塞爾蒂克隊迎接生涯第20個賽季，成為史上第14位在聯盟馳騁20個賽季的球員。今天他和喬治（Paul George）出席綠衫軍舉行的記者會，強調自己「油箱還有油」，希望能在波士頓奪下生涯不曾嘗過的總冠軍滋味。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332213.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-16 10:02", "link": "/news/story/7002/9757445"}, {"article_id": "9757422", "title": "中職／超暖！莊昕諺遭強襲球直擊 郭俊麟投手丘寫「6字」祝福", "summary": "統一獅隊昨天在嘉義球場迎戰樂天桃猿隊，獅隊先發投手郭俊麟賽前一舉動感動無數球迷，他在投手丘寫下「77早日康復」，為先前遭強襲球直擊臉部的猿隊投手莊昕諺祈福。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332166.jpg&M=1&s=Y&x=0&y=0&sw=1191&sh=794&exp=3600&sl=W&fw=360", "date": "2026-09-16 09:59", "link": "/news/story/7001/9757422"}, {"article_id": "9757373", "title": "MLB／山本由伸7局無失分本季179局、14勝雙寫生涯新高 道奇分區封王M2", "summary": "道奇隊今天客場出戰紅人隊，山本由伸再繳7局無失分的優質先發表現，只被敲1支安打，送出7次三振，投出本季第21場優質先發，拿下大聯盟生涯新高的第14勝；道奇終場以4：0完封紅人收下2連勝，分區封王魔術數字也降至「2」，最快明天完成國聯西區5連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332090.jpg&M=1&s=Y&x=0&y=0&sw=1272&sh=848&exp=3600&sl=W&fw=360", "date": "2026-09-16 09:28", "link": "/news/story/6999/9757373"}, {"article_id": "9757337", "title": "NHL／巨星歐維契金現身普丁廣告惹議 球隊出面緩頰", "summary": "北美職業冰球（NHL）華盛頓首都隊巨星歐維契金日前現身俄羅斯總統普丁的競選影片，引發外界批評。華盛頓首都隊今天表示，歐維...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332050.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 09:18", "link": "/news/story/7005/9757337"}, {"article_id": "9757257", "title": "足球／梅西國家隊告別戰 阿根廷徵召踢10月貝南友誼賽", "summary": "阿根廷足球協會今天公布對貝南友誼賽名單，39歲球星梅西獲徵召，將於10月6日出賽。梅西上月宣布退出國際賽舞台，這場比賽將...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332041.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-16 09:15", "link": "/news/story/7005/9757257"}, {"article_id": "9757293", "title": "MLB／大谷翔平傷後首度練打 道奇教頭：感覺良好", "summary": "美國職棒大聯盟MLB洛杉磯道奇總教練羅伯茲（Dave Roberts）表示，日籍球星大谷翔平今天在洛杉磯進行擊球座打擊練...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332024.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 09:13", "link": "/news/story/6999/9757293"}, {"article_id": "9757305", "title": "NBA／和布朗互換東家 喬治轉戰綠衫軍：要抓住絕佳機會", "summary": "從費城轉戰波士頓的喬治（Paul George），今天在球隊舉辦的記者會上表示，自己耳朵沒聾，外界的不滿聲音都有聽到，也能明白自身處境，但身為球員，能做的就是把握每一次機會。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332207.jpg&M=1&s=Y&x=0&y=182&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 08:53", "link": "/news/story/7002/9757305"}, {"article_id": "9756739", "title": "中職／本土奇兵崛起成亮點 富邦滿手好牌卻接連放槍", "summary": "中職下半季本土投手奇兵接連崛起，李東洺等人扛起戰力；富邦悍將投手受傷、失調與狀態低迷，滿手好牌卻逐漸陷入困境。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331229.jpg&M=1&s=Y&x=0&y=73&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 07:00", "link": "/news/story/122629/9756739"}, {"article_id": "9755985", "title": "「毀滅性打擊」快艇背後 NBA如何從密約事件重建公信力？", "summary": "經過漫長的12個月，隨著一連串令人震驚的新細節與爆料浮上檯面，鮑默與快艇隊終於獲得應有的懲罰，對NBA無數球隊高層、教練與工作人員而言，這場持續一年的風波總算告一段落，也終於能夠鬆一口氣，但更重要的是，它讓人重新感到安心——聯盟內部信任開始修復，陰謀論者提出的所有質疑聲也終於得到答案：一切照舊，既定規則得以維護，聯盟再次順暢運轉，而席佛也成功挽回了名聲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332284.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 07:00", "link": "/news/story/122629/9755985"}, {"article_id": "9756781", "title": "中職／龍隊連敗時感受圖書館寂靜 張政禹享受邦迷噓聲：還滿感謝", "summary": "味全龍隊今天以3：0擊敗富邦悍將隊，張政禹3安猛打，在此役悍將球迷滿場噓聲中出賽，讓他直呼「還滿享受」，感受到季後賽的張力，不像前幾場球隊狀況不好時很像圖書館。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331267.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-15 22:12", "link": "/news/story/7001/9756781"}, {"article_id": "9756752", "title": "中職／最不想丟到的就是戴培峰 葉總盼選手「翻頁」正常比賽", "summary": "上周因1顆近身球掀起推人風波，富邦悍將、味全龍隊今天交手，又出現一顆正好砸在事主戴培峰身上的觸身球，龍隊教頭葉君璋賽後主動提到這球，他說當選手一直在怕什麼、避免什麼，反而是最麻煩的，「投手最不想丟到的人就是戴培峰，有這樣的想法，不小心就會丟到。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331241.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 21:55", "link": "/news/story/7001/9756752"}, {"article_id": "9756749", "title": "PLG／觀看友誼賽心肌梗塞送醫 聯盟：陳建州術後恢復狀況良好", "summary": "PLG赴副會長陳建州在今天傳出因為急性心肌梗塞送醫的狀況，PLG聯盟晚間也回覆，陳建州是在今天於觀看PLG友誼賽時，身體突然感到不適，隨即前往醫院就診，在接受手術後恢復狀況良好，感謝各界關心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331239.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 21:51", "link": "/news/story/7003/9756749"}, {"article_id": "9756735", "title": "中職／吉力吉撈4打席遇噓聲全餐 吞K掀邦迷歡聲雷動", "summary": "本季張力最足的「龍邦大戰」，經過上周近身球風波升溫後，首度在新莊棒球場過招，吉力吉撈．鞏冠全場4打席吃飽噓聲全餐，悍將球迷在他的打席給出的最大歡呼聲，來自第八局賴鴻誠賞出三振。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331221.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 21:33", "link": "/news/story/7001/9756735"}, {"article_id": "9756734", "title": "中職／怎麼辦？悍將花光上半季8勝優勢 全年戰績跌回5成勝率", "summary": "兩支連敗之師正面過招，富邦悍將隊0：3遭到味全龍隊完封，悍將推進4連敗，上半季打下的勝場優勢（34勝26敗）至此消耗一空，全年戰績打平52勝52敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331220.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 21:33", "link": "/news/story/7001/9756734"}, {"article_id": "9756706", "title": "韓職／亞運前最後一場先發 王彥程4局挨轟失5分吞敗", "summary": "韓職韓華鷹投手王彥程今天先發投4局挨1轟，失掉5分責失分，球隊終場以3比13不敵KT巫師隊，王彥程吞下個人本季第6敗；王...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331188.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 21:09", "link": "/news/story/7001/9756706"}, {"article_id": "9756684", "title": "籃球／1.1秒準絕殺！北一登峰造極賽逆轉濟源一中", "summary": "2026興富發登峰造極青年籃球邀請賽今天在台北體育館點燃戰火，首日就有精采好戲，高中女子組尋求衛冕的北一女中，最後1.1秒靠著張薰文投進逆轉「準絕殺」三分球，以61：60氣走濟源一中；高中男子組首度參賽的三一高中男籃，68比94不敵的松山高中，老教頭李潤煥來頭大，兒子就是正在挑戰NBA的李賢重。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331116.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 20:51", "link": "/news/story/7003/9756684"}, {"article_id": "9756668", "title": "日職／林安可自打球傷退 西武監督擔憂：好像是直接打到膝蓋…", "summary": "效力西武獅隊的台灣好手林安可，今天因自打球擊中膝蓋退場，監督西口文也賽後透露，林安可被打到的位置是膝蓋上方骨頭的位置，接下來將先到醫院檢查，確認傷情，不諱言有脫離戰線的可能性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331186.jpg&M=1&s=Y&x=0&y=76&sw=1067&sh=711&exp=3600&sl=W&fw=360", "date": "2026-09-15 20:38", "link": "/news/story/7001/9756668"}, {"article_id": "9756428", "title": "亞運／義大利郵輪抵名古屋港 供數千亞運選手入住", "summary": "義大利歌詩達郵輪「莎倫娜號」（Costa Serena）今天抵達日本名古屋港金城碼頭，為即將開幕的愛知名古屋亞運提供住宿...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330799.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 18:16", "link": "/news/story/124981/9756428"}, {"article_id": "9756409", "title": "NBA／不滿職業生涯受牽連 蓋里納利怒批雷納德罰太輕：吐回5千萬美元", "summary": "來自義大利的前NBA球星蓋里納利（Danilo Gallinari）近日談到快艇與雷納德（Kawhi Leonard）薪資上限規避案調查結果時，對聯盟針對雷納德開出的處分相當不滿。他認為，雷納德只被罰70萬美元實在太輕，甚至主張雷納德應將外界質疑他在球員合約之外取得的相關金額全數捐出做公益。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330780.jpg&M=1&s=Y&x=0&y=5&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 18:10", "link": "/news/story/7002/9756409"}, {"article_id": "9756326", "title": "NBA／坦言詹皇聯手柯瑞從未接近成真 柯爾：只是外界瘋狂猜測", "summary": "金州勇士總教練柯爾（Steve Kerr）近日談到詹姆斯（LeBron James）今年自由球員市場動向時表示，儘管外界一度盛傳詹姆斯可能轉戰灣區，與柯瑞（Stephen Curry）強強聯手，但他從未真正感覺這件事接近發生。對柯爾而言，詹姆斯加盟勇士的說法更像是外界的瘋狂猜測，而不是實際進入高度可能階段的操作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330612.jpg&M=1&s=Y&x=13&y=49&sw=1243&sh=829&exp=3600&sl=W&fw=360", "date": "2026-09-15 17:44", "link": "/news/story/7002/9756326"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9756428", "title": "亞運／義大利郵輪抵名古屋港 供數千亞運選手入住", "date": "2026-09-15 18:16", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330799.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9756428"}, {"article_id": "9756210", "title": "亞運田徑／專注跑道、享受比賽 「短跑甜心」廖晏均保持初心迎戰亞運", "date": "2026-09-15 16:46", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330434.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9756210"}, {"article_id": "9756170", "title": "亞運排球／無緣征戰有些遺憾 「歐告」陳建禎未來仍想幫國家隊", "date": "2026-09-15 16:25", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330372.jpg&M=1&s=Y&x=0&y=0&sw=1267&sh=845&exp=3600&w=300", "link": "/news/story/124981/9756170"}, {"article_id": "9756030", "title": "亞運羽球／《奪牌之路 誰羽爭鋒》紀錄片首映 盼把祝福送到亞運", "date": "2026-09-15 15:28", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330147.jpg&M=1&s=Y&x=0&y=0&sw=1273&sh=848&exp=3600&w=300", "link": "/news/story/124981/9756030"}, {"article_id": "9756006", "title": "亞運／運彩加碼奪牌抽現金 彭政閔勉勵選手享受當下", "date": "2026-09-15 15:18", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330094.jpg&M=1&s=Y&x=0&y=0&sw=1250&sh=833&exp=3600&w=300", "link": "/news/story/124981/9756006"}]}, {"name": "棒球", "articles": [{"article_id": "9757422", "title": "中職／超暖！莊昕諺遭強襲球直擊 郭俊麟投手丘寫「6字」祝福", "date": "2026-09-16 09:59", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/3