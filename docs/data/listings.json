es": [{"article_id": "9840257", "title": "中職／年度三大獎入圍名單放榜 MVP獎落洋將、李東洺與2猿將爭進步獎", "summary": "中華職棒聯盟公布年度三大獎入圍名單，年度最有價值球員獎上演3位洋將相爭，分別是統一獅隊布雷克、味全龍隊蔣銲和台鋼雄鷹隊魔鷹，年度最佳進步獎由富邦悍將隊李東洺，以及樂天桃猿隊馬傑森、曾家輝相爭，新人王則由3位投手角逐。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35459287.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-27 17:27", "link": "/news/story/7001/9840257"}, {"article_id": "9840248", "title": "企業捐贈公務車挺中華體總推展事務 葉政彥致謝：以實際行動拋磚引玉", "summary": "為支持我國體育運動發展，提升體育行政及各項業務推展效能，智通科創股份有限公司董事長暨中華民國體育運動總會副會長鍾富瑋，今天慷慨捐贈公務車予中華民國體育運動總會，由會長葉政彥代表受贈，此次捐贈展現企業回饋社會、支持體育發展的具體行動，也為總會推動各項體育事務注入更多助力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35459271.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 17:24", "link": "/news/story/7005/9840248"}, {"article_id": "9840233", "title": "NBA／火箭4連勝森根大爆發！點名最重要隊友：有他在場打球太輕鬆", "summary": "火箭當家中鋒森根（Alperen Sengun）開季以來表現相當火燙，除了個人能力持續提升外，另一項重要因素就是主控范弗利特（Fred VanVleet）的回歸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35459243.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 17:22", "link": "/news/story/7002/9840233"}, {"article_id": "9840109", "title": "中職／自由球員年資公布！獅隊陳重羽、潘傑楷動向最受關注", "summary": "中華職棒聯盟今天公布自由球員年資，27位球員符合9年資格，其中13人為A級，而累積8年年資的5人皆為A級，最受矚目的是陳...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35459102.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 16:46", "link": "/news/story/7001/9840109"}, {"article_id": "9840093", "title": "影／王彥程談旅韓心路歷程 宋家豪一句話成堅持動力", "summary": "台灣左投王彥程結束韓職首個賽季，今天返台舉辦記者會，分享旅韓生活與心路歷程。今年他在韓華鷹繳出11勝成績，談及學長宋家豪送的手錶，直言這份禮物對他而言是無價的肯定。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35459011.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 16:14", "link": "/news/story/7001/9840093"}, {"article_id": "9840072", "title": "NBA／勇士主帥形容像牛一樣強壯！倫德伯格：太離譜了", "summary": "勇士隊首輪第11順位新秀倫德伯格（Yaxel Lendeborg）今天面對金塊隊，全場19投9中，罰球13中12，砍下31分12籃板6助攻，幫助勇士以134：114爆冷贏球，賽後勇士主帥柯爾（Steve Kerr）對倫德伯格讚譽有加，倫德伯格也認為自己的表現很離譜。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458985.jpg&M=1&s=Y&x=0&y=0&sw=1268&sh=845&exp=3600&sl=W&fw=360", "date": "2026-10-27 16:10", "link": "/news/story/7002/9840072"}, {"article_id": "9840011", "title": "韓職／宋家豪送的手錶無價 王彥程：是重要的人給我的肯定", "summary": "旅韓左投王彥程結束風光的2026年賽季，今天出席返台記者會，最激動情緒出現在談到宋家豪送的手錶時，那是來自日職文化學長送給學弟初登場的禮物，王彥程說：「等了5、6年，看到其他人發光發熱，常常想到何時輪到我。」即便已經轉戰韓職，宋家豪仍記著這份很想送出的禮物，在電話中告訴他「送你的禮物在路上了」，王彥程從收到的那一刻就一路戴著，銘記著初登板那天的心情。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458866.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:51", "link": "/news/story/7001/9840011"}, {"article_id": "9839995", "title": "NBA／在湖人拿不到球！八村壘：來到快艇做好準備承擔更多責任", "summary": "八村壘加盟快艇後準備扛起更重戰術角色，將展現進攻侵略性與組織能力；總教練魯肯定他的傳球判斷與空間掌控能力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458824.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:50", "link": "/news/story/7002/9839995"}, {"article_id": "9839934", "title": "中職／中信牛棚5人在台灣大賽一球未投！象迷還發文想念黃恩賜、吳俊偉", "summary": "中信兄弟台灣大賽連兩年以亞軍作收，牛棚五投手未登板；吳俊偉、黃恩賜缺陣引發象迷感嘆。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35459059.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:31", "link": "/news/story/7001/9839934"}, {"article_id": "9839964", "title": "籃球／總統盃3對3決賽周末凱道開戰 160支隊伍爭奪最高榮耀", "summary": "運動部全民運動署今天於運動部舉辦2026全民運動賽事總統盃3對3籃球賽全國決賽記者會，本周末在總統府前凱達格蘭大道登場的全國決賽揭開序幕，由來自全國各縣市共計160支優勝隊伍，展開精彩激烈的巔峰對決，爭奪年度最高榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458763.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:30", "link": "/news/story/7003/9839964"}, {"article_id": "9839912", "title": "NBA／火箭升空開季4連勝 森根全能數據比肩約柯奇神級紀錄", "summary": "火箭當家中鋒森根（Alperen Sengun）延續開季以來的火燙狀態，今天主場面對老鷹又繳出29分、9籃板、9助攻、6抄截的全能表現，帶領球隊以120：110擊敗對手，連續2場交手都拿下勝利，且將連勝場次推進至4場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458652.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:27", "link": "/news/story/7002/9839912"}, {"article_id": "9839956", "title": "韓職／光速續留韓華有原因 王彥程：沒有他們我今天不會在這邊", "summary": "王彥程的2026年球季在南韓職棒留下精彩回憶，外界期待他的下一步，而他火速決定續留韓華鷹隊，王彥程的不變有原因，「沒有他們，我今年不會在這邊。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458746.jpg&M=1&s=Y&x=0&y=743&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:24", "link": "/news/story/7001/9839956"}, {"article_id": "9839933", "title": "NBA／公鹿比熱火早拿下賽季首勝！官方諷：佛羅里達球迷糟糕的一天", "summary": "休賽季密爾瓦基公鹿隊將「字母哥」安戴托昆波（Giannis Antetokounmpo）交易至邁阿密熱火隊，結果熱火今天苦吞開季4連敗；公鹿則是以110：102擊敗印第安那溜馬隊首勝開張。另外，美國職棒世界大賽密爾瓦基釀酒人隊以10：1痛宰坦帕灣光芒隊，公鹿官方就發文嘲諷：「對佛羅里達球迷來說真是糟糕的一天。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458718.jpg&M=1&s=Y&x=0&y=220&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:20", "link": "/news/story/7002/9839933"}, {"article_id": "9839929", "title": "韓職／「TWICE還在就不是問題」 王彥程同框娜璉連前隊友都問怎麼可以", "summary": "台灣左投王彥程今年在南韓職棒度過大豐收賽季，意外收穫是與南韓女團TWICE成員娜璉合照，讓身為ONCE的他直言圓夢，笑說，連以前樂天金鷲隊的隊友都問他「怎麼可以」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458723.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:12", "link": "/news/story/7001/9839929"}, {"article_id": "9839883", "title": "NBA／安比德缺陣41歲詹皇扛中鋒 無奈喊話：我加盟可不是為了打5號位", "summary": "41歲詹姆斯被迫頂替中鋒，76人主場93：106不敵活塞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458587.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-27 15:00", "link": "/news/story/7002/9839883"}, {"article_id": "9839899", "title": "TPBL／林書緯率國王開季二連勝 洛斯柯罕見「40＋20」獲選周MVP", "summary": "台灣職業籃球大聯盟（TPBL）2026-27 賽季第二周單周最有價值球員（MVP）出爐，由新北國王隊林書緯與高雄全家海神隊洛斯柯（Rosco Allen）分別獲選本土及外援周MVP，兩人在25日賽事中展現出色表現，林書緯以穩定的進攻組織與關鍵得分，幫助國王延續開季不敗氣勢；洛斯柯則以42分、22籃板寫下聯盟新紀錄，成為海神收下新賽季首勝的重要功臣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458600.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-27 14:56", "link": "/news/story/7003/9839899"}, {"article_id": "9839879", "title": "高球／緯創公開賽獎金升至120萬美元 曾雅妮、坦布爾里尼力拚奪冠", "summary": "由緯創資通與台灣女子職業高爾夫協會（TLPGA）、歐洲女子巡迴賽（LET） 共同舉辦的「2026 緯創女子公開賽」，即將於10月29日（四）至11月1日（日）在揚昇高爾夫鄉村俱樂部盛大開打，台灣唯一歐巡認證的國際頂級職業高球賽事，本屆總獎金提升至120萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458579.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-27 14:49", "link": "/news/story/7005/9839879"}, {"article_id": "9839862", "title": "韓職／姜白虎帶吃烤腸、柳賢振1句「需要什麼」 溫暖王彥程旅韓生活", "summary": "台灣左投王彥程結束韓職生涯首個賽季，今天舉辦返台記者會，暢談旅韓生活，儘管到了陌生的國度，但受到許多隊友、球迷的細心呵護，王彥程透露來自姜白虎帶吃的烤腸、柳賢振一句「需要什麼就跟我說」，以及點咖啡總是多出的一塊蛋糕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458716.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 14:41", "link": "/news/story/7001/9839862"}, {"article_id": "9839795", "title": "NBA／29分大三元也救不了熱火 字母哥坦言全隊充滿沮喪情緒", "summary": "字母哥砍29分15籃板11助攻大三元仍難救熱火，球隊不敵獨行俠吞開季四連敗；他呼籲保持耐心、加強團結與進攻流暢度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458381.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 14:41", "link": "/news/story/7002/9839795"}, {"article_id": "9839732", "title": "體操／世錦賽單槓冠軍唐嘉鴻返台 很開心為台灣拿到具意義的金牌", "summary": "剛剛奪下世界體操錦標賽單槓冠軍的唐嘉鴻今天搭機返台，他表示，很開心可以為台灣拿到具有意義的一面金牌，明年希望在團體或個人...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458454.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 14:30", "link": "/news/story/7005/9839732"}, {"article_id": "9839747", "title": "NBA／勇士倫德伯格一數據比肩歐尼爾等3傳奇！柯瑞也創個人首見紀錄", "summary": "勇士隊首輪第11順位新秀倫德伯格（Yaxel Lendeborg）今天狂砍31分12籃板，成為1985-86賽季起第4位，生涯前4場累積至少85分35籃板的球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458284.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 14:05", "link": "/news/story/7002/9839747"}, {"article_id": "9839500", "title": "德國羽賽／台灣15組人馬參賽 王齊麟、邱相榤先不想衛冕的事", "summary": "BWF超級500等級的德國海洛羽球公開賽今天登場，台灣共15組人馬參賽，其中男雙王齊麟/邱相榤列為大會第5種子，也將尋求...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458271.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-27 14:00", "link": "/news/story/7003/9839500"}, {"article_id": "9839700", "title": "中職／不甘心球季就這樣結束！ 兄弟「一指」余謙發聲：盼能化遺憾為動力", "summary": "兄弟投手余謙賽後發文，雖台灣大賽僅登板一次仍不甘球季結束，盼將遺憾化為成長動力，期待明年再拚更佳表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458212.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-27 13:56", "link": "/news/story/7001/9839700"}, {"article_id": "9839729", "title": "NBA／發揮高效能殺手本色 普里查德談開季慢熱：努力找回節奏", "summary": "過去贏得年度最佳第六人的普里查德（Payton Pritchard），今天再度扮演進攻及時雨的角色，他僅替補登場22分鐘就狂轟28分，包括投進7記三分球，幫助塞爾蒂克以134：99痛宰公牛35分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35458262.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-27 13:56", "link": "/news/story/7002/9839729"}]}, {"name": "棒球", "articles": [{"article_id": "9840109", "title": "中職／自由球員年資公布！獅隊陳重羽、潘傑楷動向最受關注", "date": "2026-10-27 16:46", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/27/35459102.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=3