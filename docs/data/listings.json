", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381604.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/7001/9789374"}, {"article_id": "9789443", "title": "亞運射箭／秀金髮箭指奧運 張正韋射下首面男子複合弓銀牌", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381649.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/124981/9789443"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9789036", "title": "中職／該用什麼標準定義？今年誰最有資格獲選「東山再起獎」", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381244.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9789036"}, {"article_id": "9789253", "title": "ESPN挑戰「萊里神話」難以理解 大膽預測熱火預約東區決賽", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381461.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9789253"}, {"article_id": "9785936", "title": "道奇四王牌加持三連霸呼聲高 大谷翔平功力恢復幾成是關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/30/35376663.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9785936"}, {"article_id": "9784325", "title": "中職／悍將晉級機會只有3成 不如大膽尋求出奇制勝", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35374021.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9784325"}, {"article_id": "9783917", "title": "再度從美東火藥庫脫穎而出 光芒上演黑馬傳奇靠什麼？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373494.jpg&M=1&s=Y&x=0&y=0&sw=1225&sh=816&exp=3600&w=300", "link": "/news/story/122629/9783917"}, {"article_id": "9781613", "title": "中職／投打過度仰賴資深球員 台鋼win now不成得要顧養成了", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35370003.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9781613"}]}, {"name": "最新文章", "articles": [{"article_id": "9790326", "title": "MLB／點名李灝宇接班先發二壘 SI：老虎應該給機會", "summary": "老虎隊主戰二壘手托瑞斯（Gleyber Torres）休賽季將成自由球員，美國媒體「運動畫刊」（SI）指出，台灣好手李灝宇是合理的接班人選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382948.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-02 11:40", "link": "/news/story/6999/9790326"}, {"article_id": "9790243", "title": "NBA／終結續約僵局！杜倫接受5年2億美元報價 活塞確立未來三大核心", "summary": "底特律活塞與受限制自由球員杜倫（Jalen Duren）的續約僵局終於落幕。根據美媒報導，這名22歲明星中鋒已同意與活塞簽下5年2億美元（約新台幣64億元）合約，雙方在歷經數月拉鋸後，趕在「合格報價」期限前完成續約協議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382816.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-02 11:15", "link": "/news/story/7002/9790243"}, {"article_id": "9790236", "title": "MLB／7-11店員投贏2位百勝強投！勇士淘汰費城人 前進分區賽挑戰道奇", "summary": "道奇隊挑戰三連霸之路的第一個季後賽對手誕生，勇士隊今天靠3支全壘打以6：2擊退費城人隊，以2勝1敗挺進國聯分區系列賽，道奇、勇士將從4日展開較勁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382805.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-02 11:03", "link": "/news/story/6999/9790236"}, {"article_id": "9790195", "title": "中華民國「助跑車協會」成立 運動部前次長鄭世忠任首屆理事長布局帕運", "summary": "「助跑車（Frame Running）」是一項風靡國際的適應性創新運動，專為嚴重平衡與協調障礙者（如腦性麻痺、多發性硬化症患者）所設計。透過特製的三輪跑步車與胸墊支撐，平時依賴輪椅或助行器的身障者得以跨越身體限制，在跑道上體驗「用雙腳迎風奔跑」的自由與感動。隨著該項目已正式被納入2028年洛杉磯帕拉林匹克運動會（帕運）的競賽項目，全球發展勢頭正勁，台灣也正式迎頭趕上。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382749.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-02 10:55", "link": "/news/story/7005/9790195"}, {"article_id": "9790132", "title": "NBA／白曼巴說比楊恩還好 暴龍24歲控衛獲3年7.6億元合約", "summary": "暴龍隊今天宣布與24歲防守型控衛希德（Jamal Shead）達成協議，簽下3年2400萬美元（約7.66億新台幣）延長合約，附帶第3年球隊選項。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382580.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-02 10:35", "link": "/news/story/7002/9790132"}, {"article_id": "9790083", "title": "亞運柔道／陸媒社群疑降溫唐婧咬人爭議 網友不買單狂批「太丟臉」", "summary": "2026年愛知・名古屋亞運柔道賽場出現罕見爭議，中國女子柔道選手唐婧在女子70公斤級8強賽對上地主日本選手前田凜時，被裁判認定在地面纏鬥過程中咬傷對手手臂，最終遭判「反則負」直接落敗並取消資格。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382533.jpg&M=1&s=Y&x=9&y=0&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-10-02 10:20", "link": "/news/story/124981/9790083"}, {"article_id": "9789986", "title": "亞運柔道／日本女將遭中國唐婧「咬傷留齒痕」 日網炎上：太離譜了！", "summary": "名古屋亞運昨天（1日）進行柔道女子70公斤級決賽，日本21歲選手前田凜以一本擊敗哈薩克選手阿茲哈爾（Ashkhat Azhar）奪下金牌，不過她在8強賽卻遭中國大陸選手唐婧咬傷，左手腕留下清楚齒痕，引發日網炎上。唐婧賽後拒絕受訪。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382377.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-02 09:52", "link": "/news/story/124981/9789986"}, {"article_id": "9789955", "title": "MLB／道奇備戰上演「大谷vs.山本」 打教透露：已跨過傷勢調整階段", "summary": "道奇隊在國聯分區系列賽等待對手，前兩天閉門練球磨刀，今天開放媒體進場採訪，打擊教練巴茲（Aaron Bates）透露昨天有場夢幻對決：大谷翔平vs.山本由伸，大谷展現極佳的揮棒狀態，但不記得對決內容，而大谷也在室外打擊練習中好幾次將球打到計分板附近。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382341.jpg&M=1&s=Y&x=42&y=116&sw=1006&sh=671&exp=3600&sl=W&fw=360", "date": "2026-10-02 09:36", "link": "/news/story/6999/9789955"}, {"article_id": "9789036", "title": "中職／該用什麼標準定義？今年誰最有資格獲選「東山再起獎」", "summary": "中職2026年球季「東山再起獎」成為年度討論焦點，陳文杰等多名球員被提及，聯盟評選標準與是否頒獎引發討論。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381244.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-02 07:00", "link": "/news/story/122629/9789036"}, {"article_id": "9789253", "title": "ESPN挑戰「萊里神話」難以理解 大膽預測熱火預約東區決賽", "summary": "ESPN預測熱火東區第七、需打附加賽，作者認為低估字母哥加盟及熱火防守文化，預測可闖東決，並指控球後衛是主要盲點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381461.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-02 07:00", "link": "/news/story/122629/9789253"}, {"article_id": "9789443", "title": "亞運射箭／秀金髮箭指奧運 張正韋射下首面男子複合弓銀牌", "summary": "中華射箭代表隊廿二歲張正韋在男子複合弓個人賽摘下銀牌，射下隊史首面亞運複合弓個人賽獎牌，站上頒獎台露出的金髮，也宣告他要在洛杉磯奧運再次爭金的決心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381649.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-02 00:00", "link": "/news/story/124981/9789443"}, {"article_id": "9789459", "title": "亞運輕艇／輕艇激流 吳融政哭完才知奪銀", "summary": "名古屋亞運輕艇激流賽事，昨天我國好手吳融政在男子單人C艇傳回捷報，他在決賽雖遭罰時六秒，但仍以總成績一一九點○九秒完賽奪下銀牌，加上複合弓男子個人張正韋銀牌及網球男雙銅牌，我代表團單日進帳二銀一銅。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381661.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-02 00:00", "link": "/news/story/124981/9789459"}, {"article_id": "9789461", "title": "亞運網球／謝淑薇/梁恩碩、詹皓晴/吳芳嫺 雙闖女雙四強保兩銅", "summary": "名古屋亞運網球賽，我國女雙組合謝淑薇／梁恩碩昨天在八強賽經歷超級搶十連拿十分的強勢表現，以六比二、三比六、十比○擊敗地主日本組合小堀桃子／清水綾乃，順利挺進四強；另一組女雙詹皓晴／吳芳嫺也闖進四強，代表我國在女雙由雙銅起跳。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/02/35382466.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-02 00:00", "link": "/news/story/124981/9789461"}, {"article_id": "9789374", "title": "中職／不在意無法改寫防禦率紀錄 蔣銲：因為我喜歡棒球", "summary": "中華職業棒球大聯盟味全龍隊洋投蔣銲今天不登板就能改寫中職最低防禦率紀錄，但他選擇續戰統一7-ELEVEn獅隊而遭打下3分...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381604.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 22:50", "link": "/news/story/7001/9789374"}, {"article_id": "9789321", "title": "中職／艾菩樂領軍搶下重要勝利 猿1場勝差緊咬兄弟力拚季冠軍", "summary": "樂天桃猿隊今天作客高雄澄清湖球場，洋投艾菩樂先發7局失1分，優質表現領軍2：1搶下重要勝利，猿隊下半季排名仍居第2，落後中信兄弟隊的勝差拉近到1場，例行賽最後4戰全力爭取季後賽門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381513.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 21:48", "link": "/news/story/7001/9789321"}, {"article_id": "9789274", "title": "亞運／2日焦點林郁婷、陳念琴將拚拳擊雙金 射箭男團抗韓搶決賽門票", "summary": "2026名古屋亞運進入尾聲，拳擊女將林郁婷、陳念琴明天將先後在金牌戰亮相，力拚拳擊隊雙金入袋；男子射箭反曲弓團隊，則...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381508.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 21:39", "link": "/news/story/124981/9789274"}, {"article_id": "9789286", "title": "中職／蔣銲無緣超越「蕭任汶障礙」 獅隊季後賽門票快到手了", "summary": "味全龍、統一獅隊今天在天母棒球場進行保留比賽，龍隊洋投蔣銲投5局失3分，防禦率從賽前1.36升至1.49，確定無法改寫中職單季最低紀錄，台鋼雄鷹隊教練蕭任汶2001年在兄弟象隊創下的1.40，仍是後輩難以超越的障礙，獅隊終場4：3獲勝，晉級季後賽機會愈來愈大。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381495.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 21:20", "link": "/news/story/7001/9789286"}, {"article_id": "9789210", "title": "網球／錦織圭日本公開賽首輪遭淘汰 輝煌職業生涯落幕", "summary": "日本網球名將錦織圭今天在日本公開賽男單首輪以4比6、4比6不敵美國好手提亞佛（Frances Tiafoe），為其輝煌的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381446.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-01 20:40", "link": "/news/story/7005/9789210"}, {"article_id": "9789192", "title": "日職／徐若熙等了快4個月重返一軍 最快球速157公里後援1局無失分", "summary": "日職軟銀鷹隊今天作客仙台和樂天隊交手，賽前登錄台灣右投徐若熙，他也在8局下登板，面對4名打者被揮出1支二壘打，但未讓對手得分，順利完成後援1局任務，軟銀終場8：2獲勝，在例行賽倒數第4戰奪下本季第90勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381423.jpg&M=1&s=Y&x=0&y=0&sw=1053&sh=702&exp=3600&sl=W&fw=360", "date": "2026-10-01 20:11", "link": "/news/story/7001/9789192"}, {"article_id": "9789136", "title": "亞運網球／詹皓晴、吳芳嫺女雙挫中國晉4強保底銅牌 落淚喊話中華隊要團結", "summary": "名古屋亞運網球賽事今天展開熱戰，我國女雙組合詹皓晴／吳芳嫻在8強賽歷經高潮迭起的大戰，最終以7：6（7：2）、3：6、15：13驚險擊敗大會第一種子中國大陸組合張帥／郭涵煜，挺進4強並為中華隊鎖定至少一枚銅牌，賽後談到這場得來不易的勝利，詹皓晴更是一度落淚，動情呼籲「中華隊就是要團結」，才能在國際賽場打出更好成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381361.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 19:49", "link": "/news/story/124981/9789136"}, {"article_id": "9789120", "title": "亞運輕艇／23歲吳融政再戰亞運輕艇賽轉折奪銀 師生雀躍讚：佛大之光", "summary": "正在日本舉行的亞洲運動會傳來捷報！佛光大學管理學系碩士班一年級學生吳融政今天參加輕艇激流標竿男子單人C艇項目，勇奪銀牌，成功站上頒獎台。消息傳來，全校師生雀躍，不但為台灣代表團再添佳績，也為佛光大學帶回榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381335.jpg&M=1&s=Y&x=0&y=125&sw=819&sh=546&exp=3600&sl=W&fw=360", "date": "2026-10-01 19:31", "link": "/news/story/124981/9789120"}, {"article_id": "9789016", "title": "中職／郭天信低潮期龍隊9勝16敗 葉君璋不擔心：他能幫球隊", "summary": "中華職棒味全龍隊外野手郭天信8月下旬開始陷入打擊低潮，期間龍隊戰績僅9勝16敗，總教練葉君璋不擔心，因為守備依舊是郭天信...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381313.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 19:23", "link": "/news/story/7001/9789016"}, {"article_id": "9789098", "title": "亞運女壘／中華女壘2：4不敵衛冕軍日本 確定無緣爭金", "summary": "中華女壘今天在名古屋亞運迎接關鍵的「台日大戰」，前5局打完雙方還維持2：2平手，但在6局下被日本攻進2分，終場以2：4落敗，目前戰績4勝2敗排第三，確定無緣爭金，明天預賽最終戰對上南韓，力拚銅牌戰門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381293.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 19:11", "link": "/news/story/124981/9789098"}, {"article_id": "9789012", "title": "籃球／更多「新台灣人」！籃協推動兩外籍生入籍", "summary": "中華籃球協會副秘書長張承中今天表示，台灣籃球將效法日本模式建立完整人才庫，除了現有的「新台灣人」高柏鎧外，目前正全力推動多名外籍生包括丁恩迪與丹尼爾循「高級專業人才」路徑入籍，將正式進入「複數歸化」時代，讓中華隊未來賽事更有競爭力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381134.jpg&M=1&s=Y&x=0&y=346&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-01 18:22", "link": "/news/story/7003/9789012"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9789986", "title": "亞運柔道／日本女將遭中國唐婧「咬傷留齒痕」 日網炎上：太離譜了！", "date": "2026-10-0