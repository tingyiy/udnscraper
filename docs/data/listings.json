2", "title": "中職／史上首度龍象爭霸 年度第五兄弟能奪冠創歷史新紀錄？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35423690.jpg&M=1&s=Y&x=39&y=0&sw=1241&sh=827&exp=3600&w=300", "link": "/news/story/122629/9816842"}, {"article_id": "9817674", "title": "有扳倒西區列強能力！「范喬丹」回歸補齊漏洞 新火箭快速升空", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427797.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9817674"}]}, {"name": "最新文章", "articles": [{"article_id": "9827317", "title": "亞帕運／林姿妤連霸！桌球女單姐妹內戰 我連兩屆金包銀", "summary": "杭州亞帕運就在桌球女單Ｃ十級「金包銀」的我國好手林姿妤和田曉雯，昨天名古屋亞帕運金牌戰再度碰頭，最終林姿妤以直落三完成連霸，為中華代表團帶回本屆第二面金牌；田曉雯連兩屆登上頒獎台，加上十九歲新星陳柏諺、「四朝元老」程銘志和林駿梃也都獲銀牌，黎懿亞獲得銅牌，桌球隊單日就進帳一金四銀一銅成「獎牌庫」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439644.jpg&M=1&s=Y&x=0&y=0&sw=1249&sh=832&exp=3600&sl=W&fw=360", "date": "2026-10-21 00:00", "link": "/news/story/7005/9827317"}, {"article_id": "9827321", "title": "亞帕運／林姿妤、田曉雯攜手再戰桌球女雙 「平時是隊友也是對手」", "summary": "是對手也是最好搭檔，我國桌球帕拉女將林姿妤和田曉雯，連兩屆亞帕運都在女單Ｃ十級金牌戰會師，兩人賽後相擁，完成衛冕的林姿妤十分感謝身邊有田曉雯這樣的對手，良性競爭下激發出更多可能，接續兩人也將在女雙再攜手，目標再一起登上頒獎台。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439683.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-21 00:00", "link": "/news/story/7005/9827321"}, {"article_id": "9827322", "title": "MLB／從頻遭讓渡到敲出首安...談起大聯盟辛酸 鄭宗哲泛淚", "summary": "日前回台的旅美棒球好手鄭宗哲，昨天舉辦返台記者會，回顧過去一季歷經頻繁遭指定讓渡，到轉戰紅襪隊擊出生涯首支安打的心路歷程，忍不住情緒潰堤、激動落淚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439652.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-21 00:00", "link": "/news/story/6999/9827322"}, {"article_id": "9827212", "title": "中職／沒想過3勝0敗「聽牌」 葉總：兄弟是滿難纏的球隊", "summary": "味全龍隊在台灣大賽暢行無阻，今天再以6：0完封中信兄弟隊，已經取得3勝0敗絕對優勢，總教練葉君璋也坦言出乎意料，「沒有想過，真的是沒有想過，兄弟一整年下來是滿難纏的球隊，整場比賽給對手的壓力是滿大的，有辦法3比0，我覺得出乎我意料之外。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439573.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 22:39", "link": "/news/story/7001/9827212"}, {"article_id": "9827195", "title": "中職／G4旅美土投對決！黃暐傑vs.鄭浩均 同步解鎖台灣大賽初先發", "summary": "中華職棒總冠軍賽第四戰先發投手亮牌，上演今年首場土投交鋒，中信兄弟隊鄭浩均、味全龍隊黃暐傑都具備旅美資歷，如今都將迎接生涯首場台灣大賽先發。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439561.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 22:24", "link": "/news/story/7001/9827195"}, {"article_id": "9827193", "title": "中職／平野直言「龍隊也沒多少是靠打擊得分」 喊話啟動4連勝", "summary": "中信兄弟隊在台灣大賽3場打完只拿1分，已經處於0勝3敗絕境，對於檢討比賽細節，總教練平野惠一直言：「現在不是去討論這些的時候。」喊話從明天開始4連勝，「中信兄弟會打出怎樣的棒球，請大家繼續期待。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439547.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 22:23", "link": "/news/story/7001/9827193"}, {"article_id": "9827187", "title": "中職／李凱威自信秀神準選球+機智跑壘 不忘誇曾聖安小小年紀不簡單", "summary": "前六局以0：0僵持，中信兄弟隊一啟動牛棚，隨即成為戰線分水嶺，李凱威發揮最自信的選球功力，滿壘從2好0壞選到保送，為味全龍隊攻下第1分入袋，味全龍隊6：0贏球賽後，李凱威還原該打席，「可能自己也很專注在對決上，球看得特別清楚。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439511.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 22:13", "link": "/news/story/7001/9827187"}, {"article_id": "9827172", "title": "中職／關鍵內野安打有練閃身步 張政禹打出全隊有賞：每個人都在叫格", "summary": "味全龍隊在總冠軍賽第三戰擊潰中信兄弟隊，張政禹雙安貢獻4分打點，第七局先是閃出一支罕見的兩分打點內野安打，第九局的安打擴大為6：0領先，讓全隊都叫他「格」，他爆料：「主要是打5分，全隊都有獎金，不好意思，讓球隊花錢了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439499.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 22:01", "link": "/news/story/7001/9827172"}, {"article_id": "9827121", "title": "中職／兄弟3場只拿1分涼到破紀錄 龍隊3連勝「聽牌」隊史第6冠", "summary": "中信兄弟隊陷入絕對逆境，今天再以0：6不敵味全龍隊，已在台灣大賽站在0勝3敗懸崖邊，龍隊最快明天就將在台北大巨蛋拋下紅色彩帶。兄弟3戰打完合計只拿1分，打破前3戰最低得分紀錄，而系列賽最少得分紀錄來自2010年興農牛隊4分，兄弟岌岌可危。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439442.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 21:23", "link": "/news/story/7001/9827121"}, {"article_id": "9827092", "title": "中職／32869人進場！龍象爭霸首場兄弟主場 未破去年G3紀錄", "summary": "中華職棒總冠軍賽今年全程決戰台北大巨蛋，第三戰首度由中信兄弟隊作東，吸引3萬2869人進場，並未突破去年第三戰紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439397.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 21:07", "link": "/news/story/7001/9827092"}, {"article_id": "9827073", "title": "中職／超罕見！呂彥青季後賽投14場首度0.0局 4打席都沒解決", "summary": "情勢大不利的中信兄弟隊，今天在總冠軍賽第三戰又遭遇苦戰，罕見的是連最可靠的呂彥青登板都演出0.0局投球，面對4打席都沒解決，兄弟該局最終丟掉4分，陷入0：4落後。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439384.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 20:57", "link": "/news/story/7001/9827073"}, {"article_id": "9826937", "title": "中職／黃暐傑首度體驗台灣大賽 若先發登板會毫無保留地投", "summary": "中職味全龍隊投手黃暐傑首度體驗總冠軍賽（台灣大賽），感想是加油聲很大聲；他表示，有很多沒遇過的狀況，透過比賽累積、調整轉...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439261.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 19:40", "link": "/news/story/7001/9826937"}, {"article_id": "9826909", "title": "中職／金牌加持兄弟！王冠閎披黃衫開球 分享「今晚看棒球紓壓」", "summary": "中職總冠軍賽今天進行第三戰，由中信兄弟隊首度擔任主場球隊，此役賽前由名古屋亞運200公尺蝶式金牌、「台灣蝶王」王冠閎擔任開球嘉賓，談到面對挫折時的解方，他分享：「像今天看棒球就是非常舒緩壓力的活動。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439196.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 19:10", "link": "/news/story/7001/9826909"}, {"article_id": "9826737", "title": "中職／張士綸、張仁瑋台灣大賽16打數無安打續先發 平野透露考量", "summary": "中職總冠軍賽（台灣大賽）中信兄弟續讓張士綸、張仁瑋先發，兩人前2戰合計16打數沒有敲出安打，但總教練平野惠一希望藉此機會...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35435457.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 18:30", "link": "/news/story/7001/9826737"}, {"article_id": "9826814", "title": "中職／曾頌恩腿部慢性疼痛累積自評近況不錯 台灣大賽G3排入先發", "summary": "中職中信兄弟曾頌恩在台灣大賽前2戰因為腿部不適沒有先發，今天第3戰回到先發打序，曾頌恩表示，腿部的不適是慢性的疼痛累積，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439081.jpg&M=1&s=Y&x=0&y=70&sw=1174&sh=783&exp=3600&sl=W&fw=360", "date": "2026-10-20 18:23", "link": "/news/story/7001/9826814"}, {"article_id": "9826827", "title": "亞帕運桌球／再度不敵南韓金基泰 19歲陳柏諺男單C11銀牌作收", "summary": "亞帕運桌球男單C11級金牌戰今天晚間由我國好手陳柏諺與南韓對手金基泰爭奪金牌，也是雙方繼巴黎帕運金牌戰後再度爭金，前一次對戰吞敗的陳柏諺，最終以8：11、11：2、9：11、7：11敗下陣來，以銀牌作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439083.jpg&M=1&s=Y&x=0&y=0&sw=1247&sh=831&exp=3600&sl=W&fw=360", "date": "2026-10-20 18:21", "link": "/news/story/7005/9826827"}, {"article_id": "9826777", "title": "亞帕運桌球／金牌內戰林姿妤13分鐘速勝田曉雯 個人連兩屆摘金", "summary": "名古屋亞帕運女單C10級金牌戰，今天晚間上演台灣內戰，由林姿妤對決老搭檔田曉雯，最終林姿妤在3局賽事中以11：4、11：7、11：2直落三擊敗好友田曉雯，完成在亞帕運女單的二連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439001.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-20 18:01", "link": "/news/story/7005/9826777"}, {"article_id": "9826736", "title": "法國羽賽／亞運銅牌組合葉宏蔚詹又蓁 混雙首輪逆轉晉16強", "summary": "世界羽球聯盟（BWF）超級750等級的法國羽球公開賽，台灣混雙組合葉宏蔚、詹又蓁今天在首輪迎戰美國組合史密斯、蓋伊，首局...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35438961.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 18:00", "link": "/news/story/7005/9826736"}, {"article_id": "9826741", "title": "中職／聽見最大分貝《每次都想呼喊你的名字》 林子昱戰鬥力上升", "summary": "作為少數味全龍隊重生後兩次爭冠都參與的投手，林子昱深刻感受這支球隊一步步變得成熟，第二戰在近滿場球迷中聽著「每次都想呼喊你的名字～林子昱！」他也很有感觸，「自己的努力有被看見的感覺。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35438940.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 17:47", "link": "/news/story/7001/9826741"}, {"article_id": "9826711", "title": "中職／「江坤宇底標還是別人頂標」 張政禹奪獎等到張士綸說話了", "summary": "味全龍隊張政禹今年首度獲得最佳十人游擊手，斬斷中信兄弟隊江坤宇五連霸，談到這位可敬對手，張政禹直言，就算江坤宇沒有拿到這個獎，他還是頂尖選手，「他的底標，還是別人的頂標。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35438902.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 17:25", "link": "/news/story/7001/9826711"}, {"article_id": "9826701", "title": "TPBL／戰神主場開幕戰續颳「林來瘋」 入場送林庭謙首戰紀念卡", "summary": "台北台新戰神隊將於11月7日、8日迎接主場開幕週，球團攜手台新銀行推出《台新銀行 X 台北出聲》主題活動，結合音樂演出與籃球賽事，並準備林庭謙「主場首戰紀念卡」作為限量入場好禮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35438886.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-20 17:18", "link": "/news/story/7003/9826701"}, {"article_id": "9826653", "title": "MLB／「捕」能再忍了！洋基捕手連遭界外球爆頭 打擊低迷有苦衷", "summary": "洋基捕手威爾斯（Austin Wells）今年球季打擊率僅1成86，與過去水準有明顯落差。近日他接受《The Athletic》專訪時透露，由於球季初多次遭到界外球重擊頭部，儘管當時通過腦震盪檢測，仍長期受到頭痛、頭部壓迫感，因此影響打擊表現，直到進入傷兵名單休養後，狀況才逐漸改善。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35438783.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-20 17:09", "link": "/news/story/6999/9826653"}, {"article_id": "9826663", "title": "NBA／美媒預測雷霆、馬刺進季後賽機率99.9% 籃網、國王0%", "summary": "NBA新賽季將在明天點燃戰火，美國媒體ESPN撰文列出30隊戰力榜，雷霆和馬刺隊被看好99.9%進入季後賽；籃網和國王隊則是0%。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35438789.jpg&M=1&s=Y&x=0&y=0&sw=1269&sh=846&exp=3600&sl=W&fw=360", "date": "2026-10-20 17:04", "link": "/news/story/7002/9826663"}, {"article_id": "9826625", "title": "中職／奪最佳十人坦言下半季爛到看不下去 郭天信：起邪念了", "summary": "味全龍隊外野手郭天信雙喜臨門，夫妻倆即將迎接二寶，昨天公布的最佳十人也在外野手上榜，談起下半季暴跌的打擊數據直言「爛到自己看不下去」，至於原因為何？他苦笑說：「起邪念了嘛！」", "thumbnail": "