gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193168.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-02 19:42", "link": "/news/story/7003/9666284"}, {"article_id": "9666276", "title": "MLB／史庫柏忍淚告別老虎 轉戰道奇心情複雜：我很興奮但也很難受", "summary": "薩特健康球場特殊的地理位置，意外成為史庫柏（Tarik Skubal）與底特律老虎告別的第一個線索。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193164.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 19:41", "link": "/news/story/6999/9666276"}, {"article_id": "9666264", "title": "日職／林安可又有2安、1打點 對歐力士3連戰貢獻5安", "summary": "旅日好手林安可今天又有好表現，對歐力士隊之戰4打數2安打，攻下1分打點，幫助西武5：1獲勝，主場3連戰搶下兩勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193148.jpg&M=1&s=Y&x=44&y=0&sw=1115&sh=743&exp=3600&sl=W&fw=360", "date": "2026-08-02 19:14", "link": "/news/story/7001/9666264"}, {"article_id": "9666228", "title": "NBA／史上首位「五金行」老闆！37歲杜蘭特仍盼出征洛杉磯奧運", "summary": "休士頓火箭球星杜蘭特（Kevin Durant）並未關上再次披上美國男籃戰袍的大門，他近日表示，自己仍希望能入選2028年洛杉磯奧運美國隊名單，若最終成行並幫助美國隊再次登頂，他將成為奧運男籃史上首位拿下5面金牌的球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193108.jpg&M=1&s=Y&x=8&y=0&sw=1272&sh=848&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:54", "link": "/news/story/7002/9666228"}, {"article_id": "9666208", "title": "MLB／賺翻？道奇3農場新秀換塞揚史庫柏 韓媒：交易代價不算重", "summary": "洛杉磯道奇再度在交易市場投下震撼彈，根據大聯盟官網報導，道奇已從底特律老虎換來左投王牌史庫柏（Tarik Skubal），這名連續2年拿下美聯塞揚獎的強投，將加入道奇原本就星光熠熠的先發輪值，協助球隊挑戰世界大賽3連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193051.jpg&M=1&s=Y&x=0&y=3&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:23", "link": "/news/story/6999/9666208"}, {"article_id": "9666210", "title": "中職／羅戈先發7局無失分 兄弟終於中斷對戰龍隊9連敗", "summary": "中信兄弟隊今天在台北大巨蛋再戰味全龍隊，洋投羅戈先發7局無失分，打線火力全開，首局就以5支安打攻下4分奠定勝基，終場以7：0獲勝，中斷對戰龍隊9連勝，也終止大巨蛋4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193053.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:23", "link": "/news/story/7001/9666210"}, {"article_id": "9666205", "title": "中職／蔡其昌致賀周玲妏當選 期待棒協加強改革力道", "summary": "中華棒球協會第14屆理事長選舉結果出爐，中信育樂公司副總經理周玲妏成為棒協首位女領導人，中華職棒會長蔡其昌表示，恭喜周玲妏當選棒協理事長，也感謝前理事長辜仲諒多年來對台灣棒球發展的投入與奉獻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193046.jpg&M=1&s=Y&x=53&y=33&sw=1178&sh=785&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:13", "link": "/news/story/7001/9666205"}, {"article_id": "9666174", "title": "棒球／郭智輝落選棒協理事長 經濟部前部長吐露心聲", "summary": "中華棒球協會第14屆理事長選舉結果出爐，經濟部前部長、科技企業家郭智輝無緣獲選，今天發表聲明「坦然接受，也虛心檢討」，強調職務可以不同，初心始終不變。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192996.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:41", "link": "/news/story/7001/9666174"}, {"article_id": "9666165", "title": "棒球／辜仲諒獲聘棒協名譽理事長 未來目標爭取WBSC會長", "summary": "中華棒球協會新任理事長出爐，中信育樂公司副總經理周玲妏成為棒協首位女領導人，原任理事長辜仲諒完成8年任務，獲聘成為名譽理事長，未來目標將爭取世界棒壘球總會（WBSC）會長。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193017.jpg&M=1&s=Y&x=0&y=207&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:32", "link": "/news/story/7001/9666165"}, {"article_id": "9666160", "title": "MLB／貧窮才限制想像！道奇搶史庫柏組夢幻輪值 豪華稅猛飆1.8億美元", "summary": "洛杉磯道奇在交易截止日前再度展現「霸道總裁級」補強大法，重磅網羅底特律老虎王牌左投史庫柏（Tarik Skubal）後，原本已經星光熠熠的先發輪值再添一名連霸塞揚強投。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192982.jpg&M=1&s=Y&x=0&y=12&sw=1069&sh=713&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:31", "link": "/news/story/6999/9666160"}, {"article_id": "9666161", "title": "棒球／首位女性棒協理事長誕生 周玲妏綽號「周董」個性直率、坦言頭還在暈", "summary": "中華民國棒球協會今天改選，中信育樂公司副總經理周玲妏當選第14屆棒協理事長，今年58歲的她成為史上首位女性棒協理事長。人稱「周董」的周玲妏個性直率、豪爽，也是民進黨立委邱議瑩的好姐妹，過去擔任高雄市政府觀光局長時很會找資源，頗受高雄市長陳其邁重用。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192978.jpg&M=1&s=Y&x=0&y=0&sw=885&sh=590&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:27", "link": "/news/story/7001/9666161"}, {"article_id": "9666158", "title": "台北羽賽／165公分沖本優大首度參賽就奪冠 日本包3冠成最大贏家", "summary": "身高僅165公分的日本好手沖本優大，首度參加台北羽球公開賽就一路奪冠，且是昨天瓦解我國「一哥」周天成兩個賽末點逆轉勝，今天面對從會外賽晉級的韓國黑馬俞泰彬再以21：19、21：12奪勝，迎接生涯第二座BWF超級300冠軍，也是今天第三組登頂的日本選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192954.jpg&M=1&s=Y&x=0&y=112&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:22", "link": "/news/story/7005/9666158"}]}, {"name": "棒球", "articles": [{"article_id": "9666562", "title": "棒球／女性黑馬…周玲妏 當選棒協理事長", "date": "2026-08-03 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193464.jpg&M=1&s=Y&x=0&y=297&sw=1107&sh=738&exp=3600&w=300", "link": "/news/story/7001/9666562"}, {"article_id": "9666583", "title": "棒球／體壇政治…爭棒協、籃協 總統牌連番失靈", "date": "2026-08-03 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193503.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9666583"}, {"article_id": "9666586", "title": "棒球／棒協改選配票得宜 新任理事多中信體系", "date": "2026-08-03 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_2.jpg&w=300", "link": "/news/story/7001/9666586"}, {"article_id": "9666590", "title": "棒球／棒協交棒獲聘名譽理事長 辜仲諒爭取WBSC會長", "date": "2026-08-03 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193481.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/7001/9666590"}, {"article_id": "9666592", "title": "棒球／出掌棒協… 周玲妏找資源一流", "date": "2026-08-03 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193510.jpg&M=1&s=Y&x=149&y=269&sw=926&sh=642&exp=3600&w=300", "link": "/news/story/7001/9666592"}]}, {