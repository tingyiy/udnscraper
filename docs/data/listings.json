ticles": [{"article_id": "9650499", "title": "詹姆斯決定4.0「關鍵密碼」 選擇76人拚冠才是生涯首次抱團 ！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35169863.jpg&M=1&s=Y&x=0&y=0&sw=1096&sh=731&exp=3600&w=300", "link": "/news/story/122629/9650499"}, {"article_id": "9646736", "title": "把明星賽變成「趣味競賽」沒問題 那就把規則訂清楚吧！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164366.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9646736"}, {"article_id": "9647229", "title": "留在獨行俠只是浪費時間 36歲K湯落葉歸根勇士成最後盼望", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35165176.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9647229"}, {"article_id": "9646464", "title": "大家都愛哈蘭德、梅西才是GOAT！26個2026世界盃的有趣統計", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164200.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9646464"}, {"article_id": "9644006", "title": "亞洲職棒打回大聯盟！ 本季光芒馬丁尼茲、國民葛里芬是最佳代表", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35160326.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&w=300", "link": "/news/story/122629/9644006"}, {"article_id": "9644261", "title": "中職／高中軟式組應屆生職棒第一人 金門洪嘉恩想挑戰極限", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35160360.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9644261"}]}, {"name": "最新文章", "articles": [{"article_id": "9651454", "title": "NBA／雷霆2年1200萬美元搶側翼 金塊若跟進豪華稅爆增10億", "summary": "根據消息，雷霆已經向金塊受限制自由球員前鋒瓊斯（Spencer Jones）開出一份2年1200萬美元的報價合約，金塊將有時間在美東時間週日晚間11時59分前決定是否跟進報價，留住這名年輕側翼。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171129.jpg&M=1&s=Y&x=175&y=50&sw=1070&sh=713&exp=3600&sl=W&fw=360", "date": "2026-07-26 10:11", "link": "/news/story/7002/9651454"}, {"article_id": "9651455", "title": "MLB／李灝宇近況有多狂？近15天OPS衝1.119 放眼大聯盟排第6", "summary": "台灣好手李灝宇近期打擊手感有多燙？數據會說話，近15天整體攻擊指數（OPS）1.119，放眼全大聯盟排名第6、新人第2，目前連10場敲安，也是大聯盟仍延續中的第二長紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171140.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 10:09", "link": "/news/story/6999/9651455"}, {"article_id": "9651007", "title": "NBA／詹姆斯加盟76人影響解析 與安比德、馬克西、布朗如何共存？", "summary": "就在詹姆斯（LeBron James）決定加盟後，費城76人一躍而成熱門奪冠勁旅，而從陣容配置來看，詹姆斯與新東家的適配性相當理想。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170539.jpg&M=1&s=Y&x=0&y=16&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-26 09:00", "link": "/news/story/7002/9651007"}, {"article_id": "9651346", "title": "MLB／李灝宇已是關鍵時可倚賴的人 運動畫刊：可能成老虎下一位明星球員", "summary": "老虎隊「台灣怪力男」李灝宇在大聯盟愈打愈自在，近期打擊手感也熱得發燙，今天對上皇家隊之戰，單場2支長打本季第6轟，敲回全隊所有得分，終場老虎隊雖以2：3落敗，但李灝宇鋒芒擋不住。美國媒體《運動畫刊》也專文撰寫李灝宇的表現，並看好他有機會成為老虎隊下一位明星球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35170975.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 08:58", "link": "/news/story/6999/9651346"}, {"article_id": "9651332", "title": "MLB／大谷翔平牛棚練投取消 道奇教頭認進度倒退但不擔心", "summary": "道奇隊二刀流球星大谷翔平原訂今天進牛棚練投，計畫臨時喊卡，總教練羅伯茲（Dave Roberts）證實是在前一次牛棚後感覺到左膝仍有不適，狀況有些倒退，但他強調並不擔心，大谷的左膝狀況仍比起明星賽前要好。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35170956.jpg&M=1&s=Y&x=0&y=12&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 08:39", "link": "/news/story/6999/9651332"}, {"article_id": "9651330", "title": "世足賽／美職足球大聯盟全明星賽 梅西休養中確定缺席", "summary": "美國職業足球大聯盟（MLS）29日明星賽，不過阿根廷名將梅西（Lionel Messi）世界盃結束後正在休養，他與同為阿...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171059.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 08:33", "link": "/news/story/123107/9651330"}, {"article_id": "9651329", "title": "MLB／李灝宇2安都打壞球教頭看到從容 隊友大讚：有夠會打！", "summary": "台灣強打李灝宇持續用火燙表現驚艷大聯盟，今天貢獻雙安，包括1支全壘打、1支二壘打，在老虎2：3不敵皇家隊之戰包辦全隊所有分數，老虎捕手羅傑斯（Jake Rogers）大讚：「他真的很會打！」總教練辛區（A.J. Hinch）坦言他兩球都攻擊壞球，但看到李灝宇展現出來的從容與好勝，令人相當驚艷。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35170955.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-26 08:30", "link": "/news/story/6999/9651329"}, {"article_id": "9651230", "title": "MLB／「台灣怪力男」再炸第6轟 李灝宇先敲追平安再揮超前陽春彈", "summary": "效力於老虎隊的「台灣怪力男」近期超燙手感持續延燒，今天在主場對上皇家隊，擔任先發第6棒、三壘手，2局下先敲二壘打追平比數，4局下再轟出超前陽春砲，本季第6轟出爐！近4戰敲2轟、跨場連3打席敲長打，幫老虎隊取得2：1領先。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35170819.jpg&M=1&s=Y&x=47&y=31&sw=1233&sh=822&exp=3600&sl=W&fw=360", "date": "2026-07-26 02:47", "link": "/news/story/6999/9651230"}, {"article_id": "9651206", "title": "運動人生／吃盡排頭 只為給孩子公平比賽", "summary": "考棒球裁判一點都不難，但要真的當上裁判，尤其是女性，在台灣棒球界只能以『嚴峻』兩字形容。」劉柏君說，當裁判是為了給小朋友一場公平的比賽，但她的裁判路卻走得不輕鬆。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35170762.jpg&M=1&s=Y&x=0&y=0&sw=1269&sh=847&exp=3600&sl=W&fw=360", "date": "2026-07-26 00:33", "link": "/news/story/7001/9651206"}, {"article_id": "9651204", "title": "運動人生／資深球評：女裁判的判決毫不遜色", "summary": "美國職棒小聯盟長年都有女性裁判執法，去年八月十日更出現史上首位大聯盟女裁判帕沃（Jen Pawol），台灣職棒發展卅七年，尚未有女裁判登場執裁。資深球評王雲慶表示，台北大巨蛋是全台唯一擁有男、女裁判休息空間的球場，可以成為最佳範例。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-07-26 00:32", "link": "/news/story/7001/9651204"}, {"article_id": "9651203", "title": "運動人生／劉柏君 衝撞棒壇性別之壁", "summary": "走過挫折 美國女子職棒執判\n棒球比賽需要裁判，但如果是女性裁判，質疑聲浪就鋪天蓋地；考一張裁判證不難，但要踏進球場執判，好比「蜀道之難」。\n國內首位棒球協會認證的女性裁判劉柏君，清楚無形的高牆，從「通靈少女」到「熟齡裁判」，劉柏君用受邀擔任將登場的美國女子職業棒球聯盟第一個賽季選秀賽裁判來證明實力，「我在台灣的棒球裁判路挫折重重，卻在美國重拾信心」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35170759.jpg&M=2&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 00:32", "link": "/news/story/7001/9651203"}, {"article_id": "9651062", "title": "籃球／尹湘雲致勝跳投 新竹3對3公開女子組封后", "summary": "「風城耀動、城市3耀」新竹城市盃3對3籃球賽，今天在市府前封路舉行首日決賽，其中公開女子組竑凱運動x北市大，靠著尹湘雲致勝跳投，以21：20驚險擊敗All Rounded x Best封后，帶走3萬元冠軍獎金。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170606.jpg&M=1&s=Y&x=0&y=120&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-25 22:45", "link": "/news/story/7003/9651062"}, {"article_id": "9650999", "title": "世足賽／世界盃奪冠效應 西班牙國家隊圈粉當地台灣人", "summary": "西班牙在世界盃足球賽封王，睽違16年重返國際足壇巔峰，國家隊凝聚國人情感，在世界各地圈粉，包括住在西班牙的台灣人也受當地...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170591.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 22:35", "link": "/news/story/123107/9650999"}, {"article_id": "9650995", "title": "中國羽賽／周天成內戰退林俊易 本季首闖決賽對決法好手", "summary": "我國羽球「一哥」周天成和「左手重砲」林俊易名古屋亞運一同出征前，中國公開賽先隔網對決，兩人今天四強賽上演「寶島內戰」，世界排名第6的小天技高一籌，以21：18、21：17勝出，闖進本季第一場決賽，明天將對決法國世界排名16的大波波夫（Toma Junior Popov），尋求生涯第一座中國公開賽冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170521.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 21:47", "link": "/news/story/7005/9650995"}, {"article_id": "9650978", "title": "桌球／T聯賽開幕戰助隊取勝獲MVP 林昀儒為自己表現打101分", "summary": "日本最高層級職業桌球聯賽「Nojima T.LEAGUE」，今天在新竹縣體育館首度舉行海外開幕戰，其中晚間登場的男子組賽事，由林昀儒所屬的木下Meister東京出戰T.T埼玉，在林昀儒於第3點男單成功守成下，最終東京就以4：0直落三擊敗埼玉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170509.jpg&M=1&s=Y&x=0&y=0&sw=1218&sh=812&exp=3600&sl=W&fw=360", "date": "2026-07-25 21:21", "link": "/news/story/7005/9650978"}, {"article_id": "9650963", "title": "中職／猛打賞背後有Rain的加持 陳晨威：打擊手套要脫下來簽名還我", "summary": "樂天桃猿隊今天在台北大巨蛋以3：2擊敗富邦悍將隊，除了曾家輝先發7局失2分的好投，陳晨威也繳出單場3安猛打賞表現，包括在7局下敲回勝利打點，賽後他也透露賽前和韓國天王Rain的互動，並笑稱「Rain滿會打擊的！今天打3支！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170465.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 21:06", "link": "/news/story/7001/9650963"}, {"article_id": "9650937", "title": "中職／大巨蛋初登板3萬人場面飆好投 曾家輝：太多人太緊張了！", "summary": "生涯首度在大巨蛋登板，樂天桃猿隊23歲本土王牌曾家輝繳出先發7局失2分的出色表現，飆出9次三振，局數寫生涯單場新高，率領球隊以3：2擊敗富邦悍將隊。面對破3萬人的大場面，曾家輝賽後直呼：「真的太緊張了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170432.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 20:35", "link": "/news/story/7001/9650937"}, {"article_id": "9650910", "title": "中職／林凱威本季第6次BS 龍隊延長10局關鍵本壘攻防還是贏雄鷹", "summary": "在救援失敗榜上領跑的味全龍隊守護神林凱威，今天再追加本季第6次BS，九局下遭台鋼雄鷹隊洋砲魔鷹敲出追平兩分砲，龍隊10局上因對手失誤多添保險分，10局下在本壘攻防戰擋下腰部不適的吳念庭，終場仍以5：4險勝雄鷹。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170384.jpg&M=1&s=Y&x=0&y=0&sw=1210&sh=807&exp=3600&sl=W&fw=360", "date": "2026-07-25 20:07", "link": "/news/story/7001/9650910"}, {"article_id": "9650902", "title": "中職／布雷克1場勝投等77天 打線贊助4分有「兄弟」相挺", "summary": "統一獅隊洋投布雷克的悲情，終於撥雲見日，今天面對中信兄弟隊繳出6局無失分，隊友在他退場前打下4：0領先，終場以4：3贏球，布雷克拿下本季第3勝，而他前一勝已是5月9日，相隔77天再奪勝投。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170376.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 19:54", "link": "/news/story/7001/9650902"}, {"article_id": "9650901", "title": "古蹟變身鋼鐵擂台 全球極限體能鋼鐵大賽前進府城天后宮", "summary": "由台中市政府辦理的國際體能界年度盛事「2026全球極限體能鋼鐵大賽」宣傳熱度持續升溫，「北中南移地訓練」首站今天移師台南，在國定古蹟祀典大天后宮前廣場熱血開練。來自各地的運動愛好者迎著晨曦挑戰體能，讓擁有三百多年歷史的府城信仰中心化身戶外鋼鐵擂台；現場邀請人氣健身創作者及專業教練共同帶練，活動開放報名即秒殺額滿，不僅展現全民健身熱潮，也為10月將於台中登場的正式賽事提前暖身，再次掀起極限體能運動話題。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170375.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 19:53", "link": "/news/story/7005/9650901"}, {"article_id": "9650900", "title": "中職／曾家輝7局飆9K投出代表作 桃猿3：2擊退悍將止敗", "summary": "樂天桃猿隊在台北大巨蛋舉辦「辣年糕」主題日第2天，賽前有韓國天王Rain現身開球，在巨星的觀賽下，猿隊靠著曾家輝先發7局失2分、飆出9K，在大巨蛋投出生涯代表作，打線則有陳晨威單場3安敲回致勝分，終場猿隊以3：2擊敗富邦悍將隊，終止3連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170371.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 19:49", "link": "/news/story/7001/9650900"}, {"article_id": "9650888", "title": "桌球／日本T聯賽首次海外開幕戰竹縣登場 楊文科、鄭怡靜開球揭幕", "summary": "日本最高層級職業桌球聯賽Nojima T.LEAGUE 2026-2027賽季今天開幕，聯盟史上首場海外開幕戰首度移師新竹縣立體育館。新竹縣長楊文科與桌球名將鄭怡靜共同開球，象徵賽事正式揭幕，也展現新竹縣承辦國際大型體育賽事及推動國際體育交流的成果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170348.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 19:43", "link": "/news/story/7005/9650888"}, {"article_id": "9650856", "title": "全球極限體能鋼鐵大賽前進府城天后宮 台南首站秒殺額滿", "summary": "「2026全球極限體能鋼鐵大賽」移師台南，首站活動於祀典大天后宮前廣場熱血開練，報名即秒殺額滿，吸引各地運動愛好者參與。運動局長游志祥強調將極限體能運動與古蹟文化結合，讓運動走進城市文化地景。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170330.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 19:24", "link": "/news/story/7005/9650856"}, {"article_id": "9650848", "title": "中職／宋晟睿意外「助攻」對手三分砲 嘴巴爆血仍咬紗布奮戰", "summary": "洲際棒球場今天出現「助攻全壘打」，中信兄弟隊中外野手宋晟睿在手套碰到球後未能接牢，小白球彈出全壘打牆外，讓統一獅隊李丞齡「賺」到一支三分砲，而宋晟睿在強烈撞擊後浴血奮戰，嘴裡咬著止血紗布繼續守備。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170319.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-25 19:09", "link": "/news/story/7001/9650848"}]}, {"name": "棒球", "articles": [{"article_id": "9650900", "title": "中職／曾家輝7局飆9K投出代表作 桃猿3：2擊退悍將止敗", "date": "2026-07-25 19:49", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/25/35170371.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/