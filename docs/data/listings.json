y=&sw=&sh=&exp=3600&w=300", "link": "/news/story/122629/9800783"}, {"article_id": "9800955", "title": "日職／打擊榜洗版+鐵牛棚守成 軟銀戰力碾壓收下季後賽新優惠", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35399547.jpg&M=1&s=Y&x=102&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9800955"}, {"article_id": "9798956", "title": "中職／年度第五對第二還保送一勝 半季冠軍制有bug該修正", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35396453.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9798956"}, {"article_id": "9798142", "title": "連兩年強拉尾盤翻轉戰局 低調強權守護者再成美中之霸", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395218.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9798142"}]}, {"name": "最新文章", "articles": [{"article_id": "9806741", "title": "TPBL／攻城獅「後高國豪時代」首戰 劉丞勳飆21分謝隊友也謝自己", "summary": "新竹御嵿攻城獅在今年休賽季揮別球隊元老也是前一哥高國豪，正式邁入新時代，而今天在熱身賽首場比賽中，球隊新門面劉丞勳也表現不俗，全場出手11次命中6球，加上罰球7罰7中，攻下全隊最高的21分，儘管最終攻城獅仍是不敵高雄全家海神，但劉丞勳也將好表現歸功於隊友、教練為他創造機會，以及自己的努力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408486.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 19:10", "link": "/news/story/7003/9806741"}, {"article_id": "9806726", "title": "TPBL／昨6失誤、今「＋26」 賀丹完美反彈率海神奪熱身賽首勝", "summary": "在熱身賽首戰遭到新北中信特攻逆轉的高雄全家海神，今天在TPBL熱身賽第二戰重整旗鼓，尤其是狀元賀丹一掃前役6次失誤陰霾，全場貢獻17分、5籃板、3助攻，正負值「＋26」全場最佳，帶領球隊火力全開，終場以134：110擊敗新竹御嵿攻城獅，收下熱身賽首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408456.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-10 18:48", "link": "/news/story/7003/9806726"}, {"article_id": "9806685", "title": "北極羽賽／劉廣珩、許尹鏸擋不住對手強攻 止步混雙4強", "summary": "在芬蘭舉行的BWF超級500北極羽球公開賽，台灣混雙搭檔劉廣珩、許尹鏸今天在4強不敵中國組合高家炫、吳夢瑩的強勢進攻，以...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408446.jpg&M=1&s=Y&x=86&y=20&sw=826&sh=552&exp=3600&sl=W&fw=360", "date": "2026-10-10 18:29", "link": "/news/story/7005/9806685"}, {"article_id": "9806714", "title": "中職／平野惠一不滿挑戰失敗烙兄弟離場 內野另開視窗聊起來", "summary": "中華職棒季後挑戰賽首度前進亞太棒球場，統一獅隊尋求續命，此役第一局就出現爭議場景，中信兄弟隊教頭平野惠一因不滿判決上場，數度揮手示意兄弟退場、似意圖罷賽，大動作引起熱議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408436.jpg&M=1&s=Y&x=0&y=0&sw=1090&sh=726&exp=3600&sl=W&fw=360", "date": "2026-10-10 18:21", "link": "/news/story/7001/9806714"}, {"article_id": "9806707", "title": "NBA／安比德否認詹姆斯批他練球遲到 傳聞引發風波後名嘴已道歉", "summary": "費城76人當家中鋒安比德（Joel Embiid）否認外界傳出詹姆斯（LeBron James）曾批評他練球遲到的說法。安比德是在昨日完成本季熱身賽首秀後，針對這起傳聞做出回應。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408426.jpg&M=1&s=Y&x=0&y=21&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 18:12", "link": "/news/story/7002/9806707"}, {"article_id": "9806629", "title": "日職／度會隆輝9局致勝轟棒打巨人終結者 橫濱高潮系列賽首輪率先聽牌", "summary": "日本職棒高潮系列賽首輪，中央聯盟由橫濱隊客場面對巨人隊，今天第一場賽事，橫濱隊靠著度會隆輝在9局上砲轟巨人終結者，敲出超前陽春彈，幫助球隊以2：1打下勝利，在3戰2勝的賽事中率先聽牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408347.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 17:04", "link": "/news/story/7001/9806629"}, {"article_id": "9806588", "title": "日職／孫易磊高潮系列賽初登板投1局飆2K 西武洋砲10局再見轟搶首勝", "summary": "日本職棒季後賽高潮系列賽首輪，太平洋聯盟西武隊對上火腿隊首戰，火腿台灣投手孫易磊在第7局雙方2：2平手時上場，生涯日職季後賽初登板投出3上3下、飆2次三振，守住局面。西武則在延長賽10局下靠著洋砲卡納里歐（Alexander Canario）的再見轟，以3：2搶下勝利，在3戰2勝制系列賽拔得頭籌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408280.jpg&M=1&s=Y&x=0&y=175&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 16:18", "link": "/news/story/7001/9806588"}, {"article_id": "9806549", "title": "中職／獅隊絕境出招！史上首見季後賽43歲四棒 陳鏞基還要扛一壘", "summary": "中信兄弟隊帶著2勝0敗優勢，尋求在今晚鎖定台灣大賽門票，陷入絕境的統一獅隊，先發打線啟用43歲老將陳鏞基擔任四棒，也突破前年由他自己締造的紀錄，將季後挑戰賽最高齡先發四棒紀錄再改寫為43歲89天，就算加上總冠軍賽，也是季後賽史上首見43歲四棒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408224.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-10 15:36", "link": "/news/story/7001/9806549"}, {"article_id": "9806523", "title": "NBA／澳門球迷狂喊MVP！杜蘭特有感而發：在美國有時被視為理所當然", "summary": "NBA季前熱身賽移師澳門舉行，火箭隊球星杜蘭特（Kevin Durant）受到當地球迷熱烈歡迎，場邊不斷響起「MVP」歡呼聲，讓見慣大場面的他也印象深刻。杜蘭特賽後坦言，在美國打球多年，有時球迷難免將球星的表現視為理所當然，反而來到海外，更能感受到球迷對籃球的純粹熱愛。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408185.jpg&M=1&s=Y&x=125&y=164&sw=1097&sh=732&exp=3600&sl=W&fw=360", "date": "2026-10-10 15:31", "link": "/news/story/7002/9806523"}, {"article_id": "9806510", "title": "田徑／亞運銅牌林仲威首度參加國慶大會遊行 笑稱沒想到自己一台車", "summary": "民國115年國慶大會今天在總統府前廣場舉行，今年名古屋亞運的中華隊共計41人參加遊行；首度獲得的亞運田徑銅牌得主林仲...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408199.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 15:28", "link": "/news/story/7005/9806510"}, {"article_id": "9806524", "title": "TPBL／高錦瑋增重6公斤自認感覺不錯 談雲豹洋將異動溝通、合作沒問題", "summary": "上季在季後賽鎩羽而歸的桃園台啤永豐雲豹隊，今年在洋將陣容上進行大變動，包括3度拿下職籃得分王的克羅馬轉戰PLG台北富邦勇士隊，而在新賽季的首場熱身賽中，儘管雲豹新洋將莫騰猛轟30分，但場上進攻流暢度卻不若以往，最終也以14分差距不敵新北國王隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408184.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 15:16", "link": "/news/story/7003/9806524"}, {"article_id": "9806508", "title": "TPBL／回鍋職籃首秀上場9分鐘拿8分 國王周儀翔：很認真融入", "summary": "TPBL季前熱身賽今天繼續在台北和平籃球館舉行，首場比賽就由新北國王隊出戰桃園台啤永豐雲豹隊，兩隊在陣容都不完整的情況下交手，雖然上半場還一度拉鋸，但少了克羅馬等老班底的雲豹仍是在下半場遭拉開差距，最終國王就以107：93取勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408169.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 14:59", "link": "/news/story/7003/9806508"}, {"article_id": "9806506", "title": "桌球／直落四拍退瑞典六角戰士 林昀儒晉級WTT大滿貫中國站4強", "summary": "在昨天晚間於混雙決賽戰遭到逆轉以亞軍作收後，我國桌球一哥林昀儒今天繼續在WTT大滿貫中國大陸站男單8強賽登場，出戰世界排名第5名的瑞典好手摩賈德（Truls Moregard），最終林昀儒以11：7、11：9、11：9、11：7直落四勝出，不僅收下對戰3連勝，還挺進到4強賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408190.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-10 14:57", "link": "/news/story/7005/9806506"}, {"article_id": "9806501", "title": "網球／約克維奇上海一輪遊坦言「沒關係」 波蘭好手創罕見紀錄", "summary": "塞爾維亞39歲名將約克維奇（Novak Djokovic）剛在北京奪冠，今天在上海名人賽輸給世界排名第34的波蘭好手胡爾卡奇（Hubert Hurkacz），意外一輪遊。約克維奇賽後稱讚對手，直呼籤表非常艱難。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408165.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 14:50", "link": "/news/story/7005/9806501"}, {"article_id": "9806456", "title": "NBA／直言剛退休的衛少還能再打5、6年 杜蘭特：有點意外", "summary": "前NBA年度MVP魏斯布魯克（Russell Westbrook）今年8月無預警宣布退休，結束長達18年的職業生涯，也讓昔日雷霆隊戰友杜蘭特（Kevin Durant）感到不捨。杜蘭特在火箭隊中國熱身賽期間受訪時坦言，原本認為魏斯布魯克至少還能再打5、6年，但也尊重好友的決定，祝福他在人生下一個階段繼續發光發熱。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408100.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 14:28", "link": "/news/story/7002/9806456"}, {"article_id": "9806371", "title": "NBA／勇士補強不力拖累生涯？柯瑞回應質疑：「我又不是笨蛋」", "summary": "勇士隊自2022年奪下總冠軍後，近年戰績持續下滑，隨著當家球星柯瑞（Stephen Curry）逐漸步入生涯尾聲，外界也開始質疑球團未能替他打造足夠競爭力的陣容，浪費了這名傳奇射手最後的爭冠機會。對此，柯瑞近日接受專訪時直言：「我又不是笨蛋。」強調自己很清楚球隊目前的處境，但外界的批評並不會動搖他繼續爭冠的決心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407931.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-10 14:28", "link": "/news/story/7002/9806371"}, {"article_id": "9806431", "title": "WSBL／劉希曄國慶日迎35歲生日 笑稱兒時有優越感", "summary": "女子超級籃球聯賽（WSBL）中華電信隊球員劉希曄今天度過「國慶寶寶」35歲生日，劉希曄打趣表示，小時候有點優越感，覺得特...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408071.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-10 14:15", "link": "/news/story/7003/9806431"}, {"article_id": "9806418", "title": "NBA／勇士柯瑞60歲母親再婚！1年前認識男方、2個月籌備好婚禮", "summary": "勇士隊柯瑞（Stephen Curry）的母親索妮雅（Sonya）過去經常在場邊支持兒子，5年前與老柯瑞（Dell Curry）離婚後就比較少出現在鏡頭前，如今索妮雅公開宣布自己再婚的消息，柯瑞與弟弟小柯瑞（Seth Curry）也有出席婚禮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407992.jpg&M=1&s=Y&x=0&y=229&sw=912&sh=608&exp=3600&sl=W&fw=360", "date": "2026-10-10 13:40", "link": "/news/story/7002/9806418"}, {"article_id": "9806406", "title": "MLB／米蕭洛斯基學會面對失敗更自在 給小球員建議：穩定比飆速更重要", "summary": "釀酒人隊將在國聯冠軍賽對決道奇隊，陣中24歲王牌「火球男」米蕭洛斯基（Jacob Misiorowski）有望在首戰先發上陣，身為本屆國聯塞揚獎大熱門，與連兩屆美聯塞揚獎得主史庫柏（Tarik Skubal）的對決將十分具看頭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407998.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 13:27", "link": "/news/story/6999/9806406"}, {"article_id": "9806279", "title": "滑板／亞運鍍銀增信心 14歲女孩林逸凡闖進世錦賽決賽", "summary": "獲名古屋亞運滑板銀牌的台灣14歲小將林逸凡，今天在巴拉圭首都雅松森舉行的滑板世錦賽暨洛杉磯奧運積分賽再展實力，在公園式以...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407811.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 12:43", "link": "/news/story/7005/9806279"}, {"article_id": "9806253", "title": "NBA／對決塞爾蒂克如遇前女友 76人布朗感嘆：我們曾在一起", "summary": "七六人隊明星前鋒布朗（Jaylen Brown）今年夏天被交易至費城，結束效力塞爾提克隊長達10年的生涯，如今即將在熱身賽首度對決老東家，他也用相當有趣的方式形容心情，直言就像在路上碰到前女友，忍不住感嘆雙方曾經擁有的美好時光。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407703.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 12:41", "link": "/news/story/7002/9806253"}, {"article_id": "9806287", "title": "中職／獅隊0勝2敗絕境拚翻身 林岳平季後賽帶兵19敗差一步平紀錄", "summary": "統一獅隊在季後挑戰賽出師不利，昨天不敵中信兄弟隊，已於系列賽處於0勝2敗絕境，而總教練林岳平在季後挑戰賽、總冠軍賽已累積19敗，即將追平季後賽史上最多敗教頭紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407771.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-10 12:27", "link": "/news/story/7001/9806287"}, {"article_id": "9806267", "title": "日職／高潮系列賽首輪今開打 林安可尚未歸隊、孫易磊迎季後賽初體驗", "summary": "日本職棒季後賽高潮系列賽首輪賽事今天展開，太平洋聯盟由西武隊與火腿隊進行3戰2勝制交手，然而西武今天沒有做出球員登錄異動，林安可尚未歸隊，目前僅火腿投手孫易磊一名台灣球員參與其中。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407801.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 12:13", "link": "/news/story/7001/9806267"}, {"article_id": "9806220", "title": "日職／昔與大谷齊名！藤浪晉太郎遭戰力外 歐力士有意網羅拚東山再起", "summary": "過去與道奇隊球星大谷翔平齊名的日本強投藤浪晉太郎，旅美返日後仍未找回昔日身手，今年遭橫濱DeNA隊列為戰力外，不過他的職棒生涯有望迎來新轉機。根據日媒《體育報知》報導，歐力士隊正積極評估網羅這名32歲右投，若順利加盟，還有機會與高中搭檔森友哉重組昔日稱霸甲子園的冠軍投捕組合。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407631.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 12:07", "link": "/news/story/7001/9806220"}]}, {"name": "棒球", "articles": [{"article_id": "9806549", "title": "中職／獅隊絕境出招！史上首見季後賽43歲四棒 陳鏞基還要扛一壘", "date": "2026-10-10 15:36", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408224.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/7001/9806549"}, {"article_id": "9806588", "title": "日職／孫易磊高潮系列賽初登板投1局飆2K 西武洋砲10局再見轟搶首勝", "date": "2026-10-10 16:18", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35408280.jpg&M=1&s=Y&x=0&y=175&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9806588"}, {"article_id": "9806287", "title": "中職／獅隊0勝2敗絕境拚翻身 林岳平季後賽帶兵19敗差一步平紀錄", "date": "2026-10-10 12:27", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407771.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/7001/9806287"}, {"article_id": "9806714", "title": "中職／平野惠一不滿挑戰失敗烙兄弟離場 內野另