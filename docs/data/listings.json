634"}, {"article_id": "9803789", "title": "找來麻煩製造者莫蘭特 拓荒者「走在極端」卻能不斷創造奇蹟", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/08/35403992.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9803789"}, {"article_id": "9800783", "title": "中職／雖先處於一敗劣勢 統一投打俱佳仍有望闖進台灣大賽", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35399293.jpg&M=1&x=&y=&sw=&sh=&exp=3600&w=300", "link": "/news/story/122629/9800783"}]}, {"name": "最新文章", "articles": [{"article_id": "9810439", "title": "MLB／參與韋蘭德引退賽 李灝宇「簽到守備卡」至今喜孜孜", "summary": "旅美球星李灝宇用球棒在大聯盟卡位一席之地，談到來年課題，他並不避諱談自己的罩門，「守備真的是爛得可以」，季外將針對滾地球加強，希望讓自己的大聯盟之路可以走得更順。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413909.jpg&M=1&s=Y&x=0&y=65&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 00:00", "link": "/news/story/6999/9810439"}, {"article_id": "9810432", "title": "MLB／連續安打卻蹲板凳 李灝宇回憶「到球場都笑不出來」", "summary": "低點出發的二○二六年，「台灣怪力男」李灝宇用堅韌的心理素質當畫筆，揮灑出精彩賽季，昨天在返台記者會上述說經典賽受傷的挫折、初升大聯盟的害怕犯錯，以及八月蹲板凳的心理不平衡，如同他左側脖子上的英文「persistence（堅持）」刺青。李灝宇說，「既然我只有一點機會，就把這些很少的機會把握住。」一個轉念，成就單季一一四場出賽、八十七安、十轟賽季。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413860.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 00:00", "link": "/news/story/6999/9810432"}, {"article_id": "9810333", "title": "NBA／喬丹1998年冠軍賽球衣逾4億賣出 創籃球紀念品最高價", "summary": "拍賣公司今天宣布，NBA傳奇球星喬丹1998年總冠軍賽穿過並親筆簽名的一件客場紅色球衣，透過私人交易以1400萬美元（約...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35380277.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-12 22:58", "link": "/news/story/7002/9810333"}, {"article_id": "9810349", "title": "中職／鄭浩均展現比對手更想贏的企圖 先發勝助兄弟闖台灣大賽", "summary": "中職季後挑戰賽今天決勝第4戰，中信兄弟投手鄭浩均展現「比對手更想贏的企圖心」，先發好投率隊以8比2擊敗統一7-ELEVE...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413826.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 22:56", "link": "/news/story/7001/9810349"}, {"article_id": "9810321", "title": "中職／不分黃橘都喊「陳鏞基」 生涯最後打席敲安淚別賽場", "summary": "隨著統一獅隊2勝3敗止步季後挑戰賽，「台灣轟炸基」陳鏞基的選手生涯正式落幕，最終打席從中信兄弟隊李振昌手中敲出安打，賽後淚水奪眶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413816.jpg&M=1&s=Y&x=0&y=381&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-12 22:24", "link": "/news/story/7001/9810321"}, {"article_id": "9810300", "title": "中職／台灣大賽戲碼出爐！史上首見龍象爭霸 大巨蛋一路打到底", "summary": "中華職棒37年總冠軍賽戲碼出爐，上演史上首見的龍象大戰，中信兄弟隊要挑戰獨居史上第一的第11座總冠軍，味全隊則要尋求隊史第6冠，7戰4勝制系列賽全數都在台北大巨蛋交鋒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413784.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 22:10", "link": "/news/story/7001/9810300"}, {"article_id": "9810288", "title": "中職／獅隊燒完布雷克就沒戲唱 兄弟贏下生死戰前進總冠軍賽", "summary": "統一獅隊在0勝2敗絕境力挽狂瀾，2連勝扳平戰線，今天在生死戰推出殘血布雷克扛先發，熱投4局後戰情急轉直下，郭俊麟0.0局投球、胡智爲挨2轟，決定了兩隊命運，兄弟以8：2贏球前進台灣大賽，獅隊連兩年止步季後挑戰賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413750.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 22:04", "link": "/news/story/7001/9810288"}, {"article_id": "9810233", "title": "高球／中國信託深耕台灣高爾夫發展一甲子 舉辦「世界的涂阿玉」特展", "summary": "台灣高球傳奇女將涂阿玉老師生涯累積115座冠軍、7度榮膺JLPGA年度賞金后，近年以中國信託高爾夫顧問的身分投入人才培育，厚植台灣高球軟實力。適逢中國信託成立60周年，中國信託商業銀行特別舉辦「世界的涂阿玉」特展，首度展出逾百件涂阿玉征戰國際的珍貴高球文物，涂阿玉與在場近300位支持者分享一路走來的艱辛歷程與體悟，傳承感恩與永不放棄的台灣精神。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413701.jpg&M=1&s=Y&x=0&y=0&sw=1248&sh=832&exp=3600&sl=W&fw=360", "date": "2026-10-12 21:14", "link": "/news/story/7005/9810233"}, {"article_id": "9810205", "title": "高球／百件珍貴文物一次看！涂阿玉特展分享傳奇榮耀", "summary": "臺灣高球傳奇女將涂阿玉老師生涯累積115座冠軍、7度榮膺JLPGA年度賞金后，近年以中國信託高爾夫顧問的身分投入人才培育，厚植臺灣高球軟實力。適逢中國信託成立60周年，中國信託商業銀行特別舉辦「世界的涂阿玉」特展，首度展出逾百件涂阿玉征戰國際的珍貴高球文物，涂阿玉老師與在場近300位支持者分享一路走來的艱辛歷程與體悟，傳承感恩與永不放棄的臺灣精神。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413680.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 20:56", "link": "/news/story/7005/9810205"}, {"article_id": "9810185", "title": "中職／郭俊麟0.0局開啟連環「獅」投秀 兄弟前5局握4比0領先", "summary": "中職季後挑戰賽連續兩年決戰第四戰，統一獅、中信兄弟隊今晚一戰定生死，贏家晉級總冠軍賽、輸家賽季即刻落幕，此役前5局打完，兄弟取得4：0領先。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413658.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 20:41", "link": "/news/story/7001/9810185"}, {"article_id": "9809986", "title": "跆拳道／王婕菱大獎賽摘銅 教練勉勵不留遺憾", "summary": "台灣跆拳道新星王婕菱走出名古屋亞運失利陰霾，今天在法國舉行的世界跆拳道大獎賽拿到銅牌，而教練朱建安一句「不要有遺憾」，幫...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413574.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 19:28", "link": "/news/story/7005/9809986"}, {"article_id": "9809992", "title": "NBA／勇士格林場邊親自指點 國王菜鳥25分8助攻展現潛力", "summary": "沙加緬度國王在熱身賽作客金州勇士一戰，雖然最終以106：111在大通中心吞敗，但今年首輪第7順位潛力新秀阿庫夫（Darius Acuff Jr.）仍成為場邊焦點之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413541.jpg&M=1&s=Y&x=0&y=12&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 19:00", "link": "/news/story/7002/9809992"}, {"article_id": "9809955", "title": "北極羽賽／台灣羽壇新生代男、女雙同獲銀牌 教練簡宏儒給予高度肯定", "summary": "在芬蘭北極公開賽中，20歲男雙組合賴柏佑與蔡富丞、女雙許尹鏸與林芝昀雙雙闖入超級500等級決賽，最終以直落...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413522.jpg&M=1&s=Y&x=40&y=0&sw=1071&sh=714&exp=3600&sl=W&fw=360", "date": "2026-10-12 18:49", "link": "/news/story/7005/9809955"}, {"article_id": "9809946", "title": "武漢網球／鄭欽文肩傷退賽 詹皓晴首輪止步", "summary": "2024年打下巴黎奧運女單金牌的中國網將鄭欽文，昨天再打下北京女網賽金盃，除贏得生涯第一座WTA1000等級大賽金盃，也締造首位登頂的地主女將紀錄，不過她今天就宣布因肩膀傷勢退出同是1000等級的武漢女網賽，昨天的決賽對手、今年法網奪冠的俄羅斯新星安德瑞娃（Mirra Andreeva）同樣退出武漢金盃的爭奪。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413509.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-12 18:24", "link": "/news/story/7005/9809946"}, {"article_id": "9809889", "title": "中職／決戰G4！兄弟鄭浩均vs.獅隊布雷克 兩軍都少1洋投待命", "summary": "中華職棒季後挑戰賽決戰第4戰，兩隊先發投手亮牌，中信兄弟隊無意外推出鄭浩均，統一獅隊則交給洋投布雷克，僅休兩天，扛起生死戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413440.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 17:56", "link": "/news/story/7001/9809889"}, {"article_id": "9809809", "title": "亞帕運／多名「世界第一」坐鎮 71名選手出征名古屋", "summary": "2026年第5屆亞洲帕拉運動會即將於18日到24日在日本愛知縣及名古屋市登場，預計舉辦18項運動種類。運動部於今天正式公布本屆我國代表團參賽名單，將派出71名頂尖選手，跨海征戰12項運動種類。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413343.jpg&M=1&s=Y&x=0&y=0&sw=1234&sh=823&exp=3600&sl=W&fw=360", "date": "2026-10-12 17:18", "link": "/news/story/7005/9809809"}, {"article_id": "9809715", "title": "日職／孫易磊中繼兩局飆4K無失分 火腿淘汰西武下一輪挑戰軟銀", "summary": "日本火腿隊今天在季後賽首輪第3戰一路領先，旅日好手孫易磊中繼兩局無失分，以4：1擊敗西武隊，系列賽2勝1敗過關，後天起將和太平洋聯盟冠軍軟銀鷹隊交手，爭取打進總冠軍賽的機會。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413569.jpg&M=1&s=Y&x=0&y=39&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 16:30", "link": "/news/story/7001/9809715"}, {"article_id": "9809692", "title": "MLB／鄧愷威「台灣內戰」飆K後一抹微笑 李灝宇笑答：還滿不爽的", "summary": "台灣選手今年在大聯盟有個熱鬧的賽季，更兩度上演「台灣內戰」，李灝宇談起與鄧愷威的初次過招，開玩笑說當時吞K後，「他對我笑了一下，還滿不爽的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413123.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 16:14", "link": "/news/story/6999/9809692"}, {"article_id": "9809674", "title": "影／李灝宇自評守備「爛得可以」 盼休賽季加強站穩明年開季名單", "summary": "美國職棒大聯盟底特律老虎隊選手李灝宇今天舉行返台記者會，暢談今年首度站上大聯盟的心路歷程。李灝宇今年在大聯盟改寫多項台灣球員打擊紀錄，但聊起自己的守備，他直言「守備真的是爛得可以！」休賽季將加強滾地球處理，盼能在大聯盟站得更穩，首要目標就是力拼明年就在開季名單內。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413083.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 16:05", "link": "/news/story/6999/9809674"}, {"article_id": "9809660", "title": "MLB／李灝宇細數難忘的3場比賽 留下韋蘭德引退賽親簽打序卡", "summary": "效力老虎隊的台灣強打李灝宇，2026年球季風光落幕，本季在大聯盟留下114場出賽，細數難忘的比賽，李灝宇想起7月17日（美國時間）面對天使隊的九局致勝二壘打，以及9月18日隊白襪隊的大逆轉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413062.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 16:03", "link": "/news/story/6999/9809660"}, {"article_id": "9809623", "title": "MLB／自承守備「爛得可以」 李灝宇針對滾地球加強盼大聯盟路更順", "summary": "李灝宇靠「一片藍」的守備數據，在大聯盟卡位一席之地，寫下史上首見台灣野手打擊搏出頭案例。談到季外課題，李灝宇也自承：「守備真的是爛得可以」，季外將針對滾地球加強，希望讓自己的大聯盟之路可以走得更順。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413005.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-12 15:47", "link": "/news/story/6999/9809623"}, {"article_id": "9798549", "title": "2026MLB季後賽賽程比分 NLCS首戰道奇史庫柏7局只失2分仍輸釀酒人", "summary": "MLB最新季後賽賽程及比分", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35412972.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-12 15:40", "link": "/news/story/6999/9798549"}, {"article_id": "9809603", "title": "MLB／8月蹲板凳一度心理不平衡 李灝宇轉念：既然只讓我面對左投…", "summary": "李灝宇的大聯盟菜鳥球季留下許多回憶，其中也包括8月的板凳蟄伏期，他坦言當時為此心理不平衡、都沒有笑容，但與其抱怨，不如專注給教練給自己的任務，既然只有面對左投的機會，「那我就（把左投）看到熟，上去打就知道他們會丟什麼。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35412966.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-12 15:37", "link": "/news/story/6999/9809603"}, {"article_id": "9809537", "title": "MLB／開車赴底特律誤闖加拿大 海關google完李灝宇讚：你不錯喔", "summary": "李灝宇在大聯盟締造史上最強台灣打者賽季，今天帥氣出席返台記者會，分享大聯盟菜鳥賽季的新鮮事，透露一段要去底