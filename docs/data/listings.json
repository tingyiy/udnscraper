"articles": [{"article_id": "9641375", "title": "NBA／霍華德之子未獲魔術重用 加盟獨行俠拚延長職業生涯", "summary": "獨行俠隊近期動作不斷，才剛透過三方交易得到2024選秀狀元里薩赫（Zaccharie Risacher），今天又用雙向合約簽下2023選秀第11順位的霍華德（Jett Howard）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155869.jpg&M=1&s=Y&x=398&y=95&sw=612&sh=409&exp=3600&sl=W&fw=360", "date": "2026-07-21 14:00", "link": "/news/story/7002/9641375"}, {"article_id": "9641240", "title": "NBA／雷納德交易卡關！快艇薪資規避案未解 暴龍恐陷「人換不到也回不來」窘境", "summary": "多倫多暴龍試圖重簽雷納德，但因快艇薪資規避調查延宕，交易面臨重大變數。調查結束後，若有違規，雷納德可能遭禁賽，暴龍亦可能重新考量交易決策。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155715.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 13:42", "link": "/news/story/7002/9641240"}, {"article_id": "9641220", "title": "MLB／美媒無法相信球進鄭宗哲手套 美國鄉民全嗨翻：可以再看100遍", "summary": "紅襪隊今天靠著德賓（Caleb Durbin）超前陽春砲和鄭宗哲再見美技接殺，以6：5逆轉金鶯隊，豪取14連勝。賽後美國媒體和網友都瘋狂吹捧鄭宗哲不可思議的守備表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155701.jpg&M=1&s=Y&x=276&y=10&sw=724&sh=483&exp=3600&sl=W&fw=360", "date": "2026-07-21 13:17", "link": "/news/story/6999/9641220"}, {"article_id": "9641216", "title": "世足賽／世界盃冠軍賽掀熱潮 中華電 MOD、Hami Video 收視再創新高", "summary": "2026 FIFA世界盃™於昨（20日）落幕，西班牙擊退上屆冠軍阿根廷，睽違16年拿下「大力神盃」，中華電信（2412）表示，MOD、Hami Video完整直播104場全賽事，更創下付費會員最高上線、瀏覽次數，訂閱數都刷新上屆紀錄，再創新高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155696.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-21 13:07", "link": "/news/story/123107/9641216"}, {"article_id": "9641200", "title": "MLB／鈴木誠也近況出色第16轟出爐 球評盛讚「力量很驚人」", "summary": "芝加哥小熊日籍砲手鈴木誠也今天主場面對底特律老虎，3局下敲出個人下半季首轟，也是本季第16號全壘打。這發兩分砲也讓他把連續安打場次推進到9場。不過這場比賽小熊最終是在延長10局以6比8敗北。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155642.jpg&M=1&s=Y&x=0&y=39&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 13:03", "link": "/news/story/6999/9641200"}, {"article_id": "9641191", "title": "自由車／數據不再看得到吃不到 Bryton發表新系統讓騎士專注享受騎乘", "summary": "知名自行車車錶品牌Bryton今天舉辦發表會，打破過往專注於硬體規格升級的思維，本次以「軟體服務」為核心，推出全新技術服務「Bryton Intelligent Pilot」。執行長王聖慜直言，傳統車錶雖然能記錄龐大的運動數據，但多數業餘車友根本「看不懂也用不到」，Bryton希望透過AI技術扮演專屬運動教練，讓車友「專注騎乘，剩下的繁雜事情通通交給Bryton處理」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155618.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 12:56", "link": "/news/story/7005/9641191"}, {"article_id": "9641168", "title": "TPBL／新人王劉丞勳簽下複數年合約 攜手蔡宸綱成攻城獅建隊基石", "summary": "TPBL新竹御嵿攻城獅球團今天宣布，已正式與新人王劉丞勳提前簽下複數年延長合約，未來將與老隊友蔡宸綱攜手成攻城獅建隊基石。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155582.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-21 12:46", "link": "/news/story/7003/9641168"}, {"article_id": "9641125", "title": "籃球／東超成BCL Asia晉級途徑 台灣將與菲、蒙等隊競爭", "summary": "東亞超級聯賽（EASL）今天正式宣布，將於2026-27賽季成為亞洲籃球冠軍聯賽（BCL Asia） 的官方晉級途徑，三支東超球隊將依據2026-27賽季戰績取得 BCL Asia 參賽資格，進一步強化東超作為亞洲籃球俱樂部重要競技平台的角色。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155530.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-07-21 12:26", "link": "/news/story/7003/9641125"}, {"article_id": "9641099", "title": "MLB／李灝宇代打敲安 連5場有安打平個人最佳", "summary": "老虎隊今天打到延長10局以8：6擊敗小熊隊，台灣好手李灝宇代打出賽，首打席就敲安打，連5場有安打，已追平個人最長連續場次安打紀錄，此役最終以3支1作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155517.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 12:15", "link": "/news/story/6999/9641099"}, {"article_id": "9641054", "title": "MLB／響尾蛇亞瑞納多現役第6人2000安 更創百年歷史罕見紀錄", "summary": "目前現役球員中，生涯安打數達到2000支以上的球員，除了亞瑞納多外，還包括馬查多（Manny Machado）、高史密特（Paul Goldschmidt）、亞土維（Jose Altuve）、麥卡臣（Andrew McCutchen）與弗里曼（Freddie Freeman）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155407.jpg&M=1&s=Y&x=0&y=4&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 12:12", "link": "/news/story/6999/9641054"}, {"article_id": "9641006", "title": "NBA／2015年選秀第5順位天才想重返NBA 執行逃脫條款離開皇馬", "summary": "據記者德盧卡斯（Chema de Lucas）報導，克羅埃西亞31歲前鋒赫佐尼亞（Mario Hezonja）已啟動NBA逃脫條款，準備離開西班牙豪門皇家馬德里，重返NBA。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155313.jpg&M=1&s=Y&x=256&y=328&sw=787&sh=525&exp=3600&sl=W&fw=360", "date": "2026-07-21 11:51", "link": "/news/story/7002/9641006"}, {"article_id": "9640905", "title": "NBA／湖人補強庫明加卡關 不願大手筆交易選秀權成最大阻礙", "summary": "洛杉磯湖人對24歲前鋒庫明加的交易談判因不願支付過多選秀權而陷入停滯。雖然湖人已在休賽季大幅調整陣容，但對於這筆補強仍持謹慎態度，未來或將重新評估交易選項。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155276.jpg&M=1&s=Y&x=11&y=14&sw=1095&sh=730&exp=3600&sl=W&fw=360", "date": "2026-07-21 11:43", "link": "/news/story/7002/9640905"}, {"article_id": "9640930", "title": "NBA／二手店花百元挖寶張伯倫湖人外套 19歲賣家爽賺290萬", "summary": "一件原本在美國奧勒岡州波特蘭Goodwill二手商店被發現的張伯倫（Wilt Chamberlain）熱身外套，日前在蘇富比（Sotheby's）拍賣會上以8萬9600美元成交，金額包含買家佣金，折合約新台幣近290萬元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155213.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-21 11:34", "link": "/news/story/7002/9640930"}, {"article_id": "9640866", "title": "MLB／4局65球收工放棄勝投！釀酒人用穿戴式科技精準管控「火球王牌」", "summary": "「贏下今晚比賽」永遠會是釀酒人總教練墨菲（Pat Murphy）每日任務清單上的第一件事。不過，當「火球男」米蕭洛斯基（Jacob Misiorowski）在相隔13天重新站上投手丘時，墨菲與教練團心中同時也有更長遠的計畫，那就是要讓他保持健康，直到最後「贏得一切」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155111.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 11:15", "link": "/news/story/6999/9640866"}, {"article_id": "9640742", "title": "MLB／道奇相信現有陣容能3連霸 大谷暫停投球仍不會豪賭史庫柏", "summary": "洛杉磯道奇因大谷翔平膝傷與主捕史密斯缺陣，仍然不打算交易大聯盟頂尖投手史庫柏。道奇高層將持續維持審慎策略，優先保留潛力新秀，目標依然是爭取三連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154899.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 11:14", "link": "/news/story/6999/9640742"}, {"article_id": "9640854", "title": "世足賽／梅西、亞馬爾澡盆之戰太轟動 廠商將發限量球員卡", "summary": "阿根廷當家球星「獅王」梅西（Lionel Messi）和相差20歲的西班牙超級新星亞馬爾（Lamine Yamal），在本屆世界盃足球賽決賽上演跨世代對決，讓19年前的「澡盆合照」再被討論，連梅西都直呼瘋狂。全球最具規模的收藏卡品牌Topps嗅到商機，宣布將製作一張梅西抱著襁褓中亞馬爾的限量球員交易卡，讓世足賽話題持續延燒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155152.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 11:08", "link": "/news/story/123107/9640854"}, {"article_id": "9640763", "title": "MLB／海盜超爛守備讓人看傻眼！洋基奇森姆雙響「50轟M34」", "summary": "洋基隊今天在主場與海盜隊展開3連戰，海盜首局就發生離譜守備失誤，洋基靠著奇森姆（Jazz Chisholm Jr.）單場雙響砲，包辦5打點，幫助洋基以8：5拿下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155021.jpg&M=1&s=Y&x=387&y=635&sw=893&sh=596&exp=3600&sl=W&fw=360", "date": "2026-07-21 11:02", "link": "/news/story/6999/9640763"}, {"article_id": "9640794", "title": "中國羽賽／只花29分鐘就過關 周天成輕鬆開紅盤", "summary": "屬於BWF超級1000大賽的中國公開賽，今天在江蘇常州點燃戰火，列男單第6種子的我國「一哥」周天成在球迷一面倒支持下輕騎過關，以21：11、21：9拍下加拿大華裔對手楊燦，和前一場演出逆轉勝的混雙組合楊博軒／胡綾芳率先挺進16強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155033.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 10:55", "link": "/news/story/7003/9640794"}, {"article_id": "9640779", "title": "MLB／費城人5轟炸飛道奇 大谷翔平4支0生涯已對剋星吞12K", "summary": "道奇隊今天3任登板投手全數失分，終場以7：10不敵費城人隊，大谷翔平4打數沒有安打、吞下2次三振，只靠1次故意四壞保送上壘。費城人先發投手桑契斯（Cristopher Sánchez）在例行賽、季後賽面對大谷25打數送出12次三振，堪稱「大谷剋星」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35155023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 10:51", "link": "/news/story/6999/9640779"}, {"article_id": "9640651", "title": "MLB／道奇向洛磯換來163公里火球男 教頭：手臂天賦就在那裡", "summary": "洛杉磯道奇在季中交易大限前，與科羅拉多洛磯完成交易，獲得因肩傷復健的26歲右投哈沃森。道奇總教練羅伯茲对哈沃森的天賦表示期待，盼望能重塑其牛棚戰力。道奇送出右投弗拉索及外野手維多雷克作為交易對價。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154749.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 10:37", "link": "/news/story/6999/9640651"}, {"article_id": "9640522", "title": "世界盃／西班牙官方冠軍合照「裁掉川普」網：美國要宣戰了？", "summary": "西班牙隊將川普總統從球隊奪得世界盃冠軍的官方照片中裁切掉，引發網友熱議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154531.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-21 10:31", "link": "/news/story/123107/9640522"}, {"article_id": "9640557", "title": "世足賽／這也能賣！FIFA賣世足決賽場草皮 最貴9.6萬四款全售罄", "summary": "2026世界盃落幕，冠軍戰由西班牙以1：0戰勝阿根廷。世足賽自台灣時間6月12日開踢，直到7月20日冠軍戰，賽事緊張、各隊球星表現精采，除了球員們的努力，世足場地的「草皮」也功不可沒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154590.jpg&M=1&s=Y&x=0&y=239&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 10:17", "link": "/news/story/123107/9640557"}, {"article_id": "9640662", "title": "NBA／湖人簽下烏干達前鋒卡魯馬 夏聯曾對獨行俠狂轟34分", "summary": "湖人隊今天宣布以雙向合約簽下烏干達裔前鋒卡魯馬（Arthur Kaluma），他在夏季聯賽大殺四方，曾在面對獨行俠隊比賽狂轟34分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154775.jpg&M=1&s=Y&x=204&y=219&sw=936&sh=624&exp=3600&sl=W&fw=360", "date": "2026-07-21 10:15", "link": "/news/story/7002/9640662"}, {"article_id": "9640614", "title": "世足賽／衛冕失利先沈澱 梅西不踢美足聯明星賽了", "summary": "阿根廷沒能終結1962年迄今的世界盃「冠軍魔咒」，連霸的最後一哩路敗在西班牙手中，完全燃燒的當家球星「獅王」梅西（Lionel Messi）和隊友德保羅（Rodrigo De Paul）將稍作休息再重返邁阿密國際隊（Miami CF），預計美國職業足球大聯盟（MLS）的下兩場比賽都將缺席，也不會參加明星賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154664.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:52", "link": "/news/story/123107/9640614"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "96