s/story/122629/9650499"}, {"article_id": "9646736", "title": "把明星賽變成「趣味競賽」沒問題 那就把規則訂清楚吧！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/23/35164366.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9646736"}]}, {"name": "最新文章", "articles": [{"article_id": "9654969", "title": "MLB／李灝宇單季50安破紀錄在即 25打點排隊內第7只用隊友3分之2場次", "summary": "台灣好手李灝宇的連續場次安打之旅推進12場，今天3打數敲1安打，1支高飛犧牲打和1支內野安打掃回2分打點，本季已累積50支安打，逼近張育成2021年締造的單季54安台將紀錄，所屬的老虎隊終場以5：8不敵金鶯隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35176187.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-28 09:51", "link": "/news/story/6999/9654969"}, {"article_id": "9654902", "title": "網球／搶美網混雙百萬獎金 莎芭蓮卡合體約克維奇", "summary": "美網去年將混雙改成16隊單淘汰的賽制，不但祭出冠軍獨享100萬美金的高額獎金，且將賽事拉到單打會內賽開始前一周舉行；大會公佈今年已經報名的名單，女單白俄羅斯「世界球后」莎芭蓮卡（Aryna Sabalenka）和塞爾維亞24座大滿貫得主約克維奇（Novak Djokovic）將合體，去年奪下亞軍的波蘭斯威雅蒂（Iga Swiatek）／挪威魯德（Casper Ruud）也將捲土重來。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35176020.jpg&M=1&s=Y&x=0&y=0&sw=1254&sh=836&exp=3600&sl=W&fw=360", "date": "2026-07-28 09:22", "link": "/news/story/7005/9654902"}, {"article_id": "9654734", "title": "MLB／蔡其昌訪大聯盟總部 美職海外賽下輪台灣優先", "summary": "中華職棒大聯盟會長蔡其昌今天訪問美國職棒大聯盟，會晤主席曼佛瑞等高層。蔡其昌指出，大聯盟對台灣球迷可以坐滿日本球場感到...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35175938.jpg&M=1&s=Y&x=176&y=203&sw=913&sh=609&exp=3600&sl=W&fw=360", "date": "2026-07-28 09:15", "link": "/news/story/7001/9654734"}, {"article_id": "9654800", "title": "MLB／李灝宇內野安打推進連12場敲安 美媒讚嘆連犧牲打都飛404呎", "summary": "台灣好手李灝宇持續堆疊障礙，今天在第四局滿壘敲出內野安打，推進連12場敲安，老虎隊此役的前2分都由他貢獻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35175802.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 08:24", "link": "/news/story/6999/9654800"}, {"article_id": "9654083", "title": "傳承前輩旅日榮光路！陽岱鋼21年始終堅持 寫棒球史重要篇章", "summary": "陽岱鋼宣布在球季結束後正式引退，結束了台灣球員在日職的光輝時代。他在日職15年出賽1322場，成為唯一千安百轟百盜的台灣球員，並延續了旅日榮光。希望他能將經驗傳承給年輕球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35175101.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 07:00", "link": "/news/story/122629/9654083"}, {"article_id": "9653800", "title": "詹姆斯要替費城奪冠 76人真的準備好了嗎？", "summary": "詹姆斯加盟費城76人後，球隊面臨挑戰總冠軍的機會。他的組織能力和冠軍經驗將提升整體戰力，但健康問題、防守體系及板凳深度仍是關鍵變數。76人需在季後賽中證明自己具備冠軍實力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174679.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 07:00", "link": "/news/story/122629/9653800"}, {"article_id": "9654648", "title": "NBA／費城76人正式宣布簽下詹姆斯 將穿23號球衣", "summary": "美國職籃NBA費城76人今天正式宣布，簽下聯盟歷史得分王詹姆斯（LeBron James），而且他會穿上23號球衣", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35175667.jpg&M=1&s=Y&x=0&y=80&sw=649&sh=433&exp=3600&sl=W&fw=360", "date": "2026-07-28 05:09", "link": "/news/story/7002/9654648"}, {"article_id": "9654475", "title": "棒球／中信盃開打 「愛接棒」傳承逐夢", "summary": "中國信託慈善基金會主辦二○二六中信盃全國棒球錦標賽，昨天正式開打，來自「愛接棒計畫」支持的廿六所偏鄉學校棒球隊齊聚參賽。中信兄弟隊球星宋晟睿、伍立辰現身開幕晚宴，以自身經歷鼓勵現場近五百名小球員勇敢面對挑戰、堅持夢想。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35175412.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-28 00:00", "link": "/news/story/7001/9654475"}, {"article_id": "9654373", "title": "桌球／WTT塔什干支線賽 陳思羽吳映萱晉級女雙冠軍戰", "summary": "在烏茲別克舉行的WTT塔什干支線賽，台灣女雙陳思羽、吳映萱今天在4強戰以3比1獲勝，如願挺進冠軍戰，接下來將對戰第4種子...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35175922.jpg&M=1&s=Y&x=0&y=0&sw=1274&sh=849&exp=3600&sl=W&fw=360", "date": "2026-07-27 22:20", "link": "/news/story/7005/9654373"}, {"article_id": "9654223", "title": "籃球／國小夏季聯賽8月熱鬧開戰 地主台中52隊參賽創新高", "summary": "2026全國小學籃球夏季聯賽（EBS）將於8月1日大台中開戰，27日在台中市政府舉辦開賽記者會，今年不僅地主參賽隊數創新高，並遵照運動部建議擴大舉辦社區俱樂部組，讓更多對籃球有興趣的小朋友在盛夏以球會友。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35175185.jpg&M=1&s=Y&x=0&y=0&sw=1239&sh=826&exp=3600&sl=W&fw=360", "date": "2026-07-27 20:18", "link": "/news/story/7003/9654223"}, {"article_id": "9654171", "title": "UBA／陳威宇加強個人技能包 拚職籃選秀身價", "summary": "大專籃球聯賽UBA健行科大主力陳威宇，上季結束後並未投身職籃選秀，他今天受訪時表示希望加強個人突破、分球能力，展現更多技...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35175173.jpg&M=1&s=Y&x=0&y=54&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-27 20:06", "link": "/news/story/7003/9654171"}, {"article_id": "9654163", "title": "超馬／吉爾吉斯高山賽登場 陳彥博首日賽程暫居領先", "summary": "台灣極地超馬運動員陳彥博今天正式展開「吉爾吉斯200公里高山超馬賽」第一站的考驗，面對賽道氣溫飆升至接近攝氏30度高溫、高海拔低氧環境、將近7公斤的完全自給自足負重，以及後半段考驗步伐控制的技術性下坡地形，陳彥博以穩健的策略，以4小時4分42秒順利完賽，目前暫居第一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35175165.jpg&M=1&s=Y&x=0&y=854&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-27 19:55", "link": "/news/story/7005/9654163"}, {"article_id": "9654158", "title": "日職／張峻瑋「站在新的起跑點」拚一軍 向旅日大前輩陽岱鋼致意", "summary": "效力軟銀鷹隊的20歲台灣右投張峻瑋今天正式轉為支配下球員，背號從3位數晉升2位數，選穿17號球衣。旅日生涯邁出一大步，張峻瑋也說，現在只是站在新的起跑點，接下來還必須讓自己的實力持續提升。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35175168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-27 19:54", "link": "/news/story/7001/9654158"}, {"article_id": "9653863", "title": "NBA／不想便宜雷霆！金塊咬牙跟進報價留下瓊斯 豪華稅衝破10億", "summary": "當同區死對頭開出「要命合約」來搶自家培養的年輕球員時，你會怎麼衡量取捨？金塊今天就給出了答案，那就是吞下去。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174766.jpg&M=1&s=Y&x=0&y=16&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-27 17:07", "link": "/news/story/7002/9653863"}, {"article_id": "9653774", "title": "日職／153號→17號！張峻瑋轉支配下承接有原航平背號 先放眼一軍10勝", "summary": "20歲台灣右投張峻瑋，今天正式轉為軟銀鷹隊支配下選手，晉升雙位數背號，從153號換成17號，這個背號的前一個主人為有原航平，張峻瑋坦言多少有一點壓力，但自己會朝一軍10勝的目標努力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174612.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-27 16:17", "link": "/news/story/7001/9653774"}, {"article_id": "9653723", "title": "世界軟式少棒錦標賽中華隊今天奪冠 國手連敗多國開心互抱哭", "summary": "2026 IBA世界軟式少棒錦標賽今天在日本進行激烈的冠亞軍戰，由台中德芙蘭國小組隊的中華代表隊小國手們連續戰勝中國、新加坡和日本等國，中華隊今天奪冠，少棒國手們高興的互相抱著哭，陪同出國比賽的家長也興奮激動紅了眼眶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174529.jpg&M=1&s=Y&x=0&y=0&sw=909&sh=606&exp=3600&sl=W&fw=360", "date": "2026-07-27 16:00", "link": "/news/story/7001/9653723"}, {"article_id": "9653668", "title": "林義傑、郭彥均領軍出征2026納米比亞極限馬拉松 攜手迎向衛冕之路", "summary": "極限運動家林義傑於記者會上宣布將率領團隊參加2026納米比亞極限馬拉松，挑戰全球最艱困的沙漠耐力賽，並致力於衛冕及追求四大極地滿貫冠軍。此次備戰引入HiBERG IHHT訓練系統，提升選手表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174439.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-27 15:40", "link": "/news/story/7005/9653668"}, {"article_id": "9653691", "title": "TPBL／特攻補強教練團 美國、挪威助教加入", "summary": "為積極備戰2026-2027賽季，新北中信特攻籃球隊今天宣佈教練團補強，正式延攬兩位具備豐富國際執教經驗的助理教練，挪威籍教練艾克（Mathias Eckhoff）及美國籍教練奧雪（Chris O’Shea）加入教練團，攜手總教練費雪（Mathias Fischer）打造更具競爭力的團隊，為新賽季注入嶄新能量。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174516.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-27 15:38", "link": "/news/story/7003/9653691"}, {"article_id": "9653677", "title": "MLB／「神鱒」7月打擊手感火燙 睽違1917天敲「鐵支」助天使險勝巨人", "summary": "天使今天在客場挑戰巨人，陣中強棒「神鱒」楚奧特（Mike Trout）睽違1917天再次繳出「鐵支」成績，用4打數4安的好成績幫助球隊在3連敗後以4：3止血成功，也延續7月以來的好手感。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174463.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-27 15:32", "link": "/news/story/6999/9653677"}, {"article_id": "9652955", "title": "MLB／大都會台灣日攜手林琪兒開球 蔡其昌盼大聯盟賽事登台", "summary": "美國職棒大聯盟(MLB)紐約大都會「台灣日」活動26日在紐約皇后區花旗球場登場，中華職棒大聯盟會長蔡其昌與美國國家航空暨太空總署(NASA)台裔太空人林琪兒(Dr. Kjell N. Lindgren)共同擔任開球嘉賓。兩人分別代表棒球與太空探索，攜手站上大聯盟舞台，向全球展現台灣在體育、科技及國際交流上的能量。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35173184.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-27 15:20", "link": "/news/story/6999/9652955"}, {"article_id": "9653617", "title": "NBA／老詹沒來沒關係！柯瑞喊話勇士高層：我對充滿創意的補強抱有希望", "summary": "隨著詹姆斯（LeBron James）決定加盟76人，「老詹爭奪戰」也宣告落幕，勇士巨星柯瑞（Stephen Curry）近期就在受訪時談到球隊競爭失敗的心得，並表示本就難假設一切會如想像般順利，且就算沒能找來好友聯手，「我也相信管理層能進行充滿創意的補強」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174380.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-27 15:02", "link": "/news/story/7002/9653617"}, {"article_id": "9653528", "title": "台北羽賽／首輪強碰東奧銅牌好手 林俊易拚第2冠笑稱：第2種子籤運差", "summary": "台灣羽球男單好手「左手重砲」林俊易，今天出席台北羽球公開賽賽前記者會，儘管身負奪冠期望，但他卻搞笑說：「怎麼第2種子前2...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174240.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-27 14:31", "link": "/news/story/7005/9653528"}, {"article_id": "9653499", "title": "台北羽賽／才剛奪冠隨即趕場拚戰 周天成：每次回台灣參賽總是很開心", "summary": "BWF超級300等級的台北羽球公開賽明天開打，今天賽前記者會地主球星一字排開，其中地主男單雙保險周天成、林俊易近況都相當...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174209.jpg&M=1&s=Y&x=302&y=23&sw=814&sh=543&exp=3600&sl=W&fw=360", "date": "2026-07-27 14:27", "link": "/news/story/7005/9653499"}, {"article_id": "9653524", "title": "中職／味全龍X軟銀鷹主題日平日「攻蛋」 邀傳奇左投和田毅開球", "summary": "味全龍隊將於8月19日至8月20日在台北大巨蛋舉辦「鷹祭Summer Boost」主題日，賽事期間除了兩隊啦啦隊合體戰力加乘，指定區域資格者入場送「鷹祭in Taipei Dragons Special 聯名球衣」也是一大看點，19日更將邀請軟銀傳奇OB和田毅擔任開球嘉賓，為主題日揭開序幕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35174193.jpg&M=1