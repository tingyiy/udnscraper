rticles": [{"article_id": "9872219", "title": "亞洲運動機構協會年會登場 8國代表齊聚國訓深化國際交流", "summary": "由國家運動訓練中心主辦的「2026年第9屆亞洲運動機構協會（ASIA）年會暨研討會」於今天在高雄登場，來自8個國家的運動訓練機構代表齊聚，透過會議與專業交流，分享競技運動發展經驗，深化亞洲運動機構間的合作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507732.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 16:33", "link": "/news/story/7005/9872219"}, {"article_id": "9872213", "title": "亞冠賽／中華隊明首戰地主日本 高志綱點名警戒金丸夢斗、正木智也", "summary": "2026亞洲職棒冠軍爭霸賽明天在東京巨蛋開打，中華隊將在台灣時間晚間6點迎戰地主日本隊，總教練高志綱也點名，需特別警戒的選手包括明天的先發投手金丸夢斗，以及今年日本大賽MVP正木智也。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507739.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 16:31", "link": "/news/story/7001/9872213"}, {"article_id": "9872115", "title": "NBA／聯盟最佳仍被唱衰！名嘴點出湖人「種族論」：白人三巨頭無法奪冠", "summary": "湖人本季在唐西奇（Luka Doncic）領軍下打出10勝2敗的聯盟最佳戰績，不過，知名球評史密斯（Stephen A. Smith）卻不以為然，甚至認為湖人無法奪冠的原因，竟是陣中三大主力都是白人球員，直言球隊恐怕連季後賽第二輪都過不了。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507597.jpg&M=1&s=Y&x=0&y=28&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 16:30", "link": "/news/story/7002/9872115"}, {"article_id": "9872174", "title": "UBA／「宇宙政大」挑戰7連霸 新隊長蓄鬍撞臉金曲歌王", "summary": "今年4月在小巨蛋締造跨季74連勝、富邦人壽UBA公開男一級6連霸的政治大學，新賽季將挑戰延續「宇宙政大」王朝到7連霸，新任隊長林恩宇今天代表出席記者會，蓄鬍造型撞臉金曲歌王張震嶽，引發不少討論。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507666.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 16:16", "link": "/news/story/7003/9872174"}, {"article_id": "9872170", "title": "NBA／字母哥紀錄夜靠 阿德巴約防守鎖勝 教頭：老派的熱火式勝利", "summary": "熱火隊一哥「字母哥」安戴托昆波（Giannis Antetokounmpo）今天帶傷上陣，全場轟下30分、11籃板，生涯總得分更超越「手套」培頓（Gary Payton），以2萬1836分躍居NBA歷史得分榜第39名，率領熱火在客場以115：109險勝陣容殘缺的爵士隊，賽後總教練史波史特拉（Erik Spoelstra）表示，儘管球隊在末節熄火，但靠著防守仍是守下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507679.jpg&M=1&s=Y&x=0&y=0&sw=1212&sh=808&exp=3600&sl=W&fw=360", "date": "2026-11-11 16:14", "link": "/news/story/7002/9872170"}, {"article_id": "9872139", "title": "MLB／洋基連17年沒奪冠遭多位傳奇批評 現金人：像有人一直拿電擊棒", "summary": "洋基隊2009年以後就沒拿過世界大賽冠軍，休賽季期間，洋基總經理「現金人」凱許曼（Brian Cashman）遭到紐約媒體、前洋基球員和教練批評。凱許曼透露，自己已嘗試與這些昔日球隊成員逐一溝通，希望了解他們的真實想法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507608.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 16:06", "link": "/news/story/6999/9872139"}, {"article_id": "9872078", "title": "MLB／藍鳥重砲歧視穆斯林惹議！總管痛批「極度失望」到無法形容", "summary": "藍鳥明星外野手桑坦德（Anthony Santander）因在社群平台轉發涉及歧視穆斯林的影片，引發外界強烈批評。對此，總管艾金斯（Ross Atkins）今日在大聯盟總經理會議上首度公開回應，不僅直言對桑坦德的行為感到「極度失望」，更透露已親自與他談話，要求他公開出面說明。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507507.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 15:58", "link": "/news/story/6999/9872078"}, {"article_id": "9872045", "title": "NBA／「詹皇」又成海報背景！泰托姆重現8年前經典隔扣：雙腿回來了", "summary": "塞爾蒂克今日作客76人的焦點，可說是多不勝數，除了昔日冠軍搭檔泰托姆（Jayson Tatum）與布朗（Jaylen Brown）的互動，以及喬治（Paul George）重返76人狂攻全場最高36分，泰托姆更上演單手隔扣「詹皇」詹姆斯（LeBron James），重現2018年東冠經典畫面。泰托姆賽後也坦言，這記灌籃是歷經阿基里斯腱重傷後，睽違19個月再感受到隔扣對手的滋味。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507428.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-11-11 15:38", "link": "/news/story/7002/9872045"}, {"article_id": "9872035", "title": "UBA／新賽季17日「來耍」 政大挑戰7連霸、世新拚衛冕", "summary": "115學年度富邦人壽UBA大專籃球聯賽下周點燃戰火，今天公開一級球隊齊聚賽事宣告記者會，喊出「來耍ㄙㄥˋ」的賽季年度口號，邀請球迷一同進長，感受籃球樂趣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507400.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 15:27", "link": "/news/story/7003/9872035"}, {"article_id": "9872033", "title": "中職／捷克隊來台備戰世界16強資格賽 21、22日與台鋼雄鷹交流賽", "summary": "台灣與捷克透過棒球建立起深厚情誼，今年雙方將持續進行交流，捷克國家隊將在11月底前往中國參與世界16強資格賽，在那之前將先來台進行最後階段的集訓，並在11月21、22日在新莊棒球場與台鋼雄鷹進行2場交流賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507394.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-11 15:25", "link": "/news/story/7001/9872033"}, {"article_id": "9872011", "title": "U23世界盃／中華隊帶2敗挺進超級循環賽 依序對戰韓、日、委", "summary": "中華隊在U23世界盃棒球賽預賽打出2勝3敗，在4隊戰績相同的膠著局面下，比較對戰後脫穎而出，搶下分組第3的晉級門票，接下來6強超級循環賽將依序對上南韓、日本及委內瑞拉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507382.jpg&M=1&s=Y&x=0&y=327&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-11 15:16", "link": "/news/story/7001/9872011"}, {"article_id": "9871994", "title": "NBA／賽前握手遭忽視泰托姆不多談 布朗：我只專注在場上", "summary": "塞爾蒂克隊今天在客場以123：101擊敗76人隊，陣中球星泰托姆（Jayson Tatum）儘管在賽前試圖與前隊友布朗（Jaylen Brown）握手遭到忽視，但他最終21分外帶6籃板、4助攻幫助球隊取勝；賽後談到握手的插曲時，泰托姆雲淡風輕表示，上場就是為了專注競爭、享受比賽並力求勝利，不會讓場外雜音干擾備戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507365.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 15:12", "link": "/news/story/7002/9871994"}, {"article_id": "9871961", "title": "NBA／沙波尼斯暌違9年單場0分 國王新秀艾卡夫：不對勁", "summary": "國王隊明星長人沙波尼斯今天面對魔術隊，全場2投0中，一分未得，這是他2017年新秀賽季後首次單場0得分。國王終場以100：107輸球，新秀艾卡夫受訪時難掩沮喪之情。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507300.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-11 15:03", "link": "/news/story/7002/9871961"}, {"article_id": "9871698", "title": "足球／歐國聯迎戰克羅埃西亞 凱恩將刷新英格蘭出賽紀錄", "summary": "英格蘭足球代表隊隊長凱恩（Harry Kane）可望在明天對陣克羅埃西亞的歐洲國家聯賽（Nations League）賽...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507162.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 14:35", "link": "/news/story/7005/9871698"}, {"article_id": "9871616", "title": "體育離不開政治？美調查喜好球賽政黨傾向分明 同隊球迷卻能跨黨派", "summary": "研究顯示，美國不同地區運動偏好與政黨傾向相關；共享球隊身分可降低球迷敵意、促進跨黨交流，但看球未必改變投票立場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506656.jpg&M=1&s=Y&x=0&y=0&sw=876&sh=584&exp=3600&sl=W&fw=360", "date": "2026-11-11 14:29", "link": "/news/story/7005/9871616"}, {"article_id": "9871780", "title": "MLB／分析金鶯簽下曾峻岳可能性！美媒：有機會成為璞玉", "summary": "中華職棒富邦悍將隊火球男曾峻岳日前宣布透過入札制度挑戰大聯盟，傳出國聯中區球隊對他有興趣，美媒《Birds Watcher》則撰文分析曾峻岳加盟金鶯隊的可能性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506972.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 14:05", "link": "/news/story/6999/9871780"}, {"article_id": "9871808", "title": "亞冠賽／台日游擊手大比拚 李勛傑力推馬傑森：不會輸宗山壘", "summary": "2026年亞洲職棒冠軍爭霸賽明天將在東京巨蛋開戰，中華隊首場賽事就將迎接「台日大戰」，屆時雙方游擊手的較量也將成一大看點，日本隊有望推出2024年選秀首輪被選進的宗山壘上陣，無論面對馬傑森、陽柏翔都是話題。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506990.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 14:04", "link": "/news/story/7001/9871808"}, {"article_id": "9871683", "title": "NBA／爵士後衛單節15分拚逆轉！卻遭熱火阿德巴約「追魂鍋」吞9連敗", "summary": "熱火經歷4戰客場之旅2勝2敗後，今日靠著「字母哥」安戴托昆波（Giannis Antetokounmpo）繳出30分、11籃板的「雙十」表現，率隊一度建立23分領先優勢，加上阿德巴約（Bam Adebayo）終場前送出關鍵火鍋，成功阻擋爵士37：23的力挽狂瀾，幫助熱火以115：109驚險守住勝利，讓爐主爵士苦吞9連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506791.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-11 13:47", "link": "/news/story/7002/9871683"}, {"article_id": "9871686", "title": "亞冠賽／南韓12日首戰澳洲 推20歲新秀金旼俊先發", "summary": "2026亞洲職棒冠軍爭霸賽明天將在東京巨蛋開打，首戰由南韓隊面對澳洲隊，南韓總教練崔元豪今天也在記者會上率先公布，將由SSG登陸者隊20歲新秀投手金旼俊（Kim Min-jun）先發上陣，後續對上日本、台灣的先發人選則先保留。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506834.jpg&M=1&s=Y&x=0&y=17&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-11 13:24", "link": "/news/story/7001/9871686"}, {"article_id": "9871674", "title": "NBA／直言在塞爾蒂克能做自己！ 喬治回費城飆分還送球迷中指", "summary": "從76人隊被交易到塞爾蒂克隊的喬治（Paul George），今天首度面對前東家大殺四方，三分球11投6中轟下全場最高36分，助「綠衫軍」以123：101踢館成功，搶走泰托姆（Jayson Tatum）和布朗（Jaylen Brown）版面，甚至還送給費城球迷一記中指。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506809.jpg&M=1&s=Y&x=104&y=195&sw=987&sh=658&exp=3600&sl=W&fw=360", "date": "2026-11-11 13:21", "link": "/news/story/7002/9871674"}, {"article_id": "9871607", "title": "熊本羽賽／葉宏蔚、詹又蓁首輪逆轉過關 下一場演台灣內戰", "summary": "BWF超級500系列的日本熊本羽球大師賽，名古屋亞運銅牌的台灣混雙組合葉宏蔚、詹又蓁，今天在首輪以16比21、21比14...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506761.jpg&M=1&s=Y&x=17&y=0&sw=1033&sh=748&exp=3600&sl=W&fw=360", "date": "2026-11-11 13:17", "link": "/news/story/7005/9871607"}, {"article_id": "9871525", "title": "NBA／「好贏」復出狂射外線砍全隊最高分！太陽輕鬆擊沉快艇", "summary": "太陽隊昨天遭到馬刺隊痛宰，今天迎戰實力較弱的快艇隊，三分線火力全開，以51%命中率投進22顆，終場以133：110輕鬆拿下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506547.jpg&M=1&s=Y&x=120&y=148&sw=1001&sh=667&exp=3600&sl=W&fw=360", "date": "2026-11-11 12:33", "link": "/news/story/7002/9871525"}, {"article_id": "9871522", "title": "健力／世錦賽奪兩金！謝宗庭硬舉、總和都登頂", "summary": "我國健力選手謝宗庭在土耳其伊斯坦堡參加「2026年世界裝備公開健力錦標賽」展現卓越實力，於當地時間11月10日奪得男子組66公斤級硬舉、總和項目金牌，個人獨攬2面金牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506533.jpg&M=1&s=Y&x=1&y=478&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-11-11 12:30", "link": "/news/story/7005/9871522"}, {"article_id": "9871369", "title": "MLB／道奇新打教大有淵源！總管曝葛雷諾「回娘家」關鍵優勢", "summary": "道奇今日正式宣布，將聘請前馬林魚打教葛雷諾（Pedro Guerrero）加入團隊，並與范史柯約（Robert Van Scoyoc）共同合作，取代2019年加入的貝特斯（Aaron Bates）。有趣的是，葛雷諾不僅曾效力道奇小聯盟，更與球隊昔日世界大賽MVP同名，道奇隊總管戈梅斯（Brandon Gomes）更透露，即使沒有出現職缺，球團原本就有意延攬他回歸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35506289.jpg&M=1&s=Y&x=0&y=54&sw=1280&sh=854&exp=3600&