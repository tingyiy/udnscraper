hoto.php?u=https://uc.udn.com.tw/photo/t3/2026/07/02/35098938.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9603366"}]}, {"name": "最新文章", "articles": [{"article_id": "9607003", "title": "世足運彩／巴拉圭門將昔賣球衣救小孩 今身價飆漲仍難擋法國火力看好2.5大分", "summary": "巴拉圭門將基爾因救助早產孩子而成為焦點，賣掉國家隊球衣籌得資金。法國隊將於32強賽挑戰巴拉圭，面對姆巴佩等明星球員，法國希望快速攻破巴拉圭防線，基爾將成為防守關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104655.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:58", "link": "/news/story/123105/9607003"}, {"article_id": "9606994", "title": "世足運彩／北非雄獅沒輸過加拿大！ 推國際賽連33場不敗的摩洛哥不讓分勝", "summary": "摩洛哥與加拿大將於7月5日1時在休士頓展開16強淘汰賽。摩洛哥憑藉豐富經驗及33場不敗紀錄具優勢，加拿大則首次晉級，期待戴維斯回歸助力，面對歷史上未曾戰勝摩洛哥的挑戰。主推薦：摩洛哥不讓分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104612.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:52", "link": "/news/story/123105/9606994"}, {"article_id": "9606986", "title": "中職／林承飛挨強襲球送醫 樂天球團更新檢查結果：初步評估沒問題", "summary": "樂天桃猿隊今天在賽前傳意外，內野手林承飛在賽前練習時，遭隊友打擊練習的強襲球擊中頸部，緊急送醫治療。樂天球團隨後更新他的傷勢狀況，「初步評估沒有問題，防護團隊後續進行進一步的檢查，持續觀察。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104607.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:36", "link": "/news/story/7001/9606986"}, {"article_id": "9606899", "title": "籃球／HBL前哨戰泰帥盃籃球賽 劉丞勳回母校站台", "summary": "「GATSBY泰帥盃」高中籃球賽今天在泰山高中體育館舉行開幕典禮，邀請高中籃球聯賽HBL共8支勁旅同場較勁，其中TPBL...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104597.jpg&M=1&s=Y&x=198&y=53&sw=861&sh=574&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:21", "link": "/news/story/7003/9606899"}, {"article_id": "9606928", "title": "MLB／傷癒首轟就是滿貫！赫南德茲助道奇連兩天逆轉教士：我們從不放棄", "summary": "道奇今天靠著赫南德茲（Teoscar Hernandez）7局下轟出滿貫全壘打，以4：3超前擊敗教士，連續兩天上演逆轉秀，也將國聯西區領先優勢擴大至本季新高的14場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104526.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:09", "link": "/news/story/6999/9606928"}, {"article_id": "9606972", "title": "中職／林承飛遭強襲球擊中頸部緊急送醫 太太報平安", "summary": "樂天桃猿隊今天在台中洲際棒球場對上中信兄弟隊，賽前卻傳出意外，內野手林承飛在賽前練習時，被強襲球擊中頸部附近的位置，當場倒地，並且緊急送醫治療，先發陣容也做調整，改由劉子杰上陣擔任三壘手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104588.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:09", "link": "/news/story/7001/9606972"}, {"article_id": "9606886", "title": "MLB／1364K榮登史上第一！查普曼獨居歷史後援三振王：非常滿足", "summary": "紅襪終結者查普曼（Aroldis Chapman）今天面對天使再度寫下歷史，9局用一顆2好2壞後的時速98.6英里（約158.7公里）四縫線速球三振古茲曼（Denzer Guzman），成功拿下生涯第1364次後援三振，正式超越名人堂傳奇威爾罕（Hoyt Wilhelm）的1363次，獨居大聯盟史上後援投手三振王，隨後再製造再見雙殺，幫助紅襪以5：2擊敗天使，收下本季第17次救援成功，也是生涯第384次救援。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104449.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:09", "link": "/news/story/6999/9606886"}, {"article_id": "9606929", "title": "世足攻略／力抗38度高溫 交鋒巴拉圭「矛盾之戰」法國勝率逾8成", "summary": "法國與巴拉圭明天將在費城進行16強賽，不過根據當地天氣預報將面臨近38度的高溫，不僅是兩隊意志力的考驗，更是一場「矛盾對決」，即便傳出FIFA可能因應高溫啟動補水暫停，為比賽增添變數，但我認為這依舊無法彌補兩隊在硬實力上的巨大斷層。常規時間內，「高盧雄雞」有超過八成的勝率能昂首晉級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104557.jpg&M=1&s=Y&x=159&y=3&sw=917&sh=612&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:03", "link": "/news/story/122629/9606929"}, {"article_id": "9606952", "title": "NBA／湖人續留24歲防守悍將馬農！球員名單只剩2空缺", "summary": "湖人隊今天宣布和後衛馬農（Chris Manon）續簽雙向合約，加上先前簽下的落選新秀蘇德（Peter Suder）和奧克雷克（AK Okereke），湖人雙向名額已用完。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104556.jpg&M=1&s=Y&x=182&y=0&sw=861&sh=575&exp=3600&sl=W&fw=360", "date": "2026-07-04 17:02", "link": "/news/story/7002/9606952"}, {"article_id": "9606828", "title": "世足運彩／歷史對戰巴拉圭有絕對優勢！欣賞法國進攻秀吧 Gemini看好法國3：0勝出", "summary": "2026年世足16強賽，法國對巴拉圭顯示壓倒性優勢，賠率顯示客勝機率極高。法國近期狀態火燒，攻守全面壓制，預計將輕鬆晉級8強，總進球數預測在3球以上。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104554.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 16:51", "link": "/news/story/123105/9606828"}, {"article_id": "9606829", "title": "世足運彩／巴拉圭死守難扛法國火力 盤口態度也支持GPT主推全場3球以上", "summary": "巴拉圭在16強面對奪冠熱門法國，防守壓力巨大。法國近5戰全勝，進16球失3球，實力明顯優於巴拉圭。投注方向看好法國勝，預測比分可能為2比1或3比0。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104548.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 16:44", "link": "/news/story/123105/9606829"}, {"article_id": "9606937", "title": "中職／卡關13打席達成百安 王念好：終於出來了，1支安打要搞那麼久", "summary": "富邦悍將隊王念好生涯99安後卡關許久，終於在昨天天母棒球場完成百安，也讓他終於鬆了口氣，「終於出來了啊！1支安打而已，要搞那麼久…」接下來要為好友王苡丞的百安加油，得知他目前72安後，王念好說：「我等一下去激勵他。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104545.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-04 16:41", "link": "/news/story/7001/9606937"}, {"article_id": "9606910", "title": "世足攻略／鐵血防線撞上閃電風暴 摩洛哥經驗值更勝加拿大一籌", "summary": "當一堵密不透風的北非鐵牆，遇上帶著地主狂熱的楓葉閃電，這場世足賽16強摩洛哥與加拿大的交鋒，將是一場教科書級別的「數據量化與戰術沉著」之爭。雖然從過去四場的場均數據來看，加拿大在威脅進攻高達84次、角球逼近10次，甚至在射正次數等多項進攻指標上，都以近乎翻倍的量化優勢「全面碾壓」摩洛哥，但我始終認為，在淘汰賽這種一戰定生死的舞台上，經驗與防守體系才是不可動搖的硬道理。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104520.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 16:30", "link": "/news/story/122629/9606910"}, {"article_id": "9606925", "title": "中職／池恩齊離奇出局法關鍵在提早鬆懈 光總：和張政禹在那邊聊天", "summary": "富邦悍將隊池恩齊昨天上一壘後因被認定有進壘意圖，味全龍隊一壘手朱育賢補觸殺出局，悍將教頭後藤光尊昨天當下面露無言笑容，今天受訪對此指出，最大的問題在於池恩齊在「in play」的狀態與張政禹聊天，心情太早鬆懈。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104529.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 16:28", "link": "/news/story/7001/9606925"}, {"article_id": "9606912", "title": "中職／澄清沒騙池恩齊 張政禹：是真的就太聰明", "summary": "富邦悍將隊野手池恩齊昨天被判定有進壘意圖，在一壘被觸殺出局，外界認為被二壘手張政禹的動作騙到，張政禹澄清：「如果我是真的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102735.jpg&M=1&s=Y&x=0&y=0&sw=882&sh=588&exp=3600&sl=W&fw=360", "date": "2026-07-04 16:25", "link": "/news/story/7001/9606912"}, {"article_id": "9606911", "title": "NBA／擔任主控帶領國王重返榮耀？阿卡夫：不覺得有壓力", "summary": "國王隊2023年終結17年季後賽荒後，又連3個賽季無緣季後賽。今年獲得選秀首輪第7順位，挑中阿肯色大學明星後衛阿卡夫（Darius Acuff Jr.），他今天受訪時提到，想帶領國王重返榮耀的球星。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104496.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 16:12", "link": "/news/story/7002/9606911"}, {"article_id": "9606846", "title": "MLB／大谷明休息下次是否先發待評估 道奇教頭：二刀流負荷很大", "summary": "道奇今天以4：3逆轉擊敗教士，不過陣中日籍球星大谷翔平卻因右二頭肌緊繃提前退場。總教練羅伯茲（Dave Roberts）賽後表示，球隊將採取保守態度，因此大谷將缺席明天比賽，至於明星賽前是否還會再登板，仍有待進一步評估。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104348.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-04 15:48", "link": "/news/story/6999/9606846"}, {"article_id": "9606873", "title": "中職／葉君璋久違打擊為明年2月OB賽 自嘲打得爛要長期備戰", "summary": "味全龍隊今天在天母棒球場迎戰富邦悍將隊，選手賽前打擊練習開始前，打擊籠內先出現罕見身影，總教練葉君璋上場打擊，原以為是為明星賽備戰，葉總透露是明年二月西武獅隊來台的OB賽，他虧自己打得有夠爛，所以要從現在就開始長期訓練。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104405.jpg&M=1&s=Y&x=0&y=0&sw=1044&sh=696&exp=3600&sl=W&fw=360", "date": "2026-07-04 15:35", "link": "/news/story/7001/9606873"}, {"article_id": "9606827", "title": "世足運彩／極可能重演上屆交手劇本 Gemini看好摩洛哥2：1加拿大", "summary": "摩洛哥將於世界盃16強賽迎戰加拿大，兩隊實力懸殊。摩洛哥近五場全勝且防守穩固，將考驗加拿大防線。依據歷史交鋒，摩洛哥曾以2比1擊敗加拿大，勢頭強勁。專家預測，摩洛哥有望以1比2贏得比賽，挺進半準決賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104399.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 15:33", "link": "/news/story/123105/9606827"}, {"article_id": "9606863", "title": "MLB／大谷翔平今「二刀流」打擊出現不適 右肱二頭肌緊繃明天休兵", "summary": "道奇隊日籍球星大谷翔平今天「二刀流」出賽，繳出6局失3分的優質先發，無關勝敗，擔任打者則是在第7局就被換代打退場，賽後原因也曝光，是他在打擊時出現右側肱二頭肌緊繃，明天的比賽將休兵一天。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104471.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 15:28", "link": "/news/story/6999/9606863"}, {"article_id": "9606858", "title": "中職／收到訊息是仍有美職關注 龍隊領隊：盼費仔在那邊繼續努力", "summary": "費爾柴德（Stuart Fairchild）成為自由球員，下一步動向備受關注，味全龍隊證實有與他接觸，領隊丁仲緯表示，目前了解是美職球隊對他還是有興趣，「我們還是期盼他可以在那邊努力打拚。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104365.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 15:26", "link": "/news/story/7001/9606858"}, {"article_id": "9606826", "title": "世足運彩／經驗與防線紀律比加拿大成熟 GPT推薦摩洛哥不讓分勝、正比2：1", "summary": "摩洛哥在2026美加墨世足16強賽中面對主場作戰的加拿大，承受著淘汰賽壓力。賠率顯示摩洛哥勝出為主流，近期實力評分優於加拿大，並在過去小組賽中取得勝利。數據支持摩洛哥借助經驗與防守優勢晉級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104342.jpg&M=1&s=Y&x=274&y=246&sw=1006&sh=671&exp=3600&sl=W&fw=360", "date": "2026-07-04 15:21", "link": "/news/story/123105/9606826"}, {"article_id": "9606803", "title": "世足賽／「藍鯊」緊咬阿根廷 維德角球迷歡慶雖敗猶榮", "summary": "維德角「藍鯊」軍團今天在世界盃足球賽32強賽以2比3惜敗阿根廷，首都普拉伊亞今晨仍洋溢慶祝氣氛，掌聲、鼓聲與汽車喇叭聲此...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104322.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 15:11", "link": "/news/story/123107/9606803"}, {"article_id": "9606838", "title": "中職／劉俊緯守外野已在腦中醞釀許久 葉總評價：只差郭天信一點", "summary": "味全龍隊昨天啟用劉俊緯職棒生涯首度在比賽中防守外野，總教練葉君璋透露，這是討論已久的安排，21歲的劉俊緯還有很多發展空間，教練團思考的是如何將他留在打線內。看他昨天的外野滑接，葉總笑說：「看起來只比天信差一點。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104323.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&