bnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116566.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 14:14", "link": "/news/story/6999/9614973"}, {"article_id": "9614947", "title": "世足賽／8強賽前挪威出現感冒潮！ 總教練怪罪空調、飛機惹禍", "summary": "2026年世界盃8強賽將於台灣時間7月12日凌晨5點登場，「維京軍團」挪威將迎戰「三獅軍團」英格蘭。不過，挪威賽前卻傳出隊內出現感冒症狀，總教練索爾巴肯（Ståle Solbakken）透露，球隊有多名球員及工作人員出現咳嗽、喉嚨沙啞等情況，而頻繁搭機與長途移動，可能是造成身體不適的原因之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116494.jpg&M=1&s=Y&x=0&y=0&sw=1245&sh=830&exp=3600&sl=W&fw=360", "date": "2026-07-08 14:07", "link": "/news/story/123107/9614947"}, {"article_id": "9614856", "title": "NBA／勇士為了詹皇不匹配報價！荷蘭中鋒轉戰灰熊當周志豪替補", "summary": "荷蘭中鋒波斯特（Quinten Post）是受限制自由球員，日前接受灰熊隊3年3000萬美元合約報價。據ESPN報導，勇士隊選擇不匹配，因此他確定轉戰灰熊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116345.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 13:32", "link": "/news/story/7002/9614856"}, {"article_id": "9614851", "title": "世足賽／質疑川普介入禁賽關說 歐洲議員怒批FIFA要求徹查主席", "summary": "世足賽賽場外掀起政治干預風暴，國際足球總會（FIFA）主席英凡提諾（Gianni Infantino）日前因暫緩美國隊前鋒巴洛根（Folarin Balogun）的紅牌禁賽令，遭質疑是受到美國總統川普（Donald Trump）施壓。對此，數十名歐洲議會議員正串聯發起調查，痛批FIFA此舉破壞運動公平性，「簡直是向川普政府低頭」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116346.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 13:30", "link": "/news/story/123107/9614851"}, {"article_id": "9614823", "title": "中職／台鋼雄鷹重大傷兵！ 守護神林詩翔右肘韌帶斷裂決定開刀", "summary": "台鋼雄鷹重大傷兵報告！今天球團公布，陣中守護神林詩翔已在6日接受右肘檢查，診斷結果為「右肘尺側副韌帶斷裂」及「尺側腕屈肌肌腱斷裂」，將進行手術。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116301.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 13:16", "link": "/news/story/7001/9614823"}, {"article_id": "9614752", "title": "MLB／大谷翔平成「300轟俱樂部」首位日籍球員 紀錄之夜道奇遭逆轉", "summary": "道奇隊「二刀流」大谷翔平今天再寫生涯成就，面對洛磯隊首局首打席開轟，大聯盟生涯第300轟達陣，成為大聯盟史上第170位300轟打者，也是日籍球員第一人，雖替道奇隊打下第1分，但道奇隊在比賽後段因守備大亂流以3：4遭逆轉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116208.jpg&M=1&s=Y&x=0&y=269&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 12:55", "link": "/news/story/6999/9614752"}, {"article_id": "9614751", "title": "TPBL／雲豹與營運長顏行書完成續約 捐3年百萬薪資回饋社會", "summary": "桃園台啤永豐雲豹今天宣布，正式與球隊營運長顏行書完成續約，顏行書過去三個賽季兩度榮膺年度經理人，不僅幫助球隊抱回隊史首冠、勇奪例行賽龍頭，更在續約後隨即宣布，將捐出3年共100萬的部分薪資所得給予桃園在地的慈善機構與育幼院。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116207.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 12:55", "link": "/news/story/7003/9614751"}, {"article_id": "9614488", "title": "MiLB／費爾柴德轉戰水手先練手感 新人聯盟轟3分砲", "summary": "台美混血好手費柴德轉戰美國職棒西雅圖水手隊，今天先到小聯盟（MiLB）體系的新人聯盟找手感，立刻轟出3分砲，全場3打數1...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116094.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 12:28", "link": "/news/story/6999/9614488"}, {"article_id": "9614618", "title": "NBA／不捨布朗穿上別隊球衣 泰托姆坦言：真的很難接受", "summary": "塞爾蒂克日前將效力球隊9個賽季的前總冠軍賽MVP布朗（Jaylen Brown）交易至76人，正式宣告「雙探花」時代畫下句點。身為多年搭檔的泰托姆（Jayson Tatum）近日公開談及此事，坦言直到現在仍覺得「很奇怪」，也感嘆兩人的合作「結束得太突然」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116010.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-08 12:26", "link": "/news/story/7002/9614618"}, {"article_id": "9614554", "title": "NBA／詹皇密會格林引爆聯想！但美媒點真正領跑的是騎士、熱火與76人", "summary": "隨著「詹皇」詹姆斯（LeBron James）正式離開湖人，他的下一站仍持續成為外界關注焦點。根據《ESPN》權威記者查拉尼亞（Shams Charania）透露，詹姆斯近日正與勇士前鋒格林（Draymond Green）在一處未公開地點會面，再度引發外界對他加盟勇士、聯手柯瑞（Stephen Curry）的聯想。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115865.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 12:25", "link": "/news/story/7002/9614554"}, {"article_id": "9614576", "title": "世足賽／外媒統計8強球隊籤表難度 阿根廷最低、挪威最高", "summary": "世足賽16強賽今天落幕，阿根廷對埃及上演瘋狂逆轉秀，以3：2拿下勝利，驚險晉級。接下來8強戰阿根廷將對上瑞士，外媒統計，本屆世界盃8強球隊中，阿根廷賽程難度最低；哈蘭德（Erling Haaland）領軍的挪威最高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115908.jpg&M=1&s=Y&x=432&y=0&sw=848&sh=565&exp=3600&sl=W&fw=360", "date": "2026-07-08 12:04", "link": "/news/story/123107/9614576"}, {"article_id": "9614555", "title": "籃球／新莊體育園區打造首座智慧共享球站 8至31日享前30分鐘免費借用", "summary": "為推廣全民運動，新北市體育局與智慧運動器材共享平台「aeball」合作，今年4月在新莊體育園區啟用新北市首座「智慧化共享球站」，至今服務超過600個運動人次，累計提升民眾250小時的運動時數，為全台首例由政府機關引進自動化球類租借服務的公私協力典範。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115862.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-07-08 11:54", "link": "/news/story/7003/9614555"}, {"article_id": "9614394", "title": "MLB／李灝宇代打吞K 老虎靠史庫柏好投擊敗運動家奪3連勝", "summary": "美國職棒大聯盟（MLB）底特律老虎隊台灣好手李灝宇今天代打上場，1打數吞下三振，另外發生1次守備失誤，不過老虎隊最終仍以...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115763.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 11:37", "link": "/news/story/6999/9614394"}, {"article_id": "9614314", "title": "NBA／年資差1年家人就能共享醫療福利！法國前鋒先重返歐洲賽場等良機", "summary": "根據《HoopsHype》記者史考托（Michael Scotto）報導，現年30歲的法國前鋒亞布塞萊（Guerschon Yabusele）決定暫別NBA，確定與希臘勁旅帕納辛奈科斯（Panathinaikos）達成3年合約，重返歐洲賽場，並將成為歐洲聯賽薪資最高的3名球員之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115473.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-08 11:36", "link": "/news/story/7002/9614314"}, {"article_id": "9614405", "title": "世足賽／法國摩洛哥之戰派4位阿根廷裁判 網砲轟FIFA：乾脆叫梅西看VAR", "summary": "世足賽16強賽阿根廷上演瘋狂逆轉秀，13分鐘連進3球，以3：2氣走埃及。不過裁判吹罰公平性受全球海量球迷質疑。國際足總（FIFA）公布法國和摩洛哥8強戰裁判，4位都是阿根廷籍，再度遭網友們批評。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115646.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 11:22", "link": "/news/story/123107/9614405"}, {"article_id": "9614380", "title": "世足賽／瑞士點球大戰終破魔咒 隊長查卡談8強戰梅西：極大挑戰", "summary": "瑞士今天在世足賽16強淘汰賽中，歷經一場驚心動魄的PK大戰，最終成功擊敗哥倫比亞，挺進8強，這場勝利不僅打破了瑞士在世足賽賽史上的點球「魔咒」，更是他們自1954年以來首次殺入世足賽八強，賽後，瑞士主帥雅金（Murat Yakin）難掩興奮之情，盛讚全隊展現了不可思議的韌性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115625.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 11:10", "link": "/news/story/123107/9614380"}, {"article_id": "9614180", "title": "NBA／曾陷毒品爭議又涉酒駕！前湖人冠軍前鋒認罪協商酒駕定罪", "summary": "現年46歲的前湖人冠軍前鋒歐頓（Lamar Odom）今年1月在「賭城」拉斯維加斯因涉嫌酒駕遭逮捕，根據他的辯護律師貝克（Michael Becker）向《美聯社》透露，歐頓預計將與檢方達成認罪協商，以「不抗辯」方式結案，原本的酒駕指控將降為魯莽駕駛。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115204.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 11:05", "link": "/news/story/7002/9614180"}, {"article_id": "9614231", "title": "世足賽／8強對戰賽程出爐！法國強碰「北非雄獅」 阿根廷拚衛冕壓軸迎戰瑞士", "summary": "2026年世界盃足球賽8強對戰組合揭曉，阿根廷將對陣瑞士，法國迎戰摩洛哥。法國欲重演2022年卡達的勝利，摩洛哥則盼復仇；阿根廷目標連霸挑戰歷史。其他對戰包括西班牙對比利時、英格蘭對挪威。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115434.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 10:50", "link": "/news/story/123107/9614231"}, {"article_id": "9614303", "title": "MLB／海盜歐赫恩瘋狂3響砲、10打點破隊史 大聯盟前一人是大谷翔平", "summary": "海盜隊今天在主場以12：4擊敗勇士隊，歐赫恩（Ryan O’Hearn）上演瘋狂個人秀，前6局就轟出3發全壘打，飛行距離合計1172英尺（357.2 公尺），單場4安、灌進破隊史紀錄的10分打點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115572.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-08 10:47", "link": "/news/story/6999/9614303"}, {"article_id": "9614254", "title": "NBA／超複雜六方交易成形！勒佛特被送去公鹿、米道頓轉戰巫師", "summary": "根據ESPN記者查拉尼亞（Shams Charania）報導，活塞隊將勒佛特（Caris LeVert）交易至公鹿隊。巫師隊透過先簽後換交易，得到簽下3年1760萬美元合約的米道頓（Khris Middleton），這兩筆交易形成一筆六方大交易。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115369.jpg&M=1&s=Y&x=99&y=0&sw=1181&sh=787&exp=3600&sl=W&fw=360", "date": "2026-07-08 10:41", "link": "/news/story/7002/9614254"}, {"article_id": "9614243", "title": "MLB／大谷首打席開轟連兩天炸裂 生涯300轟達成！", "summary": "道奇隊今天在主場對上洛磯隊，大谷翔平擔任開路先鋒，首打席就把球扛出中外野大牆，連續兩天開轟，是他本季第20轟，大聯盟生涯第300轟達陣！並幫助道奇隊取得1：0領先。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115786.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 10:32", "link": "/news/story/6999/9614243"}, {"article_id": "9599483", "title": "NBA／2026年自由市場開跑 球員交易簽約動態懶人包", "summary": "看似沒有太多大咖球星恢復自由身的一年，卻在7月1日自由市場正式開啟前，早早引爆各種引人入勝的重大交易案和簽約事件，包括「字母哥」安戴托昆波（Giannis Antetokounmpo）轉戰熱火、「球三」小鮑爾（LaMelo Ball）西進明尼蘇達等。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/01/35092819.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 10:17", "link": "/news/story/7002/9599483"}, {"article_id": "9614101", "title": "MLB／明星賽前還會再投一場 大谷翔平依原訂計劃周六登板", "summary": "洛杉磯道奇隊日籍球星大谷翔平前一場「二刀流」出賽時，打擊出現右側肱二頭肌緊繃提前退場，但傷勢預計不會影響他的下一場登板。道奇總教練羅伯茲（Dave Roberts）今天指出，他還是會按照原訂計畫，在台灣時間周六於主場出戰響尾蛇隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115107.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 09:44", "link": "/news/story/6999/9614101"}, {"article_id": "9614048", "title": "世足賽／梅西拯救阿根廷 隊友讚「世界最佳球員」", "summary": "阿根廷今天16強賽起死回生，在0：2落後埃及下上演13分鐘攻進3球的史詩級逆轉，其中當家球星「獅王」梅西（Lionel Messi）先傳助攻再攻進追平球，持續推進世界盃紀錄，讓隊友阿爾瓦雷斯（Julián Álvarez）大讚梅西就是傳奇，是「世界上最佳球員」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115041.jpg&M=1&s=Y&x=0&y=0&sw=1261&sh=841&exp=3600&sl=W&fw=360", "date": "2026-07-08 09:24", "link": "/news/story/123107/9614048"}]}, {"name": "2026美加墨世足", "articles": [{