news/story/6809/9816014"}, {"article_id": "9815855", "title": "遼寧艦穿越沖繩海域赴西太平洋 日方公布航跡及艦載機起降動向", "summary": "中共海軍遼寧艦航母編隊14日赴西太平洋訓練，日本防衛省當日晚公布航跡指出，遼寧艦通過沖繩本島與宮古島之間海域，並在石垣島以南約250公里處進行艦載戰鬥機起降，日本航空自衛隊緊急出動戰鬥機應對。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421893.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 10:03", "link": "/news/story/6812/9815855"}, {"article_id": "9815826", "title": "馬斯克大讚美光價格合理 怒嗆其他記憶體廠「簡直在敲詐」", "summary": "特斯拉與SpaceX執行長馬斯克已多次公開稱讚美光科技（Micron），13日晚間再度表示美光在「未來記憶體價格方面相當合理」，他同時對其他供應業者頗有微詞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421860.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:58", "link": "/news/story/6811/9815826"}, {"article_id": "9815819", "title": "SK海力士已自高峰回落57% 投資人大舉撤離AI行情中最熱股票", "summary": "全球半導體股遭到拋售，SK海力士股價已從四個月前高峰重挫57%，可見投資人正大舉撤離AI行情中最過熱的股票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421841.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:55", "link": "/news/story/6811/9815819"}, {"article_id": "9815811", "title": "台韓之後輪到日本！川普宣布210億美元半導體投資 點名日本出錢", "summary": "美國總統川普14日在真實社群發文宣布，美國再迎來一筆210億美元巨額投資，日本將依他的指示提供資金。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421833.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:53", "link": "/news/story/6811/9815811"}, {"article_id": "9815807", "title": "文學可以使用AI嗎？法國龔固爾文學獎爭議下，法國文壇怎麼看AI創作", "summary": "2026年，法國龔固爾文學獎（Prix Goncourt）第一輪入圍名單中的作品《不這樣就是死》被指控是以AI創作而成，使能否使用AI創作、文學獎該不該引入AI檢測工具等問題，引起法國文壇辯論。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35420078.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:52", "link": "/news/story/6810/9815807"}, {"article_id": "9815774", "title": "國慶致詞的奧義！比較習近平、賴清德、韓國瑜的三種國家想像", "summary": "本文比較2024年至2026年間，習近平、賴清德與韓國瑜的國慶演說文本，觀察三位政治領導人如何界定國家、治理、兩岸關係與安全秩序，各自的論述重心又有哪些轉變。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416693.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:40", "link": "/news/story/6812/9815774"}, {"article_id": "9815767", "title": "普發一萬對經濟有沒有幫助？ 2026諾貝爾經濟學獎「新凱因斯學派」的倚天劍與屠龍刀", "summary": "2026諾貝爾經濟學獎得主，由史丹佛大學的羅伯特・霍爾（Robert E. Hall，圖左）與哥倫比亞大學的麥可・伍德福德（Michael Woodford，圖右），因為共同奠定了「總體經濟穩定政策的個經基礎」而共享殊榮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35418550.jpg&M=1&s=Y&x=0&y=0&sw=678&sh=452&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:36", "link": "/news/story/6809/9815767"}, {"article_id": "9815766", "title": "日本儲能市場設資安門檻…陸廠認證卡關 日媒說長庚、台塑和韓廠搶商機", "summary": "日本加強電網設備資安要求，大陸主要儲能供應商尚未取得認證，為台韓業者打開商機。日經亞洲報導，長庚國際能源、台塑集團及三星SDI正擴產、搶進日本市場，爭取降低對大陸設備依賴的客戶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421755.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:36", "link": "/news/story/6811/9815766"}, {"article_id": "9815664", "title": "羅馬青少年隨機飛踹滑板車騎士！知名演員重傷 1嫌竟是憲兵之子", "summary": "羅馬日前驚現青少年駕駛迷你汽車，隨機靠近攻擊騎滑板車的民眾或行人，義大利知名演員亞科皮尼（Davide Iacopini...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421648.png&M=1&s=Y&x=0&y=63&sw=740&sh=493&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:04", "link": "/news/story/6812/9815664"}, {"article_id": "9815696", "title": "美國人「最愛水果」陷生存難題！成本大漲、售價卻漲不動 業者苦撐", "summary": "伊朗戰爭推高油價與肥料成本，也讓美國自熱帶地區運來的最受歡迎水果——香蕉——面臨危機。香蕉業者原本獲利就非常微薄，如今運輸和生產成本大漲，售價卻調不上去，還得應付病害、氣候變遷__。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421647.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:03", "link": "/news/story/6811/9815696"}, {"article_id": "9815686", "title": "高科技日本為何突然變成駭客肥羊 AI拆掉一道意外防線", "summary": "日本是機器人、汽車與電子產業強國，資安防線卻沒有想像中堅固。更意外的是，日本過去其實還有一道連自己都未必意識到的「天然防線」，曾讓海外駭客不容易得手。如今AI正在把這層保護拆掉，也讓日本原本隱藏的弱點一下暴露出來。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35418336.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 09:00", "link": "/news/story/6809/9815686"}, {"article_id": "9815684", "title": "神準押中9月升息今再預警 申克：Fed 12月可能一口氣升2碼", "summary": "早在6月便預測聯準會（Fed）9月升息的經濟學家如今認為，Fed本月可能先按兵不動，但若通膨未明顯降溫，12月可能一口氣升息2碼（0.5個百分點）。Fed官員對AI投資過熱的警告，加上褐皮書顯示價格壓力擴散，也使年底升息力道更受關注。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421628.jpg&M=1&s=Y&x=0&y=0&sw=387&sh=258&exp=3600&sl=W&fw=360", "date": "2026-10-15 08:56", "link": "/news/story/6811/9815684"}, {"article_id": "9815673", "title": "晶片股又遭血洗！韓股暴跌6%日經225狂瀉2,300點 費半6天蒸發1.6兆美元", "summary": "全球半導體股與科技股今（15日）持續重挫，亞洲晶片股跟隨美國同業走跌，韓股開盤後重挫超過6%，一度觸發程式化交易暫停機制，日股也大跌超過3%。市場憂心聯準會（Fed）可能升息，以及AI產業面臨融資困難。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421610.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 08:51", "link": "/news/story/6811/9815673"}, {"article_id": "9815668", "title": "川普政府提議解凍部分俄資產以促成和談 歐洲反應曝光", "summary": "金融時報14日獨家報導，美國提議歐洲國家解凍部分俄羅斯入侵烏克蘭後遭凍結的主權資產，並轉移至由華府監督的機構，試圖藉此重啟和平談判。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421602.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 08:46", "link": "/news/story/6809/9815668"}, {"article_id": "9815642", "title": "承認斬首行動做過頭 川普稱答應「不再除掉伊朗領導人」", "summary": "美國總統川普14日在亞利桑那州一場造勢集會上表示，美軍在「史詩怒火行動」（Operation Epic Fury）期間襲擊伊朗領導階層後，德黑蘭要求他承諾不再將伊朗領導人列為攻擊目標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421551.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 08:24", "link": "/news/story/124061/9815642"}, {"article_id": "9815630", "title": "美期中選舉將至 猶如2028總統大選前哨戰", "summary": "美國將在11月3日舉行期中選舉，選後國會兩院席次將決定美國未來兩年政局及川普政府施政。多數民調顯示，民主黨取得聯邦眾議院...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421544.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-15 08:22", "link": "/news/story/6813/9815630"}, {"article_id": "9815634", "title": "蘋果收盤市值首度突破5兆美元 直追輝達的霸主地位", "summary": "蘋果公司周三（14日）收盤市值首度突破5兆美元，反映市場對蘋果新一代產品陣容的樂觀預期，尤其以折疊手機 iPhone Duo最受矚目。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421528.jpg&M=1&s=Y&x=0&y=0&sw=933&sh=622&exp=3600&sl=W&fw=360", "date": "2026-10-15 08:15", "link": "/news/story/6811/9815634"}, {"article_id": "9815615", "title": "這國家淪AI獵場？神祕美國訂單買走50噸「冷門二手書」", "summary": "生成式人工智慧（AI）吃遍網路資料後，開始回頭採購紙本書。今年8月起，日本多家線上古書店接到大批「毫無脈絡」的訂單；日本大型新書批發商也證實曾賣書給美國AI新創公司。日媒追查發現，至少50噸的日文書籍已飄洋過海。從新書到古書，日本為何突然成為AI公司尋找訓練資料的「獵場」之一？", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416215.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 08:00", "link": "/news/story/6809/9815615"}, {"article_id": "9815612", "title": "「無限資金」夢撞上舉債現實 CoreWeave股債雙殺 股價崩跌15.5%", "summary": "設法取得投資等級信用評等，就能獲得「無限」資金。對幾乎任何企業而言，這都是大膽的說法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421505.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 07:59", "link": "/news/story/6811/9815612"}, {"article_id": "9815611", "title": "烏軍星鏈突遭限速！馬斯克稱民用性質不能用於進攻 暗示美國政府介入", "summary": "烏克蘭無人機仰賴科技富豪馬斯克旗下SpaceX公司的星鏈（Starlink）衛星網路導航，攻擊俄羅斯目標並保護領空。但烏克蘭官員表示，部分星鏈服務13日突然受限，多項作戰任務因此受阻。馬斯克則暗示，限制烏克蘭部分武器移動速度及維持星鏈網路連線的決定，背後可能涉及美國政府。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421504.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 07:56", "link": "/news/story/6809/9815611"}, {"article_id": "9815608", "title": "Anthropic單季營收衝168億美元 季增近50% 可能趕在感恩節前掛牌", "summary": "人工智慧（AI）新創企業Anthropic第3季營收高達168億美元（台幣約5,406億元），較上季增加接近50%，並連續第二季在調整後基礎上實現獲利。這家Claude開發商正爭取投資人支持，有可能在感恩節前掛牌，部分投資人認為合理估值可達1.8兆至2兆美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421500.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 07:46", "link": "/news/story/6811/9815608"}, {"article_id": "9815604", "title": "今晨國際頭條一次看／通膨升溫美股重挫 澤倫斯基直指川普背叛", "summary": "「今晨國際頭條」同步檢視華爾街日報、華盛頓郵報、金融時報、衛報、路透與美聯社首頁，挑出各家頭條新聞、重點摘要與「為何重要」。用最短閱讀時間，快速掌握國際主流媒體此刻最重視的議題。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421496.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-15 07:41", "link": "/news/story/6811/9815604"}, {"article_id": "9815596", "title": "川普亞利桑那集會提台積電 稱美將占全球50%晶片產能", "summary": "繼昨天稱台灣同意採購阿拉斯加天然氣並投資相關計畫後，美國總統川普今天在亞利桑那州一場造勢集會上提及台積電在當地擴大投資設...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421495.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-15 07:40", "link": "/news/story/6813/9815596"}]}, {"name": "中東戰火連綿", "articles": [{"article_id": "9815642", "title": "承認斬首行動做過頭 川普稱答應「不再除掉伊朗領導人」", "date": "2026-10-15 08:24", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421551.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124061/9815642"}, {"article_id": "9815396", "title": "2艘新加坡籍貨櫃船荷莫茲海峽遇襲 1沉沒1船體受損", "date": "2026-10-15 06:16", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/15/35421486.jpg&M=1&s=Y&x=8&y=0&sw=1272&sh=848&exp=3600&w=300", "link": "/news/story/124061/9815396"}, {"article_id": "9815157", "title": "3層樓沒了…葉門叛軍襲沙烏地阿美石油公司 執行長辦公室也遭殃", "date": "2026-10-14 21:27", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35420974.jpg&M=1&s=Y&x=0&y=294&