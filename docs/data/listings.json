://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367614.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9780010"}]}, {"name": "最新文章", "articles": [{"article_id": "9784521", "title": "名古屋隨筆／雨來亂 網球「關門打」引眾怒", "summary": "名古屋亞運連日雨勢攪局，尤其網球場自開打第二天就因雨打亂賽程，原訂戶外球場賽事全部移進室內四面球場，但賽程依舊消化不完，「大塞車」的狀況也考驗大會的應變能力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35374179.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-30 00:00", "link": "/news/story/124981/9784521"}, {"article_id": "9784519", "title": "亞運／倒數5天 我搶金部隊壓軸登場", "summary": "中華代表團截至昨天在名古屋亞運拿下三金、十銀、二十四銅，在最後五天的賽程中，若想追平上屆杭州亞運的佳績，幾乎是不可能的任務，不過包括「柔道男神」楊勇緯、女子拳擊雙金釵陳念琴與林郁婷，以及射箭、跆拳道等隊伍都將陸續上陣，衝刺雙位數金牌成為關鍵指標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35374185.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-30 00:00", "link": "/news/story/124981/9784519"}, {"article_id": "9784518", "title": "亞運克拉術／從柔道轉項「才半年」 施劉俐伶抱銀", "summary": "從柔道轉練克拉術僅半年，施劉俐伶昨天在名古屋亞運女子八十七公斤級闖進金牌戰，最終以○比五不敵南韓選手金敏永，無緣克拉術隊史首金，再替我國代表團進帳一面銀牌，本屆克拉術代表隊兩銀一銅作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35374151.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-30 00:00", "link": "/news/story/124981/9784518"}, {"article_id": "9784514", "title": "亞運射擊／楊昆弼霸氣喊奪金 「大家都來看」", "summary": "名古屋亞運射擊男子不定向飛靶決賽昨天登場，第三度站上亞運殿堂的我國好手楊昆弼，一路與科威特四十八歲老將阿爾穆札夫激戰至最後一發失手，最終以銀牌作收，雖以一發之差與金牌擦身而過，但走過上屆杭州亞運資格賽加射失利的挫折，楊昆弼賽後展現成熟心態，甚至霸氣主動向運動部部長李洋喊話，將在今天混雙賽事拿下「金色」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35374149.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-30 00:00", "link": "/news/story/124981/9784514"}, {"article_id": "9784504", "title": "亞運拳擊／陳念琴打進金牌戰 要林郁婷快跟上", "summary": "名古屋亞運拳擊女子六十五公斤級四強賽，我國好手陳念琴昨天對決四月亞洲錦標賽金牌戰老對手、北韓強敵黃孝順，雙方歷經三回合激戰，陳念琴靠著豐富經驗與精準策略，再度以三比二技壓對手晉級金牌戰，寫下個人亞運生涯最佳成績，後天將全力拚首金。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35374142.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-30 00:00", "link": "/news/story/124981/9784504"}, {"article_id": "9784289", "title": "亞運網球／混雙首戰開胡笑談與曾俊欣搭配 謝淑薇：請叫他法拉利哥", "summary": "名古屋亞運網球賽事，曾俊欣／謝淑薇首度合拍出戰混雙賽事，今天首戰以6：1、6：2擊敗伊朗組合打出好彩頭，兩人賽後開心說起彼此搭配的互動，謝淑薇笑問曾俊欣，「你一打三沒有問題吧？」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373964.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 21:27", "link": "/news/story/124981/9784289"}, {"article_id": "9784275", "title": "亞運田徑／擺脫想逃避的壓力 余雅倩女子鏈球第6名作收", "summary": "上屆杭州亞運獲得第4名與頒獎台擦身的我國女子鏈球全國紀錄保持人余雅倩，今天在名古屋亞運決賽登場，最終擲出64公尺35以第6名作收，相較於上屆的失落與遺憾，余雅倩賽後展現出更多成熟與坦然，坦言雖然結果不盡理想，但在調適壓力與心理成長上已跨出重要一步，「輸了就輸了，就是繼續再努力。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373944.jpg&M=1&s=Y&x=0&y=0&sw=1173&sh=782&exp=3600&sl=W&fw=360", "date": "2026-09-29 21:08", "link": "/news/story/124981/9784275"}, {"article_id": "9784267", "title": "亞運田徑／吳彥翰挑戰紀錄遇抽筋 黃湧富傷後復出盡力完賽仍留遺憾", "summary": "名古屋亞運男子撐竿跳決賽今天在雨中登場，我國好手吳彥翰與黃湧富連袂出擊，全國紀錄保持人吳彥翰，在雨勢影響與試跳5公尺60抽筋的考驗下，以低於自己全國紀錄1公分的5公尺50收下第6名；而術後復出的黃湧富則以5公尺05成績獲得第12名，賽後兩人皆表示，能代表國家放手一搏、突破自我，是非常寶貴且難忘的經驗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373934.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 20:59", "link": "/news/story/124981/9784267"}, {"article_id": "9784246", "title": "中職／滿壘超會打！悍將2波4分大局獵殺雄鷹 二軍總冠軍賽開門紅", "summary": "中華職棒二軍總冠軍賽今天開打，富邦悍將隊兩次滿壘都成功兌換大局，終場以9：4擊敗台鋼雄鷹隊，在5戰3勝制系列賽先搶下首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373981.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 20:39", "link": "/news/story/7001/9784246"}, {"article_id": "9784187", "title": "亞運網球／曾俊欣、許育修一日兩戰皆告捷 曾俊欣首搭謝淑薇混雙開胡", "summary": "名古屋亞運網球賽事受到雨勢影響，包括許育修、曾俊欣今天都單打、雙打一日兩戰，皆順利過關，單打雙闖第三輪，男雙許育修／何承叡挺進8強，混雙曾俊欣／謝淑薇首戰也告捷。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373811.jpg&M=1&s=Y&x=0&y=0&sw=1267&sh=845&exp=3600&sl=W&fw=360", "date": "2026-09-29 20:11", "link": "/news/story/124981/9784187"}, {"article_id": "9784144", "title": "亞運／中華奧會主題館312人次造訪 主席蔡家福盼體育交流", "summary": "今年的名古屋亞運，中華奧會特地在市區打造「中華奧會主題館（NOC House）」，至今已逾312人次造訪；主席蔡家福今天...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373802.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 20:01", "link": "/news/story/124981/9784144"}, {"article_id": "9784048", "title": "NBA／從天才狀元到期待落差 鵜鶘威廉森媒體日說出真心話", "summary": "鵜鶘前鋒「胖虎」威廉森（Zion Williamson）在季媒體日上罕見坦承，自己目前的NBA生涯發展並沒有達到心中期待。面對記者詢問如何看待現階段職業生涯時，他給出相當直接的回答。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373637.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-29 19:02", "link": "/news/story/7002/9784048"}, {"article_id": "9784025", "title": "NBA／史上第一人！柯瑞生涯總薪資突破6億美元 超越KD、LBJ", "summary": "金州勇士球星柯瑞（Stephen Curry）近日與球隊完成延長合約，不只確定繼續留在唯一效力過的NBA球隊，也讓他的生涯場上收入正式寫進聯盟歷史。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373592.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 18:25", "link": "/news/story/7002/9784025"}, {"article_id": "9784007", "title": "亞運射擊／最後一發遭逆轉摘銀 楊昆弼霸氣喊話混雙「我要金色」", "summary": "我國射擊不定向飛靶好手楊昆弼，今天在名古屋亞運男子不定向飛靶個人決賽展現強大實力，雖以一發之差錯失金牌，但仍順利射下珍貴銀牌；談到從雅加達摘金到杭州資格賽加射失利，如今成熟突破奪銀，楊昆弼賽後談起心態轉變，甚至霸氣向運動部部長李洋喊話，混雙目標明確，「我要的是金色！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373564.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 18:09", "link": "/news/story/124981/9784007"}, {"article_id": "9783835", "title": "亞運克拉術／施劉俐伶轉項克拉術僅半年 首拚摘銀完成奪牌夢想", "summary": "前柔道國手施劉俐伶原先已經退役轉任教職，不過內心仍懷抱亞運夢想，讓她僅花費半年轉職為克拉術選手，如今更在名古屋亞運摘下女...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373588.jpg&M=1&s=Y&x=0&y=90&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-29 17:28", "link": "/news/story/124981/9783835"}, {"article_id": "9783859", "title": "NBA／唐斯表態願長留尼克 追逐連霸續約未定坦言「不舒服」", "summary": "紐約尼克上季睽違53年奪下總冠軍，新賽季開打前依然被視為爭冠熱門勁旅，不過陣中主力長人唐斯（Karl-Anthony Towns）的續約問題，卻成為球隊媒體日焦點之一。唐斯再次強調，他希望能與尼克完成延長合約，也坦言在合約尚未確定的情況下迎接新賽季，確實不是最舒服的狀態。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373370.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 17:14", "link": "/news/story/7002/9783859"}, {"article_id": "9783844", "title": "MLB／金慧成有望進季後賽名單？道奇教頭：絕對是討論人選", "summary": "道奇隊韓籍工具人5月後就沒在大聯盟出賽過，道奇仍闖進季後賽且不用打外卡賽。道奇總教練羅伯茲（Dave Roberts）受訪時，主動提到金慧成進入季後賽名單的可能性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373338.jpg&M=1&s=Y&x=0&y=0&sw=976&sh=651&exp=3600&sl=W&fw=360", "date": "2026-09-29 17:07", "link": "/news/story/6999/9783844"}, {"article_id": "9783776", "title": "亞運自由車／0.076秒之差力壓地主隊 女子團體競速摘銅", "summary": "亞運自由車場地賽今天傳回好消息，陳靖云／劉尚盈／王歆婷今天在女子團體競速賽事，在銅牌戰繳出49秒061的成績、以0.076之差擊敗地主日本隊，收下銅牌，是自由車本屆首面獎牌，也是中華代表隊第24面銅牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373184.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 16:35", "link": "/news/story/124981/9783776"}, {"article_id": "9783757", "title": "中職／拚季後賽資格獅隊30日派林詔恩先發 悍將洋投魔力藍迎戰", "summary": "中職季後賽門票競爭激烈，接下來每場對戰都很關鍵，目前全年度勝率2、3名球隊，統一7-ELEVEn獅隊與富邦悍將明天交手，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373179.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-29 16:34", "link": "/news/story/7001/9783757"}, {"article_id": "9783700", "title": 