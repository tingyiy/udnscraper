: [{"name": "專欄", "articles": [{"article_id": "9761469", "title": "中職／近身球風波延燒 場上火花不該變成跨場情緒", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309062.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/122629/9761469"}, {"article_id": "9761785", "title": "接下林志傑的火炬 陳盈駿扛起中華男籃最艱難10年", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/18/35339246.jpg&M=1&s=Y&x=0&y=159&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9761785"}, {"article_id": "9758358", "title": "2026球季7大最佳季前補強 藍鳥希斯領銜、紅襪三星齊入列", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35333742.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9758358"}, {"article_id": "9757998", "title": "沒「大物」靠團隊 U15中華隊盼突破世界盃最佳成績", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332989.jpg&M=1&s=Y&x=67&y=0&sw=1152&sh=768&exp=3600&w=300", "link": "/news/story/122629/9757998"}, {"article_id": "9756739", "title": "中職／本土奇兵崛起成亮點 富邦滿手好牌卻接連放槍", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331229.jpg&M=1&s=Y&x=0&y=73&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9756739"}, {"article_id": "9755985", "title": "「毀滅性打擊」快艇背後 NBA如何從密約事件重建公信力？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332284.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9755985"}]}, {"name": "最新文章", "articles": [{"article_id": "9764464", "title": "亞運／不受開村紛爭影響將全程參與開幕式 李洋：盡全力維持對等尊嚴", "summary": "名古屋亞運開幕式即將在今天晚間於瑞穗公園陸上競技場舉行，我國代表團將由拳擊好手黃筱雯、武術散打好手張煥宜擔任掌旗官，對於晚間是否會如期參與開幕式，運動部部長李洋在今天出席中繼站參訪活動時也強調，將會全程參與不缺席，並且已經依照流程進行申報，將會盡全力維持對等尊嚴。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343389.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-19 10:49", "link": "/news/story/124981/9764464"}, {"article_id": "9764461", "title": "亞運／歷來最強中繼站開箱 李洋：以選手角度給予最大幫助", "summary": "為了提供今年名古屋亞運參賽選手最強後勤支援，今年運動部選定三地設置中繼站，其中位在名古屋市區的「御園小學校」中繼站更堪稱是史上設備最完善、規模最大的中繼站，在今天的中繼站導覽活動後，運動部部長李洋也強調，從4月到此考察時，就希望以過去選手的角度，給予選手最大的幫助。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343383.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-19 10:46", "link": "/news/story/124981/9764461"}, {"article_id": "9764405", "title": "MLB／台將新頁誕生！李灝宇敲本季第10轟、28長打 雙破張育成紀錄", "summary": "還沒站上打擊區，李灝宇先在三壘防區發生失誤，結果在打擊區上用火力道歉，前3打數已敲2安打，第八局補上單場第3安，是一發追平兩分砲，幫助老虎扳平8：8。李灝宇本季第10轟，超越張育成2021年的9轟，成為史上第一位在大聯盟締造雙位數全壘打的台將，單季28支長打，也超越張育成同一年的26支。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343278.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-19 10:27", "link": "/news/story/6999/9764405"}, {"article_id": "9764403", "title": "MLB／狄亞茲復健賽糟糕仍重返大聯盟 道奇教頭：還有3到4次機會", "summary": "道奇隊終結者狄亞茲（Edwin Diaz）日前在小聯盟進行復健賽、如今將重返大聯盟，道奇為了騰出名額，將右投納克（Landon Knack）下放3A。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343268.jpg&M=1&s=Y&x=0&y=0&sw=1237&sh=825&exp=3600&sl=W&fw=360", "date": "2026-09-19 10:26", "link": "/news/story/6999/9764403"}, {"article_id": "9764387", "title": "NBA／熱火6000萬美元續約瑞典鐵衛 製造進攻犯規次數聯盟前10", "summary": "邁阿密熱火來自瑞典的後衛拉森（Pelle Larsson）同意與球隊簽下4年6000萬美元（約新台幣19.1億元）延長合約，合約包含2030-31年賽季的雙方選項，讓球隊與球員在合約後段都保有一定彈性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343237.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-19 10:20", "link": "/news/story/7002/9764387"}, {"article_id": "9764383", "title": "NBA／上季場均不到10分 湯普森獲活塞5年1.55億美元合約", "summary": "據ESPN報導，活塞隊防守悍將湯普森（Ausar Thompson）已與球團達成5年1.55億美元（約新台幣49.2億元）延長合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343225.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-19 10:11", "link": "/news/story/7002/9764383"}, {"article_id": "9764333", "title": "亞運／一度被拒絕入場後首發文 李洋：心裡真的很有感觸", "summary": "名古屋亞運今天正式開幕，昨天運動部長李洋出席中華隊歡迎典禮升旗儀式時，一度無法進入選手村，經協調後才順利進場。李洋事後在社群平台坦言，「心裡真的很有感觸。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343144.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-19 09:42", "link": "/news/story/124981/9764333"}, {"article_id": "9764316", "title": "中職／悍將、兄弟同日達陣主場60萬人次進場 本季5隊場均破萬在望", "summary": "繼味全龍隊後，富邦悍將、中信兄弟隊都在昨天跨過本季主場60萬人次進場，統一獅、樂天桃猿隊距離門檻也不遠了，本季有望寫下空前5隊場均破萬紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343125.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-19 09:30", "link": "/news/story/7001/9764316"}, {"article_id": "9764242", "title": "室外拔河世錦賽中華隊2金1銅 女子500公斤達成5連霸", "summary": "2026世界室外拔河錦標賽在南非登場，中華隊18日勇奪2金1銅，其中女子500公斤組擊退德國，達成5連霸，青少年女子...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343122.jpg&M=1&s=Y&x=0&y=680&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-19 09:26", "link": "/news/story/7005/9764242"}, {"article_id": "9764202", "title": "基隆城市半程馬拉松20日登場…4千人起跑交通管制及停車看這裡", "summary": "2026基隆城市半程馬拉松20日上午5時30分從國門廣場起跑，分成3公里親子組、9公里休閒組和21公里半程馬拉松組，共計4000人報名參賽。路線行經港西街、忠一路、中正路至中正、義一路口折返後，再經國門廣場、港西街、中山一到四路、中華路、文明路、湖海路，到喵喵咖啡圓環折返，回起點國門廣場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35342979.jpg&M=1&s=Y&x=0&y=0&sw=600&sh=400&exp=3600&sl=W&fw=360", "date": "2026-09-19 06:57", "link": "/news/story/7005/9764202"}, {"article_id": "9764041", "title": "力抗打壓…亞運開村儀式 李洋一度被拒絕入場", "summary": "名古屋亞運今晚正式開幕，中華代表團昨天參與選手村開村歡迎儀式，卻發生插曲，運動部部長李洋一度遭亞奧會拒絕入場，經過我方強烈抗議後，討回應有權利。活動延後一個半小時再重新舉行，李洋率代表團成員完成升旗儀式。日媒報導，亞運組委會現場負責人稱，是組委會和亞洲奧林匹克理事會（ＯＣＡ）未協調好，才延後舉行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/18/35342713.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-19 00:00", "link": "/news/story/124981/9764041"}, {"article_id": "9763943", "title": "中職／不滿勝騎士滾地傳球 平野惠一：這不是中信兄弟的棒球", "summary": "中華職棒中信兄弟隊洋投勝騎士今天的「滾地傳球」引起熱議，總教練平野惠一賽後直言此舉點燃對手反攻氣勢，「這是絕對不被允許的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35343111.jpg&M=1&s=Y&x=310&y=29&sw=763&sh=508&exp=3600&sl=W&fw=360", "date": "2026-09-18 23:09", "link": "/news/story/7001/9763943"}, {"article_id": "9763928", "title": "中職／續命安助兄弟險勝獅隊 張士綸：關鍵時刻就興奮", "summary": "中職中信兄弟隊今天靠著張士綸9局下敲出追平安打續命，延長賽王威晨敲出再見高飛犧牲打，才以5比4險勝統一7-ELEVEn獅...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/18/35342598.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-18 22:50", "link": "/news/story/7001/9763928"}, {"article_id": "9763874", "title": "中職／范國宸堅稱只是借肩膀 投手丘上與張奕耳語是秘密", "summary": "富邦悍將隊今天以2：1險勝樂天桃猿隊，寶貴的兩分，都由隊長范國宸送回，也幫助張奕再度成為「勝投怪盜」，兩人在九局上搭肩耳語，談話內容是不能說的秘密，范國宸說：「他那麼有經驗的選手了，給他搭個肩而已，沒有什麼特別的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/18/35342564.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-18 21:56", "link": "/news/story/7001/9763874"}, {"article_id": "9763864", "title": "中職／這就是富邦四棒！范國宸再見安 悍將本季第6場再見勝", "summary": "富邦悍將隊前6局攻勢18上18下，看似涼透的打線，在比賽後段啟動加熱，第七局范國宸二壘打先送回追平分，第九局再敲再見安打，以2：1擊敗樂天桃猿隊，悍將收下本季第6場再見勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/18/35342514.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-18 21:41", "link": "/news/story/7001/9763864"}, {"article_id": "9763746", "title": "亞運排球／中華女排遭直落三不敵泰國 分組第二晉級", "summary": "中華女排今天在名古屋亞運取得二連勝後已提早搶進8強，今天預賽最終戰對上強敵泰國，但陷入苦戰，最終以22：25、22：25、20：25遭直落三吞敗，以C組第二之姿晉級。", "thumbnail": "https://pgw.udn.com.tw/gw/pho