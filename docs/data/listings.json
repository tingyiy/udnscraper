: "棒球／從亞冠賽、U23到冬盟 應建立培養出與日韓抗衡球員制度", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/19/35534336.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9889447"}, {"article_id": "9889200", "title": "史上最會組團的GOAT！詹姆斯正在幫助76人成為爭冠球隊", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/20/35535682.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9889200"}, {"article_id": "9887012", "title": "中職／只投11局還能領百萬月薪 江少慶會否被獅隊戰力外？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530458.jpg&M=1&s=Y&x=0&y=0&sw=928&sh=619&exp=3600&w=300", "link": "/news/story/122629/9887012"}]}, {"name": "最新文章", "articles": [{"article_id": "9897082", "title": "關懷盃／季後最「暖」賽事台東落幕 林智勝相約明年11/26-29花蓮見！", "summary": "第33屆關懷盃棒球邀請賽，兩支在地隊伍卑南國小、卑南國中雙雙將硬式少棒組、青少棒組冠軍留在台東，軟式少棒組則由沖繩Fighters奪冠，連續4屆由沖繩球隊帶走冠軍。賽事今天順利落幕後，原棒協理事長林智勝也和大家相約，明年11月26日至29日花蓮見！", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546261.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 20:07", "link": "/news/story/7001/9897082"}, {"article_id": "9897003", "title": "國際交流化為養分 輔大男籃以賽代訓備戰UBA", "summary": "輔大男籃在亞太天主教大學運動會首戰以73比78不敵檀國大學，教練盼藉交流磨合陣容、修正外線與慢熱問題，備戰UBA。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546223.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-23 19:45", "link": "/news/story/7003/9897003"}, {"article_id": "9896991", "title": "關懷盃／林海星7局完投勝還跑回致勝分 卑南國中逆轉桃源奪第4冠", "summary": "第33屆原棒協關懷盃青少棒組冠軍戰上演「台東內戰」，卑南國中睽違4屆再闖冠軍戰，與桃源國中上演投手戰，卑南林海星繳出完投7局僅失1分的表現，自己還在6局下跑回致勝分，終場卑南國中以2：1逆轉桃源，收下隊史在關懷盃的第4冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546208.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 19:31", "link": "/news/story/7001/9896991"}, {"article_id": "9896919", "title": "棒球／捷克隊逛大稻埕 霞海城隍廟祈求12強資格賽事順利", "summary": "捷克國家棒球代表隊相隔2年再度來台，中華職棒大聯盟與文總安排文化走讀行程，今天帶領捷克隊員走進台北大稻埕，吃滷肉飯、蚵仔...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546116.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 18:55", "link": "/news/story/7001/9896919"}, {"article_id": "9896890", "title": "拍出活力與健康 機關盃羽球、匹克球大賽熱鬧登場", "summary": "中央機關盃羽球、匹克球大賽23日於台大登場，運動部成立後首辦，兩項賽事吸引450位選手參賽，為期四天開放民眾觀賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546063.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 18:20", "link": "/news/story/7005/9896890"}, {"article_id": "9896865", "title": "關懷盃／原棒協與創世台東分院公益合作 陳鏞基、王維中、董子恩現身", "summary": "第33屆原棒協關懷盃在台東舉行，原棒協副理事長陳鏞基22日與會員王維中、董子恩一同走訪創世基金會台東分院，互動過程中，一位病友見到球員後流下眼淚，讓陳鏞基感觸很深，「看到他流眼淚，其實我是滿感動的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546036.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 18:02", "link": "/news/story/7001/9896865"}, {"article_id": "9896842", "title": "田徑／全國田徑賽女子跳遠金牌南投縣許安彤 將參加巴西世界中學運動會", "summary": "南投縣女子跳遠好手許安彤12月將參加巴西世界中學運動會，南投縣政府教育處運動發展科長廖宜政代表縣長許淑華、南投縣體育會總幹事洪銘惠代表理事長潘一全，及田徑委員會主任委員莊士傑議員今天（23日）赴下午赴國立草屯商工，為許安彤選手頒發營養金並加油打氣，預祝能締造優異成績，為縣為國爭光。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546010.jpg&M=1&s=Y&x=0&y=0&sw=801&sh=534&exp=3600&sl=W&fw=360", "date": "2026-11-23 17:50", "link": "/news/story/7005/9896842"}, {"article_id": "9896749", "title": "關懷盃／陳鏞基姪子陳恩築投打好表現 卑南國小奪7冠史上最多", "summary": "關懷盃棒球邀請賽今天進行冠軍戰，硬式少棒組由地主隊台東卑南國小與首度參賽新北大豐國小，陳鏞基姪子陳恩築完投4局，打擊還敲3安，終場卑南就提前4局以11：0完封對手，將冠軍留在台東，並以7冠獨居關懷盃少棒組王者。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545868.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 17:07", "link": "/news/story/7001/9896749"}, {"article_id": "9896690", "title": "NBA／唐西奇快有幫手！里夫斯完整參與湖人訓練歸隊倒數", "summary": "湖人隊雖少了後場大將里夫斯（Austin Reaves），仍是聯盟開季表現最佳的隊伍之一，且里夫斯回歸倒數，今天他也到練習場進行完整訓練，成湖人利多消息。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545780.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 16:31", "link": "/news/story/7002/9896690"}, {"article_id": "9896658", "title": "MLB／少了史庫柏的道奇5大先發投手 官網預測山本掛帥、朗希第4號", "summary": "道奇隊今年挑戰世界大賽3連霸失利，在自由球員市場爭奪強投史庫柏（Tarik Skubal）也不敵大都會隊，新球季首席先發投手仍是山本由伸，如果沒有意外，將扛起明年3月26日對勇士隊開幕戰重任。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545771.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-23 16:16", "link": "/news/story/6999/9896658"}, {"article_id": "9896640", "title": "關懷盃／瑞穗國小獲季軍寫隊史最佳 「大谷翔昇」與黃志堅雙繳好表現", "summary": "花蓮瑞穗國小今天在關懷盃邀請賽硬式少棒組季軍戰對上台東新生國小，「大谷翔昇」林冠昇先發登板且繳雙安表現，加上隊長黃志堅後援4局還飆再見三振，幫助瑞穗以6：5拿下勝利，在關懷盃奪出隊史最佳的季軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545661.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 16:11", "link": "/news/story/7001/9896640"}, {"article_id": "9896561", "title": "MLB／道奇終於在FA市場踢到鐵板 官網：近年爭奪超級巨星很少失利", "summary": "道奇隊近年在自由球員（FA）市場挖角大咖無往不利，今年季後終於踢到鐵板，確定被大都會隊搶走史庫柏（Tarik Skubal），道奇官網今天特別提到：「過去幾年爭奪超級巨星的過程中，很少敗給其他競爭對手。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545573.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 15:35", "link": "/news/story/6999/9896561"}, {"article_id": "9896547", "title": "NBA／布克送親筆簽名球衣！ 讚賞爵士榜眼：我最喜歡的菜鳥", "summary": "鳳凰城太陽日前擊敗傷兵滿營的猶他爵士，當家球星布克（Devin Booker）不僅帶領球隊收下勝利，更在比賽結束後，特別將自己的親筆簽名球衣送給爵士19歲榜眼菜鳥彼特森（Darryn Peterson），還在球衣上寫下「我最喜歡的新秀」，展現對這位年輕小將的高度欣賞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-23 15:34", "link": "/news/story/7002/9896547"}, {"article_id": "9896487", "title": "NBA／老鷹雙大鎖壓制康寧漢只拿5分 多特：我喜歡和丹尼爾斯搭檔", "summary": "前三節還在苦苦追趕，老鷹卻在第四節突然變身鋼鐵防守軍團，不僅讓活塞當家球星康寧漢（Cade Cunningham）幾乎找不到得分機會，更靠著一波18比0的猛烈攻勢徹底扭轉戰局。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545407.jpg&M=1&s=Y&x=21&y=0&sw=1259&sh=839&exp=3600&sl=W&fw=360", "date": "2026-11-23 15:15", "link": "/news/story/7002/9896487"}, {"article_id": "9896490", "title": "關懷盃／為何加入棒球隊？ 王翾祐：被曾聖安和何品室融抬到辦公室", "summary": "在統一獅隊「基哥」、原棒協副理事長陳鏞基的號召之下，除了年年現身關懷盃的學長們外，今年多位獅隊年輕選手也首度在關懷盃亮相，包括捕手張翔、外野手朱迦恩，以及去年才進入職棒的19歲新秀王翾祐，王翾祐笑說：「學長說持續參加關懷盃的會很強。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545409.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 15:11", "link": "/news/story/7001/9896490"}, {"article_id": "9896477", "title": "TPBL／夢想家要頒冠軍戒了！Ring Night主題日三上悠亞不缺席", "summary": "上季勇奪隊史首冠的福爾摩沙夢想家，27日晚間7點將在主場臺中洲際迷你蛋迎戰桃園台啤永豐雲豹，並舉辦「Ring Night」主題日。賽前特別安排冠軍戒指頒發儀式，由夢想家總經理韓駿鎧親自為球團高層、制服組及球員送上冠軍戒指，球團邀請所有「我夢家人」齊聚主場，共同見證這份榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545340.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-23 15:01", "link": "/news/story/7003/9896477"}, {"article_id": "9895867", "title": "NBA／唐西奇爆粗口「飆罵隊友」網瘋傳 湖人瑞迪克護航：他在領導", "summary": "湖人前日在NBA盃中，靠著葛萊姆斯（Quentin Grimes）終場前的超前三分彈，幫助球隊以106：104險勝國王。然而，當家球星唐西奇（Luka Doncic）中場走回休息室，爆粗口飆罵全隊的畫面，才是大家真正關注的話題。對於唐西奇的情緒爆發，總教練瑞迪克（JJ Redick）今日則出面護航，直言唐西奇是在「領導」球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35544235.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 15:00", "link": "/news/story/7002/9895867"}, {"article_id": "9896374", "title": "NBA／遭嗆得分太少！格林反酸柏金斯「板凳啦啦隊」：比生涯就像霸凌", "summary": "前塞爾蒂克中鋒、《ESPN球評》柏金斯（Kendrick Perkins）日前批評格林（Draymond Green）得分太少，認為在柯瑞（Stephen Curry）缺陣期間，格林場均至少要拿10分，甚至搬出當年在「狼王」賈奈特（Kevin Garnett）受傷時挺身而出的例子。然而格林賽前不僅花10分鐘狂酸柏金斯，今日首節更連飆3記三分，最後一擊還守住泰托姆（Jayson Tatum），成功在主場以88：87險勝塞爾蒂克，終止5連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545166.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 14:41", "link": "/news/story/7002/9896374"}, {"article_id": "9896411", "title": "MLB／大都會84%薪資分給6大咖 另34名球員只剩4200萬美元可用", "summary": "億萬富翁柯恩（Steve Cohen）從2020年接手大都會隊以來，砸錢毫不手軟成為招牌，這次又在自由球員市場擊敗競爭對手道奇、教士、藍鳥隊，和兩屆塞揚獎強投史庫柏（Tarik Skubal）簽下9年4億5000萬美元合約；值得一提的是，史庫柏平均年薪寫下大聯盟投手新紀錄，就是超越柯恩自己過去簽下的兩大塞揚獎投手薛澤（Max Scherzer）、韋蘭德（Justin Verlander）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545219.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 14:35", "link": "/news/story/6999/9896411"}, {"article_id": "9896402", "title": "NBA／生涯總得分超越傳奇「指環王」 泰托姆：代表有做對什麼", "summary": "塞爾蒂克隊今天以87：88敗給勇士隊，吞下4連敗，不過當家球星泰托姆（Jayson Tatum）生涯得分超越傳奇羅素（Bill Russell），成為隊史得分榜第8位，讓他直呼又酷又榮幸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545209.jpg&M=1&s=Y&x=0&y=5&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 14:32", "link": "/news/story/7002/9896402"}, {"article_id": "9896364", "title": "日職／DAZN力挺古林睿煬！12月12日公益球迷見面會限量100席", "summary": "DAZN將於12月12日在台北舉辦古林睿煬公益球迷會，限100席，收入扣除成本後捐台灣原住民拳擊協會，並首播北海道同遊花絮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545151.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-23 14:21", "link": "/news/story/7001/9896364"}, {"article_id": "9896257", "title": "NBA／溫班亞瑪「灌投」爆紅卻傳抄襲？ 亞當斯搬4年前影片打臉", "summary": "馬刺日前在主場以124：112擊敗快艇的比賽中，被轉播員戲稱為「Shunk」的溫班亞瑪（Victor Wembanyama）「灌投」，在NBA官方24小時內累積近1億次觀看，成為本季觀看次數最多的一球。有趣的是，火箭中鋒亞當斯（Steven Adams）近日則跳出來「維權」，坦言自己早在2022年時，就已展現過這項技能。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545147.jpg&M=1&s=Y&x=254&y=46&sw=811&sh=540&exp=3600&sl=W&fw=360", "date": "2026-11-23 14:19", "link": "/news/story/7002/9896257"}, {"article_id": "9896212", "title": "滑冰／參賽人數創新高！北市全國中正盃小巨蛋圓滿落幕 首設「局長獎」激勵學子", "summary": "115年全國中正盃滑冰錦標賽於北市小巨蛋落幕，參賽人數創歷年新高，首設局長獎；22人跨齡演出《皮克敏的一天》成焦點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545129.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 14:18", "link": "/news/story/7005/9896212"}, {"article_id": "9896279", "title": "MLB／楚奧特合約總值被史庫柏超前 明年最高薪仍是大谷翔平", "summary": "兩屆塞揚獎強投史庫柏（Tarik Skubal）明年改穿大都會隊球衣，9年4億5000萬美元合約寫下大聯盟投手新紀錄，總值超越天使隊看板球星楚奧特（Mike Trout），躍居史上第4高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545033.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 14:02", "link": "/news/story/6999/9896279"}]}, {"name": "棒球", "articles": [{"article_id": "9897082", "title": "關懷盃／季後最「暖」賽事台東落幕 林智勝相約明年11/26-29花蓮見！", "date": "2026-11-23 20:07", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546261.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9897082"}, {"article_id": "9896991", "title": "關懷盃／林海星7局完投勝還跑回致勝分 卑南國中逆轉桃源奪第4冠", "date": "2026-11-23 19:31", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546208.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9896991"}, {"article_id": "9896919", "title": "棒球／捷克隊逛大稻埕 霞海城隍廟祈求12強資格賽事順利", "date": "2026-11-23 18:55", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546116.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9896919"}, {"article_id": "9896865", "title": "關懷盃／原棒協與創世台東分院公益合作 陳鏞基、王維中、董子恩現身", "date": "2026-11-23 18:02", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https: