 "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192454.jpg&M=1&s=Y&x=178&y=0&sw=941&sh=627&exp=3600&sl=W&fw=360", "date": "2026-08-02 13:04", "link": "/news/story/7005/9665634"}, {"article_id": "9665806", "title": "MLB／好消息！「費仔」緊急重返大聯盟 近況火燙獲水手青睞", "summary": "台美混血外野手「費仔」費爾柴德（Stuart Fairchild）再度迎來大聯盟機會。西雅圖水手今天賽前進行陣容異動，因主力外野手瑞利（Luke Raley）左前臂傷勢惡化，被放進10天傷兵名單，球團決定從3A叫上費爾柴德支援外野戰力。水手此戰最終以4：3擊敗明尼蘇達雙城，不過費爾柴德並未出賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192421.jpg&M=1&s=Y&x=0&y=18&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 12:53", "link": "/news/story/6999/9665806"}, {"article_id": "9665768", "title": "MLB／宇宙道奇不讓了！老虎王牌史庫柏確定跳槽 ESPN：衝擊世界大賽冠軍", "summary": "大聯盟交易大限將在後天到期，道奇隊今天出手補進老虎隊王牌投手史庫柏（Tarik Skubal），送出小聯盟2投1野做為交易條件，這位兩屆塞揚獎強投生涯7年首次轉戰國聯球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192371.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 12:12", "link": "/news/story/6999/9665768"}, {"article_id": "9665764", "title": "NBA／灌籃王拉文訪台送溫暖 和唐寶寶交流做公益", "summary": "由桃園市政府主辦的「2026桃園珍珠海岸國際音樂節」系列活動於本周末盛大登場，現役NBA飛人級球星拉文（Zach LaVine）今天上午10點特別出席在桃園大溪笠復威斯汀度假酒店舉辦的「LoVine 桃園（Love in Taoyuan）」公益交流活動，傳遞「用愛守護桃園」的核心精神，不僅展現體育明星的公益影響力，更將愛與希望帶進桃園。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192363.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 12:09", "link": "/news/story/7002/9665764"}, {"article_id": "9665740", "title": "MLB／道奇重磅交易「虎王」史庫柏 與山本組雙王牌挑戰3連霸", "summary": "衛冕軍洛杉磯道奇在交易截止日前完成震撼補強，根據報導，道奇將透過大型交易從底特律換來左投「虎王」史庫柏（Tarik Skubal）。這名連續2年拿下美聯塞揚獎的王牌投手，將加入已經星光熠熠的道奇輪值，協助球隊挑戰3連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192341.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 12:07", "link": "/news/story/6999/9665740"}, {"article_id": "9665732", "title": "MLB／兩顆指叉球遭拉菲拉轟出雙響砲 山本由伸優質先發不敵紅襪", "summary": "道奇隊今天繼續在洛杉磯主迎戰紅襪隊，山本由伸登板先發，遭拉菲拉（Ceddanne Rafaela）轟出雙響砲，投8局失3分吞敗，道奇終場2：3落敗，輸掉3連戰前兩戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192331.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 11:47", "link": "/news/story/6999/9665732"}, {"article_id": "9665706", "title": "MLB／挑戰道奇霸業！釀酒人拚4人交易 強化捕手戰力深度", "summary": "密爾瓦基釀酒人持續在交易市場尋找能立即提升戰力的球員，同時也先完成一筆著眼於組織深度的交易。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192273.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-02 11:31", "link": "/news/story/6999/9665706"}, {"article_id": "9665667", "title": "MLB／培瑞茲臨時頂替先發差點上演無安打 勇士笑奪4連勝", "summary": "在交易截止日前夕，如果一名先發投手臨時被撤下，外界往往會聯想到是否與交易傳聞有關；而臨時頂替登板的投手，通常也不會被期待投出接近歷史紀錄的表現。但亞特蘭大勇士老將左投培瑞茲（Martín Pérez）卻把握機會，差點寫下無安打比賽，也在勇士先發輪值因傷再添變數之際，替球隊帶來一場重要勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192231.jpg&M=1&s=Y&x=145&y=8&sw=1135&sh=757&exp=3600&sl=W&fw=360", "date": "2026-08-02 11:19", "link": "/news/story/6999/9665667"}, {"article_id": "9665653", "title": "MLB／桑契斯6局11K無失分助費城人止敗 5保送仍暴露近況不穩", "summary": "面對費城費城人近況低迷的困境，先發左投桑契斯（Cristopher Sánchez）雖然近期也不在最佳狀態之內，但他依然展現王牌氣勢，重新與隊友一起找回勝利方程式。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192197.jpg&M=1&s=Y&x=176&y=0&sw=909&sh=606&exp=3600&sl=W&fw=360", "date": "2026-08-02 11:07", "link": "/news/story/6999/9665653"}, {"article_id": "9665652", "title": "L7 LIAN CROSSFIT奪下Red Bull Gym Clash台灣總決賽冠軍 將前進埃及", "summary": "全球混合式健身競賽Red Bull Gym Clash台灣總決賽昨天（1日）進行，來自全台各地的健身房代表隊伍齊聚一堂，透過結合力量、耐力、技巧與團隊策略的多項挑戰，角逐年度台灣最強健身房榮耀。經過激烈較量，最終由L7 LIAN CROSSFIT在三項比賽制霸全場、奪下冠軍。他們將代表台灣前進埃及參加世界總決賽，與近30個國家冠軍隊伍共同角逐「地表最強健身房」殊榮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192193.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 11:05", "link": "/news/story/7005/9665652"}, {"article_id": "9665616", "title": "NBA／換帥後破冰！八村壘重返日本國家隊 盼爭取洛杉磯奧運門票", "summary": "今年7月與洛杉磯快艇簽約的日本球星八村壘（Rui Hachimura），近日回到東京新宿進行活動，並且公開表態，表示自己將會重返日本男籃代表隊。他說：「我想回到日本代表，再次為日本籃球努力。」這也代表他有望自2024年巴黎奧運後，睽違約2年再度披上日本隊戰袍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192155.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 10:46", "link": "/news/story/7002/9665616"}, {"article_id": "9665602", "title": "NBA／幸運奪冠換跑道！索漢1年合約加盟拓荒者 力拚開季15人名單", "summary": "根據《ESPN》知名記者查拉尼亞（Shams Charania）報導，自由球員前鋒索漢（Jeremy Sochan）已與拓荒者達成協議，雙方將簽下一年合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192116.jpg&M=1&s=Y&x=0&y=0&sw=1199&sh=799&exp=3600&sl=W&fw=360", "date": "2026-08-02 10:34", "link": "/news/story/7002/9665602"}, {"article_id": "9665451", "title": "籃球／東興國小女籃芬蘭4連勝 強勢挺進冠軍賽", "summary": "代表台灣參賽的台中市東興國小女子籃球隊，今天在芬蘭坦培里（Tampere）舉行的第39屆Delfin Basket國際籃...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192066.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-02 10:11", "link": "/news/story/7003/9665451"}, {"article_id": "9665537", "title": "籃球／四星高中生陳卡特花7小時取得護照 代表台灣出征U18直呼圓夢", "summary": "被評為全美四星高中生的台美混血籃球小將陳卡特，將代表台灣征戰U18亞洲盃男籃賽，他透露當初花了7小時車程取得台灣護照，如...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192062.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 10:07", "link": "/news/story/7003/9665537"}, {"article_id": "9665538", "title": "籃球／混血男籃好手陳卡特偶像是KD 愛打2K、自曝天天喝珍奶", "summary": "自曝是珍奶重度成癮者，還是熱血電玩迷，身為今年U18亞洲盃男籃台灣隊的看板人物，台美混血小將陳卡特其實跟同齡大男孩一樣，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192057.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 10:05", "link": "/news/story/700