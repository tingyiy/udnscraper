nail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/17/35525714.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9884018"}, {"article_id": "9885470", "title": "中職／想靠經驗與傳承建隊 台鋼老將卻扛不住恐現釋出潮", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35527985.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9885470"}, {"article_id": "9882340", "title": "史上最恐怖進攻二人組 老詹離隊湖人卻做好與馬刺爭霸準備", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/16/35523385.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/122629/9882340"}, {"article_id": "9881672", "title": "林書豪ESPN球評首秀評價兩極 卻呈現籃球轉播另一種可能", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/16/35522448.jpg&M=1&s=Y&x=0&y=280&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9881672"}]}, {"name": "最新文章", "articles": [{"article_id": "9888084", "title": "MLB／官網直言教士簽下史庫柏機率低 新身價可能超過達比修3倍", "summary": "兩屆塞揚獎強投史庫柏（Tarik Skubal）進入自由球員市場，成為最大咖球員，教士隊加入搶人行列，雙方本周將會碰面；大聯盟官網指出，這場激烈爭奪戰在所難免，目前看來教士搶到史庫柏的機會不高，他更有可能和其他球隊簽約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/19/35531974.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-19 09:30", "link": "/news/story/6999/9888084"}, {"article_id": "9888057", "title": "網球／可怕！前美網冠軍住家遭闖 3人被捕", "summary": "2017年奪下美網女單金盃的美國女將史蒂芬斯（Sloane Stephens），位於洛杉磯的住所驚傳遭侵入，幸運的是沒有財務損失，已有3名男子遭捕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/19/35531929.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-19 09:08", "link": "/news/story/7005/9888057"}, {"article_id": "9888020", "title": "MLB／美聯勝投王格雷重返雙城 兩年5500萬美元隊史最高薪投手", "summary": "今年美聯勝投王格雷（Sonny Gray）確定重返老東家雙城隊，以自由球員身分簽下兩年5500萬美元合約，迎接生涯第15個大聯盟球季。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/19/35531870.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-19 08:49", "link": "/news/story/6999/9888020"}, {"article_id": "9887994", "title": "NBA／馬刺折損重要戰力 哈波髖傷缺陣", "summary": "馬刺隊昨天以93：105敗給活塞隊，12連勝告終不說，先發後衛哈波（Dylan Harper）第四節剩下53.6秒還受傷提前退場，今天球團宣布哈波將缺席明天和快艇隊的比賽，原因是左髖部酸痛。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/19/35531815.jpg&M=1&s=Y&x=0&y=145&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-19 08:33", "link": "/news/story/7002/9887994"}, {"article_id": "9887971", "title": "網球／球王澤瑞夫又陷場外風波 遭網紅前伴侶提告求償違約金", "summary": "剛登上世界球王寶座的德國名將澤瑞夫（Alexander Zverev），本季迎來生涯高峰，不僅奪下生涯前兩座大滿貫金盃，本月更首度站上世界第一，然而就在他於義大利征戰年終總決賽期間，場外卻再起波瀾，遭到前伴侶帕蒂亞（Brenda Patea）在德國提起的訴訟通知。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35486904.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-19 08:16", "link": "/news/story/7005/9887971"}, {"article_id": "9887943", "title": "ATP年終賽／大腿不適仍直落二退梅德維夫 阿爾卡拉斯晉級4強放眼首冠", "summary": "西班牙好手阿爾卡拉斯（Carlos Alcaraz）在都靈舉行的ATP年終賽展現火燙手感，今天以6：2、6：4拍落俄羅斯名將梅德維夫（Daniil Medvedev），儘管次盤初一度因左大腿腿後肌不適申請傷停並纏上繃帶，但隨後同組賽事的結果助攻下，連續兩年挺進年終賽4強，並將跨季室內連勝推進到11場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35338006.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-19 07:42", "link": "/news/story/7005/9887943"}, {"article_id": "9887012", "title": "中職／只投11局還能領百萬月薪 江少慶會否被獅隊戰力外備受關注", "summary": "統一獅江少慶本季僅投11又1/3局、防禦率6.35，月薪約107萬元，是否列入60人保留名單引發關注。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530458.jpg&M=1&s=Y&x=0&y=0&sw=928&sh=619&exp=3600&sl=W&fw=360", "date": "2026-11-19 07:00", "link": "/news/story/122629/9887012"}, {"article_id": "9887379", "title": "MLB右打強棒越來越稀缺 反映在自由球員市場", "summary": "大聯盟右打強棒日益稀缺，2026年僅8人敲逾30轟，創2014年來新低；右打者安打與打席亦創外卡年代最低，自由市場選項有限。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531044.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-19 07:00", "link": "/news/story/122629/9887379"}, {"article_id": "9887448", "title": "射箭／亞洲盃杭州站 中華反曲弓男、女團闖4強拚獎牌", "summary": "2026射箭亞洲盃杭州站，由戴宇軒、黃立承及林育暘組成的中華反曲弓男團，今天在8強戰以6比2射落中國隊，攜手反曲弓女團挺...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531110.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 21:16", "link": "/news/story/7005/9887448"}, {"article_id": "9887446", "title": "UBA／板凳後衛當英雄 北護延長賽驚險退輔大", "summary": "115學年度富邦人壽UBA大專籃球聯賽，公開女一級預賽第一階段進入第二天就有戲劇一仗，上季拿二級亞軍、本季回升一級的台北護大隊史一級首遇上季第八輔仁大學，正規賽戰平，延長賽第二後衛莊宛諭關鍵抄截加上超前罰球，助隊驚險以56：53收下開季首勝，為「保級」注入強心針。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531092.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 21:09", "link": "/news/story/7003/9887446"}, {"article_id": "9887431", "title": "香港羽賽／敗給19歲印尼小將 周天成首輪爆冷出局", "summary": "香港公開賽列男單第5種子的我國「一哥」周天成，今天首輪迎戰世界排名23的印尼19歲小將烏拜迪拉（Mohammad Zaki Ubaidillah），小天意外以19：21、21：7、19：21落馬，首輪出局，爆出小冷門。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531093.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 20:56", "link": "/news/story/7005/9887431"}, {"article_id": "9887369", "title": "棒球／廖韋勛強攻3安猛打 福林國小火力展示奪重光盃隊史第二冠", "summary": "2026年第18屆重光盃全國少棒錦標賽18日進入最終決戰，台北市福林國小冠軍戰投打都有發揮，以7：2擊敗桃園市中平國小，繼2021年後再捧重光盃冠軍，季軍則是本屆「黑馬」新北市大豐國小。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531018.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 20:10", "link": "/news/story/7001/9887369"}, {"article_id": "9887331", "title": "棒球／名譽理事長辜仲諒 肯定棒協、中職全面合作籌組中華隊", "summary": "辜仲諒肯定棒協與中職合作組成中華隊，棒協明年將辦U15全國國中棒球大賽，扎根基層培育新秀，提供年輕選手發展舞臺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530969.jpg&M=1&s=Y&x=0&y=104&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 19:54", "link": "/news/story/7001/9887331"}, {"article_id": "9887213", "title": "擊劍／全國青少年排名賽奪軍刀冠軍 中興擊劍好手黃采蓉獲選亞青國手", "summary": "南投縣立中興國中選手黃采蓉，在115年全國青少年排名賽暨代表隊選拔中，勇奪女子軍刀項目冠軍，取得2027年亞洲青年暨青少年擊劍錦標賽國家代表權，為南投體育寫下亮眼新頁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530832.jpg&M=1&s=Y&x=0&y=0&sw=1162&sh=775&exp=3600&sl=W&fw=360", "date": "2026-11-18 18:41", "link": "/news/story/7005/9887213"}, {"article_id": "9887209", "title": "滑輪溜冰／台灣公開賽相隔7年重返北市 14國1384名選手同場競速", "summary": "2026台灣國際滑輪溜冰公開賽將於11月19日至22日重返台北市大佳河濱運動公園舉行。台北不僅是本屆賽事的舉辦城市，更是2019年首屆國際公開賽的起點。歷經疫情停辦三年及後續賽事的延續，今年再次回到最初舉辦的城市，別具傳承與象徵意義。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530824.jpg&M=1&s=Y&x=0&y=0&sw=969&sh=646&exp=3600&sl=W&fw=360", "date": "2026-11-18 18:38", "link": "/news/story/7005/9887209"}, {"article_id": "9887207", "title": "TPBL／感恩節主場迎敵 夢想家好禮贈球迷", "summary": "福爾摩沙夢想家本週迎來「Thanksgiving Day」主題週，11月21、22及25日於臺中洲際迷你蛋先後迎戰高雄全家海神、新北中信特攻及新竹御嵿攻城獅，球團攜手合作夥伴準備多項互動與回饋好禮，從入場、節間暫停到中場遊戲，三場賽事接力送上感恩回饋，邀請所有「我夢」家人齊聚主場，共度熱鬧的感恩節。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530822.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-18 18:37", "link": "/news/story/7003/9887207"}, {"article_id": "9887026", "title": "日職／改革！明年試行投球計時器不設罰則 為2028洛杉磯奧運停賽3周", "summary": "日本職棒球團老闆會議今天舉行，決定自2027年賽季起試行「投球計時器制度」，不設置罰則，另外為了2028年洛杉磯奧運，將暫停例行賽3周。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530508.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-18 17:19", "link": "/news/story/7001/9887026"}, {"article_id": "9887034", "title": "衝浪／頂尖好手齊聚台東 台灣公開賽最終決賽周日登場", "summary": "2026台灣國際衝浪公開賽自14日起於台東金樽海域展開國際賽事，吸引世界各國頂尖衝浪好手齊聚台東，挑戰世界衝浪聯盟（WSL）INTL 6000巡迴積分賽。隨著賽事進入最後階段，各國選手的晉級競爭日益激烈，今天到22日將迎來賽事最精彩的關鍵對決，並預計於周日舉行最終決賽，角逐年度最終站冠軍榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530471.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 17:14", "link": "/news/story/7005/9887034"}, {"article_id": "9887020", "title": "冬盟／台日韓球員簽名會登場 資格券每張1600元後天中午開賣", "summary": "2026冬季棒球聯盟正式開打，為讓球迷近距離與各隊球員見面，今年規劃4場球員簽名會，邀請台灣山林隊、台灣海洋隊、日職聯隊、韓職聯隊參與，資格券將於20日中午12點起，透過ibon售票系統正式開賣，每張售價1600元，每人每場次限購一張，各場次限量60名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530462.png&M=1&s=Y&x=113&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-18 17:12", "link": "/news/story/7001/9887020"}, {"article_id": "9886808", "title": "NBA／傳奇射手佩賈之子NCAA狂轟46分破69年紀錄！得分甚至超越老爸生涯新高", "summary": "安德烈狂轟46分，率伊利諾大學99：78擊敗杜克，改寫卡麥隆球館69年客隊紀錄，並超越父親NBA單場最高分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530239.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 16:12", "link": "/news/story/7002/9886808"}, {"article_id": "9886845", "title": "NBA／精心策劃？黃蜂主帥關鍵時刻不讓主力上場 球迷怒轟：FBI必須調查", "summary": "湖人隊今天克服18分落後，靠著葛萊姆斯（Quentin Grimes）狂轟47分，在延長賽以118：114擊敗黃蜂隊。不過黃蜂詭異的陣容調度成為賽後焦點，網友們紛紛呼籲FBI介入調查。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530235.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 16:04", "link": "/news/story/7002/9886845"}, {"article_id": "9886721", "title": "NBA／兩次自拋自扣救不了12連勝！溫班亞瑪：是當頭棒喝", "summary": "溫班亞瑪兩度自拋自扣仍難救馬刺，遭活塞逆轉吞敗，12連勝中斷；他坦言這是球隊的現實提醒，教練也承認防守仍待改善。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530023.jpg&M=1&s=Y&x=0&y=0&sw=1142&sh=761&exp=3600&sl=W&fw=360", "date": "2026-11-18 15:54", "link": "/news/story/7002/9886721"}, {"article_id": "9886729", "title": "NBA／傳勇士可能送走巴特勒或格林 美媒建議：交易來戴維斯", "summary": "勇士隊本季受到嚴重傷兵問題，但曾打出8連勝讓球迷看見希望。據ESPN記者史皮爾斯（Marc J. Spears）報導，勇士考慮在交易大限前送走老將巴特勒（Jimmy Butler）或格林（Draymond Green），美國球評柏金斯（Kendrick Perkins）則建議去交易巫師隊明星長人戴維斯（Anthony Davis）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530020.jpg&M=1&s=Y&x=0&y=0&sw=1179&sh=786&exp=3600&sl=W&fw=360", "date": "2026-11-18 15:16", "link": "/news/story/7002/9886729"}, {"article_id": "9886714", "title": "NBA／葛萊姆斯10記三分球砍生涯新高47分 湖人OT逆轉黃蜂收9連勝", "summary": "近期拉出8連勝的聯盟戰績龍頭湖人隊，在今天作客黃蜂隊主場，在兩隊都有主力缺陣的情況下，黃蜂今天雖然整場比賽一路領先，但湖人葛萊姆斯（Quentin Grimes）手感發燙狂轟47分，包括在正規賽結束前投進追平比數三分球，還在延長賽有關鍵防守表現，幫助湖人以118：114逆轉勝出，收下9連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529996.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 15:08", "link": "/news/story/7002/9886714"}]}, {"name": "棒球", "articles": [{"article_id": "9887369", "title": "棒球／廖韋勛強攻3安猛打 福林國小火力展示奪重光盃隊史第二冠", "date": "2026-11-18 20:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531018.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9887369"}, {"article_id": "9887331", "title": "棒球／名譽理事長辜仲諒 肯定棒協、中職全面合作籌組中華隊", "date": "2026-11-18 19:54", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530969.jpg&M=1&s=Y&x=0&y=104&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9887331"}, {"article_id": "9887026", "title": "日職／改革！明年試行投球計時器不設罰則 為2028洛杉磯奧運停賽3周", "date": "2026-11-18 17:19", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530508.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9887026"}, {"article_id": "9887020", "title": "冬盟／台日韓球員簽名會登場 資格券每張1600元後天中午開賣", "date": "2026-11-18 17:12", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530462.png&M=1&s=Y&x=113&y=0&sw=1080&sh=720&exp=