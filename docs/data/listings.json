rticle_id": "9617902", "title": "中職／是該與時俱進了！盡快擬定「旅外、混血外籍球員」加盟條款", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/09/35120867.jpg&M=1&s=Y&x=0&y=38&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9617902"}, {"article_id": "9617851", "title": "世足攻略／重演上屆4強對決摩洛哥要復仇 仍看好高盧雄雞法國1球小勝", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/09/35120839.jpg&M=1&s=Y&x=0&y=80&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9617851"}, {"article_id": "9615927", "title": "阿根廷如何用13分鐘變出魔法？原因是教頭補水時灌輸的一句話", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117825.jpg&M=1&s=Y&x=48&y=0&sw=1214&sh=809&exp=3600&w=300", "link": "/news/story/122629/9615927"}, {"article_id": "9615475", "title": "塞爾進階數據已達名人堂安全門檻 堪稱浴火重生的最佳典範", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117433.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9615475"}]}, {"name": "最新文章", "articles": [{"article_id": "9619353", "title": "NBA／布朗森總冠軍賽戰袍拍出102.4萬美元天價 刷新尼克隊史與個人收藏紀錄", "summary": "紐約尼克當家控衛布朗森（Jalen Brunson）在2026年總冠軍賽首戰所穿的球衣戰袍，近日在蘇富比（Sotheby's）拍賣會歷經70次競標後，最終以102.4萬美元成交，不僅創下布朗森相關收藏品歷來最高成交紀錄，也成為紐約尼克隊史所有收藏品中成交金額最高的一件。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122724.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 10:29", "link": "/news/story/7002/9619353"}, {"article_id": "9619324", "title": "NBA／湖人不只持續追求庫明加 傳有興趣網羅籃網側翼棄將", "summary": "洛杉磯湖人在持續尋求以適合價碼簽下庫明加（Jonathan Kuminga）的同時，據傳也將目光投向另一名今夏自由球員市場的重要側翼戰力。根據報導，湖人近期一直密切關注、並且對被籃網放棄的威廉斯（Ziaire Williams）展現濃厚興趣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122693.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-10 10:14", "link": "/news/story/7002/9619324"}, {"article_id": "9619281", "title": "NBA／克拉克森1年底薪續約 尼克維持奪冠陣容避免薪資爆衝", "summary": "今年成為自由球員的34歲後衛克拉克森（Jordan Clarkson），成為史上首位菲律賓裔奪下NBA總冠軍的球員，近期他已經確定與紐約尼克完成續約。根據報導，雙方將會簽下一年390萬美元的老將底薪合約", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122658.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-10 10:11", "link": "/news/story/7002/9619281"}, {"article_id": "9619283", "title": "NBA／勇士1年約續留25歲奈及利亞中鋒 詹皇做決定前保留空間", "summary": "據ESPN報導，勇士隊與25歲奈及利亞中鋒貝西（Charles Bassey）達成協議，簽下1年合約續留灣區。勇士正式球員名單達到11人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122660.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 10:08", "link": "/news/story/7002/9619283"}, {"article_id": "9619292", "title": "MLB／鈴木誠也陽春砲+二壘打卻因抽筋退場 「要去吃100根香蕉」", "summary": "小熊隊今天以2：3不敵金鶯隊，分數全數都由日籍好手鈴木誠也打下，一支陽春砲、一支一分打點二壘打，但也在這支二壘打後因為小腿抽筋退場，賽後對此回應：「我要去吃100根香蕉。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122670.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 09:58", "link": "/news/story/6999/9619292"}, {"article_id": "9619252", "title": "MLB／李灝宇4支1中斷安打荒 強勁擊球遭飛撲美技沒收少1安", "summary": "台灣好手李灝宇7月3日敲出個人第4轟後陷入安打荒，時隔一周終於再出現安打，今天面對運動家隊4打數敲1安打，老虎隊終場以4：1贏球，取得5連勝、3連戰清盤運動家。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122573.jpg&M=1&s=Y&x=81&y=0&sw=637&sh=425&exp=3600&sl=W&fw=360", "date": "2026-07-10 09:34", "link": "/news/story/6999/9619252"}, {"article_id": "9619176", "title": "世足賽／法國連3屆闖進4強 主帥德尚：姆巴佩絕不動搖", "summary": "法國今天以2比0踢走摩洛哥，主帥德尚（Didier Deschamps）賽後盛讚主將姆巴佩（Kylian Mbappe）...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122515.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 09:05", "link": "/news/story/123107/9619176"}, {"article_id": "9619146", "title": "溫網／混雙冠軍出爐！薩爾瓦多史上首次有選手捧起金盃", "summary": "拉脫維亞女將奧斯塔朋科和薩爾瓦多選手阿雷瓦洛今天失首盤後急起直追，終場4比6、7比5、6比2擊敗澳洲組合韓特和波爾曼斯，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122499.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 09:00", "link": "/news/story/124935/9619146"}, {"article_id": "9619139", "title": "世足賽／與摩洛哥球迷在巴黎和平相處 法國人：我們展現良好素養", "summary": "「高盧雄雞」法國今晚在世界盃足球賽擊敗「北非雄獅」摩洛哥晉級4強，巴黎球迷深信金盃在望。在街頭，播映賽事的小酒館和咖啡館...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122481.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 08:55", "link": "/news/story/123107/9619139"}, {"article_id": "9619190", "title": "MLB／哈波再戰全壘打大賽拚史上第一人紀錄 「我不是來玩的」", "summary": "33歲資深重砲哈波（Bryce Harper），2018年身披國民隊球衣在國民球場稱霸全壘打大賽，圓夢的他，當時以為這就是最後一次參賽；今年明星賽在費城市民銀行球場登場，哈波再燃參戰念頭，今天透過IG親自宣布參賽：「打啊！何不呢！」他將挑戰成為兩度為地主留下全壘打大賽冠軍史上第一人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122477.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 08:46", "link": "/news/story/6999/9619190"}, {"article_id": "9619135", "title": "MLB／道奇敲定日期連2年訪問白宮 川普：歡迎回來", "summary": "美國媒體報導，白宮發言人證實，美國職棒去年的冠軍隊洛杉磯道奇已經敲定日期，預計在23日再訪白宮，美國總統川普很高興他們「...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122462.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 08:42", "link": "/news/story/6999/9619135"}, {"article_id": "9619155", "title": "NBA／承認與詹姆斯在勇士連線很有吸引力 柯瑞：以前根本不敢想", "summary": "詹姆斯（LeBron James）在日前宣佈離開湖人後動向成為全聯盟焦點，其中勇士管理階層正積極展開追求，期盼能促成詹姆斯與當家球星柯瑞（Stephen Curry）這對昔日宿敵的夢幻聯手。對此，正在內華達州參加名人高爾夫球賽的柯瑞坦言，這樣的晚期生涯合作確實充滿吸引力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122408.jpg&M=1&s=Y&x=0&y=32&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 08:08", "link": "/news/story/7002/9619155"}, {"article_id": "9618995", "title": "離開我你會不會好一點 「喬治定律」成球隊重建或重組新解方", "summary": "評價一名NBA球星，通常會看得分、明星賽、年度隊伍，甚至總冠軍戒指，但如果要討論近十年「最有交易價值」的球員，喬治（Paul George）或許會是一個令人意外，卻相當合理的答案。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122232.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-10 07:57", "link": "/news/story/122629/9618995"}, {"article_id": "9619140", "title": "世足賽／姆巴佩進球前法國疑似手球未吹 摩洛哥主帥：球員因此停頓", "summary": "2026世足賽8強淘汰賽首戰今天上演驚心動魄一戰，法國靠著下半場姆巴佩（Kylian Mbappe） 一射一傳建功，以2：0連續兩屆淘汰摩洛哥，不過賽後摩洛哥總教練沃阿比（Mohamed Wahbi）也透露，在姆巴佩那顆進球前法國明顯有手球嫌疑，導致摩洛哥許多球員因目擊手球而本能性地停下動作，最終因此遭到重擊，成為全場比賽的轉捩點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122400.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 07:48", "link": "/news/story/123107/9619140"}, {"article_id": "9619118", "title": "籃球／第六屆興傳盃公益邀請賽圓滿落幕 全台14所EMBA學校同場競技", "summary": "由國立中興大學EMBA主辦、中興大學EMBA黑豹籃球社規劃執行的「第六屆興傳盃公益籃球邀請賽」日前在中興大學體育館圓滿落幕，本屆賽事共吸引全台14所EMBA學校、近400名EMBA菁英披上戰袍，組成20支重裝勁旅同場較勁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122374.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 07:17", "link": "/news/story/7003/9619118"}, {"article_id": "9619117", "title": "排球／逆轉歐陸強權土耳其 中華女排奪世界中學錦標賽冠軍", "summary": "中華女排昨天在「2026年世界中學生排球錦標賽」冠軍戰中遭遇強敵土耳其，在克服開局落後劣勢下，最終以3：1（22：25、25：19、25：19、25：23） 擊敗強敵土耳其，寫下女排隊史首度以國家隊型式在ISF奪冠的歷史新紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122370.jpg&M=1&s=Y&x=0&y=0&sw=1078&sh=719&exp=3600&sl=W&fw=360", "date": "2026-07-10 07:10", "link": "/news/story/7005/9619117"}, {"article_id": "9617902", "title": "中職／是該與時俱進了！盡快擬定「旅外、混血外籍球員」加盟條款", "summary": "中職應優化「旅外、混血外籍球員」加盟辦法，以吸引更多台美混血球員參與。近日費爾柴德成為自由球員，引發多隊興趣。中職需修訂現行條款，簡化這類球員的加盟流程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/09/35120867.jpg&M=1&s=Y&x=0&y=38&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 07:00", "link": "/news/story/122629/9617902"}, {"article_id": "9618373", "title": "NBA交易論輸贏：熱火、76人有爭冠本錢 湖人、火箭不知所云", "summary": "NBA自由球員市場即將開啟，各隊積極調整陣容。熱門爭冠隊伍76人和熱火尋求強化，而灰狼和塞爾蒂克則努力解套薪資壓力。與此同時，黃蜂和公鹿進入重建階段，湖人和火箭的未來卻充滿疑問。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/09/35121573.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 07:00", "link": "/news/story/122629/9618373"}, {"article_id": "9619108", "title": "世足賽／連三屆率隊挺進4強 姆巴佩踝傷被換下場後稱無大礙", "summary": "「高盧雄雞」法國今天在世足賽首場8強賽面對「北非鐵騎」摩洛哥，當家球星姆巴佩（Kylian Mbappe）也再度展現個人價值，在上半場錯失12碼罰球的情況下，仍在第60分鐘率先攻破摩洛哥球門，踢進個人本屆賽事第8顆、世足賽生涯第20顆進球，儘管隨後他因腳踝被撞傷遭換下場，但在球隊取得4強門票後他也直言傷勢並無大礙。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122362.jpg&M=1&s=Y&x=0&y=11&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 06:53", "link": "/news/story/123107/9619108"}, {"article_id": "9619101", "title": "世足賽／英格蘭寬沙紅牌禁賽沒暫緩還追加處分 主帥怒轟FIFA沒標準", "summary": "「三獅軍團」英格蘭雖然在世足賽16強賽以3：2驚險擊敗墨西哥、挺進8強，但陣中後防新星寬沙（Jarell Quansah）在該本比賽吞下紅牌後，今天也遭到國際足總（FIFA）追加處分將禁賽2場，讓英格蘭後防戰力拉響警報。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122355.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 06:21", "link": "/news/story/123107/9619101"}, {"article_id": "9619029", "title": "溫網／捷克女將諾斯科娃闖女單決賽 將與同胞穆霍娃爭后冠", "summary": "溫布頓網球錦標賽女單準決賽今天登場，捷克選手諾斯科娃以兩個6比4擊敗對手，生涯首度挺進溫網決賽，將與稍早擊敗美國好手高夫...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122356.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 06:20", "link": "/news/story/124935/9619029"}, {"article_id": "9619078", "title": "世足賽／姆巴佩第8顆進球再追平梅西 法國2：0連兩屆淘汰摩洛哥", "summary": "2026世足賽8強賽今天點燃戰火，並由奪冠熱門法國與北非鐵騎摩洛哥上演上屆4強對戰戲碼，儘管上半場法國姆巴佩（Kylian Mbappe）錯過了一次12碼罰球操刀機會，但下半場他與登貝萊（Ousmane Dembélé）在短短6分鐘內連進兩球，幫助法國最終以2：0連續兩屆淘汰摩洛哥，挺進到4強賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122331.jpg&M=1&s=Y&x=117&y=142&sw=1058&sh=705&exp=3600&sl=W&fw=360", "date": "2026-07-10 06:04", "link": "/news/story/123107/9619078"}, {"article_id": "9619060", "title": "世足賽／直言挪威奪冠機率極低 哈蘭德慫恿記者給英格蘭施壓", "summary": "2026世足賽即將在邁阿密迎來震撼人心的8強「英挪大戰」，首度率領挪威闖進世足8強的「神鋒」哈蘭德（Erling Haaland），在賽前記者會上大玩心理戰，不僅直言挪威的奪冠機率「依舊非常低」，更笑稱媒體應該把所有的施壓焦點，都放在奪冠熱門英格蘭身上。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122316.jpg&M=1&s=Y&x=0&y=30&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-10 05:57", "link": "/news/story/123107/9619060"}, {"article_id": "9618876", "title": "溫網／瓦解高芙賽末點 穆霍娃逆轉搶下女單決賽門票", "summary": "同樣是第一次打進溫布頓最終4強，列第7種子的美國名將高芙（Coco Gauff）和排第10種子的捷克穆霍娃（Karolina Muchova）今天上演2小時右35分鐘的激戰，穆霍娃在瓦解高芙賽末點下逆轉勝，最終以6：2、1：6、7：6（12：10）搶下決賽門票，有機會挑戰生涯第一座大滿貫金盃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/09/35121946.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-09 23:30", "link": "/news/story/124935/9618876"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9619078", "title": "世足賽／姆巴佩第8顆進球再追平梅西 法國2：0連兩屆淘汰摩洛哥", "date": "2026-07-10 06:04", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122331.jpg&M=1&s=Y&x=117&y=142&sw=1058&sh=705&exp=3600&w=300", "link": "/news/story/123107/9619078"}, {"article_id": "9619140", "title": "世足賽／姆巴佩進球前法國疑似手球未吹 摩洛哥主帥：球員因此停頓", "date": "2026-07-10 07:48", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122400.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9619140"}, {"article_id": "9619108", "title": "世足賽／連三屆率隊挺進4強 姆巴佩踝傷被換下場後稱無大礙", "date": "2026-07-10 06:53", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122362.jpg&M=1&s=Y&x=0&y=11&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story