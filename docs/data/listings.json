hoto.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489427.jpg&M=1&s=Y&x=0&y=34&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9859916"}, {"article_id": "9860320", "title": "約柯奇脫下「外星人」外衣 金塊是否已從奪冠列車下車？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35490141.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9860320"}, {"article_id": "9857431", "title": "中職／誰能頂替曾峻岳及林凱威 兩人如旅外將改變終結者版圖", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35487182.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&w=300", "link": "/news/story/122629/9857431"}]}, {"name": "最新文章", "articles": [{"article_id": "9867165", "title": "NBA／杜蘭特重返鳳凰城直言沒特殊感覺 布魯克斯贏球還補刀暗諷", "summary": "火箭球星杜蘭特（Kevin Durant）日前重返鳳凰城，面對昔日東家，雖然繳出21分、10籃板的雙十表現，仍無法幫助球隊帶走勝利。賽後談及回到這個熟悉的球場，杜蘭特坦言這只是一場普通的比賽，沒有太多特殊感受，但他也強調，鳳凰城至今仍是自己NBA生涯最喜歡居住的城市。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35500433.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 16:54", "link": "/news/story/7002/9867165"}, {"article_id": "9867091", "title": "MLB／團隊打擊率排名第3仍被炒魷魚 貝茲直言道奇逼他離開", "summary": "道奇隊今年挑戰世界大賽3連霸失利，儘管例行賽團隊打擊率2成57在大聯盟排名第3， 只落後在世界大賽爭霸的釀酒人、光芒隊（都是2成58），球團高層還是決定和42歲打擊教練貝茲（Aaron Bates）解除賓主關係，他說：「其實是道奇逼我離職。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35500413.jpg&M=1&s=Y&x=0&y=223&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 16:11", "link": "/news/story/6999/9867091"}, {"article_id": "9867041", "title": "定向越野／2026亞洲暨亞洲青年及青少年錦標賽 我首日接力奪銅", "summary": "2026亞洲定向越野錦標賽暨亞洲青年及青少年定向越野錦標賽，今天 （9日）在中國桂林揭開序幕，進行首日中距離接力賽，中華隊在16歲男子組跑出佳績，來自金門的卓佳賞與卓佳瑨兄弟檔與台中小將洪誠志，聯手奪得銅牌，為中華隊在獎牌榜開張。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35500233.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 15:49", "link": "/news/story/7005/9867041"}, {"article_id": "9866865", "title": "棒球／費爾柴德結婚一周年甜蜜放閃！兩人曬婚紗照羨煞網友", "summary": "費爾柴德與妻子結婚一周年甜蜜放閃，接連曬婚紗照及婚禮畫面，吸引逾2.5萬人按讚，網友紛紛送上祝福並熱烈討論。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499983.jpg&M=1&s=Y&x=0&y=268&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 15:00", "link": "/news/story/7001/9866865"}, {"article_id": "9866925", "title": "NBA／撕破臉？ 勇士清空波爾辛吉斯置物櫃", "summary": "本季因怪病沒有任何出賽紀錄的波爾辛吉斯（Kristaps Porzingis），日前宣布暫離球場休養身體，勇士隨隊記者強森（Dalton Johnson）透露，勇士球團已經快速清空波爾辛吉斯的置物櫃，看來彼此的緣分已盡。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35500094.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 14:56", "link": "/news/story/7002/9866925"}, {"article_id": "9866776", "title": "NBA／「這種爛出手根本是Luka」 里夫斯飆進神仙球不忘嘲諷唐西奇", "summary": "唐西奇輪休，里夫斯轟43分率湖人121比116擊敗活塞，賽後自嘲高難度後撤步是「Luka會投的爛出手」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499855.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 14:20", "link": "/news/story/7002/9866776"}, {"article_id": "9866808", "title": "日職／火腿取消上壘刻意打招呼 新庄剛志：也沒必要對裁判拍馬屁", "summary": "日本火腿隊監督新庄剛志已經決定，將從明年球季開始取消球員在比賽中向對手問候的做法，日本媒體Sponichi Annex指出，新庄認為這些問候，就算對裁判致意也毫無必要，看起來就像在阿諛奉承。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499882.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 14:17", "link": "/news/story/7001/9866808"}, {"article_id": "9866742", "title": "NBA／佛雷格助攻數創生涯新高 獨行俠主場痛宰籃網37分", "summary": "獨行俠少主佛雷格（Cooper Flagg）攻下25分還送出生涯新高12次助攻，個人連續第3場雙十演出，加上厄文（Kyrie Irving）貢獻21分，全隊打出本季最佳進攻效率，在主場以130比93狂勝籃網37分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499780.jpg&M=1&s=Y&x=49&y=0&sw=1175&sh=784&exp=3600&sl=W&fw=360", "date": "2026-11-09 13:51", "link": "/news/story/7002/9866742"}, {"article_id": "9866699", "title": "中職／遭強襲球擊中臉部後復出 莊昕諺吐心聲：沒想過那麼快就可以出賽", "summary": "樂天桃猿莊昕諺遭強襲球擊中臉部、手術休養近2個月後重返投手丘，坦言沒想過這麼快復出，仍需克服恐懼並備戰明季。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499708.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-09 13:42", "link": "/news/story/7001/9866699"}, {"article_id": "9866692", "title": "NBA／湯普森轟7記外線、希臘怪物攻29分 熱火賞國王主場5連敗", "summary": "熱火隊新成員今天一起發威，「希臘怪物」安戴托昆波（Giannis Antetokounmpo）攻下29分、14籃板，湯普森（Klay Thompson）貢獻7記三分球在內的23分，聯手助隊頂住國王隊反撲，以114：108奪勝，也賞給國王開季10場比賽的第9敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499831.jpg&M=1&s=Y&x=23&y=17&sw=1254&sh=836&exp=3600&sl=W&fw=360", "date": "2026-11-09 13:24", "link": "/news/story/7002/9866692"}, {"article_id": "9866655", "title": "NBA／勇士拚8連勝添變數 防守悍將理查德拇指韌帶撕裂", "summary": "勇士7連勝添變數，防守悍將理查德左拇指尺側副韌帶撕裂，確定缺席明日對鵜鶘之戰；後續治療方式與缺陣時間仍待評估。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499657.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 13:21", "link": "/news/story/7002/9866655"}, {"article_id": "9866571", "title": "NBA／豪宅遭闖入男子被逮稱「我是他兒子」 詹姆斯首度回應", "summary": "詹姆斯洛杉磯住家遭男子疑似闖入，警方逮捕涉跟蹤嫌犯；詹姆斯首度回應，表示家人平安，案情仍調查中，並照常出賽率76人擊敗公牛。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499501.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 13:05", "link": "/news/story/7002/9866571"}, {"article_id": "9866598", "title": "美式足球／聖母大學扳倒龍頭 NCAA季後賽靠評選決定？", "summary": "美國大學NCAA美式足球爆出冷門，聖母大學日前以31比24擊敗排名第1的邁阿密大學，也讓一套不同於職業運動的爭冠制度再受關注。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499535.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&sl=W&fw=360", "date": "2026-11-09 13:04", "link": "/news/story/7005/9866598"}, {"article_id": "9866576", "title": "中職／猿隊和梁家榮簽下3年合約 包含激勵獎金總值最高2820萬元", "summary": "樂天桃猿隊今天正式宣布與隊長梁家榮達成共識，簽下3年合約，包含激勵獎金在內總值最高2820萬元；猿隊表示，這份複數年約是球團肯定這位在球隊一路成長的選手，也代表梁家榮將繼續以隊長身分「做伙」朝下一座冠軍前進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499508.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-09 12:24", "link": "/news/story/7001/9866576"}, {"article_id": "9866495", "title": "中職／早已聽聞葉總有意卸下兵符 郭天信私心不想讓他走：我會難過", "summary": "味全龍隊今年風光奪冠，總教練葉君璋卻早已動了不論成敗交出兵符的念頭，郭天信早在今年初就有耳聞，看著葉總一路以來承擔的壓力、這段時間的辛苦，讓郭天信感嘆說出2023年這座總冠軍，對當時還不夠成熟的龍隊來說，似乎來得有點太早了。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499336.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-09 12:11", "link": "/news/story/7001/9866495"}, {"article_id": "9866519", "title": "NBA／綠衫軍雙星領軍3連勝 公鹿10戰9敗創33年最慘開局", "summary": "塞爾蒂克今天作客密爾瓦基，儘管開賽一度陷入14分落後，但喬治（Paul George）和泰托姆聯手帶動一波18比0的猛烈攻勢，迅速扭轉戰局，最終塞爾蒂克以117比97大勝公鹿20分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499436.jpg&M=1&s=Y&x=14&y=0&sw=1266&sh=844&exp=3600&sl=W&fw=360", "date": "2026-11-09 12:06", "link": "/news/story/7002/9866519"}, {"article_id": "9866490", "title": "亞冠賽／日韓擁「40轟級」主砲 中華隊最多轟郭天信記得大谷說過1句話", "summary": "中華隊28人名單正式成形，將在明天啟程前往日本東京參戰亞冠賽，本屆陣容缺乏砲手，今年球季敲出9轟的郭天信，已是陣中最多轟打者，他自己也有注意到這件事，但強調短期比賽什麼事都很難說，既然參賽了，就是要去和對手輸贏，謹記大谷翔平一席「不要仰望對手」金句。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499330.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 11:50", "link": "/news/story/7001/9866490"}, {"article_id": "9866468", "title": "MLB／官網盛讚37歲塞爾「歷史級出色」 不必擔心他很快油盡燈枯", "summary": "勇士隊37歲左投塞爾（Chris Sale）明年將迎接生涯第17季，還差1勝就可成為第3位達到160勝的現役投手，大聯盟官網指出，勇士2023年底和紅襪隊完成一對一交易時，或許算不上豪賭，但確實存在一定風險，然而塞爾在勇士3個球季的表現堪稱「歷史級出色」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499316.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 11:39", "link": "/news/story/6999/9866468"}, {"article_id": "9866402", "title": "網球／美網後4站拿3冠 阿爾卡拉斯巴黎名人賽登頂：傷後表現最好一周", "summary": "今年美網回到賽爾的西班牙「小蠻牛」阿爾卡拉斯（Carlos Alcaraz），尋求連霸雖失利，但接續4站就打下3座金盃，包括巴黎名人賽以7：6（7：5）、7：5「報仇」拍下美國好手謝爾頓（Ben Shelton），讓他直呼打出可能是腕傷回歸後的「最好一周」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499239.jpg&M=1&s=Y&x=55&y=26&sw=1225&sh=816&exp=3600&sl=W&fw=360", "date": "2026-11-09 11:25", "link": "/news/story/7005/9866402"}, {"article_id": "9866352", "title": "MLB／555轟名將曼尼想當打擊教練 重返道奇執教不是夢？", "summary": "555轟名將曼尼有意尋求大聯盟打擊教練職務，也不排斥從小聯盟起步；道奇2027年打擊教練出缺，成為關注人選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499141.jpg&M=1&s=Y&x=0&y=24&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 11:25", "link": "/news/story/6999/9866352"}, {"article_id": "9866364", "title": "NBA／多森姆聯手小鮑爾助灰狼4連勝 爵士低迷苦吞8連敗", "summary": "少了當家球星愛德華（Anthony Edwards），灰狼依舊展現強大競爭力。今天主場迎戰爵士，靠著多森姆（Ayo Dosunmu）攻下26分，以及小鮑爾（LaMelo Ball）拿下24分5助攻，最終以115：100輕騎過關，收下近期4連勝，戰績提升至8勝3敗。反觀爵士則苦吞8連敗，排名西區墊底。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499173.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 11:21", "link": "/news/story/7002/9866364"}, {"article_id": "9866325", "title": "亞冠賽／官網28人名單不見張誠恩卻有鄭澔為誤植 中華隊已請日方更正", "summary": "亞冠賽中華隊經過兩場熱身賽磨刀後，昨天公布28人正選名單，然而官方網站出現的選手名單有落差，不見張誠恩、多了鄭澔，中華隊對此已請日方盡快協助更正，仍以昨天公布的選手名單為主。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499087.jpg&M=1&s=Y&x=0&y=55&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 11:05", "link": "/news/story/7001/9866325"}, {"article_id": "9866306", "title": "NBA／哈利伯頓傷癒復出又倒下 溜馬教頭透露復原進度", "summary": "溜馬當家球星哈利伯頓（Tyrese Haliburton）本季好不容易從阿基里斯腱重傷中復出，卻又因左腿腿後肌拉傷高掛免戰牌，至今已連續缺席6場比賽。不過，總教練卡萊爾（Rick Carlisle）近日透露，哈利伯頓的復健情況相當正面，目前正接受包括高壓氧艙在內的專業治療，球隊也對他能在不久後重返賽場抱持樂觀態度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499067.jpg&M=1&s=Y&x=0&y=76&sw=1174&sh=783&exp=3600&sl=W&fw=360", "date": "2026-11-09 11:01", "link": "/news/story/7002/9866306"}, {"article_id": "9866285", "title": "NBA／交易後首度對決綠衫軍 布朗被問泰托姆淡回：「沒什麼好說」", "summary": "從塞爾蒂克隊被交易到76人隊的布朗（Jaylen Brown），台灣時間周三將首度面對前隊友，他表示不確定是否會有特別情緒，但也強調沒興趣和「綠衫軍」球星泰托姆（Jayson Tatum）重修舊好，指兩人「沒什麼好說」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499049.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-09 10:53", "link": "/news/story/7002/9866285"}]}, {"name": "棒球", "articles": [{"article_id": "9866495", "title": "中職／早已聽聞葉總有意卸下兵符 郭天信私心不想讓他走：我會難過", "date": "2026-11-09 12:11", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499336.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9866495"}, {"article_id": "9866699", "title": "中職／遭強襲球擊中臉部後復出 莊昕諺吐心聲：沒想過那麼快就可以出賽", "date": "2026-11-09 13:42", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499708.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9866699"}, {"article_id": "9866490", "title": "亞冠賽／日韓擁「40轟級」主砲 中華隊最多轟郭天信記得大谷說過1句話", "date": "2026-11-09 11:50", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499330.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9866490"}, {"article_id": "9866865", "title": "棒球／費爾柴德結婚一周年甜蜜放閃！兩人曬婚紗照羨煞網友", "date": "2026-11-09 15:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499983.jpg&M=1&s=Y&x=0&y=268&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9866865"}, {"article_id": "9866808", "title": "日職／火腿取消上壘刻意打招呼 新庄剛志：也沒必要對裁判拍馬屁", "date": "2026-11-09 14:17", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/09/35499882.jpg&M=1&s=Y&x=0&y=0&sw=1280