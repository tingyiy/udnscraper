win now不成得要顧養成了", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35370003.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9781613"}]}, {"name": "最新文章", "articles": [{"article_id": "9794365", "title": "中職／林佳緯3安擊敗悍將進季後賽名單 險失隊友首勝球", "summary": "中職統一獅隊外野手林佳緯用單場3安幫助球隊以6比1擊敗富邦悍將隊，成為總教練林岳平口中的季後賽必帶人選，但林佳緯賽後不小...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389362.jpg&M=1&s=Y&x=0&y=16&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 21:35", "link": "/news/story/7001/9794365"}, {"article_id": "9794367", "title": "籃球／U19籃球聯盟 桌球國手搖籃 松山家商廣收11名高一生聯賽練功", "summary": "福康文教基金會主辦的U19籃球聯盟2026-27年賽季，4日進行的U19第2組迎來新同學松山家商，首戰雖以31：52不敵引爆酋長隊（Chief），磨練多達11名高一生才是他們今年的目標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389358.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 21:32", "link": "/news/story/7003/9794367"}, {"article_id": "9794362", "title": "中職／葉君璋對威克消失的全壘打有感 不可能的事就是發生了", "summary": "樂天桃猿隊今天在桃園主場以4：9不敵味全龍隊，2局下洋砲威克原本3分砲改判二壘打，原本應該領先3分的局面只剩1分，龍隊總教練葉君璋賽後談到這個罕見情況，認為確實對比賽勝負影響很大。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389351.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 21:28", "link": "/news/story/7001/9794362"}, {"article_id": "9794333", "title": "中職／龍準備和兄弟、獅勝隊爭霸 葉君璋：我們是全年第1球隊", "summary": "味全龍隊今天在桃園球場以9：4擊敗樂天桃猿隊，結束本季120場例行賽，下次出賽就是17日在台北大巨蛋進行的總冠軍賽首戰，對手是中信兄弟、統一獅隊在季後賽首輪勝隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389292.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-04 21:09", "link": "/news/story/7001/9794333"}, {"article_id": "9794302", "title": "中職／從上半季墊底殺回下半季冠軍 平野惠一向全球象迷說抱歉與恭喜", "summary": "中信兄弟隊谷底反彈，揮別打得一塌糊塗的上半季，在下半季奪還季冠軍，挺進季後賽。總教練平野惠一喊話今晚享受，明天開始還有必須要做的事，「就是我們要拿回台灣第一！」重用雙箭頭張仁瑋、張士綸，成為兄弟下半季突圍關鍵之一，兩人人氣也水漲船高，讓隊長王威晨都吃味，開玩笑說：「繞場時發現都是張士綸和張仁瑋的毛巾。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389238.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 20:52", "link": "/news/story/7001/9794302"}, {"article_id": "9794284", "title": "中職／猿打到第7局就無緣季後賽 龍單季67勝隊史新高", "summary": "樂天桃猿隊爭取季後賽門票的最後希望，今天在桃園球場對味全龍隊之戰打到第7局，正式宣告破滅，同時間中信兄弟隊在台中洲際球場以12：1大勝台鋼雄鷹隊，搶到下半季冠軍，猿隊確定無法連兩年晉級總冠軍賽，最終在11645名觀眾面前以4：9不敵龍隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389202.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 20:40", "link": "/news/story/7001/9794284"}, {"article_id": "9794267", "title": "中職／悍將連7季勝率不到5成 兩天內換賽道從爭季後賽落入榜眼決定戰", "summary": "富邦悍將隊季末頹勢止不住，今天再以1：6輸給統一獅隊，確定連續7季勝率不到5成，昨天剛在季後賽之爭確定出局，明天與樂天桃猿隊之戰已經變成榜眼決定戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389176.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 20:16", "link": "/news/story/7001/9794267"}, {"article_id": "9794249", "title": "U18女籃／中華隊只打半場好球不敵日本 混血小將成亮點", "summary": "U18亞青女籃賽今天在馬來西亞點燃戰火，由「錢姐」錢薇娟領軍的中華隊，首戰面對強敵日本隊，上半場還握有2分領先，但下半場進攻當機，合計只拿21分，反觀日本兩節狂轟51分，終場以83：55帶走勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389161.jpg&M=1&s=Y&x=0&y=242&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 20:05", "link": "/news/story/7003/9794249"}, {"article_id": "9794201", "title": "中職／兄弟豪奪第21座季冠軍！季後賽戲碼與主場配置全數底定", "summary": "中信兄弟隊今天以12：1擊敗台鋼雄鷹隊，下半季封王魔術數字歸零，收下隊史第21座季冠軍，也讓今年3張季後賽門票、兩輪對戰戲碼、主客場配置就此底定。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389178.jpg&M=1&s=Y&x=0&y=0&sw=1165&sh=777&exp=3600&sl=W&fw=360", "date": "2026-10-04 19:47", "link": "/news/story/7001/9794201"}, {"article_id": "9794188", "title": "中職／藍海升級！悍將60場主場破68萬人進場 新莊13場破萬狂刷紀錄", "summary": "富邦悍將隊打完本季最後一場主場戰役，60場總計68萬4434人進場，寫下隊史新高，場均人數成長7.08%，新莊棒球場單季13場破萬，藍海盛況年年升級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389095.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-04 19:25", "link": "/news/story/7001/9794188"}, {"article_id": "9794165", "title": "亞運／名古屋亞運正式閉幕 交棒下屆主辦城市多哈 「2030見」", "summary": "名古屋亞運今天晚間進行閉幕典禮，正式將聖火火炬交給下一屆舉辦城市卡達多哈，將是多哈2006年再次舉辦亞運，今天主辦方在交接影片最後也打上「see you in 2030」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389049.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:50", "link": "/news/story/124981/9794165"}, {"article_id": "9794161", "title": "中職／小白球竟鑽進全壘打牆縫隙 威克罕見「3分砲」改判二壘打", "summary": "樂天桃猿隊今天在桃園球場對味全龍隊之戰，2局下出現罕見場面，猿隊2出局攻占一、二壘，洋砲威克從曹祐齊的手中揮出左外野方向深遠飛球，第一時間判定全壘打，後來檢視比賽畫面，小白球竟然剛好夾在全壘打牆、廣告看板之間的縫隙，根據場地規則改判二壘打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389034.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:45", "link": "/news/story/7001/9794161"}, {"article_id": "9794145", "title": "NBA／19歲佛雷格展現領袖氣質 獨行俠拚季後賽需要「老少配」", "summary": "這位即將迎接生涯第2個賽季的獨行俠少主佛雷格（Cooper Flagg），不只在場上被視為球隊未來領袖，場下與隊友、工作人員互動時，也逐漸展現自己在組織內部的影響力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389020.jpg&M=1&s=Y&x=0&y=0&sw=1269&sh=846&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:32", "link": "/news/story/7002/9794145"}, {"article_id": "9794142", "title": "中職／投手好卻勝投少現象 林岳平：因實力接近", "summary": "中華職棒今年出現投手表現傑出、勝投進帳卻很少的現象，可能再現中職史上最少勝投王，統一獅隊總教練林岳平指出，正是因為投手整...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389009.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:25", "link": "/news/story/7001/9794142"}, {"article_id": "9794132", "title": "籃球／詹姆斯右腳跟腱撕裂重傷 母隊火速簽32歲浪人後衛補缺", "summary": "土耳其勁旅安納托利亞艾菲斯（Anadolu Efes）在歐聯史上得分王詹姆斯（Mike James）遭遇嚴重右腳跟腱撕裂傷後，迅速展開補強行動，宣布簽下資深後衛佩恩（Cameron Payne），合約將持續到2026-27年賽季結束。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388986.jpg&M=1&s=Y&x=0&y=39&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:20", "link": "/news/story/7003/9794132"}, {"article_id": "9794128", "title": "115年全民運動會八大獎座亮相 集結四大要素展現桃園特色", "summary": "115年全民運動會即將於10月17日至22日登場，桃園市以城市特色為創作核心，將桃園豐富的自然生態、人文風貌、科技產業及城市發展意象融入賽會獎座設計，打造八座兼具競技精神與城市文化意涵的系列獎座。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388984.jpg&M=1&s=Y&x=0&y=0&sw=1211&sh=808&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:10", "link": "/news/story/7005/9794128"}, {"article_id": "9794110", "title": "中職／李東洺最終戰登板拚11勝 張奕伺機搶中繼", "summary": "明天是中華職棒富邦悍將隊本季最後一戰，派出投手李東洺先發爭取下半季首勝也是個人本季第11勝，另外今、明2場比賽若有機會，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388983.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:09", "link": "/news/story/7001/9794110"}, {"article_id": "9794052", "title": "中職／悍將連10年未打進冠軍賽 後藤光尊：實力仍有不足", "summary": "中華職棒富邦悍將隊今年勝場數創近7年新高，然而連續10年未能打進總冠軍賽，總教練後藤光尊直言，從球隊在面對關鍵時刻的表現...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388978.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 18:03", "link": "/news/story/7001/9794052"}, {"article_id": "9794034", "title": "亞運／初估選手可獲國光獎章獎金1億9410萬 較上屆少了近1億", "summary": "名古屋亞運中華隊摘5金17銀33銅，國光獎章獎金初估1億8915萬元，較杭州亞運2億8500萬元少近1億。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388882.jpg&M=1&s=Y&x=0&y=283&sw=1019&sh=679&exp=3600&sl=W&fw=360", "date": "2026-10-04 17:55", "link": "/news/story/124981/9794034"}, {"article_id": "9794109", "title": "亞運／結束16天賽事迎接閉幕 中華代表團王婕菱掌旗甜美現身", "summary": "2026年名古屋亞運自9月19日開幕，16天的賽事今天正式畫下句點，日本時間晚間6點於瑞穗公園陸上競技場進行閉幕典禮，我國由初次參賽的17歲「跆拳道甜心」王婕菱擔綱掌旗官，柔術、跆拳道代表隊與團本部一同出席。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388960.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 17:53", "link": "/news/story/124981/9794109"}, {"article_id": "9794099", "title": "NBA／少拿2000萬美元助勇士維持競爭力 柯瑞：全家都很支持", "summary": "金州勇士球星柯瑞（Stephen Curry）今年休賽季與球隊完成延長合約，但他並沒有把能拿到的最高金額全數放進合約，而是選擇少拿約2000萬美元，替勇士留下更多薪資操作彈性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388944.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 17:52", "link": "/news/story/7002/9794099"}, {"article_id": "9794106", "title": "黑豹旗／215隊參賽再創新高！龍津高中抽中平鎮大魔王 隊長自請先發", "summary": "第14屆中信盃黑豹旗全國高中棒球大賽，今年將於10月25日點燃戰火，本屆共215支球隊參賽，包括混合組205隊、女子組10隊，參賽隊伍數再創賽史新高紀錄，展現「台灣甲子園」熱血魅力。今天舉辦賽事記者會暨抽籤大會，由台中市龍津高中抽中「籤王」，首戰將與尋求衛冕的桃園市平鎮高中交手，隊長陳冠辰表示，很興奮能挑戰強大對手，很有志氣地自請開幕戰先發投球，希望有機會三振打者，將團結一致帶領隊友全力拚戰，不留遺憾。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388940.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 17:50", "link": "/news/story/7001/9794106"}, {"article_id": "9794069", "title": "黑豹旗／215隊征戰「台灣甲子園」 中信盃黑豹旗參賽隊數締新猷", "summary": "中信銀行冠名贊助第十四屆中信盃黑豹旗全國高中棒球大賽，將於今年10月25日點燃戰火，本屆共計215支球隊參賽，其中混合組205隊、女子組10隊，參賽隊伍數再創賽史新高紀錄，展現「台灣甲子園」的熱血魅力。4日舉辦賽事記者會暨抽籤大會，抽籤環節氣氛熱烈，最終由台中市龍津高中抽中「籤王」全場歡呼，首戰將與尋求衛冕的桃園市平鎮高中交手，隊長陳冠辰表示，很興奮能挑戰強大的對手，很有志氣的陳冠辰將自請開幕戰先發投球，希望有機會三振打者，將團結一致帶領隊友全力拚戰，不留遺憾。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388888.jpg&M=1&s=Y&x=158&y=0&sw=880&sh=587&exp=3600&sl=W&fw=360", "date": "2026-10-04 17:21", "link": "/news/story/7001/9794069"}, {"article_id": "9794061", "title": "中職／曾家輝局數爆表不打亞冠賽 形容王溢正當年真的很厲害", "summary": "樂天桃猿隊23歲投手曾家輝，今年投出生涯4年代表作，22場先發投出7勝2敗、防禦率2.69，在中職投手排行榜名列第8，也是全隊排名最佳的投手，猿隊總教練曾豪駒今天證實，他不會參加11月進行的亞洲職棒冠軍爭霸賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388872.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&