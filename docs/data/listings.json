date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35346989.jpg&M=1&s=Y&x=0&y=319&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9766699"}, {"article_id": "9761469", "title": "中職／近身球風波延燒 場上火花不該變成跨場情緒", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309062.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/122629/9761469"}]}, {"name": "最新文章", "articles": [{"article_id": "9768755", "title": "脖子刺著Persistence 李灝宇進大聯盟後學會另一個「P」單字", "summary": "如果你有機會近距離看李灝宇，可注意一下他的脖子，上面刺著一個英文單字：Persistence。中文可翻成堅持、不屈不撓，更口語一點，是不管發生什麼就繼續下去。對很多運動員而言，這只是漂亮的座右銘，但看看李灝宇這幾年在職棒走的路，會發現這字刺在他身上，還真有那麼點意思。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350273.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 07:00", "link": "/news/story/122629/9768755"}, {"article_id": "9768978", "title": "日職／阪神猛虎9月大失速 進擊的巨人已經追上來了", "summary": "阪神9月打擊熄火僅5勝9敗，巨人投打俱進逼近，兩隊勝差一度歸零、目前僅0.5場，央聯優勝可能延至球季最後幾場才揭曉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350264.jpg&M=1&s=Y&x=0&y=0&sw=798&sh=532&exp=3600&sl=W&fw=360", "date": "2026-09-22 07:00", "link": "/news/story/122629/9768978"}, {"article_id": "9768990", "title": "運動畫刊專家還在睡！最新排名湖人被高估 灰狼、勇士被低估", "summary": "運動畫刊將湖人列戰力第八卻被指高估，灰狼未進前十遭低估，勇士亦被低估；尼克居首，馬刺、雷霆列爭冠前段。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350341.jpg&M=1&s=Y&x=101&y=19&sw=1018&sh=678&exp=3600&sl=W&fw=360", "date": "2026-09-22 07:00", "link": "/news/story/122629/9768990"}, {"article_id": "9769183", "title": "亞運棒球／被南韓賞15K 陳晨威：應該沒差這麼多", "summary": "亞運棒球「台韓大戰」昨晚開戰，中華隊廿歲業餘投手林佾葳雖繳出五局無責失、僅挨一安的好投，將比數凍結在一分差，但打線完全遭封鎖，差點慘遭「無安打」，最終全場敲兩安、吞十五Ｋ，以○比五遭完封，預賽首戰吞敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35350560.jpg&M=1&s=Y&x=33&y=0&sw=1247&sh=831&exp=3600&sl=W&fw=360", "date": "2026-09-22 00:04", "link": "/news/story/124981/9769183"}, {"article_id": "9769175", "title": "亞運軟網／余凱文摘金退役 13年國手「完美句點」", "summary": "我國軟式網球混雙組合余凱文／黃詩媛，昨天在名古屋亞運混雙決賽中，一路與對手強烈糾纏至決勝局，最終以五比四險勝日本強敵上松俊貴與天間麗奈摘金。賽後受訪時，第三度參加亞運的余凱文拋出震撼彈，宣布這將是他最後一次踏上亞運舞台，接下來將轉任教職；談到能以金牌畫下亞運生涯句點，余凱文欣慰表示，「圓夢了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350475.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 00:00", "link": "/news/story/124981/9769175"}, {"article_id": "9769189", "title": "名古屋隨筆／球迷趕看台韓大戰 交通變「魔王關」", "summary": "亞運棒球賽事昨晚登場，最受矚目的「台韓大戰」開打，南韓派出的全職業陣容，中華隊也有旅外及中職球員助陣，吸引不少台、韓球迷特地到場應援，中職、韓職各隊球衣都出現在現場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350557.jpg&M=1&s=Y&x=0&y=69&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 00:00", "link": "/news/story/124981/9769189"}, {"article_id": "9769196", "title": "亞運武術／太極抱銀 孫家閎一聽「家人」就落淚", "summary": "名古屋亞運武術賽事昨天進入第二天賽程，我國好手孫家閎在男子太極拳太極劍全能決賽登場，最終以總分十九點四五三分勇奪銀牌，不僅收下個人生涯首面亞運獎牌，也是我代表團本屆第三面銀牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350481.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 00:00", "link": "/news/story/124981/9769196"}, {"article_id": "9769204", "title": "亞運空手道／教練一個眼神 穩住石政中的銅牌", "summary": "過往較晚登場的空手道代表隊，今年自開幕隔天就率先登場，且連續兩天有獎牌進帳。昨天台灣選手石政中在對打男子六十七公斤級再奪一面銅牌，證明自己沒被三年前的失利打倒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350538.jpg&M=1&s=Y&x=0&y=89&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 00:00", "link": "/news/story/124981/9769204"}, {"article_id": "9769287", "title": "頂住壓力！余凱文、黃詩媛 亞運軟網奪首金", "summary": "名古屋亞運我國代表團昨天在獎牌榜上大有斬獲，不僅由軟式網球混雙余凱文／黃詩媛擊敗強敵日本組合拿下代表團本屆賽事首面金牌，第三度挑戰亞運舞台的武術好手孫家閎與空手道男子六十七公斤級石政中也分別拿下一銀、一銅，我代表團前兩日已累積拿下一金、三銀、二銅。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350529.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 00:00", "link": "/news/story/124981/9769287"}, {"article_id": "9769107", "title": "亞運棒球／台灣險遭無安打 陳晨威敲第1安、直言氣勢不能被帶走", "summary": "名古屋亞運台灣棒球代表隊今天差點遭到韓國隊無安打，所幸中職明星外野手陳晨威挺身而出，敲出全隊第1支安打，他表示輸了沒關係...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-09-21 22:59", "link": "/news/story/124981/9769107"}, {"article_id": "9769112", "title": "亞運女足／不敵衛冕軍日本仍晉級8強 中華隊下戰對決北韓爭4強門票", "summary": "中華女足今天在名古屋亞運小組最終戰強碰衛冕軍日本隊，終場中華隊雖以0：4不敵衛冕軍，仍憑藉前兩戰擊敗越南、泰國所累積的6分，以小組第二名晉級八強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_9.jpg", "date": "2026-09-21 22:40", "link": "/news/story/124981/9769112"}, {"article_id": "9769073", "title": "亞運棒球／中華22日迎戰泰國 兄弟新秀火球男黃玠瀚先發", "summary": "名古屋亞運棒球中華隊今天預賽首戰打線沒能發揮、不敵韓國，明天與泰國隊交手，派出中職中信兄弟新秀、具最速153公里火球的2...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326518.jpg&M=1&s=Y&x=285&y=74&sw=937&sh=624&exp=3600&sl=W&fw=360", "date": "2026-09-21 21:57", "link": "/news/story/124981/9769073"}, {"article_id": "9769062", "title": "亞運棒球／久違正式比賽飆到156公里 劉致榮：上去把自己的100%丟出來", "summary": "中華隊今天在名古屋亞運棒球預賽首戰以0：5不敵南韓隊，劉致榮久違在正式賽事登板，中繼2局失2分，最快球速飆到156公里，歷經傷勢後國際賽復出，他說：「今天就是上去把自己的100%丟出來。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350397.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 21:46", "link": "/news/story/124981/9769062"}, {"article_id": "9769034", "title": "亞運棒球／林佾葳5局無責失抗韓好投 自評85分再拚職棒機會", "summary": "中華隊今天在名古屋亞運棒球賽首戰，推出業餘投手林佾葳先發迎戰強敵南韓，面對全韓職打線，繳出5局失1分（非責失）的亮眼表現，僅管沒能拿下勝利，他仍滿意自己的表現，打下85分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350373.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 21:29", "link": "/news/story/124981/9769034"}, {"article_id": "9769031", "title": "亞運軟網／混雙贏得中華代表團首金 體總會長葉政彥宴請協會與友人", "summary": "我國軟式網球混雙組合余凱文／黃詩媛今天在名古屋亞運傳出捷報，險勝日本強敵上松俊貴／天間麗奈，為中華代表團贏得本屆賽事首面金牌，在獎牌日第二天就進帳金牌，振奮了中華代表團士氣，也鼓舞代表團教練及選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350368.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 21:25", "link": "/news/story/124981/9769031"}, {"article_id": "9768996", "title": "亞運卡巴迪／最後一波攻防都失手 中華男子隊首戰1分惜敗孟加拉", "summary": "名古屋亞運中華卡巴迪代表隊今天下半場39比39平手之際，被對手的6比1攻勢打壞勝利行情，加上最後一波攻防都失手，終場47...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350347.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 21:10", "link": "/news/story/124981/9768996"}, {"article_id": "9769000", "title": "籃球／國立體大不只靠胡晉豪 鐵三角成形登峰造極2連勝", "summary": "國立體大靠胡晉豪、林睿軒與張祐瑋鐵三角合砍54分，擊敗健行科大拿下2連勝；虎科、臺北市大與文化大學也告捷。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350321.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 20:59", "link": "/news/story/7003/9769000"}, {"article_id": "9769003", "title": "圖輯／亞運棒球中韓大戰 中華隊打擊熄火 遭韓國完封", "summary": "名古屋亞運中韓大戰晚上在岡崎球場開打，中華隊以20歲業餘投手林佾葳先發登板，僅在第2局面臨危機，先讓首名打者因游擊手陽柏翔失誤上壘，接著被敲安打再投出保送，滿壘時因高飛犧牲打失1分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350288.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-21 20:58", "link": "/news/story/124981/9769003"}, {"article_id": "9768880", "title": "亞運棒球／台韓大戰 球迷下班衝直播派對吶喊挺中華隊", "summary": "名古屋亞運棒球台灣代表隊今天預賽首戰面對韓國隊。台北、新北、台中、高雄都舉辦直播派對，球迷們一下班前往看球，大聲吶喊「挺...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/21/35350426.jpg&M=1&s=Y&x=120&y=0&sw=1081&sh=721&exp=3600&sl=W&fw=360", "date": "2026-09-21 20:26", "link": "/news/story/124981/9768880"}, {"article_id": "9768859", "title": "亞運軟網／余凱文、黃詩媛奪金 教練稱讚默契佳有信任感", "summary": "名古屋亞運從開幕到今天第3天，中華代表隊靠著軟網混雙組