": "/news/story/122629/9844893"}, {"article_id": "9843081", "title": "拓荒者開季3連勝銳不可擋 3後衛+4持球點成西區大黑馬！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/28/35463385.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9843081"}]}, {"name": "最新文章", "articles": [{"article_id": "9852262", "title": "NBA／詹姆斯讚費城團隊氣氛佳 曝重返東岸最大適應難題", "summary": "費城76人新賽季展現強大競爭力，在自由市場網羅詹姆斯（LeBron James），並透過交易補進布朗（Jaylen Brown）後，戰力全面升級，開季前6場比賽取得5勝1敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477789.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 16:34", "link": "/news/story/7002/9852262"}, {"article_id": "9852266", "title": "中職／范國宸不安中再次雙料奪獎 喜獲3支iPhone送出1支慰勞後勤", "summary": "富邦悍將隊范國宸相隔三年再度斬獲個人獎，在一壘雙料得獎，今年季末集團「大董」蔡明忠祭出iPhone 18大賞，范國宸一人就拿了三支，大方提供一支給後勤人員抽獎，最終由大巴司機幸運獲獎。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477802.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 16:34", "link": "/news/story/7001/9852266"}, {"article_id": "9852251", "title": "足球／姚仁恭攜魏寶生角逐足協龍頭 喊6個月改革、吳東亮點頭支持參選", "summary": "中華民國足球協會改選戰火升溫，知名建築照明設計師姚仁恭今（2）日宣布，攜手台新新光金控副董事長、新光人壽董事長魏寶生，參選第14屆足協正、副理事長，挑戰尋求連任的現任理事長張璨。面對足協長期財務爭議，姚仁恭直言，協會仍有外界所稱的「財務黑洞」有待釐清，因此特別邀請具金融財務專業的魏寶生加入，承諾若當選，6個月內要讓改革有感，讓台灣足球真正「煞車、轉向」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477776.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 16:29", "link": "/news/story/7005/9852251"}, {"article_id": "9852202", "title": "MLB／教士留下3名左投 包括松井裕樹明年年薪650萬美元", "summary": "根據《紐約郵報》記者海曼（Jon Heyman）報導，教士35歲牛棚老將培洛塔（Wandy Peralta）將連續第3年放棄跳脫合約，執行2027年價值445萬美元的球員選項，確定不會在今年冬天投入自由市場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477764.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-02 16:23", "link": "/news/story/6999/9852202"}, {"article_id": "9852229", "title": "NBA／老鷹新秀惡意肘擊對手頭部引爆衝突 遭聯盟禁賽處分", "summary": "NBA官方今天宣布，老鷹19歲新秀佛萊明斯（Kingston Flemings）因在比賽中蓄意以手肘攻擊鵜鶘後衛麥高文斯（Bryce McGowens）頭部，遭到聯盟處以禁賽1場的懲處，將缺席老鷹接下來對溜馬的比賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477753.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 16:20", "link": "/news/story/7002/9852229"}, {"article_id": "9852216", "title": "中職／林岳平續掌統一獅兵符！1年短約迎執教第8季 蘇泰安預告教練團異動", "summary": "統一7-ELEVEn獅總教練「餅總」林岳平去留終於塵埃落定！儘管今年季後挑戰賽不敵中信兄弟，賽後一度傳出卸任消息，甚至有其他球團積極探詢執教意願，但獅隊領隊蘇泰安今天（2日）正式證實，球團已與林岳平達成續約1年共識，2027年將繼續由他領軍，迎接執教第8個球季，朝隊史第11座總冠軍邁進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477733.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 16:12", "link": "/news/story/7001/9852216"}, {"article_id": "9852190", "title": "足球／參選中華足協理事長 姚仁恭盼攜手魏寶生改革協會", "summary": "知名建築照明設計師姚仁恭，今天正式宣布和台新新光金控副董事長魏寶生搭檔，參選中華民國足球協會第十四屆理事長和副理事長，喊出「務實前行，穩健升級」的核心理念，並設定半年內改善足協形象的目標，希望為台灣足球尋求改革契機。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477691.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 16:00", "link": "/news/story/7005/9852190"}, {"article_id": "9852162", "title": "MLB／明年恐無球可打！費城人哈波暗示「整季放假」封館危機再度升溫", "summary": "隨著大聯盟與球員工會在薪資上限議題上仍存在嚴重分歧，封館危機逐漸升溫。對此，費城人當家巨星哈波（Bryce Harper）更在社群留言區，暗示明年3月至10月恐怕都將成為「休賽季」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477647.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-11-02 15:56", "link": "/news/story/6999/9852162"}, {"article_id": "9852144", "title": "棒球／西武獅台灣系列賽門票4日中午開賣 限定法披、應援手燈與衝鋒旗等球迷搶收", "summary": "2027年「西武獅台灣系列賽－傳奇對決－」門票即將開賣！埼玉西武獅明年2月27、28日將登上臺北大巨蛋，分別對戰統一7-ELEVEN獅與中信兄弟，兩天賽事都準備了限定入場贈品，從賽事限定法披、應援手燈到衝鋒旗，讓球迷不只進場看球，也能把專屬紀念品帶回家。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477580.jpg&M=1&s=Y&x=0&y=56&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-02 15:43", "link": "/news/story/7001/9852144"}, {"article_id": "9852111", "title": "MLB／不願放走最強牛棚！ 紅襪砸825萬美元續留惠特洛克", "summary": "紅襪球團今日宣布，正式執行30歲右投惠特洛克（Garrett Whitlock），價值825萬美元（約新台幣2.6億元）的2027年球隊選擇權。值得一提的是，惠特洛克本季繳出生涯最佳1.72防禦率，不僅優於隊友、明星終結者查普曼（Aroldis Chapman），更高居大聯盟後援投手第5，成為紅襪不願放手的重要原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477509.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 15:29", "link": "/news/story/6999/9852111"}, {"article_id": "9852047", "title": "NBA／湖人不忍了！暴龍全場「26犯」太粗暴 瑞迪克怒揭防守亂象", "summary": "儘管湖人今日在主場以131：125成功擊敗暴龍，賽後總教練瑞迪克（JJ Redick）卻對裁判尺度相當不滿，直言暴龍防守動作過於粗暴，不僅許多明顯犯規都未獲吹判，更將球隊頻繁發生失誤的原因，部分歸咎於裁判漏吹犯規。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477405.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 15:12", "link": "/news/story/7002/9852047"}, {"article_id": "9851988", "title": "NBA／勇士菜鳥拒當「刷分仔」倫德伯格遭隊友慫恿後悔：我不是這樣的人", "summary": "勇士24歲新秀倫德伯格（Yaxel Lendeborg）剛自嘲打出「人生最糟糕的一場比賽」後，在柯瑞（Stephen Curry）與格林（Draymond Green）今日雙雙缺陣下，面對快艇狂轟生涯新高37分，率隊以124：112收下4連勝，不過，倫德伯格賽後卻對自己的表現感到不滿，直言不應受到隊友影響，從而追求個人數據改變打法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477459.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 15:10", "link": "/news/story/7002/9851988"}, {"article_id": "9852050", "title": "NBA／狂寫史上首見全能紀錄 唐西奇場均轟37.7分傲視群雄", "summary": "湖人當家球星唐西奇（Luka Doncic）新賽季展現絕佳狀態，今天主場迎戰暴龍，全場狂轟45分、15籃板、6助攻、5抄截，還投進8記三分球，數據顯示，他成為NBA史上首位單場至少拿下45分、15籃板、5助攻、5抄截及5記三分球的球員，寫下前所未見的全能紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477440.jpg&M=1&s=Y&x=0&y=4&sw=1004&sh=669&exp=3600&sl=W&fw=360", "date": "2026-11-02 15:08", "link": "/news/story/7002/9852050"}, {"article_id": "9851984", "title": "NBA／狂讚勇士菜鳥天賦太嚇人 柯爾驚嘆：他甚至還沒搞懂比賽怎麼打", "summary": "勇士24歲「老菜鳥」倫德伯格（Yaxel Lendeborg）持續展現驚人天賦，今天面對快艇狂轟生涯新高37分，率領球隊以124：112過關，豪取4連勝。對於這名菜鳥的爆發，勇士總教練柯爾（Steve Kerr）賽後大力稱讚，但他更指出，倫德伯格目前甚至還沒有完全理解NBA的比賽節奏，未來仍有相當大的成長空間。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477286.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 14:36", "link": "/news/story/7002/9851984"}, {"article_id": "9851958", "title": "NBA／「罰球之王」換人當？泰托姆4戰狂獲54罰 寫塞爾蒂克18年紀錄", "summary": "根據《NBC Sports Boston》統計，塞爾蒂克當家球星泰托姆（Jayson Tatum）近4場比賽，累積獲得54次罰球機會，成為自2008年「真理」皮爾斯（Paul Pierce）以來第二人。更值得注意的是，泰托姆目前場均罰球10.2次，不僅與唐西奇（Luka Doncic）並列聯盟第一，甚至比雷霆球星亞歷山大（Shai Gilgeous-Alexander）的4.7次多出一倍以上。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477224.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 14:26", "link": "/news/story/7002/9851958"}, {"article_id": "9851950", "title": "中職／蔣銲確定成獎金王 親自領獎保底21萬元再拚MVP", "summary": "中華職棒年度頒獎典禮今天晚間登場，味全龍隊洋投蔣銲親自出席頒獎典禮，獎金不減半，已確定入袋21萬元，若再奪年度MVP將升級31萬元大紅包。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477222.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 14:15", "link": "/news/story/7001/9851950"}, {"article_id": "9851837", "title": "路跑／瑞典好手艾姆格倫全馬首秀奪冠 肯亞切普基魯伊2度封后", "summary": "瑞典選手艾姆格倫（Andreas Almgren）今天在紐約馬拉松奪冠，首次挑戰全馬就跑出2小時6分1秒的驚人佳績", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35477049.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 13:50", "link": "/news/story/7005/9851837"}, {"article_id": "9851826", "title": "NBA／沒有柯瑞勇士照拿4連勝 菜鳥倫德伯格狂轟37分創紀錄", "summary": "金州勇士新賽季開局一度苦吞3連敗，如今卻逐漸展現強勢反彈氣勢。今天主場迎戰洛杉磯快艇，即使柯瑞（Stephen Curry）與格林（Draymond Green）雙雙輪休，勇士仍靠著新秀倫德伯格（Yaxel Lendeborg）狂轟生涯新高37分，最終以124：112擊敗對手，豪取4連勝，也讓快艇吞下5連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35476980.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 13:37", "link": "/news/story/7002/9851826"}, {"article_id": "9851803", "title": "PLG／向林志傑、蔡文誠致敬！勇士主場開幕週辦引退儀式", "summary": "臺北富邦勇士將於11月14日、11月15日迎接PLG 2026-27賽季主場開幕戰，球團宣布以「Always Braves 藍魂不滅」為主題，規劃一系列豐富多元的開幕週活動，兩日將分別舉辦「林志傑12號球衣背號引退儀式」及「蔡文誠引退儀式」，向兩位籃壇傳奇致敬。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35476930.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 13:24", "link": "/news/story/7003/9851803"}, {"article_id": "9851759", "title": "NBA／唐西奇狂砍45分15籃板 湖人驚險退暴龍避免翻盤", "summary": "湖人隊當家球星唐西奇（Luka Doncic）今天碰暴龍隊繼續上演飆分秀，第一節就攻下16分、前9次三分球出手命中8球，最終砍下本季次高45分外帶本季新高15籃板，還有6助攻和5抄截，以全能表現率隊以131：125打下暴龍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35476878.jpg&M=1&s=Y&x=0&y=34&sw=1136&sh=758&exp=3600&sl=W&fw=360", "date": "2026-11-02 13:07", "link": "/news/story/7002/9851759"}, {"article_id": "9851758", "title": "MLB／隊友講「窩居米飯」拉近距離 鄧愷威從烏龍派出所、伍佰找殺氣", "summary": "鄧愷威在大聯盟征戰腳步進入第三年，不僅從隊友身上學習，還有來自「烏龍派出所」角色本田速人的啟發，場下看來溫和、場上卻很有殺氣的他說：「本田私底下是很nice、很和善的人，騎上摩托車就是很tough的人，我和很多隊友都是這樣，私底下都是人很好，上了球場就是不要讓、我要贏的心態。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35476868.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-02 13:07", "link": "/news/story/6999/9851758"}, {"article_id": "9851686", "title": "NBA／籃網終於開胡！波特、藍道率隊擊退溜馬 國王成唯一不勝球隊", "summary": "布魯克林籃網終於擺脫開季連敗陰霾！儘管後場面臨人手不足的困境，籃網仍靠著波特（Michael Porter Jr.）攻下23分、9籃板，以及藍道（Julius Randle）貢獻20分，最終以98：90擊敗溜馬，收下新賽季首勝，這也讓國王成為目前聯盟唯一尚未開胡的球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/02/35476767.jpg&M=1&s=Y&x=0&y=34&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-02 12:51", "link": "/news/story/7002/9851686"}, {"article_id": "9851662", "title": "MLB／本季30戰最難忘615打虎3.1局飆9K 鄧愷威想起三振很多很爽的感覺