"articles": [{"article_id": "9633511", "title": "棒球／日本隊拚洛杉磯奧運門票 傳井口資仁接任監督呼聲高", "summary": "日本武士隊新任總教練人選傳出有譜，預計將由51歲井口資仁出任，選手時期累積17年日職、4年美職生涯，退役後曾任羅德監督，近年擔任球評。日本媒體報導指出，侍JAPAN強化委員會對於由井口資仁接掌兵符已有共識，可望在近期正式宣布。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143976.jpg&M=1&s=Y&x=0&y=37&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 09:59", "link": "/news/story/7001/9633511"}, {"article_id": "9633494", "title": "MLB／大都會交易大限要當賣家！紐媒：只有5人是非賣品", "summary": "大都會隊本季狀態低迷，據紐約媒體《SNY》記者簡斯（Chelsea Janes）報導，大都會將在交易截止日前當賣家，只有5人是非賣品，當家游擊手林多（Francisco Lindor）可能被交易。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143944.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 09:55", "link": "/news/story/6999/9633494"}, {"article_id": "9633354", "title": "拳擊／U19暨U23亞錦賽摘銀 翁語瞳心態調整更勝以往", "summary": "亞洲U19暨U23拳擊錦標賽在印尼雅加達落幕，中華隊共摘下1銀6銅，其中U19女子65公斤級選手翁語瞳首度闖進國際賽決賽...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143894.jpg&M=1&s=Y&x=0&y=95&sw=1140&sh=760&exp=3600&sl=W&fw=360", "date": "2026-07-17 09:36", "link": "/news/story/7005/9633354"}, {"article_id": "9633462", "title": "MLB／3分之1球隊遊走灰色地帶 大聯盟下令平板電腦禁用AI", "summary": "明星賽落幕，下半季重燃戰火，根據美國媒體The Athletic獨家報導指出，大聯盟6月向各隊發出一份備忘錄，禁止各隊在休息室使用的公版平板電腦使用生成式人工智慧（生成式AI），新規定於明星賽後生效。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143901.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 09:35", "link": "/news/story/6999/9633462"}, {"article_id": "9633389", "title": "NBA／轉戰熱火受梅西啟發！字母哥：梅西給我勇氣迎接新挑戰", "summary": "美國職籃NBA兩屆年度最有價值球員（MVP）安戴托昆波今天抵達邁阿密（Miami）加入熱火，表示他是受到體壇傳奇梅西的啟...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143864.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 09:25", "link": "/news/story/7002/9633389"}, {"article_id": "9633404", "title": "FIFA十大話題球星誰稱王？世足賽哪個瞬間最讓你激動？", "summary": "2026世界盃哪位球星人氣最高？盤點十大爆紅球星排行與四強賽程資訊，趕緊加入熬夜看球行列！", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143974.jpg&M=1&s=Y&x=0&y=0&sw=1249&sh=833&exp=3600&sl=W&fw=360", "date": "2026-07-17 09:15", "link": "/news/story/123107/9633404"}, {"article_id": "9633419", "title": "世足賽／4強遭阿根廷逆轉飽受質疑 英格蘭主帥盼重塑球隊DNA", "summary": "英格蘭在世足賽準決賽再度鎩羽而歸，在領先局面下遭阿根廷逆轉，無緣暌違一甲子的決賽榮耀。這場慘痛的失利，不僅重創了「三獅軍團」的奪冠美夢，更將主帥圖赫爾（Thomas Tuchel）推上了輿論的風口浪尖。面對排山倒海的質疑，圖赫爾直言不諱地指出，英格蘭足球若想在國際大賽登頂，必須徹底重塑流淌在骨子裡的「足球DNA」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143844.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-17 09:14", "link": "/news/story/123107/9633419"}, {"article_id": "9633357", "title": "世足賽／阿根廷挺過質疑與逆境再闖決賽 梅西：我們非不勞而獲", "summary": "衛冕軍「藍白軍團」阿根廷今年世足賽挑戰衛冕之路雖然走得跌跌撞撞，但仍在昨天4強賽擊敗英格蘭後重返決賽舞台，對於過去一段時間面臨不少關於裁判判決與「護航」的質疑，當家球星梅西（Lionel Messi）在賽後霸氣反擊，強調阿根廷的所有成就皆是憑實力奪得，非不勞而獲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143743.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 08:31", "link": "/news/story/123107/9633357"}, {"article_id": "9632481", "title": "中職／奪金還是虛耗職業球員風險？亞運棒球徵召該重新去定位了", "summary": "亞運棒球中華隊的球員徵召爭議再起，主要因富邦悍將和台鋼雄鷹未支援球員引發討論。棒協計畫依需求徵召補充役球員，但需與球團協商，以免再次出現爭議。此次亞運，旅外球員徵召情況也引發球團不滿，顯示補充役制度亟需檢討。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142749.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 07:00", "link": "/news/story/122629/9632481"}, {"article_id": "9632635", "title": "又老又傷又缺天賦 勇士拚命找詹姆斯到底還在堅持什麼？", "summary": "勇士面臨老化與傷病問題，38歲的柯瑞與36歲的巴特勒健康狀況不確定。若有科學數據顯示勇士計畫爭冠，卻與76人、熱火等天賦滿載的隊伍相比，競爭力似乎受限，未來仍具挑戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142836.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 07:00", "link": "/news/story/122629/9632635"}, {"article_id": "9633106", "title": "世足賽／英國：就算贏不了世界盃 福克蘭群島絕對屬於我們", "summary": "阿根廷15日在世界盃足球賽4強戰擊敗英格蘭，球員賽後高舉白底黑字布條，上面寫「馬維納斯群島（福克蘭群島）是阿根廷的」。英...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143571.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-17 05:30", "link": "/news/story/123107/9633106"}, {"article_id": "9633169", "title": "世足賽／世界盃決賽在即 白宮預告川普將出席", "summary": "白宮新聞秘書李威特今天表示，美國總統川普將出席19日在紐澤西州大都會人壽體育場（MetLife Stadium）的世界盃...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143569.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-17 05:27", "link": "/news/story/123107/9633169"}, {"article_id": "9633100", "title": "廣角鏡／阿根廷逆轉英格蘭 世足賽將與西班牙爭冠", "summary": "世界盃足球賽四強賽，阿根廷以二比一逆轉英格蘭，挺進冠軍戰。阿根廷球星梅西與隊友賽後跪地相擁，與抱頭惋惜的英格蘭球員形成強烈對比，阿根廷將與西班牙爭奪大力神盃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143335.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 00:22", "link": "/news/story/123107/9633100"}, {"article_id": "9632942", "title": "煮茶論戰／梅西頂級視野超能力 把比賽讀成書", "summary": "「英阿四強大戰」是一場非典型卻無比經典的戰術與意志力逆轉勝。阿根廷昨在落後一球情況下，卻在常規賽最後階段靠梅西連續兩次助攻逆轉戰局，充分展現阿根廷衛冕軍的恐怖韌性，與梅西對於比賽解讀的超能力，這場勝利並非單純的實力碾壓，而是戰術智慧與冠軍心態的完勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35143240.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 00:00", "link": "/news/story/122629/9632942"}, {"article_id": "9632944", "title": "世足賽／當年的嬰兒長大了...梅西、亞馬爾的命運「澡盆之戰」", "summary": "二○二六年世足賽高潮迭起，阿根廷距離衛冕僅剩一步之遙，更促成了世界足壇最具詩意的一場夢幻對決，卅九歲的球王梅西將與十九歲的西班牙天才神童亞馬爾，在決賽舞台上演令人津津樂道的「澡盆之戰」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143985.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-17 00:00", "link": "/news/story/123107/9632944"}, {"article_id": "9632932", "title": "世足賽／梅西關鍵2助攻！阿根廷殺進決賽 挑戰巴西魔咒拚連霸", "summary": "世界盃衛冕軍阿根廷淘汰賽走得跌跌撞撞，仍一路挺進最終戰，昨天當家球星「獅王」梅西在一球落後下連傳出兩次助攻，第二球更是在傷停補時階段讓替補上陣的馬丁尼茲頭錘攻進致勝球，戲劇性以二比一逆轉英格蘭，勇闖決賽，創下隊史七度晉級四強賽都晉級壓軸戰紀錄，台灣時間廿日凌晨三時將和西班牙爭奪大力神盃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35143177.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-17 00:00", "link": "/news/story/123107/9632932"}, {"article_id": "9632961", "title": "排球／U18男排亞錦賽中華隊力退泰國闖4強 搶下U19世錦賽門票", "summary": "在中國舉行的亞洲U18男子排球錦標賽，中華隊今天在8強戰以3比1力退泰國隊，不僅順利前進4強，並取得明年U19世錦賽門票...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143759.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 23:43", "link": "/news/story/7005/9632961"}, {"article_id": "9632912", "title": "世足賽／迎接四強賽！萊爾富限時推「Hi café特大杯咖啡任選買1送1」", "summary": "2026世界足球賽即將進入季軍、冠軍賽程，萊爾富推出多項商品限時優惠，即日起至7月21日Hi café特大杯咖啡任選買1送1（不同價者以2杯5折計），同時攜手人氣甜品品牌鮮芋仙推出聯名冰沙，並同步引進多款日本人氣飲品，滿足消費者追求話題新品與消暑飲品的需求。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35143161.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-16 22:57", "link": "/news/story/123107/9632912"}, {"article_id": "9632870", "title": "中職／曾家輝先發帶來安定感 李勛傑：因為他是輝能帝啊！", "summary": "樂天桃猿隊今天在主場以2：1逆轉統一獅隊，下半季戰績持續獨走，李勛傑擺脫先前「連自己都受不了」的低迷手感，單場敲雙安，包括6局下打回超前分，久違地拿到單場MVP，他也直呼：「很久沒這種感覺。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35143062.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-16 22:11", "link": "/news/story/7001/9632870"}, {"article_id": "9632814", "title": "日本羽賽／許尹鏸、林芝昀組合 女雙輕鬆晉8強", "summary": "台灣羽球女雙組合許尹鏸、林芝昀今天在BWF超級750的日本羽球公開賽16強，僅用25分鐘就以21比7、21比10輕取香港...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2024/08/29/1/30369991.jpg&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 22:01", "link": "/news/story/7005/9632814"}, {"article_id": "9632843", "title": "中職／曾家輝上半季投出亮眼表現 曾總擔心：近期球速、體重都下滑", "summary": "樂天桃猿隊「輝能帝」曾家輝今年上半季先發表現亮眼，成為球隊先發輪值中最倚賴的本土投手，然而進入下半季後，近兩場先發球速明顯下滑，今天對戰獅隊僅投5局失1分收工，猿隊總教練曾豪駒表示：「會再持續注意他的身體狀況。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35143058.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-16 21:51", "link": "/news/story/7001/9632843"}, {"article_id": "9632790", "title": "運動部設涉違法事件不適任教練專區 首波公告147人前職棒球員陳凱倫上榜引熱議", "summary": "運動部公布147名不適任教練名單，前職棒球員陳凱倫因意圖性侵事件上榜，2023年遭法院定讞有罪。此公告提供民眾查詢各類違法事件的教練資訊，並連結判決書。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35143012.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 21:48", "link": "/news/story/7001/9632790"}, {"article_id": "9632810", "title": "中職／李勛傑雙安突破銳力獅 桃猿終止對戰獅隊4連敗", "summary": "中職明星賽前最後一戰，樂天桃猿隊今天靠著由曾家輝由本土投手撐住場面，曾家輝先發5局失1分、陳克羿中繼3局無失分，再由陳冠宇登板關門守成；打線則有李勛傑在6局下敲回超前分，終場以2：1逆轉統一獅隊，終止對戰4連敗，下半季續居龍頭，也讓獅隊中斷3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142991.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-16 21:29", "link": "/news/story/7001/9632810"}, {"article_id": "9632713", "title": "日職／林安可連兩場開轟後近兩戰5支0 西武終止3連勝", "summary": "日職西武獅隊今天在主場對上羅德隊，台灣強打外野手林安可重回先發打線，擔任第6棒、左外野手，3打數沒有敲出安打。此戰西武雖一度將比數扳平，但最終在9局下反撲失利，以3：4落敗，終止3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/04/21/34877187.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 20:25", "link": "/news/story/7001/9632713"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9633357", "title": "世足賽／阿根廷挺過質疑與逆境再闖決賽 梅西：我們非不勞而獲", "date": "2026-07-17 08:31", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/17/35143743.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9633357"}, 