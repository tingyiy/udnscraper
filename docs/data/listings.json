00", "link": "/news/story/122629/9751705"}, {"article_id": "9751874", "title": "美聯塞揚競爭白熱化：斯萊特勒穩居王座 希斯還有機會逆轉嗎？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/13/35323951.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9751874"}, {"article_id": "9751740", "title": "日職／巨人洋將守護神強勢追趕 岩瀨仁紀起步晚錯失史上500救援第一人", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/13/35323596.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9751740"}]}, {"name": "最新文章", "articles": [{"article_id": "9755926", "title": "MLB／大都會薪資僅次道奇卻連2年無緣季後賽 阿隆索獲紐約球迷歡呼", "summary": "「北極熊」阿隆索（Pete Alonso）離開大都會隊後，首次回到花旗球場，大都會球迷用歡呼和掌聲迎接他。大都會終場以1：2輸給金鶯隊，本季確定無緣季後賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35330006.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 14:54", "link": "/news/story/6999/9755926"}, {"article_id": "9755888", "title": "MLB／重啟打擊訓練！大谷翔平最快24日回歸 羅伯茲相信「神奇」方法", "summary": "經過大約一周休養與輕度訓練後，道奇巨星大谷翔平終於準備拿起球棒，正式展開打擊復健。根據總教練羅伯茲（Dave Roberts）透露，大谷預計從明日開始在洛杉磯進行T座打擊訓練。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329915.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 14:51", "link": "/news/story/6999/9755888"}, {"article_id": "9755732", "title": "亞運羽球／中華隊16日啟程 林俊易左腿傷勢積極治療", "summary": "名古屋中華台灣羽球代表隊將於明天啟程，今天王齊麟、林俊易、葉宏蔚、詹又蓁抽空出席紀錄片記者會；但林俊易透露，自己因左大腿...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329721.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 14:11", "link": "/news/story/124981/9755732"}, {"article_id": "9755769", "title": "MLB／單場鐵支再炸第42轟！PCA追平小熊最敬重傳奇 差3盜完成40-40", "summary": "小熊「PCA」阿姆斯壯（Pete Crow-Armstrong）今日面對勇士，不僅單場「鐵支」 、更敲出本季第42轟外加盜壘，率領小熊以7：3取勝，成功追平名人堂傳奇威廉斯（Billy Williams）保持超過半世紀的隊史紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329690.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 14:04", "link": "/news/story/6999/9755769"}, {"article_id": "9755711", "title": "NBA／暴龍官宣迎回雷納德 社群一句「He back」喚醒2019冠軍回憶", "summary": "多倫多暴龍正式迎回雷納德（Kawhi Leonard）。儘管他與洛杉磯快艇先前捲入長達近1年的薪資上限規避調查，暴龍仍在交易正式完成後表達歡迎，期待這位昔日冠軍英雄重返多倫多，為球隊下一階段爭冠計畫注入經驗與領導力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329607.jpg&M=1&s=Y&x=145&y=10&sw=1135&sh=756&exp=3600&sl=W&fw=360", "date": "2026-09-15 13:50", "link": "/news/story/7002/9755711"}, {"article_id": "9755749", "title": "MLB／卡洛爾再見2分砲助響尾蛇神奇逆轉 國聯外卡競爭白熱化", "summary": "響尾蛇隊塞揚強投伯恩斯（Corbin Burnes）迎來傷癒復出第2戰，主投4.2局失5分，不過響尾蛇靠著台美混血球星卡洛爾（Corbin Carroll）的再見2分砲，以8：7逆轉擊敗馬林魚隊，目前在國聯外卡仍落後第3的教士隊2.5場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329670.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 13:50", "link": "/news/story/6999/9755749"}, {"article_id": "9755657", "title": "NBA／只打2年就被國王放棄 2024年首輪第13順位後衛轉戰綠衫軍", "summary": "塞爾蒂克隊今天再度發動補強，與2024年首輪第13順位後衛卡特（Devin Carter）簽下Exhibit 10合約，將在季前訓練營爭取正式合約或雙向合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329543.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 13:11", "link": "/news/story/7002/9755657"}, {"article_id": "9755611", "title": "中職／莊昕諺顏面骨折撕裂傷+斷牙動刀 感謝球迷「所有慰問都收到了」", "summary": "樂天桃猿隊投手莊昕諺昨天遭遇強襲球直擊臉部傷情，球團今天公布傷勢，包括顏面骨折、撕裂傷及牙齒斷裂，安排在今天進行手術。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329522.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:57", "link": "/news/story/7001/9755611"}, {"article_id": "9755518", "title": "影／宏道基金會選手集結30人出征亞運 郭婞淳、李智凱熱血助陣", "summary": "2026名古屋亞洲運動會即將登場，宏道基金會今年贊助的選手中，一共有30位將代表台灣站上亞運國際舞台，為替選手們注入最強應援力量，宏道基金會特別邀請參賽選手拍攝亞運應援影片，從訓練場一路走向國際賽場，選手們用最熱血的宣言為自己打氣，也為即將並肩作戰的中華隊加油。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329408.png&M=1&s=Y&x=0&y=0&sw=1020&sh=680&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:29", "link": "/news/story/124981/9755518"}, {"article_id": "9755491", "title": "NBA／不認籃網只是重建球隊 藍道重返紐約喊話：我們會超越外界期待", "summary": "從近幾年西區勁旅灰狼被交易轉戰到重建中的布魯克林籃網，很多人都好奇這對於31歲的藍道（Julius Randle）來說，在心態上會不會有所落差。然而近日他在接受採訪時表示，不希望外界把籃網定位成單純的重建球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329355.jpg&M=1&s=Y&x=0&y=3&sw=1004&sh=669&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:20", "link": "/news/story/7002/9755491"}, {"article_id": "9755428", "title": "MLB／岡本和真第33轟出爐 旅美菜鳥球季創下多項紀錄", "summary": "美國職棒大聯盟MLB多倫多藍鳥隊日本重砲手岡本和真今天迎戰底特律老虎隊時，7局下敲出3分砲，在菜鳥球季累計33轟，創下多...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329356.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:20", "link": "/news/story/6999/9755428"}, {"article_id": "9755476", "title": "網球／紐約行「三喜臨門」 愛司女王鎖定法網挑戰全滿貫", "summary": "哈薩克「愛司女王」芮芭奇娜（Elena Rybakina）不只成為新科世界球后、迎接生涯第一座美網金盃，還成為第一位取得WTA年終賽資格的女將，堪稱「三喜臨門」，她也透露接續目標就是繼續奪下大賽冠軍，尤其是還沒拿過的法網金盃，挑戰完成生涯「全滿貫」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329329.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:11", "link": "/news/story/7005/9755476"}, {"article_id": "9755406", "title": "NBA／ 力壓柯瑞、魔術強森？ 墨瑞直言衛少「控衛GOAT」：無法複製", "summary": "「大三元製造機」衛斯特布魯克（Russell Westbrook）日前透過社群影片宣布退休，消息公布後，不少NBA球星紛紛向表示致敬，鵜鶘後衛墨瑞（Dejounte Murray）更轉發退休影片並直接寫下，「史上最偉大的控球後衛！！！！」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329147.jpg&M=1&s=Y&x=0&y=31&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:11", "link": "/news/story/7002/9755406"}, {"article_id": "9755424", "title": "中職／與球團保持密切聯繫 蔡其昌：一起為莊昕諺加油", "summary": "樂天桃猿隊投手莊昕諺昨天在8局下，被台鋼雄鷹隊打者王博玄的強襲球直擊臉部後倒地，隨後被工作人員抬上擔架送醫。中華職棒會長蔡其昌今天在社群平台表達關心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329206.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:01", "link": "/news/story/7001/9755424"}, {"article_id": "9755341", "title": "MLB／希恩優質先發後遭下放3A？道奇球迷炸鍋：該送走的是史考特", "summary": "道奇26歲右投希恩（Emmet Sheehan）前一場面對馬林魚最終戰才繳出好投，主投6局僅被敲2支安打、1次保送，沒有失掉任何分數，另飆出5次三振，總計僅用了81球，沒想到隔天就再次被下放3A，突如其來的人事異動也讓不少球迷看傻眼，甚至直接在社群媒體開罵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329048.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 12:01", "link": "/news/story/6999/9755341"}, {"article_id": "9755281", "title": "MLB／ 季後賽前再傷大將！道奇最穩的火球男下背不適例行賽報銷", "summary": "道奇24歲火球男恩里克斯（Edgardo Henriquez）今日因下背部不適，被球團放進15天傷兵名單，本季例行賽將提前畫下句點，並召回3A米勒（Bobby Miller）和傑瓦斯（Paul Gervase）填補空缺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328963.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 11:39", "link": "/news/story/6999/9755281"}, {"article_id": "9755312", "title": "NBA／國際專武杜蘭特想開「五金行」 表態願出征洛杉磯奧運", "summary": "擁有全方位進攻能力的杜蘭特（Kevin Durant），一直被視為國際賽的「超級專武」，對於其他各國各隊來說都是無解的存在。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329026.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 11:37", "link": "/news/story/7002/9755312"}, {"article_id": "9755283", "title": "MLB／賈吉復出首轟擊垮雙城！洋基晉級季後賽近10年第9次", "summary": "「法官」賈吉（Aaron Judge）敲出傷癒復出首轟，洋基隊8局上灌下6分大局，終場以8：3逆轉擊敗雙城隊，確定闖進季後賽，近10年第9次。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328965.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 11:21", "link": "/news/story/6999/9755283"}, {"article_id": "9755255", "title": "網球／美網後行程不停歇 謝爾頓、澤瑞夫台維斯盃再上陣", "summary": "今年美網首度打進大滿貫決賽，美國好手謝爾頓（Ben Shelton）沒有太多休息時間，確認將代表美國隊參加台維斯盃，接續拉沃盃也不缺席，加入世界隊的行列。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328989.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 11:15", "link": "/news/story/7005/9755255"}, {"article_id": "9755150", "title": "NBA／現役第2老也退了！吉布森17年旅程落幕", "summary": "40歲老將吉布森（Taj Gibson）今日宣布17年NBA生涯正式畫下句點，不過他並沒有真正離開籃球，而是選擇回到夢開始的芝加哥公牛，加入新任總教練史普利特（Tiago Splitter）的教練團擔任助理教練，正式開啟執教生涯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328760.jpg&M=1&s=Y&x=0&y=55&sw=544&sh=363&exp=3600&sl=W&fw=360", "date": "2026-09-15 11:03", "link": "/news/story/7002/9755150"}, {"article_id": "9755157", "title": "亞運網球／女將世界排名集體上升！謝淑薇重返女雙第9", "summary": "2026年美國網球公開賽結束，WTA世界排名更新， 我國「一姊」謝淑薇世界女雙排名重返前10，達到第9名。梁恩碩、葛藍喬安娜等名古屋亞運國手排名也回升。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328828.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-15 10:56", "link": "/news/story/124981/9755157"}, {"article_id": "9755184", "title": "NBA／才剛被新東家鵜鶘釋出就宣布退休 41歲吉布森重返公牛接任助教", "summary": "在NBA賽場征戰長達17個賽季的41歲資深前鋒吉布森（Taj Gibson），日前被交易到鵜鶘隊並遭到釋出後，隨即宣布結束球員生涯，不過這名昔日以頑強防守與硬朗作風著稱的禁區悍將，退役後並未離開籃球，公牛球團隨即宣布他將重返發跡地芝加哥，加入新任總教練史普利特（Tiago Splitter）的教練團，展開執教生涯的新篇章。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328843.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 10:51", "link": "/news/story/7002/9755184"}, {"article_id": "9755162", "title": "MLB／道奇連14季進季後賽平大聯盟紀錄 羅伯茲：沒那麼簡單", "summary": "道奇隊今天以4：1擊敗紅人隊，連續14季收下季後賽門票，追平大聯盟紀錄，下一步放眼國聯西區冠軍，封王魔術數字剩下「M3」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328834.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 10:43", "link": "/news/story/6999/9755162"}, {"article_id": "9755160", "title": "ASICS宣布成為名古屋亞帕運合作夥伴 盼協助凝聚賽事關注與熱度", "summary": "名古屋亞洲運動會即將在19日正式開幕，至於亞洲帕拉運動會則將在10月18日接續在名古屋登場，而運動品牌ASICS也在今天宣布與第5屆亞洲帕拉運動會簽署合作夥伴協議，期盼透過協辦2025年東京夏季聽障奧林匹克運動會的經驗透過多項行動支援第5屆亞洲帕拉運動會，進一步凝聚賽事關注與熱度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328855.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 10:43", "link": "/news/story/124981/9755160"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9755157", "title": "亞運網球／女將世界排名集體上升！謝淑薇重返女雙第9", "date": "2026-09-15 10:56", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328828.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/124981/9755157"}, {"article_id": "9755732", "title": "亞運羽球／中華隊16日啟程 林俊易左腿傷勢積極治療", "date": "2026-09-15 14:11", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329721.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9755732"}, {"article_id": "9755518", "title": "影／宏道基金會選手集結30人出征亞運 郭婞淳、李智凱熱血助陣", "date": "2026-09-15 12:29", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35329408.png&M=1&s=Y&x=0&y=0&sw=1020&sh=680&exp=3600&w=300", "link": "/news/story/124981/9755518"}, {"article_id": "9755160", "title": "ASICS宣布成為名古屋亞帕運合作夥伴 盼協助凝聚賽事關注與熱度", "date": "2026-09-15 10:43", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328855.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9755160"}, {"article_id": "9753952", "title": "亞運女足／中華2比1險勝越南 預賽首戰開紅盤", "date": "2026-09-14 17:32", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327194.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9753952"}]}, {"name": "棒球", "articles": [{"article_id": "9755611", "title": "中職／莊昕諺顏面骨折撕裂傷+斷牙動刀 感謝球迷「所有慰問都收到了」", "date": "2026-0