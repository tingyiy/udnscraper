 "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35207017.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9675473"}, {"article_id": "9674902", "title": "中職／熱昏了！韓職取消比賽 聯盟也應及早訂定高溫規定", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35206059.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9674902"}, {"article_id": "9672404", "title": "交易大限5大Win Now贏家 道奇奪史庫柏、教士迎麥茲最成功", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35202794.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9672404"}, {"article_id": "9671568", "title": "續約杜倫難解又沒第二持球點 活塞無作為的休賽季打什麼算盤？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200680.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9671568"}, {"article_id": "9671549", "title": "中職／擴編選秀CP值最高球員！ 陳文杰蛻變雄鷹王牌球星", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200626.jpg&M=1&s=Y&x=0&y=49&sw=1055&sh=703&exp=3600&w=300", "link": "/news/story/122629/9671549"}, {"article_id": "9668253", "title": "中職／至今找不到第4名可用洋投 中信洋投海戰術面臨失敗", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35196038.jpg&M=1&s=Y&x=0&y=33&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9668253"}]}, {"name": "最新文章", "articles": [{"article_id": "9679314", "title": "NBA／雷納德涉規避薪資上限爭議風暴 美名嘴喊：若屬實應禁賽1年", "summary": "洛杉磯快艇與球星雷納德（Kawhi Leonard）捲入疑似規避薪資上限調查，相關指控近日再度升溫。《ESPN》名嘴史密斯（Stephen A. Smith）直言，如果最新爆料最終被證實為真，雷納德至少應被禁賽1年，快艇老闆鮑默（Steve Ballmer）也應面臨同等嚴厲處分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212709.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 18:03", "link": "/news/story/7002/9679314"}, {"article_id": "9679226", "title": "MLB／宇宙道奇為何贏不了？羅伯茲以昔日「1勝16敗」勉勵全隊", "summary": "道奇今日在對戰響尾蛇之戰中，慘遭瓦德史密特（Ryan Waldschmidt）轟出再見2分砲，最終以4比3輸掉比賽，這場失利也讓道奇吞下本季最長7連敗，期間總得分以25比46遭到對手壓制。更誇張的是，道奇開季花了將近一個月才吞下本季第7敗，如今卻只用了8天就連輸7場，期間已經連續遭紅襪、小熊橫掃，如今又面臨被響尾蛇橫掃的危機。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212497.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-08 17:59", "link": "/news/story/6999/9679226"}, {"article_id": "9679302", "title": "中職／先讓張皓崴「感受快樂」 餅總對年輕球員設高標：不會手下留情", "summary": "統一獅隊21歲小將張皓崴近期被「暫放」在外野，繳出亮眼的打擊表現，近期連續15場安打，打擊率達3成59，總教練林岳平坦言，會讓他「再舒服一陣子」，但球隊對他的期待，還是要內外野都可以勝任，「如果回到內野還可以這麼的自在地比賽，就表示他已經有一點程度的成長。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212692.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 17:51", "link": "/news/story/7001/9679302"}, {"article_id": "9679300", "title": "NBA／承認讓愛德華打控衛是錯誤 灰狼交易小鮑爾期盼解放王牌", "summary": "灰狼總教練芬奇（Chris Finch）日前在節目中坦言，球隊上季有時讓愛德華（Anthony Edwards）扮演控球後衛，可能是錯誤決定，也讓球隊在季後賽付出代價。這也是灰狼今夏交易補進小鮑爾（LaMelo Ball）的重要原因之一，球團希望藉由真正控衛的組織能力，讓愛德華回到更自然單純的攻擊角色。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212690.jpg&M=1&s=Y&x=22&y=0&sw=1166&sh=777&exp=3600&sl=W&fw=360", "date": "2026-08-08 17:49", "link": "/news/story/7002/9679300"}, {"article_id": "9679298", "title": "日職／孫易磊後援2局6打席、17球搞定 最速156公里飆2K", "summary": "效力火腿隊的台灣投手孫易磊，今天面對樂天金鷲隊後援2局無失分，僅面對6打席完成任務，最快球速156公里，火腿終場以0：6不敵樂天。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212693.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 17:45", "link": "/news/story/7001/9679298"}, {"article_id": "9679287", "title": "MLB／村上宗隆破紀錄25轟仍難救白襪連敗 信心喊話：明天從0：0開始", "summary": "白襪日籍強打村上宗隆今天雖然轟出本季第25號全壘打，不過球隊最終不敵美聯中區第2名的守護者，吞下本季首度4連敗，分區領先優勢也被縮小到2場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212682.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 17:28", "link": "/news/story/6999/9679287"}, {"article_id": "9679258", "title": "NBA／美媒曝湖人希望庫明加做髒活 向葛登或維金斯看齊", "summary": "現年23歲的庫明加（Jonathan Kuminga）至今尚未決定新東家，湖人記者布哈（Jovan Buha）指出，湖人希望將庫明加定位成全能前鋒，類似金塊隊葛登（Aaron Gordon）或熱火隊維金斯（Andrew Wiggins）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212616.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 17:09", "link": "/news/story/7002/9679258"}, {"article_id": "9679253", "title": "中職／保護張翔！腳踝完全消腫後再回來 餅總：後面還有一個任務", "summary": "統一獅隊捕手張翔昨天在比賽中扭傷腳踝，今天被降二軍，總教練「大餅」林岳平解釋，他的傷勢狀況不算太嚴重，但因腳踝還腫脹，評估需要3天消腫，讓他充分休息後再回來，「因為他後續還有一個任務在。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212569.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 17:01", "link": "/news/story/7001/9679253"}, {"article_id": "9679210", "title": "MLB／紅襪30戰27勝超級狂！大聯盟數據專家整理5項神紀錄", "summary": "紅襪隊是目前大聯盟氣勢最強的球隊，不只先前拉出一波15連勝平隊史紀錄，最近又9連勝，近30場豪取27勝，大聯盟數據專家藍斯（Sarah Langs）整理5項紅襪創下的紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212459.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 16:35", "link": "/news/story/6999/9679210"}, {"article_id": "9679071", "title": "NBA／費里登挑戰WNBA規則界線 球員工會回應：不當政治棋子", "summary": "美國職籃NBA前球星坎特宣布他打算參加2027年美國女子職籃WNBA選秀，引發熱議，NBA前球員懷特也表示跟進，跨性別參...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212438.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 16:35", "link": "/news/story/7002/9679071"}, {"article_id": "9679212", "title": "中職／北部兩場賽事受颱風大雨延賽 悍將新洋投瑪帝斯晚一天「開箱」", "summary": "中華職棒賽事今天原訂三地開打，但受到白海豚颱風影響，在北部新莊棒球場及桃園棒球場進行的兩場賽事都因雨延賽，雙雙延至10月4日於原場地進行進行補賽；今天僅剩在高雄澄清湖棒球場進行的中信兄弟與台鋼雄鷹之戰未受影響。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212434.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 16:30", "link": "/news/story/7001/9679212"}, {"article_id": "9679159", "title": "奧運銅牌宋玉麒體驗虛擬跆拳道 看好成未來趨勢", "summary": "2026 ITSPORT虛擬跆拳道全國親子邀請賽今天在南港運動中心登場，2008年北京奧運銅牌跆拳道國手宋玉麒帶著兒子參...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212363.jpg&M=1&s=Y&x=27&y=0&sw=1186&sh=791&exp=3600&sl=W&fw=360", "date": "2026-08-08 16:16", "link": "/news/story/7005/9679159"}, {"article_id": "9679149", "title": "MLB／砸1.41億美元仍找不到守護神？迪亞茲挨再見轟：我僅犯了一個錯誤", "summary": "道奇守護神迪亞茲（Edwin Díaz）在對戰響尾蛇之戰最後階段，慘遭瓦德史密特（Ryan Waldschmidt）轟出一發飛行距離411英尺的再見2分砲，最終讓道奇以4比3輸掉比賽，連敗場次擴大至7場。賽後談到這次救援失敗，迪亞茲直接點出問題出在自己的滑球。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212313.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 15:38", "link": "/news/story/6999/9679149"}, {"article_id": "9679143", "title": "MiLB／林昱珉「全英文受訪」令球迷驚豔 分享今年進步原因", "summary": "響尾蛇隊3A台灣左投林昱珉狀態回穩，前天面對教士隊3A先發登板，繳出6局6K失2分的優質先發，賽後林昱珉以全英文受訪，分享自己近期的狀況，流利的英文和口條再次受到台灣球迷稱讚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212311.jpg&M=1&s=Y&x=0&y=70&sw=1014&sh=676&exp=3600&sl=W&fw=360", "date": "2026-08-08 15:29", "link": "/news/story/6999/9679143"}, {"article_id": "9679072", "title": "田徑／U20田徑世錦賽簡子傑3000公尺破全國 名列亞洲第6傑", "summary": "在美國奧勒岡舉行的世界U20田徑錦標賽，台灣旅日長跑新星簡子傑今天在男子3000公尺以7分51秒18名列第6名，不僅刷新...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212219.jpg&M=1&s=Y&x=0&y=2&sw=1135&sh=757&exp=3600&sl=W&fw=360", "date": "2026-08-08 14:46", "link": "/news/story/7005/9679072"}, {"article_id": "9679086", "title": "中職／兄弟一次增加2位重大傷兵 張志豪手腕、許基宏右膝動刀", "summary": "中信兄弟隊今天公布重大傷兵，兩位主力球星張志豪與許基宏都傳傷情，近期在經過主治醫師、教練團以及醫療防護團隊的審慎檢查與評估後，張志豪已完成手腕鉤狀骨手術，許基宏則是即將進行右膝關節鏡半月板修復手術。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212169.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&sl=W&fw=360", "date": "2026-08-08 14:22", "link": "/news/story/7001/9679086"}, {"article_id": "9679014", "title": "亞運籃球／分組賽程出爐！男籃與中東3隊競爭、女籃第3戰碰南韓", "summary": "2026名古屋亞運公布五人制籃球分組及預賽賽程出爐，中華男籃、女籃首戰比賽時間與對手確定。男籃預賽9月10日點燃戰火，女籃預賽則是9月17日登場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212077.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:36", "link": "/news/story/124981/9679014"}, {"article_id": "9679002", "title": "MLB／佐佐木朗希先發投球依舊優質 羅伯茲不排除季後賽兩頭燒", "summary": "道奇日籍投手佐佐木朗希今天在客場先發對戰響尾蛇，主投6局被敲4支安打失2分，雖然第7局道奇追平比數，讓他無關勝敗，但整體內容仍展現近期回穩狀態。不過近況低迷的道奇又是面臨未能守成的窘境，終結者迪亞茲（Edwin Díaz）慘遭瓦德史密特（Ryan Waldschmidt）敲出再見兩分砲，最終苦吞7連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212059.jpg&M=1&s=Y&x=76&y=33&sw=1144&sh=762&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:29", "link": "/news/story/6999/9679002"}, {"article_id": "9678977", "title": "足球／2012世界盃被爆曾性招待裁判 韓國足協今天公開致歉", "summary": "韓國足球國家代表隊在世足賽慘遭淘汰後，足球協會接連爆發多項醜聞，並被媒體...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212056.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:28", "link": "/news/story/7005/9678977"}, {"article_id": "9679001", "title": "MLB／迪亞茲砸鍋是否換人關門？道奇教頭：換別人投得也沒多好", "summary": "道奇隊有機會畫上句點的連敗，今天在九局下遭瓦德史密特（Ryan Waldschmidt）兩分砲一棒摧毀，終場以3：4不敵響尾蛇隊。守護神迪亞茲（Edwin Díaz）關門砸鍋，賽後被問到是否考慮終結者換人，總教練羅伯茲（Dave Roberts）直白回應：「其他人投得也沒多好。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212063.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:24", "link": "/news/story/6999/9679001"}, {"article_id": "9678965", "title": "MLB／楚奧特每逢生日超會轟！教頭鈴木清笑：希望明後天也當生日過", "summary": "天使隊球星楚奧特（Mike Trout）的生日似乎總少不了全壘打相伴。今日迎來35歲生日的「神鱒」，在天使作客馬林魚之戰再度展現自己的「生日限定」火力，首局就將一顆96.8英里速球轟向中左外野，形成一發飛行距離400英尺的陽春砲，不僅敲出本季第19轟，也幫助天使最終以4比3驚險帶走勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211995.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:09", "link": "/news/story/6999/9678965"}, {"article_id": "9678969", "title": "MLB／村上宗隆25轟超越岡本和真 獨佔日本球員大聯盟新秀全壘打紀錄", "summary": "白襪日籍重砲村上宗隆今天在主場面對守護者敲出本季第25號全壘打，超越多藍鳥強打岡本和真，獨居日本球員大聯盟新人球季全壘打紀錄第一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212000.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:00", "link": "/news/story/6999/9678969"}, {"article_id": "9678946", "title": "MLB／6支「生日砲」追平A-Rod！楚奧特：能排在那個位置滿酷的", "summary": "天使球星「神鱒」楚奧特（Mike Trout）今日為自己送上一份特別的「35歲生日禮物」，在天使作客馬林魚的比賽首局中，楚奧特敲出一發Statcast預估飛行距離400英尺的中左外野陽春砲，幫助天使最終以4比3擊敗馬林魚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212001.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:58", "link": "/news/story/6999/9678946"}, {"article_id": "9678971", "title": "MLB／李灝宇連4戰未先發代打選保送 老虎11安不敵巨人單場5安", "summary": "老虎隊台灣內野手李灝宇近期連4場比賽沒先發，今天客場出戰巨人隊，在8局上被換上場代打，選到四壞球保送上壘，但沒能跑回分數，後續也沒有上場守備，終場老虎以2：5不敵巨人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212004.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:55", "link": "/news/story/6999/9678971"}]}, {"name": "棒球", "articles": [{"article_id": "9679298", "title": "日職／孫易磊後援2局6打席、17球搞定 最速156公里飆2K", "date": "2026-08-08 17:45", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212693.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9679298"}, {"article_id": "9679086", "title": "中職／兄弟一次增加2位重大傷兵 張志豪手腕、許基宏右膝動刀", "date": "2026-08-08 14:22", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/352121