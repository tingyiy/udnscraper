to.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35219029.jpg&M=1&s=Y&x=0&y=0&sw=1107&sh=738&exp=3600&w=300", "link": "/news/story/122629/9685328"}]}, {"name": "最新文章", "articles": [{"article_id": "9694973", "title": "定向越野／一張地圖走進全民生活 北極星串聯山林探索與貓空茶文化", "summary": "中華民國定向越野協會今天（16日）舉辦「台北大縱走第七段─山林定向探索體能訓練」，由山域嚮導專家廖登山帶領親子家庭、年輕上班族及退休族群，自政治大學走入政大後山、飛龍步道、樟樹步道、貓空與指南宮。活動結合地圖判讀、手機定位、文化任務及AR擴增實境，讓健行不只是跟著隊伍前進，更是一場主動觀察、思考與認識土地的探索。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235169.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 18:13", "link": "/news/story/7005/9694973"}, {"article_id": "9694971", "title": "中職／6局吵好球帶、7局已經印好 本後龍迷高舉全彩K-Zone", "summary": "味全龍、樂天桃猿隊今天續戰台北大巨蛋，龍隊六局下的攻勢中「滿壘計」，林辰勳滿球數情況下面對1顆偏低的球未出棒遭判決好球三振，龍隊陣營情緒激動，內野守備教練陳志偉手比「2」激動抗議，儘管並未釀成大場面，但本壘後方隨後出現球迷高舉全彩列印K-Zone畫面。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 18:12", "link": "/news/story/7001/9694971"}, {"article_id": "9694951", "title": "中職／林辰勳以為保送變三振滿壘成空 龍隊教練手比「2」激動抗議", "summary": "味全龍、樂天桃猿隊今天續戰台北大巨蛋，龍隊六局下的攻勢中「滿壘計」，林辰勳滿球數情況下面對1顆偏低的球未出棒遭判決好球三振，龍隊陣營情緒激動，內野守備教練陳志偉手比「2」激動抗議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235135.jpg&M=1&s=Y&x=0&y=0&sw=1272&sh=848&exp=3600&sl=W&fw=360", "date": "2026-08-16 17:51", "link": "/news/story/7001/9694951"}, {"article_id": "9694949", "title": "中職／洲際球場賽前下大雨 兄弟雄鷹之戰因雨延至10月4日", "summary": "中信兄弟隊今天原訂在台中洲際棒球場與台鋼雄鷹隊交手，但賽前現場突然下起大雨，經等待後雨勢仍未停歇，比賽宣布延賽，將移至10月4日17：05於原場地進行補賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235156.jpg&M=1&s=Y&x=0&y=90&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-16 17:49", "link": "/news/story/7001/9694949"}, {"article_id": "9694946", "title": "NBA／詹姆斯笑稱布朗尼已成「前隊友」 父子同隊歷史轉為難忘回憶", "summary": "詹姆斯（LeBron James）如今仍在適應一個相當特別的新現實，那就是他的長子布朗尼（Bronny James）已經不只是他的兒子，也正式成為他NBA生涯中的「前隊友」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235130.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 17:46", "link": "/news/story/7002/9694946"}, {"article_id": "9694900", "title": "游泳／德國19歲小將破1500公尺自由式世界紀錄 快了近4秒", "summary": "德國19歲新星李普曼（Johannes Liebmann）今天在歐洲游泳錦標賽打破男子長水道1500公尺自由式的世界紀錄...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235131.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 17:45", "link": "/news/story/7005/9694900"}, {"article_id": "9694912", "title": "羽球／世錦賽明印度開打 周天成領銜出賽", "summary": "2026年羽球世錦賽明天將在印度新德里點燃戰火，首日賽程我國由「一哥」周天成領銜，共4組台將要先上陣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235092.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-16 17:08", "link": "/news/story/7001/9694912"}, {"article_id": "9694871", "title": "日職／孫易磊連兩天登板製造3上3下飆156公里 連5場無失分", "summary": "日職火腿隊與歐力士隊3連戰最後一場比賽，21歲台灣投手孫易磊連兩天中繼登板，7局下球隊7分領先時上場，用13球製造3上3下，最快球速達156公里，連5戰無失分，最終火腿以13：7打下二連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235048.jpg&M=1&s=Y&x=0&y=125&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 16:38", "link": "/news/story/7001/9694871"}, {"article_id": "9694776", "title": "籃球／八村壘回歸日本隊聯手河村痛宰韓國 日網友狂讚：等級不一樣", "summary": "今夏轉戰快艇的混血前鋒八村壘（Rui Hachimura）睽違2年重返日本國家隊舞台，立刻展現NBA等級身手。他在8月15日舉行的「買取大吉盃2026」國際親善賽中，率領日本以88：68大勝宿敵韓國，個人僅出賽23分40秒就攻下全隊最高22分，展現壓倒性存在感。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234881.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 15:32", "link": "/news/story/7003/9694776"}, {"article_id": "9694762", "title": "並肩淬煉！TPF攜手AR Taipei打造城市夜訓場 破百人齊聚101水舞廣場熱血開練", "summary": "TPF攜手adidas Runners Taipei於台北101水舞廣場舉辦城市夜訓，吸引上百名運動愛好者參與，備戰10月17日至18日賽事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234854.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 15:25", "link": "/news/story/7005/9694762"}, {"article_id": "9694768", "title": "MiLB／台灣投打未來有望了！柯敬賢棒打菊池雄星 沙子宸1.2局狂飆5K全場最高", "summary": "台灣投打新星有望！目前效力道奇農場1A球隊的的台灣20歲新科強打柯敬賢，今天交手天使1A，狙擊投復健賽的日本明星左投菊池雄星，成功敲安；投手方面，同樣是旅美好手的22歲新星「大沙」沙子宸，今天在運動家高A賽事中後援1.2局就狂飆5K。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234889.png&M=1&s=Y&x=0&y=7&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 15:22", "link": "/news/story/6999/9694768"}, {"article_id": "9694736", "title": "中職／遭惡球迷私訊辱罵「很爛」 富邦先發魔力藍強勢回擊", "summary": "富邦悍將昨日在主場遭統一獅大開魯閣，以1：12遭到痛宰，其中先發投手魔力藍繳出主投4.2局失4分的糟糕成績單，最終也只能吞下本季第7敗。對於這位外援的表現網友顯然「有話說」，賽後更出現惡質球迷私訊攻擊魔力藍「很爛」，而他也在個人社群發出限時動態回擊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234832.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 15:00", "link": "/news/story/7001/9694736"}, {"article_id": "9694722", "title": "中職／猿隊陣中也有「美美」 賴威誠初登板有緊張但沒那麼緊張", "summary": "樂天桃猿隊陣中也有一位「美美」，20歲的賴威誠昨天在一軍解鎖初登板，面對味全龍隊投1局無失分，總教練曾豪駒恭喜他「解鎖人生第一次」，賴威誠透露心情沒有想像中緊張，儘管是破3萬人的場合，但他專注到「沒有看到太多觀眾」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234803.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-16 14:54", "link": "/news/story/7001/9694722"}, {"article_id": "9694698", "title": "中職／下勾投手林柏佑初登板有好評 右腳那一踏掀龍將模仿大賽", "summary": "味全龍隊2023年第六輪選進的下勾投手林柏佑，昨天在台北大巨蛋初登板，獲得總教練葉君璋好評，也給出加強課題。有趣的是，下勾投球動作直接在賽後掀起龍將模仿大賽，林柏佑透露，隊友是看到土痕後，驚訝他的踩踏位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234761.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 14:28", "link": "/news/story/7001/9694698"}, {"article_id": "9694697", "title": "NBA／跑轟大師入選名人堂！ 丹東尼點名：生涯最難忘是「林來瘋」", "summary": "改變現代籃球戰術的跑轟大師丹東尼（Mike D'Antoni）今天正式入選名人堂，而他在致詞時，除了感謝當初執教的太陽團隊願意接納完全不同的球風，更是對到場的林書豪喊話「林來瘋（Linsanity）」是執教生涯最難忘時刻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234781.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-16 14:27", "link": "/news/story/7002/9694697"}, {"article_id": "9694650", "title": "羽球／全國羽球排名賽 王子維相隔10年再奪甲組男單冠軍", "summary": "2026年第2次全國羽球排名賽今天進行的甲組男單決賽上演合庫球團內戰，經驗老到的王子維以21比17、13比21、21比1...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234753.jpg&M=1&s=Y&x=0&y=226&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 14:22", "link": "/news/story/7005/9694650"}, {"article_id": "9694691", "title": "中職／劉俊緯為他自製百安看板、陳禹勳說要列隊 石翔宇：是引退嗎？", "summary": "味全龍隊石翔宇逼近生涯百安，有來自隊友的自製百安看板相挺，石翔宇笑說，也不知道為何隊友比自己還關注百安，劉俊緯寫好後馬上跟他說百安要拿出去幫他舉，陳禹勳說要列隊，讓他苦笑說：「是要引退嗎？」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234751.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 14:18", "link": "/news/story/7001/9694691"}, {"article_id": "9694620", "title": "棒球／健行小牛遺憾化動力 台中二中猛牛奪冠軍金盃", "summary": "台中健行小牛社區棒球隊3年前在全國社區大賽止步8強，高中最後的夏天，小將們再集結組隊「台中二中猛牛」，將遺憾化為動力，在...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234750.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 14:18", "link": "/news/story/7001/9694620"}, {"article_id": "9694676", "title": "中職／吉力吉撈爭議滿貫轟 曾豪駒接受判決：裁判果斷說有看到", "summary": "吉力吉撈．鞏冠化身「折射系砲手」，繼2024年8月11日新莊棒球場改判滿貫砲，昨天再於台北大巨蛋敲出備受討論的滿貫轟，對手樂天桃猿隊總教練曾豪駒還原昨天裁判給予的說明，「裁判是很果斷講他有看到經過標竿上面，所以這部分，我們還是得要接受。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35234728.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-16 14:00", "link": "/news/story/7001/9694676"}, {"article_id": "9694672", "title": "排球／U17世青賽不敵土耳其隊無緣冠軍戰 中華隊明和中國隊爭季軍", "sum