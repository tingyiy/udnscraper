thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238035.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&w=300", "link": "/news/story/122629/9696821"}]}, {"name": "最新文章", "articles": [{"article_id": "9703611", "title": "亞運空手道／三戰亞運心情更chill 辜翠萍笑稱狀況像回到18歲", "summary": "從18歲初次登上亞運舞台，30歲空手道女將辜翠萍今年將迎接個人第三屆亞運，在倒數一個月的衝刺期，她笑稱自己「很像回到18歲」，保持著開心的心情做準備。至於是不是最後一次參賽？她還不多想，但抱持「最後一次」的心態，讓自己把握當下。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35247724.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 14:19", "link": "/news/story/124981/9703611"}, {"article_id": "9703552", "title": "亞運軟網／22歲女將江旻育首度參賽 被看好奪牌熱門", "summary": "22歲江旻育首度征戰名古屋亞運，被總教練方同賢看好成為奪牌、甚至爭金熱門；她將出戰女單、混雙及女團，盼發揮最佳狀態。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35247676.jpg&M=1&s=Y&x=0&y=0&sw=1232&sh=821&exp=3600&sl=W&fw=360", "date": "2026-08-20 14:07", "link": "/news/story/124981/9703552"}, {"article_id": "9703572", "title": "TPBL／戰神簽211公分長人 克羅埃西亞國手加盟", "summary": "台北台新戰神隊今天宣布簽下克羅埃西亞籍中鋒馬利（Marin Maric），營運長楊勝凱表示，馬利身材高大，同時具備外線投射能力，能為球隊帶來更多元的戰術選擇，「馬利是一名重視團隊合作、願意與隊友溝通的球員，期待他加入後，不僅能提升禁區戰力，也能幫助團隊邁向另一個層級。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35247640.jpg&M=1&s=Y&x=1&y=256&sw=1143&sh=762&exp=3600&sl=W&fw=360", "date": "2026-08-20 14:01", "link": "/news/story/7003/9703572"}, {"article_id": "9702468", "title": "網球／「壞小子」基里洛斯古柯鹼陽性遭禁賽 坦承鑄下大錯", "summary": "澳洲網壇「壞小子」基里洛斯（Nick Kyrgios）被驗出古柯鹼呈陽性反應，遭到暫時禁賽，他今天在社群媒體上坦承自己鑄...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35247375.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-20 13:15", "link": "/news/story/7005/9702468"}, {"article_id": "9703316", "title": "MLB／道奇牛棚再失火延長賽橫掃洛磯！朗希5局6K壓制「打者天堂」", "summary": "道奇今日作客洛磯進行3連戰最終戰，儘管一度取得4分領先，卻在比賽後段遭到追平，雙方一路鏖戰至延長賽，道奇最終靠著弗里曼（Freddie Freeman）10局上敲出超前高飛犧牲打，加上貝茲（Mookie Betts）單場「3安猛打賞」、包含全壘打以及關鍵保險分打點，終場以6：4擊敗洛磯，客場3戰全勝完成橫掃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35247191.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 12:52", "link": "/news/story/6999/9703316"}, {"article_id": "9703196", "title": "NBA／金塊為躲稅線送走華森 丹佛媒體怒評「F」：浪費約柯奇奪冠窗口", "summary": "金塊今日在一筆涉及騎士、快艇、巫師和國王的5隊交易案中，將23歲前鋒華森（Peyton Watson）送往克里夫蘭，金塊則獲得不受保護的2031年騎士的首輪選秀權、2032年國王隊的次輪選秀權，以及從巫師來的里斯（Julian Reese）。然而這筆交易卻讓金塊今年休賽季的操作遭到當地媒體猛烈批評。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35247080.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 12:17", "link": "/news/story/7002/9703196"}, {"article_id": "9703205", "title": "TPBL／新賽季拚連霸 夢想家續約冠軍隊長張宗憲", "summary": "福爾摩沙夢想家隊今天宣布與冠軍功臣張宗憲續約，迎接2026-27新賽季，與團隊一同朝衛冕目標前進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246961.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 11:54", "link": "/news/story/7003/9703205"}, {"article_id": "9702621", "title": "羽球世錦賽／美18歲新星陳翝櫟男單爆冷晉級 曾說在台灣訓練「有家的感覺」", "summary": "美國18歲羽球男單新星陳翝櫟（Garret Tan）在世界錦標賽爆冷擊敗印度名將。這名新秀在南加州長大，長期赴亞洲訓練，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35247152.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 11:46", "link": "/news/story/7005/9702621"}, {"article_id": "9703029", "title": "MLB／才投3局無失分仍遭3度DFA！道奇替葛拉斯諾回歸清40人名單", "summary": "道奇今日在作客洛磯系列賽最終戰前，將右投赫南德茲（Jonathan Hernández）指定讓渡（DFA），34歲右投史都華（Brock Stewart）則移出傷兵名單，重新加入大聯盟牛棚。不過這次人員異動除了讓史都華回歸之外，還有另一層重要意義。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246666.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-20 11:25", "link": "/news/story/6999/9703029"}, {"article_id": "9703111", "title": "中職／悍將新洋投曲折人生…MLB初登板產生懷疑 轉行賣保險、太陽能板", "summary": "富邦悍將隊今天宣布簽下新洋投泰威（Tyler Ivey），2017年選秀由太空人隊第三輪挑選，自此展開的職棒故事充滿曲折，一度對棒球失去熱情，轉行銷售保險、太陽能板，卻在一場社區棒球比賽的登板，重新在指尖感受到棒球縫線帶來的悸動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246808.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-20 11:25", "link": "/news/story/7001/9703111"}, {"article_id": "9703096", "title": "TPBL／特攻第4名外援來了 全能前鋒猛士加盟", "summary": "新北中信特攻隊今天宣布簽下與美國籍前鋒猛士（Clay Mounce），預計8月下旬抵台，新賽季將披上61號黃衫戰袍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246776.jpg&M=1&s=Y&x=0&y=33&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-20 11:20", "link": "/news/story/7003/9703096"}, {"article_id": "9703082", "title": "中職／悍將簽有MLB經驗新洋投泰威 831洋將大限5取4變6取4", "summary": "富邦悍將隊積極備戰下半季賽事，今天宣布簽下右投手泰威（Tyler Ivey），擁有美國職棒大聯盟經驗，日前已抵達台灣並至二軍報到調整，加盟後進一步強化外籍戰力先發輪值的競爭力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246744.jpg&M=1&s=Y&x=0&y=0&sw=1092&sh=728&exp=3600&sl=W&fw=360", "date": "2026-08-20 11:16", "link": "/news/story/7001/9703082"}, {"article_id": "9702950", "title": "MLB／道奇塔克終結漫長安打荒！羅伯茲暖心守護：你不是一個人", "summary": "道奇季前砸下重金簽下的塔克（Kyle Tucker）在昨日7：6擊敗洛磯的比賽中終於敲出二壘安打，不僅是他自8月12日面對皇家後的第一支安打，更是自8月10日以來首支長打及打點。對於先前面臨「打守兩端」低迷的塔克，總教練羅伯茲（Dave Roberts）不僅沒有責怪，反而希望塔克知道自己並不是一個人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246557.jpg&M=1&s=Y&x=0&y=47&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-20 11:00", "link": "/news/story/6999/9702950"}, {"article_id": "9702898", "title": "瓊斯盃／中華藍分組墊底仍晉4強惹議 籃協道歉了", "summary": "第45屆威廉瓊斯盃籃球邀請賽分組循環賽已近尾聲，中華藍隊目前5戰打完只拿1勝，分組名次墊底，但因「保障名額」仍能晉級4強，引發外界與球迷間對於本屆賽制諸多討論。中華籃球協會早上發出聲明，對於賽制改變造成各方熱議表達歉意，未來將持續改進瓊斯盃賽程編排方案，符合球迷期待也讓來訪的國外球隊享受比賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246435.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:30", "link": "/news/story/7003/9702898"}, {"article_id": "9702856", "title": "MLB／道奇終結者正式換人！羅伯茲盛讚史考特擁有「超能力」", "summary": "隨著道奇終結者迪亞茲（Edwin Diaz）因頸部發炎進入15天傷兵名單，道奇季末衝刺階段的終結者人選也正式出現變化。總教練羅伯茲（Dave Roberts）今日明確表示，以目前的投球狀態來看，史考特（Tanner Scott）就是球隊現階段最好的後援投手，並將他定位為道奇終結者。甚至認為史考特擁有真正的「超能力」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246313.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:23", "link": "/news/story/6999/9702856"}, {"article_id": "9702840", "title": "MLB／道奇狄亞茲MRI結果出爐！羅伯茲透露：最理想的情況", "summary": "道奇終結者迪亞茲（Edwin Diaz）昨日因頸部發炎被放進傷兵名單，考量到他本季已多次受到傷勢影響，加上近期投球狀況持續低迷，一度讓外界擔心是否又出現更嚴重的身體問題。不過今日檢查結果出爐，總教練羅伯茲（Dave Roberts）也終於帶來好消息。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246270.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:18", "link": "/news/story/6999/9702840"}, {"article_id": "9702836", "title": "NBA／金塊沒留住替補悍將！華森5隊交易案轉戰騎士", "summary": "騎士、金塊和快艇隊達成交易協議，華森（Peyton Watson）將從金塊被送去騎士，史特魯斯（Max Strus）從騎士轉戰快艇，這筆交易還包括巫師隊和國王隊，是一筆牽涉5隊的交易案。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246274.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:06", "link": "/news/story/7002/9702836"}, {"article_id": "9702798", "title": "NBA／沒想到那麼快！22歲溫班亞瑪接法國隊長", "summary": "雖只有22歲，馬刺隊長人溫班亞瑪（Victor Wembanyama）已經展現領袖氣息，他的領導力也將延續到法國國家隊，以隊長身分率隊出征FIBA世界盃的歐洲區資格賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246233.jpg&M=1&s=Y&x=0&y=39&sw=820&sh=547&exp=3600&sl=W&fw=360", "date": "2026-08-20 09:53", "link": "/news/story/7002/9702798"}, {"article_id": "9702665", "title": "MLB／跑打守俱佳！李灝宇對決海盜塞揚史肯斯敲安 三度上壘跑回2分", "summary": "老虎隊前進匹茲堡對決海盜隊3連戰最後一場比賽，台灣內野手李灝宇先發上陣，對決海盜塞揚強投史肯斯（Paul Skenes）首打席就敲安，單場還選到2次保送上壘、跑回2分，跑、打、守都有好表現，但終場海盜以3：4遭逆轉吞敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246036.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 08:31", "link": "/news/story/6999/9702665"}, {"article_id": "9702610", "title": "MLB／李灝宇對塞揚強投史肯斯敲安、積極跑壘 惜老虎遭逆轉", "summary": "台灣好手李灝宇今天面對美國職棒頂級強投、去年賽揚獎得主史肯斯，不僅敲出安打，更展現積極的跑壘態度，為球隊貢獻分數。可惜李...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246220.jpg&M=1&s=Y&x=0&y=0&sw=1230&sh=820&exp=3600&sl=W&fw=360", "date": "2026-08-20 08:03", "link": "/news/story/6999/9702610"}, {"article_id": "9701544", "title": "山本由伸投球策略改變依舊強 不求三振只求出局投更長", "summary": "你有沒有發現山本由伸今年三振變少了？他的三振率由去年的10.4下滑到8.4，但這並不代表他的投球能力下滑，因為他的防禦率仍為國聯第5的2.60，WHIP更是高居全聯盟第2的0.89。他不求三振只求出局的投球策略反而讓他用球數更精簡、投得更長，依舊是大聯盟頂尖的王牌投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35244967.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 07:00", "link": "/news/story/122629/9701544"}, {"article_id": "9701580", "title": "投手沒王牌靠打擊 中華隊征戰女棒世界盃分組賽大解析", "summary": "2026女棒世界盃台南分組賽8月23日開打，中華隊投手缺王牌，將靠打擊與車輪戰搶勝，力拚前三戰全勝爭取晉級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35244804.jpg&M=1&s=Y&x=67&y=0&sw=1183&sh=789&exp=3600&sl=W&fw=360", "date": "2026-08-20 07:00", "link": "/news/story/122629/9701580"}, {"article_id": "9702504", "title": "羽球世錦賽／美國羽球新星陳翝櫟爆冷晉級 家族與台灣淵源偶赴台訓練", "summary": "美國18歲羽球男單新星陳翝櫟（Garret Tan）今天在印度新德里舉行的世界羽球錦標賽中，爆冷擊敗印度好手森恩，讓主場...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246033.jpg&M=1&s=Y&x=317&y=148&sw=768&sh=512&exp=3600&sl=W&fw=360", "date": "2026-08-20 03:16", "link": "/news/story/7005/9702504"}, {"article_id": "9702207", "title": "中職／劉時豪驚天3分砲助雄鷹逆轉勝 陳鏞基台東告別戰2打點謝幕", "summary": "「台灣轟炸機」陳鏞基生涯在家鄉台東的最後一場出賽，所屬的統一獅隊兩度領先都沒能守成；台鋼雄鷹在8局下靠著捕手劉時豪轟出驚天3分砲一棒逆轉，終場以8：6擊敗獅隊，終止主場6連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245568.jpg&M=1&s=Y&x=0&y=0&sw=12