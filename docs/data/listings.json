/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549887.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9899595"}, {"article_id": "9896894", "title": "中職／傷勢纏身加上一軍沒空間 昔日兄弟幫同被戰力外機會高", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35547631.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&w=300", "link": "/news/story/122629/9896894"}, {"article_id": "9896592", "title": "從火箭MVP到本季再轟51分 哈登不當得分王反而更接近冠軍？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545611.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9896592"}, {"article_id": "9897021", "title": "向下沈淪一言難盡 墨瑞喊「賣我」成壓垮鵜鶘最後稻草", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546242.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9897021"}, {"article_id": "9894619", "title": "中職／3大年輕「台製潛水艇」國際賽發光 壓制左打未來才能發熱", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542170.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9894619"}, {"article_id": "9894636", "title": "道奇用兩名普通球員就換來雙城前狀元 這帳是怎麼算的？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542228.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9894636"}]}, {"name": "最新文章", "articles": [{"article_id": "9900762", "title": "MLB／不打日職直闖洋基！火球男廣池浩成有望終結洋基「日本荒」", "summary": "根據《紐約郵報》報導，洋基已和22歲的日本右投廣池浩成達成小聯盟合約，並預計11月29日赴美，到洋基位於佛州的春訓基地接受體檢。值得注意的是，這筆簽約有望終結洋基從田中將大2020年後的「日本球員荒」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551567.jpg&M=1&s=Y&x=148&y=0&sw=1013&sh=675&exp=3600&sl=W&fw=360", "date": "2026-11-25 12:30", "link": "/news/story/6999/9900762"}, {"article_id": "9900680", "title": "NBA／ 新人王熱門成破口？勇士倫德伯格防守數據聯盟倒數1%", "summary": "勇士新秀倫德伯格雖場均20.2分成新人王熱門，但在場防守效率121.0，落差居聯盟倒數1%；他坦言防守需改進，仍盼拚全明星。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551622.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 12:16", "link": "/news/story/7002/9900680"}, {"article_id": "9900641", "title": "NBA／「聽說MJ要退休了？」 前隊友分享Kobe棄學闖NBA原因", "summary": "根據《紐約郵報》報導，曾與已故湖人傳奇布萊恩（Kobe Bryant）並肩奪冠的沙利（John Salley），在史考特（Byron Scott）的節目《Fast Break》時，揭開了布萊恩當年高中畢業直接投入1996年選秀，竟和「籃球之神」喬丹（Michael Jordan）有關的往事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551374.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 12:02", "link": "/news/story/7002/9900641"}, {"article_id": "9900741", "title": "NBA／傳詹姆斯經紀人兜售墨瑞 慘遭勇士打槍", "summary": "墨瑞（Dejounte Murray）日前向鵜鶘隊喊賣我，但交易市場上乏人問津，傳出詹姆斯（LeBron James）經紀人保羅（Rich Paul）向勇士隊兜售墨瑞遭到打槍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551538.jpg&M=1&s=Y&x=185&y=24&sw=1095&sh=730&exp=3600&sl=W&fw=360", "date": "2026-11-25 12:02", "link": "/news/story/7002/9900741"}, {"article_id": "9900737", "title": "NBA／差點虛擲34分領先！ 泰托姆轟41分率綠衫軍退巫師止4連敗", "summary": "塞爾蒂克隊今天NBA盃火力全開，客場出賽但上半場就轟下80分，最多34分領先雖在第四節被巫師隊一度追到7分差，靠當家球星泰托姆（Jayson Tatum）挺身而出，最終仍以131：116守下勝利，止住近期4連敗．", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551570.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 12:00", "link": "/news/story/7002/9900737"}, {"article_id": "9900534", "title": "NBA／「別被戰績騙了！」 《ESPN》預言76人未來會跌出前4", "summary": "昨日76人在主場以111：128不敵拓荒者，吞下本季首場對西區球隊的比賽就輸球。然而真正讓費城球迷坐不住的，是《ESPN》記者的大膽預言，直言76人本季不會拿到東區前4種子。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551142.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 11:55", "link": "/news/story/7002/9900534"}, {"article_id": "9900642", "title": "MLB／老虎官方曬2026年10大最拚好球 李灝宇撲壘後怒吼入選第9", "summary": "老虎隊官方今天整理出2026年「10大最拚精彩好球」，台灣好手李灝宇敲出清壘長打後怒吼，獲選第9。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551377.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 11:37", "link": "/news/story/6999/9900642"}, {"article_id": "9900473", "title": "NBA／勇士助教怒轟防守跟屎一樣！ 傷兵威廉斯乾著急：真的難受", "summary": "勇士前日在主場以88：87險勝塞爾蒂克後，成功終止柯瑞（Stephen Curry）傷後5連敗，甚至把對手壓在87分，末節更只讓塞爾蒂克拿下12分。然而在此之前，勇士防守一度全面崩盤。根據《ClutchPoints》報導，曾帶湖人奪冠的助理教練佛蓋爾（Frank Vogel）與助教魯賓（Jacob Rubin）甚直接對球員開罵：「各位，這防守跟屎一樣，真的很爛。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551016.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 11:13", "link": "/news/story/7002/9900473"}, {"article_id": "9900495", "title": "NBA／夯！開幕首月吸7500萬人觀看 刷新多項聯盟收視紀錄", "summary": "美國職籃2026-27賽季開幕第一個月收視開紅盤，全美透過NBC／Peacock、Amazon Prime Video及ESPN收看NBA比賽的人數超過7500萬人，創下NBA歷史新紀錄，比去年同期成長20%。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551048.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:57", "link": "/news/story/7002/9900495"}, {"article_id": "9900496", "title": "運動部與美國在台協會攜手建立合作 拓展運動交流與人才培育", "summary": "美國在台協會（AIT）文化新聞組司馬騰（Matthew Cenzer）組長日前率團拜會運動部，政務次長黃啟煌代表接見，雙方就運動交流、人才培育、國際領袖人才參訪、運動科技發展及教育資源等議題交換意見，也為台美雙方奠定長期合作基礎。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551042.jpg&M=1&s=Y&x=0&y=0&sw=1094&sh=729&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:56", "link": "/news/story/7005/9900496"}, {"article_id": "9900484", "title": "NBA／3大先發缺陣奇兵喬伊21分頂缺口 活塞逆轉魔術終止連敗", "summary": "近期苦吞2連敗的活塞隊，今天客場之旅來到奧蘭多作客魔術隊主場，一度出現開賽慢熱問題陷入落後，不過靠著第二節單節猛轟32分逆轉戰局，以及第四節關鍵時刻成功靠防守壓制魔術，最終以104：86擊敗魔術終止連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551064.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:55", "link": "/news/story/7002/9900484"}, {"article_id": "9900427", "title": "MLB／洋基搶輸「左投剋星」！ 全能外野手泰勒2年短約加盟白襪", "summary": "儘管前小熊外野手泰勒（Tyrone Taylor）最後沒離開芝加哥，卻換了一身球衣。根據《MLB.com》報導，白襪今日從洋基在內的追逐者中勝出，並以2年1700萬美元成功簽下，加上泰勒的打擊特性以及多守備功能，讓白襪明年分配外野手的上場時間時更有彈性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35551023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:52", "link": "/news/story/6999/9900427"}, {"article_id": "9900468", "title": "中職／樂天桃猿簽下日籍育成右投 金澤智也最快球速達154公里", "summary": "樂天桃猿球團季後補強持續進行，今天宣布與日本獨立聯盟BC聯盟信濃大羚羊隊投手金澤智也達成合約共識，簽下育成洋將合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550998.jpg&M=1&s=Y&x=0&y=0&sw=699&sh=466&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:48", "link": "/news/story/7001/9900468"}, {"article_id": "9900433", "title": "棒球／DAZN將中信盃黑豹旗推向國際 台灣高中棒球首度登上日本轉播舞台", "summary": "DAZN首度將中信盃黑豹旗賽事推向海外，讓台灣高中棒球登上日本轉播舞台。2026年中信盃第14屆黑豹旗全國高中棒球大賽將於11月25日展開八強決戰，DAZN Japan將在當天上午10點南英商工與衛冕軍平鎮高中的傳統勁旅對決揭開轉播序幕，接續直播兩場四強賽及冠軍戰，共計四場賽事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550945.jpg&M=1&s=Y&x=0&y=27&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:39", "link": "/news/story/7001/9900433"}, {"article_id": "9900280", "title": "TPBL／選舉周特意未排賽程 聯盟鼓勵返鄉行使公民權利", "summary": "隨著2026年九合一選舉進入倒數計時，台灣職業籃球大聯盟TPBL本週末特意未安排賽程，副秘書長程柏仁表示，希望鼓勵大家返...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550939.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:37", "link": "/news/story/7003/9900280"}, {"article_id": "9900388", "title": "MLB／光芒只用半季！美聯冠軍賽MVP培洛塔轉戰金鶯 合約破隊史紀錄", "summary": "金鶯隊剛失去王牌左投羅傑斯（Trevor Rogers），立刻以5年1.25億美元破隊史紀錄合約，網羅美聯冠軍賽MVP培洛塔（Freddy Peralta），補強先發輪值戰力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550863.jpg&M=1&s=Y&x=14&y=0&sw=1040&sh=694&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:23", "link": "/news/story/6999/9900388"}, {"article_id": "9900367", "title": "MLB／能否「守護」玻璃左臂？道奇明星左投轉戰克里夫蘭", "summary": "根據《ESPN》記者帕山（Jeff Passan）報導，守護者今日完成休賽季第一筆重要補強，與現年29歲左投布比奇（Kris Bubic）達成1年1750萬美元合約。值得注意的是，儘管布比奇2025曾入選全明星，卻只簽下1年約，大聯盟官網球評雷諾茲（Harold Reynolds）直呼「很意外，只有1年」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550811.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:14", "link": "/news/story/6999/9900367"}, {"article_id": "9900362", "title": "NBA／恭喜！溜馬主控哈利伯頓升格當爸 明年春天迎接寶寶", "summary": "溜馬隊當家後衛哈利伯頓（Tyrese Haliburton）7月完成終身大事，今天再宣布邁入人生新里程，他和太太潔德（Jade Haliburton）升格父母，預計明年春天迎接第一個孩子到來。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550850.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-25 10:08", "link": "/news/story/7002/9900362"}, {"article_id": "9900289", "title": "MLB／老虎一年約簽下31歲金河成 李灝宇、鄭宗哲再添競爭者", "summary": "31歲韓籍內野手金河成連續3年投入自由市場，在揮別傷勢所苦後，新球季將轉戰老虎隊，雙方簽下一紙1年500萬美元的合約，也是目前老虎內野繼台灣好手李灝宇、鄭宗哲後再添亞洲競爭者，然而目前老虎40人名單已滿編，勢必需再做出人員異動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550681.jpg&M=1&s=Y&x=0&y=157&sw=1044&sh=696&exp=3600&sl=W&fw=360", "date": "2026-11-25 09:41", "link": "/news/story/6999/9900289"}, {"article_id": "9900286", "title": "網球／高調示愛成追憶？謝爾頓、崔妮蒂傳出分手", "summary": "今年美網大方曬恩愛的美國足壇身價最高的女將崔妮蒂（Trinity Rodman）和同胞網球好手謝爾頓（Ben Shelton），驚傳已經結束近兩年的情侶關係，最先刊出兩人分手消息的《每日郵報》指出，兩人各自繁忙的行程是無法維持關係的主要原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550687.jpg&M=1&s=Y&x=0&y=0&sw=1265&sh=843&exp=3600&sl=W&fw=360", "date": "2026-11-25 09:40", "link": "/news/story/7005/9900286"}, {"article_id": "9900231", "title": "MLB／FA市場「最獨特投手」 平良海馬5年8千萬美元加盟藍鳥", "summary": "西武獅隊27歲投手平良海馬季後透過入札制度挑戰大聯盟，今天揭曉新東家，根據《ESPN》記者帕森（Jeff Passan）報導，平良海馬與藍鳥隊達成5年8000萬美元（約新台幣25.6億元）的合約協議，將補強藍鳥隊的先發輪值深度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550591.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-25 09:15", "link": "/news/story/6999/9900231"}, {"article_id": "9900184", "title": "NBA／又要再休一周！暴龍11月等不到雷納德回歸", "summary": "兩度獲得總冠軍賽MVP的暴龍隊球星雷納德（Kawhi Leonard），新賽季只打兩場比賽就因左膝腫脹高掛免戰牌，回歸時程更一延再延；暴龍球團月初雖宣布雷納德已完成治療，將在多倫多主場重返賽場，但上周宣布雷納德至少會再休息一周，今天再發出通知，一周後會再更新雷納德狀況，代表回歸時程繼續延後。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550582.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-25 08:46", "link": "/news/story/7002/9900184"}, {"article_id": "9900110", "title": "網球／膝傷保守治療未見起色 球王接班人辛納動刀盼早日回歸", "summary": "義大利網球名將辛納（Jannik Sinner）今天宣布，已順利完成改善髂脛束的小型手術，正式展開復健之路；自7月溫布頓網球錦標賽奪冠後便高掛免戰牌的他，也在聲明中向球迷喊話「很快就會再見！」期盼早日重返賽場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550581.jpg&M=1&s=Y&x=0&y=85&sw=1152&sh=768&exp=3600&sl=W&fw=360", "date": "2026-11-25 07:46", "link": "/news/story/7005/9900110"}, {"article_id": "9900103", "title": "NBA／灰狼迪文森佐獲准投入訓練 鎖定元旦復出", "summary": "儘管少了當家球星愛德華（Anthony Edwards），但依舊在西區殺出一條血路的灰狼，如今後場再傳好消息，去年季後賽遭遇阿基里斯腱重傷的後衛迪文森佐（Donte DiVincenzo），近日已獲球團許可投入籃球相關訓練，並將本季首秀目標鎖定在元旦前後。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550573.jpg&M=1&s=Y&x=383&y=0&sw=770&sh=513&exp=3600&sl=W&fw=360", "date": "2026-11-25 07:34", "link": "/news/story/7002/9900103"}]}, {"name": "棒球", "articles": [{"article_id": "9900468", "title": "中職／樂天桃猿簽下日籍育成右投 金澤智也最快球速達154公里", "date": "2026-11-25 10:48", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/25/35550998.jpg&M=1&s=Y&x=0&y=0&sw=699&sh=466&exp=3600&w=300", "link": "/news/story/7001/9900468"}, {"article_id": "9900433", "title": "棒球／DAZN將中信盃黑豹旗推向國際 台灣高中棒球首度登上日本轉播舞台", "date": "2026-11-25 10:39