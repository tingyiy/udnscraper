hoto.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381461.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9789253"}, {"article_id": "9785936", "title": "道奇四王牌加持三連霸呼聲高 大谷翔平功力恢復幾成是關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/30/35376663.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9785936"}, {"article_id": "9784325", "title": "中職／悍將晉級機會只有3成 不如大膽尋求出奇制勝", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35374021.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9784325"}, {"article_id": "9783917", "title": "再度從美東火藥庫脫穎而出 光芒上演黑馬傳奇靠什麼？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/29/35373494.jpg&M=1&s=Y&x=0&y=0&sw=1225&sh=816&exp=3600&w=300", "link": "/news/story/122629/9783917"}, {"article_id": "9781613", "title": "中職／投打過度仰賴資深球員 台鋼win now不成得要顧養成了", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35370003.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9781613"}]}, {"name": "最新文章", "articles": [{"article_id": "9793086", "title": "林唯均四強落敗 跆拳道收1銀2銅", "summary": "名古屋亞運跆拳道對打最後一天賽事，上屆杭州亞運奪下銀牌的林唯均在女子五十七公斤級登場，先是在八強賽踢退巴黎奧運銀牌得主伊朗基亞尼，不過四強賽遭遇廿一歲的中國大陸新星張楚玲，在前兩回合與對手踢成平手的情況下，最終仍是以一比二敗下陣來，銅牌作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387261.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 00:15", "link": "/news/story/124981/9793086"}, {"article_id": "9793083", "title": "金牌的手不好握 詹謝情結延燒名古屋亞運", "summary": "名古屋亞運女雙金牌戰昨天上演「台灣內戰」，謝淑薇、詹皓晴兩人的互動成為最大關注焦點，賽後謝淑薇面對詹皓晴伸手釋出的善意，僅舉起手摸了摸帽子，接著轉身離開，兩人仍舊沒握手，受訪時再隔空交鋒，火花十足。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35387387.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-04 00:15", "link": "/news/story/124981/9793083"}, {"article_id": "9793092", "title": "連十屆摘牌 女壘火力全開 擊退菲律賓奪銅牌", "summary": "名古屋亞運壘球賽事昨天落幕，中華隊與菲律賓進行銅牌戰，我國打線火力全開，單場十三支安打包括三發全壘打，提前四局以十二比二擊退對手，連續兩屆獲銅牌。結果雖不盡如人意，但隊長沈嘉玟說「這段經歷我們會記很久」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387293.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-04 00:14", "link": "/news/story/124981/9793092"}, {"article_id": "9793096", "title": "40歲網將謝淑薇 再戰亞運 收女雙第一金", "summary": "中華代表團在本屆名古屋亞運的第五金，昨天落在網球賽場，女雙金牌戰連續兩屆上演台灣內戰， 謝淑薇與梁恩碩搭檔，以六比四、四比六、十比五擊敗詹皓晴／吳芳嫺，台灣組合「金包銀」。中華代表團單日則進帳一金一銀三銅，目前以五金十七銀卅三銅的成績迎接閉幕日。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35387379.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-04 00:12", "link": "/news/story/124981/9793096"}, {"article_id": "9793090", "title": "微笑球后曾雅妮 率中華女團亞運高爾夫奪銅牌", "summary": "名古屋亞運高爾夫球昨天迎來最終輪，我國好手曾雅妮、徐薇淩與錢珮芸在女子組賽事攜手奮戰，雖然個人賽分別以並列第九名與兩個並列第十一名作收，但女團四輪合計總桿數五五○桿險勝南韓，幫助中華女團奪下銅牌，這也是繼二○一○年廣州亞運後女團再度站上高爾夫頒獎台。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387292.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 00:11", "link": "/news/story/124981/9793090"}, {"article_id": "9793078", "title": "運動人生／鐵血「女魔頭」 最溫暖的擺渡人", "summary": "「高中某場國手選拔賽，我早早被淘汰，扛起全隊庶務工作，哭著去替隊友買水、買茶葉蛋，我發誓不再當『淘汰郎』。」林宜螢說，她的射箭人生遭遇過許多挫折，如今她用這些失敗與挫折來當教材，鼓勵學生養成跌倒再爬起來的勇氣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387244.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 00:00", "link": "/news/story/7005/9793078"}, {"article_id": "9793049", "title": "運動人生／銜接制度保障選手、建人才庫", "summary": "「遇到可能沒奪牌機會的學生，我會嘗試詢問是否想挑戰其他領域」。林宜螢表示，體育其實只是一種選擇，要用什麼態度面對則是人生的際遇，她很鼓勵學生找尋第二興趣，不要只有體育一種選擇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_6.jpg", "date": "2026-10-04 00:00", "link": "/news/story/7005/9793049"}, {"article_id": "9793078", "title": "運動人生／鐵血「女魔頭」 最溫暖的擺渡人", "summary": "「高中某場國手選拔賽，我早早被淘汰，扛起全隊庶務工作，哭著去替隊友買水、買茶葉蛋，我發誓不再當『淘汰郎』。」林宜螢說，她的射箭人生遭遇過許多挫折，如今她用這些失敗與挫折來當教材，鼓勵學生養成跌倒再爬起來的勇氣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387244.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-04 00:00", "link": "/news/story/7005/9793078"}, {"article_id": "9792965", "title": "【專家之眼】亞運台網女雙 「金包銀」內戰與握手爭議", "summary": "本屆亞運網球賽最熱門的話題，不是拿了幾面獎牌，而是謝淑薇對上詹皓晴的女雙金牌戰，結束後兩人是否在網前握手。為了一睹這場「金包銀」內戰的結局，國內媒體紛紛湧進球場，備好相機盯著，連轉播的體育台也排除萬難，突破大會不提供訊號的障礙，自架單台攝影機，甚至臨時找棒球主播來支援。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387143.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 22:06", "link": "/news/story/124981/9792965"}, {"article_id": "9792937", "title": "第三屆L’Étape環法自行車挑戰賽寫下新里程 傳奇車手Peter Sagan與2700名車友騎進日月潭", "summary": "「2026 L’Étape by Tour de France環法自行車挑戰賽－紐崔萊・日月潭站」今天（3日）盛大登場，第三屆賽事規模再創新高，更迎來全球唯一完成UCI公路世界錦標賽男子菁英公路賽三連霸的環法傳奇車手Peter Sagan親自參賽，與國內外車友共享賽道。賽事更首度透過DAZN進行直播，將日月潭的競速畫面與沿途風景同步傳送給更多國內外觀眾。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387101.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-10-03 21:27", "link": "/news/story/7005/9792937"}, {"article_id": "9792933", "title": "中職／獅擊敗龍近期4連勝 王鏡銘睽違8年再奪救援成功", "summary": "中職統一7-ELEVEn獅隊今天延續氣勢以5比3擊敗味全龍隊、近期4連勝；獅隊40歲投手王鏡銘睽違8年再進帳救援成功，龍...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387100.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 21:24", "link": "/news/story/7001/9792933"}, {"article_id": "9792928", "title": "中職／亞運之力！黃韋盛敲致勝三壘打 卻不知封王劇本「我數學不好」", "summary": "黃韋盛從名古屋亞運歸來後，今天貢獻一支滿壘清壘三壘打，幫助中信兄弟隊以3：0擊敗富邦悍將隊，下半季封王魔術數字M1，賽後看到黃色彩帶沒拋下，才知道另一地戰況，封王還要再等等。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387087.jpg&M=1&s=Y&x=0&y=0&sw=996&sh=664&exp=3600&sl=W&fw=360", "date": "2026-10-03 21:07", "link": "/news/story/7001/9792928"}, {"article_id": "9792900", "title": "中職／桃猿單局攻6分翻轉戰局 保續拚季後賽門票機會", "summary": "中職樂天桃猿爭下半季冠軍關鍵期，桃猿隊今天一度4分落後，7局下攻勢串聯單局攻下6分、翻轉戰局，終場以7比5擊敗台鋼雄鷹，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387073.jpg&M=1&s=Y&x=0&y=61&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-03 21:03", "link": "/news/story/7001/9792900"}, {"article_id": "9792911", "title": "中職／「中2日」登板無心插柳成勝投王 勝騎士：羅戈明天會拿12勝", "summary": "中信兄弟隊今天以3：0擊敗富邦悍將隊，下半季封王魔術數字下修M1，勝騎士「中2日」登板，一舉盜走勝投，並登頂勝投王寶座。勝騎士收到此戰任務義不容辭，奪勝在意料之外，賽後直接預言：「明天羅戈會拿到第12勝，成為勝投王。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387062.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 20:49", "link": "/news/story/7001/9792911"}, {"article_id": "9792878", "title": "中職／說好「不一樣」終究是夢一場 悍將連10季未打總冠軍賽破紀錄", "summary": "富邦悍將隊的季後賽美夢，終究在拚戰118場後醒了，今天以0：3輸給中信兄弟隊，確定悍將通往季後賽的最後一條路也成為死路，成軍10季只打過1次季後賽、0次總冠軍賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387032.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 20:14", "link": "/news/story/7001/9792878"}, {"article_id": "9792872", "title": "你今天運動了嗎？廟埕揮拍等你來挑戰…白天匹克球 晚上歌手唱乎你聽", "summary": "「2026鹿耳門匹克球嘉年華」今天（3日）上午10點在台南正統鹿耳門聖母廟登場，從匹克球體驗、趣味闖關及拍照打卡同步展開，將匹克球運動結合在地文化與假日活動。現場陸續有民眾拿起球拍下場體驗，從實際揮拍、擊球到趣味挑戰，也讓不同年齡層的民眾都能一起體驗匹克球的樂趣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35387026.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 20:08", "link": "/news/story/7005/9792872"}, {"article_id": "9792831", "title": "亞運跆拳道／水要有流動才會新鮮 總教練蘇泰源大膽換血率隊重回軌道", "summary": "名古屋亞運跆拳道賽事今天落幕，中華隊最終繳出1銀2銅的成績單，相隔7年再度接掌國家隊兵符的總教練蘇泰源，賽後首度吐露心路歷程，坦言接任初期看到台灣與國際技術的巨幅差距曾被「嚇到」，甚至動過後悔念頭，但他堅持大膽啟用新生代，直言「水要有流動才會新鮮」，如今看到子弟兵重回競爭軌道，深信台灣選手實力絕不輸人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386999.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 19:29", "link": "/news/story/124981/9792831"}, {"article_id": "9792821", "title": "NBA／唐西奇爭監護權提「海牙公約」 盼申請將兩女兒帶到洛城", "summary": "洛杉磯湖人球星唐西奇（Luka Doncic）正陷入女兒監護權爭議。據《California Post》引述消息來源確認，唐西奇已提出「海牙公約」相關申請，希望讓2名女兒從斯洛維尼亞前往美國。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386981.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 19:18", "link": "/news/story/7002/9792821"}, {"article_id": "9792818", "title": "NBA／拓荒者新主播上任數小時遭撤換 昔厭女歧視言論曝光踩紅線", "summary": "波特蘭拓荒者才剛宣布新任電視賽事主播人選，就在數小時後火速撤回任命。原本獲聘擔任新球季播報主播的貝爾（Braiden Bell），因過去在社群平台X上的舊發文被翻出，內容涉及厭女與種族歧視言論，拓荒者隨即宣布不再與他合作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386978.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-03 19:09", "link": "/news/story/7002/9792818"}, {"article_id": "9792730", "title": "亞運網球／謝淑薇奪金頻誇搭檔梁恩碩：妳球很猛我才很有威脅力", "summary": "名古屋亞運網球女雙金牌戰落幕，謝淑薇／梁恩碩以6：4、4：6、10：5擊敗詹皓晴／吳芳嫺，在「台灣內戰」中勝出，摘下本屆我國代表團第5金，謝淑薇個人亞運女雙首金入袋，賽後頻誇搭檔，「主要功臣就是恩碩，多誇獎我們年輕人。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386788.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 17:29", "link": "/news/story/124981/9792730"}, {"article_id": "9792716", "title": "日職／日媒直言小園海斗難挑戰大聯盟 不如考慮到台灣等地打球", "summary": "日本2026經典賽國手小園海斗遭戰力外，震驚日本球界。日媒《Daily新潮》分析小園未來可能的去向，提到來台灣打球的可能。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386770.jpg&M=1&s=Y&x=355&y=14&sw=741&sh=494&exp=3600&sl=W&fw=360", "date": "2026-10-03 17:15", "link": "/news/story/7001/9792716"}, {"article_id": "9792703", "title": "亞運網球／詹皓晴釋出善意未獲回應 搭檔吳芳嫺笑稱：金牌的手不好握", "summary": "名古屋亞運網球詹皓晴尋求女雙衛冕失利，賽後釋出善意想與謝淑薇握手致意，結果未獲回應，她自認已經做好該做的，搭檔吳芳嫺則笑...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386392.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 17:09", "link": "/news/story/124981/9792703"}, {"article_id": "9792664", "title": "中職／悍將下放3主力 曾峻岳盼進季後賽：我還能丟", "summary": "中華職業棒球大聯盟富邦悍將隊陣容今天異動，下放3名主力包括投手曾峻岳、野手范國宸與王苡丞到二軍，但如果悍將闖進季後賽，曾...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386709.jpg&M=1&s=Y&x=0&y=84&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 16:49", "link": "/news/story/7001/9792664"}, {"article_id": "9792658", "title": "亞運網球／「喜歡別人主動找」 謝淑薇奪金後問梁恩碩：是妳找我的吧？", "summary": "本屆名古屋亞運網球賽事從開打前就話題不斷，謝淑薇暌違12年再戰亞運，與梁恩碩搭配，在金牌戰擊敗另一組台灣搭檔詹皓晴／吳芳嫺摘回金牌，賽後滿面笑容，多次大讚梁恩碩「表現得很棒」，也頻頻向梁恩碩確認，「是妳找我的吧？」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386684.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-03 16:31", "link": "/news/story/124981/9792658"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9792578", "title": "亞運網球／與詹皓晴賽後沒握手零互動 謝淑薇：對手不尊重我就沒什麼好說", "date": "2026-10-03 15:21", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386538.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/124981/9792578"}, {"article_id": "9792610", "title": "亞運網球／打定主意和謝淑薇握手卻沒握到 詹皓晴：每個人都有選擇", "date": "2026-10-03 15:53", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386611.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9792610"}, {"article_id": "9792658", "title": "亞運網球／「喜歡別人主動找」 謝淑薇奪金後問梁恩碩：是妳找我的吧？", "date": "2026-10-03 16:31", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/03/35386684.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/124981/9792658"}, {"article_id": "9792730", "title"