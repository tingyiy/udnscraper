"thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35263941.jpg&M=1&s=Y&x=115&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9713858"}]}, {"name": "最新文章", "articles": [{"article_id": "9721831", "title": "瓊斯盃／泰國再度單節僅拿1分 中華白多點開花奪下第5名", "summary": "瓊斯盃女子組賽事在今天展開最後一天賽程，首場比賽就由中華白與泰國進行本屆賽事第5名之爭，儘管首節兩隊還一度拉鋸，但泰國卻連續兩天出現單節僅拿1分的表現，讓中華白在第二節拉開差距，最終中華白更在5人得分上雙下，以93：35奪下本屆賽事首勝與第5名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276190.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 16:23", "link": "/news/story/7003/9721831"}, {"article_id": "9721824", "title": "NBA／控訴K教練無視求助！前雷霆球員辛格勒精神狀態引擔憂", "summary": "前NBA球員辛格勒（Kyle Singler）最近在社群平台發布許多令人擔憂的影片，公開點名杜克大學名帥K教練（Mike Krzyzewski），無視自己的求助。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276179.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 16:21", "link": "/news/story/7002/9721824"}, {"article_id": "9721827", "title": "中職／獅隊與7新秀完成簽約 首輪內野手黃靖哲合約總額640萬加盟", "summary": "統一獅隊在今年中職季中選秀會挑中7名新秀，並在本周全數完成簽約，其中首輪選進的18歲內野手黃靖哲，簽約金加上激勵獎金，合約總額達640萬元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276184.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 16:20", "link": "/news/story/7001/9721827"}, {"article_id": "9721807", "title": "中職／雄鷹急轉彎取消陳曉東演出 球團聲明：避免模糊賽事", "summary": "台鋼雄鷹隊中秋連假前進台北大巨蛋擔任主場球隊，賽後演出藝人近期陸續曝光，公布9月26日由陳曉東擔任演出嘉賓後引發熱議，今天球團轉彎宣布取消他的演出。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276172.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 16:03", "link": "/news/story/7001/9721807"}, {"article_id": "9721796", "title": "中職／江少慶前役1局收工坦言還想續投 狀況「舒服」迎明天先發", "summary": "統一獅隊投手江少慶在23日暌違111天再次登板，先發1局用29球退場，身體狀況一切正常，明天獲得再次登板先發的機會，江少慶說：「就一步一步來，教練給我的指令、任務，就上去完成投球。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276153.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 15:55", "link": "/news/story/7001/9721796"}, {"article_id": "9721759", "title": "MLB／ 史肯斯球速下滑成話題 老將塞爾開酸：羨慕質疑者如此不懂棒球", "summary": "勇士37歲資深強投塞爾（Chris Sale）昨日彷彿讓時光倒轉，面對道奇演出9局無失分、11次三振，最快球速飆破百哩，以1：0完封道奇，自2019年以來首場完封勝。然而，另一名在鎂光燈下的海盜「怪物狀元」史肯斯（Paul Skenes）不僅被拍到身材變胖，近期球速甚至下滑，引發外界對他狀態的擔憂，但塞爾看到這些質疑卻忍不住笑了。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276046.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 15:46", "link": "/news/story/6999/9721759"}, {"article_id": "9721706", "title": "NBA／灰狼承諾庫明加「先發」卻藏危機？格林警告：打不好第一個被換", "summary": "前鋒庫明加（Jonathan Kuminga）在短暫效力老鷹後，如今以一份兩年1240萬美元的合約轉戰灰狼。不過昔日隊友格林（Draymond Green）卻認為，這次看似重新證明自己的機會，背後其實也藏著一項現實風險，只要效果不好，庫明加很可能就是第一個被換下先發的人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275906.jpg&M=1&s=Y&x=23&y=71&sw=1173&sh=782&exp=3600&sl=W&fw=360", "date": "2026-08-29 15:27", "link": "/news/story/7002/9721706"}, {"article_id": "9721556", "title": "MLB／岡本和真27轟推高藍鳥新人紀錄 打點超越城島健司僅次松井", "summary": "藍鳥日籍重砲岡本和真今天在主場面對西雅圖水手之戰敲出本季第27轟，持續刷新自己保持的藍鳥隊史新人單季全壘打紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276057.jpg&M=1&s=Y&x=0&y=11&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 15:23", "link": "/news/story/7002/9721556"}, {"article_id": "9721761", "title": "MLB／超衰！29座球場全壘打變內野沖天炮 波賈茲：真難受", "summary": "光芒隊純品康納球場（Tropicana Field）再度發生詭異畫面，教士隊波賈茲（Xander Bogaerts）一發高機率成為全壘打的球，竟變成內野高飛出局，讓教士隊全傻眼。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276055.jpg&M=1&s=Y&x=0&y=202&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-29 15:23", "link": "/news/story/6999/9721761"}, {"article_id": "9721752", "title": "中職／味全龍近6戰5敗怎麼了？葉總：選手想法飄來飄去", "summary": "味全龍隊近6戰5敗，近況陷入一波小低潮，總教練葉君璋也感受到，選手心態上不像上半季那麼單純，「想法飄來飄去，比較複雜。」他自曝，有和大家叮嚀，「9月開始是很重要的時間點…所以還有幾天。」講完自己覺得好笑，忍不住「呵呵。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276019.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 15:09", "link": "/news/story/7001/9721752"}, {"article_id": "9721739", "title": "總統盃街舞大賽預賽啟動 首次跨海前進金門一起來Battle", "summary": "由運動部全民運動署主辦的「2026全民運動賽事－總統盃街舞大賽」，總計吸引全台近500組隊伍熱烈響應，今年總統盃街舞大賽首次將分區預賽帶進金門，離島區預賽於今天在金門縣金湖綜合體育館籃球場熱力登場，來自金門及各地的街舞好手齊聚，以音樂、舞步及與創意一決高下，為金門注入充滿活力的街舞能量，也讓更多金門在地民眾能夠就近認識、參與街舞運動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275973.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 14:53", "link": "/news/story/7005/9721739"}, {"article_id": "9721737", "title": "中職／龍隊「831大限」60人名單敲定 最後3席出爐", "summary": "831球員註冊大限將至，味全龍隊60人名單已經敲定，確定沒有今年選秀新人，剩下3個名額屬於捕手全浩瑋、投手吳東霖、內野手許子謙，後兩人都還不曾在一軍出賽過。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275972.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-29 14:51", "link": "/news/story/7001/9721737"}, {"article_id": "9721672", "title": "棒球／「斜槓捷克隊」經典賽爆紅 醫師教頭：以職業態度征戰國際", "summary": "捷克棒球國家隊總教練哈丁兼具神經科醫師身分，他帶領捷克隊以業餘球員組成聞名國際。哈丁表示，捷克球員各有工作與家庭，「我們...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275933.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 14:34", "link": "/news/story/7001/9721672"}, {"article_id": "9721710", "title": "MiLB／本季代表作！林昱珉6.1局好投收本季第7勝", "summary": "響尾蛇隊3A今天與巨人隊3A交手，台灣左投林昱珉繳出本季代表作，6.1局只失1分，奪下本季第7勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275927.jpg&M=1&s=Y&x=0&y=28&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-29 14:30", "link": "/news/story/6999/9721710"}, {"article_id": "9721557", "title": "MLB／史庫柏交易後重返老虎主場 致敬影片看到落淚！", "summary": "即使如今身披道奇戰袍，兩屆塞揚左投史庫柏（Tarik Skubal）今日首度以客隊球員身分重返老虎主場，當球場播放昔日效力期間的致敬影片時，他再也藏不住情緒，站在場邊紅了眼眶、擦去淚水。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275648.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 14:15", "link": "/news/story/6999/9721557"}, {"article_id": "9721686", "title": "TPBL／不排斥為棒球應援 三上悠亞：能整季在台灣會很有趣", "summary": "啦啦隊女神三上悠亞在日前與福爾摩沙夢想家隊完成續約後，新賽季將再度加入Formosa Sexy為球隊應援，談到在台啦啦隊生涯將邁入第二個賽季，三上悠亞在今天被問到是否有機會轉戰棒球場時，她也透露並不排斥，並認為如果可以因為應援工作整季都待在台灣，應該會相當有趣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275861.jpg&M=1&s=Y&x=0&y=0&sw=1068&sh=712&exp=3600&sl=W&fw=360", "date": "2026-08-29 14:05", "link": "/news/story/7003/9721686"}, {"article_id": "9721425", "title": "NBA／柯瑞傳奇歷史登上大銀幕！動用21台IMAX攝影機記錄「首位4000顆三分」誕生", "summary": "勇士一哥柯瑞（Stephen Curry）成為NBA首位投進4000顆三分球的傳奇歷程將登上大銀幕，紀錄片《Portrait of an Artist: Stephen Curry》確定將於2026年10月10日在IMAX戲院獨家上映，記錄他完成史無前例里程碑的珍貴時刻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275446.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-29 14:00", "link": "/news/story/7002/9721425"}, {"article_id": "9721675", "title": "NBA／本季年薪545萬美元 騎士裁掉22歲潛力前鋒惠特摩", "summary": "22歲前鋒惠特摩（Cam Whitmore）日前被巫師隊交易至騎士隊，但根據《HoopsHype》記者史卡托（Michael Scotto）報導，騎士今天選擇裁掉他。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275844.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 13:56", "link": "/news/story/7002/9721675"}, {"article_id": "9721666", "title": "中職／味全龍「龍躍列車」啟動 用愛縮短走進球場的距離", "summary": "味全龍隊今天於天母棒球場正式啟動全新公益計畫「龍躍列車」，由一個在球場看見的溫暖畫面出發，在愛心人士捐贈車輛支持下，將感動化為實際行動。未來「龍躍列車」將提供特殊境遇人士、身心障礙朋友等有特殊需求的圓夢者接送服務，陪伴他們在生日或別具意義的日子走進天母棒球場，讓看球不再因距離或身體狀況而變得困難。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35275829.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-0