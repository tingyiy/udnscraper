humbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/30/35377421.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-30 18:51", "link": "/news/story/7001/9786434"}, {"article_id": "9786498", "title": "籃球／金華奪永德盃冠軍 阿巴西弟弟還要強化基本功", "summary": "永德盃分齡籃球邀請賽今天落幕，國中組金華國中以96：83擊敗信義國中摘冠，其中金華國中國二的球員阿信，是新北中信特攻球星「黑豹」阿巴西的弟弟，教練讚他身體素質佳，但仍要多練基本功。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/30/35377407.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-30 18:46", "link": "/news/story/7003/9786498"}, {"article_id": "9786449", "title": "亞運柔道／林真豪無緣獎牌情緒潰堤 「希望可以拍那種頒獎台的照片」", "summary": "台灣柔道女將林真豪今天在名古屋亞運女子48公斤級闖進銅牌戰，最後卻仍以一步之遙無緣頒獎台，她在走下場後淚水潰堤，賽後也含著淚笑說：「還是希望可以拍那種頒獎台的照片。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/30/35377335.jpg&M=1&s=Y&x=0&y=0&sw=1246&sh=831&exp=3600&sl=W&fw=360", "date": "2026-09-30 18:15", "link": "/news/story/124981/9786449"}, {"article_id": "9786448", "title": "中職／阪神「台灣日」甲子園登場 中職6位啦啦隊女孩活力十足", "summary": "日本職棒阪神虎隊今天在甲子園球場對養樂多隊之戰舉辦「台灣日」，集結台灣職棒啦啦隊及台灣特色美食，打造充滿台灣味的精彩活動，讓日本球迷在看球之餘，也能感受豐富的台灣文化與特色。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/30/35377329.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-30 18:15", "link": "/news/story/7001/9786448"}, {"article_id": "9786356", "title": "亞運播錯國歌、接駁車害延賽 名古屋市長公開致歉：真摯反省", "summary": "日本愛知．名古屋亞運籌辦過程接連爆發多起賽事營運瑕疵，引發各國參賽代表團譁然。針對賽場頻繁發生的低級失誤，身兼大會組織委員會代會長的名古屋市長廣澤一郎於例行記者會上正式公開向受波及的選手與相關人員致歉，坦言組織內部存在明顯的人為疏失與溝通斷層，強調必須為一連串的行政怠失「真摯深刻反省」，並承諾將全力補破網修正後續賽事流程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/30/35377183.jpg&M=1&s=Y&x=80&y=0&sw=1200&sh=800&exp=3600&sl=W&fw=360", "date": "2026-09-30 18:06", "link": "/news/story/124981/9786356"}, {"article_id": "9786378", "title": "亞運柔道／盡力但結果不是自己想要的⋯ 楊勇緯壓力大淚謝外界支持", "summary": "「柔道男神」楊勇緯未能完成在亞運衛冕金牌的目標，今天在銅牌戰與中國選