", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154156.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9640269"}, {"article_id": "9640257", "title": "雷霆避稅縮減天賦還是60勝球隊 但奪冠除了帶天命還要靠好運", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154136.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9640257"}, {"article_id": "9640155", "title": "煮茶論戰／「平均11秒奪回球權」 西班牙新傳控體系無敵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35154081.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9640155"}, {"article_id": "9637210", "title": "中職／富邦悍將爭奪季後賽門票 李東洺成最大變數", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/19/35149536.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9637210"}]}, {"name": "最新文章", "articles": [{"article_id": "9643099", "title": "MLB／黑田葛勞爾「睪丸破裂」還敲安！賽後緊急動手術進傷兵名單", "summary": "運動家隊今天宣布內野手黑田葛勞爾（Joshua Kuroda-Grauer）因睪丸破裂接受手術，被放入10天傷兵名單，右投萊特（Mark Leiter）因右髖夾擠症進15天傷兵名單，並從3A叫回右投尤恩格（Hayden Juenger）與內野手蒙西（Max Muncy）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35158377.jpg&M=1&s=Y&x=0&y=0&sw=1262&sh=841&exp=3600&sl=W&fw=360", "date": "2026-07-22 09:56", "link": "/news/story/6999/9643099"}, {"article_id": "9643055", "title": "NBA／專屬個人展覽將進駐名人堂 柯瑞創現役球員第一人紀錄", "summary": "奈史密斯籃球名人堂（Naismith Basketball Hall of Fame）將迎來歷史性的一刻，官方宣佈本周末將為勇士超級巨星柯瑞（Stephen Curry）推出個人專屬展覽，這也是名人堂成立近75年以來，首度有現役球員獲得此項殊榮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35158302.jpg&M=1&s=Y&x=0&y=170&sw=1025&sh=683&exp=3600&sl=W&fw=360", "date": "2026-07-22 09:33", "link": "/news/story/7002/9643055"}, {"article_id": "9643046", "title": "世足賽／地主淘汰不影響 冠軍賽創收視紀錄", "summary": "賽史首度增隊到48隊的美加墨世界盃，104場比賽本周落幕，儘管賽事出現票價爭議、裁判問題等負面新聞，但開出亮眼收視成績，西班牙以1：0擊敗阿根廷的冠軍賽創下收視紀錄，吸引超過3893萬觀眾，收視最高峰更突破5168萬，創下了美國史上收視率最高的英文轉播足球賽轉播紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35158381.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-22 09:30", "link": "/news/story/123107/9643046"}, {"article_id": "9642920", "title": "才接下亞運總教練 謝政瀛遭多女控「恐怖情人」、賣賽事通行證", "summary": "運動部日前公布2026年亞洲運動會各代表隊教練與選手名單，網球名將謝淑薇確定代表台灣參賽，哥哥謝政瀛也獲選擔任國家隊總教練。不過，謝政瀛近日遭多名前女友出面指控，不僅涉及控制、騷擾、暴力等「恐怖情人」行徑，還遭爆料私下販售國際賽事公關票、簽名球及教練證件牟利。對此，謝政瀛全盤否認，表示若相關報導內容不實，將依法提告。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35158222.jpg&M=1&s=Y&x=291&y=298&sw=681&sh=454&exp=3600&sl=W&fw=360", "date": "2026-07-22 09:16", "link": "/news/story/7005/9642920"}, {"article_id": "9643017", "title": "世足賽／決賽飲恨不敵西班牙 梅西低調返鄉休養球迷暖心舉牌力挺", "summary": "在美加墨世足賽決賽以0：1不敵西班牙、遺憾屈居亞軍的阿根廷球王梅西（Lionel Messi），於今天搭乘私人飛機返抵故鄉羅薩里奧（Rosario），展開短暫的休養期。雖然許多球迷清晨便前往機場守候，但梅西並未公開亮相，隨即在維安安排下搭車前往私人住宅區。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35158255.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-22 09:14", "link": "/news/story/123107/9643017"}, {"article_id": "9641759", "title": "中職／「蝦輝」轉換身分貢獻更大 助陣悍將外野不再瞎揮", "summary": "富邦悍將外野陣容經歷轉型，退出的退役球星林哲瑄與高國輝重返擔任教練，帶動外野養成走上正軌。新選秀及教練團改革讓球員展現競爭氣氛，今年外野戰力有望全面提升，逐漸恢復昔日輝煌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35156672.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-22 07:00", "link": "/news/story/122629/9641759"}, {"article_id": "9642724", "title": "棒球／長期深耕業餘棒球 郭智輝：整合資源打造更完整棒球環境", "summary": "經濟部前長、崇越集團創辦人郭智輝表達有意角逐新任中華民國棒球協會理事長，希望憑藉多年投入台灣棒球的經驗，結合企業治理與運動科學專業，成為政府、企業與棒球界之間的重要橋樑，為台灣棒球注入更多資源與發展動能。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35157810.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-22 00:04", "link": "/news/story/7001/9642724"}, {"article_id": "9642469", "title": "中職／「林智勝一直在催」 朱育賢連11季雙位數全壘打堆疊障礙", "summary": "2：2平手局面，朱育賢以第六局的陽春砲轟破，率領味全龍隊以3：2擊敗樂天桃猿隊，而他自己推進菜鳥年起11季雙位數全壘打的「朱哥障礙」，賽後透露來自林智勝的催促。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157590.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 22:09", "link": "/news/story/7001/9642469"}, {"article_id": "9642437", "title": "中職／從林凱威臉上看到自信 葉總：那是我喜歡的後援投手樣子", "summary": "味全龍隊今天以3：2擊敗樂天桃猿隊，第九局驚濤駭浪守住危機，守護神林凱威在得點圈危機連抓3個出局數，臉上的表情讓總教練葉君璋看到自信的模樣，他說：「那是我喜歡的後援投手的樣子。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157583.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 21:52", "link": "/news/story/7001/9642437"}, {"article_id": "9642411", "title": "帕總晚宴凝聚全球帕運家族 APC主席拉希德高規格致贈榮譽匾額", "summary": "由亞洲帕拉林匹克委員會（APC）主辦、中華帕拉林匹克總會承辦的「第二屆APC女性運動發展研討會」日前在台北君悅大飯店隆重登場。為款待遠道而來的各國貴賓，APC女性運動委員會主席、我國中華帕拉林匹克總會會長穆閩珠博士昨晚特別設宴款待。現場最受矚目的重量級貴賓當屬APC主席馬吉德·拉希德（Majid Rashed）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157509.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 21:27", "link": "/news/story/7005/9642411"}, {"article_id": "9642405", "title": "中職／已是無「猿」人…朱育賢陽春砲、魔神龍6局好投 龍隊3連勝", "summary": "樂天桃猿隊今天不敵兩位「舊情人」，魔神樂繳出6局失2分優質先發，朱育賢則在第六局敲出致勝陽春砲，聯手幫助味全龍隊以3：2擊敗猿隊，取得3連勝，下半季5勝5敗站回5成勝率。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157502.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 21:24", "link": "/news/story/7001/9642405"}, {"article_id": "9642389", "title": "打破性別與疆界 第二屆APC女性運動研討會台北盛大登場", "summary": "由亞洲帕拉林匹克委員會（APC）主辦、中華帕拉林匹克總會承辦的「第二屆APC女性運動發展研討會」20、21日於台北君悅大飯店盛大召開，這場匯聚來自45個會員國的女性運動領袖、政策制定者及運動選手的國際盛會，共同為亞洲身心障礙女性與青少女體育發展擘劃未來。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157474.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 21:11", "link": "/news/story/7005/9642389"}, {"article_id": "9642353", "title": "世足賽／2026世足賽助攻 中華電信MOD、Hami Video收視再寫新猷", "summary": "2026 FIFA世界盃本周精彩落幕，中華電信MOD、Hami Video完整直播104場全賽事，與消費者見證西班牙擊退上屆冠軍阿根廷，暌違16年拿下「大力神盃」。中華電信表示，本屆世足賽轉播寫下多項紀錄，包括Hami Video付費會員同時間最高上線數超越上屆四成以上、Hami Video全站累積瀏覽次數大幅超越上屆逾八成，助攻網路天數型方案訂閱數較上屆成長4.9倍，創下一波波收視高峰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157415.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 20:50", "link": "/news/story/123107/9642353"}, {"article_id": "9642234", "title": "中國羽賽／「麟榤配」逆轉失利 連六站「一輪遊」", "summary": "我國第一男雙「麟榤配」，全英公開賽後陷入低潮，今天中國公開賽碰日本組合熊谷翔／西大輝，雖瓦解對手第二局的賽末點，但逼到第三局仍沒能逆轉，最終以6：21、23：21、11：21吞敗，連六站都「一輪遊」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157343.jpg&M=1&s=Y&x=0&y=26&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-21 19:49", "link": "/news/story/7005/9642234"}, {"article_id": "9642184", "title": "世足賽／世足決賽敗給西班牙 阿根廷挨批球風骯髒被貼反派標籤", "summary": "阿根廷在2026世足決賽以0比1敗給西班牙，被批戰術骯髒與缺乏運動家精神，加深他們在賽事期間被貼上的反派標籤，但許多阿根...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157288.jpg&M=1&s=Y&x=0&y=64&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-21 19:27", "link": "/news/story/123107/9642184"}, {"article_id": "9642189", "title": "中職／怎麼投的？後勁首局5BB成史上第9人 前次已是2008年", "summary": "台鋼雄鷹隊洋投後勁投出離譜的第一局，今面對中信兄弟隊單局出現5次四壞保送，追平單一投手於第一局的最多四壞保送紀錄，而前次出現已是2008年。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157283.jpg&M=1&s=Y&x=0&y=0&sw=1270&sh=847&exp=3600&sl=W&fw=360", "date": "2026-07-21 19:15", "link": "/news/story/7001/9642189"}, {"article_id": "9642149", "title": "中職／陽念祖輪替上一軍守備不錯 清楚角色定位盼有表現", "summary": "中職味全龍隊內野手陽念祖14日上到一軍，總教練葉君璋表示是球員輪替安排、陽念祖守備不錯；陽念祖表示，這次上一軍更知道該做...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157280.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 19:11", "link": "/news/story/7001/9642149"}, {"article_id": "9642099", "title": "NBA／杜倫續約談判仍陷僵局 傳活塞拒絕討論先簽後換方案", "summary": "2026年NBA自由市場開啟已超過3週，聯盟多筆重大交易與簽約陸續完成，但受限制自由球員杜倫（Jalen Duren）與底特律活塞之間的合約僵局，據傳仍未解決。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157148.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-21 18:23", "link": "/news/story/7002/9642099"}, {"article_id": "9642051", "title": "中職／「雞毛二人組」明星賽都成傷兵 林英傑：看恩宇好痛、結果我更痛", "summary": "中職明星賽打出許多過往傳奇選手，昔日「雞毛二人組」很有默契，連在明星賽都一起傷退，林英傑也苦笑說：「真的！我看他（林恩宇）這樣的時候好痛，結果換我上去投，更痛。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157070.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 18:04", "link": "/news/story/7001/9642051"}, {"article_id": "9642018", "title": "NBA／馬刺仍信任福克斯下季回穩 傳哈波願續任第六人等待接班", "summary": "聖安東尼奧馬刺上季打出亮眼表現，重返總冠軍賽舞台，今年休賽季持續補強與調整陣容。不過，在球隊逐步完成名單配置之際，後場安排仍留下外界關注的疑問。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35156997.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 17:57", "link": "/news/story/7002/9642018"}, {"article_id": "9642012", "title": "亞運／從跆拳道、卡巴迪到綜合格鬥 林郁芬解鎖「最狠」亞運新篇章", "summary": "從跆拳道場的個人對決、卡巴迪賽場的團隊拚搏，到如今將站上名古屋亞運首度舉辦的綜合格鬥擂台，林郁芬用一條極具個人特色的跨界之路，詮釋了對技擊運動的極致熱愛，談到再次披上國家隊戰袍，她帶著招牌的豁達與自信笑言，這次目標除了鎖定4強、挑戰獎牌成色，更要「在擂台上表現自己，越帥越好！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35156991.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 17:52", "link": "/news/story/7005/9642012"}, {"article_id": "9641909", "title": "中職／林英傑明星賽對決林智勝 直呼享受4萬人的感覺", "summary": "中職明星賽傳奇球星林英傑登板投球，勾起球迷回憶，林英傑被林智勝強襲球擊中退場，雖僅投1人次，但直言在台灣巨蛋投球很不一樣...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35156986.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 17:50", "link": "/news/story/7001/9641909"}, {"article_id": "9642009", "title": "NBA／湖人也想湊中鋒「鐵支」？ 傳有意簽6呎11護框長人", "summary": "洛杉磯湖人今年休賽季已經針對前場做出多項補強，但球隊仍持續探索進一步強化禁區深度的可能性。根據NBA記者希德利（Evan Sidery）報導，湖人是目前對自由球員中鋒理查茲（Nick Richards）展現興趣的球隊之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35156985.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 17:50", "link": "/news/story/7002/9642009"}, {"article_id": "9641952", "title": "中職／楊鈺翔睽違5年返一軍兒子成動力 感謝蕭一傑幫助", "summary": "中職味全龍隊24歲投手楊鈺翔經歷手術復健，睽違近5年重回一軍投手丘，家人和兒子都到場見證，成為爸爸後心理狀態轉變更有動力...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35156971.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-07-21 17:46", "link": "/news/story/7001/9641952"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9643046", "title": "世足賽／地主淘汰不影響 冠軍賽創收視紀錄", "date": "2026-07-22 09:30", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35158381.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/123107/9643046"}, {"article_id": "9643017", "title": "世足賽／決賽飲恨不敵西班牙 梅西低調返鄉休養球迷暖心舉牌力挺", "date": "2026-07-22 09:14", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35158255.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9643017"}, {"article_id": "9642353", "title": "世足賽／2026世足賽助攻 中華電信MOD、Hami Video收視再寫新猷", "date": "2026-07-21 20:50", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35157415.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9642353"}, {"article_id": "9642184", "title": "世足賽／世足決賽敗給西班牙 阿根廷挨批球風骯髒被貼反派標籤", "date": "2026-07-21 19:27", "thumbnail": "htt