mbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367614.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9780010"}, {"article_id": "9777213", "title": "詹姆斯百大球員終於跌出前10 ESPN是公允、低估還是過譽？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35363281.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9777213"}, {"article_id": "9776212", "title": "中職／兄弟望演史上第6次下半季奪冠大逆襲 悍將落得搶最後生機", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35361787.jpg&M=1&s=Y&x=0&y=40&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9776212"}, {"article_id": "9773727", "title": "中職／郭天信、魔神龍近況差 味全天龍陣在投打端都現罩門", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357631.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9773727"}, {"article_id": "9770767", "title": "日職／落合博滿後等了40年 羅德本土30轟大砲為何遲遲難產？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35353051.jpg&M=1&s=Y&x=57&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9770767"}]}, {"name": "最新文章", "articles": [{"article_id": "9781023", "title": "亞運羽球／葉宏蔚、詹又蓁搭檔混雙4強止步 羽球隊一銅作收", "summary": "名古屋亞運羽球今天展開4強賽程，其中我國組合葉宏蔚／詹又蓁，今天遭遇中國大陸搭擋蔣振邦／魏雅欣，最終以13：21、9：21敗下陣來，以銅牌作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35369113.jpg&M=1&s=Y&x=0&y=31&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-28 10:53", "link": "/news/story/124981/9781023"}, {"article_id": "9781009", "title": "MLB／大谷連18戰未開轟結束球季 30轟仍是道奇連3季全壘打王", "summary": "道奇隊作客舊金山，例行賽最後一戰和巨人隊拚到延長10局以5：1獲勝，奪下本季第100勝，也是隊史第12次單季百勝紀錄，大谷翔平從第2棒調回開路先鋒，3次打數揮出1支安打，雖從8月20日起就沒有全壘打紀錄，仍是道奇唯一30轟打者，連續3年都是隊上全壘打王。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35369092.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 10:44", "link": "/news/story/6999/9781009"}, {"article_id": "9780978", "title": "亞運田徑／父母首度海外觀戰成定心丸 傅兆玄驚喜奪金：我到現在還不敢相信", "summary": "台灣男子跳高好手傅兆玄在27日男子跳高決賽跳出2.25公尺，以試跳成功率優勢勇奪金牌，不僅為中華代表團拿下本屆第3金，也寫下台灣田徑重要里程碑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35369059.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 10:40", "link": "/news/story/124981/9780978"}, {"article_id": "9780899", "title": "中職／大巨蛋本季58場123萬1778人進場 雄鷹票房雙榜包尾", "summary": "台北大巨蛋本季例行賽58場全數落幕，合計123萬1778人次進場，比較場均人數，同樣全假日檔期的兩隊，票房兩樣情，樂天桃猿隊場均2萬4829人排名第一，台鋼雄鷹隊1萬6148人在6隊墊底。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368959.jpg&M=1&s=Y&x=0&y=48&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 09:56", "link": "/news/story/7001/9780899"}, {"article_id": "9780897", "title": "MLB／領軍道奇11年首度全季未被驅逐出場 羅伯茲：我長大了", "summary": "道奇隊今天以5：1擊敗巨人隊，例行賽以100勝62敗作收，暌違3年再次達到百勝球季，總教練羅伯茲（Dave Roberts）也在此役後確定中斷一項紀錄，領軍道奇11個賽季，這是他第一次全年未被驅逐出場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368946.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 09:50", "link": "/news/story/6999/9780897"}, {"article_id": "9780872", "title": "MLB／兩聯盟投打數據王者出爐 阿隆索奪美聯雙冠王創罕見紀錄", "summary": "大聯盟例行賽今天結束，投打各項數據領先球員也出爐，金鶯隊「北極熊」阿隆索（Pete Alonso）轉戰美聯首季奪下全壘打、打點雙冠王，成為史上首位在兩聯盟都拿過打點王的球員，釀酒人隊王牌投手米蕭洛斯基（Jacob Misiorowski）包辦國聯防禦率王、三振王。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368924.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 09:33", "link": "/news/story/6999/9780872"}, {"article_id": "9780825", "title": "跆拳道／全小錦落幕曾櫟騁之女連四屆全勝 仁愛跆拳道館獲7金", "summary": "中華民國115年全國國小學生跆拳道錦標賽27日於新北市立板橋體育館進行為期兩天的最後一天賽程，兩天下來共有1300多名小將陸續登場，其中不乏有名將之後，2012年倫敦奧運銅牌得主曾櫟騁與老公2010年廣州亞運男子68公斤以下級銅牌羅宗瑞有女初長成，曾羅克薇完成四連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368839.jpg&M=1&s=Y&x=0&y=0&sw=1194&sh=796&exp=3600&sl=W&fw=360", "date": "2026-09-28 08:55", "link": "/news/story/7005/9780825"}, {"article_id": "9780807", "title": "MLB／菜鳥年114場出賽加值 李灝宇87安10轟證明台灣野手也能固定先發", "summary": "2026年成為李灝宇旅美賽季突破的一季，首度站上大聯盟，且一舉留下114場出賽，狂刷各項台灣球員紀錄，最終以2成63打擊率敲出87支安打、10轟、46分打點，證明台灣野手也能在最高殿堂卡位固定先發。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368911.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 08:41", "link": "/news/story/6999/9780807"}, {"article_id": "9780802", "title": "MLB／太空人、費城人驚險晉級季後賽 道奇挑戰3連霸10月4日起跑", "summary": "大聯盟例行賽今天落幕，太空人隊9：0擊敗運動家隊、費城人7：3擊敗光芒隊，搶下最後兩張季後賽門票，季後賽後天點燃戰火，4組外卡系列賽同日開打，世界大賽如果打滿7場，將在11月1日產生冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368908.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 08:35", "link": "/news/story/6999/9780802"}, {"article_id": "9780801", "title": "MLB／李灝宇4支0吞K後徒手斷棒不是第一次 老虎教頭：他就是這麼好勝", "summary": "台灣好手李灝宇值得留念的2026年賽季畫下句點，今天在例行賽最終戰先發4打數沒有安打、吞下2次三振，第八局吞K後氣噗噗徒手折斷球棒，球棒隨著李灝宇的賽季最後一打席結束後成為碎片。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368905.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 08:34", "link": "/news/story/6999/9780801"}, {"article_id": "9780007", "title": "棒球／林佾葳對南韓一戰成名 勢必受到韓職球探關注", "summary": "林佾葳亞運先發對南韓5局僅失1分非自責分，三振強打金倒永，表現受矚目；韓職亞洲外援制度上路，赴韓發展增添可能。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367591.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-28 07:00", "link": "/news/story/122629/9780007"}, {"article_id": "9780010", "title": "日職／火退要避免6年無一冠 「新庄政權」延續成敗在守備", "summary": "日本火腿監督新庄剛志獲球團高度評價，外界推測將續任2027年；第6年爭冠之外，團隊失誤87次居12隊之首，守備將是成敗關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35367614.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 07:00", "link": "/news/story/122629/9780010"}, {"article_id": "9780583", "title": "亞運棒球／率隊奪銅 林昱珉差點投出飆無安打比賽", "summary": "中華隊昨天在名古屋亞運棒球銅牌戰以五比一擊敗中國大陸，效力於響尾蛇隊的旅美左投林昱珉演出近完美的表現，差點飆出「無安打比賽」，最後以八局無失分、只被敲一支安打、送出十Ｋ的表現奪下勝投，他也為自己的表現打下「九十分」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368459.jpg&M=1&s=Y&x=0&y=0&sw=1271&sh=847&exp=3600&sl=W&fw=360", "date": "2026-09-28 00:19", "link": "/news/story/124981/9780583"}, {"article_id": "9780581", "title": "克拉術創紀錄 李宛庭奪銀獻亡母", "summary": "名古屋亞運克拉術女子五十七公斤級賽事昨天傳回捷報，我國好手李宛庭一路過關斬將殺進決賽，雖然最終金牌戰在判決有些許不利的情況下，以○比三不敵烏茲別克勁敵阿戈喬諾娃，但收下銀牌仍刷新隊史在亞運克拉術項目的最佳成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368575.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-28 00:16", "link": "/news/story/124981/9780581"}, {"article_id": "9780579", "title": "亞運田徑／媽媽親睹跳高摘金 傅兆玄：不可思議", "summary": "在亞運的舞台上披著中華代表團會旗繞場，傅兆玄昨天在名古屋亞運跳高決賽以二公尺二五的成績摘金，他用「不可思議」來形容昨晚這從沒想過的奪金時刻，生涯成人等級國際賽的第一面金牌入袋，直到賽後他都直呼有點不敢相信，「希望可以在場上一直待著、披會旗繞場一圈。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35368548.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-28 00:12", "link": "/news/story/124981/9780579"}, {"article_id": "9780612", "title": "暌違60年…亞運男子田徑奪金 傅兆玄跳高封王", "summary": "名古屋亞運田徑賽場昨天傳出好消息，我國男子跳高好手傅兆玄以二公尺二五成績拿下金牌，不僅是今年中華代表團的第三面金牌，更是我國田徑男子選手相隔六十年再度站上亞運頒獎台最高點，加上在克拉術、舉重、棒球場也都有奪牌捷報，單日進帳一金二銀二銅，累積拿下三金七銀十九銅。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368481.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-28 00:00", "link": "/news/story/124981/9780612"}, {"article_id": "9780487", "title": "中職／三層人塔大怒神墜落！啦啦隊特技女神「潔潔」再次挑戰新高度", "summary": "啦啦隊特技女神潔潔於9/26富邦球場賽後挑戰三層人塔自由落體，結合演唱與高難度特技，動員24名舞者及特技人員，獲全場驚呼。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368383.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-27 22:43", "link": "/news/story/7001/9780487"}, {"article_id": "9780462", "title": "亞運田徑／擺脫心魔與低潮 傅兆玄奪金告白向俊賢是定心丸", "summary": "從過去面對大型比賽的心魔纏身、陷入改步幅與傷後復原的漫長低潮，到如今站上名古屋亞運男子跳高頒獎台的最高處，傅兆玄在奪金背後經歷了無數次自我懷疑。賽後談到這段心路歷程，傅兆玄透露，除了家人的陪伴，前全國紀錄保持人「阿寶」向俊賢教練與教練團的默默支持，更是讓他克服心魔、重拾自信的最大關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368361.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-27 22:12", "link": "/news/story/124981/9780462"}, {"article_id": "9780447", "title": "亞運／29日焦點拳擊林郁婷拚獎牌　羽球混雙、桌球林昀儒4強登場", "summary": "名古屋亞運台灣代表團明天將持續衝擊獎牌，「台灣拳后」林郁婷將在60公斤級8強亮相，而羽球混雙葉宏蔚、詹又蓁及桌球男單林昀...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368341.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-27 22:04", "link": "/news/story/124981/9780447"}, {"article_id": "9780450", "title": "亞運田徑／獲暌違60年金牌加上486萬 傅兆玄想一直披著會旗留在場上", "summary": "暌違60年我國男子田徑代表隊再度有選手站上亞運頒獎台最高處，跳高好手傅兆玄今天在名古屋亞運男子跳高決賽中，克服天候與中途出現的抽筋危機，一舉跳過2公尺25的佳績拿下金牌，得知這面金牌讓台灣田徑隊寫下歷史新頁時，傅兆玄賽後坦言「完全不敢相信」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368333.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-27 21:56", "link": "/news/story/124981/9780450"}, {"article_id": "9780436", "title": "中職／林澤彬連2次短打失敗 後藤光尊：只有第1次是戰術", "summary": "中華職棒富邦悍將隊今天雖以2比1擊敗中信兄弟隊，但打擊王林澤彬連2打席在一、二壘有人時短打失敗引起討論，悍將總教練後藤光...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368325.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-27 21:56", "link": "/news/story/7001/9780436"}, {"article_id": "9780423", "title": "中職／悍將險勝兄弟MVP獲iPhone手機獎勵 申皓瑋：我比較幸運", "summary": "富邦悍將隊今天以2比1險勝中信兄弟隊，在中職全年勝率與第2名的統一7-ELEVEn獅隊回到半場勝差，續拚季後賽。貢獻1分...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368305.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-27 21:29", "link": "/news/story/7001/9780423"}, {"article_id": "9780381", "title": "亞運田徑／傷後首戰跨欄第6作收 林翊凱坦言太緊張「只能給自己60分」", "summary": "中華隊兩名跨欄好手謝元愷、林翊凱，今天雙雙在名古屋亞運田徑男子110公尺跨欄決賽登場，謝元愷跑出13秒55排名第4，林翊凱則是跑出13秒77的表現排名第6作收，賽後林翊凱對於自己的表現也不太滿意，「只能給自己60分。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368254.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-27 20:47", "link": "/news/story/124981/9780381"}, {"article_id": "9780374", "title": "中職／李東洺好投、申皓瑋強打收拾兄弟 悍將緊咬獅搶季後賽門票", "summary": "富邦悍將隊投手李東洺今天先發7局失1分，優質表現無關勝敗，但讓球隊保有贏球機會，8局下申皓瑋關鍵三壘打帶動反撲氣勢，終場以2：1擊敗中信兄弟隊，年度戰績仍居第3，但只落後統一獅隊半場勝差，全力爭取季後賽門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368285.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-27 20:37", "link": "/news/story/7001/9780374"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9781023", "title": "亞運羽球／葉宏蔚、詹又蓁搭檔混雙4強止步 羽球隊一銅作收", "date": "2026-09-28 10:53", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/28/35369113.jpg&M=1&s=Y&x=0&y=31&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/124981/9781023"}, {"article_id": "9780450", "title": "亞運田徑／獲暌違60年金牌加上486萬 傅兆玄想一直披著會旗留在場上", "date": "2026-09-27 21:56", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368333.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9780450"}, {"article_id": "9780373", "title": "亞運田徑／傅兆玄跳高2公尺25作收 男子田徑隊暌違60年再奪金牌", "date": "2026-09-27 20:37", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/27/35368215.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/124981/9780373"}, {"article_id": "9780192", "title": "