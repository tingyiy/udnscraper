": "/news/story/124981/9797705"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9795974", "title": "中職／有張育成游擊竟還成破洞 是悍將明年必須改善的大重點", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/05/35391992.jpg&M=1&s=Y&x=0&y=0&sw=927&sh=618&exp=3600&w=300", "link": "/news/story/122629/9795974"}, {"article_id": "9795795", "title": "沒有「法官」賈吉的十月 洋基換血換的不是王牌而是建隊邏輯", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/05/35391691.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9795795"}, {"article_id": "9796291", "title": "打臉詹皇！斑馬拒絕代言博奕平台 是標新立異還是過於自我？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/05/35392457.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9796291"}, {"article_id": "9793865", "title": "中職／季後賽帶兵戰績慘綠 林岳平考驗才正要開始", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35388681.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9793865"}, {"article_id": "9794357", "title": "日職／藤川球兒驚險二連霸 77年來的阪神巨人新排名", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/04/35389316.jpg&M=1&s=Y&x=0&y=43&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9794357"}, {"article_id": "9789036", "title": "中職／該用什麼標準定義？今年誰最有資格獲選「東山再起獎」", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/01/35381244.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9789036"}]}, {"name": "最新文章", "articles": [{"article_id": "9798259", "title": "TPBL／夢想家成軍第十季拚連霸 總經理自信喊「最強」", "summary": "上季奪下隊史第一座總冠軍的福爾摩沙夢想家隊，今年以衛冕軍身分迎接成軍第10個季賽，今天球團開季記者會上總經理韓駿鎧霸氣說，很多隊伍都進行補強，但「我們應該還是最強」，笑說：「所以冠軍呢，可能他們還是要努力一點來搶。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395434.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 16:12", "link": "/news/story/7003/9798259"}, {"article_id": "9798221", "title": "MLB／生涯555轟、曾來台打球 曼尼退圈5年後尋求重返大聯盟當教練", "summary": "據大聯盟資深記者海曼（Jon Heyman）報導，54歲傳奇球星曼尼（Manny Ramirez）尋求暌違5年重返棒球圈，希望擔任大聯盟打擊教練，甚至願意從小聯盟教練做起。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395380.jpg&M=1&s=Y&x=0&y=73&sw=1056&sh=704&exp=3600&sl=W&fw=360", "date": "2026-10-06 16:05", "link": "/news/story/6999/9798221"}, {"article_id": "9798186", "title": "高球／世界球后也曾看不見低潮終點！「微笑球后」曾雅妮再為台灣奪牌 發文吐20年心聲", "summary": "對於曾登上世界第一，卻經歷傷勢、低潮與「推桿失憶症」的台灣高球名將曾雅妮而言，相隔20年再次披上中華隊戰袍，甚至重新站上亞運頒獎台，這面銅牌的重量，早已和當年不同。昨日曾雅妮也透過社群寫下心情，從隊友一路感謝到教練、協會等人，因為走過一段漫長低谷後，她比任何時候都更明白，能夠再次為台灣而戰，從來不是理所當然。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395331.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-06 16:03", "link": "/news/story/7005/9798186"}, {"article_id": "9798174", "title": "日職／林家正旅日首年一軍0出賽 將參加鳳凰聯盟拚機會", "summary": "日本職棒各隊今天公布宮崎鳳凰聯盟參賽名單，台灣球員部分，火腿隊旅日捕手林家正、樂天金鷲隊21歲內野手陽柏翔、西武獅隊23歲外野手林冠臣入列，火腿隊台灣投手古林睿煬未出現在球員名單。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395245.jpg&M=1&s=Y&x=0&y=151&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 15:42", "link": "/news/story/7001/9798174"}, {"article_id": "9798168", "title": "亞運／代表團奪好成績 卓榮泰：啟動「黃金計畫3.0」備戰下屆奧運", "summary": "行政院長卓榮泰6日出席「2026年第20屆愛知名古屋亞洲運動會」代表團返國餐會，肯定台灣代表團在本屆亞運締造佳績，並特別感謝運動部長李洋全心帶領代表團參賽。卓榮泰表示，他已要求行政院及運動部持續精進「黃金計畫3.0」，為台灣下一階段國際賽事及下屆奧運提前備戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395325.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 15:38", "link": "/news/story/124981/9798168"}, {"article_id": "9798082", "title": "中職／遭嗆「人品爛、舔共還開砲」 啦啦隊琳妲：別把造謠當言論自由", "summary": "中信兄弟隊下半季封王，取得季後挑戰賽門票；樂天桃猿隊則是被淘汰。最近有不理性球迷對啦啦隊樂天女孩琳妲開嗆，對此琳妲表示，不實指控及造謠內容都已截圖存證，將交由律師依法處理。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395165.jpg&M=1&s=Y&x=0&y=389&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-06 15:11", "link": "/news/story/7001/9798082"}, {"article_id": "9798060", "title": "桌球／瓦解2個賽末點！林昀儒逆轉闖中國大滿貫16強", "summary": "剛在名古屋亞運打下雙料銅牌的「小林同學」林昀儒，馬不停蹄轉戰北京參加WTT中國大滿貫，今天男單第二輪再度通過5局大戰考驗，且是決勝局瓦解2個賽末點下，以6：11、11：6、11：6、8：11、15：13逆轉新星黃友政，晉級16強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395174.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 14:51", "link": "/news/story/7005/9798060"}, {"article_id": "9798004", "title": "MLB／紅襪否認「數據換投」主帥出面扛責：我的決定搞砸了", "summary": "紅襪在美聯外卡遭洋基2連勝橫掃出局，其中總教練崔西（Chad Tracy）連2場提前換下先發投手的決定成為外界批評焦點。今日崔西也特別澄清，所有換投決定都是由自己做出，沒有任何人透過數據、電腦或所謂「賽前劇本」要求他這麼做。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394958.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 14:41", "link": "/news/story/6999/9798004"}, {"article_id": "9797936", "title": "MLB／暴傳送分不後悔！洋基奇森姆仍喊：再來一次照傳", "summary": "洋基在美聯分區系列賽第2戰上演守備災難，全場發生4次失誤，首局前4名打者更出現3次失誤，最終以2：5不敵光芒，系列賽陷入0：2落後。然而發生關鍵暴傳的奇森姆（Jazz Chisholm Jr.）賽後則坦言，自己不後悔當下的傳球決定，若再來一次仍然會選擇出手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394832.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 14:23", "link": "/news/story/6999/9797936"}, {"article_id": "9797943", "title": "NBA／尼克開64億元合約仍無法達成協議！唐斯：我還有什麼需要證明？", "summary": "尼克隊今天迎來季前熱身賽首戰，但明星中鋒唐斯（Karl-Anthony Towns）目前仍因續約問題，與球團存在明顯分歧。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394854.jpg&M=1&s=Y&x=558&y=400&sw=679&sh=453&exp=3600&sl=W&fw=360", "date": "2026-10-06 14:13", "link": "/news/story/7002/9797943"}, {"article_id": "9797562", "title": "NFL／詭異成謎球星湧現傷病潮 研究竟找不到原因", "summary": "NFL開季第4週爆發全明星傷退潮，傑克遜等多名球星受傷；數據難證增賽與人工草皮造成傷病增加，恐影響多隊賽季走向。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394204.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&sl=W&fw=360", "date": "2026-10-06 13:54", "link": "/news/story/7005/9797562"}, {"article_id": "9797866", "title": "亞運／卓榮泰宴請中華代表團 宣布啟動「黃金計畫3.0」", "summary": "行政院今天中午在圓山大飯店舉行名古屋亞運中華代表團返國餐會，行政院長卓榮泰致詞時宣布，政府將啟動「黃金計畫3.0」，持續協助台灣選手備戰下一場國際大賽，期許中華健兒再創佳績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394706.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 13:39", "link": "/news/story/124981/9797866"}, {"article_id": "9797774", "title": "MLB／複製去年「中0日」神表現？山本由伸：我會做好準備", "summary": "道奇隊日籍強投山本由伸明天將在分區系列賽G3登板，對上勇士隊爭取聽牌優勢。當被問到是否會複製去年季後賽的「中0日」傳說，山本直言，「只要是我能做的事，我都會做好準備。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394566.jpg&M=1&s=Y&x=151&y=116&sw=1022&sh=737&exp=3600&sl=W&fw=360", "date": "2026-10-06 13:12", "link": "/news/story/6999/9797774"}, {"article_id": "9797705", "title": "亞運／設返國餐會迎接中華英雄 卓榮泰宣布啟動「黃金計畫3.0]", "summary": "行政院今天在圓山大飯店設宴，舉辦名古屋亞運中華代表團返國餐會，行政院院長卓榮泰親自宣布，將開啟「黃金計畫3.0」，下一次大賽備戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394710.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 12:50", "link": "/news/story/124981/9797705"}, {"article_id": "9797676", "title": "NBA／湖人生涯最「沉重」負擔 AD扛中鋒胖到122公斤：我沒辦法這樣打", "summary": "巫師戴維斯（Anthony Davis）過去曾多次表明，自己並不希望整季擔任全職中鋒，不過在湖人生涯後期，他卻逐漸從熟悉的大前鋒轉往5號位，如今他也透露，為了對抗約柯奇（Nikola Jokic）、安比德（Joel Embiid）等聯盟頂級中鋒，自己一度增重到接近268磅（約122公斤）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394399.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 12:41", "link": "/news/story/7002/9797676"}, {"article_id": "9797549", "title": "MLB／數據分析先等等！白襪靠「冰淇淋玄學」贏球 教頭喊：全隊都來一支", "summary": "白襪今日在美聯分區系列賽第2戰以4：3擊敗守護者，成功取得2：0領先，冰箱裡的冰淇淋甜筒更意想不到成為「贏球秘方」，捕手提爾（Kyle Teel）也對此笑稱，「冰淇淋甜筒裡真的有安打。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394191.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-06 12:08", "link": "/news/story/6999/9797549"}, {"article_id": "9797566", "title": "MLB／白襪挑戰120年首見紀錄！柏克差點破「瘋邦」鬼神表現", "summary": "白襪隊今天靠26歲投手柏克（Sean Burke）後援5.1局失1分，以4：3險勝守護者隊，柏克創季後賽罕見紀錄，白襪則要挑戰隊史120年來，首次在主場Rate Field贏下季後賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394225.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 12:03", "link": "/news/story/6999/9797566"}, {"article_id": "9797507", "title": "NBA ／湖人新賽季頭號難題？里夫斯吐槽唐西奇「說話」完全聽不懂", "summary": "湖人新賽季陣容迎來大幅改組，球隊也有不少問題等待解決。近日里夫斯（Austin Reaves）便透露，自己和唐西奇（Luka Doncic）搭檔後遇到的最大難題，竟然是「語言障礙」，甚至忍不住向這位會說4種語言的隊友懇求「講英文」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394096.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 11:50", "link": "/news/story/7002/9797507"}, {"article_id": "9797421", "title": "NBA／好慘！快艇開季前第4位傷兵 史特魯斯至少缺陣4週", "summary": "快艇隊休賽季透過五方交易得到上季效力騎士隊的側翼史特魯斯（Max Strus），沒想到史特魯斯因右腳足底筋膜部分撕裂，將至少缺陣4週。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35393967.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-06 11:25", "link": "/news/story/7002/9797421"}, {"article_id": "9797378", "title": "MLB／洋基手套集體「放假」！首局3E追平大聯盟最難堪紀錄吞敗", "summary": "對洋基而言，美聯分區系列賽第2戰幾乎是一場非贏不可的比賽，沒想到全隊守備彷彿「集體中邪」，從三壘、二壘、游擊一路延燒到捕手，幾乎每個守備位置都出現狀況，首局面對前4名打者更發生3次失誤，追平1975年美聯冠軍系列賽第1戰，運動家面對紅襪的季後賽「首局最多失誤」紀錄，最終洋基也為此付出代價以2：5吞敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35393968.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 11:24", "link": "/news/story/6999/9797378"}, {"article_id": "9797400", "title": "MLB／扯…洋基單場4E險些內野大滿貫 連輸光芒2場快要放假了", "summary": "洋基隊打出荒腔走板的一戰，單局3失誤、單場4失誤，內野僅一壘手沒有失誤，兩個發生失誤的半局都掉分，最終以2：5輸給光芒隊，在美聯分區系列賽連吞2敗，距離淘汰只差一步。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35393922.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-06 11:14", "link": "/news/story/6999/9797400"}, {"article_id": "9797338", "title": "NBA／2023年樂透後衛霍金斯遭灰熊釋出 公牛成新東家", "summary": "2023年首輪第14順位霍金斯（Jordan Hawkins）休賽季被鵜鶘隊交易到灰熊隊，上週六被灰熊釋出，如今找到新東家，與公牛隊簽下雙向合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35393812.jpg&M=1&s=Y&x=134&y=176&sw=1013&sh=675&exp=3600&sl=W&fw=360", "date": "2026-10-06 11:01", "link": "/news/story/7002/9797338"}, {"article_id": "9797251", "title": "NBA／熱身賽首戰就打架！活塞柯林斯狠掐太陽惡棍脖子", "summary": "太陽與活塞隊今天展開本季第1場季前熱身賽，就出現火爆場面，活塞前鋒柯林斯（John Collins）掐住太陽「惡棍」布魯克斯（Dillon Brooks）的脖子，但布魯克斯沒有進一步回擊，事態未擴大。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35393695.jpg&M=1&s=Y&x=0&y=88&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-06 10:54", "link": "/news/story/7002/9797251"}, {"article_id": "9797141", "title": "NBA／和尼克熱身賽才打5分鐘 76人替補中鋒就傷退", "summary": "76人隊今天和尼克隊在季前熱身賽碰頭，不料開賽不到5分鐘，76人替補中鋒胡克波提（Ariel Hukporti）右腳就出現傷勢，被迫提前離場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35393513.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-06 10:01", "link": "/news/story/7002/9797141"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9797705", "title": "亞運／設返國餐會迎接中華英雄 卓榮泰宣布啟動「黃金計畫3.0]", "date": "2026-10-06 12:50", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35394710.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9797705"}, {"article_id": "9798168", "title": "亞運／代表團奪好成績 卓榮泰：啟動「黃金計畫3.0」備戰下屆奧運", "date": "2026-10-06 15:38", "thumbnail": "https://pgw.udn.com.tw/gw/photo.