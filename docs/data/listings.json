humbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507521.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9871984"}, {"article_id": "9872315", "title": "亞冠賽／熱身賽開轟手感火燙 林安可西武隊友成中華隊警戒重點", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/11/35507928.jpg&M=1&s=Y&x=0&y=52&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9872315"}, {"article_id": "9870300", "title": "中職／契約保留名單不夠用 近90人成FA將掀搶人之戰", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/10/35504806.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9870300"}]}, {"name": "最新文章", "articles": [{"article_id": "9878793", "title": "PLG／退役後首個休賽季坦言開心 林志傑談車侑城：累積起來會愈來愈好", "summary": "PLG台北富邦勇士隊在今天賽前將為上季退役的「野獸」林志傑舉行球衣退休儀式，在賽前受訪時林志傑直言，在卸下球員身分後的首個休賽季，因為不用堅持在訓練上，確實覺得蠻開心的，對於副領隊的新角這也還在慢慢調整與適應，至於談到今年新加入的後衛車侑城，林志傑也直言在經過經驗累積後，他將會有愈來愈好表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518113.jpg&M=1&s=Y&x=0&y=185&sw=1211&sh=775&exp=3600&sl=W&fw=360", "date": "2026-11-14 16:13", "link": "/news/story/7003/9878793"}, {"article_id": "9878765", "title": "中職／張肇元靠「讓痛怕你」撐過復健難關 力拚雄鷹春訓回歸", "summary": "中職台鋼雄鷹隊捕手張肇元術後展開訓練，力拚明年春訓回歸，最艱辛的拉開關節階段，他用「讓痛怕你」這句鼓勵度過，但開始傳球時...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518089.jpg&M=1&s=Y&x=0&y=51&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 16:09", "link": "/news/story/7001/9878765"}, {"article_id": "9878700", "title": "棒球／曾昱磬重返徐生明少棒指導 分享秋訓雙發球機特訓", "summary": "徐生明國際少棒賽今天舉辦棒球教室，中職台鋼雄鷹隊內野手曾昱磬曾經參賽，如今到場傳承經驗，他透露秋訓期間針對速球、變化球特...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518088.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-11-14 16:06", "link": "/news/story/7001/9878700"}, {"article_id": "9878755", "title": "NBA／拓荒者本季真的不一樣！ 開季9勝3敗卡位西區前段班", "summary": "拓荒者本季開局展現驚人氣勢，繼日前連續擊敗雷霆後，今天在NBA盃小組賽作客面對戰力有所落差的國王，阿夫迪亞（Deni Avdija）狂轟本季新高34分，搭配里拉德（Damian Lillard）也飆出29分，最終以120比107拿下勝利，拓荒者強勢收下3連勝，開季戰績提升至9勝3敗，寫下近年來最出色的開季表現之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518049.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 15:49", "link": "/news/story/7002/9878755"}, {"article_id": "9878731", "title": "PLG／李珠珢、朴星垠加入富邦勇士組「韓援五本柱」 南珉貞：總冠軍，拜託！", "summary": "富邦勇士新球季應援陣容全面升級，場邊啦啦隊Fubon Angels迎來豪華「韓援五本柱」，包含學姊南珉貞、李晧禎、李雅英，以及今年首度加入籃球應援行列的李珠珢與朴星垠，五人今天首度合體展現強大應援氣勢，誓言要在今年助球隊重返榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518000.jpg&M=1&s=Y&x=62&y=221&sw=1175&sh=739&exp=3600&sl=W&fw=360", "date": "2026-11-14 15:31", "link": "/news/story/7003/9878731"}, {"article_id": "9878725", "title": "冬盟／獅隊第一指名新秀黃靖哲代打再見安 台灣海洋逆轉日本社會人", "summary": "亞洲冬季聯盟賽事今天開打，台灣海洋隊首戰在亞太成棒主球場對上日本社會人隊，8局打完以0：1落後，9局下由靠富邦悍將隊2名內野手展開攻勢，統一獅隊今年季中選秀首輪指名的黃靖哲代打立大功，揮出再見二壘打，幫助台灣海洋隊以2：1打下首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35518065.jpg&M=1&s=Y&x=65&y=43&sw=1215&sh=810&exp=3600&sl=W&fw=360", "date": "2026-11-14 15:26", "link": "/news/story/7001/9878725"}, {"article_id": "9878712", "title": "亞冠賽／日本隊0出局已攻11分 澳洲隊教頭大受衝擊：攻擊火力前所未見", "summary": "澳洲隊今天在亞冠賽遭遇慘烈一戰，提前7局以1：16不敵日本隊，總教練尼爾森（Dave Nilsson）賽後直言，日本隊的打擊火力之強大，是自己前所未見。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517978.jpg&M=1&s=Y&x=0&y=32&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 15:09", "link": "/news/story/7001/9878712"}, {"article_id": "9878681", "title": "NBA／同年同月同日生！黃仁勳辭職輝達 網友神比喻：就像沒有喬丹的公牛", "summary": "輝達（NVIDIA）董事會前日宣布，創辦人黃仁勳即日起卸下所有職務。執行長職位將由輝達的財務長柯蕾絲（Colette Kress）兼任暫時代理。消息不僅震撼全球科技圈，眼尖的網友更發現，同樣退出自家領域的「籃球之神」喬丹（Michael Jordan）竟跟黃仁勳同年同月同日生，讓網友直喊，「沒有黃仁勳的輝達，就像沒有喬丹的公牛。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517903.png&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&sl=W&fw=360", "date": "2026-11-14 14:59", "link": "/news/story/7002/9878681"}, {"article_id": "9878666", "title": "亞冠賽／超罕見「全壘打完全打擊」！日本游擊砲宗山壘48小時4轟 網友：太怪物了…", "summary": "日本游擊手宗山壘今日在首局無人出局滿壘時轟出滿貫砲，幫助日本以16：1在7局「扣倒」澳洲，3戰全勝晉級15日的冠軍戰，宗山壘本屆大會不僅連3場開轟，48小時內更累積4轟，而且依序是陽春砲、兩分砲、三分砲、滿貫砲，完成罕見的「全壘打完全打擊」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517884.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 14:58", "link": "/news/story/7001/9878666"}, {"article_id": "9878691", "title": "JHBL／愛子劉衡聯賽初登場秀射手本事 劉孟竹到場觀賽「超感動」", "summary": "UBA健行科大總教練劉孟竹的兒子劉衡，經過多年的刻苦訓練，今年終於拿到生涯首件JHBL球衣，並在今天代表信義國中出戰115學年JHBL國中籃球聯賽男生組甲級預賽，劉衡在第一節就展現真本事，共砍進3顆三分球，令特地到屏東觀賽的劉孟竹興奮直呼，「看到兒子上場真的超感動，這種感覺好特別！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517911.jpg&M=1&s=Y&x=2&y=295&sw=1044&sh=696&exp=3600&sl=W&fw=360", "date": "2026-11-14 14:53", "link": "/news/story/7003/9878691"}, {"article_id": "9878689", "title": "亞冠賽／中華隊晉級條件出爐！贏球免算數學 若輸1分怎麼輸牽動天堂地獄", "summary": "日本隊以3戰全勝率先挺進冠軍賽，晚間中華隊與南韓隊過招，決定另一席誰屬，中華隊贏球就能晉級，輸球也不代表100%絕望，但比賽是否有打九局下、輸幾分，牽動結局將在天堂地獄之間。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517909.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 14:51", "link": "/news/story/7001/9878689"}, {"article_id": "9878678", "title": "NBA／森根轟43分紀錄比肩兩大巨人 范弗利特怒吼喚醒火箭搶3連勝", "summary": "火箭當家長人森根（Alperen Sengun）今天狂轟43分、12籃板、5助攻，成為繼「非洲天王」歐拉朱萬（Hakeem Olajuwon）、「中國長城」姚明之後，隊史第3位單場繳出至少40分、10籃板、5助攻，且投籃命中率達70%以上的球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517898.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 14:43", "link": "/news/story/7002/9878678"}, {"article_id": "9878626", "title": "NBA／ 才喊想幫助「阿公柯瑞」！拚明星賽的倫德伯格同日13投1中", "summary": "勇士菜鳥倫德伯格（Yaxel Lendeborg）在接受《NBA on Prime》主持人魯克斯（Taylor Rooks）專訪時，開玩笑柯瑞（Stephen Curry）已經到了「阿公等級」，表示不想浪費柯瑞生涯最後幾年，本季目標更是入選明星賽。然而，就在專訪播出當天，倫德伯格全場13投1中只拿3分，正負值－40，勇士也以85：123慘敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517837.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 14:23", "link": "/news/story/7002/9878626"}, {"article_id": "9878611", "title": "NBA／超狂迷因誕生！尼克教頭「崩潰臉」被玩壞 網友笑：頭像行李箱", "summary": "衛冕軍尼克今日在NBA盃小組賽作客溜馬，即使布朗森（Jalen Brunson）攻下全場最高33分、11助攻，仍以104：106惜敗，吞下2連敗。然而比起比賽結果，更讓球迷熱議的，是尼克總教練布朗（Mike Brown）在場邊一臉傻眼的表情，畫面隨即在社群瘋傳，網友也紛紛發揮創意玩梗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517785.png&M=1&s=Y&x=111&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-14 14:22", "link": "/news/story/7002/9878611"}, {"article_id": "9878590", "title": "中職／日本武士明年來台打交流賽 蔡其昌盼未來再加入韓國", "summary": "日本武士隊將於明年3月6、7日來台交流，中華職棒與日本職棒今天於日本東京巨蛋舉行記者會、完成簽約。中職會長蔡其昌表示，不...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517786.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 13:46", "link": "/news/story/7001/9878590"}, {"article_id": "9878613", "title": "亞冠賽／日本隊預賽10轟3戰全勝挺進冠軍賽 台韓大戰爭第2張門票", "summary": "日本隊今天繼續秀狂暴火力，全隊敲出11支安打，包括3發全壘打，「正宗」核彈頭繼續開砲，正木智也兩分砲、宗山壘滿貫砲，率領日本隊以16：1提前7局扣倒澳洲隊，以預賽3勝率先挺進冠軍賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517793.png&M=1&s=Y&x=63&y=0&sw=906&sh=604&exp=3600&sl=W&fw=360", "date": "2026-11-14 13:41", "link": "/news/story/7001/9878613"}, {"article_id": "9878589", "title": "NBA ／霸氣喊當「狗老大」！勇士菜鳥13投僅1中 多項數據寫本季最慘", "summary": "在當家球星柯瑞（Stephen Curry）受傷後，勇士陣中菜鳥倫德伯格（Yaxel Lendeborg）幾乎一致被外界看好扛起進攻重任，倫德伯格更在今日對馬刺的NBA盃賽前霸氣喊話，將成為球隊的「狗老大」，扛下更多分數。然而，倫德伯格本場出賽23分鐘，命中率卻僅7.7%，繳出3分、3失誤、正負值－40的本季最慘成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517757.jpg&M=1&s=Y&x=28&y=25&sw=1234&sh=822&exp=3600&sl=W&fw=360", "date": "2026-11-14 13:34", "link": "/news/story/7002/9878589"}, {"article_id": "9878510", "title": "NBA／「小學生」安比德低迷又掛彩 學弟化身心靈導師：你還是那個MVP", "summary": "76人昨日在主場一度落後17分下，靠著馬克西（Tyrese Maxey）全隊最高27分、8助攻，以123：112逆轉暴龍，穩居東居第一，然而當家中鋒安比德（Joel Embiid）本季表現不僅持續低迷，傷病問題更持續被外界放大。對此，陣中後衛埃奇庫姆（VJ Edgecombe）也替這位前MVP學長精神喊話。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517617.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 13:29", "link": "/news/story/7002/9878510"}, {"article_id": "9878457", "title": "MLB／不是「爛洋基」！釀酒人教頭預言對一半 包爾斯反投世仇紅襪", "summary": "釀酒人總教練墨菲（Pat Murphy）早在奪冠慶祝時，就曾預言愛將包爾斯（Jake Bauers）將獲得洋基一紙肥約，沒想到根據《ESPN》報導，今日宣布竟是世仇紅襪與這位31歲的一壘手，達成4年5800萬美元的合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517513.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 13:28", "link": "/news/story/6999/9878457"}, {"article_id": "9878586", "title": "NBA／首節就被打爆格林惱羞成怒推飛溫班亞瑪 勇士慘輸馬刺36分", "summary": "在主控柯瑞（Stephen Curry）因腹斜肌撕裂傷勢恐缺席2周至1個月的情況下，勇士今天在季中錦標賽作客馬刺主場，開賽就被對手打出18：0攻勢寫下難堪紀錄，在整場比賽一路維持超過20分落後的情況下，最終馬刺也以123：85輕取勇士，收下11連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517756.jpg&M=1&s=Y&x=0&y=128&sw=1148&sh=765&exp=3600&sl=W&fw=360", "date": "2026-11-14 13:18", "link": "/news/story/7002/9878586"}, {"article_id": "9878523", "title": "NBA／布朗森33分白搭！唐斯錯失關鍵跳投 溜馬驚險退尼克", "summary": "面對開季走得跌跌撞撞的衛冕軍紐約尼克，溜馬在主場展現鬥志，席亞康（Pascal Siakam）攻下19分、奈史密斯（Aaron Nesmith）貢獻18分，加上團隊在籃板爭奪戰取得優勢，最終以106比104驚險擊敗尼克。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517644.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 12:49", "link": "/news/story/7002/9878523"}, {"article_id": "9878492", "title": "NBA／巴克利酸騎士「爛透了」 米契爾踢館成功回嗆：誰在乎", "summary": "前日騎士在「大鬍子」哈登（James Harden）復活下，全場轟下最高，也是個人賽季最佳的32分，成功以115：107踢館尼克。然而賽前，名嘴巴克利（Charles Barkley）卻在《Inside the NBA》節目中狠酸「騎士爛透了！」，也讓當家球星米契爾（Donovan Mitchell）贏得勝利後，毫不客氣回嗆，「誰在乎啊？」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517572.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 12:32", "link": "/news/story/7002/9878492"}, {"article_id": "9878508", "title": "MLB／大聯盟官網評選自由市場10大強打 鈴木誠也、佐藤暉明排前二", "summary": "大聯盟進入休賽季，官網針對今年自由球員市場上最佳打者進行評選，列出前10名強打，其中前兩名都是日籍球星，包括小熊隊外野手鈴木誠也，以及今年季後透過入札制度挑戰大聯盟的阪神隊內野手佐藤輝明。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517612.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 12:32", "link": "/news/story/6999/9878508"}, {"article_id": "9878489", "title": "WTA年終賽／前搭檔不幫忙、自己也輸球 謝淑薇、O妹無緣女雙4強", "summary": "WTA年終賽女雙分組賽最後一天賽程，我國好手謝淑薇與搭檔「O妹」奧斯塔朋科（Jelena Ostapenko）今天迎戰加拿大達布洛夫斯基（Gabriela Dabrowski）／巴西史蒂芬妮（Luisa Stefani），最終在超級搶十敗下陣來，以6：2、6：7（2：7）、3：10遭到逆轉，加上前搭檔比利時梅騰絲（Elise Mertens）／中國大陸張帥未能擊敗中國大陸郭涵煜／法國茉蘭登諾維琪（Kristina Mladenovic），確定無緣4強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517589.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-14 12:19", "link": "/news/story/7005/9878489"}]}, {"name": "棒球", "articles": [{"article_id": "9878666", "title": "亞冠賽／超罕見「全壘打完全打擊」！日本游擊砲宗山壘48小時4轟 網友：太怪物了…", "date": "2026-11-14 14:58", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517884.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9878666"}, {"article_id": "9878613", "title": "亞冠賽／日本隊預賽10轟3戰全勝挺進冠軍賽 台韓大戰爭第2張門票", "date": "2026-11-14 13:41", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/14/35517793.png&M=1&s=Y&x=63&y=0&sw=906&sh=604&exp=3600&w=300", "link": "/news/story/7001/9878613"}, {"article_id": "9878274", "title": "U23世界盃／雷皓博完投7局+黃鈞麟超前轟 中華隊2：1逆轉日本收二連勝", "date": "2026-11-14 10:23", "thumbnail":