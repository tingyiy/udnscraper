gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222665.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/7002/9686424"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9685328", "title": "中職／全季排名戰局詭譎富邦還在線！ 831大限成突圍關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35219029.jpg&M=1&s=Y&x=0&y=0&sw=1107&sh=738&exp=3600&w=300", "link": "/news/story/122629/9685328"}, {"article_id": "9684672", "title": "日職／林安可手感好卻膝傷缺陣 西武傷兵潮來得不是時候", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168266.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684672"}, {"article_id": "9684466", "title": "金鶯震撼出清狀元拉契曼 第二代「面具鐵爺」再次遺憾收場", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35220091.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684466"}, {"article_id": "9682402", "title": "日職／洋將及捕手戰力考量 火腿林家正或有上一軍開箱機會", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217245.jpg&M=1&s=Y&x=0&y=0&sw=927&sh=618&exp=3600&w=300", "link": "/news/story/122629/9682402"}, {"article_id": "9682472", "title": "從什麼都想打到知道什麼不能打 小熊阿姆斯壯蛻變成MVP關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217330.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9682472"}, {"article_id": "9682771", "title": "德羅展生涯已到窮途末路？ 中距離教科書仍是爭冠球隊拼圖！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217792.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9682771"}]}, {"name": "最新文章", "articles": [{"article_id": "9686312", "title": "MLB／近8年恐迎第6任總教練？天使45勝74敗逼出球團「全面改革」", "summary": "本季戰績僅45勝74敗、排名全大聯盟墊底的天使，正在經歷近年最大規模的組織重整。從6月底開除總管米納西安（Perry Minasian）後、球隊從交易大限大量送走主力，到如今一次撤換3名投手部門教練，種種跡象都顯示，這支已經長期無緣季後賽的球隊，正試圖徹底改變過去的經營方向。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222591.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 11:52", "link": "/news/story/6999/9686312"}, {"article_id": "9686424", "title": "NBA／柯瑞月底符合續約資格 總管自信說：會當終身勇士人", "summary": "勇士隊當家球星柯瑞（Stephen Curry）即將符合續約條件，球隊總管小鄧利維（Mike Dunleavy Jr.）再次重申，有自信球隊的指標球星會當永遠的勇士人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222665.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 11:46", "link": "/news/story/7002/9686424"}, {"article_id": "9686342", "title": "MLB／李灝宇連7場未先發今整場坐板凳 老虎終止對戰守護者6連敗", "summary": "老虎隊今天在主場對上守護者隊，碰上「台灣日」活動，賽前還有李灝宇學弟、新明國中青少棒隊球員們上場參與唱國歌環節，但陣中唯一的台灣球員李灝宇今天依舊沒先發，整場坐板凳，最終老虎隊以6：4擊敗守護者，近10戰拿8勝，且終止本季對戰守護者6連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222098.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-12 11:28", "link": "/news/story/6999/9686342"}, {"article_id": "9686281", "title": "MLB／6周前才保證不砍人！天使總管揭炒教練翻臉原因：有科技卻沒充分利用", "summary": "天使今日一口氣開除冠軍投手教練麥達克斯（Mike Maddux）、助理投手教練史考特（Darryl Scott）以及牛棚教練奇提（Dom Chiti），不過真正引發討論的並不只有3名教練突然遭到解職，而是代理總管莫澤利亞克（John Mozeliak）直接點出球團長期存在的，直言投手部門擁有科技與數據分析資源，卻沒有充分利用。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222312.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 11:18", "link": "/news/story/6999/9686281"}, {"article_id": "9686290", "title": "NBA／傳勇士有意網羅西蒙斯 美媒不看好契合度：應培養倫德伯格", "summary": "2016年狀元西蒙斯（Ben Simmons）正尋求重返NBA，勇士隊確實也需要側翼球員，不過美國媒體「運動畫刊」認為，勇士不該簽下西蒙斯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222370.jpg&M=1&s=Y&x=218&y=277&sw=863&sh=576&exp=3600&sl=W&fw=360", "date": "2026-08-12 11:14", "link": "/news/story/7002/9686290"}, {"article_id": "9686283", "title": "TPBL／夢想家補強團隊 加入戰神前代理總教練", "summary": "TPBL衛冕軍福爾摩沙夢想家隊今天正式宣布教練團異動，塞爾維亞籍米蘭（Milan Stevanovic）擔任助理教練，義大利籍羅馬諾（Michele Romano）擔任體能訓練師，兩人將分別從戰術與體能面向，為球隊帶來國際經驗與專業能量。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222313.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 11:10", "link": "/news/story/7003/9686283"}, {"article_id": "9686244", "title": "MLB／天使投手群單季508保送、20次砸鍋！冠軍投教麥達克斯等3人慘遭提前開除", "summary": "本季戰績僅45勝74敗、排名全大聯盟墊底的天使，確定將迎來連續第11個勝率未達5成的球季。今日球團也正式對教練團開刀，一口氣開除投手教練麥達克斯（Mike Maddux）、助理投手教練史考特（Darryl Scott）以及牛棚教練奇提（Dom Chiti），3人甚至都還沒做完整個加盟天使的第1個賽季，就提前遭到解職。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222311.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 11:09", "link": "/news/story/6999/9686244"}, {"article_id": "9686117", "title": "MLB／不用躺到手術台！道奇拉辛不動刀盼本季回歸蹲捕", "summary": "道奇25歲捕手拉辛（Dalton Rushing）自8月2日後，因右手肘尺側副韌帶出現「輕微撕裂」便沒有再出賽，不過他的復健進度傳來好消息。根據道奇隨隊記者瓦塞（David Vassegh）透露，拉辛確定不會接受手術，休賽季也沒有動刀計畫，更樂觀看待自己本季重新戴上捕手面罩的可能性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222054.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 10:49", "link": "/news/story/6999/9686117"}, {"article_id": "9686155", "title": "MLB／道奇史奈爾重返大聯盟 巴恩斯遭下放3A、崔能進60天傷兵名單", "summary": "道奇隊2屆塞揚左投史奈爾（Blake Snell）傷癒復出，今天先發戰皇家隊，道奇將30歲左投巴恩斯（Charlie Barnes）下放3A，明星後援右投崔能（Blake Treinen）轉進60天傷兵名單。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222111.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 10:23", "link": "/news/story/6999/9686155"}, {"article_id": "9686146", "title": "MLB／9年前在底特律許下的夢想成真 李灝宇今與新明國中學弟相見歡", "summary": "老虎隊今天在主場迎戰守護者隊，李灝宇賽前迎接一批熟悉的嘉賓來訪，母校新明國中教練團率領學弟們赴美參與LLB世界次青棒賽錦標賽，賽前現身老虎球場和李灝宇相見歡，老虎社群特別發出照片，紀錄這個特別的「圓夢」時刻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222096.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-12 10:21", "link": "/news/story/6999/9686146"}, {"article_id": "9686139", "title": "排球／目標突破上屆銀牌成績 中華隊亞洲東區賽旗開得勝", "summary": "中華女排在2026亞洲東區女子排球錦標賽首戰以直落三戰勝澳門，成功開局。接下來將面對中國，力求超越上屆銀牌成績，衝擊冠軍目標。選手温以勤重返國家隊，期待以最佳狀態貢獻團隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222084.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 10:19", "link": "/news/story/7005/9686139"}, {"article_id": "9686076", "title": "MLB／道奇弗里曼和帕赫斯打序互換 羅伯茲解釋「西語老師」失去先發", "summary": "道奇隊今天做出先發打線異動，左打弗里曼（Freddie Freeman）改打第二棒，右打帕赫斯（Andy Pages）被調往第三棒，「西語老師」赫南德茲（Teoscar Hernández）則被移出先發打線。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222025.jpg&M=1&s=Y&x=0&y=0&sw=1055&sh=703&exp=3600&sl=W&fw=360", "date": "2026-08-12 10:03", "link": "/news/story/6999/9686076"}, {"article_id": "9685981", "title": "MLB／勇士球迷親自歸還 千賀滉大生涯首救援球失而復得", "summary": "大都會隊日籍投手千賀滉大昨天代班終結者，拿下生涯首次救援成功，但那顆紀念球卻被隊友班吉（Carson Benge）丟上觀眾席，讓千賀放聲大笑。好消息是，這段影片中在社群上廣傳後，成功找到該球迷，千賀滉大今天也順利拿回這顆「首救援球」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35221924.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 09:33", "link": "/news/story/6999/9685981"}, {"article_id": "9685846", "title": "足球／「C❤️G」！C羅結束10年愛情長跑 5名子女見證下完婚", "summary": "根據公關說法，葡萄牙足球巨星「C羅」羅納度和交往10年的伴侶羅德里格斯今天在葡萄牙度假勝地卡斯凱什（Cascais）結為...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35222215.jpg&M=1&s=Y&x=0&y=57&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-12 09:11", "link": "/news/story/7005/9685846"}, {"article_id": "9685860", "title": "多倫多女網／逆轉奧運金牌差一步 謝淑薇連兩年止步四強", "summary": "我國「一姊」謝淑薇多倫多女網賽和拉脫維亞前搭檔奧斯塔朋科（Jelena Ostapenko）重新合體，名列第5種子的台拉組合一路闖進4強，今天對巴黎奧運奪金的義大利老將艾拉妮（Sara Errani）／美國梅莉雪（Nicole Melichar-Martinez）爭決賽門票，兩組人馬激戰到「超級搶10」，台拉組合雖從4：8落後追到8：8平手，但關鍵分沒能拿下，讓謝淑薇連兩年停在四強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35221844.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-12 08:25", "link": "/news/story/7005/9685860"}, {"article_id": "9684672", "title": "日職／林安可手感好卻膝傷缺陣 西武傷兵潮來得不是時候", "summary": "西武隊在關鍵期面臨傷兵潮，林安可因膝傷缺陣，影響球隊表現。雖然林安可七、八月表現佳，但主力打者集體受傷，使西武隊在爭奪季後賽席次上困難重重。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/24/35168266.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 07:00", "link": "/news/story/122629/9684672"}, {"article_id": "9685328", "title": "中職／全季排名戰局詭譎富邦還在線！ 831大限成突圍關鍵", "summary": "中職戰局緊繃，831洋將登錄大限成為各隊的補強關鍵。味全龍已晉級，其他隊伍僅有兩個季後賽名額，樂天桃猿與富邦悍將面臨補強壓力。洋投的選擇需靈活應變，期待能找到適合球隊的實力選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35219029.jpg&M=1&s=Y&x=0&y=0&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-08-12 07:00", "link": "/news/story/122629/9685328"}, {"article_id": "9684466", "title": "金鶯震撼出清狀元拉契曼 第二代「面具鐵爺」再次遺憾收場", "summary": "金鶯隊驚人出清當家捕手拉契曼，送往紅襪隊，回收多名有潛力新秀，象徵重建新篇章。拉契曼在球隊重建過程中扮演核心角色，卻因傷病困擾，未能實現预期佳績。此交易不僅改變金鶯戰力，也令球迷感到不捨。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35220091.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 07:00", "link": "/news/story/122629/9684466"}, {"article_id": "9685377", "title": "NBA／開幕戰賽程曝光 詹姆斯加盟76人首戰對決尼克", "summary": "美國職籃NBA今天公布2026-27球季部分賽程，超級巨星詹姆斯（LeBronJames）加盟費城76人後，將於10月2...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221293.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-11 22:15", "link": "/news/story/7002/9685377"}, {"article_id": "9685364", "title": "中職／陳鏞基溫暖叮嚀催生追平轟 朱迦恩：沒有辜負基哥", "summary": "生涯在台東棒球場的第一個打席，陳鏞基就敲二壘打為統一獅隊首開紀錄，有他溫暖守護的學弟們也很爭氣，第八局朱迦恩敲追平轟、林子豪敲超前安，獅隊終場以3：2逆轉擊敗樂天桃猿隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221295.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-11 21:43", "link": "/news/story/7001/9685364"}, {"article_id": "9685363", "title": "籃球／波波卡第四節犯滿 政大不敵上海交大AUBL連霸夢碎", "summary": "UBA公開男一級霸主政治大學「雄鷹」籃球隊，去年抱回第一屆亞洲大學生籃球聯賽（Asian University Basketball League，AUBL）冠軍，今年第二屆賽事再度打進冠軍戰，今天和上海交大進行最終對決，政大第二節曾握有兩位數領先，但第三節僅拿10分，外籍生波波卡第四節又犯滿離場，加上最後連番失誤，最終以69：72無緣連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221254.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-11 21:43", "link": "/news/story/7003/9685363"}, {"article_id": "9685350", "title": "中職／就是守不住！雄鷹連4場逆轉敗 下半季、全年都跌B段班", "summary": "台鋼雄鷹隊黃子鵬8局僅失1分的超好投，等不到一場勝投，黃群第九局關門卻被炸開大門，讓味全龍隊單局攻下6分，雄鷹終場以4：7輸球，吞下4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221307.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-11 21:35", "link": "/news/story/7001/9685350"}, {"article_id": "9685335", "title": "足球／亞足聯挑戰聯賽 台灣雙雄資格賽突圍成功", "summary": "2026-27賽季亞足聯挑戰聯賽（AFC Challenge League）資格賽今天傳來捷報，代表台灣出征的台南市台灣鋼鐵足球俱樂部與新北航源足球俱樂部雙雙在蒙古賽場取得勝利，攜手挺進小組賽階段。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221247.jpg&M=1&s=Y&x=0&y=0&sw=1085&sh=723&exp=3600&sl=W&fw=360", "date": "2026-08-11 21:18", "link": "/news/story/7005/9685335"}, {"article_id": "9685301", "title": "亞洲少棒／好棒！中華隊3:1力克南韓隊 分組第一到手帶1勝晉複賽", "summary": "U12亞洲少棒錦標賽今天上演台韓過招，中華隊把握南韓隊投手開賽不穩，前2局攻下3分，儘管差距一直未能拉開，台灣小將屢次面對危機驚險度過，最終以3：1擊敗南韓隊。中華隊贏球後取得2勝，確定將以分組第1、帶1勝進入複賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35221197.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-11 20:54", "link": "/news/story/7001/9685301"}]}, {"name": "棒球", "articles": [{"article_id": "9685364", "title": "中職／陳鏞基溫暖叮嚀催生追平轟 朱迦恩：沒有辜