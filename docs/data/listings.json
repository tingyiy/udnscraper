79999", "title": "側翼集體失靈、進攻引擎當機 尼克場內外凝聚力是回升關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/15/35519936.jpg&M=1&s=Y&x=363&y=36&sw=917&sh=611&exp=3600&w=300", "link": "/news/story/122629/9879999"}]}, {"name": "最新文章", "articles": [{"article_id": "9887448", "title": "射箭／亞洲盃杭州站 中華反曲弓男、女團闖4強拚獎牌", "summary": "2026射箭亞洲盃杭州站，由戴宇軒、黃立承及林育暘組成的中華反曲弓男團，今天在8強戰以6比2射落中國隊，攜手反曲弓女團挺...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531110.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 21:16", "link": "/news/story/7005/9887448"}, {"article_id": "9887446", "title": "UBA／板凳後衛當英雄 北護延長賽驚險退輔大", "summary": "115學年度富邦人壽UBA大專籃球聯賽，公開女一級預賽第一階段進入第二天就有戲劇一仗，上季拿二級亞軍、本季回升一級的台北護大隊史一級首遇上季第八輔仁大學，正規賽戰平，延長賽第二後衛莊宛諭關鍵抄截加上超前罰球，助隊驚險以56：53收下開季首勝，為「保級」注入強心針。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531092.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 21:09", "link": "/news/story/7003/9887446"}, {"article_id": "9887431", "title": "香港羽賽／敗給19歲印尼小將 周天成首輪爆冷出局", "summary": "香港公開賽列男單第5種子的我國「一哥」周天成，今天首輪迎戰世界排名23的印尼19歲小將烏拜迪拉（Mohammad Zaki Ubaidillah），小天意外以19：21、21：7、19：21落馬，首輪出局，爆出小冷門。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531093.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 20:56", "link": "/news/story/7005/9887431"}, {"article_id": "9887369", "title": "棒球／廖韋勛強攻3安猛打 福林國小火力展示奪重光盃隊史第二冠", "summary": "2026年第18屆重光盃全國少棒錦標賽18日進入最終決戰，台北市福林國小冠軍戰投打都有發揮，以7：2擊敗桃園市中平國小，繼2021年後再捧重光盃冠軍，季軍則是本屆「黑馬」新北市大豐國小。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531018.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 20:10", "link": "/news/story/7001/9887369"}, {"article_id": "9887331", "title": "棒球／名譽理事長辜仲諒 肯定棒協、中職全面合作籌組中華隊", "summary": "辜仲諒肯定棒協與中職合作組成中華隊，棒協明年將辦U15全國國中棒球大賽，扎根基層培育新秀，提供年輕選手發展舞臺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530969.jpg&M=1&s=Y&x=0&y=104&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 19:54", "link": "/news/story/7001/9887331"}, {"article_id": "9887213", "title": "擊劍／全國青少年排名賽奪軍刀冠軍 中興擊劍好手黃采蓉獲選亞青國手", "summary": "南投縣立中興國中選手黃采蓉，在115年全國青少年排名賽暨代表隊選拔中，勇奪女子軍刀項目冠軍，取得2027年亞洲青年暨青少年擊劍錦標賽國家代表權，為南投體育寫下亮眼新頁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530832.jpg&M=1&s=Y&x=0&y=0&sw=1162&sh=775&exp=3600&sl=W&fw=360", "date": "2026-11-18 18:41", "link": "/news/story/7005/9887213"}, {"article_id": "9887209", "title": "滑輪溜冰／台灣公開賽相隔7年重返北市 14國1384名選手同場競速", "summary": "2026台灣國際滑輪溜冰公開賽將於11月19日至22日重返台北市大佳河濱運動公園舉行。台北不僅是本屆賽事的舉辦城市，更是2019年首屆國際公開賽的起點。歷經疫情停辦三年及後續賽事的延續，今年再次回到最初舉辦的城市，別具傳承與象徵意義。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530824.jpg&M=1&s=Y&x=0&y=0&sw=969&sh=646&exp=3600&sl=W&fw=360", "date": "2026-11-18 18:38", "link": "/news/story/7005/9887209"}, {"article_id": "9887207", "title": "TPBL／感恩節主場迎敵 夢想家好禮贈球迷", "summary": "福爾摩沙夢想家本週迎來「Thanksgiving Day」主題週，11月21、22及25日於臺中洲際迷你蛋先後迎戰高雄全家海神、新北中信特攻及新竹御嵿攻城獅，球團攜手合作夥伴準備多項互動與回饋好禮，從入場、節間暫停到中場遊戲，三場賽事接力送上感恩回饋，邀請所有「我夢」家人齊聚主場，共度熱鬧的感恩節。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530822.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-18 18:37", "link": "/news/story/7003/9887207"}, {"article_id": "9887026", "title": "日職／改革！明年試行投球計時器不設罰則 為2028洛杉磯奧運停賽3周", "summary": "日本職棒球團老闆會議今天舉行，決定自2027年賽季起試行「投球計時器制度」，不設置罰則，另外為了2028年洛杉磯奧運，將暫停例行賽3周。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530508.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-18 17:19", "link": "/news/story/7001/9887026"}, {"article_id": "9887034", "title": "衝浪／頂尖好手齊聚台東 台灣公開賽最終決賽周日登場", "summary": "2026台灣國際衝浪公開賽自14日起於台東金樽海域展開國際賽事，吸引世界各國頂尖衝浪好手齊聚台東，挑戰世界衝浪聯盟（WSL）INTL 6000巡迴積分賽。隨著賽事進入最後階段，各國選手的晉級競爭日益激烈，今天到22日將迎來賽事最精彩的關鍵對決，並預計於周日舉行最終決賽，角逐年度最終站冠軍榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530471.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 17:14", "link": "/news/story/7005/9887034"}, {"article_id": "9887020", "title": "冬盟／台日韓球員簽名會登場 資格券每張1600元後天中午開賣", "summary": "2026冬季棒球聯盟正式開打，為讓球迷近距離與各隊球員見面，今年規劃4場球員簽名會，邀請台灣山林隊、台灣海洋隊、日職聯隊、韓職聯隊參與，資格券將於20日中午12點起，透過ibon售票系統正式開賣，每張售價1600元，每人每場次限購一張，各場次限量60名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530462.png&M=1&s=Y&x=113&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-18 17:12", "link": "/news/story/7001/9887020"}, {"article_id": "9886808", "title": "NBA／傳奇射手佩賈之子NCAA狂轟46分破69年紀錄！得分甚至超越老爸生涯新高", "summary": "安德烈狂轟46分，率伊利諾大學99：78擊敗杜克，改寫卡麥隆球館69年客隊紀錄，並超越父親NBA單場最高分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530239.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 16:12", "link": "/news/story/7002/9886808"}, {"article_id": "9886845", "title": "NBA／精心策劃？黃蜂主帥關鍵時刻不讓主力上場 球迷怒轟：FBI必須調查", "summary": "湖人隊今天克服18分落後，靠著葛萊姆斯（Quentin Grimes）狂轟47分，在延長賽以118：114擊敗黃蜂隊。不過黃蜂詭異的陣容調度成為賽後焦點，網友們紛紛呼籲FBI介入調查。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530235.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 16:04", "link": "/news/story/7002/9886845"}, {"article_id": "9886721", "title": "NBA／兩次自拋自扣救不了12連勝！溫班亞瑪：是當頭棒喝", "summary": "溫班亞瑪兩度自拋自扣仍難救馬刺，遭活塞逆轉吞敗，12連勝中斷；他坦言這是球隊的現實提醒，教練也承認防守仍待改善。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530023.jpg&M=1&s=Y&x=0&y=0&sw=1142&sh=761&exp=3600&sl=W&fw=360", "date": "2026-11-18 15:54", "link": "/news/story/7002/9886721"}, {"article_id": "9886729", "title": "NBA／傳勇士可能送走巴特勒或格林 美媒建議：交易來戴維斯", "summary": "勇士隊本季受到嚴重傷兵問題，但曾打出8連勝讓球迷看見希望。據ESPN記者史皮爾斯（Marc J. Spears）報導，勇士考慮在交易大限前送走老將巴特勒（Jimmy Butler）或格林（Draymond Green），美國球評柏金斯（Kendrick Perkins）則建議去交易巫師隊明星長人戴維斯（Anthony Davis）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530020.jpg&M=1&s=Y&x=0&y=0&sw=1179&sh=786&exp=3600&sl=W&fw=360", "date": "2026-11-18 15:16", "link": "/news/story/7002/9886729"}, {"article_id": "9886714", "title": "NBA／葛萊姆斯10記三分球砍生涯新高47分 湖人OT逆轉黃蜂收9連勝", "summary": "近期拉出8連勝的聯盟戰績龍頭湖人隊，在今天作客黃蜂隊主場，在兩隊都有主力缺陣的情況下，黃蜂今天雖然整場比賽一路領先，但湖人葛萊姆斯（Quentin Grimes）手感發燙狂轟47分，包括在正規賽結束前投進追平比數三分球，還在延長賽有關鍵防守表現，幫助湖人以118：114逆轉勝出，收下9連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529996.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 15:08", "link": "/news/story/7002/9886714"}, {"article_id": "9886708", "title": "NBA／阿基里斯腱斷裂後首度坐滑板車現身 西蒙斯回國王球館暖聊隊友", "summary": "國王隊後衛西蒙斯（Ben Simmons）雖因右腳阿基里斯腱斷裂，確定整季報銷，但他並未遠離球隊。近日社群流出畫面，西蒙斯坐著術後使用的膝行滑板車回到國王訓練館，還與同樣在養傷的法國中鋒雷諾（Maxime Raynaud）聊天，展現不錯精神狀態。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529989.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-18 15:08", "link": "/news/story/7002/9886708"}, {"article_id": "9886665", "title": "東吳超馬27年聯手故宮 跨界特展五大主題為賽事倒數領跑", "summary": "2026東吳國際超級馬拉松將於12月5日至6日在東吳大學外雙溪校區溪望操場熱血開跑，今年東吳大學與國立故宮博物院再續前緣，共同策辦「藝動雙溪—東吳×故宮奔騰無界特展」。即日起至12月11日，以「金牌賽事、跨域合作、性別平權、慈善公益、台灣之光」五大主題，呈現東吳超馬的精神與故事。以「奔騰無界」為主題，結合故宮典藏文物與東吳超馬精華賽事影像，從速度、耐力、專注及突破極限等面向，探索古代技藝與現代運動之間的共通精神。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529900.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-18 14:49", "link": "/news/story/7005/9886665"}, {"article_id": "9886571", "title": "NBA／新家硬蓋半場籃球場被老婆罵翻！ 詹姆斯認錯：退役後可能用不到", "summary": "生涯第24季仍在NBA征戰的詹姆斯（LeBron James），近日在家裡蓋了一座半場籃球場，卻意外惹毛妻子莎凡娜（Savannah James）。他笑著坦承，太太的質疑完全有道理，因為自己退役後，這座球場很可能只會留著「占空間」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529780.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 14:26", "link": "/news/story/7002/9886571"}, {"article_id": "9886580", "title": "NBA／馬刺哈波終場前傷退狀況不明 溫班亞瑪：討厭這樣", "summary": "馬刺隊今天以93：105敗給活塞隊，不但12連勝告終，先發後衛哈波（Dylan Harper）第四節剩下53.6秒還受傷提前退場，溫班亞瑪（Victor Wembanyama）直說「討厭這樣」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529744.jpg&M=1&s=Y&x=0&y=0&sw=1203&sh=802&exp=3600&sl=W&fw=360", "date": "2026-11-18 14:14", "link": "/news/story/7002/9886580"}, {"article_id": "9886544", "title": "NBA／「佩賈之子」轟46分破紀錄、斷35連勝！杜克教練：歷史級表現", "summary": "前NBA名將「佩賈」史托亞克維奇（Peja Stojakovic）之子小史托亞克維奇（Andrej Stojakovic）今天在NCAA大爆發，帶領全美排名第10的伊利諾大學以99：78大勝排名第5的杜克大學，終結杜克大學主場35連勝，全場狂砍46分，創杜克主場客隊球員最高分紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529671.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 14:08", "link": "/news/story/7002/9886544"}, {"article_id": "9886522", "title": "香港羽賽／逆轉勝！林俊易終於止住連四站「一輪遊」", "summary": "今年全英公開賽奪下男單冠軍的「左手重砲」林俊易，下半年受傷勢影響勝少敗多，今天香港公開賽總算把握機會，面對世界排名37的加拿大華裔對手楊燦演出逆轉勝，以15：21、21：16、21：14奪勝，止住連同名古屋亞運在內的連六站「一輪遊」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529664.jpg&M=1&s=Y&x=0&y=0&sw=1215&sh=810&exp=3600&sl=W&fw=360", "date": "2026-11-18 13:56", "link": "/news/story/7005/9886522"}, {"article_id": "9886459", "title": "NBA／從小學喬丹後仰跳投反害了自己！ 詹姆斯自曝壞習慣至今仍在", "summary": "NBA歷史得分王詹姆斯（LeBron James）從不避諱喬丹（Michael Jordan）是自己少年時期的偶像，甚至連23號球衣都深受影響。不過他近日卻坦言，年少時太想成為「下一個喬丹」，反而在投籃動作中養成至今仍難完全擺脫的壞習慣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529573.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 13:46", "link": "/news/story/7002/9886459"}, {"article_id": "9886324", "title": "MLB／「龍仔」3A兩季36轟還進不了40人名單！ 馬林魚想賭一把", "summary": "台灣混血強打「龍仔」強納森．龍（Jonathon Long）連兩年在3A繳出亮眼火力，卻仍無緣大聯盟，甚至沒能擠進馬林魚隊40人名單。表面看來令人意外，但攤開球探報告便能發現，他不是球棒不夠好，而是「右打一壘手」這個位置，對長打要求實在太殘酷。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529426.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-18 13:11", "link": "/news/story/6999/9886324"}]}, {"name": "棒球", "articles": [{"article_id": "9887369", "title": "棒球／廖韋勛強攻3安猛打 福林國小火力展示奪重光盃隊史第二冠", "date": "2026-11-18 20:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35531018.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9887369"}, {"article_id": "9887331", "title": "棒球／名譽理事長辜仲諒 肯定棒協、中職全面合作籌組中華隊", "date": "2026-11-18 19:54", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530969.jpg&M=1&s=Y&x=0&y=104&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9887331"}, {"article_id": "9887026", "title": "日職／改革！明年試行投球計時器不設罰則 為2028洛杉磯奧運停賽3周", "date": "2026-11-18 17:19", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530508.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9887026"}, {"article_id": "9887020", "title": "冬盟／台日韓球員簽名會登場 資格券每張1600元後天中午開賣", "date": "2026-11-18 17:12", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530462.png&M=1&s=Y&x=113&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9887020"}, {"article_id": "9886093", "title": "12強賽／WBSC重提中華隊2009經典賽慘案 激勵中國拚隊史首次正賽", "date": "2026-11-18 12:01", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35529075.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9886093"}]}, {"name": "MLB", "articles": [{"article_id": "9885740", "title": "MLB／4名台灣戰力未進40人名