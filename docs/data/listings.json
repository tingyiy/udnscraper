{"全球": {"slider": [{"article_id": "9742567", "title": "關稅報復 美加貿易戰升溫", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309183.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600", "link": "/news/story/6809/9742567"}, {"article_id": "9742606", "title": "台積電攜ASML 拚次世代製程", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/21/35251911.jpg&M=1&s=Y&x=0&y=23&sw=1280&sh=853&exp=3600", "link": "/news/story/6811/9742606"}, {"article_id": "9742621", "title": "日圓碰觸153 寫七個月高點", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35306208.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600", "link": "/news/story/6811/9742621"}, {"article_id": "9742626", "title": "法國AI新創Mistral募資 估值翻倍", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309453.png&M=1&s=Y&x=0&y=0&sw=627&sh=418&exp=3600", "link": "/news/story/6811/9742626"}, {"article_id": "9742614", "title": "防台灣有事 日擴大跨國防衛網", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309215.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600", "link": "/news/story/6809/9742614"}, {"article_id": "9741357", "title": "川普曬超大美國地圖！一口氣劃入32個國家地區 加拿大、墨西哥入列", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35307535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/6813/9741357"}], "subsections": [{"name": "最新文章", "articles": [{"article_id": "9742841", "title": "加拿大對美報復關稅生效 川普揚言再反制", "summary": "《聯合報數位版》即日起每周一至周五，推出「今日紐時頭條」，由資深編譯一早為讀者精選三篇《紐約時報》今日重點新聞，30秒事件摘要快速歸納重點，讓讀者輕鬆掌握全球脈動。\n頭條一：加拿大對美報復關稅生效 川普揚言再反制\n頭條二：錢凱港曝美國對中施壓極限秘魯不願選邊\n頭條三：以軍連3日猛攻黎南至少27死 奪戰略高地後恐深入黎境", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35308521.png&M=1&s=Y&x=0&y=0&sw=930&sh=620&exp=3600&sl=W&fw=360", "date": "2026-09-09 06:00", "link": "/news/story/6809/9742841"}, {"article_id": "9742826", "title": "控種族清洗 英法加將禁止進口以色列屯墾區商品", "summary": "英國、法國與加拿大今天表示，將禁止進口以色列在被占領的約旦河西岸所設屯墾區的商品，英國外交大臣更指責以色列對當地巴勒斯坦...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_7.jpg", "date": "2026-09-09 04:47", "link": "/news/story/6809/9742826"}, {"article_id": "9742615", "title": "加國對美祭報復性關稅 700項商品稅率最高50%", "summary": "加拿大總理卡尼領導的政府將於美東時間8日凌晨零時01分（台灣8日中午12時01分）起，正式對大約700項美國商品課徵15%至50%的報復性關稅，反擊美國對約200億美元加拿大商品課徵最高50%關稅，美加貿易戰進一步升級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_1.jpg", "date": "2026-09-09 02:30", "link": "/news/story/6811/9742615"}, {"article_id": "9742611", "title": "韓擬在美蓋八座核電廠", "summary": "南韓媒體報導，南韓政府計劃到美國興建八座大型核電廠，總投資金額估達1,200億美元，此案預料將列入最快於18日簽署的韓美策略投資協議之中。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_2.jpg", "date": "2026-09-09 02:30", "link": "/news/story/6811/9742611"}, {"article_id": "9742607", "title": "川普貼文 曬「大美國」地圖 加、墨等32個國家地區被劃入版圖", "summary": "美國總統川普7日在Trutch Social分享一張AI生成地圖，將美國國旗直接覆蓋加拿大、墨西哥、格陵蘭、冰島、古巴、牙買加及中美洲、加勒比海多地，相當於把大半個北美洲、共32個其他國家與地區都劃入美國版圖。川普沒有附上任何說明，白宮也未表明這代表正式政策，但他先前多次談及加拿大成為第51州、取得格陵蘭控制權，這張地圖迅速引發外界關注。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_2.jpg", "date": "2026-09-09 02:28", "link": "/news/story/6811/9742607"}, {"article_id": "9742626", "title": "法國AI新創Mistral募資 估值翻倍", "summary": "法國AI新創公司Mistral在最新一輪募資籌得30億歐元（約35億美元），是歐洲未上市科技公司歷來最大規模股權融資。Mistral表示，資金將用於強化模型運算能力、投資前沿研究，並擴充AI基礎設施，以追趕美中對手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309453.png&M=1&s=Y&x=0&y=0&sw=627&sh=418&exp=3600&sl=W&fw=360", "date": "2026-09-09 02:21", "link": "/news/story/6811/9742626"}, {"article_id": "9742634", "title": "歐洲車企示警衝擊榮景 呼籲與陸企建立互惠關係", "summary": "歐洲汽車零件巨人Gestamp的董座警告，歐洲的經濟繁榮和財富將難以為繼，除非能拯救汽車工業，並與中國大陸車廠建立互惠關係，關鍵在於促使陸企在歐洲設廠、創造工作機會。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309223.jpg&M=1&s=Y&x=0&y=0&sw=1230&sh=820&exp=3600&sl=W&fw=360", "date": "2026-09-09 02:19", "link": "/news/story/6811/9742634"}, {"article_id": "9742644", "title": "法、韓砸368億挺獨立電影", "summary": "法國總統馬克宏呼籲，在人工智慧（AI）與串流影音平台盛行時代，應致力於保護電影產業，並宣布法國與南韓將共同投資10億歐元（約新台幣368億元），支持獨立電影製作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_9.jpg", "date": "2026-09-09 02:18", "link": "/news/story/6811/9742644"}, {"article_id": "9742604", "title": "布蘭特油價連三漲 逼近100美元", "summary": "伊朗和美國戰火再起，國際油價在荷莫茲海峽航運風險升高下應聲續漲，布蘭特期貨價在紐約8日早盤連續第三天上漲，一度離每桶100美元大關不到1美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309087.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 01:38", "link": "/news/story/6811/9742604"}, {"article_id": "9742600", "title": "銅價飆新高 一年來漲47%", "summary": "國際銅價創新高，市場預期川普政府可能對精煉銅加徵關稅，交易商今年已把數十萬噸銅運往美國，搶賺美國較高銅價帶來的套利機會，短期供應因此吃緊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_8.jpg", "date": "2026-09-09 01:36", "link": "/news/story/6811/9742600"}, {"article_id": "9741369", "title": "韓法各砸5.8億美元拚影視產業 李在明提「Kpop獵魔女團」", "summary": "南韓總統李在明目前正在法國進行國是訪問，7日與法國總統馬克宏共同宣布，將為電影、影像產業各投資5億歐元(約5.8億美元)，除了活絡各自國家的影視產業外，也進一步推動兩國共同投資、共同製作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35307561.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 01:25", "link": "/news/story/6811/9741369"}, {"article_id": "9742606", "title": "台積電攜ASML 拚次世代製程", "summary": "艾司摩爾（ASML）與台積電7日宣布，將共同推動晶片製造轉移升級至12吋光罩，要把最先進的高數值孔徑極紫外光（High NA EUV）微影技術的價值發揮到極致，台積電規劃，2031年之前建立12吋光罩試產線，2033年將微影系統全面就緒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/21/35251911.jpg&M=1&s=Y&x=0&y=26&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 01:24", "link": "/news/story/6811/9742606"}, {"article_id": "9742608", "title": "英特爾、三星也找艾司摩爾 強化High NA EUV應用", "summary": "台積電宣布和艾司摩爾（ASML）共同推動轉移升級至12吋光罩，加強利用高數值孔徑極紫外光（High NA EUV）微影技術之後，英特爾與三星也跟進宣布與艾司摩爾進行一樣的合作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_4.jpg", "date": "2026-09-09 01:23", "link": "/news/story/6811/9742608"}, {"article_id": "9742618", "title": "星國內閣大加薪 總理年領9000萬", "summary": "新加坡內閣官員待遇已是全球最高，星國總理黃循財八日表示，新加坡部長級薪資擬自下月十五日起調漲，總理年薪可望從二二○萬增至三六○萬新元（約台幣九千萬元），漲幅達百分之六十四。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_0.jpg", "date": "2026-09-09 01:19", "link": "/news/story/6809/9742618"}, {"article_id": "9742614", "title": "防台灣有事 日擴大跨國防衛網", "summary": "南華早報八日報導，日本防衛規畫日益受到台海可能發生衝突影響，東京正迅速擴大防衛夥伴網，與澳洲、菲律賓、印度等印太國家深化作戰、後勤、訓練及軍事准入合作，也加強與北美、歐洲在武器研發、生產、情報、科技及供應鏈等領域的連結，希望提升台海若爆發長期衝突時的承受能力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309215.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-09 01:18", "link": "/news/story/6809/9742614"}, {"article_id": "9742617", "title": "蘋果折疊iPhone恐缺貨 開賣初期可能跟不上需求", "summary": "蘋果將於台灣時間10日凌晨舉辦秋季新品發表會，首款折疊iPhone預料將是一大亮點，惟日媒報導，蘋果對折疊iPhone品質要求極為嚴格，導致該新機截至8月底日產量僅數百支，開賣初期恐鬧缺貨，並牽動台積電、大立光、鴻海、新日興等供應鏈出貨。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35306512.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 00:49", "link": "/news/story/6811/9742617"}, {"article_id": "9742622", "title": "蘋果簽NAND長約…價格不是問題", "summary": "記憶體缺貨大漲價狂潮延續，連向來以強大議價能力聞名的蘋果都難以抵抗。南韓媒體Economy Tribune報導，蘋果為取得充裕的儲存型快閃記憶體（NAND Flash），近期已與供應商簽訂長期供應協議（LTA），並且未設定價格上限。這隱約透露蘋果內部傾向「價格不是問題，有充裕記憶體供應最重要」的策略，更凸顯當下記憶體一貨難求。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_5.jpg", "date": "2026-09-09 00:47", "link": "/news/story/6811/9742622"}, {"article_id": "9742620", "title": "歐洲電信業抗星鏈 捍衛「通訊主權」", "summary": "歐洲電信四巨頭德國電信（Deutsche Telekom）、Orange、Vodafone和西班牙電信（Telefonica）將攜手攻衛星服務，與全球首富馬斯克旗下SpaceX搶生意，引爆全球新一波衛星相關訂單出籠，昇達科、萊德光電、華通等台廠迎來大單。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309216.jpg&M=1&s=Y&x=0&y=0&sw=1023&sh=682&exp=3600&sl=W&fw=360", "date": "2026-09-09 00:45", "link": "/news/story/6811/9742620"}, {"article_id": "9742621", "title": "日圓碰觸153 寫七個月高點", "summary": "日圓匯價8日一度升破1美元兌153日圓，再度改寫今年2月來新高。最新公布的數據顯示，日本7月名目薪資意外年增4.7%，創1997年來最大增幅，加上第2季經濟成長率獲上修0.3個百分點至1.4%，都進一步強化日本銀行（央行）下周升息的理由，但民間消費仍低迷，且日圓急升對汽車等出口產業勢將帶來衝擊，日圓後市以及日銀後續升息速度，都有待觀察。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35306208.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-09 00:10", "link": "/news/story/6811/9742621"}, {"article_id": "9742679", "title": "首度熱線 習通話英相維護多邊主義", "summary": "大陸國家主席習近平昨日應約與英國首相柏能通電話。習近平在通話中表示，中英共同利益大於分歧，雙方應當超越分歧、求同存異，做大互利合作的蛋糕，並指雙方都支持多邊主義及開放貿易。據陸方發布，柏能稱英方願保持對中政策連續性，發展長期穩定戰略夥伴關係，並指「英方在台灣問題上的立場沒有改變」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309262.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 00:00", "link": "/news/story/6809/9742679"}, {"article_id": "9742571", "title": "歐盟力挺丹麥 投資格陵蘭73億", "summary": "歐盟七日與格陵蘭簽署聯合聲明，並發布「歐盟格陵蘭夥伴關係方案」，將投資二億歐元（約台幣七十三點三億元），聚焦通訊連結、潔淨能源及關鍵原物料。美國總統川普多次表達希望取得格陵蘭而受國際關注，歐盟藉此重申對格陵蘭及丹麥的支持。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_5.jpg", "date": "2026-09-09 00:00", "link": "/news/story/6809/9742571"}, {"article_id": "9742570", "title": "川普曬美地圖畫入32國家地區 冰島召見美大使抗議", "summary": "國會山報七日報導，美國總統川普七日在社群平台分享一張ＡＩ生成地圖，將美國國旗直接覆蓋加拿大、墨西哥、格陵蘭、冰島等地，把北美洲和中美洲共卅二個國家地區畫入美國版圖，標註為「美利堅合眾國」。這些國家當中冰島動作最大，已召見美國大使抗議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309185.jpg&M=1&s=Y&x=0&y=0&sw=660&sh=440&exp=3600&sl=W&fw=360", "date": "2026-09-09 00:00", "link": "/news/story/6809/9742570"}, {"article_id": "9742569", "title": "民意支持抗川普貿易政策 卡尼成要角", "summary": "美國總統川普的貿易戰加上一再宣稱要將加拿大納為美國一州，引發加拿大民眾反彈，讓加國總理卡尼得以憑藉民意支持對抗川普。美聯社指出，卡尼已成為國際反制川普貿易政策的代表人物。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309267.jpg&M=1&s=Y&x=0&y=0&sw=1273&sh=849&exp=3600&sl=W&fw=360", "date": "2026-09-09 00:00", "link": "/news/story/6809/9742569"}, {"article_id": "9742567", "title": "關稅報復 美加貿易戰升溫", "summary": "加拿大強硬反擊美國總統川普的貿易戰，對總額二百億美元的美國商品課徵最高百分之五十報復性關稅八日生效。川普七日則把矛頭指向加國製飛機，宣布總部位於蒙特婁的航太公司龐巴迪必須在美國設廠生產，否則將禁止在美銷售。這些發展顯示，美加貿易戰繼續升級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309183.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 00:00", "link": "/news/story/6809/9742567"}]}, {"name": "西藏尼泊爾洪災", "articles": [{"article_id": "9742575", "title": "尼泊爾西藏洪災奪1400命 救難人員聚焦搜救3處隧道受困者", "date": "2026-09-08 22:56", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309188.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124995/9742575"}, {"article_id": "9741040", "title": "2工人困尼泊爾隧道奇蹟獲救過程曝光！喝髒泥水撐9天 躲1處逃死劫", "date": "2026-09-08 11:31", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35307007.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/124995/9741040"}]}, {"name": "中東戰火連綿", "articles": [{"article_id": "9742407", "title": "哈瑪斯2023年襲以色列致千死 內唐亞胡挨批漠視警告", "date": "2026-09-08 20:43", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309001.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124061/9742407"}, {"article_id": "9741651", "title": "國防轉捩點？伊朗改良射程1200公里彈道飛彈 採取新戰略「先發制人」", "date": "2026-09-08 15:12", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35308028.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh