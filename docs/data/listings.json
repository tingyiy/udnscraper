7241"}, {"article_id": "9667534", "title": "桃園盃三對三籃球賽AI灌水風波延燒 議員質疑審查失靈市府展開調查", "summary": "桃園市體育局主辦的「2026第10屆桃園盃全國三對三籃球賽」爆出承辦廠商以AI生成「幽靈球隊」灌水報名，引發外界譁然。民進黨桃園市議員余信憲、黃瓊慧今質疑，涉案廠商過去已有重大履約爭議，為何仍能通過市府審查承辦標案，要求釐清責任。市府回應，已將全案送政風調查，並依法移送法辦、追究損害賠償，同時提報為不良廠商。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194961.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 13:24", "link": "/news/story/7003/9667534"}, {"article_id": "9667484", "title": "MLB／史庫柏報到第1天目睹尷尬場面 道奇本季第2次系列賽遭橫掃", "summary": "老虎隊昨天把王牌投手史庫柏（Tarik Skubal）交易到道奇隊，這位兩屆塞揚獎強投今天在道奇球場正式報到，和新隊友一一打招呼，卻也目睹道奇本季第2次系列賽遭橫掃，他穿上新的29號球衣，後天將在芝加哥登板先發對決小熊隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194872.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 13:10", "link": "/news/story/6999/9667484"}, {"article_id": "9667412", "title": "捷運盃街舞大賽初賽落幕 六國際隊伍、八國評審8月齊聚台北", "summary": "邁入第21屆的「捷運盃街舞大賽」首度全面升級為國際賽，以「用夢想展現力量 讓世界看見台北（Empowered by Dreams Spotlight on Taipei）」為主題，經過兩天激烈比拚，各組晉級選手正式出爐，將於22日站上中山堂總決賽舞台，8月23日則將舉辦「國際霹靂舞邀請賽」，共6國際隊伍將來台較勁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194758.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 12:39", "link": "/news/story/7005/9667412"}, {"article_id": "9667375", "title": "TPBL／領航猿選到「空氣」 吳志鍇加盟戰神", "summary": "PLG選秀會和TPBL選秀會都受到青睞的UBA冠軍隊政治大學前鋒吳志鍇，確定投入TPBL，台北台新戰神隊今天宣布選秀「榜眼」吳志鍇正式加盟，新秀賽季將披上13號戰袍，也代表PLG衛冕軍桃園璞園領航猿隊選到「空氣」，今年選秀會空手而歸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194706.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 12:21", "link": "/news/story/7003/9667375"}, {"article_id": "9667290", "title": "國際少年運動會會員大會在台舉行 地主兩代表成功連任", "summary": "2026年國際少年運動會（International Children's Games，簡稱ICG）昨天在花蓮召開委員會議與會員大會。適逢四年一度的組織核心幹部換屆改選，全球運動外交目光齊聚台灣，最終運動部國際事務司副司長許秀玲和台北市執行委員張芬芬成功連任。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194570.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-03 12:00", "link": "/news/story/7005/9667290"}, {"article_id": "9667234", "title": "新竹帆船推廣大突破！年度「運動i台灣」系列活動體驗人數首度破千人", "summary": "由新竹市政府主辦、指導單位運動部全民運動署支持的「115年運動i台灣2.0計畫─竹市i運動」系列活動正熱烈展開，承辦單位新竹市體育會帆船委員會說，今年特別推出「與風共舞─新竹帆船體驗營」，在南寮舊漁港掀起水上運動狂潮，累計參與及體驗人數首度飆破1000 人，創下歷年新高紀錄，成功讓竹市成為北台灣最重要的全民海洋運動推廣基地。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194495.jpg&M=1&s=Y&x=0&y=0&sw=1023&sh=682&exp=3600&sl=W&fw=360", "date": "2026-08-03 11:37", "link": "/news/story/7005/9667234"}, {"article_id": "9667222", "title": "中職／UniGirls主題日下周台南登場 HUR+展現獨特舞台魅力", "summary": "統一獅隊UniGirls年度盛事「第一次心動」主題日，將於8月15、16日在亞太成棒主球場登場，推出成軍第5首全新單曲「第一次心動」，以韓系甜美風格為主軸，打造專屬女孩們的青春戀愛篇章，展現最青春、最有活力的樣貌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194466.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-03 11:33", "link": "/news/story/7001/9667222"}, {"article_id": "9667206", "title": "國際少年運動會花蓮登場 警動員國安級維安護賽事", "summary": "第58屆國際少年運動會（ICG）昨晚在花蓮縣立體育館開幕，來自26個國家、68座城市的近1300名選手及代表團成員齊聚花蓮，為歷年來花蓮規模最大的國際體育賽事。運動部長李洋親臨會場勉勵青年選手，花蓮縣警察局則比照國際大型賽會規格，結合中央單位投入維安工作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194450.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 11:29", "link": "/news/story/7005/9667206"}, {"article_id": "9667180", "title": "足球／2026安聯小小世界盃總決賽 U15新北蘆洲笑擁冰淇淋金盃", "summary": "2026世界盃冠軍戰剛落幕，台灣安聯小小世界盃總決賽延續熱潮，於8月1日、2日在台北田徑場盛大開踢。長期推廣台灣基層足球的安聯人壽舉辦本次「2026安聯小小世界盃總決賽」，再現世界盃的熱情和精神。小將們歷經7區激烈的預賽，最終共有70隊前進總決賽一戰高下，各組別冠軍隊伍將獲得安聯小小世界盃經典特製的冰淇淋金盃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194402.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 11:22", "link": "/news/story/7005/9667180"}, {"article_id": "9667141", "title": "MLB／道奇本季確定遭紅襪清盤 拉菲拉、吉田正尚開轟定江山", "summary": "紅襪隊氣勢驚人，道奇隊在主場怎麼擋都擋不住，先發投手西恩（Emmet Sheehan）今天只投2.2局失5分退場，讓道奇陷入苦戰，終場以4：8落敗，3連戰遭清盤。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194340.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-03 11:10", "link": "/news/story/6999/9667141"}, {"article_id": "9667064", "title": "中職／兄弟攜手鬼滅之刃前進大巨蛋 公布聯名主題周售票資訊", "summary": "中信兄弟隊下半季將在台北大巨蛋帶來一系列精采多元的主題活動，球團今天正式公布平日主場賽事聯名活動，以及備受期待的《中信兄弟X鬼滅之刃─決戰無限城》聯名主題周售票資訊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194283.jpg&M=1&s=Y&x=34&y=0&sw=1220&sh=813&exp=3600&sl=W&fw=360", "date": "2026-08-03 10:42", "link": "/news/story/7001/9667064"}, {"article_id": "9667057", "title": "桌球／找到了！「學姊」鄭怡靜尋回行李 感謝網友幫忙", "summary": "東京奧運奪下混雙銅牌的我國桌球「一姊」鄭怡靜，昨天飛往日本準備參加4日登場的WTT橫濱冠軍賽，不料卻發生行李遺失意外，所幸今天早上終於找到拿錯行李的旅客，結束一場虛驚，教練也特別發文網友們的熱心幫忙。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194205.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 10:38", "link": "/news/story/7005/9667057"}, {"article_id": "9666763", "title": "籃球／台中東興國小女籃芬蘭國際賽奪冠 5戰壓倒性全勝", "summary": "從全國冠軍打到國際冠軍，台中市東興國小女子籃球隊今天在芬蘭舉行的第39屆Delfin Basket國際籃球錦標賽，以55...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194066.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-03 10:07", "link": "/news/story/7003/9666763"}, {"article_id": "9666870", "title": "紐西蘭超馬女將29天縱貫阿爾卑斯 刷新歷史紀錄", "summary": "紐西蘭女子超馬名將伍茲（Sophie Woods），昨天晚間抵達阿爾卑斯1號線路（Via Alpina）終點摩納哥。她以...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194062.jpg&M=1&s=Y&x=21&y=0&sw=1207&sh=804&exp=3600&sl=W&fw=360", "date": "2026-08-03 10:02", "link": "/news/story/7005/9666870"}, {"article_id": "9666945", "title": "MLB／洋基4換1補進國民重砲 賈西亞形容心情悲喜交加", "summary": "大聯盟交易大限將在明天到期，洋基隊挖角國民隊重砲賈西亞（Luis Garcia Jr.），送出4名右投做為交易條件，官網指出洋基增添一名急需的左打，提升進攻火力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194038.jpg&M=1&s=Y&x=92&y=0&sw=1019&sh=680&exp=3600&sl=W&fw=360", "date": "2026-08-03 09:50", "link": "/news/story/6999/9666945"}, {"article_id": "9666932", "title": "TPBL／蕭順議憶重傷「眼縫20多針」 離新竹前感謝中醫大院長救命之恩", "summary": "新北國王隊官宣攻城獅前隊長蕭順議加入，蕭順議離開新竹前，特地返回中國醫藥大學新竹附設醫院致謝，並將去年球季主戰球衣贈送院長陳自諒。蕭順議感念4年前眼部重傷時，陳自諒親自縫合20多針，直呼對方是自己的「救命恩人」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35194007.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 09:44", "link": "/news/story/7003/9666932"}, {"article_id": "9666911", "title": "MLB／李灝宇貢獻1安1打點 老虎離外卡只有2.5場勝差", "summary": "旅美好手李灝宇今天重返先發，對運動家隊之戰5次打數揮出1支安打、攻下1分打點，老虎終場以11：0大勝，不但完成客場3連戰橫掃，而且整季對戰運動家6戰全勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35193989.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-03 09:35", "link": "/news/story/6999/9666911"}, {"article_id": "9666806", "title": "高球／英國公開賽拉尾盤 徐薇淩並列第6平個人最佳", "summary": "台灣旅美高球女將徐薇淩，今天在LPGA英國公開賽最終輪抓下4博蒂，可惜第18洞吞下雙柏忌，但單輪69（-2）桿成績仍讓她從三輪打完的並列16名躍居10名，最終以283（-1）桿的並列第6名結束賽事，追平去年在英國公開賽締造的個人最佳成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35193996.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-03 08:37", "link": "/news/story/7005/9666806"}]}, {"name": "棒球", "articles": [{"article_id": "9666327", "title": "日職／張峻瑋優質先發飆速156公里 奪二軍本季第5勝", "date": "2026-08-02 20:58", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193240.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9666327"}, {"article_id": "9666280", "title": "中職／洋投羅戈對戰龍數據出色 稱曲球是生涯重要球種", "date": "2026-08-02 19:50", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=h