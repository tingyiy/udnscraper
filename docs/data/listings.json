: "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/19/35149792.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9637237"}]}, {"name": "最新文章", "articles": [{"article_id": "9640614", "title": "世足賽／衛冕失利先沈澱 梅西不踢美足聯明星賽了", "summary": "阿根廷沒能終結1962年迄今的世界盃「冠軍魔咒」，連霸的最後一哩路敗在西班牙手中，完全燃燒的當家球星「獅王」梅西（Lionel Messi）和隊友德保羅（Rodrigo De Paul）將稍作休息再重返邁阿密國際隊（Miami CF），預計美國職業足球大聯盟（MLS）的下兩場比賽都將缺席，也不會參加明星賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154664.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:52", "link": "/news/story/123107/9640614"}, {"article_id": "9640603", "title": "MLB／鄭宗哲再見接殺拯救查普曼 紅襪4度平手後獵鶯推進14連勝", "summary": "歷經4度平手，紅襪隊的連勝之旅還沒打算畫下句點，今天以6：5臉勝金鶯隊，推進14連勝，只差1場追平隊史紀錄。台灣好手鄭宗哲先發出賽，3打數沒有安打、吞下2K，在第七局為紅襪跑回追平分，第九局更上演關鍵的再見接殺，擋住金鶯反撲氣焰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154650.jpg&M=1&s=Y&x=379&y=298&sw=806&sh=538&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:50", "link": "/news/story/6999/9640603"}, {"article_id": "9640575", "title": "世足賽／新科冠軍隊馬德里辦遊行 兩百萬球迷同慶", "summary": "西班牙隊帶著隊史第2座世界盃金盃凱旋，今天26名球員先與皇室成員和首相桑切斯（Pedro Sánchez）會面，再搭上露天巴士，在馬德里市中心舉辦冠軍遊行，和參與遊行的200萬名球迷共享冠軍榮耀", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154623.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:36", "link": "/news/story/123107/9640575"}, {"article_id": "9640534", "title": "世足賽／「傷口需要時間癒合」梅西心碎發文致謝阿根廷球迷 也向西班牙送上祝福", "summary": "阿根廷在2026年世界盃決賽以0比1不敵西班牙，衛冕夢碎。梅西賽後發文感謝球迷，坦言失利帶來巨大傷痛，但也希望大家記住團隊的努力，並祝賀西班牙奪冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154552.jpg&M=1&s=Y&x=0&y=40&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:28", "link": "/news/story/123107/9640534"}, {"article_id": "9640552", "title": "MLB／美媒認同李灝宇續留大聯盟調度 「找不到下放理由」", "summary": "老虎隊主戰二壘手托瑞斯（Gleyber Torres）傷癒回歸，牽動台灣好手李灝宇的出賽機會，他在這波異動中續留大聯盟，美國媒體也討論到此事，直言以老虎目前狀況，並沒有下放李灝宇的理由。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154584.jpg&M=1&s=Y&x=228&y=0&sw=1052&sh=701&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:25", "link": "/news/story/6999/9640552"}, {"article_id": "9640532", "title": "迎選手生涯20周年 陳彥博出發吉爾吉斯200公里高山超馬賽事", "summary": "極地超馬運動員陳彥博於今天正式啟程，代表台灣飛往中亞吉爾吉斯，準備參加7月27日至31日、為期5天「吉爾吉斯200公里高山超馬分站賽」，面對這場平均海拔3000公尺以上、最高達3907公尺的賽道考驗，陳彥博在出發前夕透露，過去三個月為了適應高海拔速度戰，他決心將體重從69.3公斤一路降至63.5公斤，展現邁入選手生涯第20年依然無比自律的意志。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154545.jpg&M=1&s=Y&x=0&y=247&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:13", "link": "/news/story/7005/9640532"}, {"article_id": "9640487", "title": "NBA／湖人要的防守大鎖來了！3D側翼塞布爾1年合約加盟", "summary": "湖人與防守悍將賽布爾達成1年330萬美元合約，填補史馬特離隊後的防守缺口。賽布爾曾兩度入選NBA年度防守第二隊，並在拓荒者提升外線手感，有潛力成為唐西奇的重要3D拼圖。湖人需調整陣容以符合人數限制。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154494.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 09:08", "link": "/news/story/7002/9640487"}, {"article_id": "9640491", "title": "世足賽／冠軍戰後爆衝突FIFA啟動調查 阿根廷、西班牙恐面臨嚴懲", "summary": "2026世足賽落幕，但冠軍戰後掀起的「場外風暴」才正要開始，針對西班牙以1：0絕殺阿根廷奪冠後發生的肢體衝突事件，國際足總（FIFA）今天發表聲明，確定正式啟動紀律調查程序，並指定專責檢察官對兩隊球員與教練團隊的涉案行為進行全面釐清。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154514.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 08:57", "link": "/news/story/123107/9640491"}, {"article_id": "9640490", "title": "MLB／主戰二壘手歸隊下放3選1不是李灝宇 老虎教頭曝有新任務", "summary": "老虎隊二壘手托瑞斯（Gleyber Torres）左腹斜肌傷癒歸隊，李灝宇在3位考慮下放3A的人選中，最終獲得留在大聯盟，總教練辛區（AJ Hinch）談到李灝宇接下來的出賽定位，會更常在二壘、三壘之間遊走，也先預告明天李灝宇將以三壘手出賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154495.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-21 08:57", "link": "/news/story/6999/9640490"}, {"article_id": "9640253", "title": "日職／不像火腿留得住大谷翔平 軟銀又一個第一指名消失", "summary": "軟銀的第一指名佐佐木麟太郎選擇留在美國，無緣回國加盟，這標誌著軟銀近年來面臨的第一指名魔咒持續延續。佐佐木的決定讓軟銀在爭取他的過程中所做的努力付諸東流，成為日職選秀的又一典型案例。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154117.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 07:00", "link": "/news/story/122629/9640253"}, {"article_id": "9640269", "title": "鄭宗哲能在紅襪站穩嗎？三成打擊率背後真正的考驗才剛開始", "summary": "鄭宗哲在大聯盟的首季表現引人關注，他以.303的打擊率和不錯的選球能力，證明了自己的競爭力。儘管面對三振問題和高BABIP，但他的速度與防守潛力，使他成為紅襪多功能內野手的候選人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154156.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 07:00", "link": "/news/story/122629/9640269"}, {"article_id": "9640257", "title": "雷霆避稅縮減天賦還是60勝球隊 但奪冠除了帶天命還要靠好運", "summary": "雷霆今夏進行三筆交易，成功減少薪資並創造未來操作空間，保有爭冠實力；然而，NBA奪冠之路愈加困難，需面對更大的運氣變數。即使仍具60勝實力，雷霆能否重奪冠軍仍充滿不確定性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154136.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-21 07:00", "link": "/news/story/122629/9640257"}, {"article_id": "9640323", "title": "西班牙世界盃封王遊行 逾百萬球迷湧馬德里街頭慶祝", "summary": "世界盃冠軍西班牙隊今天在馬德里街頭展開敞篷巴士遊行，逾100萬名球迷湧上街頭慶祝，迎接這支睽違16年重返國際足壇巔峰「無...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154260.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 06:04", "link": "/news/story/123107/9640323"}, {"article_id": "9640129", "title": "世足賽／獎金創紀錄 48支參賽隊伍合計可獲8.7億美元", "summary": "世界盃足球決賽由西班牙隊抱走冠軍，除了可高舉大力神盃、獲頒冠軍戒指，還可獲5,100萬美元獎金；亞軍阿根廷則獲3,400萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35153931.jpg&M=1&s=Y&x=0&y=0&sw=1261&sh=841&exp=3600&sl=W&fw=360", "date": "2026-07-21 02:58", "link": "/news/story/123107/9640129"}, {"article_id": "9640131", "title": "世足賽／預測市場交易量飆升 增速遠超過傳統博弈公司", "summary": "在世界盃足球賽熱潮席捲全球期間，預測市場的交易量大幅飆升，增速遠超傳統運動博弈公司，凸顯出像Kalshi這類業者如今對體育博弈產業構成競爭威脅。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_6.jpg", "date": "2026-07-21 02:56", "link": "/news/story/123107/9640131"}, {"article_id": "9640186", "title": "世足賽／西班牙奪冠大合照 川普疑搶鏡頭不肯離場引熱議", "summary": "西班牙今天在世足決賽奪冠後，陣中球員拍攝大合照，美國總統川普頒獎後疑似不肯離場，而是留在舞台一側參與合照，引發網友熱議", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35154074.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:12", "link": "/news/story/123107/9640186"}, {"article_id": "9640232", "title": "郭智輝 參選中華棒協理事長", "summary": "經濟部前部長、科技企業家郭智輝宣布參選中華民國棒球協會第十四屆理事長，不同於傳統棒球人出身，他帶著十五年投入棒球的經驗，以及科技業最熟悉的數據、運動科學與企業管理思維，希望為台灣棒球補上「另一塊關鍵拼圖」，讓世界冠軍不只是歷史上的驚喜，而是可以不斷複製、持續挑戰的實力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35154079.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:04", "link": "/news/story/7001/9640232"}, {"article_id": "9640155", "title": "煮茶論戰／「平均11秒奪回球權」 西班牙新傳控體系無敵", "summary": "西班牙冠軍戰上演延長賽「絕殺」，以一比○擊敗阿根廷，阿根廷費南德斯領到紅牌是關鍵之一，西班牙再憑藉體能和體系的穩定性奪下隊史第二冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154682.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:00", "link": "/news/story/122629/9640155"}, {"article_id": "9640152", "title": "世足賽／西班牙隊長「低調強」 抱走金球獎", "summary": "相隔十六年，西班牙奪下隊史第二座世界盃冠軍，隊長羅德里更獲得賽會最佳球員的金球獎肯定，讓這位沒有刺青、生活低調的西班牙球星成為史上第七位握有世界盃、歐洲國家盃、歐洲冠軍聯賽金盃及金球獎的「大滿貫」選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35153973.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:00", "link": "/news/story/123107/9640152"}, {"article_id": "9640170", "title": "世足賽／巴瑞德斯賽後揮拳 阿根廷背「髒」名", "summary": "比賽結束哨聲響起，另一場戰鬥才正要開始。世界盃足球賽冠軍賽後爆發全武行，阿根廷巴瑞德斯朝西班牙選手鎖喉、揮拳，當場領到紅牌，更遭批「輸不起」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35154029.jpg&M=1&s=Y&x=0&y=0&sw=1217&sh=811&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:00", "link": "/news/story/123107/9640170"}, {"article_id": "9640173", "title": "世足賽／川普硬蹭西班牙捧盃照 現場噓不停", "summary": "衛報報導，美國總統川普十九日現身世足決賽頒獎時，現場噓聲四起，他頒獎後不肯下台，擠進西班牙隊捧盃畫面，場面一度尷尬。儘管世足落幕，川普將賽事政治化的爭議仍延燒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35154060.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:00", "link": "/news/story/123107/9640173"}, {"article_id": "9640200", "title": "世足賽／西班牙奪金盃 阿根廷衛冕夢碎…梅西輸球淚灑球場", "summary": "擴增到四十八隊的美加墨世界盃足球賽台灣時間昨天凌晨落幕。隊史第二度打進世界盃冠軍戰的「無敵艦隊」西班牙，完全封鎖上屆冠軍阿根廷進攻，加上阿根廷費南德斯正規賽補時階段領到紅牌下場，讓西班牙獲得人數優勢，靠著托雷斯延長賽攻破球門，以一比○奪冠，阿根廷衛冕失利，沒能突破一九六二年迄今的「連霸魔咒」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35153992.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:00", "link": "/news/story/123107/9640200"}, {"article_id": "9640155", "title": "煮茶論戰／「平均11秒奪回球權」 西班牙新傳控體系無敵", "summary": "西班牙冠軍戰上演延長賽「絕殺」，以一比○擊敗阿根廷，阿根廷費南德斯領到紅牌是關鍵之一，西班牙再憑藉體能和體系的穩定性奪下隊史第二冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/21/35154682.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-21 00:00", "link": "/news/story/122629/9640155"}, {"article_id": "9640017", "title": "世足賽／西班牙奪冠嗨翻全國 球迷集體狂歡震出地震訊號", "summary": "西班牙於世界盃封王，不僅歡呼聲響徹全國，甚至連地底都感受到這股歡騰氣氛。科學家今天表示，西班牙昨天世足奪冠後，各地地震儀...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/20/35153803.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-20 22:21", "link": "/news/story/123107/9640017"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9640534", "title": "世足賽／「傷口需要時間癒合」梅西心碎發文致謝阿根廷球迷 也向西班牙送上祝福", "date": "2026-07-21 09:28", "thumbnail": "https