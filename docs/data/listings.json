, "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142836.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9632635"}, {"article_id": "9632942", "title": "煮茶論戰／梅西頂級視野超能力 把比賽讀成書", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35143240.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9632942"}, {"article_id": "9629922", "title": "中職／亞運棒球名單惹爭議 張翔、朱迦恩入選成正面力量", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/15/35138904.jpg&M=1&s=Y&x=0&y=39&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9629922"}, {"article_id": "9630390", "title": "煮茶論戰／「無敵艦隊」團隊傳控 給傲慢巨星軍團上一課", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35139569.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9630390"}]}, {"name": "最新文章", "articles": [{"article_id": "9636578", "title": "世足賽／阿根廷大戰西班牙 世足64年衛冕魔咒會打破？", "summary": "四十八隊、總場次一○四場的馬拉松式世界盃足球賽，台灣時間明天凌晨三點大結局。冠軍賽由阿根廷、西班牙上演雙強爭冠，決定大力神盃獎落誰家。仿效超級盃的史上首次中場秀亦是焦點，各界聚焦國際足球總會（ＦＩＦＡ）如何在有限的中場時間完成大秀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148517.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-19 00:03", "link": "/news/story/123107/9636578"}, {"article_id": "9636581", "title": "世足賽／梅西盛讚亞馬爾「但這次他不會如願」", "summary": "二○○七年的一張照片，廿歲的梅西和澡盆裡四個月大的亞馬爾，如今在二○二六年世界盃足球賽冠軍賽碰頭，這段宛如神劇本般的緣分，讓梅西也直言「真的太不可思議」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/19/35148717.jpg&M=1&s=Y&x=0&y=0&sw=1059&sh=706&exp=3600&sl=W&fw=360", "date": "2026-07-19 00:03", "link": "/news/story/123107/9636581"}, {"article_id": "9636586", "title": "煮茶論戰／世足冠軍賽 西班牙被看好 阿根廷有絕境韌性", "summary": "西班牙對上阿根廷的決賽，西班牙的實力應該比阿根廷好，在常規的時間之內，勝率略高於阿根廷，有機會小勝阿根廷；但如果阿根廷把比賽拖到延長賽，他們就好像「九命怪貓」一樣，局勢有機會逆轉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/19/35148720.jpg&M=1&s=Y&x=42&y=0&sw=1238&sh=826&exp=3600&sl=W&fw=360", "date": "2026-07-19 00:02", "link": "/news/story/123107/9636586"}, {"article_id": "9636575", "title": "中職／「最強銀行員」隔7年明星賽登板 吳昇峰：快跟棒球說再見了", "summary": "昔日在國際賽投出亮眼表現的「最強銀行員」、合作金庫投手吳昇峰，暌違7年再次在中職明星賽現身，帶著手肘傷勢走到球員生涯的尾聲，能在台北大巨蛋4萬人面前留下美好回憶，他一方面開心，同時也帶點感傷，「該跟棒球說再見的時刻快到了⋯⋯。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148512.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 23:25", "link": "/news/story/7001/9636575"}, {"article_id": "9636484", "title": "中職／想幫郭天信止敗…陳鏞基明星賽2安2盜「珍惜每一刻」 健康迎接引退賽", "summary": "43歲老將陳鏞基引退年，球員生涯最後一次中職明星賽，今天5局下代打上場，單場2安2盜壘，直言想幫郭天信止敗，但重點還是保...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148404.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 22:39", "link": "/news/story/7001/9636484"}, {"article_id": "9636478", "title": "中職／富邦投捕見林威助上場「不知怎麼對決」 張奕：我怕丟到他", "summary": "中職明星賽今天安排「傳奇明星卡」橋段，多位退役球星驚喜出現在場上，其中富邦悍將副領隊林威助在8局上拿起球棒站上打擊區，對上的正是自家悍將隊的投捕搭檔張奕、戴培峰，兩人尷尬地不知道如何面對才是好。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148395.jpg&M=1&s=Y&x=0&y=58&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-18 22:27", "link": "/news/story/7001/9636478"}, {"article_id": "9636477", "title": "中職／想好兩套劇本都沒上演 官大元明星賽吞敗：張奕為何沒轉回來？", "summary": "中職著名「轉運手」官大元，退役後以傳奇身分參戰今年明星賽，今天直接撼動戰局勝負，中繼1局失5分，賽後透露自己心裡的完美劇本，「其實我期望我轉過去後，張奕可以再轉回來。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148394.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 22:27", "link": "/news/story/7001/9636477"}, {"article_id": "9636458", "title": "中職／「你們怎麼那麼開心？」郭天信明星賽9連敗堅強說沒關係", "summary": "中華職棒明星賽首日，由中華隊以7：4擊敗明星隊，也讓郭天信推進個人明星賽9連敗，打到表情逐漸凝重，賽後被問起9連敗心情，郭天信一眼看穿，「你們怎麼看起來那麼開心啊？」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148372.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 22:13", "link": "/news/story/7001/9636458"}, {"article_id": "9636419", "title": "世足賽／梅西、馬拉度納、比利拚高下 BBC分析誰才是史上最強", "summary": "阿根廷足球巨星梅西即將迎來生涯第3場世界盃決賽，他是否已超越同胞馬拉度納和巴西「球王」比利，成為足球史上最偉大球員？這個...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148348.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 21:34", "link": "/news/story/123107/9636419"}, {"article_id": "9636416", "title": "排球／U18男排亞錦賽中華隊退中國奪季軍 暌違25年登頒獎台", "summary": "在中國舉行的亞洲U18男子排球錦標賽，台灣隊今天季軍戰靠著翁郁盛灌進全場最高28分，終場以3比2逆轉地主中國隊，順利拿到...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148334.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 21:18", "link": "/news/story/7005/9636416"}, {"article_id": "9636429", "title": "中職／8張「傳奇卡」攪翻戰局 郭天信終究要吞明星賽9連敗", "summary": "中華職棒明星賽連3年降臨台北大巨蛋，今年再度玩出新花樣，將隱藏人物正式納入賽制，8張「傳奇卡」讓滿場4萬名球迷嗨翻，許久不見的身影、曾經熟悉的應援口號，勾起球迷滿滿回憶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148345.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 21:17", "link": "/news/story/7001/9636429"}, {"article_id": "9636329", "title": "排球／不當攻擊手！許菀芸扛中華女排自由球員 期待登亞運舞台", "summary": "名古屋亞運台灣女排名單日前出爐，原先擔綱攻擊手的許菀芸預計將扛下自由球員重任，她受訪時提到難免有壓力，不過還是很期待登上...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-07-18 19:31", "link": "/news/story/7005/9636329"}, {"article_id": "9636318", "title": "NBA／愛德華透露總冠軍賽前私下助攻唐斯 提供防守溫班亞瑪「密技」", "summary": "灰狼當家少主愛德華（Anthony Edwards）雖然沒有站上上季的總冠軍賽舞台，但他可能也在尼克擊敗馬刺的過程中，扮演了一個小小卻關鍵的幕後角色。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148202.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 18:47", "link": "/news/story/7002/9636318"}, {"article_id": "9636307", "title": "NBA／前明星控衛遭親姐提告詐欺 曾率勇士上演經典「老八傳奇」", "summary": "綽號「小鋼砲」的前NBA明星控衛戴維斯（Baron Davis）近日捲入家庭房產訴訟，親姐姐麗莎（Lissa Davis）指控他出售一棟近20年前協助她購買的房屋，並已對他提出詐欺、故意造成精神痛苦等訴訟，要求未具體列明金額的賠償。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148197.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 18:34", "link": "/news/story/7002/9636307"}, {"article_id": "9636308", "title": "世足賽／足球迷開喝！梅西打造葡萄酒首度登台 金色三麥限量開賣", "summary": "足球熱潮持續升溫，不少球迷相約餐廳看球、享受應援氛圍。金色三麥今年攜手鑫羿文創，首度引進由阿根廷足球巨星梅西（Lionel Messi）親自參與打造的「Lionel Messi 10 GOAT」系列葡萄酒，即日起至8月14日於全台5家指定門市（台北美麗華店、台北酒窖店、台中勤美店、台中市政店、台中崇德店）限時限量展售，除了提供內用，也推出外帶優惠，讓球迷在觀賽之餘，多了一份兼具收藏與儀式感的微醺體驗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148192.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 18:32", "link": "/news/story/123107/9636308"}, {"article_id": "9636222", "title": "日本羽賽／許尹鏸、林芝昀不敵韓國組合 無緣女雙冠軍戰", "summary": "BWF超級750系列的日本羽球公開賽，台灣女雙組合許尹鏸與林芝昀，今天在4強戰以直落二不敵韓國組合金慧貞、孔熙容，不過仍...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148186.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-18 18:28", "link": "/news/story/7005/9636222"}, {"article_id": "9636300", "title": "中職／卓榮泰、韓國瑜明星賽同框牽手 蔡其昌：支持棒球不分顏色", "summary": "中華職棒明星賽今天在台北大巨蛋登場，也將是蔡其昌在中職會長任內的最後一屆盛會，今天在行政院長卓榮泰、立法院長韓國瑜都到場的情況下，致詞說：「大家坐在一起支持棒球，不分顏色，感覺真好。」兩人隨後牽起手來，博得現場球迷歡呼聲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 18:22", "link": "/news/story/7001/9636300"}, {"article_id": "9636296", "title": "中職／宋柏翰全壘打大賽初體驗就闖決賽 評哥哥宋嘉翔餵球「還行啦」", "summary": "中職明星賽全壘打大賽預賽今天登場，在8名參賽者中最年輕的菜鳥打者、台鋼雄鷹隊20歲新秀宋柏翰首度參賽就5轟挺進決賽，與哥哥宋嘉翔的配合得到好結果，宋柏翰說：「表現有比預期好，應該也比我哥預期的還要好。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148162.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 18:15", "link": "/news/story/7001/9636296"}, {"article_id": "9636251", "title": "世足賽／FIFA主席聯合國會議致詞 讚世界盃成功凝聚全球", "summary": "FIFA主席英凡提諾在聯合國會議中讚揚本屆世界盃成功團結全球，強調足球能促進年輕人心理健康。該賽事為史上最大規模，已進行102場比賽，吸引了全球注意。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148132.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 17:56", "link": "/news/story/123107/9636251"}, {"article_id": "9636192", "title": "中職／明星賽連3屆在大巨蛋 會長蔡其昌透露風險考量", "summary": "中職明星賽連3年在台北大巨蛋舉行，會長蔡其昌坦言考量很多，包括容納人數和氣候狀況，明星賽若受雨勢影響，虧損新台幣千萬起跳...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148118.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-18 17:46", "link": "/news/story/7001/9636192"}, {"article_id": "9636270", "title": "中職／平野送水「雷殘」、地獄版「明天會更好」 3兄弟轟進決賽", "summary": "中華職棒全壘打大賽首日預賽8名砲手較勁，4位晉級複賽名單出爐，上演3兄弟與1雄鷹相爭，王政順選「中信兄弟版」的「明天會更好」來自詹子賢獻策，曾頌恩以12轟居預賽之冠，對於明天目標直言要有信心一點，「都進決賽了，無非就是冠軍而已。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148166.jpg&M=1&s=Y&x=0&y=0&sw=1018&sh=678&exp=3600&sl=W&fw=360", "date": "2026-07-18 17:45", "link": "/news/story/7001/9636270"}, {"article_id": "9636172", "title": "中職／張翔有望打亞運再拚亞冠 高志綱盼國際賽刺激成長", "summary": "中職明星賽Team Taiwan以年底亞冠賽為雛形，2名捕手張翔、宋嘉翔特色都是臂力不錯；總教練高志綱表示，張翔也有入選...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35148111.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 17:40", "link": "/news/story/7001/9636172"}, {"article_id": "9636162", "title": "中職／明星賽曾家輝、高偉強暫不出賽 林詔恩19日先發", "summary": "中職明星賽Team Taiwan以年底亞冠賽為雛形，總教練高志綱表示，投手群中曾家輝、高偉強暫定不會上場，其餘投手應都會...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/ph