"https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316164.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600", "link": "/news/story/124981/9747033"}, {"article_id": "9747094", "title": "亞運棒球／總教練預想最壞場景 點名陳敏賜待命當第3號捕手", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316404.jpg&M=1&s=Y&x=0&y=35&sw=1280&sh=854&exp=3600", "link": "/news/story/124981/9747094"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9747955", "title": "亞運籃球層級已不如10年前！ 中華男籃「保四搶三」拚球運", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317424.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9747955"}, {"article_id": "9746578", "title": "中職／林威助今年操盤成敗最後衝刺 悍將能保住全年第二嗎？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315682.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9746578"}, {"article_id": "9745547", "title": "讓楚奧特喊「我好興奮阿」！ 天使新老闆經營球隊是奪冠專業戶", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35313616.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9745547"}, {"article_id": "9744469", "title": "中職／前4名球隊都有人去打亞運 樂天爭冠少了陳晨威最傷", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312011.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9744469"}, {"article_id": "9742489", "title": "中職／光總快手調度不復見 悍將晉級路岌岌可危", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309129.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9742489"}, {"article_id": "9741923", "title": "國聯塞揚獎還有懸念！37歲「拍賣哥」塞爾球速為何能再進化？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35308375.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9741923"}]}, {"name": "最新文章", "articles": [{"article_id": "9748095", "title": "美網／莎芭蓮卡將讓出球后仍晉女單決賽 差一勝追上小威紀錄", "summary": "雖然下周確定將讓出盤據長達99周的世界球后寶座，但白俄羅斯好手莎芭蓮卡（Aryna Sabalenka）在最熟悉的硬地賽場上依舊銳不可擋，今天她在美網女單準決賽中，莎芭蓮卡展現標誌性的重砲火力，最終以7：5、6：2直落二擊敗在地希望皮古拉（Jessica Pegula），跨季豪取美網19連勝，連續三年挺進決賽，持續朝三連霸目標挺進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317509.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 10:33", "link": "/news/story/121623/9748095"}, {"article_id": "9747955", "title": "亞運籃球層級已不如10年前！ 中華男籃「保四搶三」拚球運", "summary": "中華男籃迎戰2026愛知名古屋亞運，目標「保四搶三」；預賽首戰83：80擊敗約旦，後續將靠防守、籃板與關鍵三分爭取晉級及奪牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317424.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 10:29", "link": "/news/story/122629/9747955"}, {"article_id": "9748033", "title": "MLB／曾評價大谷打擊像高中生 名記評價平良海馬：看起來像消防栓", "summary": "大聯盟賽季還沒結束，ESPN知名記者帕桑（Jeff Passan）就撰文分析今年休賽季自由市場，提到日職球星佐藤輝明、平良海馬和伊藤大海都會挑戰大聯盟，對這3人都給予正面評價。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317409.jpg&M=1&s=Y&x=0&y=38&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-11 10:23", "link": "/news/story/6999/9748033"}, {"article_id": "9748049", "title": "MLB／大谷明明有傷GM卻說外界大驚小怪 美媒質疑溝通出了錯", "summary": "大谷翔平在多重傷勢夾擊之下打打停停，最終還是躲不過進入傷兵名單，引發許多討論，資深記者羅森索（Ken Rosenthal）在「Foul Territory」節目中提出質疑，直指大谷並未充分且準確向球團表達傷勢，而現在面臨的考驗就是與時間賽跑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317445.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 10:19", "link": "/news/story/6999/9748049"}, {"article_id": "9748015", "title": "亞運男籃／陳盈駿指聲明不符事實 籃協：賽程落幕再說明始末", "summary": "名古屋亞運中華男籃昨天在分組賽首戰險勝約旦，不僅拿下首勝，也是今年名古屋亞運我國代表團所有代表隊的首場勝利。不過在贏球的喜悅過程中，卻夾雜中華籃協與球員間針對助理教練與後勤團隊無法入場事件的溝通問題，甚至隊長陳盈駿還在社群上指稱籃協發出不符合事實的聲明，而中華籃協也在今天強調，將先讓球員專注力回到比賽之中，並於賽程落幕後備齊資料說明始末。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317385.jpg&M=1&s=Y&x=0&y=73&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 10:07", "link": "/news/story/124981/9748015"}, {"article_id": "9747883", "title": "MLB／巨人慘到出錢拜託球迷來 祭優惠季票進場回饋15%贏球再加碼", "summary": "巨人隊慘澹賽季，為了在球季尾聲填滿座位出奇招，上周通知季票球迷，出席1場平日賽事就回饋票價15%，巨人贏球加碼5%，回饋金將進入購票帳戶，用於未來折抵購票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317213.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 09:11", "link": "/news/story/6999/9747883"}, {"article_id": "9747793", "title": "NBA／獲CP3許可？比爾重穿快艇3號球衣 隨隊總裁曾承諾不影響退休背號", "summary": "快艇球星比爾（Bradley Beal）在進入新賽季後將重新穿回他標誌性的「3號」戰袍，這號碼過去曾屬於快艇傳奇控衛「CP3」保羅（Chris Paul），隨著保羅今年宣布結束21年職業生涯，比爾也確定重拾這個陪伴他多年的背號。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317064.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 07:46", "link": "/news/story/7002/9747793"}, {"article_id": "9746578", "title": "中職／林威助今年操盤成敗最後衝刺 悍將能保住全年第二嗎？", "summary": "中職下半季剩約20場，樂天、中信、統一、味全爭冠；統一與富邦競逐年度第2，味全力守全年第1，中信則只有奪冠一途。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315682.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-11 07:00", "link": "/news/story/122629/9746578"}, {"article_id": "9747542", "title": "新聞眼／改革體壇 李洋不能只當救火員", "summary": "運動部去年九月九日掛牌上路，並由高人氣的「金牌部長」李洋掌舵，當時各界無不期盼這股新氣象能撕下傳統體育署時代的弊病標籤。但一年飛逝，回頭檢視周年成績單，體育行政與各單項協會卻依然陷在「出包、澄清、再檢討」的惡性循環，讓當初改革熱情漸被現實磨耗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/11/35317220.jpg&M=1&s=Y&x=0&y=109&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-11 00:01", "link": "/news/story/7005/9747542"}, {"article_id": "9747539", "title": "體操選手世錦賽「被棄賽」 家屬告體操協會秘書長背信", "summary": "屏東體操選手潘采宸、李佳蔚取得今年荷蘭世界競技體操錦標賽參賽機會，體操協會在未告知選手及教練下回覆放棄。民進黨立委徐富癸昨偕選手家屬赴屏東地檢署，按鈴告發體協秘書長江建東涉嫌背信罪。潘采宸阿嬤蔡玉華說，她不懂體協長官為何這麼做？她有太多心酸，提告就是嚥不下這口氣，一定幫孫子討公道，「體協敢做就要敢承擔」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316667.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=851&exp=3600&sl=W&fw=360", "date": "2026-09-11 00:00", "link": "/news/story/7005/9747539"}, {"article_id": "9747304", "title": "中職／布雷克主宰戰場讓兄弟掛零 57勝超越王漢獨居獅隊洋投第1", "summary": "統一獅隊作客台中洲際球場，洋投布雷克今天對中信兄弟隊先發7局無失分，優質表現幫助獅隊6：0獲勝，奪下本季第7勝、生涯第57勝，獲選單場MVP，超越傳奇洋投王漢，獨居隊史最多勝外籍投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316499.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 21:28", "link": "/news/story/7001/9747304"}, {"article_id": "9747094", "title": "亞運棒球／總教練預想最壞場景 點名陳敏賜待命當第3號捕手", "summary": "名古屋亞運棒球中華隊陣中僅2名捕手，總教練湯登凱預想最壞場景，若需要第3號捕手上場，隊長陳敏賜是優先選擇，朱迦恩也具蹲捕...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316404.jpg&M=1&s=Y&x=0&y=35&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-10 20:39", "link": "/news/story/124981/9747094"}, {"article_id": "9747190", "title": "排球／登峰造極上海格致中學還在適應 中山工商直落三贏得首勝", "summary": "2026登峰造極青年排球邀請賽今天賽程，高中女子組的中山工商和上海格致中學昨天休兵，今天都是首戰。兩岸勁旅交鋒，中山工商最終以25：22、25：14、25：21拿下首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316361.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 20:19", "link": "/news/story/7005/9747190"}, {"article_id": "9747033", "title": "亞運棒球／打國際賽是榮譽 陳晨威：彌補學生時期沒打過", "summary": "2026年愛知‧名古屋亞運會開幕倒數，我國棒球隊目前仍在國訓中心進行最後備戰，5名中職球員今天正式報到展開集訓，其中樂天桃猿隊陳晨威今年繼經典賽後再次為國效力，他說：「打國家隊就是一個榮譽，算是彌補我學生時期沒打過國家隊。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316164.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 18:47", "link": "/news/story/124981/9747033"}, {"article_id": "9747020", "title": "台新新光Fun Run台北站歡樂開跑 邀民眾暢遊動物樂園", "summary": "「2026台新新光全國Fun Run」首場台北站日前熱鬧開跑，近千位保戶與民眾齊聚動物園，一起走出戶外、跑出健康。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316139.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 18:40", "link": "/news/story/7005/9747020"}, {"article_id": "9746970", "title": "棒球／日本九州亞洲聯盟選拔隊來訪 對台3場交流賽誓言3連勝", "summary": "2026台日棒球國際交流賽明起在台南市亞太棒球場副球場開打，日本九州亞洲聯盟選拔隊集結5支球隊精英，將和全越運動、南市成棒、台電隊交手，今天在賽前訂下3連勝目標，球隊代表也向台灣致謝：「感謝台灣人在熊本大地震後第一時間的援助！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316074.jpg&M=1&s=Y&x=0&y=0&sw=1275&sh=850&exp=3600&sl=W&fw=360", "date": "2026-09-10 18:19", "link": "/news/story/7001/9746970"}, {"article_id": "9746900", "title": "亞運棒球／黃韋盛國家隊初體驗 平野惠一特別提點：想像我隨時在身邊", "summary": "中信兄弟內野手黃韋盛獲徵召參與今年愛知・名古屋亞運，也是他生涯首次披上國家隊戰袍，與大學時的教頭湯登凱再續前緣。向中華隊報到之前，母隊中信兄弟總教練平野惠一特別向他提點一番，並告訴他「要想像我隨時都在身邊」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315960.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:46", "link": "/news/story/124981/9746900"}, {"article_id": "9746830", "title": "美網／打到半夜顧人願 小蠻牛團隊批評：一點也不健康", "summary": "挑戰美網連霸的西班牙「小蠻牛」阿爾卡拉斯（Carlos Alcaraz）昨天男單八強賽但地主謝爾頓（Ben Shelton）激戰五盤，謝爾頓最後發出「再見愛司」淘汰衛冕軍時，當地時間已經是凌晨3點33分，寫下賽史最晚結束紀錄。儘管現場仍有許多觀眾為兩位選手歡呼，但今年頻繁出現的跨日大戰也飽受詬病，阿爾卡拉斯團隊更直批如此狀況「不健康」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315884.jpg&M=1&s=Y&x=0&y=38&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:27", "link": "/news/story/121623/9746830"}, {"article_id": "9746806", "title": "亞運棒球／劉基鴻扛國家隊4棒 最想對決和遇到的都是「古林的朋友」", "summary": "中華隊在今年愛知名古屋亞運爭取暌違20年的亞運棒球金牌，5名中職球員今天正式報到，其中味全龍隊三壘手劉基鴻也被教練團點名，將扛起中華隊的第4棒，對此他笑說：「不陌生，但是滿困難的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315808.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:13", "link": "/news/story/124981/9746806"}, {"article_id": "9746780", "title": "NBA／上季膝傷只打2場就報銷 勇士簽回22歲澳洲前鋒圖希", "summary": "據勇士隨隊記者史雷特（Anthony Slater）報導，勇士將和22歲澳洲前鋒圖希（Alex Toohey）簽下Exhibit 10合約，將在季前訓練營爭取正式合約名額。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315762.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:03", "link": "/news/story/7002/9746780"}, {"article_id": "9746740", "title": "金門馬拉松休閒組來了！9/16五鄉鎮同步報名 限額400名額滿為止", "summary": "眾所矚目的「2027第20屆金門馬拉松」將於明年1月16日登場，為方便服務不熟悉網路報名的鄉親、長輩參加，金門縣政府協調五鄉鎮公所設置現場報名服務台，9月16日上午10時至下午4時同步受理休閒組報名，中午不休息，限額400名，額滿即止。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315721.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 16:50", "link": "/news/story/7005/9746740"}, {"article_id": "9746679", "title": "亞運棒球／遭釋出曾閃過最壞念頭... 劉致榮想證明能健康回到投手丘", "summary": "27歲旅外投手劉致榮因傷兩年沒有登板，今年6月遭紅襪隊釋出，告別6年半的旅美生涯，返台後加入亞運中華隊集訓，並靠好表現遞補進入正選名單。連續兩屆亞運參賽，比起想證明自己的能力，他說：「只想證明我是可以健康地回到投手丘上。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315853.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 16:27", "link": "/news/story/124981/9746679"}, {"article_id": "9746630", "title": "TPBL／許時清加入戰神 和南山幫學生再合體", "summary": "昨天才和新北中信特攻隊正式「分手」的教練許時清，今天新東家就出爐，台北台新戰神隊宣布許時清加入教練團，擔任球隊的助理教練。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315527.jpg&M=1&s=Y&x=1&y=78&sw=1143&sh=762&exp=3600&sl=W&fw=360", "date": "2026-09-10 16:09", "link": "/news/story/7003/9746630"}, {"article_id": "9746600", "title": "MLB／洋基沃爾普「變成邦茲」重返大聯盟 隆巴德：我不尷尬", "summary": "洋基隊當家二壘手奇森姆（Jazz Chisholm Jr.）因右手拇指扭傷，進10天傷兵名單，因此決定將從3A拉上「變成邦茲」的沃爾普（Anthony Volpe）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315480.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date":