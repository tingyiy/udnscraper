, "articles": [{"article_id": "9717764", "title": "MLB／手指起水泡將缺陣至少兩周 朗希直言「完全沒有徵兆」！", "summary": "道奇日本右投「令和怪物」佐佐木朗希今天在對上勇士的比賽中，僅投3.1局就因手指起水泡緊急退場，最終球隊也以5：6敗給勇士。賽後總教練羅伯茲（Dave Roberts）表示，由於傷勢嚴重，將把朗希放至傷兵名單，並由左投勞爾（Eric Lauer）接替先發輪值空缺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269870.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 14:40", "link": "/news/story/6999/9717764"}, {"article_id": "9717757", "title": "「揮汗有禮」全民動起來 完成任務換豆漿、雞胸肉等健康好禮", "summary": "為鼓勵全民養成規律運動習慣，落實「讓運動成為日常」的健康生活理念，響應「99 國民體育日」活動，運動部將於9月1日至11月30日推出「揮汗有禮」活動，凡民國98年12月31日（含）以前出生之國民，只要完成指定運動任務並上傳紀錄，經審核通過後，即可前往超商、超市、量販店等合作通路兌換健康好禮，讓運動不只累積健康，也能周周享有實質回饋。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269841.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-27 14:37", "link": "/news/story/7005/9717757"}, {"article_id": "9717687", "title": "NBA／恨鐵不成鋼！ 「零號探員」酸庫明加簽的是「好市多會員合約」", "summary": "上季從勇士轉戰老鷹的庫明加（Jonathan Kuminga），休賽季投入自由市場卻遲遲沒結果，直到今天終於宣布以2年1240萬美元（約台幣3.93億）加盟灰狼。長期力挺庫明加的前傳奇球星「零號探員」亞瑞納斯（Gilbert Arenas）氣瘋了，拍影片表達恨鐵不成鋼的心情，挖苦「苦命」等待許久竟選擇了這種廉價的「好市多會員合約」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269717.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 14:11", "link": "/news/story/7002/9717687"}, {"article_id": "9717450", "title": "NFL／冠軍線衛對抗漸凍人症18年後逝世 巴爾的摩烏鴉悼念傳奇", "summary": "前NFL超級盃冠軍線衛O.J.布里甘斯與漸凍人症抗爭近18年後逝世，享年56歲；烏鴉隊悼念其為球團傳奇英雄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269341.jpg&M=1&s=Y&x=0&y=0&sw=1272&sh=848&exp=3600&sl=W&fw=360", "date": "2026-08-27 13:00", "link": "/news/story/7005/9717450"}, {"article_id": "9717496", "title": "籃球／曾帶出「三民五虎」震驚HBL 名帥「姥姥」劉錦池享壽85歲", "summary": "曾一手帶出「三民五虎」震驚HBL的基層名帥「姥姥」劉錦池，於8月24日離世，享壽85歲。這位被譽為「南台灣籃運推手」的傳奇教練在籃壇耕耘40餘年，將職業生涯奉獻給港都高雄，幫助七賢國中男女籃以及三民家商奪得國高中合計12座冠軍，更在2023年獲頒教育部體育署體育運動精英獎的「終身成就獎」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269297.jpg&M=1&s=Y&x=0&y=57&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 12:48", "link": "/news/story/7003/9717496"}, {"article_id": "9717280", "title": "美網／葛藍喬安娜拍落澳洲華裔好手 拚生涯首次會內賽差1勝", "summary": "台英混血網球女將葛藍喬安娜，今天在美國公開賽單打資格賽次輪以6比3、6比4擊敗澳洲華裔好手韓天遇，距離生涯首次美網會內賽...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269193.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 12:23", "link": "/news/story/121623/9717280"}, {"article_id": "9717346", "title": "MLB／洋基台灣日太空人巧遇鄧愷威中繼 國旗Taiwan躍大螢幕", "summary": "紐約洋基台灣日今晚在洋基球場登場，由洋基迎戰休士頓太空人，千名台灣球迷共同參與，「台灣尚勇」口號與滿場台灣意象再次躍上美...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269185.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-27 12:22", "link": "/news/story/7001/9717346"}, {"article_id": "9717343", "title": "MLB／鄧愷威5球解決洋基工具人 但太空人牛棚失火掉6分遭痛宰", "summary": "太空人今天在客場挑戰洋基，台灣好手鄧愷威今天又有上場機會，用5球解決打者，完成0.1局無失分任務。可惜牛棚在7、8局放火狂失6分，最終以3比9遭條紋軍痛宰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269048.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 12:20", "link": "/news/story/6999/9717343"}, {"article_id": "9717298", "title": "MLB／李灝宇重返大聯盟後太火熱 大聯盟製作專題邀球評分析", "summary": "效力美國職棒大聯盟（MLB）老虎隊的李灝宇今天雖然3打數無安打，但有2次強擊球，剛好符合球評史蓋斯對他近期強擊球率高於平...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269100.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-27 12:04", "link": "/news/story/6999/9717298"}, {"article_id": "9717377", "title": "TPBL／冠軍側翼火力不熄 馬建豪續披夢想家綠色戰袍", "summary": "福爾摩沙夢想家今天正式宣布，與馬建豪完成續約，迎接2026-27新賽季。馬建豪自2024-25賽季返台加盟夢想家，從懷抱冠軍夢回到家鄉台中，到上季與團隊一同捧起隊史首座冠軍獎盃，如今再度披上綠色戰袍，延續外線火力，與夢想家朝新賽季目標前進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269103.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 12:03", "link": "/news/story/7003/9717377"}, {"article_id": "9717310", "title": "NBA／經營權內鬥再起 珍妮巴斯提告阻兄弟姊妹售出湖人剩餘股權", "summary": "湖人內部再次爆發家族經營權爭議，湖人掌門人珍妮巴斯（Jeanie Buss）向洛杉磯高等法院提出訴訟，挑戰其餘5位兄弟姊妹日前投票決定出售家族剩餘湖人股權的合法性，並要求撤銷吉妮（Janie Buss）與喬伊（Joey Buss）的共同信託人身分，讓這起牽涉龐大商業利益與家族遺產的爭端再次升溫。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269040.jpg&M=1&s=Y&x=0&y=0&sw=1271&sh=847&exp=3600&sl=W&fw=360", "date": "2026-08-27 11:40", "link": "/news/story/7002/9717310"}, {"article_id": "9717258", "title": "MLB／朗希手指水泡3.1局退場 「自殺棒」金河成再見安送道奇2連敗", "summary": "道奇今天前往客場交手勇士，由佐佐木朗希掛帥先發，不料因手指起水泡緊急退場，留下3.1局失4分成績。不過球隊靠著打線穩定輸出纏鬥至第九局，最終才被本季狀況不佳的金河成把握機會，敲出再見安，以5：6在系列戰吞下2連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269010.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 11:27", "link": "/news/story/6999/9717258"}, {"article_id": "9717078", "title": "MLB／比費城人還扯！紅人九局狂灌7分 睽違66年再演奇蹟逆轉", "summary": "紅人今天在客場上演驚奇逆轉，在第九局落後6分的絕境下，靠著羅德里奎茲（Héctor Rodríguez）和蘇亞雷茲（Eugenio Suarez）分別敲轟吹起反攻號角，最終單局狂灌7分以10：9擊敗巨人，創下睽違66年的隊史紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35268537.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-27 11:03", "link": "/news/story/6999/9717078"}, {"article_id": "9717160", "title": "美網／才剛感性告別紐約 瓦文卡大反轉遞補獲外卡迎最後一舞", "summary": "3座大滿貫得主、前美網冠軍瑞士名將瓦文卡（Stan Wawrinka），原本在無緣獲得外卡後於社群媒體上溫情告別紐約，沒想到劇情隨即迎來戲劇性大反轉。美網主辦單位美國網球協會今天宣布，由於原本獲得外卡的美國地主好手基普森（Patrick Kypson）因傷退賽，該張外卡將由41歲的瓦文卡遞補拿下，讓這位老將得以順利登上美網會內賽舞台，迎來職業生涯的最後一舞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35268730.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-27 10:58", "link": "/news/story/121623/9717160"}, {"article_id": "9716738", "title": "MLB／美媒「認罪」錯看李灝宇 老虎教頭讚：不會帶著恐懼比賽", "summary": "美國媒體觀察，台灣棒球好手李灝宇在美國職棒大聯盟持續進化，選球力更好、拉打增加，變成一個更危險的打者。老虎總教練辛奇對他...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35268582.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 10:46", "link": "/news/story/6999/9716738"}, {"article_id": "9717107", "title": "NBA／獲鵜鶘2年1600萬美元合約 馬瑟倫改披紐奧良戰袍", "summary": "在自由市場經過一番拉鋸後，24歲的砍將馬瑟倫（Bennedict Mathurin）總算迎來生涯新篇章，今天傳出已與鵜鶘隊達成一份為期兩年、總價值1600萬美元的合約，其中第二年包含球員選項，為了順利轉戰紐奧良，馬瑟倫團隊特別要求快艇隊撤回880萬美元的報價，讓他得以投奔發揮空間更大、保障更佳的新東家。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35268608.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 10:41", "link": "/news/story/7002/9717107"}, {"article_id": "9716952", "title": "NBA／灰狼補強再有斬獲 庫明加2年短約加盟拚證明身價", "summary": "在歷經了長達數月的自由市場拉鋸戰後，前鋒庫明加（Jonathan Kuminga）的落腳處終於塵埃落定，根據美國媒體報導，庫明加已與灰狼隊達成一份為期兩年、總價值1240萬美元的合約，其中第二年為球員選項，這意味著他選擇了一份短期的合約希望能證明身價。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35268289.jpg&M=1&s=Y&x=0&y=129&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-27 09:55", "link": "/news/story/7002/9716952"}, {"article_id": "9716832", "title": "MLB／費城人史瓦柏率先40轟 追平大谷、賈吉和隊史最強紀錄", "summary": "費城人隊重砲史瓦柏（Kyle Schwarber）今天2局上轟出3分砲，成為大聯盟本季首位達到40轟的球員，費城人以6：0擊敗水手隊，逃過客場3連戰遭清盤命運。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35268320.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-27 09:05", "link": "/news/story/6999/9716832"}, {"article_id": "9716776", "title": "MLB／李灝宇再戰光芒3打數掛零 準備迎戰道奇兩大塞揚強投", "summary": "老虎隊今天繼續在底特律主場迎戰光芒隊，旅美好手李灝宇擔任先發九棒三壘手，全場3次打數掛零，老虎打線總共只有兩支安打，終場以0：3落敗，以1勝2敗輸掉系列賽，離美聯外卡愈來愈遠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35267965.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 08:25", "link": "/news/story/6999/9716776"}, {"article_id": "9715884", "title": "中職／去年4隊一球未投賭對人 悍將831抉擇能否同樣成功", "summary": "中職831洋將大限倒數4天，中信、台鋼、富邦仍評估名單；富邦8月補進3名洋投，實戰測試受天候影響，去年4名洋投曾一球未投即入選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35267025.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 07:00", "link": "/news/story/122629/9715884"}, {"article_id": "9716059", "title": "大都會拯救牛棚出奇招 千賀滉大「鬼轉」終結者有搞頭？", "summary": "大都會意外找到新終結者！千賀滉大改任後援後，8月防禦率降至2.45，連續4次救援成功，靠火球與招牌指叉球展現轉型成效。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35267207.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 07:00", "link": "/news/story/122629/9716059"}, {"article_id": "9715886", "title": "從「滾地球王子」到8月全壘打王 小塔提斯大復活的關鍵是什麼？", "summary": "教士隊小塔提斯擺脫開季低潮，八月轟出9發全壘打並列大聯盟第一，長打率居國聯之冠；揮棒速度、站姿與身體前傾調整成復活關鍵，助隊衝擊季後賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35266994.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 07:00", "link": "/news/story/122629/9715886"}, {"article_id": "9716386", "title": "中職／伍立辰生涯首獲MVP 與好友曾家輝同場較勁很興奮", "summary": "中華職棒中信兄弟隊今天以2比0擊敗樂天桃猿隊，兄弟先發投手伍立辰生涯首度獲選單場MVP，與好友曾家輝同場較勁演出7局無失...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35268500.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-27 04:14", "link": "/news/story/7001/9716386"}, {"article_id": "9716457", "title": "瓊斯盃／只打3場叫重視女籃？ 籃協：明年會有更好安排", "summary": "新任籃協理事長辜公怡兩個月前參加國泰人壽隊連霸慶功宴時，提到台灣女籃具有國際競爭力，允諾投入資源，並說：「一起努力，讓台灣女子籃球變得更好。」但新團隊首次舉辦瓊斯盃，對「資源投入女籃」的承諾卻像空頭支票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35267577.jpg&M=1&s=Y&x=50&y=0&sw=1181&sh=787&exp=3600&sl=W&fw=360", "date": "2026-08-27 00:00", "link": "/news/story/7003/9716457"}]}, {"name": "棒球", "articles": [{"article_id": "9717346", "title": "MLB／洋基台灣日太空人巧