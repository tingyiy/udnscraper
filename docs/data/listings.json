gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35333742.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9758358"}, {"article_id": "9757998", "title": "沒「大物」靠團隊 U15中華隊盼突破世界盃最佳成績", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332989.jpg&M=1&s=Y&x=67&y=0&sw=1152&sh=768&exp=3600&w=300", "link": "/news/story/122629/9757998"}, {"article_id": "9756739", "title": "中職／本土奇兵崛起成亮點 富邦滿手好牌卻接連放槍", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331229.jpg&M=1&s=Y&x=0&y=73&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9756739"}, {"article_id": "9755985", "title": "「毀滅性打擊」快艇背後 NBA如何從密約事件重建公信力？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332284.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9755985"}]}, {"name": "最新文章", "articles": [{"article_id": "9765610", "title": "李灝宇登MLB創單季10轟！一圖看全壘打分布、打擊熱區", "summary": "23歲台灣強打李灝宇的單場4安之夜，包括1發追平兩分砲，敲出本季第10轟、第28支長打，雙破張育成紀錄，也成為今年第6位達到10轟的亞洲選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344920.png&M=1&s=Y&x=0&y=0&sw=800&sh=533&exp=3600&sl=W&fw=360", "date": "2026-09-20 05:51", "link": "/news/story/6999/9765610"}, {"article_id": "9765595", "title": "拔河／室外拔河世錦賽 台灣4金2銀2銅、女子雙5連霸", "summary": "今天是在南非舉辦的2026世界室外拔河錦標賽最後一天賽事，台灣隊本日勇奪2金2銀1銅。此次比賽台灣隊展現超強實力，共獲得...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_9.jpg", "date": "2026-09-20 04:37", "link": "/news/story/7005/9765595"}, {"article_id": "9765503", "title": "運動人生／給基層資源 讓選手看到未來", "summary": "「台灣不缺溜冰人才，但訓練多處於土法煉鋼或『模仿表面動作』階段，缺乏科學化的基層訓練系統。」楊合貞表示，各地都曾引進世界冠軍好手教學，但成效往往有限，競技運動不能只靠苦練，更需要完整的科學訓練、運動防護、營養、心理及制度上的支持。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_4.jpg", "date": "2026-09-20 00:53", "link": "/news/story/7005/9765503"}, {"article_id": "9765502", "title": "運動人生／重傷後再戰 楊合貞感謝恩師沒放棄", "summary": "「當時的想法很單純，就是不想停留在第二名，想證明自己可以做得更好；從柏油路、到操場，誰會認為有一天會成了世界第一？」楊合貞說，當了多年「亞軍」，一度想放棄，在父母及教練鼓勵下堅持下來，總算站上世界舞台，拿到金牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344936.jpg&M=1&s=Y&x=0&y=0&sw=1203&sh=802&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:52", "link": "/news/story/7005/9765502"}, {"article_id": "9765500", "title": "運動人生／楊合貞 卸戰袍帶後輩追夢", "summary": "訂報贈品 開啟滑輪溜冰生涯", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344922.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:50", "link": "/news/story/7005/9765500"}, {"article_id": "9765490", "title": "MLB／本季第10轟…李灝宇雙破紀錄 台將第1人", "summary": "大聯盟單季雙位數全壘打，不再是台灣選手到不了的高度。廿三歲台灣強打李灝宇的單場四安之夜，包括一發追平兩分砲，敲出本季第十轟、第廿八支長打，雙破張育成紀錄，也成為今年第六位達到十轟的亞洲選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344906.jpg&M=1&s=Y&x=0&y=23&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:43", "link": "/news/story/6999/9765490"}, {"article_id": "9765487", "title": "MLB／超韓趕日…李灝宇78安 挑戰大谷紀錄", "summary": "來自台灣的「比特犬」、美國職棒大聯盟（ＭＬＢ）底特律老虎隊野手李灝宇，幾乎已全面刷新張育成保有的單季台將紀錄，在今年球季例行賽最後八場比賽，還有一項可以追逐的超高難度目標，就是大谷翔平保有的亞洲選手廿三歲以下賽季最多安紀錄，來自二○一八年的九十三支安打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344902.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:17", "link": "/news/story/6999/9765487"}, {"article_id": "9765488", "title": "MLB／李灝宇秀英文：不喜歡輸的感覺", "summary": "底特律老虎隊台將李灝宇在美國職棒大聯盟（ＭＬＢ）的菜鳥賽季，用球棒將自己打進球隊的建隊藍圖。他不只靠場上成績說話，與隊友的相處也游刃有餘，昨天賽後受訪時以英語說「不喜歡輸的感覺」，凸顯這位年輕好手勇於表達自己的想法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35345043.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:16", "link": "/news/story/6999/9765488"}, {"article_id": "9765489", "title": "MLB／點燃全隊鬥志 老虎教頭：別忽視實質貢獻", "summary": "渾身帶勁的美國職棒大聯盟（ＭＬＢ）底特律老虎隊球員李灝宇，不只用能量渲染全隊，老虎隊總教練辛區直言，「他是實質為比賽帶來貢獻」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/20/35345049.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:16", "link": "/news/story/6999/9765489"}, {"article_id": "9765416", "title": "亞運／富邦金挺中華隊 全民應援抽機票", "summary": "二○二六年名古屋亞運昨晚開幕，今年共六位「富邦Dream Team」選手及球員將代表中華隊爭取佳績，包括舉重選手郭婞淳、陳冠伶，體操選手李智凱、高爾夫選手王偉軒，鐵人三項選手張綺文，以及入選中華男籃的台北富邦勇士隊球員曾祥鈞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344866.png&M=1&s=Y&x=0&y=0&sw=1011&sh=674&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:00", "link": "/news/story/124981/9765416"}, {"article_id": "9765413", "title": "亞運／開幕式110人大團出場 中華隊拚首金", "summary": "二○二六名古屋亞運昨晚在瑞穗公園陸上競技場舉行開幕典禮，亞運聖火在主場館點燃，宣告本屆賽會展開。中華代表團由拳擊女將黃筱雯與散打好手張煥宜擔任掌旗官，率一一○人大團出場，迎接今天全面展開的各項賽事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344864.jpg&M=1&s=Y&x=30&y=0&sw=993&sh=662&exp=3600&sl=W&fw=360", "date": "2026-09-20 00:00", "link": "/news/story/124981/9765413"}, {"article_id": "9765298", "title": "亞運／璀璨煙火中名古屋亞運正式啟動", "summary": "2026年名古屋亞運今晚在瑞穗公園陸上競技場舉行開幕典禮，是日本暌違32年再度主辦亞運，日本天皇德仁與皇后雅子親自蒞臨現場。中華代表團由黃筱雯、張煥宜掌旗，共計110人穿著訂製西裝、揮舞會旗出場，獲得現場觀眾的歡呼聲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344587.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-19 21:36", "link": "/news/story/124981/9765298"}, {"article_id": "9765269", "title": "中職／「兄弟」連線擊退味全龍 岳東華想打高飛球變再見安", "summary": "中華職棒中信兄弟今天前9局受制於味全龍隊洋投梅賽鍶僅得2分，但10局下岳政華積極搶占三壘後，哥哥岳東華敲再見安打，以4比...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/19/35344569.jpg&M=1&s=Y&x=0&y=69&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-19 21:20", "link": "/news/story/7001/9765269"}, {"article_id": "9765274", "ti