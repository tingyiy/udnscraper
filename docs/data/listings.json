, "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/28/35462894.jpg&M=1&s=Y&x=0&y=0&sw=930&sh=620&exp=3600&w=300", "link": "/news/story/122629/9842749"}, {"article_id": "9838016", "title": "日職／軟銀帶著連勝回福岡 徐若熙要上場得等兩個情況", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/26/35455514.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9838016"}]}, {"name": "最新文章", "articles": [{"article_id": "9848968", "title": "NBA／湖人25分領先慘遭勇士逆轉 主帥怒批裁判假摔吹罰雙標", "summary": "湖人在NBA盃小組賽首戰遭遇難堪逆轉，面對勇士一度取得25分領先，卻在首節結束後攻守全面失序，最終以95：112吞敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472459.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 15:36", "link": "/news/story/7002/9848968"}, {"article_id": "9848960", "title": "NBA／波爾辛吉斯怪病纏身恐退休！勇士考慮認賠分手 柯爾坦言：完全措手不及", "summary": "金州勇士新賽季才剛展開，就面臨意想不到的人事變動。休賽季以2年4000萬美元合約留下的拉脫維亞長人波爾辛吉斯（Kristaps Porzingis），因持續受到姿勢性直立性心搏過速症候群（POTS）困擾，至今仍未歸隊，甚至傳出正在考慮退休。勇士目前也開始探索交易可能性，讓總教練柯爾（Steve Kerr）坦言，整起事件的發展完全出乎球隊預料。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472446.jpg&M=1&s=Y&x=60&y=0&sw=1118&sh=745&exp=3600&sl=W&fw=360", "date": "2026-10-31 15:21", "link": "/news/story/7002/9848960"}, {"article_id": "9848954", "title": "中職／中信兄弟連3年派員參與歐力士秋訓 彭識穎領5名投手赴日", "summary": "中信兄弟隊季後交流啟動，連續3年派員前往日本參與日職歐力士隊秋訓，今年由二軍投手教練彭識穎領軍，帶領王凱程、張祖恩、劉亦智、錢可倫及大瀧幸治等5名投手，參與為期超過兩周的歐力士隊秋訓行程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472433.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 15:13", "link": "/news/story/7001/9848954"}, {"article_id": "9848925", "title": "NBA／向勇士名將伊古達拉學投資！海斯倫：第一檔股票是Nvidia", "summary": "前熱火隊長海斯倫（Udonis Haslem）最近透露，自己在2020年NBA泡泡園區期間，開始接觸股票市場投資，當時的隊友伊古達拉（Andre Iguodala）教他怎麼投資，Nvidia成為他人生第一支股票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472381.jpg&M=1&s=Y&x=92&y=138&sw=1057&sh=705&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:52", "link": "/news/story/7002/9848925"}, {"article_id": "9848928", "title": "中職／悍將成票房王者感謝全球邦迷 休賽季海外進修團持續啟動", "summary": "富邦悍將隊今天舉辦一年一度的球迷感恩會，為不一樣的賽季感謝邦迷相挺，悍將本季票房收入近4億元在全聯盟居冠，場均1萬1407人、總人數68萬4434人都寫下新高，領隊陳昭如直言令人感動，也盼將球迷的力量帶到明年。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472382.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:51", "link": "/news/story/7001/9848928"}, {"article_id": "9848918", "title": "NBA／連環晃倒「77」唐西奇！柯瑞笑翻：我很久沒這麼空了", "summary": "勇士隊柯瑞（Stephen Curry）今天在NBA盃面對湖人隊，上演本季至今最具話題的個人秀。第三節一次單打，他連續交叉運球、背後運球再接後撤步，直接晃倒湖人「77號」唐西奇（Luka Doncic），隨後穩穩投進三分球；柯瑞賽後笑稱，自己真的很久沒有獲得那麼大的空檔。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472370.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:51", "link": "/news/story/7002/9848918"}, {"article_id": "9848923", "title": "擊劍／U23亞錦賽洪莉翔女子銳劍奪金 陳秉濬男子銳劍摘銅", "summary": "2026年亞洲U23擊劍錦標賽於10月27日至11月3日在巴林首都麥納瑪舉行，本屆賽事中華代表隊共派出15名選手出賽，角逐男、女銳劍及男、女鈍劍項目，並在30日傳回捷報，女子銳劍好手洪莉翔奪下金牌，男子銳劍陳秉濬也帶回銅牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472372.jpg&M=1&s=Y&x=1&y=239&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:47", "link": "/news/story/7005/9848923"}, {"article_id": "9848913", "title": "中職／沒想過能拿個人獎 林澤彬首度參與頒獎典禮帶彬糖彬果同行", "summary": "曾在樂天桃猿隊苦無出賽機會，林澤彬在交易轉戰富邦悍將隊後找到新天地，今年獲得最佳十人二壘手獎，後天將首度參與年度頒獎典禮，讓他超緊張，「還沒開始就很緊張，每天都睡不好。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472352.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:38", "link": "/news/story/7001/9848913"}, {"article_id": "9848814", "title": "NBA／「大頭森」後仰不慎撞進女裁判懷裡！被摟腰尷尬畫面瘋傳", "summary": "尼克隊今天在NBA盃東區B組作客76人隊，雖然最終以93：98吞敗，但場上一段意外花絮卻比比賽結果更快在社群平台掀起討論。尼克主控布朗森（Jalen Brunson）一次切入禁區後準備後仰跳投，連續動作讓他自然往場邊退去，正好撞上站在底線觀察戰況的女裁判。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472185.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:35", "link": "/news/story/7002/9848814"}, {"article_id": "9848893", "title": "中職／連兩屆亞冠賽都因傷辭退 孔念恩難掩可惜：很想看看日本投手", "summary": "富邦悍將隊外野手孔念恩3年前因左手腕傷勢錯過亞冠賽，這回再度入選，換成右手腕攪局，最終確定辭退，也讓他錯過人生第一次國際賽，言談之中難掩可惜。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472280.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:26", "link": "/news/story/7001/9848893"}, {"article_id": "9848876", "title": "中職／悍將明年主帥仍是後藤光尊 鈴木駿輔朝續留持續洽談", "summary": "富邦悍將隊今年以全年第三被擋在季後賽門外，球季落幕後針對明年球季展開布局，確定明年仍由後藤光尊領軍，洋投續約除了已完成洽談的魔力藍之外，也持續與鈴木駿輔接洽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472251.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:10", "link": "/news/story/7001/9848876"}, {"article_id": "9848536", "title": "MLB／台灣連線有譜！鄭宗哲轉戰老虎攜手李灝宇 卻先面臨DFA考驗", "summary": "旅美內野手鄭宗哲被紅襪隊交易到老虎隊，換取現金補償，也讓他與李灝宇成為隊友。兩人明年是否有機會在大聯盟聯手、甚至組成「台灣內野連線」，已成台灣球迷關注話題；不過，鄭宗哲要留在老虎40人名單，眼前還有一道很現實的關卡。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35471666.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 14:10", "link": "/news/story/6999/9848536"}, {"article_id": "9848832", "title": "NBA／從落後25分到大勝湖人17分！柯瑞領軍勇士3連勝 狂寫聯盟新紀錄", "summary": "勇士今天在自家主場打出不可思議逆轉秀，接連克服首節23分落後、第三節9分落後的劣勢，在柯瑞（Stephen Curry）和波傑姆斯基（Brandin Podziemski）聯手攻下52分，以及替補群合力轟進50分的帶動下，以112：95逆轉擊敗湖人。勇士雖然吞下開季3連敗，但近期重整腳步反而拉出一波3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472255.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 13:44", "link": "/news/story/7002/9848832"}, {"article_id": "9848833", "title": "中職／曾峻岳拚旅外面臨MLB封館時間壓力 陳昭如：全力支持", "summary": "曾峻岳提出旅外自由球員權利，儘管影響富邦悍將隊明年後防布局，球團全力支持，領隊陳昭如認為這是球員權利，球團抱持樂觀其成的態度，副領隊林威助也說這是好事，盼曾峻岳可以獲得球團青睞，甚至拿到更好條件。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472187.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 13:41", "link": "/news/story/7001/9848833"}, {"article_id": "9848799", "title": "NBA／韋德先發「0出手0得分」 詹姆斯：數據無法反映貢獻", "summary": "76人隊今天在主場以98：93險勝衛冕軍尼克隊，先發前鋒韋德（Dean Wade）上場27分鐘，0出手0得分，數據欄只有2籃板、1助攻、3抄截。不過詹姆斯（LeBron James）賽後大讚韋德，有數據看不到的貢獻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472118.jpg&M=1&s=Y&x=0&y=191&sw=872&sh=581&exp=3600&sl=W&fw=360", "date": "2026-10-31 13:20", "link": "/news/story/7002/9848799"}, {"article_id": "9848803", "title": "中職／看李灝宇、鄭宗哲同隊好羨慕 張育成回想自己孤單時沒人陪", "summary": "鄭宗哲昨天透過交易轉戰老虎隊，新球季有望與李灝宇同隊打拚，若成真將寫下史上第一次兩位台灣野手在大聯盟同隊，張育成回想自己過去在大聯盟隻身打拚，也坦言自己看了真的超羨慕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472125.jpg&M=1&s=Y&x=0&y=101&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-31 13:19", "link": "/news/story/7001/9848803"}, {"article_id": "9848802", "title": "中職／感覺像擁有全新手臂 張育成12月赴美訓練找回「最初的自己」", "summary": "富邦悍將隊張育成困擾已久的骨刺問題，在今年季後動刀根除，今天帶來好消息，張育成笑說：「感覺好像新的手臂」。他將在12月前往美國進行自主訓練，目標找回剛返台時的打擊形態，也盼明年球季重返「左半邊」防區。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472117.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 13:19", "link": "/news/story/7001/9848802"}, {"article_id": "9848773", "title": "中職／知道外界很多閒言 曾峻岳二度挑戰旅外：想讓棒球路過得更精彩", "summary": "富邦悍將隊「護國神山」曾峻岳二度挑戰旅外，繼2023年後再次向更高棒球殿堂敲門，今天揭露早在季前世界棒球經典賽，就和林凱威約定，兩人將在今年季後行使，曾峻岳直言這是自己的最後一次機會，「再不拚可能也沒機會了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472060.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 13:08", "link": "/news/story/7001/9848773"}, {"article_id": "9848692", "title": "NBA／前5戰狂獲39罰！快艇19歲新秀比肩班凱羅 寫37年罕見紀錄", "summary": "快艇隊新秀瓦格勒（Keaton Wagler）開季雖全數從板凳出發，卻已靠著強勢切入與造犯規能力，在NBA留下罕見數字。他生涯前5戰合計獲得39次罰球機會，是自2022年班凱羅（Paolo Banchero）以來新秀最多；若限定前5戰都未先發，更是自1989年馬丘利歐尼斯（Šarūnas Marčiulionis）後的最高紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35471947.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 12:50", "link": "/news/story/7002/9848692"}, {"article_id": "9848702", "title": "NBA／被布魯克斯「踢蛋」更神勇！金塊穆雷狂轟39分射落太陽", "summary": "太陽隊今天在主場迎戰金塊隊，上半場狂砍20分的布魯克斯（Dillon Brooks）第三節因「踢蛋」吞惡犯，被驅逐出場。受害者穆雷（Jamal Murray）全場狂轟39分，布勞恩（Christian Braun）也爆砍31分，加上罰球線30：11的絕對優勢，金塊最終就以127：120擊敗太陽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35471958.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 12:44", "link": "/news/story/7002/9848702"}, {"article_id": "9848699", "title": "NBA／專殺公牛！普里查德替補爆砍30分 塞爾蒂克輕鬆奪4連勝", "summary": "塞爾蒂克今天在NBA盃小組賽首戰迎戰公牛，替補殺手普里查德（Payton Pritchard）攻下全場最高30分，加上泰托姆（Jayson Tatum）也貢獻26分7籃板7助攻，綠衫軍上半場轟垮對方防線，一度取得多達32分領先，最終以125：111輕取公牛，收下近期4連勝，也讓對手苦吞4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35471950.jpg&M=1&s=Y&x=28&y=0&sw=1218&sh=812&exp=3600&sl=W&fw=360", "date": "2026-10-31 12:34", "link": "/news/story/7002/9848699"}, {"article_id": "9848629", "title": "日職／嫌日本棒球無趣！前塞揚包爾曝專打界外球：3人就耗先發30球", "summary": "曾兩度效力橫濱DeNA隊的前國聯賽揚獎投手包爾（Trevor Bauer），近日在TikTok暢談日職打者的特色，直言日本棒球「很無趣」，認為不少打者上場後的首要目標並非敲安，而是把球不斷破壞成界外球、消耗先發投手球數。不過話說得犀利，他也承認，日本打者的碰球能力確實強到「難以置信」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35471848.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 12:20", "link": "/news/story/7001/9848629"}, {"article_id": "9848673", "title": "日職／平良海馬以先發投手身分挑戰大聯盟 夢想奪下塞揚獎", "summary": "西武獅隊26歲右投平良海馬獲球團放行，準備透過入札制度挑戰大聯盟，今天他在接受日本媒體訪問時也表達自己想挑戰更高殿堂的野心，沒有特別屬意的球隊，並將朝拿下「塞揚獎」的夢想而努力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/12/35321586.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-31 12:14", "link": "/news/story/7001/9848673"}, {"article_id": "9848668", "title": "田徑／亞運摘金後逐步回歸現實 傅兆玄下一步放眼世錦賽舞台", "summary": "今年在名古屋亞運田徑男子跳高奪得金牌，也是我國田徑男子選手暌違60年亞運金牌的傅兆玄，在今天出席亞運後首個公開代言活動，談到亞運落幕一個月後的心情，他直言已經開始有回歸現實的感覺，不能在榮耀中停留太久，必須收拾心情往下一個目標前進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35471910.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-31 12:11", "link": "/news/story/7005/9848668"}]}, {"name": "棒球", "articles": [{"article_id": "9848773", "title": "中職／知道外界很多閒言 曾峻岳二度挑戰旅外：想讓棒球路過得更精彩", "date": "2026-10-31 13:08", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472060.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9848773"}, {"article_id": "9848833", "title": "中職／曾峻岳拚旅外面臨MLB封館時間壓力 陳昭如：全力支持", "date": "2026-10-31 13:41", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472187.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9848833"}, {"article_id": "9848802", "title": "中職／感覺像擁有全新手臂 張育成12月赴美訓練找回「最初的自己」", "date": "2026-10-31 13:19", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472117.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9848802"}, {"article_id": "9848803", "title": "中職／看李灝宇、鄭宗哲同隊好羨慕 張育成回想自己孤單時沒人陪", "date": "2026-10-31 13:19", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/31/35472125.jpg&M=1&s=Y&x=0&y=101&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9848803"}, {"article_id": "9848954", "title": "中職／中信兄弟連3年派員參與歐力士秋訓 彭識穎領5名投手赴日", "date": "2026-10-31 15:13", "thumbnail": "https://pgw.udn.com.tw/g