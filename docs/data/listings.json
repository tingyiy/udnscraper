ttps://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9687689"}, {"article_id": "9684672", "title": "日職／林安可手感正好卻受傷 西武死守A段班傷兵潮來得不是時候", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/31/34815827.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684672"}, {"article_id": "9685328", "title": "中職／全季排名戰局詭譎富邦還在線！831大限成突圍關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35219029.jpg&M=1&s=Y&x=0&y=0&sw=1107&sh=738&exp=3600&w=300", "link": "/news/story/122629/9685328"}, {"article_id": "9684466", "title": "金鶯震撼出清狀元拉契曼 第二代「面具鐵爺」再次遺憾收場", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35220091.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684466"}, {"article_id": "9682402", "title": "日職／洋將及捕手戰力考量 火腿林家正或有上一軍開箱機會", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217245.jpg&M=1&s=Y&x=0&y=0&sw=927&sh=618&exp=3600&w=300", "link": "/news/story/122629/9682402"}]}, {"name": "最新文章", "articles": [{"article_id": "9690402", "title": "中職／張士綸自己「吹」出第2轟 兄弟教頭讚：好表現超出預期", "summary": "中信兄弟21歲菜鳥張士綸近期手感延燒，今天從富邦悍將本土王牌李東洺手中敲出本季（生涯）第2轟，延續連14場安打、連19場上壘，總教練平野惠一也給予高度肯定，「有超出預期以上的好表現。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228566.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 23:04", "link": "/news/story/7001/9690402"}, {"article_id": "9690367", "title": "16日開跑！林義傑、王仁甫、郭彥均領台灣15選手 挑戰極限7天250K納米比亞沙漠賽", "summary": "2026年四大極地納米比亞沙漠賽將於16日開跑，15位台灣選手挑戰250公里耐力賽，林義傑領軍各職業選手攜手共赴沙漠考驗，展現人類韌性與團隊精神。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228516.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 22:50", "link": "/news/story/7005/9690367"}, {"article_id": "9690349", "title": "中職／兄弟打線狙擊李東洺 張士綸、高宇杰開轟近8戰拿6勝", "summary": "富邦悍將隊今天在新莊棒球場迎戰中信兄弟，聯盟勝投王李東洺先發遭狙擊，僅投3.2局失5分（4分自責分）；兄弟伍立辰則是先發5局失3分，加上打線全場敲12支安打，包括張士綸、高宇杰的2發全壘打，終場以8：6擊敗悍將，近8戰拿6勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228496.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 22:22", "link": "/news/story/7001/9690349"}, {"article_id": "9690269", "title": "亞洲少棒／中華隊複賽首戰不敵日本 「再見失誤」5：6遭逆轉", "summary": "U12亞洲少棒錦標賽今天複賽首戰上演「台日大戰」，中華隊儘管一度打下5：1領先，最終卻沒能守成，6局下讓日本隊展開反撲，最終發生「再見失誤」以5：6遭逆轉錯失勝利，複賽戰績1勝1敗，然而明天只要擊敗中國隊，仍能挺進冠軍戰，再次與日本隊爭冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228422.jpg&M=1&s=Y&x=0&y=0&sw=1004&sh=669&exp=3600&sl=W&fw=360", "date": "2026-08-13 21:16", "link": "/news/story/7001/9690269"}, {"article_id": "9690251", "title": "中職／高國輝罕見動怒衝上場 動用范國宸+2教練奮力攔住", "summary": "富邦悍將隊今天在主場對上中信兄弟，前5局就挨2轟，以3：7落後中信兄弟，5局下董子恩遭到三振出局後還出現插曲，打擊教練高國輝疑似因不滿好球帶，氣憤衝上場欲找主審理論，但被球員及教練奮力攔住。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228365.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 21:03", "link": "/news/story/7001/9690251"}, {"article_id": "9689991", "title": "中職／岳政華不想打擊忽冷忽熱 果斷揮棒下半季求穩", "summary": "中華職棒中信兄弟野手岳政華不想打擊手感像忽冷忽熱的熱水器，把目標放在每天都能「及格」起跳，下半季揮棒更果決也看見成效", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228023.jpg&M=1&s=Y&x=0&y=36&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 19:10", "link": "/news/story/7001/9689991"}, {"article_id": "9690028", "title": "中職／王苡丞外野美技列入個人Highlight 悍將教頭：教練被他救了", "summary": "富邦悍將王苡丞昨天在外野秀美技，面對中信兄弟之戰，在4局上接殺江坤宇擊出的右外野飛球，精彩的表現也列入他生涯的守備Highlight中，守外野的信心值再提升了一些，但總教練後藤光尊卻笑稱，「是教練被他救了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228021.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 19:05", "link": "/news/story/7001/9690028"}, {"article_id": "9690027", "title": "桌球／拍下頭號種子！林昀儒、鄭怡靜瑞典大滿貫勇闖4強", "summary": "東京奧運打下桌球混雙銅牌的「小林同學」林昀儒／鄭怡靜，今天WTT瑞典大滿貫賽面對現今混雙世界第一的南韓組合林鐘勳／申裕斌，一下場就連拿7分，第二局更打出8：0的漂亮開局，第四局再頂住頭號種子反撲，以局數3：1拍下南韓組合，闖進4強締造在大滿貫的合作最佳成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228029.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 19:04", "link": "/news/story/7005/9690027"}, {"article_id": "9689942", "title": "中職／下半季逆勢回穩 廖任磊找回投球掌握度", "summary": "富邦悍將隊後援投手廖任磊進入下半季後，登板表現更加穩定，近期連6場出賽沒讓打者上壘，控球狀況也有明顯改善。廖任磊指出，自己其實沒有特別多做什麼，但練習時在做的東西能更好地呈現出來，控制的感覺確實比較好一點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227925.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 18:17", "link": "/news/story/7001/9689942"}, {"article_id": "9689856", "title": "中職／廖任磊球有威力、控球變好 後藤光尊：安排更關鍵的時機登板", "summary": "富邦悍將隊後援投手廖任磊近期控球表現趨穩定，連6場登板無失分，悍將總教練後藤光尊也給予肯定，認為他是有能力撐起勝利方程式的投手，因此也希望能找到更好的時機，在關鍵的場面下讓他上場發揮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227848.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-13 17:41", "link": "/news/story/7001/9689856"}, {"article_id": "9689773", "title": "NBA／上季三分57.1% 太陽裁掉29歲「3D前鋒」海史密斯", "summary": "太陽隊今天裁掉29歲前鋒海史密斯（Haywood Highsmith），他具備不俗的防守和外線投射能力，可能成為爭冠球隊的拼圖。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227702.jpg&M=1&s=Y&x=0&y=65&sw=694&sh=463&exp=3600&sl=W&fw=360", "date": "2026-08-13 17:19", "link": "/news/story/7002/9689773"}, {"article_id": "9689710", "title": "MLB／史肯斯啤酒肚與女友腹肌成強烈對比 網痛批：身材不像職業球員", "summary": "海盜隊王牌投手史肯斯（Paul Skenes）今年球速下滑、成績退步。最近他與女友鄧恩（Olivia Dunne）裸上半身在海灘散步的照片，引發兩派球迷爭執。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227580.jpg&M=1&s=Y&x=0&y=29&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 17:17", "link": "/news/story/6999/9689710"}, {"article_id": "9689770", "title": "TPBL／有洋蔥！林庭謙回台打球 留一個位置給爸爸", "summary": "因為父親「小羊哥」林正明是籃球教練，讓林庭謙從小耳濡目染下進入籃球世界，國中畢業就離開台灣的他今年決定返台加入TPBL台北台新戰神隊，儘管父親已經在2年前離世，他今天加盟記者會上透露平常比賽時會在球場上找一個位置，當作父親在場為他加油，讓台下的母親劉靜明和姊姊都紅了眼眶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227688.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-13 17:16", "link": "/news/story/7003/9689770"}, {"article_id": "9689744", "title": "MLB／弗里曼重摔慶幸未傷到頭部 賽後侃侃而談笑說個子夠高", "summary": "道奇隊明星一壘手弗里曼（Freddie Freeman）今天8局上為了接界外球，在客隊皇家休息區的階梯不小心滑倒，整個人重摔在地上，讓隊友嚇出一身冷汗，還好身體沒有太大問題，這位36歲老將在賽後記者會還能露出笑容，他說：「本來打算靠在護欄上接球，顯然那裡根本沒有護欄。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227794.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 17:02", "link": "/news/story/6999/9689744"}, {"article_id": "9689662", "title": "TPBL／高薪沒壓力 林庭謙：目標就是總冠軍", "summary": "結束中國CBA旅外生活返台，中華隊國手林庭謙今天在加盟記者會正式領到0號球衣，成為台北台新戰神隊當家球星的他強調，回台目標就是為戰神打下總冠軍，合約金額不會造成壓力，他笑說：「誇下海口就必須要去實踐，去完成這個目標。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227486.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 16:31", "link": "/news/story/7003/9689662"}, {"article_id": "9689628", "title": "棒球／爭取2028奧運參賽門票 2027年12強賽、6搶1資格賽在台舉辦", "summary": "棒球賽事回歸2028年洛杉磯奧運，中華隊想爭取參賽，剩下兩場國際大賽的機會，中華棒球協會今天宣布，攸關參賽奧運門票的2項賽事，包括明年世界12強賽預、複賽，以及奧運最終資格賽，都將在台北市舉辦。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227653.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 16:20", "link": "/news/story/7001/9689628"}, {"article_id": "9689594", "title": "MiLB／洋基沃爾普比賽前6球用光2挑戰 球評狠酸：另外27人不開心", "summary": "洋基隊25歲游擊手沃爾普（Anthony Volpe）日前被下放3A，最近加練二壘，今天比賽他前6球就發動2次挑戰全部失敗，遭球評狠酸一波，還在社群平台被瘋傳。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227369.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 16:07", "link": "/news/story/6999/9689594"}, {"article_id": "9689585", "title": "影／全台200名拳擊好手對抗賽競技 基隆國內外賽事成績亮眼", "summary": "基隆拳擊選手近年在國內外賽事表現亮眼，不僅榮獲U15亞洲少年拳擊錦標賽銅牌，也在今年全國中等學校運動會勇奪1銀2銅。「基隆市115年拳擊區域對抗賽」今天在國立基隆高中登場，全台10個縣市20所學校約200名拳擊選手，透過實戰切磋，為基隆拳擊運動發展注入更多活力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227346.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 16:02", "link": "/news/story/7005/9689585"}, {"article_id": "9689528", "title": "NBA／柯瑞可能出走、補強無感？勇士老闆闢謠：為了吸引點閱的話題", "summary": "休賽季各隊積極補強，但坐擁超級球星柯瑞（Stephen Curry）的勇士在今夏的「大動作」都以失敗告終，被視為補強無感，甚至出現柯瑞也可能對金洲管理層失去信心的聲音。而對此球隊老闆拉卡柏（Joe Lacob）在一檔節目上給出不同看法外，也回擊外界質疑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227259.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:42", "link": "/news/story/7002/9689528"}, {"article_id": "9689504", "title": "TPBL／受林書豪啟發 林庭謙培養手寫筆記習慣", "summary": "中華隊國手林庭謙正式加盟台北台新戰神隊，今天記者會現場還布置了「Nothing Great Ever Comes Easy 林庭謙生涯印記」展區，展示林庭謙球員生涯具有意義的相關物品，其中紀錄每天訓練心得的手寫筆記本，林庭謙透露是來自「哈佛小子」林書豪的啟發。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227152.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:31", "link": "/news/story/7003/9689504"}, {"article_id": "9689496", "title": "TPBL／早就接觸過林庭謙 戰神總經理透露有旅外條款", "summary": "台北台新戰神隊今天為林庭謙舉行加盟記者會，總經理是林祐廷透露戰神早在創隊第一年就想找「最好球員」加入，當時就有接觸過還在中國CBA的林庭謙，直到今年才終於說服中華隊當家後衛回台，合約裡也有旅外條款，林庭謙若想再旅外挑戰也樂觀其成。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227138.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:28", "link": "/news/story/7003/9689496"}, {"article_id": "9689422", "title": "中職／啦啦隊Mika成樂天第2位「棒籃排三棲」 職排可莉女孩隊史首人", "summary": "職棒樂天桃猿啦啦隊成員Mika又有新身分，成為職排新軍新竹可利工程師首位啦啦隊成員，完成「棒籃排三棲」成就。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227010.jpg&M=1&s=Y&x=0&y=64&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:08", "link": "/news/story/7001/9689422"}, {"article_id": "9689437", "title": "MLB／曾從日職「海歸」大聯盟變強投 37歲國民右投遭DFA", "summary": "過去曾前往日職的37歲老將右投米寇拉斯 （Miles Mikolas）今天遭國民指定讓渡（DFA），並且由農場8號的23歲新秀左投肯特（Jackson Kent）頂替名單位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227046.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:03", "link": "/news/story/6999/9689437"}, {"article_id": "9689419", "title": "MLB／道奇拚重返國聯龍頭 對釀酒人關鍵前兩戰交給朗希、山本", "summary": "大谷翔平今天用全壘打為道奇隊打下江山，3局下面對皇家隊先發左投林奇四世（Daniel Lynch IV）轟出兩分砲，攻下勝利打點，幫助道奇4：2獲勝，明天繼續在主場迎戰釀酒人隊，展開關鍵4連戰，有機會重返國聯龍頭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227133.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 14:57", "link": "/news/story/6999/9689419"}]}, {"name": "棒球", "articles": [{"article_id": "9690402", "title": "中職／張士綸自己「吹」出第2轟 兄弟教頭讚：好表現超出預期", "date": "2026-08-13 23:04", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228566.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9690402"}, {"article_id": "9690251", "title": "中職／高國輝罕見動怒衝上場 動用范國宸+2教練奮力攔住", "date": "2026-08-13 21:03", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228365.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9690251"}, {"article_id": "9690349", "title": "中職／兄弟打線狙擊李東洺 張士綸、高宇杰開轟近8戰拿6勝", "date": "2026-08-13 22:22", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35228496.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&ex