w/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35267207.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9716059"}, {"article_id": "9715886", "title": "從「滾地球王子」到8月全壘打王 小塔提斯大復活的關鍵是什麼？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35266994.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9715886"}, {"article_id": "9713858", "title": "中職／延賽惡夢不斷纏身 單一球季增彈性成解方", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35263941.jpg&M=1&s=Y&x=115&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9713858"}]}, {"name": "最新文章", "articles": [{"article_id": "9722547", "title": "高球／徐薇淩表現震盪繳75桿 LPGA FM錦標賽暫居57名", "summary": "LPGA FM錦標賽今天進行第3回合，台灣唯一參賽的徐薇淩表現震盪，抓2博蒂、吞3柏忌、1次雙柏忌再度繳出75桿，合計3...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_0.jpg", "date": "2026-08-30 11:13", "link": "/news/story/7005/9722547"}, {"article_id": "9722613", "title": "MLB／今井達也轉牛棚9天沒出賽 激勵獎金恐怕全泡湯", "summary": "太空人隊正值13連戰期間，投手戰力吃緊，但至今仍遲遲沒見日籍投手今井達也的身影，轉調牛棚之後，他已9天沒出賽，8月至今只有3場出賽紀錄，太空人隊總教練艾斯帕達（Joe Espada）指出，球團只告訴他「隨時做好準備。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_5.jpg", "date": "2026-08-30 11:11", "link": "/news/story/6999/9722613"}, {"article_id": "9722595", "title": "NBA／灰狼無意交易迪文森佐 跟腱重傷復健中仍盼季末回歸", "summary": "儘管迪文森佐（Donte DiVincenzo）因去年季後賽期間遭遇的阿基里斯腱撕裂傷仍在恢復中，灰狼本季並沒有交易他的計畫。迪文森佐目前進入合約最後一年，本季薪資為1250萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35277192.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-30 10:56", "link": "/news/story/7002/9722595"}, {"article_id": "9722516", "title": "美網／在瑞士山區接獲外卡通知 瓦文卡：心情像坐雲霄飛車", "summary": "41歲的瑞士名將瓦文卡（Stan Wawrinka），生涯最後一場大滿貫心情宛如坐上雲霄飛車，都已從紐約回到瑞士，並做好和大滿貫告別的準備，卻在群山環繞中收到拿到外卡的消息。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35277111.jpg&M=1&s=Y&x=0&y=6&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-30 10:14", "link": "/news/story/121623/9722516"}, {"article_id": "9722477", "title": "美網／大滿貫最後一舞止步會外賽 錦織圭坦言：沒能有最好發揮", "summary": "世界排名最高曾到世界第4的日本「網球王子」錦織圭，今年4月宣布本季結束高掛球鞋，美網成他生涯最後一場大滿貫，他會外雖連過兩關，但最終輪面對同胞坂本憐沒能再進一步，以4：6、6：7（3：7）止步，「最後一舞」無緣會內賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35277034.jpg&M=1&s=Y&x=0&y=0&sw=1237&sh=824&exp=3600&sl=W&fw=360", "date": "2026-08-30 09:44", "link": "/news/story/121623/9722477"}, {"article_id": "9722476", "title": "MLB／李灝宇碰不到了…大谷31日登板取消 道奇教頭曝全身都在痛", "summary": "大谷翔平重返投手丘計畫，確定再次告吹，道奇隊總教練羅伯茲（Dave Roberts）今天賽後證實，大谷的左膝、右二頭肌、全身反覆痠痛，確定不會投周日（台灣時間周一）的比賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35277032.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-30 09:44", "link": "/news/story/6999/9722476"}, {"article_id": "9722424", "title": "MLB／鄧愷威後援1局失2分 代表太空人參賽國歌比誰站得久贏了", "summary": "效力太空人隊的台灣投手鄧愷威，今天在第八局、2：4落後之際登板，未能凍結比分，後援1局被敲3安打、失2分，太空人終場2：6不敵大都會隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35277037.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-30 08:49", "link": "/news/story/6999/9722424"}, {"article_id": "9722409", "title": "MLB／李灝宇1安1盜1保送對道奇秀「技能包」 單季壘打數99逼近張育成", "summary": "台灣好手李灝宇今天扛起老虎隊先發第二棒、三壘手一戰，以本季第90場出賽，突破張育成2021年的89場，締造大聯盟史上台將單季出賽最多紀錄，此役面對道奇隊敲出1安打、1盜壘、1保送，老虎靠麥克尼格（Kevin McGonigle）的再見安打終場2：1險勝道奇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35276922.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-30 08:26", "link": "/news/story/6999/9722409"}, {"article_id": "9722356", "title": "MLB／ 大谷翔平手臂膝蓋不適 教練：絕不為投球犧牲打擊", "summary": "美國職棒大聯盟MLB洛杉磯道奇「二刀流」球星大谷翔平昨天短暫牛棚練投後，手臂與膝蓋仍有不適，本季能否重返投手丘再添疑問", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35277042.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-30 06:17", "link": "/news/story/6999/9722356"}, {"article_id": "9722106", "title": "台灣戰隊CFO擊敗MVKE 壓線挺進英雄聯盟世界大賽", "summary": "英雄聯盟太平洋職業聯賽（LCP）台北決賽週末今天在和平籃球館登場，台灣戰隊CFO在敗部組決賽以3比1力退越南戰隊MVK ...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276550.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 22:05", "link": "/news/story/7005/9722106"}, {"article_id": "9722102", "title": "女子跆拳道公開錦標賽 17歲新星王婕菱奪銀牌", "summary": "在中國太原舉行的女子跆拳道公開錦標賽，名古屋亞運國手王婕菱今天在女子49公斤級金牌戰以0比2不敵中國好手傅曉璐，以銀牌作...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276547.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:58", "link": "/news/story/7005/9722102"}, {"article_id": "9722090", "title": "中職／王苡丞超前3分砲悍將搶勝 兄弟讓出下半季排名首位", "summary": "中職富邦悍將今天與中信兄弟交手，前5局打完2分落後；6局上王苡丞敲出超前比數3分砲，率隊終場以6比4搶勝，兄弟吞敗讓出下...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276541.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:51", "link": "/news/story/7001/9722090"}, {"article_id": "9722089", "title": "中職／梁家榮深遠二壘打以為開轟直呼丟臉：下次會好好注意", "summary": "中職樂天桃猿隊今天與統一7-ELEVEn獅隊交手，4局下突破，梁家榮敲出超前比數二壘打，助隊以8比4搶勝，一開始以為有機...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276538.jpg&M=1&s=Y&x=0&y=81&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:47", "link": "/news/story/7001/9722089"}, {"article_id": "9722101", "title": "中職／黃子鵬從不抱怨火力 洪總：一般洋將早就跳腳", "summary": "台鋼雄鷹隊黃子鵬登板的比賽，往往連自家打線都一起封鎖，今天雄鷹以2：1擊敗味全龍隊賽後，總教練洪一中再次談起對他的歉意，「我看要是一般洋將早就跳腳。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276540.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:45", "link": "/news/story/7001/9722101"}, {"article_id": "9722096", "title": "中職／梁家榮敲致勝長打檢討「應更盡力跑」曾總談桃猿隊史1400勝意義", "summary": "樂天桃猿今天以8：4擊敗統一獅隊，拿下隊史第1400勝，隊長梁家榮在4局下敲出差點出牆的深遠二壘打，替球隊送回超前2分，打下勝利打點，獲選單場MVP。但對於那支關鍵安打，賽後他也坦言有些不好意思，「我應該要更盡全力跑⋯⋯。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276539.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:43", "link": "/news/story/7001/9722096"}, {"article_id": "9722091", "title": "中職／「要輸也要輸在自己手上」 黃子鵬雨中霸氣7局好投殲滅龍隊", "summary": "打到第4局因雨暫停超過1小時，前6局獲得隊友0分火力支援，台鋼雄鷹隊黃子鵬沒有絲毫動搖，堅定完成7局無責失好投，雄鷹靠第七局攻下2分逆轉戰局，終場以2：1擊敗味全龍隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276536.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:37", "link": "/news/story/7001/9722091"}, {"article_id": "9722081", "title": "瓊斯盃／前田領軍對抗日本直言特別 林文佑盼亞運成功復仇", "summary": "瓊斯盃女子組中華藍隊今天在冠軍賽於開賽大幅落後的情況下，於第三節扳平戰局，但最終仍是以9分差距吞下敗仗，以亞軍作收，儘管未能奪下冠軍，但中華藍日籍總教練前田顯藏賽後表示，帶領中華藍出戰日本是一次非常特別的經驗，儘管這次輸球，但她們並沒有失去信心，也期待接下來的亞運能夠打出好表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276515.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:28", "link": "/news/story/7003/9722081"}, {"article_id": "9722071", "title": "中職／桃猿隊史1400勝里程碑 曾總：過程中的細節及成長更重要", "summary": "中職樂天桃猿、統一7-ELEVEn獅今天交手，湧入逾3.6萬人入場，為桃猿本季主場觀眾第2多；桃猿以8比4搶勝、達成隊史...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276513.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:24", "link": "/news/story/7001/9722071"}, {"article_id": "9722078", "title": "中職／後藤的怒火點燃悍將攻勢 王苡丞逆轉3分彈擊落兄弟", "summary": "富邦悍將隊新洋投悍里歐831前最後一戰，今天出戰兄弟繳出先發6局失2分表現，來台連兩戰都是優質先發，靠著王苡丞在6局下的逆轉3分彈一棒定江山，終場悍將以6：4勝出，終止近期2連敗，也將賽前2連勝的兄弟拉下下半季龍頭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276509.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 21:17", "link": "/news/story/7001/9722078"}, {"article_id": "9722052", "title": "瓊斯盃女籃／日本隊五連霸 中華藍九分差落敗", "summary": "瓊斯盃女子冠軍戰今天由中華藍對上日本隊，第一節中華隊進攻當機只拿下四分，半場打完落後打雙位數，第三節中華藍靠著防守頻頻打出轉換快攻，一度追平比數，但最後依然不敵日本隊，以66：75落敗，這也是日本隊在瓊斯盃連續五年獲得冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276462.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 20:32", "link": "/news/story/7003/9722052"}, {"article_id": "9722044", "title": "瓊斯盃／日本5連霸岡本美優獲MVP 韓雅恩、蕭豫玟入選最佳5人", "summary": "瓊斯盃女子組賽事在今天落幕，其中壓軸登場的冠軍賽，日本也在與中華藍激戰中以9分差距取勝，完成賽會5連霸，其中岡本美優獲選大會MVP，並與中華藍韓雅恩、蕭豫玟、南韓李采恩、黎巴嫩瓊斯（Morgan Jones）一同入選大會最佳五人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276457.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 20:22", "link": "/news/story/7003/9722044"}, {"article_id": "9722042", "title": "中職／寫球團史最長得分荒後打擊甦醒 桃猿8：4打退獅隊止敗", "summary": "樂天桃猿隊今天面對統一獅隊，前3局沒有攻下分數，以連續22局沒得分寫下球團史最長局數未得分紀錄，但4局下攻破獅隊洋投喬登，單局打下4分奠定勝基，單場揮出9支安打，終場以8：4擊敗獅隊，終止2連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276455.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 20:20", "link": "/news/story/7001/9722042"}, {"article_id": "9722035", "title": "瓊斯盃／開賽0：12後扳平 中華藍反撲功虧一簣不敵日本亞軍作收", "summary": "瓊斯盃女子組冠軍賽在今天晚間登場，中華藍與日本今天展開激戰攻防，儘管開賽日本一度打出12：0攻勢，但中華藍靠著林文佑、陳晏宇的輪番發揮一度追平，但末節日本又靠著防守壓迫將差距擴大，最終日本仍是以75：66擊敗中華藍，完成瓊斯盃5連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/29/35276450.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-29 20:13", "link": "/news/story/7003/9722035"}, {"article_id": "9721975", "title": "中職／猿隊單局4分把喬登打退場 終結球團史最慘連22局沒得分紀錄", "summary": "樂天桃猿隊歷經連兩戰遭完封後，今天在台北大巨蛋對上統一獅隊，前3局依舊得分掛蛋，以連續22局無得分打破樂天球團史最慘紀錄，然而4局下打線爆發，單局打了10個人次，從喬登手中攻下4分，終結近期得分荒。", "thumbnail