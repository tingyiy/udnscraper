mbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35126168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 13:55", "link": "/news/story/6999/9621431"}, {"article_id": "9621399", "title": "NBA／力壓探花布瑟狂砍35分！公牛第4順位威爾森：我哭了", "summary": "公牛隊選秀首輪第4順位威爾森（Caleb Wilson）今天在夏季聯賽初登場驚豔全場，狂砍35分，這是自2004年拉斯維加斯夏季聯賽開辦以來，球員首秀第2高得分，僅次義大利「斜塔神射」貝藍利（Marco Belinelli）的37分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35126101.jpg&M=1&s=Y&x=0&y=24&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 13:31", "link": "/news/story/7002/9621399"}, {"article_id": "9621387", "title": "MLB／大谷雙刀改單刀 道奇牛棚戰應急還被3E扯後腿不敵響尾蛇", "summary": "原訂先發的大谷翔平投不了，道奇隊啟動牛棚車輪戰，遭響尾蛇隊一口一口吃進肚，道奇終場以3：9慘敗，大谷翔平4打數敲1安打為陽春砲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35126096.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 13:20", "link": "/news/story/6999/9621387"}, {"article_id": "9621364", "title": "MLB／為何點頭參戰全壘打大賽？村上宗隆：大聯盟都邀請了就去吧！", "summary": "村上宗隆今天傷癒回歸大聯盟，5打數敲1安打、吞下4次三振，今天大聯盟同步宣布他遞補進入明星賽及參戰全壘打大賽，村上透露其實很早以前就收到邀請，自己的回覆是「如果傷癒就參加」，他笑說：「既然大聯盟發出了邀請，感覺很難拒絕，而且自己也想著至少要體驗一次。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35126038.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 13:04", "link": "/news/story/6999/9621364"}, {"article_id": "9621330", "title": "MLB／大谷翔平美日通算350轟M1 球迷驚：左膝積水照轟好誇張", "summary": "儘管賽前因左膝不適取消先發登板，但大谷翔平仍是在首局首打席轟出本季第21支全壘打，回應外界對其身體狀態的關注和疑慮，再次展現驚人的身體素質與打擊實力", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125985.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 12:51", "link": "/news/story/6999/9621330"}, {"article_id": "9621116", "title": "世足賽／西班牙4強戰對陣法國 主帥：堪稱決賽前的決賽", "summary": "西班牙今天在世界盃8強戰以2比1淘汰比利時晉級4強，總教練戴拉佛恩特賽後表示，接下來與法國的準決賽堪稱「決賽前的決賽」，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125978.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 12:46", "link": "/news/story/123107/9621116"}, {"article_id": "9621322", "title": "MLB／岡本和真致勝3分砲連兩戰開轟 22轟追平大谷翔平新人紀錄", "summary": "多倫多藍鳥隊今天客場對上聖地牙哥教士隊，日籍重砲岡本和真在5局上轟出一發超前比數的3分全壘打，本季第22轟出爐，追平大谷翔平寫下的日籍球員新人年最多轟紀錄，也敲回致勝一擊，幫助藍鳥以5：3打下三連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125971.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 12:39", "link": "/news/story/6999/9621322"}, {"article_id": "9621289", "title": "MLB／連兩戰炸裂！岡本和真第22轟出爐 追平大谷菜鳥年紀錄", "summary": "藍鳥隊日籍重砲岡本和真今天面對教士轟出本季第22支全壘打，連續兩場比賽開轟，同時這一發全壘打出爐也讓他追平大谷翔平在2018年效力天使隊時所創下的日本球員大聯盟菜鳥球季22支全壘打紀錄，之後有望繼續推高這項紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125939.jpg&M=1&s=Y&x=0&y=55&sw=1076&sh=717&exp=3600&sl=W&fw=360", "date": "2026-07-11 12:21", "link": "/news/story/6999/9621289"}, {"article_id": "9621280", "title": "NBA／加入勇士將證明柯瑞偉大！伊古達拉：恐影響詹姆斯決定", "summary": "杜蘭特（Kevin Durant）當年以「打不贏就加入」方式勇士隊，震驚全聯盟。前勇士球星伊古達拉（Andre Iguodala）指出，10年後詹姆斯（LeBron James）也在考慮類似的轉隊方式。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125932.jpg&M=1&s=Y&x=0&y=0&sw=973&sh=649&exp=3600&sl=W&fw=360", "date": "2026-07-11 12:14", "link": "/news/story/7002/9621280"}, {"article_id": "9621266", "title": "NBA／稱詹姆斯回騎士是最佳劇本 巴克利：去勇士「要擔心成人紙尿褲夠不夠用」", "summary": "休賽季宣布不續留湖人的詹姆斯（LeBron James）目前下家尚未明朗，不過近期傳奇球星「惡漢」巴克利（Charles Barkley）對勇士隨隊記者波爾（Monte Poole）提出「詹皇」的唯一解答就是返回家鄉騎士，且絕不可能前往金州。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125921.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 12:04", "link": "/news/story/7002/9621266"}, {"article_id": "9621155", "title": "世足賽／阿根廷挑戰64年來首度連霸 瑞士瞄準4強新紀錄", "summary": "衛冕軍阿根廷明天將在世界盃足球賽8強與瑞士交手，已經連續11場世界盃比賽不敗的「藍白軍團」阿根廷，正朝1962年巴西後首...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125881.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:58", "link": "/news/story/123107/9621155"}, {"article_id": "9621222", "title": "籃球／籃球博士重返第一線 鄭志龍接掌NBL蘇科雄獅帥印", "summary": "台灣籃壇傳奇「籃球博士」鄭志龍又有新動向，中國大陸NBL（全國男子籃球聯賽）蘇科雄獅球團今天正式官宣，將由鄭志龍出任新賽季總教練，全面負責球隊戰術體系搭建與賽事指揮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125845.jpg&M=1&s=Y&x=39&y=0&sw=1211&sh=808&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:45", "link": "/news/story/7003/9621222"}, {"article_id": "9621189", "title": "世足賽／西班牙亞馬爾和「超美女友」頻放閃！兩人愛情故事很平凡", "summary": "西班牙18歲足球新星亞馬爾（Lamine Yamal）是本屆世足賽觀戰焦點，他的女友賈西亞（Inés García）近日現身球場，因美麗臉蛋受到球迷熱議，賈西亞也談到兩人相識的過程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125787.jpg&M=1&s=Y&x=0&y=247&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:43", "link": "/news/story/123107/9621189"}, {"article_id": "9621194", "title": "世足賽／兩大「神鋒」同場爭金靴 凱恩：希望哈蘭德明天安靜一點", "summary": "2026年世足賽明天將迎來高潮，英格蘭與挪威將在8強賽於邁阿密狹路相逢，不僅要爭奪4強門票，也是兩大金靴獎熱門人選的正面交鋒，英格蘭隊長凱恩（Harry Kane）與挪威「魔人」哈蘭德（Erling Haaland）目前分別踢進6球與7球，讓這場比賽可能成為角逐金靴獎的關鍵戰役。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125776.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:34", "link": "/news/story/123107/9621194"}, {"article_id": "9621171", "title": "NBA／馬刺替補中鋒招募「老詹」爆笑語音流出：我是幾周前被你吼過的人", "summary": "41歲的詹姆斯（LeBron James）休賽季宣布不續留湖人，成為自由球員，讓各球隊積極展開「老詹爭奪戰」，據經紀人保羅（Rich Paul）證實共有多達27支球隊聯繫，其中上賽季闖進總冠軍賽的馬刺替補中鋒柯內特（Luke Kornet）也拋出橄欖枝，本人更流出一段幽默的「招募語音」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125753.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:23", "link": "/news/story/7002/9621171"}, {"article_id": "9621156", "title": "MLB／打的、點的都安打 鄭宗哲連3戰敲雙安打擊率衝破3成", "summary": "紅襪隊儘管受到班機延誤影響，今天賽前不到三小時才抵達球場，但仍以6：2擊敗大都會隊，延續火熱近況拉出7連勝；鄭宗哲此戰先發上陣，擔任游擊手、打第9棒，維持近期的好手感，連續3場比賽敲雙安，打擊率衝破3成。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125720.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:14", "link": "/news/story/6999/9621156"}, {"article_id": "9621134", "title": "世足賽／英格蘭拚終結60年國際大賽冠軍荒 挪威哈蘭德領軍再突破", "summary": "世界盃足球賽8強明天將在邁阿密上演「三獅軍團」英格蘭與「維京海盜」挪威的雙強對決，英格蘭將續朝60年來的第二冠邁進，挪威...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125712.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:13", "link": "/news/story/123107/9621134"}, {"article_id": "9621082", "title": "MLB／鄧愷威傷後復健賽首戰 新人聯盟投1局無失分", "summary": "被放進傷兵名單的美國職業棒球休士頓太空人隊（Houston Astros）27歲投手鄧愷威今天展開復健賽，於新人聯盟先發...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125710.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-11 11:07", "link": "/news/story/6999/9621082"}, {"article_id": "9621117", "title": "NBA／四方交易完成！小鮑爾轉戰灰狼 黃蜂創造破紀錄4千萬美元交易特例", "summary": "西區季後賽第二輪不敵馬刺的灰狼，決定在今年休賽季進行大刀闊斧的陣容重整，接連發動交易包括涉及小鮑爾（LaMelo Ball）、藍道（Julius Randle）、里德（Naz Reid）等主力球員，而後這些交易消息最終正式匯集一筆由灰狼、黃蜂、籃網與公牛四方構成的重磅交易。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125649.jpg&M=1&s=Y&x=248&y=0&sw=1015&sh=677&exp=3600&sl=W&fw=360", "date": "2026-07-11 10:48", "link": "/news/story/7002/9621117"}, {"article_id": "9621114", "title": "世足賽／十字軍團拉警報 瑞士曼贊比因傷缺陣8強對戰阿根廷", "summary": "2026年世足賽8強淘汰賽，力拚隊史首張4強門票的「十字軍團」瑞士卻傳出傷情，總教練雅金（Murat Yakin）證實，小組賽大放異彩的20歲新星、進攻中場曼贊比（Johan Manzambi），因膝蓋傷勢未癒，將缺席明天對決奪冠熱門阿根廷的關鍵大戰，這對瑞士的鋒線無記是一記沉重打擊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125665.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-11 10:44", "link": "/news/story/123107/9621114"}, {"article_id": "9621112", "title": "世足賽／因股四頭肌受傷退場 比利時門將計畫退出國家隊一年", "summary": "比利時今天在8強賽不敵奪冠熱門西班牙，以1：2結束世界盃征程。股四頭肌受傷退場的門將以庫爾圖瓦（Thibaut Courtois）賽後說明傷勢問題外，也含淚宣布未來一年計畫退出國家隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125650.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-11 10:44", "link": "/news/story/123107/9621112"}, {"article_id": "9621108", "title": "NBA／期待聯手狀元迪班薩 楊恩頂薪續約巫師：找到家的歸屬感", "summary": "連3年吞下超過60敗的東區弱旅巫師隊，今年上賽季在陣容上大刀闊斧，不僅透過交易迎來「一內一外」兩大球星戴維斯（Anthony Davis）與楊恩（Trae Young），更在選秀會上幸運挑中新科狀元迪班薩（AJ Dybantsa），今天球團也召開記者會，剛以四年2.12億美元（約台幣68.8億元）的頂薪巨約續留楊恩的楊恩展現新球季直指季後賽的強烈野心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125647.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-11 10:41", "link": "/news/story/7002/9621108"}, {"article_id": "9621084", "title": "亞運棒球／韓媒將台灣視為最大勁敵！也擔心「史上最強日本」", "summary": "名古屋亞運棒球項目公布分組和賽程，中華隊與南韓、香港和泰國同屬B組，韓媒談到中華隊是最大勁敵，也談到日本隊的威脅不容小覷。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125613.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-11 10:38", "link": "/news/story/7001/9621084"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9620998", "title": "世足賽／不懼4強戰高盧雄雞 亞馬爾放話：法國該怕的是西班牙", "date": "2026-07-11 09:54", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125516.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9620998"}, {"article_id": "9621189", "title": "世足賽／西班牙亞馬爾和「超美女友」頻放閃！兩人愛情故事很平凡", "date": "2026-07-11 11:43", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35125787.jpg&M=1&s=Y&x=0&y=247&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/123107/9621189"}, {"article_id": "9621194", "title": "世足賽／兩大「神鋒」同場爭金靴 凱恩：希望哈蘭德明天安靜一點", "date": "2026-07-