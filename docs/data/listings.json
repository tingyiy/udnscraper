ttps://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217245.jpg&M=1&s=Y&x=0&y=0&sw=927&sh=618&exp=3600&w=300", "link": "/news/story/122629/9682402"}]}, {"name": "最新文章", "articles": [{"article_id": "9689744", "title": "MLB／弗里曼重摔慶幸未傷到頭部 賽後侃侃而談笑說個子夠高", "summary": "道奇隊明星一壘手弗里曼（Freddie Freeman）今天8局上為了接界外球，在客隊皇家休息區的階梯不小心滑倒，整個人重摔在地上，讓隊友嚇出一身冷汗，還好身體沒有太大問題，這位36歲老將在賽後記者會還能露出笑容，他說：「本來打算靠在護欄上接球，顯然那裡根本沒有護欄。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_7.jpg", "date": "2026-08-13 17:02", "link": "/news/story/6999/9689744"}, {"article_id": "9689662", "title": "TPBL／高薪沒壓力 林庭謙：目標就是總冠軍", "summary": "結束中國CBA旅外生活返台，中華隊國手林庭謙今天在加盟記者會正式領到0號球衣，成為台北台新戰神隊當家球星的他強調，回台目標就是為戰神打下總冠軍，合約金額不會造成壓力，他笑說：「誇下海口就必須要去實踐，去完成這個目標。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227486.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 16:31", "link": "/news/story/7003/9689662"}, {"article_id": "9689628", "title": "棒球／爭取2028奧運參賽門票 2027年12強賽、6搶1資格賽在台舉辦", "summary": "棒球賽事回歸2028年洛杉磯奧運，中華隊想爭取參賽，剩下兩場國際大賽的機會，中華棒球協會今天宣布，攸關參賽奧運門票的2項賽事，包括明年世界12強賽預、複賽，以及奧運最終資格賽，都將在台北市舉辦。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_0.jpg", "date": "2026-08-13 16:20", "link": "/news/story/7001/9689628"}, {"article_id": "9689594", "title": "MiLB／洋基沃爾普比賽前6球用光2挑戰 球評狠酸：另外27人不開心", "summary": "洋基隊25歲游擊手沃爾普（Anthony Volpe）日前被下放3A，最近加練二壘，今天比賽他前6球就發動2次挑戰全部失敗，遭球評狠酸一波，還在社群平台被瘋傳。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227369.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 16:07", "link": "/news/story/6999/9689594"}, {"article_id": "9689585", "title": "影／全台200名拳擊好手對抗賽競技 基隆國內外賽事成績亮眼", "summary": "基隆拳擊選手近年在國內外賽事表現亮眼，不僅榮獲U15亞洲少年拳擊錦標賽銅牌，也在今年全國中等學校運動會勇奪1銀2銅。「基隆市115年拳擊區域對抗賽」今天在國立基隆高中登場，全台10個縣市20所學校約200名拳擊選手，透過實戰切磋，為基隆拳擊運動發展注入更多活力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227346.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 16:02", "link": "/news/story/7005/9689585"}, {"article_id": "9689528", "title": "NBA／柯瑞可能出走、補強無感？勇士老闆闢謠：這些話題只是想賺點閱", "summary": "休賽季各隊積極補強，但坐擁超級球星柯瑞（Stephen Curry）的勇士在今夏的「大動作」都以失敗告終，被視為補強無感，甚至出現柯瑞也可能對金洲管理層失去信心的聲音。而對此球隊老闆拉卡柏（Joe Lacob）在一檔節目上給出不同看法外，也回擊外界質疑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227259.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:42", "link": "/news/story/7002/9689528"}, {"article_id": "9689504", "title": "TPBL／受林書豪啟發 林庭謙培養手寫筆記習慣", "summary": "中華隊國手林庭謙正式加盟台北台新戰神隊，今天記者會現場還布置了「Nothing Great Ever Comes Easy 林庭謙生涯印記」展區，展示林庭謙球員生涯具有意義的相關物品，其中紀錄每天訓練心得的手寫筆記本，林庭謙透露是來自「哈佛小子」林書豪的啟發。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227152.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:31", "link": "/news/story/7003/9689504"}, {"article_id": "9689496", "title": "TPBL／早就接觸過林庭謙 戰神總經理透露有旅外條款", "summary": "台北台新戰神隊今天為林庭謙舉行加盟記者會，總經理是林祐廷透露戰神早在創隊第一年就想找「最好球員」加入，當時就有接觸過還在中國CBA的林庭謙，直到今年才終於說服中華隊當家後衛回台，合約裡也有旅外條款，林庭謙若想再旅外挑戰也樂觀其成。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227138.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:28", "link": "/news/story/7003/9689496"}, {"article_id": "9689422", "title": "中職／啦啦隊Mika成樂天第2位「棒籃排三棲」 職排可莉女孩隊史首人", "summary": "職棒樂天桃猿啦啦隊成員Mika又有新身分，成為職排新軍新竹可利工程師首位啦啦隊成員，完成「棒籃排三棲」成就。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227010.jpg&M=1&s=Y&x=0&y=64&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:08", "link": "/news/story/7001/9689422"}, {"article_id": "9689437", "title": "MLB／曾從日職「海歸」大聯盟變強投 37歲國民右投遭DFA", "summary": "過去曾前往日職的37歲老將右投米寇拉斯 （Miles Mikolas）今天遭國民指定讓渡（DFA），並且由農場8號的23歲新秀左投肯特（Jackson Kent）頂替名單位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227046.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 15:03", "link": "/news/story/6999/9689437"}, {"article_id": "9689419", "title": "MLB／道奇拚重返國聯龍頭 對釀酒人關鍵前兩戰交給朗希、山本", "summary": "大谷翔平今天用全壘打為道奇隊打下江山，3局下面對皇家隊先發左投林奇四世（Daniel Lynch IV）轟出兩分砲，攻下勝利打點，幫助道奇4：2獲勝，明天繼續在主場迎戰釀酒人隊，展開關鍵4連戰，有機會重返國聯龍頭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227133.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 14:57", "link": "/news/story/6999/9689419"}, {"article_id": "9689350", "title": "MLB／「卡仔」生涯百轟里程碑達標 創超狂長打紀錄成史上第3人", "summary": "響尾蛇台美混血球星「卡仔」卡洛爾（Corbin Carroll）今天在對陣落磯的比賽中，用一記陽春砲進帳本季第18轟外，也達標大聯盟生涯百轟的里程碑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226875.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 14:32", "link": "/news/story/6999/9689350"}, {"article_id": "9689338", "title": "TPBL／穿上父親冠軍西裝 林庭謙領戰神球衣立誓拚總冠軍", "summary": "「台北，我回來了！」中華隊核心主力後衛林庭謙今天正式加盟台北台新戰神，他特別穿上已逝父親「小羊哥」林正明HBL首冠的西裝，希望將父親的好運延續到新東家戰神，立誓為戰神帶回一座總冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226978.jpg&M=1&s=Y&x=0&y=86&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-13 14:23", "link": "/news/story/7003/9689338"}, {"article_id": "9689309", "title": "日職／「3勝、防禦率0.92」奪7月二軍MVP 張峻瑋：沒想過會拿到", "summary": "日本職棒今天公布7月二軍MVP，軟銀鷹隊20歲台灣火球男張峻瑋單月3勝，防禦率0.92，奪下西區MVP，這是他生涯首度獲獎。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226780.jpg&M=1&s=Y&x=169&y=33&sw=818&sh=545&exp=3600&sl=W&fw=360", "date": "2026-08-13 14:17", "link": "/news/story/7001/9689309"}, {"article_id": "9689295", "title": "MLB／弗里曼追球摔進休息區 道奇教頭：我們真是躲過一劫", "summary": "道奇隊今天靠大谷翔平3局下兩分砲打下江山，在洛杉磯主場以4：2擊敗皇家隊，完成3連戰橫掃，但明星一壘手弗里曼（Freddie Freeman）8局上為了接界外球，失足摔進客隊休息區，讓現場所有人嚇出一身冷汗，這位36歲老將也在8局下退場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226764.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 14:11", "link": "/news/story/6999/9689295"}, {"article_id": "9689224", "title": "路跑／免費16周疾速訓練營 號召跑者突破自我", "summary": "延續不斷突破的跑步精神，Nike連續第三年推出「NRC疾速訓練營」訓練計畫，今年預計招募10位跑者展開為期16周的馬拉松專項訓練，結合NRC與NTC專業團隊，從訓練計畫、跑步技術、營養補給到運動傷害防護，陪伴跑者以更完整的準備，迎戰年底的馬拉松賽事，以個人最佳紀錄衝過終點線。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226619.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 13:44", "link": "/news/story/7005/9689224"}, {"article_id": "9689195", "title": "NBA／發長文恭喜衛少退休！林書豪：重新定義控球後衛", "summary": "「大三元製造機」衛斯特布魯克（Russell Westbrook）今天宣布退休，結束18年職業生涯，令許多球迷感到不捨。去年退休的「哈佛小子」林書豪也在社群平台向這位傳奇致敬。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226539.jpg&M=1&s=Y&x=381&y=146&sw=736&sh=490&exp=3600&sl=W&fw=360", "date": "2026-08-13 13:35", "link": "/news/story/7002/9689195"}, {"article_id": "9689160", "title": "排球／直落三退委內瑞拉 中華隊U17世青賽勇闖8強", "summary": "中華女排隊今天迎接2026年世界U17女子排球錦標賽16強賽，面對委內瑞拉隊以25：21、25：19、25：22直落三奪勝，強勢挺進8強，下戰將於15日清晨5點對上泰國隊，全力爭取 4 強門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226487.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-13 13:26", "link": "/news/story/7005/9689160"}, {"article_id": "9689049", "title": "MLB／大谷第27轟成為致勝一擊 道奇主場3連戰橫掃皇家", "summary": "大谷翔平今天重現全壘打砲火，對皇家隊之戰3局下轟出兩分砲，本季第27轟成為致勝一擊，道奇終場以 4：2獲勝，在洛杉磯主場完成3連戰橫掃，皇家吞下4連敗，本季第10個系列賽遭清盤是大聯盟最慘紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226347.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 12:53", "link": "/news/story/6999/9689049"}, {"article_id": "9688990", "title": "MLB／投手大谷封印1個多月迎好消息！道奇總仔：復健賽就是大聯盟", "summary": "道奇日籍好手大谷翔平睽違1個多月終於有機會回歸投手丘，在今天對陣皇家的賽前受訪中，總仔羅伯茲（Dave Roberts）表示子弟兵近期已進行傳接球訓練及牛棚模擬投球，並且復健賽會直接在大聯盟賽場進行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226257.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 12:25", "link": "/news/story/6999/9688990"}, {"article_id": "9688947", "title": "NBA／詹姆斯讚衛少下一站名人堂 「打不贏就加入」的KD仍未發聲", "summary": "「大三元製造機」衛斯特布魯克（Russell Westbrook）今天在社群平台宣布退休，詹姆斯（LeBron James）等籃壇球星都留言致敬，雷霆隊時期的搭檔杜蘭特（Kevin Durant）至今仍未發聲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226206.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-13 12:16", "link": "/news/story/7002/9688947"}, {"article_id": "9688863", "title": "MLB／岡本和真致勝安助藍鳥3連勝 紅襪大起大落9連勝後5連敗", "summary": "岡本和真8局下關鍵安打攻下超前分，帶動藍鳥隊這半局5分攻勢，終場以6：4擊敗紅襪隊，不但在多倫多主場搶下4連戰前3勝，也讓紅襪吞下5連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226078.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:47", "link": "/news/story/6999/9688863"}, {"article_id": "9688822", "title": "NBA／雷霆總管讚衛少是球團根基！效力過球隊僅「湖人」未致敬", "summary": "現年37歲的「大三元製造機」衛斯特布魯克（Russell Westbrook）今天在社群平台宣布退休，雷霆總管普雷斯帝（Sam Presti）發聲明向衛少致敬，衛少待過的球團也發聲致敬，獨缺湖人隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226002.jpg&M=1&s=Y&x=0&y=157&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:38", "link": "/news/story/7002/9688822"}, {"article_id": "9688803", "title": "NBA／衛少拒絕老東家報價後退休 經紀人諷球員工會：沒人簽老將", "summary": "前MVP「忍者龜」衛斯特布魯克（Russell Westbrook）今天在社群宣布退休，結束18年職業征程。而根據《ESPN》知名記者查拉尼亞（Shams Charania）報導，這位37歲老將其實不是「無球可打」，而是自願拒絕球隊報價選擇退休。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225994.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:30", "link": "/news/story/7002/9688803"}]}, {"name": "棒球", "article