ary": "愛知名古屋亞運中華代表團9月21日進帳首金，余凱文、黃詩媛在軟式網球混合雙打奪金，其中余凱文在22日晚間登上「ONE ASIA WORLD」舞台，成為首位踏上該舞台的非日本籍選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35355401.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 11:16", "link": "/news/story/124981/9772523"}, {"article_id": "9772301", "title": "足球／稱足球是男性運動還抓女裁判手 美足大聯盟二軍教練遭鍘", "summary": "美國職業足球大聯盟（MLS）哥倫布機組員隊今天表示，已開除旗下二隊阿根廷籍教練伊瓜因。原因是他對一名女性裁判說「別忘了，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35355386.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-23 11:12", "link": "/news/story/7005/9772301"}, {"article_id": "9772367", "title": "亞運卡巴迪／中華隊上演逆轉秀 扳倒韓國勝場開胡", "summary": "台灣男子卡巴迪代表隊今天靠著下半場最後5分43秒內一波9比3攻勢，成功以43比37逆轉擊敗韓國，也如願在名古屋亞運卡巴迪...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35355373.jpg&M=1&s=Y&x=0&y=87&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 11:09", "link": "/news/story/124981/9772367"}, {"article_id": "9772430", "title": "亞運男籃／生涯最後亞運卻失望作結 胡瓏貿：心裡最寒冷的一次", "summary": "中華男籃在名古屋亞運8強戰以78：85不敵地主隊日本，無緣連3屆闖進4強，陣中老大哥「龍貓」胡瓏貿日前也在社群發文寫下「真心話」，回顧15年的國家隊生涯。他表示自己在這段時間從未後悔，但也痛批這次披上中華隊戰袍是「心裡最寒冷的一次」，對許多安排感到失望與心寒，直到運動部長李洋關心才感受到溫暖。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35355324.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 10:48", "link": "/news/story/124981/9772430"}, {"article_id": "9772329", "title": "MLB／李灝宇敲1安選到2次保送 一度因揮棒腳部不適", "summary": "美國職棒大聯盟（MLB）底特律老虎隊台灣好手李灝宇今天先發出賽，3度上壘包括敲出1支安打、選到2次四壞保送；老虎隊終場以...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35355092.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-23 10:23", "link": "/news/story/6999/9772329"}, {"article_id": "9772296", "title": "亞運空手道／銅牌戰不敵香港 男子團體型錯過頒獎台", "summary": "空手道成為名古屋亞運中華代表團「獎牌庫」，今天最終日賽程差點再獎牌入袋，杜承翰、李翔軒和張雲翔闖關男子團體型銅牌戰，可惜最終戰和香港隊的對決以2：3敗陣，錯過登上頒獎台的機會。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35355048.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 10:11", "link": "/news/story/7005/9772296"}, {"article_id": "9772192", "title": "亞運桌球／林昀儒/鄭怡靜13分鐘速勝 16強要強碰日本組合", "summary": "名古屋亞運桌球賽事今天持續進行，其中在混雙32強賽，我國搭擋林昀儒／鄭怡靜，面對吉爾吉斯組合，以秋風掃落葉之姿，僅花13分鐘就以11：7、11：4、11：4直落三勝出，晉級到16強賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35354979.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 09:39", "link": "/news/story/124981/9772192"}, {"article_id": "9772126", "title": "亞運田徑／男子競走羅聖欽、詹泳逵完賽 中國大陸奪隊史第200金", "summary": "名古屋亞運田徑賽事在今天點燃戰火，今天一早就由半程馬拉松競走率先鳴槍，在男子組賽事最終我國兩名參賽選手羅聖欽、詹泳逵，最終分別以1小時35分20秒與1小時41分48秒排名第6、8名作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35354874.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-23 09:13", "link": "/news/story/124981/9772126"}, {"article_id": "9772114", "title": "亞運田徑／初體驗走出第6名！17歲競走新星羅聖欽累積經驗", "summary": "名古屋亞運田徑賽程今天點燃戰火，去年兩度打破我國U18男子5000公尺競走全國紀錄的17歲小將羅聖欽也迎接亞運初體驗，他和隊友詹泳逵在男子半程馬拉松競走出賽，羅聖欽以1小時35分20秒排名第6，詹泳逵以1小時41分48秒排名第8，雙雙完賽完成任務。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35354749.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 09:10", "link": "/news/story/124981/9772114"}, {"article_id": "9770767", "title": "日職／落合博滿後等了40年 羅德本土30轟大砲為何遲遲難產？", "summary": "山口航輝單季敲出30轟，終結羅德本土重砲40年空窗；文章指出，球場、訓練資源與經營方針，是本土重砲難產的長期因素，也影響頂尖球星培育。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35353051.jpg&M=1&s=Y&x=57&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-23 07:00", "link": "/news/story/122629/9770767"}, {"article_id": "9771669", "title": "亞運／單日三銅！亞運頻傳捷報 空手道、武術雙奪牌", "summary": "中華空手道代表隊在名古屋亞運頻傳捷報，繼日前簡慧萱、石政中接連進帳銅牌後，昨天女子型團體賽再由簡慧萱帶領學妹田欣兒、洪芷暄出征，銅牌戰以五比○完勝尼泊爾。鍾孟宇也在男子對打八十四公斤銅牌戰藉由「先取」優勢險勝印度對手，雙雙登上頒獎台。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354240.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-23 00:00", "link": "/news/story/124981/9771669"}, {"article_id": "9771673", "title": "亞運武術／男子南拳南棍 劉菖閔奪銅圓夢 「對自己有交代」", "summary": "中華武術隊連續兩天在名古屋亞運奪牌，劉菖閔昨天在男子南拳南棍全能項目穩定發揮，個人第二屆也可能是最後一次的亞運收下銅牌，這是中華代表團本屆第五銅；他的好友黃文聖靠著南棍衝高分數，但最終以千分之一分的差距無緣頒獎台，排名第四。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354272.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-23 00:00", "link": "/news/story/124981/9771673"}, {"article_id": "9771669", "title": "亞運／單日三銅！亞運頻傳捷報 空手道、武術雙奪牌", "summary": "中華空手道代表隊在名古屋亞運頻傳捷報，繼日前簡慧萱、石政中接連進帳銅牌後，昨天女子型團體賽再由簡慧萱帶領學妹田欣兒、洪芷暄出征，銅牌戰以五比○完勝尼泊爾。鍾孟宇也在男子對打八十四公斤銅牌戰藉由「先取」優勢險勝印度對手，雙雙登上頒獎台。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354240.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-23 00:00", "link": "/news/story/124981/9771669"}, {"article_id": "9771611", "title": "亞運／台灣夜市名古屋看得到！TEAM TPE HOUSE傳遞寶島文化", "summary": "名古屋亞運賽事正如火如荼展開，中華奧林匹克委員會於名古屋打造的「TEAM TPE HOUSE」今天在奧會主席蔡家福、運動部部長李洋、名古屋亞運籌備會代理秘書長中森康弘等人致詞歡迎下正式開幕，邀請來自國際奧會、亞洲奧會及各國奧會主席及秘書長、各國際運動組織代表等齊聚交流，在賽事之外，透過台灣文化、音樂與原住民族表演，展現多元魅力，也讓TEAM TPE HOUSE成為中華隊在競技場域之外的另一個重要據點，以熱情接待來自各國重要賓客以及本次所有代表團成員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354211.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 22:49", "link": "/news/story/124981/9771611"}, {"article_id": "9771584", "title": "中職／兄弟「無助」後首度8連勝 24日有望亮燈季冠軍魔術數字", "summary": "中信兄弟隊的連勝之旅，今天在新莊棒球場遭遇嚴峻考驗，富邦悍將隊九局下孔念恩敲兩分打點二壘打追平續命，以8：8逼進延長，兄弟10局上只攻下1分，10局下蔡齊哲滿壘解決范國宸、申皓瑋，幫助兄弟驚險以9：8贏球，推進8連勝，24日若在桃園棒球場擊敗樂天桃猿隊，就將點亮下半季封王魔術數字M6。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354182.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 22:36", "link": "/news/story/7001/9771584"}, {"article_id": "9771560", "title": "籃球／大專男子組4強出爐 國體大與政大登峰造極4強上演UBA冠軍賽戲碼", "summary": "大專男子組4強出爐，國體大與政大重演UBA冠軍賽戲碼，上海交大晉級，虎尾科大爭另一決賽席次；文化大學女籃3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354157.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 22:29", "link": "/news/story/7003/9771560"}, {"article_id": "9771545", "title": "中職／龍隊猛攻13分打爆獅隊 陳鏞基引退賽後還有彩蛋首度投手登板", "summary": "近10戰狂吞8敗的味全龍隊，今天打出久違的狂龍氣勢，全場20支安打，兩波單局10人次的猛攻，終場以13：1慘電統一獅隊，比分差距大到獅隊九局上推出陳鏞基投球，在引退賽之後再端彩蛋。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354114.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 22:07", "link": "/news/story/7001/9771545"}, {"article_id": "9771412", "title": "亞運／23日中華隊熱戰 李孟遠定向飛靶拚冠、軟網再衝金", "summary": "中華代表隊明天在名古屋亞運繼續熱戰，男子定向飛靶好手李孟遠，前2天資格高居第3，有機會站上頒獎台甚至拚金；今年氣勢如虹的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354069.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 21:57", "link": "/news/story/7003/9771412"}, {"article_id": "9771343", "title": "亞運卡巴迪／中華女子隊強勢表現 首戰狂勝斯里蘭卡", "summary": "今年瞄準亞運隊史首金的中華女子卡巴迪代表隊，今天在名古屋亞運分組預賽首戰面對斯里蘭卡，上半場就取得31比9大幅領先，終場...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354068.jpg&M=1&s=Y&x=0&y=0&sw=1166&sh=777&exp=3600&sl=W&fw=360", "date": "2026-09-22 21:54", "link": "/news/story/124981/9771343"}, {"article_id": "9771512", "title": "亞運武術／掌旗官張煥宜散打晉級4強 至少銅牌入袋", "summary": "名古屋亞運我國開幕式掌旗官張煥宜，今天在武術散打75公斤級8強賽登場，面對塔吉克選手胡爾舍德佐達（Mirzodalerkhan Khurshedzoda），最終以2：0取勝，順利挺進到4強賽，由於散打不設有銅牌戰，成績將從銅牌起跳。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354061.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 21:50", "link": "/news/story/124981/9771512"}, {"article_id": "9771460", "title": "亞運桌球／林昀儒扮演定心丸 教練盛讚找回信心", "summary": "名古屋亞運桌球中華男子團體今天8強戰以3比0橫掃伊朗、確定保底銅牌，教練王翊澤認為，林昀儒已經把自信心、態度找回來，外界...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35354042.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 21:39", "link": "/news/story/124981/9771460"}, {"article_id": "9771449", "title": "亞運棒球／中華隊戰香港拚2連勝 台電投手郭子銓先發", "summary": "名古屋亞運棒球預賽，中華隊明天第三戰將在台灣時間晚間5點30分對上香港，力拚二連勝挺進超級循環賽，先發投手揭曉，由業餘球隊台電投手郭子銓先發上陣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35353969.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-22 20:58", "link": "/news/story/124981/9771449"}, {"article_id": "9771394", "title": "中職／是真的！桃猿單局2全壘打+2三壘打 締造聯盟空前紀錄", "summary": "本季長打率在聯盟排名墊底的樂天桃猿隊，今天打出空前紀錄，第二局單局2支全壘打、2支三壘打，在中職史上過去還不曾出現過，馬傑森、林承飛、林政華、威克聯手締造神跡。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/22/35353941.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-22 20:22", "link": "/news/story/7001/9771394"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9772192", "title": "亞運桌球／林昀儒/鄭怡靜13分鐘速勝 16強要強碰日本組合", "date": "2026-09-23 09:39", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35354979.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9772192"}, {"article_id": "9772430", "title": "亞運男籃／生涯最後亞運卻失望作結 胡瓏貿：心裡最寒冷的一次", "date": "2026-09-23 10:48", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35355324.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9772430"}, {"article_id": "9772114", "title": "亞運田徑／初體驗走出第6名！17歲競走新星羅聖欽累積經驗", "date": "2026-09-23 09:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.p