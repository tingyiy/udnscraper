e": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35420333.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9814666"}, {"article_id": "9814618", "title": "棒球／鄭乃介接任高苑教頭首重態度 完成父親未竟之夢", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/14/35420223.jpg&M=1&s=Y&x=0&y=106&sw=1169&sh=779&exp=3600&w=300", "link": "/news/story/122629/9814618"}]}, {"name": "最新文章", "articles": [{"article_id": "9823447", "title": "籃球／U19聯盟 U10冠軍長大開季2連勝 鷺江國小李曜宇學偶像SGA變奏", "summary": "福康文教基金會主辦的U19籃球聯盟2026-27年賽季，18日U12第4組在台灣師範大學公館校區進行，LJES隊以40：30擊敗Gladiators（角鬥士）隊，拿下開季2連勝，證明他們的冠軍身手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433610.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:54", "link": "/news/story/7003/9823447"}, {"article_id": "9823391", "title": "MLB／光芒晉級世界大賽機率達8成 守護者陷入2勝3敗從未翻盤", "summary": "光芒隊作客克里夫蘭，今天又以3：1擊敗守護者隊，帶著客場2勝1敗回到佛州坦帕灣，明天將在美聯冠軍賽第6戰推出培洛塔（Freddy Peralta）登板先發，全力爭取近6年首張世界大賽門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433565.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:42", "link": "/news/story/6999/9823391"}, {"article_id": "9823357", "title": "NBA／熱身賽慘變「1成湯」！湯普森外線20投3中不擔心：例行賽回歸4成", "summary": "擁有4座NBA總冠軍的神射手湯普森（Klay Thompson），在今年休賽季轉戰熱火後，原被期待成為球隊重要的外線火力，沒想到熱身賽卻陷入嚴重投籃低潮，4場比賽三分球合計20投僅3中，命中率低至15％。不過，面對外界質疑，湯普森卻強調季前賽成績並不重要，更有信心在例行賽找回昔日準星。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433468.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:39", "link": "/news/story/7002/9823357"}, {"article_id": "9823375", "title": "匹克球／雙向奔赴的國手夢 聽障好手邱弈偉用匹克球扭轉人生", "summary": "由台灣職業匹克球大聯盟（TMLP）舉辦的2026台灣匹克球積分巡迴賽最終站17、18日在新北市林口高中舉行，這項近年掀起全球浪潮的運動不僅老少咸宜，也適合各種族群。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433483.jpg&M=1&s=Y&x=0&y=0&sw=1187&sh=791&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:36", "link": "/news/story/7005/9823375"}, {"article_id": "9823315", "title": "中職／中信兄弟絕處逢生 張士綸、張仁瑋是Key Man", "summary": "台灣大賽前兩戰味全龍先以3：0完封勝中信兄弟，再以3：1勝出，目前味全龍2戰全勝，歷史數據顯示，最終封王機率高達9成，不過系列賽還沒結束，只要中信兄弟攻擊火力復甦，特別是前兩棒張士綸和張仁瑋，後續賽事依舊大有可為。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433450.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:30", "link": "/news/story/122629/9823315"}, {"article_id": "9823341", "title": "棒球／運科輔助再升級添大聯盟味 豪華教練團攜旅美雙星扎根基層棒球", "summary": "由錫卿文教基金會、秀傳醫療體系與阿斯貝克運動科技共同主辦的「阿斯貝克青棒訓練營」，16日在彰化八卦山棒球場熱血登場。活動以「公益傳承，夢想永續」為核心，號召彰化高中、彰化藝高、政大、高雄三民高中及桃園大溪高中等80位棒球小將齊聚一堂。開訓典禮貴賓雲集，錫卿文教基金會高專朱玉珊、彰化高中校長程彥森、彰化藝術高中校長林吟馨、彰化市長專員李吉發，以及國體大棒球隊教練林衛宣、大聯盟球探教練馬熙傑、洛杉磯道奇隊體系旅美好手柯敬賢與舊金山巨人隊體系李晨薰等人皆親自出席力挺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433447.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:26", "link": "/news/story/7001/9823341"}, {"article_id": "9823338", "title": "NBA／主戰中鋒肩膀動刀 太陽先和24歲長人續約3年", "summary": "太陽隊中鋒伊戈達羅（Oso Ighodaro）開季前先搞定續約，他的經紀人魯伊斯（Erika Ruiz）告訴美國《ESPN》，伊戈達羅已經同意一紙3年2900萬美元的續約，合約期程從2028到29年賽季開始，將到2030到31年賽季。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433476.jpg&M=1&s=Y&x=111&y=45&sw=1169&sh=779&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:24", "link": "/news/story/7002/9823338"}, {"article_id": "9823279", "title": "MLB／梅西克太操產生負面影響？守護者終結78年冠軍荒難度高", "summary": "守護者隊今天在主場以1：3不敵光芒隊，25歲先發左投梅西克（Parker Messick）只投兩局失兩分吞敗，創下生涯兩年先發局數最短紀錄，守護者在美聯冠軍賽2勝3敗已無退路，能否結束長達78年未奪世界大賽冠軍的噩夢值得觀察。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433384.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 10:02", "link": "/news/story/6999/9823279"}, {"article_id": "9823243", "title": "MLB／光芒王牌拉穆森狂飆11連勝 若有下次登板就是世界大賽", "summary": "光芒隊今天在美聯冠軍賽第5戰以3：1擊敗守護者隊，王牌投手拉穆森（Drew Rasmussen）先發7局只失1分，成為贏球最大功臣；光芒從7月22日以來，在拉穆森登板先發的15場比賽拿下14勝，他也成為隊史唯一在季後賽至少兩次先發、單場投滿7局最多失1分的投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433348.jpg&M=1&s=Y&x=101&y=34&sw=1179&sh=786&exp=3600&sl=W&fw=360", "date": "2026-10-19 09:49", "link": "/news/story/6999/9823243"}, {"article_id": "9823244", "title": "NBA／勇士驚魂！柯瑞訓練時扭傷右腳踝 幸無大礙", "summary": "NBA新賽季即將開打，勇士隊當家球星柯瑞（Stephen Curry）今天球隊訓練卻扭到右腳踝，一拐一拐回到休息室，好消息是總教練柯爾（Steve Kerr）表示傷勢不是太嚴重。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433345.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 09:49", "link": "/news/story/7002/9823244"}, {"article_id": "9823242", "title": "NBA／西蒙斯太悲情........準備復出卻傷阿基里斯腱", "summary": "好不容易要重返球場，國王隊後衛西蒙斯（Ben Simmons）卻在開季前受到重創，國王今天公告西蒙斯在練習時阿基里斯腱撕裂，將進行手術，本季還沒開始就可能告終。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433336.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 09:49", "link": "/news/story/7002/9823242"}, {"article_id": "9823074", "title": "MLB／拉穆森領軍光芒ALCS聽牌 離隊史第3座美聯冠軍只差1勝", "summary": "光芒隊王牌投手拉穆森（Drew Rasmussen）今天先發7局只失1分，在美聯冠軍賽（ALCS）第5戰有效壓制守護者隊，優質表現領軍光芒以3：1奪下重要勝利，系列賽3勝2敗「聽牌」，離隊史第3座美聯冠軍只差最後一勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/19/35433328.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 08:19", "link": "/news/story/6999/9823074"}, {"article_id": "9822455", "title": "日職／橫濱力求二度下剋上軟銀 新仇舊恨火花多", "summary": "橫濱DeNA季後賽6連勝晉級日本一總冠軍賽，將再戰軟銀，力求重演2024年下剋上奇蹟；兩隊球員交易也添新仇舊恨話題。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432288.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-19 07:00", "link": "/news/story/122629/9822455"}, {"article_id": "9822613", "title": "2026全球極限體能鋼鐵大賽圓滿落幕 近十萬人次共襄盛舉國際菁英齊聚台中", "summary": "2026全球極限體能鋼鐵大賽於台中落幕，吸引近十萬人次、逾10國近3,000名選手參與，俄羅斯隊奪菁英冠軍，台灣隊獲第7名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432412.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:30", "link": "/news/story/7005/9822613"}, {"article_id": "9822602", "title": "運動部長李洋證件「被變更」 表達不滿缺席亞帕運開幕式", "summary": "愛知名古屋亞洲帕拉運動會今晚舉行開幕式，運動部長李洋卻沒有出現在貴賓席。運動部今天聲明表示，因為部長的識別證臨時被變更，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432409.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:16", "link": "/news/story/7005/9822602"}, {"article_id": "9822586", "title": "中職／從沒想過總冠軍賽開轟當英雄 曾聖安緊張到手腳都抽筋", "summary": "味全龍隊20歲外野手曾聖安生涯首次在總冠軍賽亮相，今天在第2戰先發上陣，緊張到全身抽筋，但寫下戲劇性的劇本，失誤後下個打席敲出超前3分砲，轟破隊史最年輕紀錄，也打下他生涯最印象深刻的一轟。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432388.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:03", "link": "/news/story/7001/9822586"}, {"article_id": "9822580", "title": "中職／賽後解析「頂級投手論」 平野惠一眼中有兩種類型", "summary": "中信兄弟隊今天以1：3不敵味全龍隊，前兩戰在洋投對決中都敗下陣來，兄弟教頭平野惠一賽後接受15分鐘聯訪，也分析了自己心中的「頂級投手論」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432384.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:00", "link": "/news/story/7001/9822580"}, {"article_id": "9822572", "title": "TPVL／漢佳單場獨攬14分領軍 天鷹直落三奪賽季首勝", "summary": "漢佳轟下全場最高14分並發出2記ACE，率台鋼天鷹主場28:26、25:13、25:23直落三擊敗臺北伊斯特，收下賽季首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432383.jpg&M=1&s=Y&x=0&y=0&sw=912&sh=608&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:58", "link": "/news/story/7005/9822572"}, {"article_id": "9822559", "title": "中職／兄弟2戰只拿1分、雙箭頭16支0 平野曝面對頂級洋投難處", "summary": "中信兄弟隊打完台灣大賽前兩戰陷入0勝2敗，合計只拿1分，談到打線熄火，總教練平野惠一吐露面對頂級投手的難處，「希望大家可以理解，對方不是隨便就會失分的投手。」雙箭頭張仁瑋、張士綸前兩戰合計16支0，平野盼他們透過這兩場的學習，更了解自己的任務。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432368.jpg&M=1&s=Y&x=0&y=0&sw=1224&sh=816&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:47", "link": "/news/story/7001/9822559"}, {"article_id": "9822558", "title": "中職／菲力士從隊友變成敵人 梅賽鍶奪勝後擔心他的強襲球腿傷", "summary": "味全龍隊洋投梅賽鍶今天先發6局失1分，優質表現奪下生涯總冠軍賽首勝，幫助龍隊以3：1擊敗中信兄弟隊，他說：「感覺很棒，雖有失分但壓制在1分，隊友打擊很好，後面打得回來，自己和捕手蔣少宏搭配好，順利拿下勝投。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432351.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:44", "link": "/news/story/7001/9822558"}, {"article_id": "9822552", "title": "中職／賽前給曾聖安信心「搞不好你會全壘打」 葉總讚子弟兵長大了", "summary": "味全龍隊在總冠軍賽首戰贏球後，今天第二戰考量對戰數據後大膽變陣，讓20歲外野手曾聖安扛先發第9棒，儘管5局守備失誤「繳學費」，卻在下半局敲致勝3分砲成致勝英雄，賽後葉君璋雖稱讚他「長大了」，但也要大家「不要太舒服他」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432342.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:36", "link": "/news/story/7001/9822552"}, {"article_id": "9822535", "title": "中職／「連俊秀這種老將也會發生miss」平野惠一提出反思", "summary": "中信兄弟隊在總冠軍賽第二戰握有短暫的1：0領先，下半局就見失守，陳俊秀的失誤，最終釀成失分，遭曾聖安的三分砲逆轉戰局，總教練平野惠一坦言，在短期比賽裡，碰到雙方都是頂級投手的比賽，一個miss就會顯得很關鍵，今天這場比賽就驗證了這件事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432307.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:27", "link": "/news/story/7001/9822535"}, {"article_id": "9822515", "title": "TPBL／送狀元賀丹職業首敗 馬建豪：歡迎來到TPBL", "summary": "TPBL衛冕軍福爾摩沙夢想家，開季兩場比賽都打得驚天動地，昨天開季首戰和新北國王激戰到延長賽吞敗，今天碰高雄全家海神從最多20分落後到1分逆轉，驚險以115：114守護主場，也讓海神今年的選秀會「狀元」賀丹錯過職業賽首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432281.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:15", "link": "/news/story/7003/9822515"}, {"a