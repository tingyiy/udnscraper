id": "9689680", "title": "控衛「總統山」有四個不動傳奇 無冕王衛少足以列名史上前五", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35229289.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9689680"}, {"article_id": "9687416", "title": "中職／江少慶、林岱安互換結局均不如預期 悍將、獅隊雙輸？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224197.jpg&M=1&s=Y&x=0&y=142&sw=930&sh=620&exp=3600&w=300", "link": "/news/story/122629/9687416"}, {"article_id": "9687689", "title": "去年塞揚史肯斯本季大幅衰退 原來原因這麼多！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9687689"}, {"article_id": "9684672", "title": "日職／林安可手感正好卻受傷 西武死守A段班傷兵潮來得不是時候", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/31/34815827.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684672"}]}, {"name": "最新文章", "articles": [{"article_id": "9697513", "title": "合庫、土銀支持選手轉型 退役國手變經理", "summary": "公股行庫長年支持球隊，並且提供球員轉型為銀行員的管道，以合庫、土銀為例，相關制度已運作超過四十年。合庫負責培訓的主管觀察，選手的忠誠度高、團隊精神佳，抗壓力也比一般行員有過之而無不及，加上運動員天性較為開朗，與客戶接洽也有優勢，因此對銀行具有正面加乘效果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_4.jpg", "date": "2026-08-18 00:00", "link": "/news/story/7005/9697513"}, {"article_id": "9697511", "title": "選手轉戰半導體…資格放寬？運動部：年底通盤檢討", "summary": "運動部前身教育部體育署，自民國一一二年委託國立高雄大學推動「選手前進半導體培訓計畫」，運動部表示，計畫推動迄今已建立招募、職涯諮詢、企業媒合及在職培訓的完整運作模式，參與企業皆給予高度肯定，至於是否尋求其他輔導運動員轉職的作法，將通盤檢視本計畫辦理情形，再評估。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_9.jpg", "date": "2026-08-18 00:00", "link": "/news/story/7005/9697511"}, {"article_id": "9697488", "title": "納米比亞沙漠7日賽第二站「沙丘之路」 林義傑與李銘峰奮戰續保官方團體組第一", "summary": "Team Taiwan勇奪賽事第二天冠軍，暫居官方團體組總排第一；賽事在濃霧與巨型沙丘中激戰，明日將迎戰38公里沙地賽程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238699.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 23:28", "link": "/news/story/7227/9697488"}, {"article_id": "9697478", "title": "羽球世錦賽／首日賽程大冷門 球王石宇奇不敵地主64強就出局", "summary": "2026年羽球世錦賽今天將在印度新德里點燃戰火，首日賽程就爆出大冷門，中國「世界球王」石宇奇3局大戰敗給世界排名22的地主謝提（Ayush Shetty），以14：21、21：13、19：21出局，讓現場球迷歡聲雷動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238673.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 22:45", "link": "/news/story/7005/9697478"}, {"article_id": "9697300", "title": "舉重／郭婞淳接任原住民族舉協副理事長！第二屆原住民族舉重賽高雄登場", "summary": "第二屆原住民族舉重錦標賽17日至19日在高雄鼓山高中舉行，郭婞淳當選協會副理事長，49單位、170名選手參賽，展現原住民族舉重實力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238558.jpg&M=1&s=Y&x=0&y=78&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 21:22", "link": "/news/story/7005/9697300"}, {"article_id": "9697208", "title": "鋼鐵進城！台北101水舞廣場百人夜訓秒殺 全球極限體能大賽10月台中熱血開戰", "summary": "台北101水舞廣場百人夜訓名額迅速額滿，2026全球極限體能鋼鐵大賽將於10月17、18日在台中市府廣場登場，兩組報名至8月23日。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238467.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 20:20", "link": "/news/story/7005/9697208"}, {"article_id": "9697087", "title": "NBA／誰是西洋棋之王？ 字母哥隔空向溫班亞瑪下戰帖", "summary": "過去3個賽季，安戴托昆波（Giannis Antetokounmpo）與溫班亞瑪（Victor Wembanyama）多次在籃球場正面交鋒，每當兩人碰頭，都成為備受矚目的焦點對決。不過這一次，安戴托昆波似乎想將兩人的較量從籃球場延伸到棋盤上。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238367.jpg&M=1&s=Y&x=54&y=14&sw=1128&sh=752&exp=3600&sl=W&fw=360", "date": "2026-08-17 18:57", "link": "/news/story/7002/9697087"}, {"article_id": "9697015", "title": "中職／陳鏞基連2週回家鄉台東出賽 18日雄鷹派黃子鵬先發", "summary": "中職統一7-ELEVEn獅隊明天起作客台東棒球場與台鋼雄鷹2連戰，將是43歲老將陳鏞基球員生涯最後一次在家鄉出賽，雄鷹隊...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238281.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 18:10", "link": "/news/story/7001/9697015"}, {"article_id": "9697022", "title": "NBA／加入小鮑爾灰狼展現新氣象 愛德華放話：能擊敗雷霆、馬刺", "summary": "儘管球隊陣容今夏面臨不小變動，但灰狼當家少主愛德華（Anthony Edwards）對於新賽季的前景依然充滿信心，他甚至直言，灰狼有能力在競爭激烈的西區擊敗目前最具威脅的兩支球隊─雷霆和馬刺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238274.jpg&M=1&s=Y&x=92&y=24&sw=1072&sh=714&exp=3600&sl=W&fw=360", "date": "2026-08-17 18:07", "link": "/news/story/7002/9697022"}, {"article_id": "9696922", "title": "中職／富邦悍將Thank You日籍投手阿部雄大 返日延續球季", "summary": "富邦悍將宣布，日籍投手阿部雄大提前終止合約返日延續球季；他本季一軍出賽10場、拿下3勝，球團祝福並盼未來再合作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238154.jpg&M=1&s=Y&x=112&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-17 17:33", "link": "/news/story/7001/9696922"}, {"article_id": "9696707", "title": "棒球／42年前洛杉磯奧運老國手亮相 林華韋對新一代國手有話說", "summary": "攸關2028年洛杉磯奧運棒球賽門票的兩大國際賽，包括明年世界12強賽預、複賽，以及奧運最終資格賽都將在台北市進行，1984年洛杉磯奧運銅牌多名國手今天出席記者會，喚起不少老球迷的回憶，中華棒球協會副理事長林華韋說：「希望有機會再去現場看球。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237862.jpg&M=1&s=Y&x=0&y=0&sw=1230&sh=820&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:57", "link": "/news/story/7001/9696707"}, {"article_id": "9696660", "title": "TPBL／徵選近三百人報名 戰神啦啦隊公告4名新成員加入", "summary": "台新育樂今宣布台北台新戰神啦啦隊Taishin Wonders迎來四位新成員，本屆徵選吸引近三百人報名，僅25人挺進決選，最終由具職籃啦啦隊經歷的芭蕾女孩小馨、歷經兩年培訓轉為正式成員的Momo，以及擁有 17年舞齡、曾擔任王心凌演唱會舞者的小樂Ｍ與選秀節目舞蹈組冠軍Josh脫穎而出，四人將發揮不同舞蹈與表演專長，為新賽季帶來更多元的舞台演出。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237763.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:34", "link": "/news/story/7003/9696660"}, {"article_id": "9696647", "title": "棒球／中華隊12強賽若進奧運 棒協證實6搶1資格賽仍在北市", "summary": "中華棒球協會獲得明年世界12強賽預賽、複賽，以及後年奧運最終資格賽主辦權，都將在台北市進行比賽，今天舉行兩大國際賽舉辦權發布記者會，棒協秘書長林宗成表示，中華隊若在12強賽就取得後年洛杉磯奧運參賽權，奧運資格賽仍會在北市進行，這是和世界棒壘球總會談好的條件。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237745.jpg&M=1&s=Y&x=0&y=0&sw=1247&sh=831&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:30", "link": "/news/story/7001/9696647"}, {"article_id": "9696640", "title": "匹克球／林志穎任賽事大使 AEPL亞洲菁英聯盟月底開戰", "summary": "匹克球成為全球人氣極高的運動，亞洲菁英匹克球聯盟（Asia Elite Pickleball League，簡稱AEPL）5月宣告正式成立，今天在台北車站多功能展演空間舉辦創始賽季賽前記者會，知名藝人林志穎也現身擔任賽事大使，號召全民一起拿起球拍感受這項新興運動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237734.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:27", "link": "/news/story/7005/9696640"}, {"article_id": "9696586", "title": "NBA／坦言未打電話召募詹皇 康寧漢：他應該不想聽我說什麼", "summary": "NBA巨星詹姆斯（LeBron James）今夏自由市場動向掀起全聯盟熱潮，不少球隊與球員都親自出面招募這名「41歲老漢」。不過，對於詹姆斯是否可能加盟底特律，活塞當家球星康寧漢（Cade Cunningham）坦言，自己其實沒有太關注這件事，更沒有打電話試圖說服詹姆斯來到汽車城。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237674.jpg&M=1&s=Y&x=46&y=49&sw=1088&sh=725&exp=3600&sl=W&fw=360", "date": "2026-08-17 15:08", "link": "/news/story/7002/9696586"}, {"article_id": "9696545", "title": "棒球／中華隊挑戰衛冕明年12強賽搶奧運資格 蔣萬安透露大巨蛋10場比賽", "summary": "中華棒球隊挑戰2028年洛杉磯奧運，攸關參賽門票的兩項賽事，包括明年世界12強賽預、複賽，以及奧運最終資格賽都將在台北市舉辦，亞洲棒球總會會長、世界棒壘球總會（WBSC）副會長辜仲諒說：「感謝WBSC排除萬難，以及相關團隊共同努力，讓我們好不容易爭取到這個機會。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237624.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-17 14:46", "link": "/news/story/7001/9696545"}, {"article_id": "9696463", "title": "MLB／明星賽後狂挨11轟成警訊！ 道奇左投羅布勒斯基手臂發炎進傷兵名單", "summary": "道奇26歲左投羅布勒斯基因前臂發炎進傷兵名單；明星賽後近26局挨11轟、防禦率6.92，後續定位可能轉往牛棚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237479.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 14:33", "link": "/news/story/6999/9696463"}, {"article_id": "9696387", "title": "中職／兄弟重砲許基宏動刀修復右膝半月板 手術成功IG報平安", "summary": "中信兄弟主砲許基宏因右膝半月板破損接受關節鏡修復手術，17日透過IG報平安，表示手術順利，將積極復健盼重返球場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237344.jpg&M=1&s=Y&x=0&y=241&sw=1108&sh=739&exp=3600&sl=W&fw=360", "date": "2026-08-17 13:50", "link": "/news/story/7001/9696387"}, {"article_id": "9696336", "title": "NBA／杜蘭特選MVP勝過冠軍戒 直言「人人都想成為MVP」", "summary": "NBA超級球星杜蘭特（Kevin Durant）職業生涯成就豐富，不僅曾兩度贏得總冠軍和FMVP，也獲得過年度MVP、奧運金牌等榮耀。不過，當被問到總冠軍戒指與MVP獎項哪一項更有價值時，杜蘭特卻是毫不猶豫選擇了MVP。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237264.jpg&M=1&s=Y&x=0&y=29&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-17 13:28", "link": "/news/story/7002/9696336"}, {"article_id": "9696338", "title": "NBA／當對手之前先合體 詹姆斯和里夫斯高球場揮桿", "summary": "「小皇帝」詹姆斯（LeBron James）雖離開湖人隊，和前隊友關係仍密切，他在夏天最後的假期尾聲和里夫斯（Austin Reaves）及兒子布朗尼（Bronny James）合體，三人一起在高球場揮桿。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237279.jpg&M=1&s=Y&x=0&y=96&sw=1199&sh=799&exp=3600&sl=W&fw=360", "date": "2026-08-17 13:25", "link": "/news/story/7002/9696338"}, {"article_id": "9696264", "title": "NBA／初生之犢不畏虎 勇士首輪新秀嗆：我要狠狠修理「惡棍狄龍」", "summary": "勇士首輪新秀倫德伯格直播放話，要在新球季對決太陽布魯克斯時「狠狠修理他」；他夏聯率隊奪冠，兩隊首度交手預計10月24日登場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:56", "link": "/news/story/7002/9696264"}, {"article_id": "9696059", "title": "中職／陳鏞基生涯最終台東場賽事 獅隊雄鷹合作送紀念明信片", "summary": "中職統一7-ELEVEn獅隊本週客場到台東與台鋼雄鷹交手，也是43歲老將陳鏞基職棒球員生涯最後一次台東場出賽，19日獅隊...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237095.jpg&M=1&s=Y&x=0&y=64&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:33", "link": "/news/story/7001/9696059"}, {"article_id": "9696178", "title": "MLB／挽救生涯的TJ手術 從黃平洋到「不死鳥」數十名台灣選手走過重建路", "summary": "大聯盟傳奇左投湯米約翰享壽83歲辭世；他1974年接受首例TJ手術，影響投手生涯，也讓黃平洋、郭泓志等數十名台灣球員走過韌帶重建路。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237123.jpg&M=1&s=Y&x=13&y=46&sw=1253&sh=807&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:25", "link": "/news/story/7001/9696178"}, {"article_id": "9696184", "title": "NBA／2029名人堂眾星璀璨 保羅、衛少、羅瑞三大控衛有望攜手入選", "summary": "2029年奈史密斯籃球名人堂（Naismith Basketball Hall of Fame）可能迎來一場令人難忘的「控衛大團聚」，曾在2010年代共同定義NBA控衛版圖的3大名將衛斯特布魯克（Russell Westbrook）、保羅（Chris Paul）與羅瑞（Kyle Lowry），有望在同一年攜手踏入籃球最高殿堂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237076.jpg&M=1&s=Y&x=0&y=14&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-17 12:24", "link": "/news/story/7002/9696184"}]}, {"name": "棒球", "articles": [{"article_id": "9696922", "title": "中職／富邦悍將Thank You日籍投手阿部雄大 返日延續球季", "date": "2026-08-17 17:33", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238154.jpg&M=1&s=Y&x=112&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9696922"}, {"article_id": "9696545", "title": "棒球／中華隊挑戰衛冕明年12強賽搶奧運資格 蔣萬安透露大巨蛋10場比賽", "date": "2026-08-17 14:46", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237624.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9696545"}, {"article_id": "9696178", "title": "MLB／挽救生涯的TJ手術 從黃平洋到「不死鳥」數十名台灣選手走過重建路", "date": "2026-08-17 12:25", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237123.jpg&M=1&s=Y&x=13&y=46&sw=1253&sh=807&exp=3600&w=300", "link": "/news/story/7001/9696178"}, {"article_id": "9697015", "title": "中職／陳鏞基連2週回家鄉台東出賽 18日雄鷹派黃子鵬先發", "date": "2026-08-17 18:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238281.jpg&M=1&s=Y&x=0&y=