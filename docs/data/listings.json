p?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35208335.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:30", "link": "/news/story/6812/9676556"}, {"article_id": "9676551", "title": "限制出生公民權再出招 川普連簽2命令嚴打「生育旅遊」", "summary": "最高法院今年6月30日以6比3的票數駁回了川普總統限制「出生公民權」的行政命令，因其違反憲法第14修正案。但川普仍不放棄此目標，6日簽署兩項關於移民的行政命令，其中一項限制獲得出生公民權的幾種人，另一項則著重打擊生育旅遊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35208330.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:30", "link": "/news/story/6813/9676551"}, {"article_id": "9677207", "title": "傳不滿缺彈藥被瞞怒飆赫塞斯 川普：庫存龐大 要追查洩密者", "summary": "華盛頓郵報5日獨家報導，兩名知情人士透露，川普總統對伊朗戰爭的不滿上周在大衛營爆發，要求國防部長赫塞斯解釋，為何他顯然在彈藥極度短缺一事上受到誤導，而這項問題如今可能限制美國對伊朗採取軍事行動的選項。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209440.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:29", "link": "/news/story/6813/9677207"}, {"article_id": "9677118", "title": "廣島原爆81年 高市稱目前堅持非核3原則 不提未來引質疑", "summary": "日本廣島市6日紀念美國於二戰末期投下原子彈81周年的「原爆日」。去年10月就任的高市早苗6日首次以首相身分，在廣島市和平紀念公園舉行的和平紀念儀式致詞。她在致詞時和之後的記者會都只說，日本「目前」堅持「非核三原則」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209298.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:29", "link": "/news/story/6809/9677118"}, {"article_id": "9676656", "title": "申請移民缺件 USCIS可直接駁回衝擊申庇 審理中也適用", "summary": "美國公民及移民服務局(USCIS)5日宣布，即日起調整案件審查政策，移民官若認定申請文件未能證明申請資格，或缺少規定應附的初始證明文件，可直接駁回申請，不再必須先發出「補件通知」(Request for Evidence，RFE)或「擬拒絕通知」(Notice of Intent to Deny，NOID)，讓申請人補件後再作決定。新規立即生效，並適用於目前仍在審理中的案件及8月5日以後提出的新申請。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35208470.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:28", "link": "/news/story/6813/9676656"}, {"article_id": "9677117", "title": "消除政變隱患 李在明促加速三軍官校合併 直接點名陸軍", "summary": "南韓政府正推動陸海空三軍官校合併，消除軍校派系化引發軍事政變的隱患，引發軍方反彈。南韓總統李在明5日敦促加快推動之餘，也直接點名陸軍，表示：「三次政變的核心人物都是陸軍官校出身，卻從未有人被追究責任。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209296.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:27", "link": "/news/story/6809/9677117"}, {"article_id": "9677117", "title": "消除政變隱患 李在明促加速三軍官校合併 直接點名陸軍", "summary": "南韓政府正推動陸海空三軍官校合併，消除軍校派系化引發軍事政變的隱患，引發軍方反彈。南韓總統李在明5日敦促加快推動之餘，也直接點名陸軍，表示：「三次政變的核心人物都是陸軍官校出身，卻從未有人被追究責任。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209296.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:27", "link": "/news/story/6809/9677117"}, {"article_id": "9677224", "title": "2028誰接班？華郵：川普表面不表態 私下要金主挺范斯", "summary": "華盛頓郵報6日獨家報導，儘管川普總統公開發言時對於2028年共和黨候選人保持開放態度，但私底下卻要求金主支持副總統范斯；川普幕僚則說，私下言論並不代表川普對於2028年候選人已經拍板。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209459.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:26", "link": "/news/story/6813/9677224"}, {"article_id": "9677115", "title": "劍橋最年輕非裔教授涉抄襲請辭 學術資歷、豬頭威脅也被戳破", "summary": "劍橋大學教育社會學教授阿爾戴(Jason Arday)因遭指控論文涉抄襲、個人經歷與學術資歷疑似誇大，在校方宣布將針對其學歷與職涯展開新一輪調查後，已宣布辭職。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209294.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:25", "link": "/news/story/6809/9677115"}, {"article_id": "9677230", "title": "伊朗總統逼最高領袖現身 爆請辭28次換密會…見完反更困惑", "summary": "總部位於倫敦的反對派媒體「伊朗國際」4日報導，伊朗最高領袖穆吉塔巴3月掌權至今神隱5個月，連伊朗總統裴澤斯基安也屢次被拒於門外。消息人士稱，裴澤斯基安曾多次以辭職相逼爭取會面，甚至累計28度提出辭職，最後換來一場極不尋常的車內祕密會晤。當時裴澤斯基安被禁止與穆吉塔巴握手，甚至看不到他的真面目，事後困惑到向幕僚確認對方到底是不是最高領袖。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209466.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:25", "link": "/news/story/124061/9677230"}, {"article_id": "9677233", "title": "伊朗阿曼協議草案 擬禁美以船隻通行荷莫茲 敵對國須先賠償", "summary": "伊朗媒體披露的伊朗與阿曼擬定的協議顯示，德黑蘭尋求禁止美國和以色列船隻通過荷莫茲海峽，並要求敵對國家在使用這條關鍵航道前進行賠償。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209469.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:24", "link": "/news/story/124061/9677233"}, {"article_id": "9677113", "title": "韓足協爆違法消費 為世界盃等7賽事 性賄賂外籍裁判10餘人", "summary": "南韓足球界爆出大醜聞。南韓主流媒體 JTBC獨家揭露一份政府內部調查報告，指出大韓足球協會（KFA）曾在 2011年至2012年間，多次動用官方信用卡（法務卡）違法消費，為多達20名執法國家隊比賽的外籍裁判及比賽監督官提供不當性招待。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209292.jpg&M=1&s=Y&x=0&y=0&sw=1110&sh=740&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:23", "link": "/news/story/6809/9677113"}, {"article_id": "9676461", "title": "不滿華府對台軍售 北京拒美防部次長柯伯吉訪問", "summary": "美國國防部政策次長柯伯吉(Elbridge Colby)長期以來對中國持鷹派觀點及制訂相關政策，在台海防衛、美國戰略等多方面頻繁挑戰北京。知情人士透露，他近期希望到北京訪問及在中國國防大學演說，但中方表明不歡迎他。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35208205.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:23", "link": "/news/story/6813/9676461"}, {"article_id": "9676654", "title": "新州6600非公民被誤登選民恐遭遣返 他盼16年綠卡夢碎", "summary": "新澤西州民主黨籍州長薛瑞爾(Mikie Sherrill)上月披露，該州誤將多達6600名非美國公民登記為選民。她承諾將盡其所能，協助受影響人士，減輕此事件帶來的後果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35208469.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:22", "link": "/news/story/6809/9676654"}, {"article_id": "9677112", "title": "埃及32歲知名女星跨國販毒一審判死 同夥12人下場相同", "summary": "埃及法院4日對近年規模最大的毒品案作出判決，將埃及知名女星哈里發以及另外12名被告一審判處死刑。此案不僅震撼埃及社會，也再次凸顯埃及對毒品犯罪「零容忍」的嚴厲政策。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209291.jpg&M=1&s=Y&x=2&y=167&sw=477&sh=318&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:21", "link": "/news/story/6809/9677112"}, {"article_id": "9676652", "title": "ICE頻登機抓人 航空公司開始說不 要求出示司法搜查令", "summary": "聯邦政府擴大機場移民執法，航空公司近期開始拒絕聯邦移民及海關執法局(ICE)探員直接登機逮捕乘客。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35208468.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:21", "link": "/news/story/6809/9676652"}, {"article_id": "9677111", "title": "發文曾提犯罪集團 墨西哥擁60萬粉絲網紅直播遭槍殺", "summary": "墨西哥地方及聯邦當局表示，網紅加斯特盧姆（César Gastélum）4日在西北部城市庫利亞坎（Culiacán）一家速食店前直播時遭槍擊身亡。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209290.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:19", "link": "/news/story/6809/9677111"}, {"article_id": "9677134", "title": "美大砍F-1留學簽證 環時社評：這是歧視中國留學生", "summary": "美國保守派智庫「移民研究中心」（Center for Immigration Studies）3日發布報告稱，去年5到8月中國學生獲發放的F-1留學簽證，相比2024年同期減少34%、給印度學生簽證數量減少60%。中國官媒環球時報5日社評批評美方，將正常留學活動政治化、武器化，以國家安全為名搞歧視性限制，該社評還指，「我們堅決反對任何對中國留學生的汙名化和歧視性對待。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209335.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-07 14:10", "link": "/news/story/6813/9677134"}]}, {"name": "中東戰火連綿", "articles": [{"article_id": "9675976", "title": "協議草案 伊朗阿曼將共管荷莫茲海峽", "date": "2026-08-07 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35207502.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/124061/9675976"}, {"article_id": "9677230", "title": "伊朗總統逼最高領袖現身 爆請辭28次換密會…見完反更困惑", "date": "2026-08-07 14:25", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35209466.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124061/9677230"}, {"article_id": "9677233", "title": "伊朗阿曼協議草案 擬禁美以船隻通行荷莫茲 敵對國須先賠償", "date": "2026-08-07 14:24", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/phot