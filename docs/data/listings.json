/pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/08/35403806.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=852&exp=3600&w=300", "link": "/news/story/122629/9803634"}, {"article_id": "9803789", "title": "找來麻煩製造者莫蘭特 拓荒者「走在極端」卻能不斷創造奇蹟", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/08/35403992.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9803789"}, {"article_id": "9800783", "title": "中職／雖先處於一敗劣勢 統一投打俱佳仍有望闖進台灣大賽", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35399293.jpg&M=1&x=&y=&sw=&sh=&exp=3600&w=300", "link": "/news/story/122629/9800783"}, {"article_id": "9800955", "title": "日職／打擊榜洗版+鐵牛棚守成 軟銀戰力碾壓收下季後賽新優惠", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/07/35399547.jpg&M=1&s=Y&x=102&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9800955"}, {"article_id": "9798956", "title": "中職／年度第五對第二還保送一勝 半季冠軍制有bug該修正", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35396453.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9798956"}, {"article_id": "9798142", "title": "連兩年強拉尾盤翻轉戰局 低調強權守護者再成美中之霸", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/06/35395218.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9798142"}]}, {"name": "最新文章", "articles": [{"article_id": "9806148", "title": "MLB／鈔能力對決小資軍團！道奇薪資海放釀酒人 國聯冠軍賽誰能笑到最後", "summary": "國聯冠軍賽再度由道奇隊碰上釀酒人隊，除了爭奪世界大賽門票，兩隊的薪資落差也成為焦點。《今日美國》旗下《密爾瓦基哨兵報》指出，釀酒人今年現役名單薪資僅約道奇的27%，道奇更有15名球員的薪資，足以排進釀酒人陣中前3名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407627.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 11:53", "link": "/news/story/6999/9806148"}, {"article_id": "9806087", "title": "MLB／才後援救火又扛生死戰！守護者三振王「中1日」拚讓二追三", "summary": "守護者隊從0勝2敗的淘汰邊緣連扳兩城，將與白襪隊的美聯分區系列賽逼進決勝第5戰，最後一搏再把球交給王牌威廉斯（Gavin Williams），這名右投才在第4戰後援守住勝利，僅休息1天就要重返先發投手丘，力拚帶領球隊完成「讓二追三」逆轉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407394.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 11:04", "link": "/news/story/6999/9806087"}, {"article_id": "9806093", "title": "MLB／賈吉直言有沃爾普洋基才能奪冠！紐媒：守二壘很自在", "summary": "「基特接班人」沃爾普（Anthony Volpe）從谷底翻身，差點成為洋基隊季後賽英雄。洋基隊長賈吉（Aaron Judge）也直言：「如果我們想贏世界大賽，就需要沃爾普留在這支球隊。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407419.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-10 10:56", "link": "/news/story/6999/9806093"}, {"article_id": "9806050", "title": "MLB／酸道奇「史上最幸運」球隊！美球評：大谷、貝茲、弗里曼沒發揮", "summary": "道奇隊連續3年闖進國聯冠軍賽，距離世界大賽3連霸再近一步，不過《MLB Network》球評帕克（Rob Parker）卻不買單。他認為，道奇屢次在季後賽過關，靠的是角色球員救援與關鍵時刻的好運，更替衛冕軍冠上「史上最幸運球隊」的稱號。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407391.jpg&M=1&s=Y&x=0&y=0&sw=1272&sh=848&exp=3600&sl=W&fw=360", "date": "2026-10-10 10:48", "link": "/news/story/6999/9806050"}, {"article_id": "9806079", "title": "NBA／退而不休！ 衛斯特布魯克放話 爭取洛杉磯奧運火炬手", "summary": "曾奪下2012年倫敦奧運金牌的NBA傳奇球星衛斯特布魯克（Russell Westbrook），儘管今年8月宣布結束長達18年的輝煌NBA生涯，但近日他拋出生涯新目標，希望爭取成為2028年在家鄉舉辦的洛杉磯奧運擔任聖火傳遞的火炬手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407383.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 10:40", "link": "/news/story/7002/9806079"}, {"article_id": "9806053", "title": "MLB／道奇對決釀酒人前2戰先發公布 教頭解釋山本由伸投G2規劃", "summary": "國聯冠軍賽將在台灣時間12日開打，道奇隊首戰將在客場迎戰釀酒人隊，今天總教練羅伯茲（Dave Roberts）公布前兩戰的先發投手，一如外界預期，由塞揚左投史庫柏（Tarik Skubal）及山本由伸先後上陣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407366.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 10:28", "link": "/news/story/6999/9806053"}, {"article_id": "9806033", "title": "MLB／大谷翔平變小小水槍還是相信他 道奇教頭：雖然提不出依據", "summary": "大谷翔平近況低迷，變成小小水槍，棒次安排備受關注，道奇隊總教練羅伯茲（Dave Roberts）表示，還不確定將在明天把大谷排在第幾棒，只確定會是第2到5棒之間。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407324.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 10:16", "link": "/news/story/6999/9806033"}, {"article_id": "9806019", "title": "NBA／史馬特暗指續約未獲湖人尊重 轉戰火箭盼用表現討回公道", "summary": "今年休賽季離開湖人、轉戰休士頓的鐵衛史馬特（Marcus Smart），在澳門舉行的中國賽受訪時，談到自己離開湖人的原因。他坦言，自己原本認為上季表現足以換來一份更具誠意的續約報價，但湖人最終有不同想法，也讓他決定展開新篇章。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407299.jpg&M=1&s=Y&x=0&y=54&sw=1170&sh=780&exp=3600&sl=W&fw=360", "date": "2026-10-10 10:08", "link": "/news/story/7002/9806019"}, {"article_id": "9805952", "title": "MLB／道奇國聯冠軍賽史庫柏打頭陣 山本第2戰再戰去年完投對手", "summary": "道奇隊國聯冠軍賽前兩戰先發底定，總教練羅伯斯（Dave Roberts）今天宣布，將由兩屆塞揚獎左投史庫柏（Tarik Skubal）在首戰迎戰釀酒人隊，山本由伸接手第2戰。山本去年曾在同一輪系列賽對釀酒人投出9局失1分的完投勝，今年將再度登上密爾瓦基投手丘。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407285.jpg&M=1&s=Y&x=20&y=11&sw=1163&sh=775&exp=3600&sl=W&fw=360", "date": "2026-10-10 10:03", "link": "/news/story/6999/9805952"}, {"article_id": "9805966", "title": "NBA／模仿「Dame Time」釀心結 哈利伯頓盼與里拉德破冰", "summary": "在2023年首屆季中錦標賽（現為NBA盃）4強賽中，溜馬主將哈利伯頓（Tyrese Haliburton）在對陣公鹿的關鍵時刻投進致命三分球，隨後敲擊手腕做出對手里拉德（Damian Lillard）招牌的「Dame Time」慶祝動作，這幕經典的挑釁場面，如今卻成了哈利伯頓心中最深沉的遺憾。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407174.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-10 09:40", "link": "/news/story/7002/9805966"}, {"article_id": "9805924", "title": "NBA／停止2奪冠功臣續約談判！尼克球團：專注開季", "summary": "尼克隊上賽季才捧回睽違53年的總冠軍金盃，新賽季尚未開打，主力球員的續約問題已成焦點。球團在美國時間9日宣布，暫停包括唐斯（Karl-Anthony Towns）、哈特（Josh Hart）等人的延長合約談判，直到球季稍晚才會重啟，強調現階段將全力投入開季準備。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407065.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 09:30", "link": "/news/story/7002/9805924"}, {"article_id": "9805756", "title": "NFL／名人堂傳奇迪特卡86歲逝世 家人、球隊同悼念", "summary": "職業美式足球聯盟NFL芝加哥熊隊（Chicago Bears）傳奇教練迪特卡（Mike Ditka）今天去世，享壽86歲", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35406764.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-10 04:37", "link": "/news/story/7005/9805756"}, {"article_id": "9805594", "title": "北極羽賽／周天成8強戰不敵渡邊航貴 無緣3連霸", "summary": "羽球好手「台灣一哥」周天成今天在世界羽球聯盟（BWF）超級500等級的北極羽球公開賽男子單打8強戰，以19比21、16比...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407008.jpg&M=1&s=Y&x=47&y=140&sw=1072&sh=715&exp=3600&sl=W&fw=360", "date": "2026-10-09 23:29", "link": "/news/story/7005/9805594"}, {"article_id": "9805534", "title": "中職／獅隊首局雙殺不成釀禍 餅總：林子豪那球影響很大", "summary": "統一獅隊今天在季後挑戰賽首戰以1：4不敵中信兄弟，陷入0勝2敗的絕境，首局失3分成最大敗筆，總教練「大餅」林岳平也直言，首局沒能製造雙殺確實影響很大，讓球隊陷入不利的局面。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/10/35407004.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-09 22:27", "link": "/news/story/7001/9805534"}, {"article_id": "9805514", "title": "桌球／遭化解8個冠軍點 林昀儒、鄭怡靜混雙不敵南韓大滿貫賽亞軍作收", "summary": "暌違4年再度晉級到WTT大滿貫賽混雙決賽的林昀儒／鄭怡靜，今天遭遇世界排名第1的南韓林鐘勳／申裕斌，也是雙方繼名古屋亞運後再度交手，台灣組合在第四局聽牌且大幅領先的情況下，卻被對手化解8個冠軍點，最終以14：12、9：11、18：16、11：13、8：11敗下陣來，以亞軍作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406471.jpg&M=1&s=Y&x=27&y=0&sw=1253&sh=835&exp=3600&sl=W&fw=360", "date": "2026-10-09 22:15", "link": "/news/story/7005/9805514"}, {"article_id": "9805452", "title": "中職／象獅季後挑戰賽G2先發出爐 菲力士對決喬登", "summary": "中信兄弟隊今天在季後挑戰賽首戰以4：1擊敗統一獅隊，先取得2勝0敗的聽牌優勢，明天第2戰移師獅隊主場、台南亞太棒球場，兩隊先發投手揭曉，兄弟將推菲力士出馬迎戰前東家，「背水一戰」的獅隊則由喬登把關。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406472.jpg&M=1&s=Y&x=0&y=3&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-09 20:47", "link": "/news/story/7001/9805452"}, {"article_id": "9805450", "title": "TPBL／王晟霖爆扣獲教練隊友讚賞 林庭謙：看到學弟成長很開心", "summary": "台北台新戰神在今年休賽季進行陣容上的大進補，不僅新加入的林庭謙與洋將麥基首場比賽就火力全開猛轟54分，從SBL基隆黑鳶轉戰戰神的中鋒王晟霖，更有一次接獲林庭謙助攻後雙手爆扣的演出，賽後不僅總教練圖奇大讚王晟霖的表現，林庭謙也直言看到學弟的成長很開心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406389.jpg&M=1&s=Y&x=0&y=307&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-09 20:46", "link": "/news/story/7003/9805450"}, {"article_id": "9805422", "title": "中職／勝騎士做足準備繳7局好投 預約「再一起拋一次彩帶」", "summary": "中信兄弟隊洋投勝騎士在季後賽首度迎戰前東家統一獅隊，今天在季後挑戰賽首戰繳出7局失1分好投，率領球隊以4：1收下勝利、系列賽取得2勝0敗的聽牌優勢，賽後勝騎士也向主場球迷喊話，「希望我們能再一起拋一次彩帶。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406378.jpg&M=1&s=Y&x=0&y=0&sw=1236&sh=824&exp=3600&sl=W&fw=360", "date": "2026-10-09 20:27", "link": "/news/story/7001/9805422"}, {"article_id": "9805412", "title": "TPBL／林庭謙攜手麥基狂飆54分 戰神熱身賽首戰就退衛冕軍夢想家", "summary": "今年返台加入台北台新戰神的林庭謙，今天迎接在TPBL熱身賽的首秀，在他全場猛轟25分、送出6助攻、3抄截領軍下，加上新洋將麥基也火力全開猛轟7記三分球拿下29分，最終戰神就以122：114擊敗衛冕軍福爾摩沙夢想家。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406372.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-09 20:10", "link": "/news/story/7003/9805412"}, {"article_id": "9805407", "title": "中職／勝騎士7局好投壓制前東家 中信兄弟4：1擊敗獅隊「聽牌」", "summary": "中職季後挑戰賽今天在台中洲際棒球場展開，中信兄弟奪下半季冠軍手握1勝，今天靠著勝騎士先發7局失1分壓制前東家，打線則在首局就敲回3分奠定勝基，在滿場兩萬人的見證下，以4：1擊敗統一獅隊，在4戰3勝制的季後賽先搶下2勝0敗的「聽牌」優勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406366.jpg&M=1&s=Y&x=0&y=0&sw=1248&sh=832&exp=3600&sl=W&fw=360", "date": "2026-10-09 20:01", "link": "/news/story/7001/9805407"}, {"article_id": "9805391", "title": "TPBL／拿出菜鳥季影片激勵自己 謝亞軒飆7三分球放眼「三分球王」", "summary": "TPBL熱身賽今天展開點燃戰火，新北中信特攻在延長賽以136：133驚險擊敗高雄全家海神，全場飆進7顆三分球、獨攬27分的特攻射手謝亞軒，無疑是球隊獲勝的最大功臣，賽後他坦言，休賽季特別找回菜鳥年影片「複習」，盼在新球季找回最強的投籃自信，並把聯盟本季新增的「三分球王」視為個人目標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406345.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-09 19:39", "link": "/news/story/7003/9805391"}, {"article_id": "9805390", "title": "TPBL／首度以職業球員身份重返和平館 賀丹自認表現不佳待改進", "summary": "TPBL新賽季熱身賽在今天於台北和平籃球館點燃戰火，首場比賽就由高雄全家海神出戰新北中信特攻，海神選秀狀元賀丹在本場比賽雖然有14分進帳，但不僅命中率不盡理想，還發生6次失誤，賽後賀丹也直言首秀的表現確實不好，也希望下場比賽能夠打出更好表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406344.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=790&exp=3600&sl=W&fw=360", "date": "2026-10-09 19:39", "link": "/news/story/7003/9805390"}, {"article_id": "9805255", "title": "U18女籃／中華隊搶下U19世界盃門票 錢薇娟：完成艱鉅任務", "summary": "中華隊今天在U18亞洲盃女籃賽關鍵戰中，以86比55擊敗菲律賓，總教練錢薇娟表示，球員記取前一戰教訓，從首節就保持專注、...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406219.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-09 17:48", "link": "/news/story/7003/9805255"}, {"article_id": "9805127", "title": "花式滑輪／長短曲均高居第1 陳毅帆勇奪世錦賽金牌", "summary": "在巴拉圭舉行的世界花式滑輪溜冰錦標賽，台灣好手陳毅帆今天在男子組直排花式項目，不論短曲、長曲都高居第1，最終順利奪下金牌", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406214.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-09 17:43", "link": "/news/story/7005/9805127"}]}, {"name": "棒球", "articles": [{"article_id": "9805452", "title": "中職／象獅季後挑戰賽G2先發出爐 菲力士對決喬登", "date": "2026-10-09 20:47", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/09/35406472.jpg&M=1&s=Y&x=0&y=3&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9805452"}, {"article_id": "9805534", "title": "中職／獅隊首局雙殺不成釀禍 餅總：林子豪那球影響很大", "date": "2026-10-09 22:27", "thumbnail": "https://pgw.udn.com.tw/gw/photo.ph