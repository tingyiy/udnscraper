, "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/21/35442833.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9829305"}, {"article_id": "9827006", "title": "選爆山本、轟垮史奈爾 釀酒人包爾斯從棄將變道奇殺手的夢幻之旅", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35439309.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/122629/9827006"}]}, {"name": "最新文章", "articles": [{"article_id": "9835242", "title": "桌球亞錦賽／新星郭冠宏、馮翊新同闖男單8強", "summary": "在烏茲別克舉行的亞洲桌球錦標賽，台灣桌球新星郭冠宏、馮翊新今天相繼在男單16強勝出，攜手挺進8強，其中郭冠宏恰巧是18歲...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451224.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 18:45", "link": "/news/story/7005/9835242"}, {"article_id": "9835291", "title": "亞帕運／勇奪3金後再扛閉幕式重任 林姿妤擔任掌旗官直呼期待", "summary": "2026年第5屆名古屋亞洲帕拉運動會今天舉行閉幕典禮，我國代表團由本屆勇奪3面金牌的桌球好手林姿妤擔任掌旗官，與各國代表團選手及隊職員共同參與閉幕典禮，為本屆亞帕運畫下精彩句點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451214.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 18:37", "link": "/news/story/7005/9835291"}, {"article_id": "9835286", "title": "NBA／「他又不是喬丹！」勇士菜鳥開嗆唐西奇 自認對媒體說得太過火", "summary": "勇士新秀倫德伯格（Yaxel Lendeborg）與湖人球星唐西奇（Luka Doncic）在新賽季開幕戰爆發的場上口角，近日持續引發熱議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451202.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 18:34", "link": "/news/story/7002/9835286"}, {"article_id": "9835201", "title": "NBA／「83分先生」得分比犯規少 阿德巴約：真的太誇張了", "summary": "熱火隊今天以111：128輸給活塞隊，新賽季前2場都以慘敗坐收。「83分先生」阿德巴約（Bam Adebayo）全場6次犯規，只得4分，賽後他坦言自己的表現太誇張。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451124.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 17:02", "link": "/news/story/7002/9835201"}, {"article_id": "9835203", "title": "企業射箭／分項冠軍賽加射、季後賽港都開戰 亞運3將歸建爭取榮耀", "summary": "結束名古屋亞運後，2026中華企業射箭聯賽8年本周回歸，將於明、後兩天的光復節連假於高雄國家運動訓練中心進行分項冠軍賽加射與季後挑戰賽，亞運建功的張正韋、鄭祥輝、林子翔等人都將歸建，為母隊爭取榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451122.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 17:01", "link": "/news/story/7005/9835203"}, {"article_id": "9835199", "title": "中職／中信兄弟G5先發再換人！ 羅戈休4天再登板對決龍隊蔣銲", "summary": "薔琵颱風造成中職總冠軍賽G5延後兩天進行，兩隊都獲得3天的休息日，對於中信兄弟隊先發投手來說更是一大利多，明天G5先發再換人，由G3先發羅戈休4天後再登板，對決味全龍隊洋投蔣銲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451125.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 16:59", "link": "/news/story/7001/9835199"}, {"article_id": "9835198", "title": "NBA／凱斯勒連兩戰攻守宰制禁區 里夫斯讚嘆：無法要求更多", "summary": "湖人隊今年休賽季引進的中鋒凱斯勒（Walker Kessler）在今天以125：117力克快艇隊的比賽中，不僅轟下22分，更繳出單場6次阻攻與3次抄截的頂級防守數據，成為隊史第8位達成此項防守成就的球員，歷經上季因傷僅出戰5場的低谷，他直言如今能保持健康並重返賽場感覺非常美妙，心中充滿感恩。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451123.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 16:58", "link": "/news/story/7002/9835198"}, {"article_id": "9835166", "title": "NBA／菜鳥布瑟致勝球氣走勇士 超狂全能數據史上第3年輕", "summary": "終場前還剩下3分47秒，勇士領先12分，眼看要拿下開季首勝，沒想到慘案發生了！", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451078.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 16:34", "link": "/news/story/7002/9835166"}, {"article_id": "9835160", "title": "揚名國際！2026FAI美國長灘無人機足球國際盃 中華代表隊APEXTEAM奪冠", "summary": "中華台北派出兩支代表隊參賽，憑藉精湛的飛行操控技術、優異的攻防戰術及高度團隊默契，從6國、16支參賽隊伍中脫穎而出，由APEX TEAM勇奪冠軍、JQK榮獲亞軍，一舉包辦本屆賽事冠亞軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451064.jpg&M=1&s=Y&x=25&y=0&sw=1249&sh=833&exp=3600&sl=W&fw=360", "date": "2026-10-24 16:20", "link": "/news/story/7005/9835160"}, {"article_id": "9835148", "title": "NBA／勇士重建第一塊拼圖！賈奈特盛讚倫德伯格：沒自我膨脹問題", "summary": "勇士隊首輪第11順位新秀倫德伯格（Yaxel Lendeborg）進入聯盟後，因即戰力和自信言論吸引關注，傳奇球星賈奈特（Kevin Garnett）也公開表達對他的讚賞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451051.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 16:02", "link": "/news/story/7002/9835148"}, {"article_id": "9835132", "title": "MLB／簽59億合約兩年因傷只投28場 道奇塞揚巨投：我想拚到45歲", "summary": "道奇塞揚左投史奈爾（Blake Snell）於2025年簽下一份為期5年、總值1.82億美元（約58億新台幣）的巨額合約，成為先發輪值重要戰力。然而，在簽約後的這兩年間，史奈爾在例行賽中僅有過20場先發機會。光是在今年，他就因肩膀痠痛、肘部關節鼠（游離體）以及腹股溝拉傷等多重傷勢所苦，整季只有登板9次，難以長時間維持穩定的投球節奏。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451034.jpg&M=1&s=Y&x=196&y=38&sw=1073&sh=715&exp=3600&sl=W&fw=360", "date": "2026-10-24 15:54", "link": "/news/story/6999/9835132"}, {"article_id": "9835089", "title": "NBA／冠軍戒指成釣魚陷阱！尼克員工點開郵件遭資安測試 官方認錯道歉", "summary": "紐約尼克日前舉行總冠軍戒指頒發暨冠軍旗幟升起儀式，原本應是慶祝球隊睽違53年再度登頂的重要時刻，卻接連爆出爭議。不僅有部分助理教練在典禮上拿到空戒指盒，尚未領取正式的冠軍戒指，麥迪遜廣場花園（MSG）更被揭露，曾以「領取NBA總冠軍戒指」為誘餌，向公司及球場員工寄送釣魚郵件，測試員工的資安意識。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450975.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-24 15:12", "link": "/news/story/7002/9835089"}, {"article_id": "9835086", "title": "MLB／等了44年不差多等幾分鐘 釀酒人終結者力挺隊友普拉特", "summary": "釀酒人隊在世界大賽G1對上光芒隊，9局上準備用再見雙殺迎接暌違44年的世界大賽首勝，勝利焰火都已施放，卻因光芒提出挑戰且成功，讓比賽又多打了幾分鐘，最終由釀酒人終結者梅吉爾（Trevor Megill）用再見三振終結比賽，3：2收下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450971.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 15:00", "link": "/news/story/6999/9835086"}, {"article_id": "9835078", "title": "NBA／遭再見火鍋無緣助馬刺開胡 溫班亞瑪：重來一次絕對灌籃", "summary": "馬刺隊今天以110：114惜敗於火箭隊，苦吞開季2連敗，其中溫班亞瑪此役雖繳出25分、13籃板、2助攻與2阻攻的成績單，然而比賽激戰至最後關頭卻遭火箭湯普森（Amen Thompson）送出「再見火鍋」，賽後談到這充滿遺憾的最後一擊，溫班亞瑪懊惱直言，假使時光能倒流，他絕不會選擇保守出手，「如果能重來，我一定會直接把球狠狠灌進去。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450926.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 14:52", "link": "/news/story/7002/9835078"}, {"article_id": "9835070", "title": "NBA／羅賓森轉戰波士頓拒看尼克頒冠軍戒儀式 布朗森暖心回應", "summary": "紐約尼克日前舉行總冠軍戒指頒發暨冠軍旗幟升旗儀式，昔日奪冠功臣羅賓森（Mitchell Robinson）卻選擇不觀看這場慶典，引發外界關注。對此，尼克隊長布朗森（Jalen Brunson）表示理解，強調羅賓森本來就是一名情緒表達直接、競爭心強烈的球員，並不會因此對這位昔日隊友產生芥蒂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450946.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 14:49", "link": "/news/story/7002/9835070"}, {"article_id": "9835069", "title": "MLB／分析道奇爭取三連霸失敗原因 日本名將：大谷今年很少說要奪冠", "summary": "道奇隊今年再度奪下國聯西區冠軍，原本被認為有機會達成3連霸，卻在國聯冠軍賽遭釀酒人隊4戰橫掃，讓外界感到錯愕。前大聯盟日本球員長谷川滋利對於道奇被淘汰，提出自己的看法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450931.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-24 14:40", "link": "/news/story/6999/9835069"}, {"article_id": "9835052", "title": "NBA／湯普森驚天隔扣溫班亞瑪加再見火鍋 杜蘭特讚：不可思議的怪物", "summary": "火箭隊與馬刺隊今天上演一場精彩對決，最大焦點落在火箭湯普森（Amen Thompson）身上，他不僅在第三節上演震撼全場的隔扣溫班亞瑪（Victor Wembanyama），更在決勝關頭送出致命的再見火鍋，全場繳出20分、10籃板、4助攻、2抄截與2阻攻的全能數據，率隊收下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450967.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 14:22", "link": "/news/story/7002/9835052"}, {"article_id": "9834971", "title": "MLB／世界大賽G1先發飆火球寫紀錄 米蕭洛斯基：想投到130球", "summary": "釀酒人隊「火球怪物」米蕭洛斯基（Jacob Misiorowski）今天在世界大賽首戰出馬，投第一球就以103.5英里（約166.5公里）寫下世界大賽紀錄，最終以78球繳出5局失1分的表現，拿下勝投，他在賽後甚至表示自己還想繼續投，「我想投到130球。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450815.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 13:28", "link": "/news/story/6999/9834971"}, {"article_id": "9834914", "title": "NBA／格林關鍵犯規+柯爾抱怨吞T 勇士收尾被灰熊轟17：0慘遭逆轉", "summary": "勇士隊今天迎來主場開幕戰，面對重建的灰熊隊，第四節尾聲被打出一波17：0攻勢慘遭逆轉，終場以108：111輸球，苦吞2連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450702.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 13:08", "link": "/news/story/7002/9834914"}, {"article_id": "9834912", "title": "高球／個人紀錄片檀香山首映 曾雅妮分享從球場榮耀走向內心旅程", "summary": "記錄台灣高爾夫名將曾雅妮生命歷程的紀錄片《微笑之後：曾雅妮》（BEYOND THE SMILES: YANI TSENG），於夏威夷當地時間10月22日晚間6時，在檀香山 Consolidated Theatres Kahala 舉行世界首映。吸引滿場觀眾到場觀賞，觀眾與曾雅妮、導演陳惟揚（Frank W. Chen）及製片楊明燊（Brian Yang）一同見證這段歷時多年的紀錄旅程，首次在國際大銀幕上與觀眾相遇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450698.png&M=1&s=Y&x=0&y=0&sw=1278&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 13:01", "link": "/news/story/7005/9834912"}, {"article_id": "9834899", "title": "NBA／唐西奇23分11失誤無礙 湖人有凱斯勒22分6阻攻洛城內戰勝出", "summary": "NBA本賽季首度的「洛城內戰」在今天登場，在主場出賽的湖人隊儘管首節手感不佳一度落後，但第二、三節團隊火力全開，兩節合計攻下76分，並在末節擋下快艇隊反撲，以125：117收下開季二連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450685.jpg&M=1&s=Y&x=0&y=89&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-24 12:50", "link": "/news/story/7002/9834899"}, {"article_id": "9834890", "title": "NBA／格林開砲指唐西奇恐終身無緣MVP 里夫斯也抱屈：這就是審美疲勞", "summary": "勇士老將格林（Draymond Green）先前曾發表過一項大膽的觀點，聲稱唐西奇（Luka Doncic）與泰托姆（Jayson Tatum）恐怕整個職業生涯都無法獲得年度MVP的殊榮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450675.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 12:45", "link": "/news/story/7002/9834890"}, {"article_id": "9798549", "title": "2026MLB世界大賽賽程比分 釀酒人G1險勝光芒旗開得勝", "summary": "《聯合新聞網》udn.com特別整理MLB季後賽賽程與比分表格，完整掌握美聯、國聯各組對戰、系列賽戰績與晉級進度，快速看懂最新季後賽版圖。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35438056.png&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-24 12:45", "link": "/news/story/6999/9798549"}, {"article_id": "9834879", "title": "MLB／樂見世界大賽釀酒人光芒小市場對決 大聯盟主席仍強調要有薪資上限", "summary": "大聯盟主席曼弗瑞（Rob Manfred）認為，今年世界大賽由釀酒人和光芒兩支小市場球隊對決，對棒球運動發展是好事。不過他也強調，這不會改變球團老闆希望在下一份勞資協議中，導入薪資上限制度的立場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450666.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-24 12:38", "link": "/news/story/6999/9834879"}]}, {"name": "棒球", "articles": [{"article_id": "9835199", "title": "中職／中信兄弟G5先發再換人！ 羅戈休4天再登板對決龍隊蔣銲", "date": "2026-10-24 16:59", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35451125.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9835199"}, {"article_id": "9834713", "title": "中職／平野惠一熱血喊話「希望能一起走下去」 兄弟迷感動：超像日漫台詞", "date": "2026-10-24 10:51", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/24/35450383.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9834713"}, {"article_id": "9833931", "title": "中職／因颱風一延再延 台灣大賽最新賽程出爐！若打到G7比賽地點未定", "date": "2026-10-23 20:42", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/23/35449418.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9833931"}, {"article_id": "9833898", "title": "中職／薔琵颱風打亂賽程！台北市繼續停班停課 台灣大賽G5再延至周日", "date": "2026-10-23 20:16", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/23/35449387.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9833898"}, {"article_id": "9833670", "title": "棒球／U23世界盃中華隊正式名單出爐 11名職棒球員參賽、林柏佑也入列", "date": "2026-10-23 17:02", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/23/35449067.png&M=1&s=Y&x=0&y=0&sw=865&sh=576&exp=3600&w=300", "link": "/ne