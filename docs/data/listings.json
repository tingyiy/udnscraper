rticles": [{"article_id": "9893847", "title": "西武獅台灣系列賽 傳奇對決", "summary": "「Kintone Presents 西武獅台灣系列賽 傳奇對決」將於明年二月廿七日、廿八日來台與統一7-ELEVEN獅、中信兄弟交手，其中廿八日賽後還加碼西武獅ＯＢ與中華ＯＢ傳奇對抗賽，門票熱銷中。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540936.jpg&M=1&s=Y&x=0&y=0&sw=1056&sh=704&exp=3600&sl=W&fw=360", "date": "2026-11-22 00:00", "link": "/news/story/7001/9893847"}, {"article_id": "9893746", "title": "關懷盃／第33屆賽事台東開幕62隊參賽 原棒協吉祥物黑皮小子俏皮亮相", "summary": "第33屆原棒協關懷盃棒球錦標賽今天進行開幕典禮，原棒協理事長林智勝率原棒協會員齊聚台東縣體育館，與台東縣長饒慶齡、原住民族委員會政務副主任委員陳義信等嘉賓，以及62支參賽隊伍齊聚一堂，共同為這場棒球豐年祭揭幕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540793.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 21:54", "link": "/news/story/7001/9893746"}, {"article_id": "9893718", "title": "棒球／世界身障棒球賽台灣中止跨屆5連敗 65歲郭耀宗是家人驕傲", "summary": "2026年世界身障棒球賽今天開打，台灣首戰不敵日本，第2戰以4比2擊敗波多黎各、中止跨屆5連敗；65歲郭耀宗為本屆最年長...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540764.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 21:42", "link": "/news/story/7001/9893718"}, {"article_id": "9893717", "title": "TPVL／從中原大學走向職業舞台！林謙盼桃園獵光雲豹首季留下難忘回憶", "summary": "桃園獵光雲豹靠輪替與心態調整拿下主場勝利，林謙逐步累積職業經驗，盼首季提升體能，在熟悉場館留下難忘回憶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540752.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 21:40", "link": "/news/story/7005/9893717"}, {"article_id": "9893489", "title": "PLG／獵鷹高國豪24分創本季新高 仍不敵勇士洋將強勢拉出3連勝", "summary": "富邦勇士靠克羅馬、馬可聯手攻下49分，擊敗台鋼獵鷹豪取3連勝；高國豪攻下本季新高24分，仍無力助獵鷹避免本季第2敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540470.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 19:25", "link": "/news/story/7003/9893489"}, {"article_id": "9893592", "title": "中職／哀宥宇二軍核炸認進步不如預期 赴日本冬盟練功不知餅總也要來", "summary": "統一獅隊19歲投手哀宥宇今年在二軍度過感受成長痛的賽季，讓他坦言「進步不如預期」，他在季後前往日本冬季聯盟練功，比賽將於明天在沖繩開打，總教練林岳平行前只問了一句話：「你什麼時候要丟？」哀宥宇說：「我也不知道。」事實上，林岳平將在明天出席開幕日，哀宥宇聽媒體提起才知道。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540527.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 19:00", "link": "/news/story/7001/9893592"}, {"article_id": "9893574", "title": "棒球／從數據追蹤到專家課程 日本冬季聯盟打造選手升級舞台", "summary": "第五屆日本冬季聯盟將在明天於沖繩開打，本屆超過150名以上選手參賽為史上最多，也包括中華職棒統一獅、中信兄弟隊推派選手參與，還有來自國立體育大學的投手吳祉恩、自行報名的游擊手曾泓銘，期盼透過這個舞台尋求生涯的躍進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540501.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:43", "link": "/news/story/7001/9893574"}, {"article_id": "9893555", "title": "中職／福島章太接受雄鷹測試 看台灣12強奪冠對中職產生興趣", "summary": "日籍投手福島章太接受中職台鋼雄鷹隊測試，提到2024年世界12強棒球賽看到台灣擊敗日本奪冠，對中職產生興趣，希望尋求合約...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540471.jpg&M=1&s=Y&x=0&y=92&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:30", "link": "/news/story/7001/9893555"}, {"article_id": "9893558", "title": "關懷盃／「我也是被幫助到大的」 林子偉正式投入關懷盃做回饋", "summary": "樂天桃猿隊內野手林子偉去年首度現身關懷盃，今年再次出現在台東，他自認這次才算是「第一次」參與，透過這樣的機會付出自己的一點心力，「我也是被幫助到大的，現在就會想要來回饋。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540469.jpg&M=1&s=Y&x=0&y=0&sw=1248&sh=832&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:25", "link": "/news/story/7001/9893558"}, {"article_id": "9893541", "title": "全國民俗運動匯演賽 曹子宏以鈴會友 古家姊妹特優 晉級全國決賽", "summary": "115年「全國民俗運動匯演賽」南區、北區預賽，今天（21日）在台南大學、淡江大學同步登場。北區方面，扯鈴名將曹子宏在社會男子組「個人賽舞台賽」獲得特優（49.90分排名第3），順利晉級下個月全國決賽。去年他在全國賽以最高分獲得特優，並於公開組「一對一對抗賽」擊敗日本選手津田真叶，勇奪冠軍。他表示，今年練習時間確實比較少，將以平常心應戰，「以鈴會友」，享受這項運動帶來的樂趣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540460.jpg&M=1&s=Y&x=0&y=64&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:13", "link": "/news/story/7005/9893541"}, {"article_id": "9893513", "title": "台鋼雄鷹與捷克交流賽 3日籍測試投手登板有觀察重點", "summary": "中職台鋼雄鷹隊今、明兩日安排與捷克交流賽，雄鷹隊陣中3名測試日籍投手都會上場，投手教練蕭任汶表示，阿部翔太、福島章太過去...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540458.jpg&M=1&s=Y&x=74&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:13", "link": "/news/story/7001/9893513"}, {"article_id": "9893511", "title": "中職／吳柏萱U23世界盃收穫多 難忘與雷皓博搭配勝日直呼熱血", "summary": "中職台鋼雄鷹隊捕手吳柏萱在U23世界盃棒球賽9場先發出賽，首度體驗短期連續場次出賽，更懂得如何調配體力，最難忘與雷皓博投...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540455.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:11", "link": "/news/story/7001/9893511"}, {"article_id": "9893519", "title": "NBA／唐西奇開季數據太驚人！15戰550分100籃板100助攻 史上最快", "summary": "湖人本季在唐西奇（Luka Doncic）帶領下展現強大競爭力，他本人更持續以驚人的得分能力改寫NBA歷史。在今天主場險勝國王的比賽中，唐西奇成為聯盟史上最快累積550分、100籃板、100助攻的球員，同時達成生涯1700記三分球里程碑，寫下令人難以置信的重要里程碑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540439.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:06", "link": "/news/story/7002/9893519"}, {"article_id": "9893516", "title": "關懷盃／王維中腳傷復原現身台東陪孩子 「讓他們喜歡棒球最重要」", "summary": "台鋼雄鷹隊34歲左投王維中今年6月底在比賽中造成左腳踝外側韌帶斷裂，球季提前報銷，今天他現身台東關懷盃，傷勢復原順利，預計能正常趕上明年春訓，他還笑說：「如果真的趕不上就轉一壘。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540434.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 18:00", "link": "/news/story/7001/9893516"}, {"article_id": "9893514", "title": "讓世界看見台灣 亞太天主教大學運動會輔大登場實踐在地國際化", "summary": "首屆「2026亞太天主教大學運動會」（APCUG 2026）明天將於輔仁大學正式開幕，來自9個國家及地區、20所大專校院、700多位選手，將齊聚台灣參與籃球、足球及桌球賽事。東道主輔大校長藍易振在賽前記者會表示，希望透過運動，讓各國青年共融相處，「讓世界看見輔大，透過輔大看到台灣。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540433.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 17:55", "link": "/news/story/7005/9893514"}, {"article_id": "9893508", "title": "TPBL／夢想家單場30次失誤平聯盟紀錄 簡浩：問題非常明顯", "summary": "本賽季展開衛冕之旅的福爾摩沙夢想家隊，開季卻接連遭遇打擊，在前3場比賽僅拿下1勝後，今天在主場迎戰來訪的高雄全家海神隊，全場又發生平聯盟紀錄的30次失誤，最終也以17分差距吞下敗仗，賽後總教練簡浩也直言，球隊需要修改的問題非常明顯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540426.jpg&M=1&s=Y&x=0&y=0&sw=1175&sh=783&exp=3600&sl=W&fw=360", "date": "2026-11-21 17:50", "link": "/news/story/7003/9893508"}, {"article_id": "9893505", "title": "NBA／湖人半場落後8分遭瑞迪克怒吼 唐西奇帶傷逆轉：我已經習慣了", "summary": "上半場落後8分、當家球星決勝節又意外傷到右眼，湖人這場NBA盃分組賽贏得格外驚險。所幸唐西奇（Luka Doncic）帶傷堅持打完比賽，湖人也在最後關頭展現更好的執行力，隨著國王球星拉文（Zach LaVine）錯失可能逆轉戰局的最後一擊，湖人最終以2分之差險勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540425.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 17:50", "link": "/news/story/7002/9893505"}, {"article_id": "9893486", "title": "TPBL／飆新高17分助海神退夢想家 賀丹：開季最健康一戰", "summary": "高雄全家海神隊今天作客福爾摩沙夢想家隊主場，在團隊共送出29次助攻並投進18記三分球下，最終以17分差距終止對戰夢想家的6連敗，也揮別前一次作客遭上演20分逆轉秀的陰影，賽後海神總教練齊科也直言，對戰夢想家本來就不是一件容易的事情，但球員今天將備戰的東西都應用到場上，成為贏球關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540403.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-21 17:36", "link": "/news/story/7003/9893486"}, {"article_id": "9893451", "title": "中職／阿部翔太獲多隊測試邀約 做完善準備盼延續球員生涯", "summary": "具日職資歷的投手阿部翔太到台鋼雄鷹測試，他表示希望延續選手生涯，透露除了雄鷹外，也有收到中職其他球隊測試邀約，生涯雖以長...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540392.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 17:25", "link": "/news/story/7001/9893451"}, {"article_id": "9893447", "title": "TPBL／蔣淯安26分獨木難支 海神18記三分球終止對戰夢想家6連敗", "summary": "TPBL戰績龍頭高雄全家海神隊在今天作客福爾摩沙夢想家隊主場下起三分雨，在團隊猛轟18記三分球下，整場比賽一路壓制進攻熄火的夢想家，最終海神就以107：90終止對戰夢想家的6連敗，並繼續坐穩戰績龍頭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540366.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 17:07", "link": "/news/story/7003/9893447"}, {"article_id": "9893411", "title": "NBA／快艇4勝10敗陷泥淖將迎曙光 英格倫預計下周復出", "summary": "開季至今始終在西區後段班苦苦掙扎的洛杉磯快艇，終於等到期待已久的好消息！根據報導，因阿基里斯腱部分撕裂而長期休養的明星前鋒英格倫（Brandon Ingram），預計將在美國時間11月23日對火箭的比賽中正式復出，這也是他今年9月透過重磅交易加盟快艇後，首度披上新東家戰袍出賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540261.jpg&M=1&s=Y&x=0&y=99&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-21 16:46", "link": "/news/story/7002/9893411"}, {"article_id": "9893364", "title": "射箭／亞洲盃女團摘銀 教練：節奏順暢可惜未反映分數", "summary": "射箭亞洲盃今天在中國杭州舉行各項目金牌戰，台灣反曲弓女團以0比6敗給中國，依舊帶回一面銀牌；教練吳蕙如表示，「其實選手的...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540263.jpg&M=1&s=Y&x=0&y=353&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-21 16:40", "link": "/news/story/7005/9893364"}, {"article_id": "9893404", "title": "NBA／爵士三劍客都「7中0」不敵太陽 勇士創21世紀紀錄後跌至西區第11", "summary": "太陽隊今天在客場以111：101擊退爵士隊，拉出一波3連勝，登上西區第9。今天沒有比賽的勇士隊跌至西區第11。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540255.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-21 16:36", "link": "/news/story/7002/9893404"}, {"article_id": "9893394", "title": "關懷盃／「我也是來找快樂的」 林靖凱久違現身盼從孩子身上找回自己", "summary": "原棒協關懷盃今年在台東舉行，今年在原棒協副理事長陳鏞基的大力號召之下，統一獅隊出動多位球員共襄盛舉，除了幾名多次參與的熟面孔外，包括朱迦恩、張翔、新秀王翾祐都是首次現身，內野手林靖凱則是暌違多年再次與會，他直呼「我也是來找快樂的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/21/35540225.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-21 16:24", "link": "/news/story/7001/9893394"}]}, {"name": "棒球", "articles": [{"article_id": "9893592", "title": "中職／哀宥宇二軍核炸認進步不如預期 赴日本冬盟練功不知餅總也要來", "date": "2026-11-21 19:00", "thumbnail": "https://pgw.udn.com.tw/