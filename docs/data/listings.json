{"全球": {"slider": [{"article_id": "9608769", "title": "關鍵一周…伊朗國葬期間 「美伊不交火」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107246.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600", "link": "/news/story/124061/9608769"}, {"article_id": "9608662", "title": "川普國慶演說：美國是贏家國度", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35107504.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600", "link": "/news/story/6813/9608662"}, {"article_id": "9608667", "title": "美最新民調 半數不相信「美國夢」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107236.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/6813/9608667"}, {"article_id": "9608774", "title": "雙普熱線 北約峰會前夕商討俄烏局勢", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107258.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/6809/9608774"}, {"article_id": "9608697", "title": "OPEC+將增產…油價有壓 華爾街警告：油市恐重返供給過剩", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104502.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/6811/9608697"}, {"article_id": "9608923", "title": "英廉航易捷航空原則同意賣身美資！估值55億英鎊 完成交易將下市", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35107552.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/6811/9608923"}], "subsections": [{"name": "最新文章", "articles": [{"article_id": "9608923", "title": "英廉航易捷航空原則同意賣身美資！估值55億英鎊 完成交易將下市", "summary": "英國廉價航空易捷航空（easyJet）周日（5日）宣布，原則上同意接受美國投資公司Castlelake提高後的收購提案，交易估值最高達55億英鎊（約73.4億美元）。若交易完成，這家成立31年的航空公司將下市、成為私有企業，可能改寫歐洲航空業版圖。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35107552.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 06:50", "link": "/news/story/6811/9608923"}, {"article_id": "9608672", "title": "美UFO檔案之謎／完全解密川普政府293份UFO檔案", "summary": "編按：檔案分析由本報記者洪欣慈與Claude AI Cowork協作完成。資料來源為美國國防部公開的三波UAP（不明異常現象，過去俗稱UFO）解密檔案，共計293件文件、影片與音訊；AI協助OCR（光學字元辨識，將文件裡的印刷或手寫內容轉成電腦文字）、語音轉錄、文字雲統計與地理時間分析等，所有文件引述均經人工核對原始檔案與公開史料。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_2.jpg", "date": "2026-07-06 05:01", "link": "/news/story/124068/9608672"}, {"article_id": "9608677", "title": "美UFO檔案之謎／公布UFO檔案 川普轉移美伊戰注意力", "summary": "在美國總統川普指示下，五角大廈今年5月及6月先後公布三批不明飛行物的機密檔案。雖然川普稱公開檔案是出於大眾對此展現的巨大興趣；衛報5月16日刊出專家觀點，卻認為除了與相信幽浮存在團體數十年持續施壓有關外，也與川普拉抬支持率有關。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_9.jpg", "date": "2026-07-06 05:01", "link": "/news/story/124068/9608677"}, {"article_id": "9608678", "title": "美UFO檔案之謎／UFO檔案能證明外星人存在？ 專家這樣看", "summary": "美國國防部近日公布三批「不明異常現象」（UAP）檔案，再次引發外星人存在的討論。然而，美國「科學美國人」雜誌專欄作家薛默日前投書華盛頓郵報，稱檔案有些為氣球、鏡頭效果或肉眼錯覺等一般地表現象，有些則為中國大陸或俄國的偵察機或無人機，僅有少部分與外星現象相關。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_0.jpg", "date": "2026-07-06 05:01", "link": "/news/story/124068/9608678"}, {"article_id": "9608697", "title": "OPEC+將增產…油價有壓 華爾街警告：油市恐重返供給過剩", "summary": "在中東石油恢復流動之際，石油輸出國組織與夥伴國（OPEC+）部長級會議5日同意，8月再次提高生產目標。若美伊和平協議持續有效，全球石油供給量將進一步增加，並加重油價下跌壓力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35104502.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 02:20", "link": "/news/story/6811/9608697"}, {"article_id": "9608698", "title": "紅海驚傳貨輪遇襲 中東航行安全添變數", "summary": "英國海事貿易行動辦公室（UKMTO）指出，紅海有一艘貨輪遭不明武裝份子攻擊。最新數據也顯示，公開沿著阿曼海岸通行荷莫茲海峽的船隻，數量在5日銳減，凸顯中東水域與荷莫茲海峽的航行安全增添變數。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_9.jpg", "date": "2026-07-06 02:19", "link": "/news/story/6811/9608698"}, {"article_id": "9608591", "title": "韓元新規 24小時交易上路 惟匯價貶至17年低點 當局嚴陣以待", "summary": "南韓外匯市場6日起正式實施韓元兌美元的24小時全天候交易，鬆綁1997年亞洲金融風暴後以來的外匯管制，反映南韓政策重心已轉為建立完全開放的貨幣市場，以吸引全球資金。但在韓元匯率貶至逼近2009年低點之際，這項政策也可能提高股匯市、甚至全國經濟所面臨的風險，當局嚴陣以待。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107119.jpg&M=2&s=Y&x=0&y=0&sw=1280&sh=825&exp=3600&sl=W&fw=360", "date": "2026-07-06 01:30", "link": "/news/story/6811/9608591"}, {"article_id": "9608593", "title": "投資原油期貨更容易了 芝交所下月推出每口10桶合約 金額約700美元", "summary": "全球最大衍生性金融產品交易商芝加哥商品交易所（CME）宣布，8月底將允許散戶將能以10桶為單位（目前金額約700美元）買賣西德州石油，且每日24小時全天候進行、全年無休，迎合美伊衝突吸引大量散戶押注油價波動的趨勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107124.jpg&M=3&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 01:28", "link": "/news/story/6811/9608593"}, {"article_id": "9608594", "title": "世足預測平台 交易量創高", "summary": "2026世界盃足球賽可望是史上規模最大的博弈賽事，預測平台受惠於此，6月交易量暴增，Polymarket更改寫單月歷史新高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_0.jpg", "date": "2026-07-06 01:28", "link": "/news/story/6811/9608594"}, {"article_id": "9608595", "title": "「川普帳戶」美國慶日推出", "summary": "美國為孩童設立投資帳戶的「川普帳戶」，在美國國慶日7月4日正式上路，為符合資格的新生兒提供一次性的1,000美元聯邦存款，並允許父母與其雇主能投入更多資金，希望提高孩童對理財的基礎認識。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_8.jpg", "date": "2026-07-06 01:28", "link": "/news/story/6813/9608595"}, {"article_id": "9608597", "title": "AI 股動盪 印度成避風港", "summary": "在人工智慧（AI）類股近來陷入動盪之際，之前錯失AI行情的印度股市，反而正贏得尋求避風港的投資人青睞。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_5.jpg", "date": "2026-07-06 01:27", "link": "/news/story/6811/9608597"}, {"article_id": "9608643", "title": "美高所得家長 走另類教育", "summary": "美國許多高所得家庭正捨棄傳統學校，為小孩尋求體制外的教育方式，這類學校強調生活技能、創業思維，以人工智慧（AI）為基礎的學習。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107144.jpg&M=1&s=Y&x=0&y=0&sw=1260&sh=840&exp=3600&sl=W&fw=360", "date": "2026-07-06 01:25", "link": "/news/story/6811/9608643"}, {"article_id": "9608744", "title": "京東方、康寧合攻三應用", "summary": "今年5月宣布與美國康寧公司就玻璃基封裝載板、鈣鈦礦和光互連新業務領域進行合作後，京東方董事長陳炎順透露，所有新的方向和新的賽道目前都已經展開技術交流、產品驗證，實打實地在落地推進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_3.jpg", "date": "2026-07-06 01:15", "link": "/news/story/6811/9608744"}, {"article_id": "9608769", "title": "關鍵一周…伊朗國葬期間 「美伊不交火」", "summary": "伊朗前最高領袖哈米尼國葬儀式自四日起展開，為期六天。五日哈米尼其中三個兒子在哈米尼及其他四名罹難親屬：孫女、女婿、女兒和次子的妻子靈柩前祈禱悼念。現任最高領袖、哈米尼次子穆吉塔巴尚未現身。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107246.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-06 00:00", "link": "/news/story/124061/9608769"}, {"article_id": "9608771", "title": "國安憂暗殺 穆吉塔巴缺席伊朗國葬", "summary": "五日是為期六天的前伊朗最高領袖哈米尼國葬儀式第二天。紐約時報四日報導，對於為何現任伊朗最高領袖穆吉塔巴仍未出席其父哈米尼的國葬儀式，主因是伊朗維安團隊擔憂以色列企圖暗殺穆吉塔巴或追蹤他的藏身處，因此未安排他出席。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_8.jpg", "date": "2026-07-06 00:00", "link": "/news/story/124061/9608771"}, {"article_id": "9608774", "title": "雙普熱線 北約峰會前夕商討俄烏局勢", "summary": "北約（ＮＡＴＯ）年度峰會將自七日起在土耳其首都安卡拉舉行前夕。美國總統川普與俄羅斯總統普亭四日通話近九十分鐘（一說為八十五分鐘），討論俄烏與伊朗相關情勢。烏克蘭總統澤倫斯基四日也說，他當天和川普通話，呼籲川普展現「美國決心」，協助結束俄國四年多來的侵烏戰爭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107258.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 00:00", "link": "/news/story/6809/9608774"}, {"article_id": "9608775", "title": "俄稱奪頓內次克樞紐 烏軍駁斥", "summary": "俄羅斯總統普亭三日宣稱奪取頓內次克工業中心及交通樞紐康斯坦丁諾夫卡。對此，烏克蘭總統澤倫斯基四日斥為謊言。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_2.jpg", "date": "2026-07-06 00:00", "link": "/news/story/6809/9608775"}, {"article_id": "9608662", "title": "川普國慶演說：美國是贏家國度", "summary": "四日是美國國慶日，適逢建國二五○周年，總統川普當晚在華府國家廣場發表約四十分鐘的國慶演說。他向美國人民喊話，「美國是一個贏家國度；我們會永遠屹立不搖，我們絕不讓國家陷落，我們永遠都是最好的」，並強調美國不會讓任何人奪走自由。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/06/35107504.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-06 00:00", "link": "/news/story/6813/9608662"}, {"article_id": "9608667", "title": "美最新民調 半數不相信「美國夢」", "summary": "法新社四日報導，美國建國二五○周年，美國人民在這天心情複雜，夾雜自豪、希望與愛國心，和對國家今後走向的疑慮及不安。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107236.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-06 00:00", "link": "/news/story/6813/9608667"}, {"article_id": "9608673", "title": "美前總統國慶感言…拜登：堅持憲法 歐巴馬：化解分歧", "summary": "在美國慶祝建國二五○周年之際，兩黨四位卸任總統：民主黨籍的拜登、歐巴馬及柯林頓和共和黨籍的布希，分別接受布希女兒珍娜訪問，分享他們的國慶感言。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_6.jpg", "date": "2026-07-06 00:00", "link": "/news/story/6813/9608673"}, {"article_id": "9608675", "title": "美國慶現場…哈德遜河軍艦遊行 搭配空中閱兵", "summary": "美東地區四日發布高溫的極端氣候警報，體感溫度可達攝氏四十一點七度，還颳暴風雨，但多項美國國慶日慶祝活動仍風雨無阻進行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_8.jpg", "date": "2026-07-06 00:00", "link": "/news/story/6813/9608675"}, {"article_id": "9608770", "title": "OPEC+允8月增產 恐供給過剩", "summary": "在中東石油恢復流動之際，石油輸出國組織與夥伴國（ＯＰＥＣ+）部長會議五日同意，八月再次提高生產目標。若代表美伊初步和平協議的十四點諒解備忘錄（ＭＯＵ）持續有效，全球石油供給量將進一步增加，並加重油價下跌壓力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_9.jpg", "date": "2026-07-06 00:00", "link": "/news/story/6811/9608770"}, {"article_id": "9608706", "title": "伊朗聲稱估將有1500萬人參加哈米尼國葬 部分民眾坦言不在意批誇大", "summary": "美國CNN報導，為了展現團結，伊朗稱預計將有1500萬人出席前最高領袖哈米尼的國葬，德黑蘭街頭5日也確實湧現哀悼人潮，但部分民眾坦言自己並不在乎，甚至質疑數據誇大。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/05/35107189.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-05 23:09", "link": "/news/story/6809/9608706"}, {"article_id": "960858