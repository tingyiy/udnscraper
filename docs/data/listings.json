?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327435.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/122629/9754113"}, {"article_id": "9754369", "title": "雷霆馬刺兩分天下 看好西區這三隊有可能扳倒這兩座大山", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327698.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9754369"}, {"article_id": "9751740", "title": "日職／巨人洋將守護神強勢追趕 岩瀨仁紀起步晚錯失史上500救援第一人", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/13/35323596.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9751740"}, {"article_id": "9751705", "title": "中職／張家兄弟命運大不同 張進德、張偉聖浮現生存危機", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/13/35323472.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9751705"}, {"article_id": "9751874", "title": "美聯塞揚競爭白熱化：斯萊特勒穩居王座 希斯還有機會逆轉嗎？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/13/35323951.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9751874"}]}, {"name": "最新文章", "articles": [{"article_id": "9754807", "title": "NBA／快艇違規風波正式落幕 雷納德確定重返暴龍還放棄交易補償金", "summary": "在歷經聯盟調查與懲處後，快艇與暴龍總算達成協議，正式重啟並完成當家球星雷納德（Kawhi Leonard）重返多倫多的重磅交易案，雙方隨後將與聯盟進行官方交易電話會議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328211.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 07:49", "link": "/news/story/7002/9754807"}, {"article_id": "9753748", "title": "36歲球速沒變快卻投更好 格雷到波士頓究竟改了什麼？", "summary": "36歲格雷加盟紅襪後調整球路配置，防禦率降至2.69、拿下17勝，躍升賽揚獎討論；惟明年選擇權與退休可能性讓續留生變。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326825.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 07:00", "link": "/news/story/122629/9753748"}, {"article_id": "9754113", "title": "中職／831後洋投都出狀況 統一、悍將卻分處天堂與地獄", "summary": "831洋將大限後，統一洋投銳力獅受傷仍靠其餘王牌撐住，9月7勝2敗；富邦洋投失常、打擊低迷，僅4勝6敗落後統一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327435.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-15 07:00", "link": "/news/story/122629/9754113"}, {"article_id": "9754369", "title": "雷霆馬刺兩分天下 看好西區這三隊有可能扳倒這兩座大山", "summary": "勇士教練柯爾認為，雷霆、馬刺是西區未來數年兩座大山；勇士處於柯瑞、格林生涯末期的過渡期，金塊、灰狼、火箭有望挑戰霸主地位。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327698.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-15 07:00", "link": "/news/story/122629/9754369"}, {"article_id": "9754766", "title": "【專家之眼】美網之後球后易主，那男單呢？", "summary": "今年美網剛開戰時，去年單打冠軍前球王阿爾卡拉斯與球后莎芭蓮卡來勢洶洶，一路過關斬將，卻未能如願衛冕。阿卡傷後復出，表現依舊亮眼，卻在八強歷經五盤激戰後，爆冷敗給美國一哥謝爾頓；莎芭雖然順利殺進決賽，球后寶座卻已換給哈薩克的芮芭奇娜，兩人再度重演年初澳網的爭冠戲碼。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35328165.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-15 06:16", "link": "/news/story/121623/9754766"}, {"article_id": "9754389", "title": "中職／場上驚悚瞬間…莊昕諺強襲球濺血意外 IG報平安：我會沒事的", "summary": "樂天桃猿隊今天以2：1險勝台鋼雄鷹隊，場上發生驚悚瞬間，猿隊投手莊昕諺遭強襲球直擊臉部濺血，由擔架抬出場送醫，而他本人透過IG限時動態報平安：「大家不用擔心我，我會沒事的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327723.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 22:06", "link": "/news/story/7001/9754389"}, {"article_id": "9754388", "title": "中職／雄鷹近11戰8敗打悍將以外球隊全輸 桃猿邱駿威奪生涯首勝", "summary": "台鋼雄鷹隊上周末在主場3連戰橫掃富邦悍將隊，今天對手換成樂天桃猿隊，又進入熄火狀態，全場只有4安打，以1：2輸球，近11場比賽吞下8敗，輸給悍將以外的所有其他球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327720.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 22:06", "link": "/news/story/7001/9754388"}, {"article_id": "9754343", "title": "花式滑冰／「璃來龍」訂婚後首亮相放閃：希望美好地一起慢慢變老", "summary": "日本花式滑冰金牌組合「璃來龍」三浦璃來與木原龍一今天共同出席護膚品牌在東京舉辦的發表會，這是兩人自8月23日宣布訂婚後，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327668.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-14 21:24", "link": "/news/story/7005/9754343"}, {"article_id": "9754327", "title": "網球／約克維奇世界排名下滑 2002年以來前10首度缺三巨頭", "summary": "根據今天公布的網壇男單世界排名，塞爾維亞39歲名將約克維奇已從第5名跌至第12名，這是自2002年10月以來男網前10名...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327654.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 21:14", "link": "/news/story/7005/9754327"}, {"article_id": "9754308", "title": "永不停止國際溜冰超級馬拉松賽11月盛大回歸 首推8小時親子組", "summary": "曾掀起全台公路溜冰狂熱的「永不停止國際溜冰超級馬拉松賽」，將於11月29日在桃園大溪月眉中庄滯洪池周邊道路盛大回歸。有別於傳統錦標賽的封閉式繞圈，這是一場遠離車陣、結合落羽松絕美湖景的公路嘉年華。今年賽事更首度推出「8小時親子組」，號召家長與孩子共同挑戰，在湖光山色中重溫滑行的快樂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327627.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-14 20:52", "link": "/news/story/7005/9754308"}, {"article_id": "9754186", "title": "排球／東山寫登峰造極賽4連霸 豐商重返王座", "summary": "2026登峰造極青年排球邀請賽今天進行最後一天賽程，高中女子組東山高中歷經五局大戰，以3：2力克上海格致中學，完成邀請賽四連霸；高中男子組豐原高商以26：24、25：20、17：25、25：22扳倒華僑高中，繼2023年後再度登頂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327509.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 19:55", "link": "/news/story/7005/9754186"}, {"article_id": "9754133", "title": "中華民國縣市體育會聯合總會 鄭錦洲連任總會長許淑華擔任副手", "summary": "中華民國縣市體育會聯合總會12日召開「第七屆第一次會員代表大會」，進行新一屆理監事改選，現任總會長鄭錦洲獲得全體會員代表一致支持，高票連任。鄭錦州表示，全國健走、全國武藝展演及各縣市單項活動洲繼續辦理，而且非常感謝南投縣長許淑華全力支持。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327458.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 19:15", "link": "/news/story/7005/9754133"}, {"article_id": "9754099", "title": "排球／登峰造極賽高女東山四連后 高男豐商2023年後再封王", "summary": "登峰造極青年排球邀請賽落幕，東山高中五局擊敗上海格致，完成高中女排四連后；豐原高商力克華僑高中，繼2023年後再度封王。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327425.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 18:56", "link": "/news/story/7005/9754099"}, {"article_id": "9754086", "title": "NBA／尼克延攬波蘭天才前鋒 把握訓練營機會拚雙向合約", "summary": "衛冕冠軍紐約尼克在新賽季訓練營前持續補強陣容深度，根據波蘭媒體《Interia Sport》報導，尼克將與波蘭天才前鋒米利西奇（Igor Milicic Jr.）簽下「Exhibit 10」合約，讓這位歐洲戰力有機會在訓練營中爭取留隊位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327397.jpg&M=1&s=Y&x=0&y=38&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 18:39", "link": "/news/story/7002/9754086"}, {"article_id": "9753952", "title": "亞運女足／中華2比1險勝越南 預賽首戰開紅盤", "summary": "名古屋亞運中華女足今天分組賽首戰面對越南，靠著旅外好手蘇育萱、歸化球員若林美里先後進球，終場以2比1驚險取得勝利，替這次...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327194.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 17:32", "link": "/news/story/124981/9753952"}, {"article_id": "9753852", "title": "NBA／2027-28年賽季薪資上限調至1.76億美元 溫班亞瑪多賺290萬", "summary": "NBA已向各隊發出更新版2027-28年賽季薪資上限預估，最新預測金額來到1.76億美元（約新台幣56億元），比先前預估的1.74億美元（約新台幣55.3億元）再提高約200萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327038.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 17:03", "link": "/news/story/7002/9753852"}, {"article_id": "9753891", "title": "亞運女籃／羅蘋傷退 林蝶補進12人名單", "summary": "今天啟程名古屋的中華女籃隊，12人名單最後一刻異動，後衛羅蘋因傷退出，補進179公分的長人林蝶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2024/07/10/realtime/29977700.jpg&s=Y&x=0&y=30&sw=1685&sh=1122&exp=3600&sl=W&fw=360", "date": "2026-09-14 17:00", "link": "/news/story/124981/9753891"}, {"article_id": "9753850", "title": "MLB／洋基少主殺瘋了！斯萊特勒1.95防禦率宰制聯盟 布恩驚嘆：搞不好MVP", "summary": "洋基少主斯萊特勒（Cam Schlittler）今日在「地鐵大戰」面對大都會，繳出6局僅被敲1安、無失分並送出8次三振的強勢內容，率領球隊以2：0完封同城宿敵，拿下本季第14勝。賽後總教練布恩（Aaron Boone）都忍不住表示，斯萊特勒可能已打出MVP等級的球季。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326995.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 16:51", "link": "/news/story/6999/9753850"}, {"article_id": "9753793", "title": "亞運電競／英雄聯盟上屆奪銀 教練喊出目標：名次不能退步", "summary": "電子競技在上屆杭州亞運首次被列為正式競賽種類，中華隊在「英雄聯盟」打下銀牌好成績，連莊名古屋亞運的教練陳如治今天媒體日喊出目標，他強調不希望「退步」，設定至少追平上屆成績，進而挑戰頒獎台最高位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326899.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 16:10", "link": "/news/story/124981/9753793"}, {"article_id": "9753787", "title": "運動部修正兩岸運動交流處理規範 國人不得代表中國出賽", "summary": "運動部今天透過聲明表示，修正發布「兩岸運動交流處理規範」，明確規範國人不得擔任中國大陸國家代表隊選手參加國際賽事，宣示兩...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326902.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-14 16:09", "link": "/news/story/7005/9753787"}, {"article_id": "9753729", "title": "MLB／道奇「喪鐘」變「走鐘」！狄亞茲0.2局狂失5分 鄧愷威同場3上3下", "summary": "身價高達22億台幣的道奇終結者迪亞茲（Edwin Díaz），今日在3A復健賽徹底「炸裂」，中繼僅投0.2局就狂失5分，30球更只有13顆好球，不僅成為全隊唯一失分的投手，最終還吞下敗投。更尷尬的是，同場登板的台灣投手鄧愷威反而繳出三上三下的完美一局，形成強烈對比。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326773.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-14 15:46", "link": "/news/story/6999/9753729"}, {"article_id": "9753701", "title": "桃園盃／ 北市長安國中青少棒賽奪冠 斷地主新明連霸夢", "summary": "桃園盃青少棒賽冠軍戰，北市長安國中蘇敬恩6局敲出超前比數安打，後援投3局1責失分，率隊以4比3擊敗桃園新明國中奪冠，讓新...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326789.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-14 15:45", "link": "/news/story/7001/9753701"}, {"article_id": "9753659", "title": "MLB／道奇投手帽子為何多了「E.F.」？背後隱藏911恐攻希恩家族的傷痛", "summary": "道奇投手希恩（Emmet Sheehan）今日面對馬林魚繳出6局無失分好投，不過比起場上的成績，他頭上那頂帽子背後的故事，或許才是這場比賽對他而言最重要的意義。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326641.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-14 15:37", "link": "/news/story/6999/9753659"}, {"article_id": "9753697", "title": "健身運動／HYROX澳選手失禁奪冠爭議延燒 官方認規範模糊仍譴責暴力威脅", "summary": "HYROX北京站女子精英組賽事日前爆發爭議，澳洲女選手喬安娜（Joanna Wietrzyk）在比賽途中發生失禁狀況，身上與部分賽道、共用器材疑似沾有排泄物，卻仍繼續完成比賽並最終奪冠。事件曝光後，引發外界對賽事衛生、裁判處置與公平性的討論。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326754.jpg&M=1&s=Y&x=64&y=0&sw=1124&sh=749&exp=3600&sl=W&fw=360", "date": "2026-09-14 15:33", "link": "/news/story/7005/9753697"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9753952", "title": "亞運女足／中華2比1險勝越南 預賽首戰開紅盤", "date": "2026-09-14 17:32", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327194.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9753952"}, {"article_id": "9753584", "title": "亞運棒球／旅美球員黃仲翔球團沒放行 兄弟新秀投手黃玠瀚遞補", "date": "2026-09-14 14:40", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326518.jpg&M=1&s=Y&x=285&y=74&sw=937&sh=624&exp=3600&w=300", "link": "/news/story/124981/9753584"}, {"article_id": "9753891", "title": "亞運女籃／羅蘋傷退 林蝶補進12人名單", "date": "2026-09-14 17:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2024/07/10/realtime/29977700.jpg&s=Y&x=0&y=718&sw=1685&sh=1122&exp=3600&w=300", "link": "/news/story/124981/9753891"}, {"article_id": "9753793", "title": "亞運電競／英雄聯盟上屆奪銀 教練喊出目標：名次不能退步", "date": "2026-09-14 16:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326899.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124