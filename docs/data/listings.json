://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35547631.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&w=300", "link": "/news/story/122629/9896894"}, {"article_id": "9896592", "title": "從火箭MVP到本季再轟51分 哈登不當得分王反而更接近冠軍？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35545611.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9896592"}, {"article_id": "9897021", "title": "向下沈淪一言難盡 墨瑞喊「賣我」成壓垮鵜鶘最後稻草", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35546242.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9897021"}]}, {"name": "最新文章", "articles": [{"article_id": "9907582", "title": "NBA／湖人領先20分遭逆轉！馬刺找回三分準星 外卡挺進NBA盃淘汰賽", "summary": "馬刺克服上半場三分球12投2中的低迷手感，靠著第三節火力爆發扭轉全場一度落後20分的巨大劣勢，靠著卡瑟爾（Stephon Castle）終場前43.4秒轟進關鍵三分球取得6分領先，即便里夫斯回敬外線，馬刺仍是在歷經苦戰後以99比96驚險勝出。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562617.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 13:57", "link": "/news/story/7002/9907582"}, {"article_id": "9907563", "title": "棒球／穿林安可球衣投票可能觸法！關鍵在有拉票行為最高罰500萬元", "summary": "九合一大選投票日，中選會提醒，穿戴可能讓人聯想到候選人的服飾恐違規，違者可能被請離投開票所，拉票最高罰500萬元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562589.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-28 13:54", "link": "/news/story/7001/9907563"}, {"article_id": "9907535", "title": "MLB／分享與在宇宙道奇心得 金慧成：眾星雲集但只有克蕭是神！", "summary": "金慧成受訪表示，道奇休息室雖眾星雲集，但僅克蕭讓他感到如來自另一個世界；大谷、貝茲與弗里曼則像朋友般自然。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562570.jpg&M=1&s=Y&x=0&y=0&sw=1256&sh=837&exp=3600&sl=W&fw=360", "date": "2026-11-28 13:41", "link": "/news/story/6999/9907535"}, {"article_id": "9907565", "title": "日職／養樂多畫伯誕生！5選手畫吉祥物 最有靈魂作品奪冠還要商品化", "summary": "日本職棒養樂多燕子隊今天舉辦球迷感恩會，今年活動中考驗選手繪畫實力，25歲內野手長岡秀樹筆下畫出的吉祥物燕美，既沒燕子樣、也沒胖企鵝樣，本人卻很驕傲：「只有我畫了全身！」長岡秀樹最終奪冠，球團宣布他的畫作將商品化，他當場回應：「我不會買。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562573.jpg&M=1&s=Y&x=0&y=222&sw=900&sh=600&exp=3600&sl=W&fw=360", "date": "2026-11-28 13:40", "link": "/news/story/7001/9907565"}, {"article_id": "9907468", "title": "NBA／湖人豪賭凱斯勒收成效！ 唐西奇承認對球團親下指導棋", "summary": "唐西奇親自向湖人高層點名要來凱斯勒，球團雖付出沉重選秀資產與高額合約，但他開季即以攻防統治力證明身價。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562495.jpg&M=1&s=Y&x=0&y=53&sw=1200&sh=800&exp=3600&sl=W&fw=360", "date": "2026-11-28 13:05", "link": "/news/story/7002/9907468"}, {"article_id": "9907489", "title": "NBA／灰熊攻勢爆發力壓殘陣灰狼！9戰8勝搶下NBA盃分組第一", "summary": "少了愛德華（Anthony Edwards）與小鮑爾（LaMelo Ball）兩大後場主力，灰狼仍在第三節一度完成逆轉，但決勝節還是擋不住灰熊的猛烈攻勢。灰熊靠著考沃德（Cedric Coward）攻下22分，以及第四節開局一波21比6的攻勢重新掌握戰局，最終以114比109擊敗灰狼，成功拿下NBA盃西區B組龍頭，近期9場比賽更豪取8勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562449.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 12:48", "link": "/news/story/7002/9907489"}, {"article_id": "9907472", "title": "NBA／率76人首闖NBA盃淘汰賽 詹姆斯坦言自身與團隊狀況良好", "summary": "76人隊今天在NBA盃分組賽最後一天賽程中，以24分差距大勝溜馬隊，收下隊史首張NBA盃淘汰賽門票，且開季前20場比賽拉出16勝，也創下球隊近25年來的最佳開局，賽後攻下21分、7籃板、6助攻的詹姆斯（LeBron James）就表示，儘管開季還不到2個月，但自己與球隊狀態都相當不錯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562431.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-28 12:36", "link": "/news/story/7002/9907472"}, {"article_id": "9907464", "title": "響應國際身心障礙者日 「2026動島嘉年華」國父紀念館盛大登場", "summary": "為響應國際身心障礙者日，運動部於今天起一連兩天，在國立國父紀念館前廣場盛大舉辦「2026國際身心障礙日－動島嘉年華 Move Island」。活動以「動無礙、共未來」為核心精神，開幕式由「伊甸基金會極限輪椅舞團」以充滿力與美的演出震撼揭幕；運動部部長李洋與活動代言人夏嘉璐及與會貴賓共同啟動「點亮共融光球」儀式，更現場坐上運動輪椅體驗輪椅羽球，以實際行動號召民眾認識適應運動、感受運動平權價值。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562411.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 12:29", "link": "/news/story/7005/9907464"}, {"article_id": "9907461", "title": "NBA／熱火贏球後教頭才知沒晉級 尼克衛冕夢碎布朗森很沮喪", "summary": "熱火隊今天在NBA盃分組賽最後一場比賽以3分差距險勝尼克隊，粉碎了尼克挑戰NBA盃2連霸的美夢，至於熱火雖然贏球，但總教練史波史特拉（Erik Spoelstra）卻是在賽後才得知，在比較勝負分差後，仍無法取得東區外卡資格，讓他直言相當失望。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562429.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 12:26", "link": "/news/story/7002/9907461"}, {"article_id": "9907421", "title": "NBA／老鷹大逆轉搶下NBA盃分組第一 塞爾蒂克26次失誤崩盤仍奪外卡", "summary": "面對塞爾蒂克，老鷹一度落後多達15分，卻在第三節末段打出20比4攻勢扭轉戰局，最後靠著亞歷山大-華克（Nickeil Alexander-Walker）在決勝時刻連拿4分，在客場以87比86險勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562341.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 12:08", "link": "/news/story/7002/9907421"}, {"article_id": "9907400", "title": "NBA／斑馬、唐西奇MVP競爭激烈！前雷霆球星逆風挺：SGA才是最強", "summary": "溫班亞馬、唐西奇開季強勢爭MVP，前雷霆球星費爾頓仍力挺衛冕者亞歷山大，認為他才是當今NBA最強球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562344.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 12:08", "link": "/news/story/7002/9907400"}, {"article_id": "9907367", "title": "NBA／活塞謹慎保護康寧漢膝傷 板凳部隊狂轟60分逆轉公鹿", "summary": "開賽不到多久就落後16分，3名先發主力又因傷缺陣，底特律活塞卻靠著板凳奇兵上演精彩逆轉。今天NBA盃分組賽面對密爾瓦基公鹿，活塞在首節陷入苦戰，總教練比克斯塔夫（J.B. Bickerstaff）甚至一口氣撤下所有先發球員，沒想到替補陣容成功扭轉戰局，全場合力攻下60分，最終以113比98擊敗公鹿，並以3勝1敗奪下東區A組龍頭，取得淘汰賽主場優勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562250.jpg&M=1&s=Y&x=0&y=30&sw=1105&sh=737&exp=3600&sl=W&fw=360", "date": "2026-11-28 11:34", "link": "/news/story/7002/9907367"}, {"article_id": "9907363", "title": "MLB／日本3大入札球星全開獎 伊藤大海加盟小熊與佐藤輝明當隊友", "summary": "今年透過入札制度挑戰大聯盟的日職球星陸續完成簽約，最後一人今天開獎，根據美國媒體報導，火腿隊王牌伊藤大海據傳已和小熊隊達成簽約共識，具體合約內容尚未公開，將與阪神隊強打佐藤輝明並肩作戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562246.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-28 11:30", "link": "/news/story/6999/9907363"}, {"article_id": "9907290", "title": "MLB／鄭宗哲無權拒絕下放！ 封館在即下一步短期恐難明朗", "summary": "鄭宗哲遭老虎指定讓渡，距勞資協議到期僅四天；若未被交易或認領，將無權拒絕下放小聯盟，留在老虎體系效力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562239.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 11:25", "link": "/news/story/6999/9907290"}, {"article_id": "9907345", "title": "NBA／詹姆斯21分6助攻領軍 76人退溜馬隊史首闖NBA盃淘汰賽", "summary": "NBA盃分組賽最後一天賽程，競爭激烈的東區B組，76人隊在今天只要擊敗溜馬隊就能晉級到淘汰賽的情況下，靠著詹姆斯（LeBron James）全場21分、7籃板、6助攻領軍5人得分上雙下，76人以111：87擊敗溜馬，隊史首度闖進到NBA盃淘汰賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562230.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-28 11:15", "link": "/news/story/7002/9907345"}, {"article_id": "9907326", "title": "世界盃男籃／克羅埃西亞睽違13年重返舞台 德國攜手波蘭晉級", "summary": "克羅埃西亞今天在小組賽以80比69擊敗波蘭，成功搶下一張世界盃門票，結束長達13年的等待。另一方面，德國也在客場以78比76險勝拉脫維亞，提前確定晉級資格，並且間接幫助波蘭鎖定門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562177.jpg&M=1&s=Y&x=0&y=0&sw=1156&sh=771&exp=3600&sl=W&fw=360", "date": "2026-11-28 11:09", "link": "/news/story/7003/9907326"}, {"article_id": "9907223", "title": "MLB／不能比佐藤輝明便宜！ 鈴木誠也仍吸引費城人等5隊競價", "summary": "鈴木誠也經紀團隊尋求超越佐藤輝明1.2億美元保障合約，本季繳出26轟、86打點，費城人等隊有意競逐。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562034.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 10:59", "link": "/news/story/6999/9907223"}, {"article_id": "9907298", "title": "NBA／安戴托昆波22分23籃板 熱火粉碎尼克NBA盃衛冕夢", "summary": "NBA盃分組賽最後一日賽程，東區競爭最激烈的B組進行兩場關鍵戰役，其中熱火隊與NBA盃上屆冠軍尼克隊正面交鋒，一路落後的尼克雖然在第四節一度逆轉戰局，但比賽最後階段卻出現致命防守失誤，讓熱火最終以108：105取勝，尼克也確定無緣淘汰賽與NBA盃衛冕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562154.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 10:58", "link": "/news/story/7002/9907298"}, {"article_id": "9907267", "title": "亞太天主教大學運動會圓滿落幕 輔大讓世界看見台灣熱情", "summary": "首屆亞太天主教大學運動會落幕，輔大男、女籃雙雙奪金；逾700名選手來自9國及地區20校，六天完成263場賽事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562104.jpg&M=1&s=Y&x=170&y=0&sw=936&sh=624&exp=3600&sl=W&fw=360", "date": "2026-11-28 10:50", "link": "/news/story/7227/9907267"}, {"article_id": "9907270", "title": "MLB／投手破億合約有人奪99勝有人拿1勝 美媒評最賺與最慘都是國民", "summary": "史庫柏（Tarik Skubal）以9年4.5億美元（約台幣149億元）落腳大都會隊，簽下史上最大投手合約，這筆投資成果成功或失敗，必須等待時間驗證。TheAthletic網站作家史塔克（Jayson Stark）回顧過往投手億級合約，列名最佳與最差的5筆簽約，薛則（Max Scherzer）榮登最優，史特拉斯堡（Stephen Strasburg）則是最慘烈，而兩筆合約都是國民隊所簽的。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562124.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 10:47", "link": "/news/story/6999/9907270"}, {"article_id": "9907242", "title": "NBA／馬刺湖人頂上決戰各自迎接好消息 三大主力傷癒回歸", "summary": "NBA盃賽事迎來西區強權正面交鋒，湖人與馬刺不僅要爭奪關鍵勝利，更將迎回各自的重要戰力。湖人後衛里夫斯（Austin Reaves）因左腳跟傷勢連續缺席5場後正式復出，而且不再受到上場時間限制；馬刺則迎回福克斯（De'Aaron Fox）與哈波（Dylan Harper）兩名後場主力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562079.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 10:43", "link": "/news/story/7002/9907242"}, {"article_id": "9907258", "title": "MLB／鈴木誠也拚日本野手最大約 喊價超越佐藤輝明1.2億美元", "summary": "小熊隊以6年1.2億美元（約台幣39億元）合約簽下27歲日籍強打佐藤輝明，期待他能補起鈴木誠也成為自由球員離隊後的火力空缺，這也讓鈴木誠也經紀團隊已向各隊表示，要尋求一份保障金額超越佐藤輝明的合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562085.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 10:40", "link": "/news/story/6999/9907258"}, {"article_id": "9907138", "title": "MLB／高橋光成旅美成功今年日職第3人 剩火腿王牌等待入札", "summary": "西武王牌右投高橋光成行使海外FA成功，與響尾蛇達成1年300萬美元合約，正式挑戰大聯盟；他本季在日職繳出9勝6敗、防禦率2.54。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35561974.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 10:23", "link": "/news/story/6999/9907138"}, {"article_id": "9907109", "title": "MLB／3.5億美元合約先放夢裡 奇森姆1年2000萬美元加盟藍鳥揮別洋基", "summary": "奇森姆（Jazz Chisholm Jr.）新東家傳定案，藍鳥隊與他簽下一年2000萬美元合約，附帶的2028年選擇權，最多可讓他的合約總值衝到5850萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35561848.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-28 09:39", "link": "/news/story/6999/9907109"}]}, {"name": "棒球", "articles": [{"article_id": "9907563", "title": "棒球／穿林安可球衣投票可能觸法！關鍵在有拉票行為最高罰500萬元", "date": "2026-11-28 13:54", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562589.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9907563"}, {"article_id": "9907062", "title": "黑豹旗／劉任右比賽中拿手機拍場內惹議 行銷公司認害選手違規道歉了", "date": "2026-11-28 08:49", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562011.jpg&M=1&s=Y&x=0&y=238&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9907062"}, {"article_id": "9907565", "title": "日職／養樂多畫伯誕生！5選手畫吉祥物 最有靈魂作品奪冠還要商品化", "date": "2026-11-28 13:40", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/28/35562573.jpg&M=1&s=Y&x=0&y=222&sw=900&sh=600&exp=3600&w=300", "link": "/news/story/7001/9907565"}, {"article_id": "9906614", "title": "12強賽／中國全場僅1安0：1遭英國完封 想晉級可能又要算數學", "date": "2026-11-27 21:32", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/27/35561124.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9906614"}, {"article_id": "9906127", "title": "日職／盼織田翔希取消旅美 巨人隊提