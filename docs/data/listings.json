dn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/02/35287340.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9728515"}, {"article_id": "9728518", "title": "中職／為陳鏞基最後一舞奪冠 「五成獅」不能再一成不變", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/02/35287347.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9728518"}]}, {"name": "最新文章", "articles": [{"article_id": "9737740", "title": "中職／生涯首次先發第4棒「來得太突然」 林澤彬：終於可以體驗一下", "summary": "富邦悍將隊昨天對上樂天桃猿隊，全場僅敲4支安打遭完封，今天打線變陣，全隊打擊狀況最佳的林澤彬生涯首度被排上先發第4棒，林澤彬坦言看到打序時很驚訝，他笑說：「打的時候感覺不會差太多，但看起來和感受，還是會有差。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35302158.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 16:05", "link": "/news/story/7001/9737740"}, {"article_id": "9737733", "title": "運動部／上任將滿一週年 李洋挑戰疊杯國手曝「揮汗有禮」有望加碼", "summary": "9月9日「國民體育日」即將登場，運動部推出一系列活動，除討論度高的「揮汗有禮」活動，今天在松山文創園區文化廣場舉辦國民體育日系列活動，運動部部長李洋親自下場，攜手名古屋亞運女排隊長廖苡任現場體驗主題展區，邀請全民一起走出家門，感受運動魅力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35302138.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-06 16:01", "link": "/news/story/7005/9737733"}, {"article_id": "9737669", "title": "MLB／ 睽違近1年奪勝投！菊池雄星6局0失分吐傷病煎熬：曾懷疑能不能回來", "summary": "本季飽受傷勢困擾的天使日籍左投菊池雄星，今日作客海盜先發6局0失分，幫助天使以6：1拿下勝利，自2025年9月25日後，睽違近一年再次成為勝投，賽後他也坦言自己曾懷疑今年究竟還能不能再次投球。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35302041.jpg&M=1&s=Y&x=0&y=0&sw=1234&sh=823&exp=3600&sl=W&fw=360", "date": "2026-09-06 15:39", "link": "/news/story/6999/9737669"}, {"article_id": "9737694", "title": "中職／起亞虎領隊稱台韓實力相當 沒簽下王彥程持續關注台灣好手", "summary": "韓職起亞虎隊領隊沈哉學今天現身台北大巨蛋，與關係友好的富邦悍將隊進行交流。對於透過韓職「亞洲外援」制度網羅台灣選手，沈哉學透露曾有意王彥程，「如果在台灣有優秀的選手，我們球隊也很想引進，目前也在積極尋找這樣的選手。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35302074.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 15:32", "link": "/news/story/7001/9737694"}, {"article_id": "9737684", "title": "美網／「教練說不用打滿五盤」 頭號種子澤瑞夫直落三闖第四輪", "summary": "前兩輪都打滿五盤才辛苦勝出，今年美網列男單頭號種子的德國名將澤瑞夫（Alexander Zverev）今天雖又打了一場跨日大戰，但打三盤就「收工」，以6：2、7：6（7：2）、6：2拍下智利塔比洛（Alejandro Tabilo），晉級第四輪。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35302078.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 15:20", "link": "/news/story/121623/9737684"}, {"article_id": "9737678", "title": "日職／小島大河、林安可聯手開轟 西武終止3連敗穩住洋聯第2", "summary": "西武隊作客福岡巨蛋，今天對軟銀隊進行3連戰最後一戰，旅日好手林安可全場5打數2安打，被三振1次，本季第8支全壘打出爐，西武終場5：2獲勝，不但避掉3連戰遭橫掃，也終止最近3連敗，穩住太平洋聯盟排名第2，落後軟銀6場勝差。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35302075.png&M=1&s=Y&x=0&y=61&sw=1237&sh=825&exp=3600&sl=W&fw=360", "date": "2026-09-06 15:18", "link": "/news/story/7001/9737678"}, {"article_id": "9737643", "title": "MLB／167次三振又如何？岡本和真生涯首度「鐵支」當勝利功臣", "summary": "今日藍鳥以4：3擊敗皇家，終結對皇家連續5個系列賽落敗的紀錄，日本重砲岡本和真更繳出大聯盟生涯至今最精彩的比賽之一，單場敲出生涯新高4支安打，貢獻2分打點，不僅展現招牌的強勁拉打能力，還打出了不太常見的攻擊方式。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35302004.jpg&M=1&s=Y&x=0&y=0&sw=1259&sh=839&exp=3600&sl=W&fw=360", "date": "2026-09-06 14:59", "link": "/news/story/6999/9737643"}, {"article_id": "9737606", "title": "網球／選手遠離家鄉征戰全球 毛孩成對抗孤獨的最佳隊友", "summary": "汪星人日益成為網球選手最受喜愛的應援夥伴，除了伴隨選手四處征戰，也登上網壇重要舞台，從選手休息區、訓練場地到頒獎台，都看...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301980.jpg&M=1&s=Y&x=0&y=28&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-06 14:30", "link": "/news/story/7005/9737606"}, {"article_id": "9737622", "title": "MLB／小熊超越洋基、國民率先200轟 戰績最強釀酒人卻在30隊墊底", "summary": "小熊隊作客邁阿密，今天又以6：5擊敗馬林魚隊，最近拚出3連勝，國聯外卡排名穩居榜首，指定打擊康佛托（Michael Conforto）3局上轟出致勝陽春砲，小熊成為大聯盟本季首支達到200轟的球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301969.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 14:13", "link": "/news/story/6999/9737622"}, {"article_id": "9737576", "title": "MLB／74打席全壘打荒破了！白襪誕生「30轟三巨頭」村上宗隆坦言：重點我們輸了", "summary": "儘管白襪今日以4：6不敵雙城，不過村上宗隆在經歷連續74個打席、近3周的全壘打荒後，首局面對布萊德利（Taj Bradley），在2好2壞後逮中92英里指叉球，以49度的仰角轟出左外野方向346英尺兩分砲，創下「生涯最高」紀錄，更收下本季第30轟，並坦言若打擊調整有望得到更好結果。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301889.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 13:56", "link": "/news/story/6999/9737576"}, {"article_id": "9737378", "title": "NBA／詹姆斯宣布攜手Polymarket！14秒神秘短片預告合作 粉絲卻怒了「別碰博弈」", "summary": "NBA傳奇球星詹姆斯（LeBron James）再有新動作，他近日在社群平台X發布一段僅14秒的神秘短片，預告將與預測市場平台Polymarket展開合作。雖然雙方尚未公布合作細節與金額，不過知情人士透露，這次合作預計將聚焦美式足球，完整內容最快本周進一步揭曉，然而本次合作預告卻引發部分粉絲不滿。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301609.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 13:50", "link": "/news/story/7002/9737378"}, {"article_id": "9737584", "title": "日職／林安可再轟軟銀投手上茶谷大河 本季第8轟助西武領先5分", "summary": "西武隊作客福岡巨蛋，今天對軟銀隊進行3連戰最後一戰，旅日好手林安可6局上轟出陽春砲，本季第8支全壘打出爐，幫助西武擴大到5：0領先。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301964.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-06 13:50", "link": "/news/story/7001/9737584"}, {"article_id": "9737467", "title": "NBA／不再只是「詹姆斯兒子」！布朗尼甘願在唐西奇、里夫斯身旁打無球", "summary": "經過前兩年的養成後，將邁入生涯第3季的布朗尼（Bronny James）坦言已清楚在唐西奇（Luka Dončić）與里夫斯（Austin Reaves）身邊該扮演什麼角色，並將「無球進攻」視為今年夏天強化的重點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301724.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 13:29", "link": "/news/story/7002/9737467"}, {"article_id": "9737448", "title": "NBA／打出生涯年卻離隊倒數？波特與籃網續約卡關 交易截止日前恐遭送走", "summary": "根據籃網隨隊記者史萊特（Erik Slater）與《紐約郵報》記者路易斯（Brian Lewis）報導，儘管前鋒波特（Michael Porter Jr.）上季打出生涯代表作，但隨著雙方續約談判仍存在明顯差距，波特很可能在新賽季交易截止日前離開。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301698.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 13:28", "link": "/news/story/7002/9737448"}, {"article_id": "9737496", "title": "亞青棒球賽／陳昱勛增加2球種、壯4公斤 力扛中華隊終結者", "summary": "亞洲青棒錦標賽7日開打，中華隊將由投手陳昱勛擔任終結者角色，集訓期間增重4公斤、投起球來更輕鬆；多練變速球、橫掃球，豐富...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301783.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:55", "link": "/news/story/7001/9737496"}, {"article_id": "9737487", "title": "美網／大坂直美苦戰3盤力退梅丹斯 連兩年挺進16強", "summary": "日本網球名將大坂直美今天在美國網球公開賽女子單打第3輪，以6比3、3比6、7比5，擊敗世界排名第20的比利時女將梅丹斯（...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301778.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:53", "link": "/news/story/121623/9737487"}, {"article_id": "9737455", "title": "MLB／艾德曼取代大谷開路先鋒 3分砲領軍道奇對國民5戰全勝", "summary": "大谷翔平連續缺席3場比賽，道奇隊今天在主場對國民隊之戰，艾德曼（Tommy Edman）繼續擔任第1棒，7局下轟出中右外野方向389英尺3分砲，成為逆轉戰局的關鍵全壘打，道奇終場以6：5獲勝，本季對戰國民5場全勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301758.jpg&M=1&s=Y&x=0&y=12&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:51", "link": "/news/story/6999/9737455"}, {"article_id": "9737491", "title": "美網／3小時激鬥 18歲地主新星拍落菲律賓人氣女將", "summary": "美網中央球場今天上演青春對決，18歲地主新星約維奇（Iva Jovic）和21歲菲律賓人氣女將艾亞拉（Alexandra Eala）大戰3小時03分鐘，約維奇才驚險以7：5、3：6、7：5挑進第四輪，讓她仰躺在地迎接突破時刻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301771.jpg&M=1&s=Y&x=0&y=15&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:39", "link": "/news/story/121623/9737491"}, {"article_id": "9737400", "title": "NBA／哈利伯頓穿小熊球衣「復仇」家鄉 開球遭網友狂酸：比投籃姿勢還醜", "summary": "溜馬球星哈利伯頓（Tyrese Haliburton）前天受邀到小熊主場，擔任對戰釀酒人的開球嘉賓，雖然最終看到小熊2：1擊敗自己從小支持的釀酒人，自己的開球表現卻意外成為網路上的笑點，遭不少球迷毫不留情開酸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301641.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:39", "link": "/news/story/7002/9737400"}, {"article_id": "9737386", "title": "MLB／比大谷、松井更年輕達標 村上宗隆菜鳥30轟創日本第一", "summary": "芝加哥白襪隊重砲手村上宗隆，今天在主場迎戰明尼蘇達雙城隊期間，首打席就敲出2分砲，成為第一個在MLB菜鳥賽季就繳出單季30轟的日本選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301752.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:37", "link": "/news/story/6999/9737386"}, {"article_id": "9737364", "title": "NBA／夏聯MVP替代巴特勒 勇士菜鳥倫德伯格有望扛先發3號", "summary": "勇士總教練柯爾（Steve Kerr）近日談到新賽季陣容時，透露在巴特勒巴特勒（Jimmy Butler）與穆迪（Moses Moody）可能長期缺席的情況下，身為今年第11順位新秀的倫德伯格（Yaxel Lendeborg），開季有望進入主要輪替，甚至被賦予比原先預期更重要的角色。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301717.jpg&M=1&s=Y&x=0&y=11&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:21", "link": "/news/story/7002/9737364"}, {"article_id": "9737384", "title": "亞青棒球賽／悍將「藍色力量」3新秀有望連線 不把職棒光環當壓力", "summary": "亞洲青棒錦標賽將於7日開打，中華隊陣中3名中職富邦悍將新秀陳柏凱、帕蘇拉．塔基斯利尼安與全永樂建立好交情，有望先發連線。...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301662.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 12:04", "link": "/news/story/7001/9737384"}, {"article_id": "9737422", "title": "中職／L.S.S.來2場悍將都輸球 現場找富邦大董敲通告「來到贏為止」", "summary": "韓流傳奇男團SUPER JUNIOR小分隊L.S.S.連兩年助陣富邦悍將隊主題日，看悍將已經看出感情來，隊長利特喊話會一直為了富邦悍將加油，始源更說會一直來，來到悍將贏球為止。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301658.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 11:48", "link": "/news/story/7001/9737422"}, {"article_id": "9737370", 