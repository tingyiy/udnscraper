"thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/20/35535682.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9889200"}, {"article_id": "9887012", "title": "中職／只投11局還能領百萬月薪 江少慶會否被獅隊戰力外？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/18/35530458.jpg&M=1&s=Y&x=0&y=0&sw=928&sh=619&exp=3600&w=300", "link": "/news/story/122629/9887012"}]}, {"name": "最新文章", "articles": [{"article_id": "9894927", "title": "NBA／國王菜鳥「無限開火權」引兩極評價 球探直言：他只是不想傳球", "summary": "以高居全聯盟第3的22.7次出手次數、每場轟下25.4分，國王菜鳥後衛艾卡夫（Darius Acuff Jr.）才剛踏入NBA，就展現令人驚豔的得分爆發力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542775.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 10:00", "link": "/news/story/7002/9894927"}, {"article_id": "9894914", "title": "NBA／防守能力超越90%球員！ 灰狼側翼悍將驚人數據曝光", "summary": "灰狼原本就是防守效率排名聯盟前10的球隊，近期透過陣容調整，讓整體防守戰力更上一層樓，加上陣中多名防守悍將的出色發揮，成功將球隊防守提升至近年未曾達到的高度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542760.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 09:30", "link": "/news/story/7002/9894914"}, {"article_id": "9895624", "title": "MLB／天價簽下史庫柏才剛開始 大都會還要砸錢補強先發投手", "summary": "兩屆塞揚獎史庫柏（Tarik Skubal）前天過30歲生日，今天就收到生涯最大份禮物，確定以9年4億5000萬美元合約加盟大都會隊，換算台幣高達148億3263萬；大都會官網直言「中了最大獎」，但這可能才剛開始而已，仍會繼續在自由球員市場尋求先發投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35543881.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 09:27", "link": "/news/story/6999/9895624"}, {"article_id": "9895608", "title": "NBA／活塞一哥打鐵只拿5分 老鷹第四節瘋狂攻勢逆轉奪4連勝", "summary": "老鷹隊今天打出瘋狂第四節攻勢，先打出一波18：0猛攻，單節更讓活塞僅拿12分，讓球隊扭轉最多13分落後，最終以107：97逆轉，在主場收下近期4連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35543878.jpg&M=1&s=Y&x=0&y=33&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 09:18", "link": "/news/story/7002/9895608"}, {"article_id": "9895606", "title": "ATP年終賽／阿爾卡拉斯退球王登頂 首度捧冠進帳破紀錄1.7億獎金", "summary": "連兩年打進ATP年終賽最終戰，西班牙「小蠻牛」阿爾卡拉斯（Carlos Alcaraz）今年沒再錯過金盃，今天凌晨決賽他以6：2、7：6（9：7）力退德國現任球王澤瑞夫（Alexander Zverev），生涯第一次在年終大賽捧冠，以本季第6座金盃為賽季完美告終。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35543891.jpg&M=1&s=Y&x=0&y=25&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 09:17", "link": "/news/story/7002/9895606"}, {"article_id": "9895604", "title": "MLB／史庫柏9年4.5億美元轉戰大都會 破投手合約總值最高紀錄", "summary": "兩屆塞揚左投史庫柏（Tarik Skubal）新東家開獎！根據大聯盟官網記者費恩森（Mark Feinsand）揭露的消息，大都會隊以9年、4.5億美元（約台幣142億元）的合約簽下史庫柏，寫下大聯盟史上投手合約總值最高紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35543880.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 09:17", "link": "/news/story/6999/9895604"}, {"article_id": "9894900", "title": "NBA／史上第13人征戰20季 霍福特揭長青秘訣：菜鳥時期就保養身體", "summary": "能夠在競爭激烈的NBA征戰20個球季，對絕大多數球員而言都是遙不可及的成就。勇士資深長人霍福特（Al Horford）本季正式成為聯盟史上第13位生涯橫跨20個賽季的球員，近日接受節目《Dubs Talk》訪問時，他坦言至今仍覺得這項成就有些不真實，並透露自己之所以能夠維持如此漫長的職業生涯，與父親從小灌輸的身體保養觀念有著密切關係，甚至從菜鳥球季開始，他就已經像資深老將一樣接受身體保養與治療。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542707.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 09:00", "link": "/news/story/7002/9894900"}, {"article_id": "9894911", "title": "NBA／有資格續簽1.43億美元合約 布里吉斯坦言：只想幫太陽贏球", "summary": "即使有機會爭取上億美元的大合約，鳳凰城太陽前鋒布里吉斯（Miles Bridges）仍不願讓金錢問題影響自己的場上表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542734.jpg&M=1&s=Y&x=86&y=42&sw=1194&sh=796&exp=3600&sl=W&fw=360", "date": "2026-11-23 08:30", "link": "/news/story/7002/9894911"}, {"article_id": "9894881", "title": "NBA／《俠盜獵車手6》引爆話題！湯普森當守法公民 隊友開飛機撞熱火主場", "summary": "等待長達13年，備受全球玩家期待的《俠盜獵車手6》（Grand Theft Auto VI，簡稱GTA6）終於正式推出，而以邁阿密為遊戲城市原型的設定，也讓邁阿密熱火成為這波電玩熱潮的焦點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542663.jpg&M=1&s=Y&x=2&y=39&sw=1110&sh=740&exp=3600&sl=W&fw=360", "date": "2026-11-23 08:00", "link": "/news/story/7002/9894881"}, {"article_id": "9895451", "title": "網球／生涯首度登頂年終賽 阿爾卡拉斯：為自己感到驕傲", "summary": "7座大滿貫賽冠軍得主阿爾卡拉斯（Carlos Alcaraz）今天以6比2、7比6（9/7）擊敗世界排名第一的澤瑞夫（Alexander Zverev），首度贏得ATP年終賽冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/23/35543930.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-23 07:00", "link": "/news/story/7005/9895451"}, {"article_id": "9894619", "title": "中職／3大年輕「台製潛水艇」國際賽發光 壓制左打未來才能發熱", "summary": "林柏佑U23世盃投9局無失分奪防禦率王，與陳宇宏、陳世展並列中職三大下勾投手；能否在中職站穩，關鍵在控球及壓制左打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542170.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-23 07:00", "link": "/news/story/122629/9894619"}, {"article_id": "9894636", "title": "道奇用兩名普通球員就換來雙城前狀元 這帳是怎麼算的？", "summary": "雙城送走前狀元路易斯，換回道奇右投米勒與捕手艾斯皮諾薩；路易斯近況低迷且傷病纏身，道奇看中其內野多功能與對左投能力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542228.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 07:00", "link": "/news/story/122629/9894636"}, {"article_id": "9894636", "title": "道奇用兩名普通球員就換來雙城前狀元 這帳是怎麼算的？", "summary": "雙城送走前狀元路易斯，換回道奇右投米勒與捕手艾斯皮諾薩；路易斯近況低迷且傷病纏身，道奇看中其內野多功能與對左投能力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542228.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-23 07:00", "link": "/news/story/122629/9894636"}, {"article_id": "9895134", "title": "HBL／能仁51分差奪勝晉級12強 北市成功逆轉淘汰泰山闖複賽", "summary": "115學年度HBL男子組16強預賽今天進行完第三日賽程，各組戰況更加明朗，C組南山高中以2連勝提前晉級後，能仁家商跟進以51分差轟下首勝，兩隊相繼搭上12強複賽列車，彰縣成功與東泰高中也都無懸念提前以2連勝晉級；北市成功則是扭轉最多落後17分劣勢，最終以96：94逆襲擊敗泰山高中，奪下B組最後一張12強入場券，淘汰掉曾經的冠軍隊伍泰山。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35543079.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-22 22:20", "link": "/news/story/7003/9895134"}, {"article_id": "9895084", "title": "教宗、副總統蕭美琴賀電祝福 亞太天主教大學運動會輔大隆重開幕", "summary": "首屆亞太天主教大學運動會在輔大開幕，9國及地區20校約700名選手參賽，教宗良十四世與副總統蕭美琴致賀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542992.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-22 21:39", "link": "/news/story/7005/9895084"}, {"article_id": "9894924", "title": "PLG／高國豪飆32分、李盛新三度暴扣 獵鷹逆轉賞領航猿開季4連敗", "summary": "台南台鋼獵鷹隊的新成員高國豪和新秀李盛新，今天在成功大學中正堂主場聯手，高國豪狂轟加盟獵鷹的新高32分，其中12分集中在決勝節，李盛新則是放送灌籃秀，下半場三度暴扣，包括最後4秒灌進保險分，助隊以97：94賞給衛冕軍桃園璞園領航猿開季4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542767.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-22 19:37", "link": "/news/story/7003/9894924"}, {"article_id": "9894902", "title": "棒球／世界身障棒球賽 台灣1勝3敗連兩年第5作收", "summary": "2026年「第六屆世界身體障害者野球大賽」（世界身障棒球賽）22日在日本福岡北九州市民球場進行最後一天賽程，我國代表隊先後以3：4與0：3不敵美國與南韓，連兩屆第5名作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542709.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-22 19:16", "link": "/news/story/7001/9894902"}, {"article_id": "9894858", "title": "NBA／女神賽琳娜親臨觀戰！ 溫班亞瑪轟50分還耍帥：當然要好好表現", "summary": "場邊出現一位特別嘉賓，讓溫班亞瑪（Victor Wembanyama）打得更加起勁！", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542616.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-22 18:50", "link": "/news/story/7002/9894858"}, {"article_id": "9894863", "title": "UBA／宇宙政大狂轟隊史新高141分 77分血洗中原奪跨季77連勝", "summary": "115學年度富邦人壽UBA大專籃球聯賽男一級預賽第一階段，尋求七連霸的「宇宙政大」，昨天破百大勝臺科大，主帥陳子威公開向子弟兵喊話「大二學弟跳出來」，今天開季第三戰徐得祈再飆23分，另送出平生涯最多的12助攻活絡攻勢，12人都得分8人上雙，含4名「大二」，141：64輕取中原大學。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542611.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-22 18:45", "link": "/news/story/7003/9894863"}, {"article_id": "9894857", "title": "關懷盃／化仁陳科睿繳生涯首場完封勝 趁陽念希返校練習在旁「偷學」", "summary": "花蓮化仁國中今天在關懷盃面對上屆亞軍花蓮三民國中，高三投手陳科睿請纓完投，最終以7局僅被敲3支安打出色表現，率隊以5：0完封對手，挺進8強，投出生涯首場完封勝，陳科睿賽後也笑說很開心，「對三民比較興奮，如果投贏他們會很驕傲。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542602.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-22 18:38", "link": "/news/story/7001/9894857"}, {"article_id": "9894852", "title": "回母校輔大服務 划船國手黃義婷參與亞太天主教大學運動會", "summary": "兩屆奧運划船國手黃義婷回母校輔大服務，參與首屆亞太天主教大學運動會籌備，投入行銷與媒體工作，兼顧教練與博士學業。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542588.jpg&M=1&s=Y&x=186&y=0&sw=1081&sh=721&exp=3600&sl=W&fw=360", "date": "2026-11-22 18:37", "link": "/news/story/7005/9894852"}, {"article_id": "9894836", "title": "NBA／絕殺戰術原本不是設計給他！布里吉斯揭最後一擊幕後真相", "summary": "從領先23分到終場前3.2秒反而落後2分，紐約尼克差點在主場上演本季最難堪的崩盤，沒想到整季飽受批評、關鍵時刻甚至經常被換下場的布里吉斯（Mikal Bridges），竟然成為拯救球隊的英雄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542551.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-22 18:24", "link": "/news/story/7002/9894836"}, {"article_id": "9894801", "title": "棒球／捷克隊為棒球犧牲一切 業餘球員逐夢登上國際賽奇蹟", "summary": "美國職棒大聯盟官網記者克雷爾（Michael Clair）曾多次跟隨捷克棒球國家隊採訪，今年他出版著作「We Sacri...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542553.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-11-22 18:24", "link": "/news/story/7001/9894801"}, {"article_id": "9894834", "title": "舉重／協會辦名古屋亞運慶功宴 理事長盼促和北韓交流", "summary": "中華民國舉重協會今天舉行第十四屆第二次理監事會議，同時舉辦名古屋亞運及寧波世錦賽的慶功宴，身兼中華奧運副主席的理事長廖裕輝，不但開心發紅包及獎勵金給得牌的選手、教練，同時也宣示說：「我接舉重協會的目的，就是在我任內，要讓舉重在奧運及亞運會能夠奪牌。」",