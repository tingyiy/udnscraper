0", "link": "/news/story/122629/9711009"}]}, {"name": "最新文章", "articles": [{"article_id": "9714953", "title": "NBA／八村壘曝國中曾被不良少年埋伏 「日本LBJ」出手拯救", "summary": "日本混血球星八村壘最近出演日本綜藝節目，談到學生時代受到「日本LBJ」馬場雄大的幫忙，避免受到不良少年騷擾。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35265427.jpg&M=1&s=Y&x=0&y=0&sw=908&sh=605&exp=3600&sl=W&fw=360", "date": "2026-08-26 12:04", "link": "/news/story/7002/9714953"}, {"article_id": "9714970", "title": "PLG／ 李家瑞續留新竹 轉戰洋基工程補齊鋒線深度", "summary": "PLG洋基工程隊今天宣布，正式簽下前鋒李家瑞，期待透過他優異的機動性與豐富賽事經驗，有效提升本土鋒線深度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35265434.png&M=1&s=Y&x=0&y=0&sw=636&sh=424&exp=3600&sl=W&fw=360", "date": "2026-08-26 12:03", "link": "/news/story/7003/9714970"}, {"article_id": "9714933", "title": "影／立院審電競基本法草案 李洋：不支持設單一項目專法", "summary": "立法院教育及文化委員會今天審查「電子競技運動發展基本法」草案。運動部部長李洋上午會前受訪明確表態，運動部立場始終如一，「不支持為任何單一運動項目設立專法或基本法」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35265371.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 11:56", "link": "/news/story/7005/9714933"}, {"article_id": "9714862", "title": "羽球／母親來自台灣！美新星陳翝櫟出身洛杉磯老球館 目標洛杉磯奧運", "summary": "18歲美國羽球新星陳翝櫟（Garret Tan）本屆世錦賽爆冷擊敗印度名將。他從小在洛杉磯郊區一間31年老球館打球，父母...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35265320.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-26 11:48", "link": "/news/story/7005/9714862"}, {"article_id": "9714790", "title": "MLB／三壘指偷暗號符合規則 響尾蛇教頭向小熊道歉：是我們錯了", "summary": "響尾蛇隊總教練羅夫洛（Torey Lovullo）因昨天比賽偷暗號爭議，向聯盟高層請教規則，他得知真相後認錯，並向小熊隊總教練康索（Craig Counsell）道歉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35265177.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 11:21", "link": "/news/story/6999/9714790"}, {"article_id": "9714697", "title": "沒罰站了！電競法審查再延宕 李洋重申不支持、將辦學生聯賽培育人才", "summary": "立法院教育及文化委員會今天排定「電子競技運動發展基本法草案」逐條審查，不過在民進黨立委提案認為行政部門已表明不支持立場以及委員會意見分歧下，最終表決通過將相關草案保留在委員會，另定期審議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35265023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 10:51", "link": "/news/story/7005/9714697"}, {"article_id": "9714679", "title": "NBA／威廉斯生涯年仍被勇士底薪拿下 美媒盛讚：聰明操作", "summary": "勇士隊今天在自由市場連續簽下後衛威廉斯（Brandon Williams）和前鋒尼恩（Georges Niang），勇士記者強森（Dalton Johnson）直呼簽下威廉斯是相當聰明的操作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264975.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 10:44", "link": "/news/story/7002/9714679"}, {"article_id": "9714633", "title": "MLB／葛拉斯諾復出5局7K無關勝敗 道奇9上送不回三壘的大谷斷6連勝", "summary": "道奇隊明星右投葛拉斯諾（Tyler Glasnow）因傷缺陣三個半月後回歸，今天客場對上勇士隊，先發5局飆7K失3分，無關勝敗；勇士8局下從道奇後援投手史考特（Tanner Scott）手中敲回致勝分，終場以4：3勝出，斷道奇6連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264909.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 10:24", "link": "/news/story/6999/9714633"}, {"article_id": "9714571", "title": "中職／羅戈妻子遭惡劣留言恐嚇 中信兄弟：將維護球員及家人安全", "summary": "中信兄弟隊洋投羅戈昨天面對樂天桃猿隊，主投5局失5分承擔敗投。賽後竟有不理性球迷到羅戈妻子的社群帳號留言攻擊，甚至發表「收錢打假球」、「全家很快死於車禍」等惡劣言論，羅戈發聲反擊，兄弟球團也發表聲明。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264804.jpg&M=1&s=Y&x=53&y=0&sw=943&sh=629&exp=3600&sl=W&fw=360", "date": "2026-08-26 10:08", "link": "/news/story/7001/9714571"}, {"article_id": "9714576", "title": "NBA／休賽季補強雷聲大雨點小 勇士簽下尼恩補滿第15人", "summary": "勇士隊今天傳出已與33歲前鋒「巨無霸」尼恩（Georges Niang）達成共識，簽下一年390萬美元合約，補齊球員名單第15名、也是最後一名正式球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264819.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 10:07", "link": "/news/story/7002/9714576"}, {"article_id": "9714536", "title": "籃球／籃協爆資金爭議 李洋籲接任協會理事長要有還債決心", "summary": "中華籃球協會今年進行改選後至今爭議不斷，昨天更遭到媒體爆料協會資金未如期挹注等問題，導致亞運後運作可能出現問題，運動部部長李洋今天於立法院受訪時表示，確實有幾個協會在資金上有需要精進的空間，也呼籲有負債的協會理事長在接任時，務必要有還債的決心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264791.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 09:55", "link": "/news/story/7003/9714536"}, {"article_id": "9714501", "title": "MLB／大谷翔平最快31日重返投手丘 有望對決「台灣怪力男」李灝宇", "summary": "道奇隊「二刀流」大谷翔平重返投手丘腳步愈來愈近，預計明天將再進行一次牛棚練投或實戰打擊練習，總教練羅伯茲（Dave Roberts）今天透露，若一切順利，大谷最快有機會在美國時間周日（台灣時間31日）對上老虎隊的比賽登板。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264699.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 09:37", "link": "/news/story/6999/9714501"}, {"article_id": "9714472", "title": "籃球／瓊斯盃男籃保底賽制引菲律賓不滿 李洋籲別失信於國際", "summary": "瓊斯盃男子組賽事在日前爆發賽制爭議，引發菲律賓代表隊的不滿，運動部部長李洋在今天出席立法院教育及文化委員會審查「電子競技運動發展基本法草案」會前受訪時表示，運動部過去幾天一直在與籃協進行溝通，並希望這類國際性邀請賽不要失信於國際。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264686.jpg&M=1&s=Y&x=282&y=12&sw=931&sh=621&exp=3600&sl=W&fw=360", "date": "2026-08-26 09:31", "link": "/news/story/7003/9714472"}, {"article_id": "9714449", "title": "MLB／李灝宇擊球初速180公里強勁安打帶打點 老虎終止6連敗", "summary": "老虎隊面對美聯龍頭光芒隊系列賽第2戰，台灣內野手李灝宇擔任先發第2棒、三壘手，4打數敲出1支帶有打點的強勁安打，替老虎追加保險分，終場老虎以4：1勝出，終結近期6連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264644.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 09:19", "link": "/news/story/6999/9714449"}, {"article_id": "9714429", "title": "NBA／減薪千萬加入熱火 湯普森強調奪冠最重要", "summary": "勇士隊昔日「浪花兄弟」之一的湯普森（Klay Thompson），正式披上熱火隊戰袍，和「希臘怪物」安戴托昆波（Giannis Antetokounmpo）成新隊友，放棄約千萬美元收入的他在新東家舉行的記者會上強調，贏得比賽比薪資更重要。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264624.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 09:11", "link": "/news/story/7002/9714429"}, {"article_id": "9714378", "title": "美網／小威、小約提前落馬 神鵰俠侶闖混雙4強", "summary": "美網混雙台灣時間昨天深夜11點點燃戰火，打頭陣的「世界第一對決」就好戲連連，24座大滿貫得主約克維奇（Novak Djokovic）和女單白俄羅斯「世界球后」莎芭蓮卡（Aryna Sabalenka）雖先下一城，但遭現任女雙和男雙世界第一的組合捷克絲妮柯娃（Katerina Siniakova）／英國帕特恩（Henry Patten）逆轉，網壇「神鵰俠侶」史維托莉娜（Elina Svitolina）和孟非斯（Gael Monfils）則是挺進最終4強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264612.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 08:36", "link": "/news/story/121623/9714378"}, {"article_id": "9713858", "title": "中職／延賽惡夢不斷纏身 單一球季增彈性成解方", "summary": "中職近年延賽場數超過20場，補賽週仍難化解梅雨季衝擊；建議採單一球季，彈性保留補賽日，並改善球場排水。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35263941.jpg&M=1&s=Y&x=115&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-26 07:00", "link": "/news/story/122629/9713858"}, {"article_id": "9713447", "title": "高昂代價換回華森值得嗎？騎士重磅重組背後的爭冠抉擇", "summary": "騎士完成五隊重磅交易，換來23歲大型側翼華森，卻付出史特魯斯、施羅德等輪替戰力與選秀資產，正式押注陣容升級與爭冠前景。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35263451.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 07:00", "link": "/news/story/122629/9713447"}, {"article_id": "9713049", "title": "日職／控球修不好球速還變慢 藤浪晉太郎生涯顯現危機訊號", "summary": "藤浪晉太郎回歸日職後控球問題未解，球速也下滑；截至8月23日，本季一軍僅投10局、防禦率6.30，生涯與續約前景亮起警訊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35263009.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-26 07:00", "link": "/news/story/122629/9713049"}, {"article_id": "9713949", "title": "中職／威克4轟光速登本季巨蛋王 曾總：他很舒服", "summary": "7月底才加入戰局的樂天桃猿隊洋砲威克，光速登頂大巨蛋王者，今天面對中信兄弟隊敲出雙響砲，已在大巨蛋累積4轟，總教練曾豪駒許願：「希望他在別的球場也可以繼續發威。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35264054.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-25 22:13", "link": "/news/story/7001/9713949"}, {"article_id": "9713945", "title": "中職／中信兄弟象失11分大敗 九局上推野手宋晟睿登板止血", "summary": "中信兄弟象晚上在台北大巨蛋迎戰樂天桃猿，終場中信兄弟象失11分大敗，中信兄弟投手表現失常大失血，保送連連，在比分落後差距已大的情況下，九局上推出宋晟睿野手登板，連連飆出紅字掀全場歡呼，連續解決梁家榮、林子偉後，面對道威聖投出保送，再面對「左打版」馬傑森投出三振，完成後援1局無失分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35264049.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-25 22:12", "link": "/news/story/7001/9713945"}, {"article_id": "9713932", "title": "中職／派「左打版」馬傑森對宋晟睿 曾總：153公里滿嚇人", "summary": "樂天桃猿隊今天以11：1暴打中信兄弟隊，隨著比分差距擴大，兄弟九局上推出宋晟睿野手登板，飆速153公里，面對「左打版」馬傑森投出三振，而這來自猿隊教頭曾豪駒的授意，「因為153，看起來滿嚇人。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35264024.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-25 22:03", "link": "/news/story/7001/9713932"}, {"article_id": "9713894", "title": "中職／兄弟成大巨蛋「最暖房東」 主場6戰全敗只得6分狂失34分", "summary": "中信兄弟隊本季在台北大巨蛋當「客人」勝率破5成（9勝8敗），當「主人」卻一勝難求，今天再以1：11遭樂天桃猿隊暴打，今年在大巨蛋主場戰績是淒涼的0勝6敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35263982.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-25 21:32", "link": "/news/story/7001/9713894"}, {"article_id": "9713851", "title": "中職／象迷真的回來了！18977人進場破「平日蛋」紀錄", "summary": "中信兄弟隊「百萬象迷」人氣發威，今天在台北大巨蛋的平日主場湧入1萬8977人，寫下今年「平日蛋」最佳數字。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/25/35263930.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-25 20:57", "link": "/news/story/7001/9713851"}]}, {"name": "棒球", "articles": [{"article_id": "9714571", "title": "中職／羅戈妻子遭惡劣留言恐嚇 中信兄弟：將維護球員及家人安全", "date": "2026-08-26 10:08", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35264804.jpg&M=1&s=Y&x=53&y=0&sw=943&sh=629&exp=3600&w=300", "link": "/news/story/70