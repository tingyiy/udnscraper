php?u=https://uc.udn.com.tw/photo/t3/2026/08/27/35269938.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9717641"}, {"article_id": "9718482", "title": "高估湖人小看76人、熱火 ESPN季前勝場預測恐是最失準一次", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/28/35272137.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9718482"}, {"article_id": "9715884", "title": "中職／去年4隊一球未投賭對人 悍將831抉擇能否同樣成功", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/26/35267025.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9715884"}]}, {"name": "最新文章", "articles": [{"article_id": "9725955", "title": "今年世足賽成最後一舞 阿根廷傳奇球星梅西宣布退出國家隊", "summary": "39歲的阿根廷傳奇足球球星梅西8月31日宣布，將退出阿根廷國家隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35283583.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 23:43", "link": "/news/story/7005/9725955"}, {"article_id": "9725836", "title": "龍舟／世界俱樂部錦標賽 9月1日起花蓮鯉魚潭開戰", "summary": "2026年第15屆「世界俱樂部龍舟錦標賽」（IDBF Club Crew World Championships，簡稱CCWC）9月1日至6日於花蓮壽豐鄉鯉魚潭開戰，今天晚間的開幕儀式更是宛如盛夏嘉年華，來自全球21國、近6000名選手齊聚知名景點東大門廣場，儘管陰雨綿綿，水上男女的熱情不減。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35283506.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 23:00", "link": "/news/story/7005/9725836"}, {"article_id": "9725786", "title": "籃球／黃泓瀚號召能仁幫 花蓮秀林辦籃球關懷活動", "summary": "職籃球員「大瀚」黃泓瀚上周末攜手「能仁幫」的劉人豪、高承恩和劉駿霆，走進花蓮縣秀林鄉陶樸閣部落籃球場，舉辦籃球關懷活動。本次活動由林正明公益籃球協會協辦，透過職業球員親自指導，讓孩子在熟悉的部落球場與不同層級的籃球前輩交流，從實際參與與互動中接觸更完整的籃球訓練經驗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35283472.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 22:36", "link": "/news/story/7003/9725786"}, {"article_id": "9725401", "title": "MLB／終結大谷翔平MVP之路？小熊PCA兩戰5轟 狂寫多項歷史紀錄", "summary": "雖然小熊今天最終以5：7不敵紅人，但期火力燙到幾乎無法阻擋的中外野重砲阿姆斯壯（Pete Crow-Armstrong）再度演出單場雙響，讓主場瑞格利球場再度響起越來越高亢的MVP呼聲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35283154.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 18:54", "link": "/news/story/6999/9725401"}, {"article_id": "9725329", "title": "NBA／灰狼大補強全力挑戰馬刺雷霆 少主愛德華也很滿意", "summary": "灰狼今年夏天成為NBA休賽季最忙碌的球隊之一，雖然未能在詹姆斯（LeBron James）爭奪戰中勝出，但球團仍完成多項重要補強，包括交易來小鮑爾（LaMelo Ball）、簽下在歐洲籃球聯賽首秀表現出色的萊爾斯（Trey Lyles）、續留上季季後賽表現亮眼的多森姆（Ayo Dosunmu），並成功招募自由市場最受關注球員之一的庫明加（Jonathan Kuminga）加盟。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35283089.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&sl=W&fw=360", "date": "2026-08-31 18:23", "link": "/news/story/7002/9725329"}, {"article_id": "9725256", "title": "NBA／結束法國男籃資格賽行程 溫班亞瑪重返馬刺備戰新賽季", "summary": "溫班亞瑪（Victor Wembanyama）在代表法國隊出征世界盃資格賽之後，接下來將把重心重新轉回馬刺。他坦言，自己已經迫不及待想回到球隊，繼續為新賽季做好準備。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35282308.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 18:07", "link": "/news/story/7002/9725256"}, {"article_id": "9725149", "title": "羽球／超級750中國大師賽 周天成再拚亞運前好彩頭", "summary": "BWF超級750等級的中國羽球大師賽，將於明天起在深圳登場，台灣由「男單一哥」周天成領軍，共22組人馬參賽，希望能在名古...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35281114.jpg&M=1&s=Y&x=0&y=0&sw=1081&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-31 17:38", "link": "/news/story/7005/9725149"}, {"article_id": "9725121", "title": "秋風起正是玩馬祖好時節 啖肥美淡菜、徒步跳島再享國旅多重優惠", "summary": "秋遊馬祖正逢淡菜肥美季，9月1日起國旅補助與地方加碼優惠同步登場，涵蓋交通、住宿、食遊購，還可搭船跳島、徒步走讀戰地聚落。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35281066.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 17:34", "link": "/news/story/7005/9725121"}, {"article_id": "9725142", "title": "中職／悍將、兄弟都不改答案 沿用已在註冊名單內4洋投", "summary": "831大限最後一天，各隊洋投選擇題勾選好答案，只有台鋼雄鷹隊決定換人，註銷後勁、註冊威鳳山，富邦悍將隊留下鈴木駿輔、魔力藍、瑪帝斯、悍里歐，中信兄弟隊在三本柱羅戈、勝騎士、德保拉外，第4人留用菲力士，兩隊最終都不換人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35281072.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-31 17:27", "link": "/news/story/7001/9725142"}, {"article_id": "9725072", "title": "棒球／智通盃全國社區挑戰賽落幕 鍾富瑋放眼未來制度化發展", "summary": "2026智通盃全國社區棒球挑戰賽歷經颱風、連日大雨考驗，在主辦單位中華社區棒球協會與各界共同努力下，已在嘉義市圓滿落幕，本屆賽事除了全台社區棒球小將同場競技，更結合OB傳承賽、女子棒球、媒體轉播及企業公益資源，展現社區棒球不只是競技，更可以成為串聯不同世代與社會力量的平台。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280971.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-31 16:52", "link": "/news/story/7001/9725072"}, {"article_id": "9725043", "title": "TPBL／瓊斯盃添踏出舒適圈信心 高國豪離開攻城獅發長文感謝新竹", "summary": "新竹御嵿攻城獅球團今天宣布當將後衛高國豪已明確表達挑戰旅外的意願，且合約期滿，經雙方充分溝通後，球團全力支持高國豪生涯規劃，感謝自2020年創隊以來貢獻的6年時光；高國豪也在社群發出長文，感謝攻城獅外也強調「踏出舒適圈」的決心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280928.jpg&M=1&s=Y&x=1&y=574&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 16:39", "link": "/news/story/7003/9725043"}, {"article_id": "9725024", "title": "中職／雄鷹後勁沒了！期末考對悍將7局好投還是死當 改啟用威鳳山", "summary": "台鋼雄鷹隊831大限60人名單出爐，確定換掉效力3季的洋投後勁，改註冊威鳳山；今年2月進行右手肘韌帶置換手術的主戰捕手張肇元，也獲得註冊，本季回歸有望。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280893.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 16:30", "link": "/news/story/7001/9725024"}, {"article_id": "9724930", "title": "NBA／布朗深情告別波士頓 帶冠軍獎盃現身感謝球迷：我愛你們", "summary": "布朗（Jaylen Brown）今夏被塞爾蒂克交易到76人，這筆突如其來的重磅轉隊案可說是震撼全聯盟，不過即使即將展開職業生涯新篇章，布朗對波士頓這座城市仍沒有怨懟，反而在自己的告別活動中，向一路支持他的球迷與社區人士送上深情感謝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280841.jpg&M=1&s=Y&x=40&y=11&sw=856&sh=571&exp=3600&sl=W&fw=360", "date": "2026-08-31 16:21", "link": "/news/story/7002/9724930"}, {"article_id": "9724876", "title": "美網／打完比賽已經凌晨2點 46歲大威單打又吞敗喊盡力了", "summary": "46歲的美國名將大威廉絲（Venus Williams），今天午夜在美網主球場迎接生涯第26次的美網女單賽事，不過在可能的「最後一舞」沒能突破，以2：6、6：7（6：8）敗給同胞珂寧（Sofia Kenin），從去年7月至今連15站單打都首戰出局。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280711.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 15:29", "link": "/news/story/121623/9724876"}, {"article_id": "9724785", "title": "NBA／湖人無緣得到庫明加 傳金塊奪冠功臣成下一個補強目標", "summary": "隨著庫明加（Jonathan Kuminga）決定加盟灰狼，湖人在自由市場上的補強方向可能轉向更具經驗的側翼球員，其中曾幫助金塊在2023年奪冠的布朗（Bruce Brown）再次成為潛在人選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280551.jpg&M=1&s=Y&x=146&y=8&sw=981&sh=654&exp=3600&sl=W&fw=360", "date": "2026-08-31 14:53", "link": "/news/story/7002/9724785"}, {"article_id": "9724762", "title": "中職／悍將60人名單一口氣換9人 黃保羅本季一軍0出賽、張進德也註銷", "summary": "富邦悍將隊831大限60人名單本土球員出爐，一口氣註銷註冊9人，包括黃保羅、張進德、高國麟等人，確定黃保羅本季在一軍留下0出賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280553.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 14:44", "link": "/news/story/7001/9724762"}, {"article_id": "9724754", "title": "美網／嘔吐、抽筋整場都不適 約克維奇坦言考慮過退賽", "summary": "曾4度美網奪冠的塞爾維亞名將約克維奇（Novak Djokovic），今年以第4種子身分迎接年度壓軸大滿貫，但第一輪卻爆出冷門，超過4個半小時的五盤大戰敗給世界排名49的阿根廷25歲對手納沃內（Mariano Navone），他坦言在場上感覺「糟透了」，除了嘔吐還有抽筋，一度考慮退賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280518.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-31 14:42", "link": "/news/story/121623/9724754"}, {"article_id": "9724749", "title": "籃球／「男模」呂政儒暗示將退役 開心享受親子時光", "summary": "前台灣男籃當家射手「男模」呂政儒今天在社群媒體暗示將退役、結束長達22個賽季的職業球員生涯，他表示，最近很開心可以花更多...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280499.jpg&M=1&s=Y&x=0&y=61&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 14:41", "link": "/news/story/7003/9724749"}, {"article_id": "9724744", "title": "棒球／新竹市城市隊正式成軍 預計年底參加各項成棒賽事", "summary": "新竹市城市棒球隊今舉辦成軍記者會，29名球員與教練團正式亮相，記者會由光復高中啦啦隊活力開場，現場介紹球隊隊徽設計理念並播放成軍影片，完整呈現球隊從籌組、球員測試、報到到投入訓練的歷程，宣告新竹市正式建立城市成棒發展平台，為風城棒球注入嶄新能量。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280488.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 14:34", "link": "/news/story/7001/9724744"}, {"article_id": "9724356", "title": "中職／統一獅「巷仔內的西拉雅」主題日 下月6日江振愷攜手羅美玲開球", "summary": "中職統一7-ELEVEn獅隊9月推出「巷仔內的西拉雅」主題日，宣布9月6日邀請藝人江振愷（Terry）與歌手羅美玲攜手開...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280479.jpg&M=1&s=Y&x=0&y=174&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 14:34", "link": "/news/story/7001/9724356"}, {"article_id": "9724700", "title": "世界盃男籃／德國隊長施羅德關鍵罰球定勝負 終結波蘭不敗金身", "summary": "世界盃衛冕冠軍德國男籃在2027年歐洲區資格賽客場面對原本保持不敗的波蘭，雙方一路激戰到延長賽最後階段，最終德國靠著隊長施羅德（Dennis Schroder）終場前17秒兩罰俱中，以96：94險勝波蘭，不只終結對手資格賽7連勝，也讓K組晉級形勢更加白熱化。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280448.jpg&M=1&s=Y&x=0&y=5&sw=1126&sh=751&exp=3600&sl=W&fw=360", "date": "2026-08-31 14:25", "link": "/news/story/7002/9724700"}, {"article_id": "9724575", "title": "MLB／再見接殺竟然變成兩分砲 光芒德魯卡：太愛這座全壘打牆了", "summary": "美聯戰績最強的光芒隊，今天在主場對教士隊進行3連戰最後一戰，9局下2出局後，德魯卡（Jonny DeLuca）轟出左外野深遠飛球，眼看比賽就要結束，教士左外野手泰勒（Samad Taylor）接到球竟彈出全壘打牆，形成追平比數的兩分砲，光芒打到延長11局以5：4險勝，神奇完成成3連戰橫掃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280340.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 13:30", "link": "/news/story/6999/9724575"}, {"article_id": "9724488", "title": "棒球／桃園盃台啤2連勝 大一新生磨經驗找可用之兵", "summary": "2026年第11屆桃園盃棒球賽大專組賽事台灣啤酒今天以8比4擊敗中信科大、預賽2連勝；教練林衛宣表示，每場比賽釋出機會給...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280086.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 13:17", "link": "/news/story/7001/9724488"}, {"article_id": "9724530", "title": "TPBL／高國豪旅外心意堅定 攻城獅送祝福", "summary": "新竹御嵿攻城獅球團今天宣布高國豪因合約期滿，且已明確表達挑戰旅外的意願，經雙方充分溝通後，球團全力支持其生涯規劃，高國豪即日起正式離隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280067.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-31 13:09", "link": "/news/story/7003/9724530"}]}, {"name": "棒球", "articles": [{"article_id": "9724762", "title": "中職／悍將60人名單一口氣換9人 黃保羅本季一軍0出賽、張進德也註銷", "date": "2026-08-31 14:44", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280553.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9724762"}, {"article_id": "9725142", "title": "中職／悍將、兄弟都不改答案 沿用已在註冊名單內4洋投", "date": "2026-08-31 17:27", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35281072.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9725142"}, {"article_id": "9725072", "title": "棒球／智通盃全國社區挑戰賽落幕 鍾富瑋放眼未來制度化發展", "date": "2026-08-31 16:52", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280971.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/7001/9725072"}, {"article_id": "9725024", "title": "中職／雄鷹後勁沒了！期末考對悍將7局好投還是死當 改啟用威鳳山", "date": "2026-08-31 16:30", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280893.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9725024"}, {"article_id": "9724744", "title": "棒球／新竹市城市隊正式成軍 預計年底參加各項成棒賽事", "date": "2026-08-31 14:34", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280488.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", 