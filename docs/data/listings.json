k": "/news/story/122629/9656339"}, {"article_id": "9656390", "title": "湖人不惜梭哈也要得手 凱斯勒是唐西奇遇過最好禁區搭檔！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178373.jpg&M=1&s=Y&x=0&y=53&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9656390"}, {"article_id": "9656288", "title": "日職／12強輸球最後打者 栗原陵矢長打再進化 改善重訓敲最快30轟！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/28/35178347.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9656288"}, {"article_id": "9654083", "title": "傳承前輩旅日榮光路！陽岱鋼21年始終堅持 寫棒球史重要篇章", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/27/35175101.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9654083"}]}, {"name": "最新文章", "articles": [{"article_id": "9661736", "title": "中職／高宇杰生涯首次罕見紀錄 認為鄭浩均「沒把自己投倒」", "summary": "中信兄弟隊今天3局上猛攻6分奠定勝基，終場以10：5擊敗樂天桃猿隊，高宇杰單局兩支安打帶動全隊攻勢，全場5打數3安打，獲選單場MVP，他說：「這是生涯首次單局兩支內野安打。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186525.jpg&M=1&s=Y&x=0&y=0&sw=1089&sh=726&exp=3600&sl=W&fw=360", "date": "2026-07-30 22:59", "link": "/news/story/7001/9661736"}, {"article_id": "9661735", "title": "中職／平野惠一點名宋晟睿是MVP 關鍵守備沒收猿隊大局", "summary": "中信兄弟隊今天在桃園棒球場狂揮13支安打，以10：5擊敗樂天桃猿隊，總教練平野惠一賽後被問到心目中的單場MVP，不是看打擊成績，而是關鍵守備，直接點名中外野手宋晟睿。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186521.jpg&M=1&s=Y&x=0&y=0&sw=924&sh=616&exp=3600&sl=W&fw=360", "date": "2026-07-30 22:58", "link": "/news/story/7001/9661735"}, {"article_id": "9661661", "title": "台北羽賽／獲頒10萬獎金全數捐出 周天成盼把榮耀化為正能量", "summary": "剛在BWF超級1000系列中國大陸羽球公開賽締造歷史奪冠的我國羽球一哥周天成，今天於台北羽球公開賽男單16強再傳捷報，以21：17、22：20直落二擊退馬來西亞新銳尤陽，收下8強門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186415.jpg&M=1&s=Y&x=0&y=0&sw=1228&sh=819&exp=3600&sl=W&fw=360", "date": "2026-07-30 22:07", "link": "/news/story/7005/9661661"}, {"article_id": "9661657", "title": "中職／高宇杰罕見單局兩支內野安打 鄭浩均等了兩個月奪勝", "summary": "中信兄弟隊作客桃園棒球場，今天再戰樂天桃猿隊，鄭浩均先發6局失4分，未繳出優質表現，但兄弟打線全場出現13支安打，3局上猛攻6分奠定勝基，終場以10：5獲勝，也讓猿隊中斷3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186411.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 22:03", "link": "/news/story/7001/9661657"}, {"article_id": "9661422", "title": "台北羽賽／周天成、麟榤配晉級8強 王齊麟再邀李洋來觀賽", "summary": "甩開近期連續6站首輪出局的陰霾，台北公開賽男雙衛冕軍王齊麟／邱相榤今天在16強戰以21：13、24：22直落二拍落日本組合中靜悠斗／綠川大輝，挺進8強，場上雖意外出現「隊友爆頭」的驚險插曲，但兩人賽後自嘲這是預示好兆頭的「開光儀式」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186158.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 19:40", "link": "/news/story/7003/9661422"}, {"article_id": "9661388", "title": "霹靂舞／巴黎奧運雙金牌領銜 世界四大冠軍齊聚高雄", "summary": "高雄市政府運動發展局攜手青年局，串聯「2026雄爭舞鬥國際街舞大賽」及「2026高雄霹靂舞國際大賽」，推出一系列國際街舞賽事、多元運動體驗及街舞文化活動，其中2026高雄霹靂舞國際大賽更將邀請世界四大冠軍齊聚高雄，邀請市民朋友一起走進街舞、參與運動，打造兼具競技、文化交流與全民參與的城市盛典。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186090.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 19:15", "link": "/news/story/7005/9661388"}, {"article_id": "9661338", "title": "中職／德保拉失9分本季最慘敗投 王建民點出變化球最大問題", "summary": "中信兄弟隊作客桃園球場，昨天對樂天桃猿隊2連戰首戰以5：12落敗，洋投德保拉先發4.1局狂失9分，吞下本季最慘的一敗；投手教練王建民今天賽前表示，德保拉直球品質不錯，但變化球投不到想要的位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186050.jpg&M=1&s=Y&x=0&y=0&sw=987&sh=658&exp=3600&sl=W&fw=360", "date": "2026-07-30 18:51", "link": "/news/story/7001/9661338"}, {"article_id": "9661295", "title": "中職／經典賽看過杰克飆球速 王建民直言菲力士地位危險", "summary": "中信兄弟隊今天宣布簽下澳洲籍左投杰克（Jack O'Loughlin），已完成加盟手續投入訓練，投手教練王建民表示，曾在世界棒球經典賽看過杰克投球，就看過這一次，球威相當不錯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185972.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 18:23", "link": "/news/story/7001/9661295"}, {"article_id": "9661103", "title": "台北羽賽／林俊易連退奧運奪牌名將晉8強 亞運時盼到場為林昀儒加油", "summary": "我國「左手重砲」林俊易，繼昨天在台北公開賽首輪擊退東京奧運男單銅牌印尼金廷（Anthony Sinisuka Ginting）後，今天再度與巴黎奧運銅牌李梓嘉苦戰三局後以22：20、11：21、21：18險勝，晉級到8強賽，賽後李梓嘉也給予林俊易表現讚賞，並直言看到他這幾年的逐漸成熟。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185955.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 17:18", "link": "/news/story/7003/9661103"}, {"article_id": "9661020", "title": "NBA／詹皇怕被罵才不加盟勇士？前球員柏金斯直指格林活在「幻想」", "summary": "勇士在今夏錯失網羅詹姆斯（LeBron James）的機會後，對於格林（Draymond Green）認為詹姆斯是因為害怕加盟勇士後「被外界罵翻」，才選擇加入76人，前NBA球員、現任《ESPN》球評柏金斯（Kendrick Perkins）對此毫不留情駁斥格林「太妄想」了。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185556.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 17:05", "link": "/news/story/7002/9661020"}, {"article_id": "9661031", "title": "緯來電視網攜手高中體總 四年轉播四大聯賽正式啟動", "summary": "學生運動聯賽轉播正式邁入嶄新里程碑，緯來電視網與高中體總今天共同舉辦「115-118學年度學生運動聯賽轉播暨行銷發布記者會」，正式宣布未來連續四個學年度，HBL高中籃球聯賽、JHBL國中籃球聯賽、HVL高中排球聯賽、JHVL國中排球聯賽、HFL中等學校足球聯賽（11人制）、HSL中等學校女子壘球聯賽、HDC全國中等學校熱舞大賽及全國中等學校3X3籃球賽，將由緯來體育家族及緯來電視網APP提供完整的電視與網路平台轉播，打造全方位、多平台的學生運動觀賽服務。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185581.jpg&M=1&s=Y&x=0&y=0&sw=1137&sh=758&exp=3600&sl=W&fw=360", "date": "2026-07-30 17:00", "link": "/news/story/7005/9661031"}, {"article_id": "9660985", "title": "日職／阪神上半季場均4.2萬觀眾居冠、廣島下滑3.9% 洋聯6隊全數成長", "summary": "日本職棒明星賽昨天落幕，日本野球機構（NPB）也在今天公布2026年日職上半球季的進場人數，中央聯盟以阪神虎隊場均場均4萬1947人進場高居12球團第一；太平洋聯盟則是6隊進場人數都成長。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185541.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 16:45", "link": "/news/story/7001/9660985"}, {"article_id": "9660945", "title": "台北羽賽／被球迷應援聲嚇到 邱品蒨僅睡5小時仍搶下8強門票", "summary": "儘管昨天32強賽打完回到家準備就寢已經是凌晨兩點，但台北公開賽羽球女單第一種子邱品蒨，今天在16強賽面對日本選手水津愛美，仍是在休息不足的情況下，以21：13、18：21、21：14險勝，繼6月初的印尼公開賽後再度安抵8強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185695.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-30 16:28", "link": "/news/story/7005/9660945"}, {"article_id": "9660936", "title": "中職／邱緯綸罕見回鍋猿隊終上一軍 曾豪駒不諱言選手需要刺激", "summary": "樂天桃猿隊22歲左投邱緯綸，昨天終於等到一軍初登板，對中信兄弟隊後援1局無失分，猿隊總教練曾豪駒說：「選手需要刺激，想打職棒必須提升自己。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185388.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 16:25", "link": "/news/story/7001/9660936"}, {"article_id": "9660917", "title": "華航公益籃球營邁入第10年 球星攜手伴學童為夢想啟航", "summary": "中華航空公益籃球營今年邁入第10年，今（30）日攜手桃園璞園領航猿，在桃園舉辦公益籃球活動，邀請竹圍國中、大崗國中學生參與，由資深副總經理羅雅美揭開活動序幕，球星白曜誠、陳將双及林正也化身一日教練，帶領學生從傳球、運球、投籃等基本功練習，近距離感受職業球員訓練氛圍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185348.jpg&M=1&s=Y&x=0&y=0&sw=840&sh=560&exp=3600&sl=W&fw=360", "date": "2026-07-30 16:15", "link": "/news/story/7003/9660917"}, {"article_id": "9660769", "title": "足球／從天才少年到巴西隊史射手王！回顧內馬爾16年國家隊傳奇生涯故事", "summary": "現年34歲的巴西足球傳奇內馬爾（Neymar）昨日正式宣布退出巴西國家隊，將不會再披上「森巴軍團」戰袍，為長達16年的國家隊生涯畫下句點。儘管留下巴西隊史最多的80顆進球，但他始終未能帶領球隊奪下夢寐以求的世界盃冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185117.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:59", "link": "/news/story/7005/9660769"}, {"article_id": "9660810", "title": "籃球／全美四星高中生陳卡特 披中華U18男籃戰袍直呼很酷", "summary": "被評為全美四星高中生的台美混血陳卡特，近期加入中華U18男籃培訓，甚至秀出大風車灌籃驚艷全場，他表示一直很想代表國家隊出...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185427.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:54", "link": "/news/story/7003/9660810"}, {"article_id": "9660801", "title": "中職／韓國女團Apink抵台 31日大巨蛋味全龍主場賽後開唱", "summary": "韓國女團Apink今天下午搭機抵台，Apink將擔任味全龍年度主題日 「新光亞洲音樂祭」首發卡司，於31日登上台北大巨蛋...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185244.jpg&M=1&s=Y&x=0&y=258&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:48", "link": "/news/story/7001/9660801"}, {"article_id": "9660840", "title": "中職／威克、魔鷹下周重量級較勁 曾豪駒點出兩人唯一不同之處", "summary": "樂天桃猿隊洋砲威克砲火凶猛，目前出賽4場貢獻兩支全壘打、5分打點，猿隊總教練曾豪駒表示，他將固定打第3棒，但不會每場比賽都守備，要看隊型需要。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185246.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:48", "link": "/news/story/7001/9660840"}, {"article_id": "9660820", "title": "TPBL／再一國手助陣 巴西全能好手加爾文加盟海神", "summary": "TPBL高雄全家海神隊今天宣布簽下巴西國家隊好手加爾文（Gabriel Galvanini），27歲的加爾文身高204公分，擁有巴西、希臘、烏拉圭聯賽資歷，且為巴西國家隊班底，打法團隊且善於為球隊注入能量。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185202.jpg&M=1&s=Y&x=1&y=187&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:41", "link": "/news/story/7003/9660820"}, {"article_id": "9660783", "title": "羽球／直擊馬來西亞祕密基地 台灣小將觀摩世界勁旅培訓", "summary": "羽球擊球聲此起彼落，場邊教練高聲提醒節奏，這裡不是國際賽，而是馬來西亞國家羽球訓練中心，也是培育國家隊的「祕密基地」。來...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185150.jpg&M=1&s=Y&x=0&y=81&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:37", "link": "/news/story/7005/9660783"}, {"article_id": "9660815", "title": "籃球／富邦、台啤參戰T3X聯盟 首站父親節台北101燃戰火", "summary": "由中華民國3x3籃球協會打造的「Taiwan 3x3 League 台灣3x3聯賽（T3X）」今天在台北市政府舉行開賽記者會，宣告國內全新三對三籃球舞台正式啟航，首屆賽事最大亮點，莫過於匯集國內外多支勁旅同場競技，包含台灣首支3x3職業隊台北永豐旺寶、富邦勇士、台啤等傳統職籃隊伍，以及海外強權參戰，賽事強度與話題性十足。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185190.jpg&M=1&s=Y&x=0&y=0&sw=1096&sh=731&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:37", "link": "/news/story/7003/9660815"}, {"article_id": "9660807", "title": "台北羽賽／三組混雙晉8強衝擊純本土首冠 李佳馨另求平安完賽", "summary": "台北羽球公開賽今天展開16強賽程，其中率先結束的混雙賽事，共有3組台灣組合晉級到8強賽，將全力衝擊首座混雙純本土冠軍，其中李佳馨／吳冠勳在今天就拍退馬來西亞組合晉級，談到兩年前在4強賽腳踝大扭傷退，上周又在中國大陸公開賽被擊中眼睛坐救護車離場，讓李佳馨直言，這次目標就是平安完賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185179.jpg&M=1&s=Y&x=1&y=107&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:33", "link": "/news/story/7005/9660807"}, {"article_id": "9660715", "title": "足球／「我付出了鮮血與生命」！內馬爾告別16年巴西國家隊生涯", "summary": "昨日34歲巴西傳奇球星內馬爾（Neymar）在南美俱樂部盃中，在對陣委內瑞拉中央大學的比賽中替補上陣，最終幫助桑托斯以4：2擊敗對手晉級16強，下一輪將對上厄瓜多球隊馬卡拉。然而，內馬爾賽後也向媒體談及自己的國家隊未來，表示將來不再為巴西效力，正式確認結束國家隊生涯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35185023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-30 15:13", "link": "/news/story/7005/9660715"}]}, {"name": "棒球", "articles": [{"article_id": "9661657", "title": "中職／高宇杰罕見單局兩支內野安打 鄭浩均等了兩個月奪勝", "date": "2026-07-30 22:03", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186411.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9661657"}, {"article_id": "9661735", "title": "中職／平野惠一點名宋晟睿是MVP 關鍵守備沒收猿隊大局", "date": "2026-07-30 22:58", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186521.jpg&M=1&s=Y&x=0&y=0&sw=924&sh=616&exp=3600&w=300", "link": "/news/story/7001/9661735"}, {"article_id": "9661736", "title": "中職／高宇杰生涯首次罕見紀錄 認為鄭浩均「沒把自己投倒」", "date": "2026-07-30 22:59", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/30/35186525.jpg&M=1&s=Y&x=0&y=0&sw=1089&sh=726&exp=3600&w=300", "link": "/news/story/7001/9661736"}, {"article_id": "9660840", "title": "中職／威克、魔鷹下周重量級較勁 曾豪駒點出兩人唯一不同之處", "date": "2026-07-30 15:48", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07