, "title": "高國豪圈粉！瓊斯盃是台灣籃壇世紀資產 不是世代悲歌", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238035.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&w=300", "link": "/news/story/122629/9696821"}, {"article_id": "9694944", "title": "日職／30轟100打點二人組有望成形 加速軟銀霸業", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/16/35235095.jpg&M=1&s=Y&x=135&y=0&sw=1078&sh=718&exp=3600&w=300", "link": "/news/story/122629/9694944"}, {"article_id": "9689384", "title": "中職／主審好壞球頻遭抗議 聯盟實施ABS務必做好相關配套", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35227113.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9689384"}, {"article_id": "9689680", "title": "控衛「總統山」有四個不動傳奇 無冕王衛少足以列名史上前五", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/14/35229289.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9689680"}]}, {"name": "最新文章", "articles": [{"article_id": "9700016", "title": "納米比亞沙漠7日賽第三站最熱考驗 林義傑肋骨斷裂仍完賽保官方團體組第一", "summary": "納米比亞沙漠7日賽第二站高溫逾46度，林義傑肋骨裂仍完賽，與李銘峰續居官方團體組第一；明日迎38公里陡坡挑戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35242291.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 00:06", "link": "/news/story/7005/9700016"}, {"article_id": "9699971", "title": "李灝宇單季57安 刷新大聯盟台將紀錄", "summary": "廿三歲台灣好手李灝宇的大聯盟菜鳥賽季，寫下「台灣第一」紀錄，昨天單場三安打、五次上壘，本季累積五十七支安打，超越張育成二○二一年在守護者隊締造的五十四安，將大聯盟史上台將單季最多安打紀錄推向新高度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35242199.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 00:00", "link": "/news/story/6999/9699971"}, {"article_id": "9699973", "title": "李灝宇3A回鍋開竅 靠打擊站穩大聯盟", "summary": "李灝宇初升大聯盟打得跌跌撞撞，六月初遭下放三Ａ時，老虎隊教頭辛區說「下次回來大聯盟時，他會更自在。」李灝宇讓教頭的預言成真，在第二趟大聯盟之旅站穩腳步，六月以後的打擊表現，堪稱史上第一位靠打擊站穩大聯盟的台灣選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35242293.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-19 00:00", "link": "/news/story/6999/9699973"}, {"article_id": "9699977", "title": "老虎外卡並列第3 李灝宇拚季後賽首位台灣野手", "summary": "儘管老虎隊勝率還不到五成，但季後賽之旅希望無窮，目前於美聯外卡排名並列第三，李灝宇除了堆疊個人數據，也要幫助老虎挺進季後賽，尋求成為第一位參戰大聯盟季後賽的台灣野手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_9.jpg", "date": "2026-08-19 00:00", "link": "/news/story/6999/9699977"}, {"article_id": "9699823", "title": "瓊斯盃／高柏鎧傷退 中華隊教頭曝狀況", "summary": "中華藍今天雖克服第一節兩位數落後，在高柏鎧傷退下第二節一度領先，但下半場失誤增加下仍以76：87不敵韓國原州DB新世代，中華藍總教練圖奇透露高柏鎧昨天就身體不適，今天上場後發現狀況不好，後續狀況仍待觀察。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35242049.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-18 22:24", "link": "/news/story/7003/9699823"}, {"article_id": "9699808", "title": "中職／獅隊6局突破黃子鵬 林子豪滿貫砲率隊擊退雄鷹", "summary": "中職統一7-ELEVEn獅隊今天前5局打線受制，第6局突破台鋼雄鷹隊先發投手黃子鵬，包括林子豪滿貫砲在內，攻勢串聯單局攻...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241983.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 22:21", "link": "/news/story/7001/9699808"}, {"article_id": "9699791", "title": "中職／桃猿、雄鷹也跟進！本季5隊雙位數完封敗 寫史上首見紀錄", "summary": "台鋼雄鷹、樂天桃猿隊今天雙雙吞蛋收場，本季都集滿10場完封敗，至此除了味全龍隊（4場）外，其餘5隊都達雙位數完封敗，寫下中職史上首見紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35242035.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 22:01", "link": "/news/story/7001/9699791"}, {"article_id": "9699781", "title": "中職／桃猿有雙洋砲仍遭完封 悍將8月勝場近3年新高把爐主送給雄鷹", "summary": "富邦悍將隊今年沒有在8月向下沉淪，今天以5：0擊敗樂天桃猿隊，加上另一地台鋼雄鷹隊0：8不敵統一獅隊，悍將下半季攀升第5名，把已經連坐23天的爐主位置交給雄鷹。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241961.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 21:55", "link": "/news/story/7001/9699781"}, {"article_id": "9699767", "title": "瓊斯盃／高柏鎧傷退 韓國外線射垮中華藍", "summary": "中華藍今天瓊斯盃碰韓國原州DB新世代，第一節就陷入兩位數落後，第二節雖打出一波18：3的逆轉攻勢，但禁區大將高柏鎧傷退下，下半場逐漸被拉開差距，最終以76：87吞下第3敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241955.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-18 21:42", "link": "/news/story/7003/9699767"}, {"article_id": "9699755", "title": "韓職／滿壘K掉金倒永！王彥程先發5局失3分 承擔本季第5敗", "summary": "效力韓華鷹隊的台灣左投王彥程，叩關第11勝再度失利，今天面對起亞虎隊先發5局被敲失3分，在1：3落後局面退場，韓華未能追平，最終以3：4輸球，承擔本季第5敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241933.jpg&M=1&s=Y&x=0&y=49&sw=639&sh=426&exp=3600&sl=W&fw=360", "date": "2026-08-18 21:29", "link": "/news/story/7001/9699755"}, {"article_id": "9699655", "title": "中職／前5局15上15下→第6局核炸 黃子鵬生涯首度單局失6分", "summary": "台鋼雄鷹隊黃子鵬投了5局的完全比賽，卻在第六局「單局爆」，留下的滿壘危機，只用了3球就見證隊友將炸彈引爆，最終先發5.1局狂失6分，寫下本季最慘烈一戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241842.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 20:41", "link": "/news/story/7001/9699655"}, {"article_id": "9699614", "title": "瓊斯盃／對高國豪印象深刻 美教頭讚半場神奇壓哨球", "summary": "中華白今天以57：81敗給美國加州大學爾灣分校（UC Irvine），本屆瓊斯盃就吞下2連敗，不過美國總教練透納（Russell Turner）仍讚中華白展現很好的拚戰精神，高國豪的表現更讓人印象深刻，尤其今天半場的神奇打板三分球，可能創下瓊斯盃最遠進球紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241804.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 20:25", "link": "/news/story/7003/9699614"}, {"article_id": "9699523", "title": "瓊斯盃／高國豪拋進神奇大號外線無用 中華白又輸美國", "summary": "瓊斯盃首戰碰美國加州大學爾灣分校（UC Irvine）就吞敗，今天在休兵日後再度交手，第一節在張祐瑋單節8分發揮下取得領先，但第二節被打出24：5的逆轉攻勢，雖有高國豪投進半場壓哨的超大號打板三分球，但下半場分數仍被拉開，最終以57：81吞下對戰連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241706.jpg&M=1&s=Y&x=0&y=406&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-18 19:34", "link": "/news/story/7003/9699523"}, {"article_id": "9699402", "title": "亞運／名古屋亞運倒計時 東京舉行聖火點燃儀式", "summary": "第20屆亞運即將於9月19日至10月4日在名古屋及愛知縣舉行，亞運主辦方今天在東京舉行聖火點燃儀式，開始倒數迎接這項綜合...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241580.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 18:12", "link": "/news/story/7005/9699402"}, {"article_id": "9699355", "title": "中職／永田颯太郎中職二軍首場出賽 敲2安有長打", "summary": "台鋼雄鷹隊今年選秀第2輪選進具日職資歷的內野手永田颯太郎，被期待成為即戰力，今天中職二軍首場出賽，單場2安、包括1支二壘...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241517.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=851&exp=3600&sl=W&fw=360", "date": "2026-08-18 17:50", "link": "/news/story/7001/9699355"}, {"article_id": "9699282", "title": "MLB／通過教士39億美元出售案 創球隊收購價紀錄", "summary": "美國職棒大聯盟MLB及各隊老闆今天一致通過，將聖地牙哥教士出售給投資人費里希安諾及其妻子瓊斯領軍的所有權團隊", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241452.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 17:33", "link": "/news/story/6999/9699282"}, {"article_id": "9699272", "title": "到大巨蛋看比賽前先到「500甜2026甜點派對」　感受最甜蜜的滋味", "summary": "500甜2026甜點派對8月21日至23日於松山文創園區2號倉庫登場，集結全台37個話題品牌，門票200元，另推1,099元套票禮盒限量販售。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241348.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 17:16", "link": "/news/story/7001/9699272"}, {"article_id": "9699254", "title": "MLB／迪亞茲防禦率逼近12不擔心？ESPN曝羅伯茲秘密「牛棚武器」", "summary": "道奇今日在以11比5擊敗洛磯，不過終結者迪亞茲（Edwin Diaz）卻在11比2、足足9分領先下，被敲出4支安打、1次觸身球，一口氣失掉3分才結束比賽。不過《ESPN》棒球分析員培瑞茲（Eduardo Perez）並沒有太過擔心，原因是總教練羅伯茲（Dave Roberts）過去已證明到了季後賽，他往往能夠做出正確的投手調度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241295.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 17:00", "link": "/news/story/6999/9699254"}, {"article_id": "9699234", "title": "羽球世錦賽／林俊易過頭關 邱品蒨錯過3局點遭逆轉", "summary": "2026年羽球世錦賽在印度新德里點燃戰火，「左手重砲」林俊易今天迎接首戰，面對馬來西亞賀首維以直落二順利奪勝，和昨天晉級的「一哥」周天成分闖32強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241322.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 16:45", "link": "/news/story/7005/9699234"}, {"article_id": "9699073", "title": "MLB／道奇2.4億巨星為何徹底迷航？塔克本人也困惑：我真的不知道", "summary": "即使道奇今日以11：5大勝洛磯，休賽季加盟的明星外野手塔克（Kyle Tucker）仍沒有擺脫近期連續7場、25個打數沒有安打的低潮，面對自己本季持續低迷的狀態，塔克似乎也已經找不到答案。被問到為何加盟道奇第一年、在主場的表現會差到如此誇張時，他也表達了自己的看法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35240971.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 15:48", "link": "/news/story/6999/9699073"}, {"article_id": "9699024", "title": "MLB／連續25打數無安打！道奇球評建議塔克去「新人聯盟」重新磨練", "summary": "道奇明星外野手塔克（Kyle Tucker）的打擊低潮仍看不到盡頭，在今日11比5擊敗洛磯的比賽中，全場5打數沒有敲出任何安打，連續無安打場次正式延長至7場。更誇張的是，塔克目前已經連續25個打數沒有安打，讓不少球迷甚至連《SportsNet LA》球評、前道奇球星卡洛斯（Eric Karros）都對此發聲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35240892.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 15:37", "link": "/news/story/6999/9699024"}, {"article_id": "9698985", "title": "MLB／與大谷翔平同天雙響砲達陣「30+30」 小熊PCA回應MVP之爭", "summary": "國聯MVP競爭白熱化，道奇隊大谷翔平今天單場雙響砲，小熊隊中外野手「PCA」阿姆斯壯（Pete Crow-Armstrong）也雙響砲，其中一發還是個人生涯首發再見轟，成功達陣單季「30轟30盜」，幫助小熊以7：5擊敗白襪隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35240792.jpg&M=1&s=Y&x=369&y=58&sw=907&sh=605&exp=3600&sl=W&fw=360", "date": "2026-08-18 15:05", "link": "/news/story/6999/9698985"}, {"article_id": "9698895", "title": "NBA／生涯年受質疑遭交易！豆總警告將迎「暴怒版」布朗：對聯盟會很可怕", "summary": "冠軍傳奇控衛「豆總」朗多（Rajon Rondo），近日向全聯盟發出警告，他認為今年休賽季被塞爾蒂克交易至死敵76人，加上過去幾個月受到的各種質疑與「不尊重」的布朗（Jaylen Brown），將會帶著怒火進入新賽季，可能會成為相當可怕的存在。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35240630.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-18 14:35", "link": "/news/story/7002/9698895"}, {"article_id": "9698858", "title": "PLG／簽下217公分捷克長人 獵鷹禁區「霸而穩」", "summary": "台鋼獵鷹隊今天宣布簽下身高217公分的捷克籍中鋒霸而穩（Ondrej Balvin），獵鷹新成員擁有多年歐洲頂級聯賽征戰經驗，兼具身高、機動性及策應能力，新賽季將以籃板、護框及禁區威嚇力，為獵鷹內線增添強悍戰力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35240564.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-18 14:14", "link": "/news/story/7003/9698858"}]}, {"name": "棒球", "articles": [{"article_id": "9699781", "title": "中職／桃猿有雙洋砲仍遭完封 悍將8月勝場近3年新高把爐主送給雄鷹", "date": "2026-08-18 21:55", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241961.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9699781"}, {"article_id": "9699755", "title": "韓職／滿壘K掉金倒永！王彥程先發5局失3分 承擔本季第5敗", "date": "2026-08-18 21:29", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241933.jpg&M=1&s=Y&x=0&y=49&sw=639&sh=426&exp=3600&w=300", "link": "/news/story/7001/9699755"}, {"article_id": "9699791", "title": "中職／桃猿、雄鷹也跟進！本季5隊雙位數完封敗 寫史上首見紀錄", "date": "2026-08-18 22:01", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35242035.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9699791"}, {"article_id": "9699808", "title": "中職／獅隊6局突破黃子鵬 林子豪滿貫砲率隊擊退雄鷹", "date": "2026-08-18 22:21", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241983.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9699808"}, {"article_id": "9699655", "title": "中職／前5局15上15下→第6局核炸 黃子鵬生涯首度單局失6分", "date": "2026-08-18 20:41", "thumbnail": "https://pgw.udn.com.tw/gw/ph