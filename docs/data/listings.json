 "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413584.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9810048"}, {"article_id": "9807734", "title": "中職／連3年遭遇超級投手 魔鷹狂轟猛打恐難奪年度MVP", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/11/35409929.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9807734"}, {"article_id": "9808191", "title": "強調Contact與三振大隊矛盾對決 美聯冠軍戰賽前分析", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/11/35410683.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9808191"}, {"article_id": "9807993", "title": "日職／多位名將因當監督毀一世英明 工藤公康真能成中日龍救世主？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/11/35410467.jpg&M=1&s=Y&x=0&y=0&sw=859&sh=573&exp=3600&w=300", "link": "/news/story/122629/9807993"}]}, {"name": "最新文章", "articles": [{"article_id": "9812134", "title": "滑冰／再爆選手達標卻無法參賽爭議 滑冰協會聲明強調並無因人設事", "summary": "我國短道競速滑冰青年代表隊選拔近日引發爭議，傳出有5名青年好手達到國際滑冰總會青年世界盃與世青錦標賽的參賽門檻，卻因協會以審查依據為由，恐面臨無人能參賽的困境。中華民國滑冰協會今天透過聲明作出澄清，強調絕無因人設事，現行選拔辦法雖是前屆制定，本屆團隊也將積極檢討制度合理性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_9.jpg", "date": "2026-10-13 16:50", "link": "/news/story/7005/9812134"}, {"article_id": "9812121", "title": "NBA／不能單靠天賦和華麗陣容 兩冠老臣點出76人爭冠關鍵", "summary": "費城76人今年休賽季補進具備冠軍經驗的老將凱威爾波普（Kentavious Caldwell-Pope），他近日受訪時表示，球隊新賽季能走多遠，關鍵不只是陣容天賦，而是全隊能否建立真正的化學效應。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416620.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:47", "link": "/news/story/7002/9812121"}, {"article_id": "9812129", "title": "TPBL／「籃球很好玩」 42歲曾文鼎：有球隊就繼續打", "summary": "「野獸」林志傑上季結束高掛球鞋，「男模」呂政儒8月也宣布退役，42歲的新北中信特攻隊禁區門神曾文鼎成為「黃金世代」僅存的現役球員，他妙喻同期戰友退休就像球場熄燈，「一盞一盞燈關起來了」，但對他來說現在籃球仍是「好玩的」，還有球隊需要自己就會繼續打下去。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416621.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:47", "link": "/news/story/7003/9812129"}, {"article_id": "9812091", "title": "NBA／寧願「薪」酸也要走！史馬特離開湖人真相 記者直言不被尊重", "summary": "效力NBA長達12年的資深後衛史馬特（Marcus Smart），今年夏天離開湖人轉戰火箭。原本外界認為湖人放走這名32歲的防守悍將，是出於年齡、健康或場上表現的考量，不過根據隨隊記者布哈（Jovan Buha）透露，雙方分道揚鑣的真正原因，其實是合約年限與金額談不攏，甚至讓史馬特感到不受尊重。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416561.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:41", "link": "/news/story/7002/9812091"}, {"article_id": "9812098", "title": "NBA／與柯瑞一起先發最大的挑戰？勇士波傑姆斯基：要防持球者", "summary": "勇士隊年輕後衛波傑姆斯基（Brandin Podziemski）日前獲得5年1.1億美元延長合約，引發外界熱烈討論。勇士總教練柯爾（Steve Kerr）和波傑姆斯基最近受訪時都談到，與柯瑞（Stephen Curry）一起先發可能發生的問題。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416593.jpg&M=1&s=Y&x=0&y=0&sw=1130&sh=753&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:38", "link": "/news/story/7002/9812098"}, {"article_id": "9812052", "title": "TPBL／結合運動與生活風格 國王攜手品牌打造限定「勝利紀念品」", "summary": "新北國王隊與知名百年隨行杯品牌STANLEY 展開跨界合作。本次合作以結合運動與生活風格為核心，專為季票球迷打造專屬聯名商品與限定杯款，更將賽事勝利與杯款收藏結合，為球迷帶來參與感與榮耀感。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416489.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:19", "link": "/news/story/7003/9812052"}, {"article_id": "9812041", "title": "TPBL／特攻世代交替魏嘉豪接任新隊長 盼化壓力為動力回應期待", "summary": "TPBL新北中信特攻隊在休賽季儘管本土陣容異動不大，但隨著林韋翰、曾文鼎等經驗豐富的球員先前陸續擔任過隊長職務，今年球隊內部透過球員互選，由中生代後衛魏嘉豪接下新任隊長重任，面對這項突如其來的任務，魏嘉豪坦言當下感到相當錯愕，但也展現決心，誓言將外界與教練團的期待轉化為球隊前進的動力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416480.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:15", "link": "/news/story/7003/9812041"}, {"article_id": "9812027", "title": "TPBL／重回季後賽將是低標 特攻GM陳暉盼新帥費雪打造防守強權", "summary": "連續兩季無緣季後賽後，TPBL新北中信特攻隊在新賽季積極求新求變，球隊總經理陳暉表示，打進季後賽是球隊的基本目標，但更希望能展現出與往年不同的強悍拚勁與積極態度，讓球迷感受到全新的正面氣象。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416469.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:10", "link": "/news/story/7003/9812027"}, {"article_id": "9812016", "title": "TPBL／上季遭淘汰一度消沈 謝亞軒「皮繃緊」迎戰新賽季", "summary": "新北中信特攻隊今天正式公佈新賽季球隊隊長和副隊長，創隊兩隊成員魏嘉豪和謝亞軒接下重任，兩人宣告要率特攻重返季後賽，追尋隊史第2座冠軍獎盃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416564.jpg&M=1&s=Y&x=84&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:03", "link": "/news/story/7003/9812016"}, {"article_id": "9811854", "title": "滑輪溜冰／劉懿萱競速溜冰世錦賽奪銀 莊惟甯稱霸青年男子組", "summary": "在巴拉圭舉行的世界競速滑輪溜冰錦標賽，台灣女將劉懿萱今天在500+D公尺爭先賽以43秒837拿到銀牌，而小將莊惟甯則以4...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416446.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 16:00", "link": "/news/story/7005/9811854"}, {"article_id": "9811991", "title": "全民運聖火傳遞今起跑 張善政邀市民共襄盛舉", "summary": "2026全民運動會將於10月17日至22日在桃園登場，桃市府今天在市府前廣場舉行市內聖火傳遞起跑儀式為賽事揭開序幕。市長張善政表示，本屆全民運共設32個競賽種類，選手年齡橫跨6歲至88歲，將在43處場地競技，期盼透過聖火傳遞凝聚市民熱情，帶動全民運動風氣，邀請民眾共同迎接這場運動盛會。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416438.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 15:59", "link": "/news/story/7005/9811991"}, {"article_id": "9811921", "title": "台灣體壇奧斯卡 運動精英獎開放推薦送件", "summary": "為公開表揚年度內我國參加國內或國際運動賽會成績優良的運動選手、有功教練及運動界人士，被視為國內運動界奧斯卡獎的運動精英獎即日起至28日受理各界推薦。今年運動精英獎評選8個獎項，除終身成就獎外，其他7個獎項的評選事蹟期間定為114年10月1日起至115年10月24日止，請各界踴躍推薦送件。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416282.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=850&exp=3600&sl=W&fw=360", "date": "2026-10-13 15:23", "link": "/news/story/7005/9811921"}, {"article_id": "9811872", "title": "韓職／票房全面升溫！進場1277萬人再寫史上新高 場均17737人", "summary": "中華職棒今年票房大豐收，同樣地，韓國職棒KBO也是熱鬧滾滾。根據韓媒報導，今年KBO不僅連續2年突破1200萬觀眾大關，更刷新去年才創下的聯盟單季最多觀眾紀錄，讓韓國職棒再度寫下票房新頁。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416241.jpg&M=1&s=Y&x=21&y=0&sw=1252&sh=835&exp=3600&sl=W&fw=360", "date": "2026-10-13 15:19", "link": "/news/story/7001/9811872"}, {"article_id": "9811883", "title": "TPVL／放下過去重新出發 吳宗軒領軍台中連莊再戰冠軍", "summary": "吳宗軒放下上季失落，領軍台中連莊備戰新賽季，面對聯盟戰力升級，強化體能、戰術與團隊磨合，力拚再奪冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416240.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 15:13", "link": "/news/story/7005/9811883"}, {"article_id": "9811828", "title": "中職／參加粉絲婚禮牽花童進場！李多慧：韓國比較正式、台灣像派對", "summary": "韓籍啦啦隊李多慧因親民形象獲得許多死忠粉絲支持，最近她竟現身台北圓山大飯店，參加「元老級」粉絲的婚禮，首度參加台式婚宴的她直呼非常有趣且有意義。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416117.jpg&M=1&s=Y&x=0&y=340&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-13 14:49", "link": "/news/story/7001/9811828"}, {"article_id": "9811791", "title": "TPBL／海神添助力 NBA等級影像分析師入港", "summary": "高雄全家海神隊今天宣布，來自美國頂尖籃球訓練顧問公司 Integrity Hoops的影像分析總監溫新加入團隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416060.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 14:31", "link": "/news/story/7003/9811791"}, {"article_id": "9811255", "title": "NBA／喬丹1998年冠軍賽球衣1400萬美元賣出 創籃球紀念品最高價", "summary": "總部位於賓州的韓特拍賣公司(Hunt Auctions) 12日宣布，籃球傳奇名將喬丹(Michael Jordan) 1998年NBA總決賽中穿過並親筆簽名的客場球衣，以1400萬美元天價售出，創有史以來籃球紀念品最高成交價。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35415181.jpg&M=1&s=Y&x=0&y=0&sw=1217&sh=811&exp=3600&sl=W&fw=360", "date": "2026-10-13 14:27", "link": "/news/story/7002/9811255"}, {"article_id": "9811776", "title": "TPBL／特攻下周迎主場開幕周 限量套票開售", "summary": "台灣職業籃球大聯盟（TPBL）2026-2027賽季本月開打，新北中信特攻隊將於24日、25日在新莊體育館進行主場開幕周，今天公布新賽季年度口號「WE OVER ME」，強調團隊合作、凝聚力量的核心精神，邀請所有「線人們」攜手為新北而戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35416033.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-13 14:25", "link": "/news/story/7003/9811776"}, {"article_id": "9811717", "title": "MLB／「鈔」能力沒用！豪華牛棚不敵釀酒人平價款 道奇教頭超無奈", "summary": "道奇近2年豪砸1.63億美元（約新台幣49億元）補強牛棚，原希望打造堅不可摧的後援防線，沒想到在國聯冠軍賽卻遭釀酒人狠狠上了一課。釀酒人今日不僅以7：4擊敗道奇，系列賽取得2勝0敗領先，牛棚更連續2戰沒有失分，甚至在第2戰讓道奇最後15名打者全數出局。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35415916.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-13 14:11", "link": "/news/story/6999/9811717"}, {"article_id": "9811653", "title": "MLB／山本由伸投到懷疑人生？釀酒人打者12球耗7分鐘 保送後喊：真的超好玩", "summary": "釀酒人今日在國聯冠軍賽第2戰以7：4擊敗道奇，系列賽取得2勝0敗領先。其中，釀酒人一壘手包爾斯（Jake Bauers）在第3局面對日本王牌山本由伸，展開一場長達12球、耗時超過7分鐘的激烈纏鬥，最終成功選到四壞保送，為球隊創造滿壘機會。令人意外的是，面對這場讓投手備感壓力的打席，鮑爾斯賽後卻笑稱自己打得非常開心，直呼是人生中最享受的事情之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35415853.png&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-13 14:05", "link": "/news/story/6999/9811653"}, {"article_id": "9811718", "title": "韓職／王彥程確定續留韓華鷹 明年身價翻倍年薪近千萬", "summary": "台灣左投王彥程明年動向底定，確定將續留南韓職棒韓華鷹隊，身價從今年的年薪10萬美元，明年調整為總額30萬美元（約台幣963萬元）合約，包括20萬美元年薪、10萬美元簽約金。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/04/28/34895882.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-13 13:58", "link": "/news/story/7001/9811718"}, {"article_id": "9811316", "title": "NBA／交易傳聞滿天飛 獨行俠總裁搬出「KD金句」：世上只有一個厄文", "summary": "儘管外界持續傳出厄文（Kyrie Irving）可能是他效力獨行俠的最後一個賽季，但新任總裁尤基利（Masai Ujiri）仍對這名9屆全明星後衛充滿信心，不僅期待他重返球場，更認為厄文能夠幫助年輕隊友成長，成為球隊建立全新體系的重要人物。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35415295.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-13 13:49", "link": "/news/story/7002/9811316"}, {"article_id": "9811586", "title": "MLB／釀酒人狂野比特犬！康崔拉斯「猛打賞」打爆道奇 教頭直呼：被嚴重低估", "summary": "釀酒人今日在國聯冠軍賽第2戰以7：4擊敗道奇，取得系列賽2勝0敗領先。明星捕手康崔拉斯（William Contreras）單場4打數3安「猛打賞」，包括1發全壘打，貢獻3分打點，成為球隊贏球的最大功臣。賽後總教練墨菲（Pat Murphy）更直言外界始終低估他的價值。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35415750.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-13 13:48", "link": "/news/story/6999/9811586"}, {"article_id": "9811664", "title": "中職／總冠軍賽前兩戰預售票突破6萬張 大巨蛋加開外野上層看台", "summary": "中華職棒總冠軍賽將於17日在台北大巨蛋開打，史上首見「龍象大戰」，味全龍隊擁有前兩場主場，今天宣布這兩戰門票預售已經突破6萬張，開幕戰更是接近完售。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35415854.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-13 13:41", "link": "/news/story/7001/9811664"}]}, {"name": "棒球", "articles": [{"article_id": "9811718", "title": "韓職／王彥程確定續留韓華鷹 明年身價翻倍年薪近千萬", "date": "2026-10-13 13:58", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/04/28/34895882.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9811718"}, {"article_id": "9809889", "title": "中職／決戰G4！兄弟鄭浩均vs.獅隊布雷克 兩軍都少1洋投待命", "date": "2026-10-12 17:56", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/12/35413440.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9809889"}, {"article_id": "9811664", "title": "中職／總冠軍賽前兩戰預售票突破6萬張 大巨蛋加開外野上層看台", "date": "2026-10-13 13:41", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35415854.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9811664"}, {"article_id": "9811828", "title": "中職／參加粉絲婚禮牽花童進場！李多慧：韓國比較正式、台灣像派對", "date": "2026-10-13 14:49", "thumbnail": "https://pgw.udn.