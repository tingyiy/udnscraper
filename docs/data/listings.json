tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/02/35287340.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9728515"}, {"article_id": "9728518", "title": "中職／為陳鏞基最後一舞奪冠 「五成獅」不能再一成不變", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/02/35287347.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9728518"}]}, {"name": "最新文章", "articles": [{"article_id": "9737184", "title": "美網／高芙直落二晉級16強 坦承自己「沒有做出最好表現」", "summary": "美國網球好手高夫（Coco Gauff）今天在美國公開賽女單第3輪，耗時88分鐘後以6比3、6比4淘汰西班牙對手布克薩（...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301374.jpg&M=1&s=Y&x=144&y=7&sw=886&sh=591&exp=3600&sl=W&fw=360", "date": "2026-09-06 10:10", "link": "/news/story/121623/9737184"}, {"article_id": "9737236", "title": "MLB／村上宗隆第30轟出爐白襪還是輸了 追平大谷翔平並列日本球員最多", "summary": "白襪隊今天繼續在芝加哥主場迎戰雙城隊，日本重砲村上宗隆1局下轟出兩分砲，本季第30轟出爐，追平道奇隊大谷翔平，並列大聯盟日本球員第1，白襪終場4：6落敗，兩隊在3連戰前兩戰打平。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301407.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 10:06", "link": "/news/story/6999/9737236"}, {"article_id": "9737173", "title": "MLB／大谷翔平連3戰未進先發名單 道奇官網直言IL可能性愈來愈高", "summary": "道奇隊今天對國民隊進行3連戰第2戰，大谷翔平仍未排進先發名單，若連續3場未出賽將是加盟3年首見，官網直言，隨著大谷缺席場次增加，這位二刀流巨星被列入傷兵名單（IL）的可能性愈來愈高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301319.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 09:37", "link": "/news/story/6999/9737173"}, {"article_id": "9737171", "title": "MLB／李灝宇傷勢無礙繼續先發 吞3K選2BB還有精彩守備", "summary": "老虎隊台灣內野手李灝宇昨天因本壘攻防被撞傷提前退場，好在傷勢無大礙，今天對上守護者隊繼續先發上陣，擔任第2棒、三壘手，3打數都遭三振，但選到2次保送上壘，還替球隊跑回1分，終場老虎以6：0拿下勝利，終止2連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301316.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-06 09:36", "link": "/news/story/6999/9737171"}, {"article_id": "9737139", "title": "美網／第9種子領先兩盤慘遭逆轉 地主希望難過喊：不想說話", "summary": "以第9種子身份迎接家鄉大滿貫，美國地主希望弗里茲（Taylor Fritz）第三輪打完兩盤已經取得「聽牌」優勢，不料最終卻是遭阿根廷對手塞倫多羅（Francisco Cerundolo）連趕三盤逆轉，讓他記者會上難掩激動，幾乎要落淚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301347.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 09:19", "link": "/news/story/121623/9737139"}, {"article_id": "9737118", "title": "美網／台男將唯一代表 何承叡首輪不敵地主遭逆轉", "summary": "美網唯一的男將代表何承叡，和巴西搭檔迪莫利爾（Marcelo Demoliner）男雙首輪迎戰地主拉蒙斯（Nathaniel Lammons）／威斯羅（Jackson Withrow），何承叡組合首盤先下一城，可習第二盤「搶7」讓出，最終遭地主組合上演三盤逆轉勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301194.jpg&M=1&s=Y&x=0&y=0&sw=1239&sh=826&exp=3600&sl=W&fw=360", "date": "2026-09-06 08:51", "link": "/news/story/121623/9737118"}, {"article_id": "9736950", "title": "運動人生／陳怡安卸下道服 再創精彩", "summary": "提到跆拳道，五十歲以上的運動迷一定對陳怡安不陌生。她十五歲時在漢城奧運拿下跆拳道示範賽金牌，十九歲巴塞隆納奧運「連霸」摘金，二十歲前就「解鎖」兩面奧運金牌，帶動台灣跆拳道風潮，被封為「跆拳道女神」。\n\n陳怡安以過來人經驗，鼓勵年輕選手走出台灣，參加國際賽，多出去看看，每一次經驗累積會把自己再往上堆疊，沒有什麼比充實自己還重要。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300827.jpg&M=1&s=Y&x=23&y=0&sw=1257&sh=838&exp=3600&sl=W&fw=360", "date": "2026-09-06 00:00", "link": "/news/story/7005/9736950"}, {"article_id": "9736958", "title": "運動人生／眼淚宣洩低潮 手作療癒自己", "summary": "「奧運跆拳道示範賽二連霸，首度列入正式賽，我卻在國手選拔失利；那是我人生最大低潮，眼淚沒少過。」陳怡安說，二○○○年沒當上奧運國手，但仍到雪梨參加奧運測試賽，踢下金牌也走了媒體採訪流程，心情相當複雜。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300837.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 00:00", "link": "/news/story/7005/9736958"}, {"article_id": "9736960", "title": "運動人生／享受比賽 退役再找人生方向", "summary": "「當選手，不是任何人想做就能做到的事，而頂尖運動員更需要全心全意投入。」陳怡安鼓勵仍在運動競技場上的年輕選手要有企圖心，把握每一刻並努力享受，退役後再尋找人生方向，並不會太遲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301311.jpg&M=1&s=Y&x=0&y=507&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-06 00:00", "link": "/news/story/7005/9736960"}, {"article_id": "9736781", "title": "蘇柏陵公開水域世青少奪銅寫紀錄 教練看好未來性", "summary": "年僅15歲的台灣游泳新星蘇柏陵，今天在世界青少年公開水域錦標賽摘下男子7.5公里銅牌，締造台灣青少年第1人紀錄，教練劉曜...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300543.jpg&M=1&s=Y&x=0&y=116&sw=1108&sh=739&exp=3600&sl=W&fw=360", "date": "2026-09-05 21:30", "link": "/news/story/7005/9736781"}, {"article_id": "9736782", "title": "中職／三局上先馳得點 樂天桃園4：0富邦悍將", "summary": "中職例行賽今天由富邦悍將於台北大巨蛋主場對上樂天桃猿，三局上樂天桃猿馬傑森、陳晨威打出安打上壘，隨後林立擊出一發中外野高飛球，助馬傑森回本壘得分，率先拿下一分，隨後林泓育、梁家榮再貢獻二分、一分打點，助樂天桃猿比數4：0領先，最終富邦悍將並未逆轉戰局，由樂天桃猿拿下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300536.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 21:22", "link": "/news/story/7001/9736782"}, {"article_id": "9736753", "title": "日職／兩台將同場出賽無緣對決 陽柏翔2支0、孫易磊中繼0.1局失1分", "summary": "日職樂天金鷲隊今天在主場迎戰火腿隊，2名台灣選手同場出賽，但沒能上演投打對決。金鷲隊內野手陽柏翔先發上陣，2打數沒安打提前被換下場；火腿隊投手孫易磊則是在8局下登板，中繼0.1局失1分，終場由火腿以5：2勝出。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300507.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-05 20:47", "link": "/news/story/7001/9736753"}, {"article_id": "9736752", "title": "中職／虧陳克羿「控球再練好一點」 曾總向光總說抱歉", "summary": "樂天桃猿隊陳克羿今天繳出7局無失分好投，幫助球隊以4：0完封富邦悍將隊，兩顆砸在張育成身上的觸身球，引發板凳清空，猿隊教頭曾豪駒賽後透露，有向悍將教頭後藤光尊表達歉意。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/06/35301381.jpg&M=1&s=Y&x=31&y=0&sw=1249&sh=833&exp=3600&sl=W&fw=360", "date": "2026-09-05 20:44", "link": "/news/story/7001/9736752"}, {"article_id": "9736741", "title": "國民體育日運動嘉年華登場 許晉哲攜子同樂推廣親子共運", "summary": "台北市政府體育局今天在台北體育館舉辦「2026國民體育日運動嘉年華」，吸引超過千名民眾熱情參與。本次嘉年華特別邀請台北富邦勇士總教練許晉哲與愛子擔任活動大使，父子攜手挑戰趣味親子競賽，引領市民感受全民運動的樂趣。活動現場特別設置臨時托育區，由專業保母協助照護幼童，讓家長也能安心投入運動，盡情揮灑汗水。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300472.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 20:31", "link": "/news/story/7005/9736741"}, {"article_id": "9736740", "title": "中職／眼睛一閉再睜開已經都是人 陳克羿：嚇死我了", "summary": "樂天桃猿隊今天以4：0完封富邦悍將隊，陳克羿繳出7局無失分好投，然而焦點都在面對張育成的兩顆觸身球，賽後也屢次提到對賢拜真的很不好意思。回憶板凳清空，陳克羿傳神描述：「當下我也是很不好意思，閉著眼睛，怎麼張開眼睛變那麼多人。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300471.jpg&M=1&s=Y&x=0&y=0&sw=1200&sh=800&exp=3600&sl=W&fw=360", "date": "2026-09-05 20:31", "link": "/news/story/7001/9736740"}, {"article_id": "9736731", "title": "中職／勝騎士6局無失分+打線擊退鋼龍 兄弟8：0本季第3度完封龍隊", "summary": "下半季龍頭之戰戰況膠著，中信兄弟隊今天今天在台中洲際棒球場對上味全龍隊，勝騎士主投6局無失分帶頭，打線則是單場揮出13支安打，終場以8：0大勝收場，本季第3度完封龍隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300467.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 20:18", "link": "/news/story/7001/9736731"}, {"article_id": "9736725", "title": "中職／全年第二告急 悍將已在下半季墊底連躺10天", "summary": "富邦悍將隊下半季打得辛苦，今天再以0：4不敵樂天桃猿隊，加上統一獅隊豪取3連勝，悍將目前在全年戰績領先獅隊只剩0.5場勝差，季後賽席次保衛戰告急。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300425.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 20:02", "link": "/news/story/7001/9736725"}, {"article_id": "9736710", "title": "中職／林培緯3安1打點奪MVP 獅隊擊敗雄鷹3連勝", "summary": "中職統一7-ELEVEn獅隊今天靠著洋投喬登6局無失分優質先發，林培緯3安1打點，終場以3比0擊敗台鋼雄鷹，獅隊近期3連...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300417.jpg&M=1&s=Y&x=0&y=138&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 19:49", "link": "/news/story/7001/9736710"}, {"article_id": "9736716", "title": "中職／L.S.S.連兩年來開球 始源撩悍將球迷「因為富邦睡不著」", "summary": "繼去年9月21日「寵愛天使」主題日後，韓流傳奇男團SUPER JUNIOR小分隊「SUPER JUNIOR–L.S.S.」再次為富邦悍將隊擔任嘉賓，這回助陣「悍將中學」主題日，兩天前就在IG上打卡台北大巨蛋的始源，展現練投成果，更嘴甜撩邦迷：「有一陣子我怎樣都睡不著，因為富邦。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300414.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 19:43", "link": "/news/story/7001/9736716"}, {"article_id": "9736702", "title": "自由車／96聯賽第二站決戰武嶺亞運國手缺陣 選拔積分戰燃戰火", "summary": "2026年第六屆96自由車聯賽戰火再起，第二站將移師台灣自由車經典聖地武嶺，本屆共有約1200名車手參與，參賽年齡從12歲一路橫跨至76歲，更吸引來自英國、法國、丹麥、德國、新加坡等超過10個國家、約30名外籍選手共襄盛舉。從國手級菁英、新生代好手到市民車友，將共同朝海拔3275公尺的武嶺發起挑戰，寫下今年96聯賽最具代表性的高山戰役。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300366.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-05 19:28", "link": "/news/story/7005/9736702"}, {"article_id": "9736694", "title": "外澳罟浪祭決戰倒數 6位國際好手浪尖展演、音樂煙火點亮周末", "summary": "「2026 宜蘭外澳 罟浪祭」今天持續於宜蘭外澳熱力展開，經過連日競逐，衝浪賽事正式進入最後決戰階段，賽程將一路推進至女子長板A組四強賽（SF H1-H2）結束，各組好手持續爭取通往最終決賽的門票。除了正式競賽，來自澳洲、瑞典、法國、印尼及巴西等5個國家的6位國際衝浪好手也再度踏浪登場，帶來精彩交流展演，以不同風格及高水準技巧成為外澳海面另一大焦點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300352.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-05 19:20", "link": "/news/story/7005/9736694"}, {"article_id": "9736692", "title": "企業射箭／新竹市愛山林單日12點只拿1點 王正邦：彷彿熬過春夏秋冬", "summary": "2026第8年企業射箭聯賽第四周賽程今天回到桃園國立體育大學射箭場，彰化銀行延續第三周好手感，以5：1輕取寒舍集團，協會青年4：2逆轉學長姐新濠建設，而因補賽必須連續出賽兩場的新竹市愛山林相當可惜，12點只拿了1點，辛苦並未換來甜美果實。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300350.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 19:20", "link": "/news/story/7005/9736692"}, {"article_id": "9736691", "title": "中職／張育成連2打席挨砸掀板凳清空 唯一火藥味來自一雙手", "summary": "富邦悍將、樂天桃猿隊今天續戰台北大巨蛋，猿隊先發投手陳克羿前6局出現3顆觸身球，連兩打席砸在張育成背上，引發兩隊板凳清空，最濃火藥味出現在猿隊首席守備教練陳彥夆。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/05/35300349.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-05 19