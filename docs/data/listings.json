=https://uc.udn.com.tw/photo/t3/2026/09/09/35311347.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 15:02", "link": "/news/story/6811/9744009"}, {"article_id": "9744023", "title": "侵犯著作權？俄羅斯方塊出聲警告 白宮築牆遊戲上線數天後下架", "summary": "白宮今天從官網遊戲專區下架一款名為「築起圍牆」（Build theWall）的俄羅斯方塊風格遊戲。經典遊戲「俄羅斯方塊」...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311374.jpg&M=1&s=Y&x=90&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-09 15:02", "link": "/news/story/6813/9744023"}, {"article_id": "9744001", "title": "代價恐由所有人承擔…18個航運國警告全球貿易正分裂 航運業高層吐擔憂", "summary": "全球18個主要航運國家周二警告，當前的武裝衝突、貿易戰與極端天氣對海運供應鏈的衝擊，並非個別事件，而是全球貿易正經歷結構性轉變的徵兆。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311251.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:51", "link": "/news/story/6811/9744001"}, {"article_id": "9743084", "title": "曼達尼公開9/11檔案 揭朱利安尼隱瞞有毒空氣危害", "summary": "就在紐約市即將迎來9/11恐襲事件25周年之際，市長曼達尼(Zohran Mamdani)8日公開第一批詳細記錄世貿中心遺址空氣品質問題的文件；這些文件詳細說明，由朱利安尼(Rudy Giuliani)擔任市長的紐約市府當時對世貿中心遺址周邊有毒空氣了解多少、何時得知相關情況，並進而揭露當時的市府隱瞞有毒空氣的危害程度，才造成事發25年後仍有人因9/11而罹病身亡。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309825.jpg&M=1&s=Y&x=0&y=0&sw=1268&sh=845&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:31", "link": "/news/story/6813/9743084"}, {"article_id": "9743094", "title": "投票權大戰 川普政府上訴最高院 促解禁選民資格查核", "summary": "川普政府8日緊急上訴最高法院，請求大法官在11月大選前，恢復允許各州使用國土安全部的移民資料庫確認選民資格。這是繼郵寄選票案之後，最新一起涉及期中選舉且訴至最高法院的法律戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309839.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:30", "link": "/news/story/6813/9743094"}, {"article_id": "9743086", "title": "控種族清洗… 以屯墾區商品 英法加禁止進口 美不加入", "summary": "英國、法國與加拿大8日相繼宣布，將禁止進口以色列在約旦河西岸屯墾區生產的商品，以色列則關閉英國駐耶路撒冷領事館回應，以巴衝突外交風暴持續延燒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309830.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:30", "link": "/news/story/6811/9743086"}, {"article_id": "9743744", "title": "川普「奪島」威脅…歐盟挺丹麥 投資格陵蘭2.3億元", "summary": "歐盟與格陵蘭7日宣布進一步深化夥伴關係。歐盟執委會主席范德賴恩(Ursula von der Leyen)訪問格陵蘭首府努克(Nuuk)期間宣布，歐盟將推出總額2億歐元(約2.32億美元)的「全球門戶夥伴關係方案」(Global Gateway Partnership Package)，相關資金將於2026年及2027年投入格陵蘭及與格陵蘭合作的項目。歐盟、格陵蘭及丹麥同日簽署新的聯合聲明，進一步擴大雙方在經濟、能源、數位連結及其他領域的合作。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35310814.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:29", "link": "/news/story/6809/9743744"}, {"article_id": "9743082", "title": "川普曬超大美地圖 一口氣併32國 學者：沒文字說明更挑釁", "summary": "國會山報報導，川普總統7日在自家社群分享一張AI生成地圖，將美國國旗直接覆蓋加拿大、墨西哥、格陵蘭、冰島、古巴、牙買加及中美洲、加勒比海多地，把大半個北美洲、共32個其他國家與地區都畫入美國版圖。川普沒有附上任何說明，白宮也未表明這代表正式政策，但他先前多次談及加拿大成為第51州、取得格陵蘭控制權，這張地圖迅速引發外界關注。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309818.jpg&M=1&s=Y&x=0&y=0&sw=660&sh=440&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:29", "link": "/news/story/6813/9743082"}, {"article_id": "9743192", "title": "恐攻事件25年 川普紀念9/11受害者矢言「永不忘記」", "summary": "9/11恐怖攻擊事件即將屆滿25周年，川普8日在白宮橢圓形草坪(Ellipse)悼念遇難者，誓言「永不忘記」，也為9/11事件紀念活動揭開序幕。川普指出，「9/11」攻擊是歷史上極少數能夠「將時間畫分為『在此之前』與『在此之後』」的時刻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309951.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:28", "link": "/news/story/6813/9743192"}, {"article_id": "9743883", "title": "911恐攻25周年 川普致敬救難英雄憶當年", "summary": "911恐攻即將屆滿25周年，美國總統川普今天在白宮一場紀念殉職救援人員的活動中表示，2001年9月11日恐攻過後，兩名消...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311074.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:27", "link": "/news/story/6813/9743883"}, {"article_id": "9743748", "title": "美控制澳洲逾半國防設施達110座 學者轟：第二波殖民", "summary": "最新數據顯示，美軍和美國軍工企業已控制或獲准進入澳洲110座國防設施，占該國所有軍事設施逾半，麥覺理大學教授Vince Scappatura將美國在澳洲各地取得軍事基地使用權的情況，形容為遍布澳洲大陸到「飽和」的程度，甚至是某種「第二波殖民」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35310818.jpg&M=1&s=Y&x=1&y=139&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:27", "link": "/news/story/6809/9743748"}, {"article_id": "9743129", "title": "改變高數領域… OpenAI：新AI破解數學「千禧年難題」", "summary": "人工智慧(AI)公司OpenAI宣布，最新AI技術已經破解數學界「千禧年大獎難題」(Millennium Problems)其中一道題目。紐約時報8日分析，這項宣布，象徵人工智慧正在從根本上改變高等數學領域，OpenAI的聲明是到目前為止最充滿戲劇化的徵兆，如此變化讓某些數學家感到振奮，但也引發其他人士擔憂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309893.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:27", "link": "/news/story/6811/9743129"}, {"article_id": "9743063", "title": "美禁止加國乳製品進口 3周後生效 這些商品也被封殺", "summary": "白宮8日表示，隨著美國與加拿大這個長期盟友兼鄰國之間的貿易戰升級，美國將禁止從加拿大進口乳製品、大多數酒類飲料以及摩托車。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309799.jpg&M=1&s=Y&x=0&y=0&sw=1257&sh=838&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:22", "link": "/news/story/6813/9743063"}, {"article_id": "9743737", "title": "中國百萬粉絲博主倫敦直播遭圍毆搶劫 使館介入", "summary": "擁有約500萬粉絲的旅英華人博主「倫敦Kj」（本名施克俊），近日在英國倫敦鬧區戶外直播時，遭三名外籍青年辱罵挑釁、圍毆致傷，並險些被搶走名表。整個過程透過直播鏡頭即時傳回中國，數千名線上觀眾目擊這起驚魂事件。目前，中國駐英國大使館已接獲求助並介入跟進。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35310805.jpg&M=1&s=Y&x=0&y=0&sw=1248&sh=832&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:21", "link": "/news/story/6812/9743737"}, {"article_id": "9743058", "title": "反抗川普貿易政策 卡尼成代表性人物", "summary": "美國總統川普的貿易戰加上一再宣稱要將加拿大納為美國一州，引發加拿大民眾反彈，讓加國總理卡尼得以憑藉民意支持對抗川普。美聯社指出，卡尼已成為國際反制川普貿易政策的代表人物。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309793.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:21", "link": "/news/story/6813/9743058"}, {"article_id": "9743130", "title": "AI破解高數／「納維-斯托克斯」難題 探索液體氣體運動", "summary": "數學家有時將「納維-斯托克斯存在性與光滑性問題」(Navier–Stokes existence and smoothness problem)簡稱為「納維-斯托克斯」問題。這道題目是被視為高等數學最重要問題的「千禧年大獎難題」(Millennium Problems)七大難題之一，如今被OpenAI尚未公布的最新人工智慧(AI)技術破解。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309895.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:20", "link": "/news/story/6811/9743130"}, {"article_id": "9743747", "title": "菲律賓傳奇拳王巴喬入閣 接掌反貧窮委員會誓言1願景", "summary": "菲律賓傳奇拳王巴喬(Manny Pacquiao)過去數十年都在拳擊場上奮戰；然而從現在起，這位體育偶像將把這股戰鬥精神用在對付一個更長遠的對手—貧窮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35310817.jpg&M=1&s=Y&x=0&y=0&sw=960&sh=640&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:19", "link": "/news/story/6809/9743747"}, {"article_id": "9743131", "title": "加州Calif AI電腦蠕蟲 能快速駭入微信…騰訊回應了", "summary": "紐約時報8日報導，總部位於加州帕拉阿圖(Palo Alto)的資安公司Calif，旗下研究團隊在短短一周多的時間裡，就透過人工智慧(AI)模型打造出能夠迅速駭入即時通訊軟體微信(WeChat)的電腦蠕蟲(computer worm)。Calif執行長泰當(Thai Duong，音譯)表示，這個資安漏洞相當罕見。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35309896.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 14:19", "link": "/news/story/6811/9743131"}]}, {"name": "西藏尼泊爾洪災", "articles": [{"article_id": "9742575", "title": "尼泊爾西藏洪災奪1400命 救難人員聚焦搜救3處隧道受困者", "date": "2026-09-08 22:56", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309188.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124995/9742575"}]}, {"name": "中東戰火連綿", "articles": [{"article_id": "9744164", "title": "強攻美艦升高衝突！伊朗斷定美期中選舉後必打 出招對抗川普施壓", "date": "2026-09-09 15:51", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311529.jpg&M=1&s=Y&x=7&y=0&sw=1265&sh=843&exp=3600&w=300", "link": "/news/story/