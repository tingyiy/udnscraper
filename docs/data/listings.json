nail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35516457.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 21:47", "link": "/news/story/7005/9877710"}, {"article_id": "9877705", "title": "亞冠賽／日韓6轟互鬥 日本靠宗山壘雙響砲、致勝3分彈維持全勝", "summary": "2026年亞洲職棒冠軍爭霸賽今晚在東京巨蛋進行日韓大戰，雙方單場6發全壘打互轟，日本隊敲4轟，恐怖前兩棒正木智也、宗山壘都是2天3轟表現，其中宗山壘此戰單場雙響砲，包括在8局下敲出致勝3分彈，幫助日本隊以9：5打下二連勝，延續亞冠賽9連勝；南韓隊則吞下二連敗，明天對決中華隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35516456.jpg&M=1&s=Y&x=0&y=0&sw=1219&sh=813&exp=3600&sl=W&fw=360", "date": "2026-11-13 21:40", "link": "/news/story/7001/9877705"}, {"article_id": "9877612", "title": "亞冠賽／日本隊超狂前兩棒 正木智也、宗山壘兩戰合敲6轟", "summary": "2026年亞洲職棒冠軍爭霸賽，日本隊前兩棒展現超狂火力，正木智也、宗山壘「雙箭頭」面對中華隊、南韓隊都是兩天敲3轟，截至日韓戰8局結束，兩人前兩場比賽已合計敲出6發全壘打...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35516324.jpg&M=1&s=Y&x=0&y=0&sw=1219&sh=813&exp=3600&sl=W&fw=360", "date": "2026-11-13 20:41", "link": "/news/story/7001/9877612"}, {"article_id": "9877436", "title": "王貞治建議大谷翔平改走「一刀流」 專注打擊挑戰極限", "summary": "日本職棒傳奇球星王貞治今天談及洛杉磯道奇隊球星大谷翔平時表示，隨著年齡增長，大谷的投球能力可能逐漸下滑，建議大谷不妨考慮...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35516058.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-13 18:50", "link": "/news/story/7001/9877436"}, {"article_id": "9877434", "title": "黑豹旗／升高三更有責任感 平鎮范博超5局飆8K突破生涯最速146公里", "summary": "平鎮高中今天在黑豹旗32強戰對上鶯歌工商，高三左投范博超先發上陣，主投5局只被擊出2支安打，飆8次三振，失1分，最快球速飆到生涯最快的146公里，范博超對此也十分驚喜，笑說：「太快就突破了，有點嚇到自己。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35516051.jpg&M=1&s=Y&x=0&y=72&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 18:36", "link": "/news/story/7001/9877434"}, {"article_id": "9877411", "title": "黑豹旗／高三雙左投范博超、劉任右合飆10K 平鎮8：1淘汰鶯歌闖16強", "summary": "中信盃黑豹旗全國高中棒球大賽今天展開32強戰，尋求衛冕的平鎮高中與上屆挺進8強的鶯歌工商正面交鋒，平鎮高三雙左投范博超、劉任右聯手壓制對手，加上打線在6局下進帳5分大局，終場以8：1拿下勝利，前進16強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515987.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 18:14", "link": "/news/story/7001/9877411"}, {"article_id": "9877294", "title": "無動力飛行運動知能研討會登場 跨域交流開創產業新視野", "summary": "為推動無動力飛行運動載飛體驗與飛旅品牌產業化，運動部全民運動署今天舉辦「115年無動力飛行運動業知能研討會」。本次研討會以「品牌行銷、旅遊體驗及永續營運」為主軸，邀請國際飛行傘教育認證機構講師、媒體影音團隊、產官學代表及專業人員齊聚一堂，透過經驗分享與專業座談，協助業者精進載飛體驗、遊程創新、品牌研發與永續營運。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515850.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 17:16", "link": "/news/story/7005/9877294"}, {"article_id": "9877101", "title": "亞洲運動機構協會年會落幕 趙士強盼達到交流互惠目的", "summary": "第9屆亞洲運動機構協會（ASIA）年會暨研討會，今天在高雄國訓中心落幕，8國代表熱情經驗分享，讓為期1天半的座談會笑聲不...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515843.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 17:14", "link": "/news/story/7005/9877101"}, {"article_id": "9877172", "title": "亞冠賽／中華隊14日對韓國關鍵戰 高志綱目標先馳得點", "summary": "中職聯隊今天在亞洲職棒冠軍爭霸賽以6比4擊敗澳洲隊，本屆賽事取得1勝1敗，明天對上強敵韓國隊，關係到冠軍賽門票，總教練高...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515842.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 17:13", "link": "/news/story/7001/9877172"}, {"article_id": "9877259", "title": "NBA／勇士波傑自研「鏡像柯瑞」訓練法！本尊大讚：真有創意", "summary": "勇士隊波傑姆斯基（Brandin Podziemski）上季表現備受球迷批評，本季熱身賽模仿柯瑞（Stephen Curry）動作還被球迷酸爆。不過波傑姆斯基開季表現優異，讓外界對他改觀，他接受《舊金山紀事報》訪問時也談到自己的「鏡像柯瑞」特殊訓練方法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515812.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 17:08", "link": "/news/story/7002/9877259"}, {"article_id": "9877102", "title": "U23世界盃／林佾葳連2次國際賽壓制南韓 韓媒感嘆：再次成為剋星", "summary": "台灣20歲業餘強投林佾葳在名古屋亞運對陣南韓隊，先發5局只失1分，一戰成名。今天U23世界盃棒球賽超級循環賽首戰，林佾葳再繳出6局失1分好投，幫助中華隊以6：1擊退南韓隊，韓媒也感嘆又被林佾葳壓制。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515589.jpg&M=1&s=Y&x=280&y=136&sw=627&sh=418&exp=3600&sl=W&fw=360", "date": "2026-11-13 16:03", "link": "/news/story/7001/9877102"}, {"article_id": "9877080", "title": "亞冠賽／打中華隊不像昨天打南韓順手 澳洲4棒嘆：令人失望", "summary": "澳洲隊昨天以8：7擊敗南韓隊震撼亞冠賽場，今天沒能延續氣勢，以4：6不敵中華隊，總教練尼爾森（Dave Nilsson）賽後嚴詞表示：「這是澳洲隊近幾年來最令我失望的一場比賽。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515593.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 15:56", "link": "/news/story/7001/9877080"}, {"article_id": "9876995", "title": "國華球場總監勇奪 GCSAA「創新保育獎」冠軍！ 連續三年獲國際肯定", "summary": "北投國華高爾夫俱樂部總監蔡文生勇奪2026年GCSAA「創新保育獎」冠軍，連續三年獲國際肯定，團隊並推動智慧灌溉、生態保育與資源循環。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515473.jpg&M=1&s=Y&x=0&y=487&sw=1108&sh=739&exp=3600&sl=W&fw=360", "date": "2026-11-13 15:32", "link": "/news/story/7005/9876995"}, {"article_id": "9877019", "title": "熊本羽賽／林湘緹不敵宮崎友花 我國僅剩女雙許尹鏸／林芝昀晉4強", "summary": "BWF超級500的日本熊本名人賽今天展開8強賽程，我國共有5組人馬相繼當場，但最終僅有女雙許尹鏸／林芝昀順利擊敗中國大陸組合晉級到4強，包括女單林湘緹以及混雙葉宏蔚／詹又蓁都止步於8強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515506.jpg&M=1&s=Y&x=0&y=0&sw=1071&sh=714&exp=3600&sl=W&fw=360", "date": "2026-11-13 15:29", "link": "/news/story/7005/9877019"}, {"article_id": "9876985", "title": "NBA／50分11助攻0失誤寫多項紀錄 康寧漢坦言打了生涯最棒一戰", "summary": "活塞隊一哥康寧漢（Cade Cunningham）在今天客場對上巫師隊的比賽中，上演了一場載入歷史的表現，他全場狂飆52分外帶11助攻且零失誤，締造了NBA自1977-78年採計失誤數據以來的史詩級紀錄，並幫助活塞在二度延長賽以144：140險勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515435.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 15:15", "link": "/news/story/7002/9876985"}, {"article_id": "9876978", "title": "NBA／傳「高砲塔」里德被交易機率高 勇士有興趣網羅", "summary": "黃蜂隊休賽季將小鮑爾（LaMelo Ball）交易至灰狼隊，得到里德（Naz Reid）等資產。外界預期黃蜂會在交易大限前將里德賣出，換回更多未來選秀權資產。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515419.jpg&M=1&s=Y&x=458&y=14&sw=662&sh=442&exp=3600&sl=W&fw=360", "date": "2026-11-13 15:15", "link": "/news/story/7002/9876978"}, {"article_id": "9876946", "title": "黑豹旗／車禍斷職棒夢 成大南工黃宇揚黑豹旗最終戰飆速130公里", "summary": "成大南工在今年中信盃黑豹旗全國高中棒球大賽於64強止步，高三球員黃宇揚最快球速達130公里，在科班球隊中顯得相當吸睛，雖因一場車禍斷了職棒夢，但沒放棄他對棒球的熱愛。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515331.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 14:59", "link": "/news/story/7001/9876946"}, {"article_id": "9876835", "title": "亞冠賽／中華隊首勝到手！林佳緯、張仁瑋敲雙安 馬傑森2打點力退澳洲", "summary": "中華隊無懼「晚接午」考驗，今天面對澳洲隊，張仁瑋、林佳緯都有雙安，幫助中華隊在比賽後段突圍，終場以6：4贏球，拿下本屆賽會首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515112.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 14:24", "link": "/news/story/7001/9876835"}, {"article_id": "9876795", "title": "黑豹旗／完投三局寫棒球生涯代表作 成大南工王宣閔登投手丘圓夢", "summary": "成大南工今天在中信盃黑豹旗全國高中棒球大賽64強戰以9：11不敵六和高中，本屆賽事畫下句點，陣中高三選手、身高僅128公分的王宣閔沒能再登板，但預賽三局無失分的表現，仍是今年賽事一大亮點，也為他的黑豹旗旅程記上一筆深刻回憶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35515028.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-13 14:10", "link": "/news/story/7001/9876795"}, {"article_id": "9876755", "title": "MLB／道奇不妙！傳聯盟內部普遍預期史庫柏轉戰大都會", "summary": "2屆塞揚左投史庫柏（Tarik Skubal）是今年自由球員市場最大咖，據大聯盟官網記者費恩森（Mark Feinsand）報導，聯盟內部普遍預期史庫柏會加盟大都會隊，而不是留道奇隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35514983.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 14:02", "link": "/news/story/6999/9876755"}, {"article_id": "9876682", "title": "亞冠賽／光之愛徒！王念好敲二壘打躍日媒版面 「備受期待的台灣4棒」", "summary": "中華隊今天在亞冠賽面對澳洲隊，第五局由「富邦金孫」王念好敲二壘打追平戰局，也躍上日本媒體版面，「Sponichi Annex」提到他是備受期待的台灣四棒，也是過去歐力士隊的後藤光尊子弟兵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35514806.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 13:31", "link": "/news/story/7001/9876682"}, {"article_id": "9876607", "title": "亞冠賽／陳克羿首局核爆→2局後變身「威能key」 王念好敲長打追平4:4", "summary": "中華隊晚接午迎戰澳洲隊，打線甦醒，張仁瑋、王念好都有長打貢獻，克服先發投手陳克羿首局「單局爆」帶來的2：4落後，打完前5局追平4：4。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35514679.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 12:57", "link": "/news/story/7001/9876607"}, {"article_id": "9876575", "title": "NBA／太陽第四節「封印格林」 布克關鍵時刻發威險勝黃蜂", "summary": "太陽隊今天在主場迎戰殘陣黃蜂隊，第四節將格林（Jalen Green）冰在板凳後展開反撲，靠著布克（Devin Booker）關鍵時刻連續砍分，以101：96辛苦收下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35514624.jpg&M=1&s=Y&x=0&y=177&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-13 12:46", "link": "/news/story/7002/9876575"}, {"article_id": "9876529", "title": "從膝傷低潮到亞帕運跆拳道金牌 蕭翔文二連霸背後有教練吳燕妮相挺", "summary": "中華跆拳道好手蕭翔文今年挑戰亞洲帕拉運動會衛冕，4月訓練時右膝重傷，備戰過程因傷勢與壓力情緒崩潰，所幸教練吳燕妮一路陪伴，適時調整訓練、穩定身心狀態，挺過膝傷低潮，10月赴日奪金，成功衛冕，為台灣代表團拿下本屆首面獎牌與金牌，2年後將進軍洛杉磯帕運。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35514518.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-13 12:29", "link": "/news/story/7005/9876529"}]}, {"name": "棒球", "articles": [{"article_id": "9877705", "title": "亞冠賽／日韓6轟互鬥 日本靠宗山壘雙響砲、致勝3分彈維持全勝", "date": "2026-11-13 21:40", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/13/35516456.jpg&M=1&s=Y&x=0&y=0&sw=1219&sh=813&exp=3600&w=300", "link": "/news/story/7001/9877705"}, {"article_id": "9877612", "title": "亞冠賽／日本隊超狂前兩棒 正木智也、宗山壘兩戰合敲6轟", "date": "2026-11-13 20:41", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?