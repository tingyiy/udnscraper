es": [{"article_id": "9707938", "title": "MLB／原力覺醒！洋基年輕王牌穿星際大戰鞋 球員周末造型爆紅", "summary": "紐約洋基年輕右投斯萊特勒（Cam Schlittler）從不掩飾自己對《星際大戰》的熱愛。適逢大聯盟「球員周末」，球員能透過裝備展現個人特色，斯萊特勒乾脆把光明面與黑暗面都穿上腳，左腳釘鞋是黑武士（Darth Vader），右腳則是絕地武士主題。接著，他也用投球證明，這位美聯塞揚獎競爭者之一，確實「原力強大」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254437.jpg&M=1&s=Y&x=44&y=0&sw=1211&sh=807&exp=3600&sl=W&fw=360", "date": "2026-08-22 18:09", "link": "/news/story/6999/9707938"}, {"article_id": "9707932", "title": "U18亞青男籃／中華隊不敵伊朗 將與菲律賓爭奪第7名", "summary": "U18男籃亞洲盃今天展開排名賽賽程，中華隊在5至8排名賽出戰伊朗，在上半場就落後到25分的情況下，最終以84：105吞下敗仗，接下來將與菲律賓爭奪第7名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254425.png&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-22 17:59", "link": "/news/story/7003/9707932"}, {"article_id": "9707898", "title": "MLB／馬提列傷兵卻在比賽時間出入賭場 響尾蛇教頭說沒違規", "summary": "響尾蛇隊球星馬提（Ketel Marte）先前無故缺席比賽惹議，球團找到人後，在21日以左膝發炎將他放進傷兵名單，結果今天又被民眾直擊在比賽期間出現在度假村賭場，場外不斷生波。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254342.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 17:30", "link": "/news/story/7002/9707898"}, {"article_id": "9707873", "title": "NBA／巴特勒相處模式超怪？前隊友爆料：前晚像最好朋友隔天完全不理你", "summary": "前熱火射手史特魯斯（Max Strus）近日談到昔日隊友「士官長」巴特勒（Jimmy Butler），直言生涯至今從沒遇過像他這樣的人，除了會在關鍵時刻瞬間「切換開關」，私底下更有一套讓隊友摸不著頭緒的相處模式。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254282.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 17:23", "link": "/news/story/7002/9707873"}, {"article_id": "9707857", "title": "MLB／馬提無故失蹤事件 響尾蛇教頭坦言：有被背叛的感覺", "summary": "響尾蛇隊正在追逐季後賽席次之際，明星二壘手馬提（Ketel Marte）卻失聯4天，總教練羅夫洛（Torey Lovullo）坦言，有被背叛的感覺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254175.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:53", "link": "/news/story/6999/9707857"}, {"article_id": "9707860", "title": "中職／先發拉緊報被大雨幫一把 葉總笑稱：就⋯閃過去了", "summary": "味全龍隊在迎接本周5連戰之前，先發投手戰力拉緊報，準備要動用本季第3位本土先發，但幸運被老天幫了一把，昨天對上富邦悍將隊之戰因雨延賽，總教練葉君璋笑說：「就⋯⋯閃過去了，還不錯！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254179.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:52", "link": "/news/story/7001/9707860"}, {"article_id": "9707837", "title": "霹靂舞／捷運盃首度升級國際邀請賽 明年再推出全新Metro-Pop賽制", "summary": "捷運盃街舞大賽今年首度升級舉辦國際霹靂舞邀請賽，昨天晚間特別舉行歡迎餐會，來自世界各地的頂尖選手及國際評審齊聚台北交流，台北大眾捷運股份有限公司更宣布，2027年將推出全新Metro-Pop賽制。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254161.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:44", "link": "/news/story/7005/9707837"}, {"article_id": "9707815", "title": "MLB／道奇球迷策畫「全場鼓掌」暖挺！羅伯茲堅信塔克已跨過轉折點", "summary": "道奇4年2.4億美元補強的塔克（Kyle Tucker）日前一度陷入生涯最長的連續無安打低潮。然而今日主場面對海盜時，當塔克第2局走進打擊區，道奇球場卻沒有再次響起噓聲，取而代之的是大批球迷刻意送上的長時間掌聲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254091.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:40", "link": "/news/story/6999/9707815"}, {"article_id": "9707831", "title": "MLB／「飛向外野浩瀚無垠」！皇家野手拿巴斯光年球棒開轟 考慮下次用蜘蛛人球棒", "summary": "堪薩斯市皇家外野手伊斯貝爾（Kyle Isbel）在大聯盟「球員周末」揮出一棒話題性十足的全壘打。他拿著以《玩具總動員》角色巴斯光年（Buzz Lightyear）為主題設計的球棒，於今天主場面對底特律老虎之戰第5局轟出陽春砲，幫助皇家最終以5：2拿下勝利，收下本季最長6連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254151.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:37", "link": "/news/story/6999/9707831"}, {"article_id": "9707819", "title": "日職／古林睿煬睽違逾2個月再登板 二軍投1局3上3下含2K", "summary": "北海道日本火腿鬥士隊「台灣金孫」古林睿煬終於重返投手丘，沉寂2個多月後首度出賽，在日本職棒二軍後援1局無失分", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254153.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:37", "link": "/news/story/7001/9707819"}, {"article_id": "9707808", "title": "中職／盼李東洺找回球速和控球 江國豪、陳仕朋有望補起一軍先發", "summary": "富邦悍將隊本土投手李東洺今年上半季投出10連勝隊史紀錄，但進入下半季後狀況不盡理想，14日被降二軍，總教練後藤光尊指出，希望他能夠針對投球機制和球速進行調整，盡快恢復水準， 這段時間包括江國豪、陳士朋和年輕選手都有機會扛一軍先發。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254139.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:16", "link": "/news/story/7001/9707808"}, {"article_id": "9707795", "title": "棒球／日本亞青賽18人名單公布 157公里火球男織田翔希領軍復仇", "summary": "日本高校野球聯盟22日公布，將參加9月7日至13日在台灣舉行的「第14屆BFA U18亞洲青棒錦標賽」日本代表隊18人名單。其中，擁有最快157公里火球的橫濱高校王牌投手織田翔希，以及沖繩尚學左投末吉良丞，以及今夏富山大會投出無安打比賽、最快156公里的高岡第一左投前田侑大等好手都入選代表隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254059.jpg&M=1&s=Y&x=36&y=0&sw=1133&sh=755&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:10", "link": "/news/story/7001/9707795"}, {"article_id": "9707800", "title": "中職／王威晨賽前突降二軍 兄弟球團：腹部輕微拉傷", "summary": "中信兄弟隊王威晨今天賽前下放二軍，球團透露傷情為腹部輕微拉傷，在打擊練習時感覺不適，先休息調整，避免傷勢加重。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254058.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 16:08", "link": "/news/story/7001/9707800"}, {"article_id": "9707742", "title": "MLB／艾德曼再見安助道奇4連勝！羅伯茲點出最大轉變：所有人重新投入", "summary": "道奇今日主場面對海盜一路鏖戰至延長賽，最終靠艾德曼（Tommy Edman）10局下2出局後敲出再見安，以5：4氣走對手，拿下自7月底以來首度4連勝。總教練羅伯茲（Dave Roberts）也點出球隊近期最大的轉變，直言所有人似乎已「重新投入」比賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253970.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 15:57", "link": "/news/story/6999/9707742"}, {"article_id": "9707767", "title": "中職／王建民認證散漫 誇呂彥青巨大拆彈「滿壘守住很厲害欸」", "summary": "中信兄弟隊呂彥青壓制統一獅隊有口皆碑，昨天再度演出巨大的拆彈，賽後笑曝投手教練王建民都給很難的炸彈，王建民對此笑說：「對啊！這樣他才有比較想要丟球的感覺，不然你看他沒壓力都散散的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254003.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 15:50", "link": "/news/story/7001/9707767"}, {"article_id": "9707761", "title": "中職／菲力士期末考只是過關「室內」小題 王建民準備新關卡", "summary": "中信兄弟隊洋投菲力士昨天在期末考繳出6局失1分，獲得留校觀察的機會，明天推出本土投手游竣宥，而非新洋投杰克，投手教練王建民指出，現在主要觀察點在於菲力士的室外球場表現，「就是再給他一次機會，看看室外的手汗問題。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35254001.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-22 15:40", "link": "/news/story/7001/9707761"}, {"article_id": "9707757", "title": "MLB／道奇悲報！古巴中外野帕赫斯骨裂 教頭曝至少缺陣4周", "summary": "道奇隊今天在延長賽以5：4擊敗海盜隊，賽後卻傳來悲報。古巴籍先發中外野手帕赫斯（Andy Pages）被診斷出左手背骨裂，道奇總教練羅伯茲（Dave Roberts）表示至少要休息4周，屆時例行賽已經快結束。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253990.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 15:37", "link": "/news/story/6999/9707757"}, {"article_id": "9707750", "title": "中職／又被「青」手送進監獄 林岳平摔帽不想多談：不至於完全打不到", "summary": "統一獅隊本季一碰上呂彥青就沒轍，昨天滿壘、無人出局竟然換不回分數，總教練林岳平氣到摔帽，今天談到此事也還在無奈，「我能講什麼？」他坦言大好機會，但一顆確實擊出去的球都沒有。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253983.jpg&M=1&s=Y&x=0&y=0&sw=1116&sh=744&exp=3600&sl=W&fw=360", "date": "2026-08-22 15:29", "link": "/news/story/7001/9707750"}, {"article_id": "9707707", "title": "MLB／洋基5連勝有望「奪還」美東龍頭！左打法官：我們牛棚太強了", "summary": "洋基隊今天主場迎戰藍鳥隊，靠著「左打法官」瓊斯（Spencer Jones）2分砲，加上少主斯萊特勒（Cam Schlittler）6局失1分的優質先發，以3：1拿下勝利，洋基現在只落後美東龍頭光芒隊3場勝差。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253885.jpg&M=1&s=Y&x=0&y=18&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-22 14:36", "link": "/news/story/6999/9707707"}, {"article_id": "9707607", "title": "NBA／無懼魔術連3季「一輪遊」！貝恩豪言強敵環伺仍有望奪冠", "summary": "儘管球隊連續第3年止步季後賽首輪，魔術後衛貝恩（Desmond Bane）近日受訪時仍直言，即使東區迎來詹姆斯（LeBron James）、布朗（Jaylen Brown）、「字母哥」安戴托昆波（Giannis Antetokounmpo）等球星轉隊，，他依舊相信魔術有能力成為其中一支爭冠球隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253762.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-22 14:32", "link": "/news/story/7002/9707607"}, {"article_id": "9707583", "title": "棒球／智辯和歌山4比3險勝健大高崎 奪下夏季甲子園冠軍", "summary": "夏季甲子園決賽今天登場，智辯和歌山高中雖然在8局上被健大高崎敲出逆轉2分砲，落後1分，但8局下隨即追回2分，再度逆轉局勢...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253875.png&M=1&s=Y&x=104&y=0&sw=1068&sh=712&exp=3600&sl=W&fw=360", "date": "2026-08-22 14:26", "link": "/news/story/7001/9707583"}, {"article_id": "9707695", "title": "MLB／如何與馬恰多、阿隆索一起練球？ 新人王熱門「穿西裝做PPT」說服", "summary": "紅人22歲新星史都華（Sal Stewart）本季打出國聯新人王熱門身手，不過他近日透露當年為了爭取跟教士球星馬恰多（Manny Machado）以及前大聯盟球員阿隆索（Yonder Alonso）一起訓練，甚至特地穿上西裝、準備一份「PPT提案」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253857.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 14:24", "link": "/news/story/6999/9707695"}, {"article_id": "9707666", "title": "MLB／意外嗎？山本由伸第13勝又被牛棚搞砸 艾德曼再見安助道奇4連勝", "summary": "道奇隊今天由日籍強投山本由伸今天先發迎戰海盜隊，主投6.1局失2分、飆9次三振，但牛棚又沒能守住他勝投，8局上哈特（Kyle Hurt）挨轟遭追平，道奇直到10局下靠艾德曼（Tommy Edman）敲再見安打，以5：4拿下4連勝，連兩戰在延長賽贏球。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253831.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-22 13:47", "link": "/news/story/6999/9707666"}, {"article_id": "9707639", "title": "世界盃男籃／美國隊名單出爐！詹姆斯聯手二連霸前鋒拚晉級門票", "summary": "美國男籃今天公布世界盃資格賽第四階段12人名單，36歲老將詹姆斯（Mike James）領銜，攜手二連霸前鋒瓊斯（Dillon Jones），本階段將與智利，哥倫比亞交手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/22/35253823.jpg&M=1&s=Y&x=146&y=119&sw=1012&sh=675&exp=3600&sl=W&fw=360", "date": "2026-08-22 13:40", "link": "/news/story/7002/9707639"}]}, {"name": "棒球", "articles": [{"article_id": "9707750", "title": "中職／又被「青」