hoto.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35417319.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9812748"}, {"article_id": "9812765", "title": "MLB先發投手重要性逐漸式微？現代棒球投打價值天秤正在失衡", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35417351.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9812765"}]}, {"name": "最新文章", "articles": [{"article_id": "9819443", "title": "MLB／道奇老化速度太快、魔力消失 洛時：無緣3連霸主因是大谷翔平", "summary": "挑戰3連霸的道奇隊在國聯冠軍賽遭釀酒人隊橫掃，令不少球迷意外。《洛杉磯時報》撰長文分析道奇去年與今年的落差，點名大谷翔平是問題的起點，「天才第一次展現出凡人的脆弱。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427643.jpg&M=1&s=Y&x=0&y=0&sw=1163&sh=775&exp=3600&sl=W&fw=360", "date": "2026-10-16 16:36", "link": "/news/story/6999/9819443"}, {"article_id": "9819467", "title": "高球／富邦長春公開賽28日開打 謝敏男攜手林志傑、高國輝進行趣味賽", "summary": "國內歷史最悠久的長春職業高球大賽「富邦長春公開賽」，將於10月28至30日在老淡水球場點燃戰火，今年適逢富邦集團成立65周年，賽事總獎金一舉加碼至800萬元，吸引來自12國、118名各國職業好手齊聚一堂，要在台灣最具代表性的百年球場一較高下。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427640.jpg&M=1&s=Y&x=0&y=0&sw=1162&sh=775&exp=3600&sl=W&fw=360", "date": "2026-10-16 16:34", "link": "/news/story/7003/9819467"}, {"article_id": "9819456", "title": "中職／張家兄弟總冠軍賽對決 張政禹回應張士綸「來就來，誰怕誰！」", "summary": "中職總冠軍賽「龍象對決」明天開打，由味全龍隊在台北大巨蛋迎戰中信兄弟隊，「張家兄弟」的手足之爭成為受關注的一大焦點，中信兄弟張士綸日前對哥哥喊話「張政禹我來了！」張政禹今天也回應：「來就來，誰怕誰！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-10-16 16:31", "link": "/news/story/7001/9819456"}, {"article_id": "9819295", "title": "MLB／大谷翔平三分砲難救道奇！ 4敗全被逆轉寫11年首見難堪紀錄", "summary": "大谷翔平轟三分砲仍難救道奇，4：6遭釀酒人逆轉吞4連敗，系列賽遭橫掃，挑戰三連霸夢碎；4戰全曾領先卻全遭逆轉，寫11年首見紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427366.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-16 15:43", "link": "/news/story/6999/9819295"}, {"article_id": "9819314", "title": "MLB／未回應明年是否回道奇 史庫柏看奪冠列車翻車：真的太難了", "summary": "史庫柏（Tarik Skubal）因交易季中轉戰道奇隊，搭上的不是奪冠列車，車子只開到國聯冠軍賽就遭洗劫一空，季後將成為自由球員的他，目前無意談論自己的下一步。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427388.jpg&M=1&s=Y&x=0&y=26&sw=1212&sh=808&exp=3600&sl=W&fw=360", "date": "2026-10-16 15:31", "link": "/news/story/6999/9819314"}, {"article_id": "9819225", "title": "MLB／羅哈斯泛淚向道奇隊友宣布退休 昔霸凌奇森姆受關注", "summary": "道奇隊國聯冠軍賽慘遭釀酒人隊橫掃，三連霸夢碎。37歲老將羅哈斯（Miguel Rojas）更在賽後會議向全隊宣布退休消息，讓現場氣氛更加沉重。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427229.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 15:25", "link": "/news/story/6999/9819225"}, {"article_id": "9819264", "title": "中職／總冠軍賽首次「龍象爭霸」明開打 雙方32人名單揭曉", "summary": "中職總冠軍賽史上首次「龍象爭霸」明天開戰，由例行賽年度勝率第一的味全龍隊，迎戰下半季冠軍中信兄弟隊，進行7戰4勝制系列賽，7場賽事全在台北大巨蛋舉行，雙方今天公布32人參賽名單。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427310.png&M=1&s=Y&x=102&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-16 15:12", "link": "/news/story/7001/9819264"}, {"article_id": "9819064", "title": "台灣大賽龍象大戰登場！《Run & Roar 奔龍而上》紀實冊 嘖嘖募資倒數", "summary": "中職37年台灣大賽17日開打，味全龍與中信兄弟首度上演龍象大戰；《Run & Roar 奔龍而上》紀實冊募資倒數，收錄龍隊歷史與人物故事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427065.png&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-10-16 15:00", "link": "/news/story/7001/9819064"}, {"article_id": "9819196", "title": "MLB／朗希季後賽ERA不到3 盼明年重返先發：解決暴露出的問題", "summary": "佐佐木朗希季後賽3場防禦率2.70，道奇遭釀酒人橫掃；他盼提升變化球品質，明年例行賽以重返先發為目標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427180.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 14:50", "link": "/news/story/6999/9819196"}, {"article_id": "9819176", "title": "MLB／道奇三連霸破滅！韓媒嘆金慧成失去登場機會 旅美韓將全出局", "summary": "韓國媒體報導，洛杉磯道奇在國聯冠軍賽第4戰主場不敵密爾瓦基釀酒人，系列賽苦吞4連敗遭到橫掃，不僅無緣晉級世界大賽，挑戰3連霸的美夢也提前破滅。隨著道奇季後賽之旅畫下句點，韓籍內野手金慧成的2026年賽季也正式結束，代表今年仍在大聯盟征戰的韓國球員已全數出局。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427175.jpg&M=1&s=Y&x=0&y=15&sw=1091&sh=727&exp=3600&sl=W&fw=360", "date": "2026-10-16 14:39", "link": "/news/story/6999/9819176"}, {"article_id": "9818966", "title": "MLB／洋基終結者可望獲合格報價 應會放奇森姆進自由市場", "summary": "洋基休賽季留人策略明朗，擬向終結者貝德納開出2315萬美元合格報價，奇森姆因本季攻擊下滑恐成自由球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426794.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 14:27", "link": "/news/story/6999/9818966"}, {"article_id": "9819168", "title": "MLB／感嘆整場比賽只有一支安打 大谷翔平：釀酒人真的很強", "summary": "大谷翔平終於在國聯冠軍賽G4走出低潮，敲出3分砲。不過道奇隊仍以4：6輸給釀酒人隊，本季畫下句點。大谷賽後談到擊出全壘打當下的想法。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427148.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-16 14:25", "link": "/news/story/6999/9819168"}, {"article_id": "9819139", "title": "中職／龍隊洋投4取3捨棄魔神龍 G4可能推黃暐傑先發", "summary": "味全龍隊明天起與中信兄弟展開總冠軍賽，擺開4洋投的堅強陣容，葉總透露，前三戰確定交給3名洋投，第4戰則預計由本土投手黃暐傑及不占洋將名額的伍鐸中「二擇一」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427111.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 14:13", "link": "/news/story/7001/9819139"}, {"article_id": "9819128", "title": "PLG／新賽季四大改變！開放日籍亞外、「違反運動精神犯規」走入歷史", "summary": "PLG公布更新的賽務章程及相關比賽規則，新賽季將有四大改變，分別為首度開放「亞洲外籍球員」（本季限日本）、註冊名單擴大到20人、設立註冊大限與交易截止日、違反運動精神犯規改為「阻斷犯規」與「惡性犯規」。聯盟強調，這樣的改變旨在提升比賽精采度並且同步和FIBA新規則接軌，除了讓球員在例行賽就開始習慣，未來在打東亞超級聯賽和進入國家隊都能減少對新規則的適應，同時也提供球迷朋友更多元的比賽內容。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427138.jpg&M=1&s=Y&x=0&y=0&sw=617&sh=411&exp=3600&sl=W&fw=360", "date": "2026-10-16 14:11", "link": "/news/story/7003/9819128"}, {"article_id": "9819029", "title": "中職／隊長吉力吉撈缺席台灣大賽 葉總：狀況不穩定無法勉強", "summary": "中職總冠軍賽明天展開，味全龍隊將與中信兄弟展開7戰4勝制系列賽，32人名單揭曉前，總教練葉君璋透露，隊長吉力吉撈・鞏冠確定缺陣，「如果他狀況不是100%準備好的話，對他或對球隊來講都不是一件好事情。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426910.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 13:42", "link": "/news/story/7001/9819029"}, {"article_id": "9819011", "title": "NBA／76人探花稱打奧運比總冠軍重要 白巧克力怒批：付薪水的人更重要", "summary": "76人隊探花埃奇庫姆（VJ Edgecombe）最近表示，代表巴哈馬參加奧運對他而言，比贏下NBA總冠軍更有意義，前NBA後衛「白巧克力」威廉斯（Jason Williams）對這名新秀的價值觀表達強烈不滿，質疑如果76人隊友聽到這番言論，會有什麼感受。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426880.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 13:34", "link": "/news/story/7002/9819011"}, {"article_id": "9818956", "title": "NBA／盛讚前隊友83分神紀錄 巴特勒：阿德巴約什麼都做得很好", "summary": "邁阿密熱火中鋒阿德巴約（Bam Adebayo）上季狂轟83分，超越傳奇球星布萊恩（Kobe Bryant）的單場81分紀錄，成為NBA歷史單場得分第2高的球員。儘管這場歷史級表現引發不少討論，但昔日熱火隊友、現效力勇士的巴特勒（Jimmy Butler），近日公開表達對阿德巴約的肯定，直言83分是相當了不起的成就。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426786.jpg&M=1&s=Y&x=0&y=20&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 13:14", "link": "/news/story/7002/9818956"}, {"article_id": "9818894", "title": "NBA／熱火找來字母哥仍被看衰 前教頭直言阿德巴約「過譽了」", "summary": "前熱火教頭范甘迪看衰新陣容，直指阿德巴約進攻「過譽」，認為補強外線恐削弱防守，不認為球隊能闖進東區前六。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426701.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 12:51", "link": "/news/story/7002/9818894"}, {"article_id": "9818901", "title": "PLG／洋基工程竹、苗雙主場季票開賣 新增 Fans Club", "summary": "PLG洋基工程隊今天宣布，2026–27年賽季正式季票即將開賣，透過多種席位方案、會員贈品與專屬權益，提供球迷不同的整季觀賽選擇。新賽季主場賽事將於新竹市立體育館及苗栗巨蛋體育館舉行，球隊將於12月6日在新竹市立體育館迎戰桃園璞園領航猿，揭開新賽季主場序幕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426730.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 12:51", "link": "/news/story/7003/9818901"}, {"article_id": "9818884", "title": "MLB／134億打造的道奇豪華艦隊4戰沉沒 羅伯茲：運動迷人的地方", "summary": "過去兩年世界大賽冠軍球隊道奇隊，今年在國聯冠軍賽被釀酒人隊打得潰不成軍，只撐4場比賽就繳械，總教練羅伯茲（Dave Roberts）說：「這就是運動迷人的地方，你永遠無法預知結果，無論準備得多麼充分、求勝的渴望有多麼強烈，都沒有人能保證一定會贏。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426683.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 12:44", "link": "/news/story/6999/9818884"}, {"article_id": "9818824", "title": "NBA／去年挑釁柯瑞、數據被當迷因嘲弄 勇士新同學：算好事", "summary": "休賽季加入勇士隊的後衛威廉斯（Brandon Williams）去年還在挑釁柯瑞（Stephen Curry），如今卻成為隊友，他受訪時談到自己與柯瑞的迷因梗，並表達對這位傳奇球星的尊重。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426586.jpg&M=1&s=Y&x=106&y=100&sw=763&sh=509&exp=3600&sl=W&fw=360", "date": "2026-10-16 12:24", "link": "/news/story/7002/9818824"}, {"article_id": "9818815", "title": "MLB／首嘗季後賽出局不甘心 大谷翔平喊明年還是要當二刀流", "summary": "大谷翔平的三分砲，讓道奇隊可以短暫做起讓3追4的美夢，只用3局，領先花光，道奇隊最終4：6輸給釀酒人隊，在國聯冠軍賽4戰出局，大谷翔平賽後直言有滿滿的不甘心，也明確表示明年將繼續挑戰二刀流。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426582.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-16 12:16", "link": "/news/story/6999/9818815"}, {"article_id": "9818694", "title": "中職／台灣大賽7戰打好打滿竟是史上最多 連9年「得G1者得天下」", "summary": "中信兄弟明日出戰味全龍台灣大賽G1，歷年已有11次打滿7戰；近9年連續「得G1者得天下」，首戰勝隊封王率87.87%。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426349.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 12:05", "link": "/news/story/7001/9818694"}, {"article_id": "9818743", "title": "MLB／為了醫療保險反悔退休如今奪國聯冠軍賽MVP 包爾斯成釀酒人第一人", "summary": "2024年球季結束後已經通知經紀人自己決定退休，包爾斯（Jake Bauers）不會想到，自己最風光的一頁，會在兩年後的10月，登頂國聯冠軍賽MVP，即將隨釀酒人隊首度挑戰世界大賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426470.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-16 11:58", "link": "/news/story/6999/9818743"}]}, {"name": "棒球", "articles": [{"article_id": "9819029", "title": "中職／隊長吉力吉撈缺席台灣大賽 葉總：狀況不穩定無法勉強", "date": "2026-10-16 13:42", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426910.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9819029"}, {"article_id": "9819264", "title": "中職／總冠軍賽首次「龍象爭霸」明開打 雙方32人名單揭曉", "date": "2026-10-16 15:12", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35427310.png&M=1&s=Y&x=102&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9819264"}, {"article_id": "9818694", "title": "中職／台灣大賽7戰打好打滿竟是史上最多 連9年「得G1者得天下」", "date": "2026-10-16 12:05", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426349.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9818694"}, {"article_id": "9818399", "title": "日職／好消息！U18台灣隊長張乙安、投手許宸緯育成約加盟歐力士", "date": "2026-10-16 10:01", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35425793.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9818399"}, {"article_id": "9819456", "title": "中職／張家兄弟總冠軍賽對決 張政禹回應張士綸「來就來，誰怕誰！」", "date": "2026-10-16 16:31", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_1.jpg&w=300", "link": "/news/story/7001/9819456"}]}, {"name": "MLB", "articles": [{"article_id": "9818682", "title": "MLB／史上首見以橫掃復仇橫掃 釀酒人教頭：用一群悍將戰勝一群名人堂", "date": "2026-10-16 11:36", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/16/35426297.jpg&M=1&s=Y&x=0&y=16&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/6999/9818682"}, {"article_id": "9818884", "title": "MLB／134億打造的道奇豪華艦隊4戰沉沒 羅伯茲：運動迷人的地方", "date": "2026-10