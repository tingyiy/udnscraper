://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/07/35305747.jpg&M=1&s=Y&x=0&y=138&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9740130"}, {"article_id": "9739773", "title": "光芒慧眼識英雄賺翻了！ 交易截止日後6人轉隊幫大忙", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/07/35305400.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9739773"}, {"article_id": "9739954", "title": "日職／小笠原慎之介成巨人先發救世主 球迷真心換絕情又一例", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35306539.jpg&M=1&s=Y&x=0&y=347&sw=1108&sh=739&exp=3600&w=300", "link": "/news/story/122629/9739954"}]}, {"name": "最新文章", "articles": [{"article_id": "9744982", "title": "中職／范國宸挨砸示意「我沒事」 後藤光尊為瑪帝斯兩次觸身球致歉", "summary": "富邦悍將隊、味全龍隊昨天在比賽後段因近身球爆衝突，今晚在台北大巨蛋繼續交手，依舊充滿煙硝味，雙方單場再出現4次觸身球，但沒有再出現激情場面。悍將先發投手瑪帝斯2度砸到對手，賽後他多次強調「真的沒要引起衝突。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312721.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 22:55", "link": "/news/story/7001/9744982"}, {"article_id": "9744924", "title": "中職／威能帝「投1休4」飆9局無四死球完封勝 雄鷹吞7連敗平隊史", "summary": "樂天桃猿隊洋投威能帝休4天再登板，今天以101球投出9局無四死球完封勝，僅被擊出4支安打，率隊以4：0完封台鋼雄鷹，拿下跨季對戰7連勝，並讓雄鷹吞下平隊史最長的7連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312654.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 22:17", "link": "/news/story/7001/9744924"}, {"article_id": "9744885", "title": "中職／單場4顆觸身球沒再釀衝突 悍將4：2再勝龍隊", "summary": "經過昨晚因近身球引發的激情一戰，富邦悍將隊、味全龍隊今天繼續在台北大巨蛋交手，前3局又出現3顆觸身球，所幸沒再造成衝突。悍將隊長范國宸雙手擋下可能形成的衝突後，製造悍將3分大局的機會，加上瑪帝斯6局好投壓制龍隊，終場悍將以4：2收下二連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312602.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 21:40", "link": "/news/story/7001/9744885"}, {"article_id": "9744873", "title": "U18亞青／胡辰睿敲出場內轟 期待對決日本織田翔希", "summary": "U18亞洲青棒錦標賽中華隊開路先鋒胡辰睿展現快腿，今天敲出3分打點的場內全壘打，幫助球隊挺進複賽，胡辰睿希望有機會遇到日...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312570.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-09 21:34", "link": "/news/story/7001/9744873"}, {"article_id": "9744870", "title": "韓職／亞運前最後登板 王彥程6局失1分優質先發奪本季第11勝", "summary": "效力於韓職韓華鷹隊的台灣左投王彥程，今天迎接亞運前最後一場例行賽先發，在主場迎戰LG雙子隊，投出6局失1分的優質先發，「愛彥程打線」也用超狂火力相挺，包括在8局下海灌12分，終場以19：3打下勝利，王彥程拿下本季第11勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312567.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 21:28", "link": "/news/story/7001/9744870"}, {"article_id": "9744844", "title": "排球／登峰造極邁入第五屆 勁旅上海格致中學女排來台交流", "summary": "2026登峰造極青年排球邀請賽今年邁入第五屆，今天起至14日在台北體育館一樓登場，除了台灣傳統勁旅，更邀請深圳龍崗布吉中學男排和上海格致中學女排來台，期望透過校際交流，增加選手比賽經驗，培養出優秀選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312491.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-09 21:04", "link": "/news/story/7005/9744844"}, {"article_id": "9744828", "title": "U18亞青／中華隊大勝新加坡晉級 複賽首戰交給吳杰叡", "summary": "中華隊在U18亞洲青棒錦標賽預賽最終戰以16比1大勝新加坡隊，取得晉級複賽門票，總教練楊孝承透露，對菲律賓隊預定吳杰叡先...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312485.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-09 20:59", "link": "/news/story/7001/9744828"}, {"article_id": "9744809", "title": "日職／孫易磊後援1局無失分飆156公里 火腿1分差不敵軟銀", "summary": "日職火腿隊今天在福岡巨蛋客場出戰軟銀隊，8局下2分落後的局面，推出21歲台灣投手孫易磊登板，後援1局無失分，最快球速飆到156公里，但終場火腿仍以4：5不敵軟銀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312426.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 20:31", "link": "/news/story/7001/9744809"}, {"article_id": "9744796", "title": "日職／林安可單場2支二壘打棒打九里亞蓮 西武8：0完封歐力士", "summary": "日職西武隊今天前進神戶於客場對上歐力士隊，林安可擔任先發第5棒、指定打擊，連兩打席敲二壘打，有1打點、2得分，在球隊大幅領先的局面下，打完3打席提前退場休息，終場西武也以8：0完封歐力士。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312417.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 20:22", "link": "/news/story/7001/9744796"}, {"article_id": "9744716", "title": "台大校園化身5.3KM賽道 翁滋蔓相約全民12月土木盃開跑", "summary": "「2026第五屆台大土木盃校園之美路跑」將於12月5日將在國立台灣大學登場，預計號召3000名跑者齊聚校園，本活動不限台大師生及校友，全國民眾皆可報名參加，邀請大家用腳步探索台大，感受結合校園景觀、團隊合作與特色美食的路跑體驗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312364.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=851&exp=3600&sl=W&fw=360", "date": "2026-09-09 19:56", "link": "/news/story/7005/9744716"}, {"article_id": "9744689", "title": "亞運／郭婞淳、陳念琴、唐嘉鴻領軍突破 啟程旗下好手出戰名古屋", "summary": "2026愛知名古屋亞洲運動會於9月正式登場，啟程國際運動行銷旗下選手將代表中華隊出戰舉重、拳擊、體操、田徑及籃球等項目，包含郭婞淳、陳念琴、唐嘉鴻、簡子傑、謝元愷、陳盈駿、陳冠全、林庭謙、雷蒙恩與彭詩晴等人。面對亞洲最高層級的競技舞台，啟程此次以「突破（Breakthrough）」為核心溝通主題，從選手各自的運動歷程出發，記錄他們在賽場內外持續挑戰自我的過程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312323.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 19:40", "link": "/news/story/124981/9744689"}, {"article_id": "9744674", "title": "U18亞青／胡辰睿扛開路先鋒 首次入選中華隊拚速度", "summary": "胡辰睿生涯第1次穿上中華隊球衣就是在今年U18亞洲青棒錦標賽，並扛起開路先鋒的重責大任，小時候從滑輪溜冰起家的他要展現速...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312316.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 19:30", "link": "/news/story/7001/9744674"}, {"article_id": "9744652", "title": "排球／男排亞錦賽中華隊惜敗泰國 第7種子闖8強", "summary": "在日本舉行的亞洲男子排球錦標賽，中華隊今天分組最終戰面對泰國隊，可惜在手握聽牌優勢情況下，終場以2比3遭到逆轉，確定以第...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312302.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 19:23", "link": "/news/story/7005/9744652"}, {"article_id": "9744618", "title": "U18亞青／日本左投前田侑大亮相 複賽再提升火球威力", "summary": "U18亞洲青棒錦標賽日本隊火球左投前田侑大今天亮相，球速還沒拉到招牌的150公里以上，日本總教練岡田龍生希望他在複賽能將...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312303.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 18:51", "link": "/news/story/7001/9744618"}, {"article_id": "9744492", "title": "中職／吉力吉撈認動手推戴培峰「比較不好」 葉總笑看比賽有火花", "summary": "味全龍隊吉力吉撈・鞏冠昨天對上富邦悍將隊，9局下因一顆近身球動怒，引爆雙方板凳清空，吉力吉撈・鞏冠今天賽前現身簡短說明，為出手推了戴培峰「感到比較不好一點」；龍隊總教練葉君璋則笑說：「棒球比賽就是這樣，有些火花很正常。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309066.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 17:52", "link": "/news/story/7001/9744492"}, {"article_id": "9744403", "title": "U18亞青／複賽有望對中華隊 菲律賓教頭盼打出拉鋸戰", "summary": "菲律賓隊在U18亞洲青棒錦標賽預賽取得2勝1敗，晉級複賽後有望對上台灣隊，總教練奧里拉納希望球員將心態武裝起來，「打出一...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311989.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 17:43", "link": "/news/story/7001/9744403"}, {"article_id": "9744304", "title": "TPBL／連四年交流 雲豹赴熊本打友誼賽", "summary": "桃園台啤永豐雲豹隊將於明天啟程前往日本熊本市，與日本B.LEAGUE ONE聯盟勁旅熊本Volters進行「2026台日友好城市交流賽」，這是雙方連續第4年交流，總經理顏行書說：「每年的季前交流賽，是磨練球員與新賽季磨合的黃金機會，更是深化桃園與熊本兩座城市情誼的友誼盛會，期盼為兩地球迷帶來充滿文化火花的交流賽。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311716.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 16:34", "link": "/news/story/7003/9744304"}, {"article_id": "9744232", "title": "NFL／2026新賽季開幕戰！超級盃對決再現NFL Game Pass就在DAZN", "summary": "2026 NFL美式足球新賽季正式點燃戰火！全球領先運動娛樂串流平台 DAZN 陪伴全球球迷迎接全新賽季，台灣時間9月10日上午8點20分，開幕戰直接上演上季超級盃對決，由衛冕冠軍西雅圖海鷹坐鎮主場迎戰新英格蘭愛國者。歷經近七個月等待，新賽季從第一戰就火力全開，海鷹踏上衛冕之路，愛國者則帶著復仇氣勢捲土重來。從例行賽、國際賽、季後賽一路到第61屆超級盃（Super Bowl LXI），球迷都能透過DAZN上的NFL Game Pass掌握精彩戰況，不只鎖定話題大戰，更要一路追完整個賽季，成為真正的NFL鐵粉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311629.png&M=1&s=Y&x=114&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-09 16:12", "link": "/news/story/7005/9744232"}, {"article_id": "9744163", "title": "美網／五盤惡鬥打到凌晨3點半創紀錄 地主好手粉碎阿爾卡拉斯連霸夢", "summary": "同是23歲的美國「地主希望」謝爾頓（Ben Shelton）和尋求衛冕的西班牙「小蠻牛」阿爾卡拉斯（Carlos Alcaraz）今天上演精彩的五盤大戰，列第8種子的謝爾頓克服決勝盤最後的「超級搶10」壓力，在4小時又28分鐘激戰中以6：7（5：7）、6：1、6：3、1：6、7：6（10：7）力退衛冕者，奪下4度交手的對戰首勝，生涯第二度打進美網4強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311538.jpg&M=1&s=Y&x=0&y=14&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 15:51", "link": "/news/story/121623/9744163"}, {"article_id": "9744154", "title": "MLB／史庫柏繳轉戰後道奇最長先發 西語老師：很像山本由伸", "summary": "道奇隊塞揚左投史庫柏（Tarik Skubal）漸入佳境，今天主投7.1局只失2分，幫助道奇以3：2擊敗紅人隊。史庫柏的表現讓「西語老師」赫南德茲（Teoscar Hernández）想起山本由伸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311506.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-09 15:49", "link": "/news/story/6999/9744154"}, {"article_id": "9744108", "title": "路跑／接力賽改為10K、半馬 亞瑟士路跑賽明年宜蘭開跑", "summary": "運動品牌ASICS秉持「Sound Mind, Sound Body」的品牌精神，長期持續鼓勵大眾透過運動感受身心正向改變，更將理念延伸至年度跑步盛事「ASICS RUN」，2027年的賽事將於明年2月21日在宜蘭運動公園登場，明天中午12點起開放報名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35311436.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-09 15:31", "link": "/news/story/7005/9744108"}, {"article_id": "9744098", "title": "中職／龍隊回應吉力吉撈不當行為 「造成不良示範謹此致歉」", "summary": "味全龍隊指定打擊吉力吉撈．鞏冠昨天因頭部近身球爆衝突，出手推了富邦悍將隊捕手戴培峰，不但遭到驅逐出場，今天也被聯盟罰款2萬元、禁賽1場，龍隊今天聲明：「球團尊重聯盟依相關規章所作之裁決，並將配合執行。針對昨日比賽中的不當行為及所造成的不良示範，謹此致歉。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309062.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-09 15:28", "link": "/news/story/7001/9744098"}, {"article_id": "9744014", "title":