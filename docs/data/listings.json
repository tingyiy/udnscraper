to.php?u=https://uc.udn.com.tw/photo/t3/2026/10/13/35417351.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9812765"}]}, {"name": "最新文章", "articles": [{"article_id": "9822613", "title": "2026全球極限體能鋼鐵大賽圓滿落幕 近十萬人次共襄盛舉國際菁英齊聚台中", "summary": "2026全球極限體能鋼鐵大賽於台中落幕，吸引近十萬人次、逾10國近3,000名選手參與，俄羅斯隊奪菁英冠軍，台灣隊獲第7名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432412.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:30", "link": "/news/story/7005/9822613"}, {"article_id": "9822602", "title": "運動部長李洋證件「被變更」 表達不滿缺席亞帕運開幕式", "summary": "愛知名古屋亞洲帕拉運動會今晚舉行開幕式，運動部長李洋卻沒有出現在貴賓席。運動部今天聲明表示，因為部長的識別證臨時被變更，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432409.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:16", "link": "/news/story/7005/9822602"}, {"article_id": "9822586", "title": "中職／從沒想過總冠軍賽開轟當英雄 曾聖安緊張到手腳都抽筋", "summary": "味全龍隊20歲外野手曾聖安生涯首次在總冠軍賽亮相，今天在第2戰先發上陣，緊張到全身抽筋，但寫下戲劇性的劇本，失誤後下個打席敲出超前3分砲，轟破隊史最年輕紀錄，也打下他生涯最印象深刻的一轟。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432388.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:03", "link": "/news/story/7001/9822586"}, {"article_id": "9822580", "title": "中職／賽後解析「頂級投手論」 平野惠一眼中有兩種類型", "summary": "中信兄弟隊今天以1：3不敵味全龍隊，前兩戰在洋投對決中都敗下陣來，兄弟教頭平野惠一賽後接受15分鐘聯訪，也分析了自己心中的「頂級投手論」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432384.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 21:00", "link": "/news/story/7001/9822580"}, {"article_id": "9822572", "title": "TPVL／漢佳單場獨攬14分領軍 天鷹直落三奪賽季首勝", "summary": "漢佳轟下全場最高14分並發出2記ACE，率台鋼天鷹主場28:26、25:13、25:23直落三擊敗臺北伊斯特，收下賽季首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432383.jpg&M=1&s=Y&x=0&y=0&sw=912&sh=608&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:58", "link": "/news/story/7005/9822572"}, {"article_id": "9822559", "title": "中職／兄弟2戰只拿1分、雙箭頭16支0 平野曝面對頂級洋投難處", "summary": "中信兄弟隊打完台灣大賽前兩戰陷入0勝2敗，合計只拿1分，談到打線熄火，總教練平野惠一吐露面對頂級投手的難處，「希望大家可以理解，對方不是隨便就會失分的投手。」雙箭頭張仁瑋、張士綸前兩戰合計16支0，平野盼他們透過這兩場的學習，更了解自己的任務。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432368.jpg&M=1&s=Y&x=0&y=0&sw=1224&sh=816&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:47", "link": "/news/story/7001/9822559"}, {"article_id": "9822558", "title": "中職／菲力士從隊友變成敵人 梅賽鍶奪勝後擔心他的強襲球腿傷", "summary": "味全龍隊洋投梅賽鍶今天先發6局失1分，優質表現奪下生涯總冠軍賽首勝，幫助龍隊以3：1擊敗中信兄弟隊，他說：「感覺很棒，雖有失分但壓制在1分，隊友打擊很好，後面打得回來，自己和捕手蔣少宏搭配好，順利拿下勝投。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432351.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:44", "link": "/news/story/7001/9822558"}, {"article_id": "9822552", "title": "中職／賽前給曾聖安信心「搞不好你會全壘打」 葉總讚子弟兵長大了", "summary": "味全龍隊在總冠軍賽首戰贏球後，今天第二戰考量對戰數據後大膽變陣，讓20歲外野手曾聖安扛先發第9棒，儘管5局守備失誤「繳學費」，卻在下半局敲致勝3分砲成致勝英雄，賽後葉君璋雖稱讚他「長大了」，但也要大家「不要太舒服他」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432342.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:36", "link": "/news/story/7001/9822552"}, {"article_id": "9822535", "title": "中職／「連俊秀這種老將也會發生miss」平野惠一提出反思", "summary": "中信兄弟隊在總冠軍賽第二戰握有短暫的1：0領先，下半局就見失守，陳俊秀的失誤，最終釀成失分，遭曾聖安的三分砲逆轉戰局，總教練平野惠一坦言，在短期比賽裡，碰到雙方都是頂級投手的比賽，一個miss就會顯得很關鍵，今天這場比賽就驗證了這件事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432307.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:27", "link": "/news/story/7001/9822535"}, {"article_id": "9822515", "title": "TPBL／送狀元賀丹職業首敗 馬建豪：歡迎來到TPBL", "summary": "TPBL衛冕軍福爾摩沙夢想家，開季兩場比賽都打得驚天動地，昨天開季首戰和新北國王激戰到延長賽吞敗，今天碰高雄全家海神從最多20分落後到1分逆轉，驚險以115：114守護主場，也讓海神今年的選秀會「狀元」賀丹錯過職業賽首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432281.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 20:15", "link": "/news/story/7003/9822515"}, {"article_id": "9822440", "title": "中職／怎麼又一樣？兄弟連兩年爭冠前2戰合計1分 龍隊主場先搶2連勝", "summary": "味全龍隊啟用20歲小將曾聖安扛先發，成為神調度，今天在台灣大賽第二戰敲出逆轉三分砲，上演三倍誠意的道歉野球，龍隊終場以3：1擊敗中信兄弟隊，在系列賽握有2勝0敗優勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432231.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 19:37", "link": "/news/story/7001/9822440"}, {"article_id": "9822437", "title": "TPBL／20分落後戲劇性逆轉！衛冕軍夢想家1分氣走海神", "summary": "上季奪下TPBL總冠軍的福爾摩沙夢想家，今天開季第二場比賽展現韌性，面對高雄全家海神克服最多20分落後，在「小跑車」林俊吉替補轟下23分，包括最後7.2秒的致勝球領軍下，戲劇性以115：114守護主場勝利和新賽季首勝，也收下對戰跨季6轟勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432225.jpg&M=1&s=Y&x=22&y=0&sw=1242&sh=792&exp=3600&sl=W&fw=360", "date": "2026-10-18 19:33", "link": "/news/story/7003/9822437"}, {"article_id": "9822427", "title": "亞帕運／劉雅婷、劉瑋旂開幕典禮掌旗 中華代表團71位選手拚佳績", "summary": "2026年第5屆愛知名古屋亞洲帕拉運動會開幕典禮今天晚間6時於日本名古屋市瑞穗公園田徑場隆重舉行，我國代表團由總領隊何維華率領選手、教練及團本部人員共計25人參與開幕典禮，依大會進場順序，以英文字母「T」序位在敘利亞之後、塔吉克之前，於第36順位進場，正式揭開本屆賽會序幕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432203.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 19:22", "link": "/news/story/7005/9822427"}, {"article_id": "9822420", "title": "中職／差432人滿場！龍隊兩戰近8萬人相挺 G3換兄弟接棒做主", "summary": "中華職棒總冠軍賽今天進行第二戰，票房開出3萬9568人，未能連續兩場締造滿場，第三、四戰將由中信兄弟隊接棒擔任主場球隊，象迷從外野進攻內野。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432193.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 19:17", "link": "/news/story/7001/9822420"}, {"article_id": "9822404", "title": "高球／亞巡澳門公開賽王偉軒奪冠 哽咽盼媽媽在天上看見", "summary": "亞巡賽澳門高爾夫公開賽，台灣男子職業好手王偉軒今天在最終回合和韓國名將任成宰戰至延長賽，靠著再見博蒂抱回冠軍盃。賽後，他...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432186.jpg&M=1&s=Y&x=0&y=0&sw=884&sh=589&exp=3600&sl=W&fw=360", "date": "2026-10-18 19:08", "link": "/news/story/7005/9822404"}, {"article_id": "9822395", "title": "中職／兄弟戰情再拉警報 菲力士腿部挨強襲球4.2局傷退", "summary": "中信兄弟隊在總冠軍賽情勢不利，第二戰先發投手菲力士投不滿5局，因強襲球打到左小腿傷退，此役先發4.2局失3分，兄弟處於1：3落後。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432154.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 18:45", "link": "/news/story/7001/9822395"}, {"article_id": "9822393", "title": "中職／曾聖安總冠軍賽初登場轟超前3分砲 隊史最年輕、史上排第二", "summary": "味全龍隊20歲外野手曾聖安生涯首次在總冠軍賽亮相，今天在G2先發上陣，儘管在5局上發生守備失誤，但下半局馬上戴罪立功，轟出右外野方向的超前3分砲，替龍隊打下3：1領先，寫下味全龍隊史總冠軍最年輕開轟紀錄，也是中職史上第2年輕開轟打者。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432146.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 18:43", "link": "/news/story/7001/9822393"}, {"article_id": "9822388", "title": "中職／總冠軍賽前兩戰人氣旺 龍隊票房加商品至少進帳1.5億元", "summary": "中職總冠軍賽今天繼續在台北大巨蛋進行第2戰，再度吸引大批球迷進場觀戰，全力爭取連兩場爆滿紀錄，味全龍隊擔任主隊這兩場比賽，票房收入加上商品販售數字，保守估計超過1億5千萬元，大巨蛋人氣十足。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432115.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 18:38", "link": "/news/story/7001/9822388"}, {"article_id": "9822372", "title": "中職／奪還分數！去年打16局才得分 兄弟今年打到第14局破蛋", "summary": "中信兄弟隊久違的分數，終於到手了！今天在第五局敲出2安打，加上味全龍隊右外野手曾聖安的失誤，為兄弟開啟攻勢，台灣打賽打到第14局首度拿到分數。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/18/35432084.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-18 18:27", "link": "/news/story/7001/9822372"}, {"article_id": "9822354", "title": "MLB／大谷翔平去年東京開幕戰球衣206.5萬美元落槌 創個人戰袍拍賣紀錄", "summary": "洛杉磯道奇隊日本球星大谷翔平去年在東京巨蛋開幕戰所穿的球衣，17日以驚人的價格205萬5700美元（約新台幣6547萬元...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=h