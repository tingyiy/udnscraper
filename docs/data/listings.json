: "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35126418.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/122629/9621575"}, {"article_id": "9621515", "title": "世足攻略／梅西率衛冕軍抗十字軍鐵桶 體能與空間戰成阿根廷晉級鑰匙", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/11/35126275.jpg&M=1&s=Y&x=78&y=5&sw=1117&sh=745&exp=3600&w=300", "link": "/news/story/122629/9621515"}, {"article_id": "9620592", "title": "煮茶論戰／法放棄逼搶改單挑突破 徹底瓦解摩洛哥防線", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35124917.jpg&M=1&s=Y&x=20&y=175&sw=1017&sh=678&exp=3600&w=300", "link": "/news/story/122629/9620592"}, {"article_id": "9619901", "title": "世足攻略／傳控鬥牛士慎防紅魔反擊 西班牙攻防優勢應能低比分勝出", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35123781.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9619901"}, {"article_id": "9618995", "title": "離開我你會不會好一點 「喬治定律」成球隊重建或重組新解方", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/10/35122232.jpg&M=1&x=&y=&sw=&sh=&exp=3600&w=300", "link": "/news/story/122629/9618995"}, {"article_id": "9617902", "title": "中職／是該與時俱進了！盡快擬定「旅外、混血外籍球員」加盟條款", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/09/35120867.jpg&M=1&s=Y&x=0&y=38&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9617902"}]}, {"name": "最新文章", "articles": [{"article_id": "9622737", "title": "世足賽／西班牙前總理一句「法國隊沒有法國人」惹議 4強大戰前引爆種族歧視風波", "summary": "2026美加墨世界盃進入最終4強階段，西班牙即將與法國爭奪決賽門票，不過賽前卻因西班牙前總理拉荷義（Mariano Rajoy）一篇評論文章掀起爭議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127938.jpg&M=1&s=Y&x=16&y=0&sw=1258&sh=838&exp=3600&sl=W&fw=360", "date": "2026-07-12 13:50", "link": "/news/story/123107/9622737"}, {"article_id": "9622714", "title": "世足賽／挪威驚奇之旅止步8強 哈蘭德感性說：人生改變了", "summary": "挪威「進球機器」哈蘭德（Erling Haaland）今天被英格蘭限制，延長賽時被教練換下場，國際賽連續進球數告終，挪威1：2落敗後驚奇之旅停在8強，不過哈蘭德仍說：「這是很瘋狂的旅程。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127902.jpg&M=1&s=Y&x=0&y=0&sw=1254&sh=836&exp=3600&sl=W&fw=360", "date": "2026-07-12 13:30", "link": "/news/story/123107/9622714"}, {"article_id": "9622681", "title": "日職／台灣重砲發威！ 林安可連兩打席開轟、2天敲3轟", "summary": "台灣重砲發威！效力於西武獅隊的台灣外野手林安可，今天在北海道Es Con Field對上火腿隊，首打席轟出2分砲，4局上第二打席再敲一發右外野陽春全壘打，連兩打席開轟，演出日職生涯首次單場雙響砲，且2天已轟出3發全壘打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/05/12/34937736.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-12 13:12", "link": "/news/story/7001/9622681"}, {"article_id": "9622663", "title": "NBA／學長面子交給學弟來討！ 布萊恩率馬刺夏季聯賽痛宰尼克", "summary": "馬刺在上季總冠軍賽5戰不敵尼克，過程中屢屢慘遭逆轉，這份輸球的遺憾在夏季聯賽稍微得到紓解。馬刺在二年級生布萊恩（Carter Bryant）攻下全場最高19分的帶領下，最終以70：49大勝尼克，總算收下本屆夏季聯賽首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127837.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-12 13:00", "link": "/news/story/7002/9622663"}, {"article_id": "9622646", "title": "NBA／崔蘭特4年6400萬美元續留公鹿 從底薪翻身拿下保障長約", "summary": "根據報導，崔蘭特（Gary Trent Jr.）與公鹿達成4年6400萬美元續約協議，這份合約將會是全額保障，且雙方都沒有球員或球隊選項。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127802.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 12:37", "link": "/news/story/7002/9622646"}, {"article_id": "9622633", "title": "世足賽／慶祝晉級摔斷手沒關係 英格蘭老將包著石膏仍參與熱身", "summary": "英格蘭今天在世界盃8強靠著「竹北之光」貝林漢（Jude Bellingham）梅開二度，以2：1擊敗挪威。而16強因慶祝晉級導致骨折的36歲老將韓德森（Jordan Henderson）也在賽前包上石膏與隊友一起熱身，但會不會上場本人則是賣關子回應「到時候就知道了」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127784.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 12:28", "link": "/news/story/123107/9622633"}, {"article_id": "9622631", "title": "日職／林安可連續兩天開轟！ 首打席就敲2分砲", "summary": "西武獅隊台灣外野手林安可連兩天開跑！昨天對上火腿隊暌違77天開轟，今天繼續先發西武先發第5棒、左外野手，首打席再掃出右外野方向的2分全壘打，日職生涯首次連續兩天炸裂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/04/25/34889649.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-12 12:26", "link": "/news/story/7001/9622631"}, {"article_id": "9622548", "title": "世足賽／延長賽不敵英格蘭 挪威廉航願賭服輸換社群大頭照", "summary": "挪威今天雖在世界盃足球賽8強吞敗，但廉價航空挪威穿梭航空卻因願賭服輸，意外圈粉全球網友", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127714.jpg&M=1&s=Y&x=0&y=2&sw=804&sh=536&exp=3600&sl=W&fw=360", "date": "2026-07-12 12:02", "link": "/news/story/123107/9622548"}, {"article_id": "9622595", "title": "MLB／連山本由伸都被咬 響尾蛇兩戰讓道奇狂噴18分", "summary": "連山本由伸都失守，道奇隊連續兩天遭到響尾蛇隊震撼教育，今天在他先發6局任內失血6分，牛棚也持續遭到攻陷，道奇終場以2：9不敵響尾蛇，系列賽前兩戰已失18分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127715.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 12:00", "link": "/news/story/6999/9622595"}, {"article_id": "9622577", "title": "世足賽／4強賽程出爐！法國西班牙新中生代巨星對決 衛冕軍阿根廷強碰「三獅軍團」", "summary": "2026世界盃8強賽事今天落幕，在衛冕軍阿根廷3：1在延長賽擊敗瑞士後，4強隊伍全數出爐，法國與西班牙上演傳統強權對決，阿根廷則對上英格蘭，力求超過60年無人達成的連霸壯舉。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127706.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 11:53", "link": "/news/story/123107/9622577"}, {"article_id": "9622572", "title": "世足賽／阿根廷延長賽3比1淘汰瑞士闖4強 梅西沒進球神紀錄中斷", "summary": "衛冕軍阿根廷今天8強壓軸戰登場，開賽第10分鐘就靠麥克阿列斯特（Alexis Mac Allister）頭錘破網，但瑞士下半場扳平戰局，雙方激戰到延長賽，阿根廷靠阿爾瓦雷斯（Julián Álvarez）第112分鐘遠射破門，補時階段馬丁尼茲（Lautaro Martínez）再補刀，聯手以3：1淘汰瑞士，下戰將和英格蘭爭決賽門票。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127759.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 11:49", "link": "/news/story/123107/9622572"}, {"article_id": "9622514", "title": "MiLB／張弘稜高A投6局挨轟失1分 優質先發無關勝敗", "summary": "旅美匹茲堡海盜隊24歲投手張弘稜今天在高階1A出賽，投出本季單場最長局數6局，唯一失分是被敲陽春砲、為優質先發，海盜延長...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127608.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-12 11:27", "link": "/news/story/6999/9622514"}, {"article_id": "9599483", "title": "NBA／2026年自由市場開跑 球員交易簽約動態懶人包", "summary": "看似沒有太多大咖球星恢復自由身的一年，卻在7月1日自由市場正式開啟前，早早引爆各種引人入勝的重大交易案和簽約事件，包括「字母哥」安戴托昆波（Giannis Antetokounmpo）轉戰熱火、「球三」小鮑爾（LaMelo Ball）西進明尼蘇達等。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/01/35092819.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 11:20", "link": "/news/story/7002/9599483"}, {"article_id": "9622508", "title": "MLB／釀酒人火球男手臂疲勞 明與史肯斯的「強投對決」喊卡", "summary": "大聯盟明星賽前哨戰，原本明天有望上演釀酒人隊火球男米蕭洛斯基（Jacob Misiorowski）與海盜王牌史肯斯（Paul Skenes）的強投對決，但米蕭洛斯基如今因手臂疲勞，跳過這次先發，也將缺席明星賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127602.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 11:19", "link": "/news/story/6999/9622508"}, {"article_id": "9622489", "title": "世足賽／英格蘭逆轉挪威 FIFA稱貝林漢進球有效", "summary": "國際足球總會（FIFA）今天表示，沒有證據顯示英格蘭在世界盃8強戰以2比1逆轉擊敗挪威時，追平比分的進球應因球碰到場地上...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127582.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 11:14", "link": "/news/story/123107/9622489"}, {"article_id": "9622490", "title": "NBA／新球隊新開始！莫蘭特轉戰拓荒者後首次公開心聲：希望擺脫壞蛋形象", "summary": "明星後衛莫蘭特（Ja Morant）休賽季離開灰熊轉戰拓荒者後始終保持安靜，今天終於公開說出心路歷程，除了感謝波特蘭給予重新開始的機會，也希望新球季能擺脫大家對他「壞蛋」形象的誤解。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127565.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 11:02", "link": "/news/story/7002/9622490"}, {"article_id": "9622460", "title": "世足賽／挪威進球被取消 老哈蘭德酸裁判「幹得好」", "summary": "美加墨世界盃出現不少爭議判決，今天英格蘭和挪威的8強賽，挪威第2顆進球經VAR檢視後取消，讓挪威當家球星哈蘭德（Erling Haaland）的爸爸老哈蘭德（Alfie Haaland）十分不滿，透過社群發文寫下「貝林漢和裁判幹得好」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127535.jpg&M=1&s=Y&x=18&y=0&sw=1262&sh=841&exp=3600&sl=W&fw=360", "date": "2026-07-12 10:44", "link": "/news/story/123107/9622460"}, {"article_id": "9622452", "title": "MLB／初次造訪芝加哥就愛上 UCLA游擊手喬洛斯基成白襪選秀狀元", "summary": "2026年MLB選秀狀元開獎，白襪隊隊史第3次握有狀元籤，今天選進來自UCLA的21歲明星游擊手喬洛斯基（Roch Cholowsky），雙方預計將簽下一份破紀錄的合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127506.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 10:42", "link": "/news/story/6999/9622452"}, {"article_id": "9622444", "title": "世足賽／不滿爭議判決皆有利英格蘭 老哈蘭德開砲：今晚贏的是裁判", "summary": "挪威在2026美加墨世界盃8強賽的延長賽以1：2不敵英格蘭，黑馬之旅止步8強。不過，這場比賽賽後焦點並不只在英格蘭晉級4強，裁判與VAR判決也成了討論重點。哈蘭德（Erling Haaland）的父親、前挪威國腳老哈蘭德（Alf-Inge Haaland）賽後公開把矛頭指向FIFA裁判團隊，直言：「今天，贏球的是裁判。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127484.jpg&M=1&s=Y&x=0&y=0&sw=1259&sh=839&exp=3600&sl=W&fw=360", "date": "2026-07-12 10:40", "link": "/news/story/123107/9622444"}, {"article_id": "9622404", "title": "MLB／道奇25歲新星入選明星賽直言「超興奮」 山本由伸連兩年無緣參賽", "summary": "大聯盟今天宣布道奇25歲左投羅布勒斯基（Justin Wrobleski）將遞補紅人榜眼伯恩斯（Chase Burns），進入全明星賽，不過本季保持超強宰制力的山本由伸卻無法出賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127443.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 10:21", "link": "/news/story/6999/9622404"}, {"article_id": "9622388", "title": "世足賽／23歲貝林漢成英格蘭救世主！瘋狂個人秀直逼比利神紀錄", "summary": "2026美加墨世界盃8強賽，英格蘭靠著靠著明星中場貝林漢（Jude Bellingham）個人獨進兩球，在延長賽以2：1逆轉擊敗挪威，寫下「三獅軍團」隊史第4度闖進世界盃4強大門。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127404.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 10:12", "link": "/news/story/123107/9622388"}, {"article_id": "9622364", "title": "世足賽／連14場正式國際賽進球紀錄中斷 哈蘭德遺憾止步8強", "summary": "2026年美加墨世界盃8強賽，挪威當家射手哈蘭德（Erling Haaland）在面對英格蘭一役遭到嚴密看管，全場未能破門，遺憾中止連14場正式的國際賽進球紀錄。最終挪威在延長賽後以1：2不敵英格蘭，無緣挺進4強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127367.jpg&M=1&s=Y&x=0&y=53&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-12 10:02", "link": "/news/story/123107/9622364"}, {"article_id": "9622333", "title": "MLB／拒當備胎的備胎 費城人惠勒拒絕遞補明星賽：大聯盟先不尊重我", "summary": "收到明星賽遞補通知，費城人隊投手惠勒（Zack Wheeler）顯然一點都不開心，無意當備胎的備胎，今天發言抨擊大聯盟官方：「因為他們不尊重我，所以我不打算參加那玩意（that thing）。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127322.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-12 09:48", "link": "/news/story/6999/9622333"}, {"article_id": "9622298", "title": "世足賽／阿根廷10歲童紀念日脫稿挺梅西 影片瘋傳教頭也感動", "summary": "2026年世界盃8強賽阿根廷今天迎戰瑞士，一名10歲男童9日在阿根廷獨立紀念日校園典禮上脫稿高喊「阿根廷代表隊加油！梅西...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127301.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-12 09:38", "link": "/news/story/123107/9622298"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9622572", "title": "世足賽／阿根廷延長賽3比1淘汰瑞士闖4強 梅西沒進球神紀錄中斷", "date": "2026-07-12 11:49", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127759.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9622572"}, {"article_id": "9622577", "title": "世足賽／4強賽程出爐！法國西班牙新中生代巨星對決 衛冕軍阿根廷強碰「三獅軍團」", "date": "2026-07-12 11:53", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/12/35127706.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9622577"}, {"article_id": "9622237", "title": "世足賽／貝林漢梅開二度、哈蘭德沒進球 英格蘭2：1