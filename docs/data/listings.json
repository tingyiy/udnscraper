nail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/22/35542668.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9894880"}]}, {"name": "最新文章", "articles": [{"article_id": "9899928", "title": "MLB／佐藤輝明6年1.2億美元加盟小熊 日本野手史上首張破億大約", "summary": "日職阪神虎隊27歲強打佐藤輝明透過入札制度挑戰大聯盟，落腳處揭曉，大聯盟官網記者費恩森（Mark Feinsand）稍早披露，他以6年1.2億美元（約新台幣37.8億元）的合約加盟小熊隊，合約也寫下日本野手最高紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_7.jpg", "date": "2026-11-25 00:09", "link": "/news/story/6999/9899928"}, {"article_id": "9899639", "title": "HBL／青奧國手成板凳殺手 永平新賽制首戰驚奇扳倒永仁", "summary": "115學年度HBL男子組16強預賽落幕後，女子組12強預賽今天在高雄鳳山體育館接力登場，首日賽程就出現驚奇，上季第6名的永平高中「下剋上」以75：68擊敗上季奪後季軍的永仁高中，青奧3對3國手馮佳萍從板凳出發攻下全場最高的27分，成永平致勝功臣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549949.jpg&M=1&s=Y&x=1&y=22&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 22:14", "link": "/news/story/7003/9899639"}, {"article_id": "9899539", "title": "羽球／中央機關盃登場 陳義信為原民會加油、李洋首日未出賽", "summary": "115年中央機關盃羽球、匹克球大賽今天持續在國立台灣大學綜合體育館進行，羽球賽事正式登場，展開第二日賽程。本屆羽球賽共有男子團體35隊、女子團體9隊及混合團體22隊報名，選手們陸續展開分組對戰，競爭熱烈。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549811.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 20:31", "link": "/news/story/7005/9899539"}, {"article_id": "9899471", "title": "UBA／謝旻耕成面具俠回歸 宇宙政大連4戰破百寫新猷", "summary": "115學年度富邦人壽UBA大專籃球聯賽男一級預賽第一階段，尋求7連霸的衛冕軍政大，今天碰台師大11人得分、5人達兩位數，點點開花下以119：86輕取臺師大，開季四連勝，且連四場破百，再寫「宇宙政大」另一新猷，超越112學年度及上季都是開季連三場破百。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549759.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-24 20:02", "link": "/news/story/7003/9899471"}, {"article_id": "9899448", "title": "UBA／健行菜鳥狂轟7記三分彈 破百轟垮中原", "summary": "115學年度富邦人壽UBA大專籃球聯賽男一級預賽第一階段，22日對臺科艱辛收下第二勝的健行科大，休兵一日沉澱後，今天逢上季第11中原大學，健行在菜鳥余玄胤個人秀帶動下，首節即轟40分、開季最高，最終108：64大勝，贏44分開季最多，本季首破百。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549741.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 19:57", "link": "/news/story/7003/9899448"}, {"article_id": "9899401", "title": "羽球／BWF年終總決賽名單公布 賽事改制後周天成第7度參賽", "summary": "BWF年終總決賽將於12月9日在中國杭州登場，今天公布各組參賽名單，台灣包括男單周天成、女雙許尹鏸/林芝昀、混雙葉宏蔚/...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/04/35485843.jpg&M=1&s=Y&x=0&y=0&sw=1258&sh=838&exp=3600&sl=W&fw=360", "date": "2026-11-24 19:26", "link": "/news/story/7003/9899401"}, {"article_id": "9899312", "title": "2026第八屆ISUZU運轉職人挑戰賽首度前進雲林 集結各路好手挑戰最高殿堂", "summary": "2026第八屆ISUZU運轉職人挑戰賽首度移師雲林，於11月22日舉行，簡克孝奪單人冠軍，簡原谷、劉柏希獲雙人組冠軍，總獎金36萬元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549508.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 18:27", "link": "/news/story/7005/9899312"}, {"article_id": "9899258", "title": "菲律賓聖多瑪斯大學向台灣桌球取經 包辦亞太天主教大學運動會團體雙金", "summary": "菲律賓聖多瑪斯大學桌球隊擊敗輔仁大學男團，以3比2奪冠，並在女團封王，包辦亞太天主教大學運動會團體雙金，教練感謝台灣交流。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549407.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 18:02", "link": "/news/story/7005/9899258"}, {"article_id": "9899216", "title": "NBA／波傑姆斯基考慮披波蘭戰袍 父親曝遲未決定原因：擔心俄烏戰爭", "summary": "擁有波蘭血統的勇士戰將波傑姆斯基（Brandin Podziemski），至今仍認真考慮未來披上波蘭國家隊戰袍，但根據他的父親透露，俄羅斯與烏克蘭之間持續的戰爭，讓家人對前往波蘭的安全問題有所顧慮，也成為他遲遲未做出最終決定的重要原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549355.jpg&M=1&s=Y&x=105&y=53&sw=1148&sh=800&exp=3600&sl=W&fw=360", "date": "2026-11-24 17:43", "link": "/news/story/7002/9899216"}, {"article_id": "9899209", "title": "中職／2027年賽程對戰組合與時程出爐！龍隊、悍將開幕周就過招", "summary": "中華職棒聯盟公布2027年一軍例行賽日程及對戰組合，新球季將在3月27日開打，總冠軍味全龍隊開幕周兩場比賽分別挑選中信兄弟、富邦悍將隊當對手，兄弟主場開幕戰則與台鋼雄鷹隊過招。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549496.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 17:37", "link": "/news/story/7001/9899209"}, {"article_id": "9899143", "title": "NBA／沒跟風「GTA6」熱潮 約柯奇：我只用手機玩英雄聯盟", "summary": "等待13年終於上市的《俠盜獵車手6（GTA6）》，引發全球玩家熱潮，不過對於3屆年度MVP約柯奇（Nikola Jokic）來說，顯然沒有讓他產生太大興趣。日前接受採訪時，約柯奇坦言自己確實有玩遊戲的習慣，但不是《俠盜獵車手6（GTA6）》。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549253.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 17:11", "link": "/news/story/7002/9899143"}, {"article_id": "9899141", "title": "NBA／史上最懸殊「西強東弱」？西區對東區67.7%勝率恐破紀錄", "summary": "東區龍頭76人隊本季首度與西區球隊交手，面對拓荒者隊以111：128慘遭痛宰，引發外界對「西強東弱」的關注。本季西區對東區勝率高達67.7%，若維持下去將創歷史新高。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549247.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 17:06", "link": "/news/story/7002/9899141"}, {"article_id": "9899127", "title": "TPBL／海神洋將回巴西出戰世界盃 盼將經驗帶回台", "summary": "高雄全家海神職業籃球隊外援加爾文，上週面對福爾摩沙夢想家繳出TPBL生涯新高27分、16籃板、3抄截、2助攻，效率值31的全能數據，今天獲選聯盟單週外援MVP。人在巴西備戰FIBA世界盃美洲區資格賽的他感謝上帝，並歸功隊友的協助，才能守住這場關鍵勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549227.jpg&M=1&s=Y&x=0&y=271&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 16:56", "link": "/news/story/7003/9899127"}, {"article_id": "9899029", "title": "中職／方郁淮滑球似李欣穎般有威力 精進變化球拚一軍", "summary": "中職台鋼雄鷹隊投手方郁淮今年季末膝蓋舊傷影響出賽，在與捷克交流賽復出後援無失分。投手教練蕭任汶稱讚方郁淮滑球跟李欣穎一樣...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549168.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 16:45", "link": "/news/story/7001/9899029"}, {"article_id": "9899063", "title": "NBA／灰狼愛德華膝傷復原進度緩慢 回歸時間恐等到明年1月", "summary": "灰狼本季持續等待當家球星愛德華（Anthony Edwards）傷癒歸隊，但這位明星後衛的膝蓋傷勢可能比預期更加棘手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549118.jpg&M=1&s=Y&x=40&y=27&sw=1240&sh=826&exp=3600&sl=W&fw=360", "date": "2026-11-24 16:36", "link": "/news/story/7002/9899063"}, {"article_id": "9898955", "title": "荷蘭冬奧金牌「超辣女神」紐約街頭真空上陣大秀身材！", "summary": "荷蘭競速滑冰女將萊爾丹奪得米蘭冬奧女子1000公尺金牌，未婚夫保羅贈價值約台幣1250萬元賓利；她赴紐約度假分享時尚美照，吸引粉絲關注。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35548952.jpg&M=1&s=Y&x=0&y=432&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-24 16:30", "link": "/news/story/7005/9898955"}, {"article_id": "9899035", "title": "NBA／和灰狼分手沒怨懟 藍道談前東家：獲得很多樂趣", "summary": "今年夏天從灰狼隊被交易到籃網隊的藍道（Julius Randle），今天首度回到明尼蘇達面對前隊友，儘管最終以116：142慘敗，他仍獲得昔日球場球迷起立鼓掌，成為另一段屬於灰狼的璀璨回憶。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549146.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 16:22", "link": "/news/story/7002/9899035"}, {"article_id": "9898977", "title": "NBA／「雕像換頭」熱火順起來！韋德：大家不用謝我", "summary": "熱火隊開季表現不佳，但自從更新傳奇球星韋德（Dwyane Wade）的雕像後，豪取8勝2敗佳績。韋德在節目上表示，「大家不用謝我！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35548965.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 16:06", "link": "/news/story/7002/9898977"}, {"article_id": "9898956", "title": "NBA／少溫班亞瑪仍退國王 夏帕尼：得找出他不在場也贏球的方法", "summary": "馬刺隊今天作客國王隊主場，開賽前90分鐘才確定溫班亞瑪（Victor Wembanyama）與福克斯（De'Aaron Fox）雙雙免戰，加上哈波（Dylan Harper）因臀部拉傷缺陣，最終仍以123：107擊退國王，客場8戰全勝並與湖人隊並列西區龍頭。不過比起勝負，賽後焦點落在少了主戰力，夏帕尼（Julian Champagnie）與總教練強森（Mitch Johnson）如何看待球隊的應變與化學效應。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35549017.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 16:00", "link": "/news/story/7002/9898956"}, {"article_id": "9898861", "title": "日職／年薪維持4.5億日圓、背號改成81號 山川穗高：通常是監督穿的", "summary": "軟銀鷹隊35歲重砲山川穗高今天完成合約談判，年薪維持4億5000萬日圓（約新台幣9291萬元）、還有激勵獎金。山川穗高透露背號將從「5號」改成「81號」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35548753.jpg&M=1&s=Y&x=294&y=124&sw=768&sh=512&exp=3600&sl=W&fw=360", "date": "2026-11-24 15:27", "link": "/news/story/7001/9898861"}, {"article_id": "9898853", "title": "TPBL／38歲桑尼又回來了加盟雲豹 顏行書盼攜手打造強悍領袖文化", "summary": "桃園台啤永豐雲豹隊今天宣布簽下38歲巴勒斯坦籍全能前鋒桑尼（Sani Sakakini），補強球隊禁區戰力，總經理顏行書表示，桑尼在台灣的實力與表現備受肯定，更是極具名望的領袖型洋將，期待他強悍的心理素質與球風能為球隊文化帶來正向助益。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35548734.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 15:19", "link": "/news/story/7003/9898853"}, {"article_id": "9898828", "title": "中職／「推人怎麼了？」蔣少宏挺兄弟發言惹議 致歉聲明標示AI內容", "summary": "吉力吉撈．鞏冠因近身球出手推戴培峰，事件距今已過77天，味全龍隊捕手蔣少宏在自家付費會員限定節目中表態挺兄弟，回應「推人怎麼了？我還沒有幹人，他又沒有拿棒子打人」，爭議發言讓事件再度升溫。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35309062.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-24 15:08", "link": "/news/story/7001/9898828"}, {"article_id": "9898759", "title": "NBA／11天7戰無懼疲勞！公牛痛打騎士 板凳群暴砍63分寫紀錄", "summary": "前一晚才與金塊激戰至延長賽，最終遺憾吞敗，芝加哥公牛隔天又得馬不停蹄迎戰另一支強敵騎士。然而，密集賽程並未拖垮公牛的進攻火力，反而激發替補球員的強大能量，板凳軍團全場狂轟63分，其中上半場就攻下48分，創下隊史新紀錄，幫助公牛以122比108擊敗騎士，成功從前一晚的延長賽失利中反彈。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35548589.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-24 14:47", "link": "/news/story/7002/9898759"}, {"article_id": "9898744", "title": "NBA／少3大主力客場仍8戰全勝 卡瑟爾準大三元領馬刺退國王", "summary": "馬刺隊今天作客國王隊主場，儘管包括溫班亞瑪（Victor Wembanyama）、福克斯（De’Aaron Fox）與哈波（Dylan Harper）在內多名主力缺陣，但靠著卡瑟爾（Stephon Castle）繳出28分、11助攻、8籃板的準大三元全能演出，加上團隊在第二、三節聯手拉開比分，最終仍以123：107輕取國王，開季客場維持8戰全勝不敗金身。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/24/35548550.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=