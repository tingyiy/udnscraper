k": "/news/story/122629/9644006"}, {"article_id": "9644261", "title": "中職／高中軟式組應屆生職棒第一人 金門洪嘉恩想挑戰極限", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/22/35160360.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9644261"}]}, {"name": "最新文章", "articles": [{"article_id": "9652240", "title": "中國羽賽／相隔6年再奪千分大賽冠軍 周天成：學習走出低潮", "summary": "台灣「羽球一哥」周天成，今天在BWF超級1000的中國羽球公開賽，以2比1扳倒法國波波夫，相隔6年再奪千分大賽金盃；他表...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172318.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 21:54", "link": "/news/story/7005/9652240"}, {"article_id": "9652177", "title": "中職／江坤宇致勝二壘打 兄弟終止洲際主場對獅跨季7連敗", "summary": "中信兄弟避免在台中洲際主場續寫連敗紀錄，今天在洋投羅戈5局無失分的帶領之下，全場5任投手合力完封統一獅隊，並在4局下由江坤宇二壘打敲回巨大的1分，終場兄弟以1：0勝出，逃過系列賽被橫掃，終止在洲際對戰獅隊跨季7連敗、本季主場對獅6連敗（洲際、大巨蛋）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172182.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-26 20:25", "link": "/news/story/7001/9652177"}, {"article_id": "9652171", "title": "籃球／勇士近年成績「不理想」 林志傑當副領隊盼改變", "summary": "今年高掛球鞋的「野獸」林志傑，今天現身啤酒品牌3對3賽事的表演賽，和「少俠」田壘重現經典的「俠獸對決」；剛退役的林志傑體態、身手和過去沒太大變化，他透露樂於嘗試各種運動，接續也將回到台北富邦勇士，希望傳承經驗，讓球隊提早「武裝」，追求更好成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172175.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 20:23", "link": "/news/story/7003/9652171"}, {"article_id": "9652155", "title": "籃球／新竹城市盃3對3 在地品牌組隊奪冠", "summary": "「風城耀動、城市3耀」新竹城市盃3對3籃球賽，今天進行決賽最終日，牧德科技組成的「MV WARRIORS」以16：15險勝瑞昱半導體，收下企業男子組冠軍，公開男子組則由新竹在地品牌奪冠。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172152.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 20:07", "link": "/news/story/7003/9652155"}, {"article_id": "9652102", "title": "中職／威克打3場敲2轟 卻說「不覺得台北大巨蛋特別好轟」", "summary": "樂天桃猿隊洋砲威克打出「魔鷹級」砲火，今天的兩分砲直接撼動勝負，幫助猿隊以2：0擊敗富邦悍將隊，儘管在台北大巨蛋打3場就已敲出2轟，威克賽後謙稱，沒有覺得台北大巨蛋特別好打全壘打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172107.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 19:32", "link": "/news/story/7001/9652102"}, {"article_id": "9652099", "title": "籃球／俠獸對決再現！林志傑致勝上籃吃掉田壘", "summary": "今年結束23年職業球員生涯的「野獸」林志傑，退休後再回球場就是和「少俠」田壘重現經典的「俠獸對決」，兩人在《Tiger Street 超熱派對》傳奇表演賽正面交鋒，三對三中林志傑先飆進追平三分球再「一打一」吃掉田壘，完成致勝切入，讓台北松山文創園區的球迷們歡聲雷動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172101.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 19:19", "link": "/news/story/7003/9652099"}, {"article_id": "9652088", "title": "中職／威克是我大哥！林子崴相隔5年奪MVP 盼「只是一個開始」", "summary": "樂天桃猿隊雙「ㄨㄟ」發威，先發投手林子崴6局無失分，加上洋砲威克兩分砲，以2：0完封富邦悍將隊。看到威克這一轟，已完成6局投球任務收工在換衣服的林子崴，馬上衝出來，賽後也直呼被他救到，「他是我大哥！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172081.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-26 19:12", "link": "/news/story/7001/9652088"}, {"article_id": "9652086", "title": "中職／魔鷹暴力轟、累積67轟超越布雷 陳文杰致勝安助台鋼逆轉味全", "summary": "台鋼雄鷹王牌先發黃子鵬今天出戰味全龍隊，雖沒能再推進自己寫下的連續局數無失分紀錄，仍繳出6局失1分的好投，製造球隊在比賽後段翻盤的機會；雄鷹打線在8局下靠曾子祐、陳文杰連續二壘打攻進3分逆轉戰局，終場以4：2擊敗味全龍隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172139.jpg&M=1&s=Y&x=0&y=41&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 19:11", "link": "/news/story/7001/9652086"}, {"article_id": "9652067", "title": "SIDIZ攜手DAZN、樂天桃猿再登台北大巨蛋「坐 你的人生」主題日登場", "summary": "7月26日，SIDIZ攜手DAZN與樂天桃猿在台北大巨蛋舉辦「SIDIZ 坐 你的人生」主題日，邀請樂天女孩參與三天見面會，並有機會抽中人體工學椅。活動強調舒適坐姿的重要性，並由韓國FURSYS執行長親臨分享品牌理念。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172058.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-26 18:54", "link": "/news/story/7001/9652067"}, {"article_id": "9652063", "title": "日職／西武排3洋砲連線但打線大熄火遭軟銀完封 林安可4支0吞2K", "summary": "效力於西武獅隊的台灣外野手林安可，近期連4場比賽先發上陣，今天面對軟銀隊系列賽第3戰擔任第3棒、指定打擊，4打數沒有敲出安打、吞2K，西武打線全場僅敲3安，終場以0：3不敵全場敲4安的軟銀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/04/21/34877141.jpg&M=1&s=Y&x=0&y=229&sw=1265&sh=843&exp=3600&sl=W&fw=360", "date": "2026-07-26 18:44", "link": "/news/story/7001/9652063"}, {"article_id": "9652053", "title": "中職／「ㄨㄟ」助桃猿！林子崴6局好投、威克兩分砲 賞悍將完封敗", "summary": "樂天桃猿隊「開箱」洋砲中大獎，威克第六局敲兩分砲，狙擊富邦悍將隊洋投威戈神，這一棒為猿隊打下2：0勝利，力挺本季首度先發的林子崴拿下勝投。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 18:28", "link": "/news/story/7001/9652053"}, {"article_id": "9652041", "title": "中國羽賽／1000等級大賽三局拍下法好手 周天成男單奪冠創史上最長紀錄", "summary": "我國羽球「一哥」周天成生涯首度打進中國公開賽決賽，今天和法國世界排名16的大波波夫（Toma Junior Popov）對決，小天首局從最多6分落後逆轉，最終在三局大戰以21：15、7：21、21：13迎接本季第一座冠軍，也是生涯第二座超級1000等級大賽金盃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172166.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-26 18:15", "link": "/news/story/7005/9652041"}, {"article_id": "9652019", "title": "NBA／25歲馬克西成就詹姆斯第5冠？ ESPN點名可複製騎士厄文模式", "summary": "詹姆斯（LeBron James）決定加盟費城76人後，外界焦點除了這支豪華陣容能否爭奪總冠軍，也開始關注25歲明星後衛馬克西（Tyrese Maxey）將如何與這名41歲傳奇球星搭配。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171971.jpg&M=1&s=Y&x=14&y=0&sw=1120&sh=747&exp=3600&sl=W&fw=360", "date": "2026-07-26 18:03", "link": "/news/story/7002/9652019"}, {"article_id": "9651958", "title": "MLB／10年累積日美100勝 山本由伸自曝「被打爆的比賽更留在記憶裡」", "summary": "道奇日籍王牌山本由伸先發面對紐約大都會，繳出6局失1分的優質先發內容，幫助道奇以4：3擊敗大都會，收下4連勝。山本由伸也拿下本季第11勝，完成日職、美職通算100勝里程碑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171890.jpg&M=1&s=Y&x=0&y=8&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 17:04", "link": "/news/story/6999/9651958"}, {"article_id": "9651941", "title": "NBA／讚76人帳面天賦媲美「宇宙勇」 表弟卡森斯點出「幸福的煩惱」", "summary": "隨著詹姆斯（LeBron James）確定加盟，費城76人一躍而成奪冠大熱門。前明星中鋒「表弟」卡森斯（DeMarcus Cousins）在節目分析時便直言，補進底薪詹姆斯後的76人，已經擁有全聯盟最強陣容，天賦媲美當年「宇宙勇」，具備推翻王者尼克的本錢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171885.jpg&M=1&s=Y&x=0&y=0&sw=1195&sh=797&exp=3600&sl=W&fw=360", "date": "2026-07-26 16:49", "link": "/news/story/7002/9651941"}, {"article_id": "9651918", "title": "MLB／史上第21人！山本由伸日美通算100勝 大谷翔平還差11勝", "summary": "道奇日籍強投山本由伸今天再次展現壓制力，如願取得本季第11勝，同時正式達成日職、美職合計100勝里程碑。山本由伸過去效力日職歐力士猛牛期間拿下70勝，挑戰大聯盟後再添30勝，成為日本棒球史上第21位達成日美通算100勝的投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171834.jpg&M=1&s=Y&x=234&y=5&sw=788&sh=525&exp=3600&sl=W&fw=360", "date": "2026-07-26 16:32", "link": "/news/story/6999/9651918"}, {"article_id": "9651898", "title": "中職／林家勝肩盂唇破裂歷經458天重返一軍 新名字連隊友都還在習慣", "summary": "林旺熙去年經歷肩盂唇破裂傷勢，再回歸一軍已經變成「林家勝」，不少人看到名字以為是哪位新人投手，直到看到臉才發現就是他，經歷458天重返一軍戰場，林家勝也說：「終於回來了！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171800.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-26 16:00", "link": "/news/story/7001/9651898"}, {"article_id": "9651878", "title": "NBA／轉戰冠軍尼克卻錯過詹皇 前76人中鋒自我「打氣」：對新球隊很滿意了", "summary": "「小皇帝」詹姆斯（LeBron James）近期決定前往76人震撼聯盟，而休賽季離開費城與尼克簽約的明星中鋒佐蒙德（Andre Drummond）似乎對無法聯手這位巨星感到遺憾，在個人社群發出貼文為自己的決定「打氣」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171775.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 15:40", "link": "/news/story/7002/9651878"}, {"article_id": "9651872", "title": "中職／去年已聽過悍將版生日快樂歌 壽星光總：不知道在唱什麼", "summary": "富邦悍將隊總教練後藤光尊明天將度過48歲生日，今天先在台北大巨蛋接受來自選手的道賀，他在去年就曾於二軍感受選手五音不全版生日快樂歌，笑說：「不知道在唱什麼。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171762.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 15:31", "link": "/news/story/7001/9651872"}, {"article_id": "9651863", "title": "中職／董子恩連2天一壘、三壘都失誤 光總歸咎自己讓他變來變去", "summary": "富邦悍將隊董子恩連兩天在角落內野發生失誤，總教練後藤光尊對此沒有苛責，「可能是我讓他們守備位置改變太多了。」他說兼具多守位的同時，也可能讓他在訓練時無法專注在當天的守備位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171749.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-26 15:23", "link": "/news/story/7001/9651863"}, {"article_id": "9651854", "title": "MLB／7.65億美元巨星倒下！索托左小腿2級拉傷 最糟可能提前報銷", "summary": "紐約大都會外野手索托（Juan Soto）台因左小腿2級拉傷，被放進10天傷兵名單。大都會代理總教練格林（Andy Green）透露，這次傷勢可能比他先前缺陣約3週的情況更嚴重，至於本季能否再回到球場，他並未給出明確答案，也讓這名超級球星的賽季前景蒙上陰影。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171733.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-26 15:11", "link": "/news/story/6999/9651854"}, {"article_id": "9651845", "title": "MLB／用怪力轟打破交易傳聞！洋基捕手夯430英呎陽春砲創生涯最遠紀錄", "summary": "洋基捕手威爾斯（Austin Wells）近期打擊狀況低迷又陷入交易傳聞，不過他今天在面對費城人的比賽中，用一發生涯最遠距離的430英呎（約130公尺）超大號全壘打，告訴條紋軍「想賣我再想想」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171725.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 15:00", "link": "/news/story/6999/9651845"}, {"article_id": "9651829", "title": "NBA／岳父說可以！阿德巴約徵取求婚意見成功 情緒潰堤衝廁所痛哭", "summary": "熱火球星阿德巴約（Bam Adebayo）傳來喜訊，美媒《ESPN》報導，這位今年3月砍下聯盟史上第二高83分的大個，近期向4屆WNBA年度MVP的女友威爾森（A'ja Wilson）父親羅斯柯（Roscoe Wilson Jr.）徵取求婚同意成功外，還獲得許多寶貴建議，讓他情緒激動，一問完問題就衝向洗手間痛哭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171675.jpg&M=1&s=Y&x=0&y=35&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-26 14:37", "link": "/news/story/7002/9651829"}, {"article_id": "9651751", "title": "中職／看何品室融二軍登板也嚇一跳 曾豪駒：有疑慮且是重點栽培選手", "summary": "樂天桃猿隊外野手何品室融昨天在二軍賽事登板，總教練曾豪駒看了也嚇一跳，要再向二軍教練團、球探部門了解一下，也直言野手登板、且又是球隊重點栽培選手，還是必須盡量避免。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35171586.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-26 13:24", "link": "/news/story/7001/9651751"}]}, {"name": "棒球", "articles": [{"article_id": "9652053", "title": "中職／「ㄨㄟ」助桃猿！林子崴6局好投、威克兩分砲 賞悍將完封敗", "date": "2026-07-26 18:28", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172023.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9652053"}, {"article_id": "9652177", "title": "中職／江坤宇致勝二壘打 兄弟終止洲際主場對獅跨季7連敗", "date": "2026-07-26 20:25", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172182.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/7001/9652177"}, {"article_id": "9652086", "title": "中職／魔鷹暴力轟、累積67轟超越布雷 陳文杰致勝安助台鋼逆轉味全", "date": "2026-07-26 19:11", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172139.jpg&M=1&s=Y&x=0&y=41&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9652086"}, {"article_id": "9652102", "title": "中職／威克打3場敲2轟 卻說「不覺得台北大巨蛋特別好轟」", "date": "2026-07-26 19:32", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172107.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9652102"}, {"article_id": "9652088", "title": "中職／威克是我大哥！林子崴相隔5年奪MVP 盼「只是一個開始」", "date": "2026-07-26 19:12", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35172081.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9652088"}]}, {"name": "MLB", "articles": [{"article_id": "9651230", "title": "MLB／「台灣怪力男」再炸第6轟 李灝宇先敲追平安再揮超前陽春彈", "date": "2026-07-26 02:47", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/26/35