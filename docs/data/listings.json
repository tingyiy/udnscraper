hoto/t3/2026/08/02/35193184.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 20:08", "link": "/news/story/7001/9666287"}, {"article_id": "9666291", "title": "擊劍／亞洲青少年盃台北站 地主小將斬獲1金3銀1銅", "summary": "「2026亞洲青少年盃擊劍巡迴賽－臺北站（2026 Asian Cadet Cup Taipei）」今天臺北體育館4樓技擊館圓滿落幕，最終日進行青少年男子軍刀及青少年女子鈍劍兩項賽事，地主男子軍刀好手梁崇義一路挺進冠軍戰，最終勇奪銀牌，為地主隊再添一面獎牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193176.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 20:03", "link": "/news/story/7005/9666291"}, {"article_id": "9666232", "title": "心元盃匹克球賽台大體育館登場 逾5百選手參賽", "summary": "2026第2屆心元盃匹克球公開賽，今天在台大綜合體育館登場，祭出總獎金新台幣10萬元誘因下，吸引超過500名選手參賽，致...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193175.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 20:02", "link": "/news/story/7005/9666232"}, {"article_id": "9666280", "title": "中職／洋投羅戈對戰龍數據出色 稱曲球是生涯重要球種", "summary": "中信兄弟洋投羅戈今天7局無失分，率隊以7比0勝味全龍，本季對戰防禦率0.47、表現出色。總教練平野惠一稱讚曲球投得好，羅...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193169.jpg&M=1&s=Y&x=0&y=23&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 19:50", "link": "/news/story/7001/9666280"}, {"article_id": "9666284", "title": "佛光盃籃賽／台師大女子組封后 佛光逆轉奪季軍", "summary": "2026佛光盃國際大學籃球邀請賽今天落幕，唯一闖進冠軍戰的本土代表台灣師大，在女子組冠軍戰靠著上半場所奠定超過20分領先優勢，68：50擊敗日本東北學院大學，自2013年後再次捧起佛光盃冠軍；壓軸男子組冠軍戰，馬來西亞激戰美國維斯蒙特學院，維斯蒙特再次拉尾盤，在最後1節甩開馬來西亞，74：57後來居上，抱走今年佛光盃男籃冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193168.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-02 19:42", "link": "/news/story/7003/9666284"}, {"article_id": "9666276", "title": "MLB／史庫柏忍淚告別老虎 轉戰道奇心情複雜：我很興奮但也很難受", "summary": "薩特健康球場特殊的地理位置，意外成為史庫柏（Tarik Skubal）與底特律老虎告別的第一個線索。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193164.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 19:41", "link": "/news/story/6999/9666276"}, {"article_id": "9666264", "title": "日職／林安可又有2安、1打點 對歐力士3連戰貢獻5安", "summary": "旅日好手林安可今天又有好表現，對歐力士隊之戰4打數2安打，攻下1分打點，幫助西武5：1獲勝，主場3連戰搶下兩勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193148.jpg&M=1&s=Y&x=44&y=0&sw=1115&sh=743&exp=3600&sl=W&fw=360", "date": "2026-08-02 19:14", "link": "/news/story/7001/9666264"}, {"article_id": "9666228", "title": "NBA／史上首位「五金行」老闆！37歲杜蘭特仍盼出征洛杉磯奧運", "summary": "休士頓火箭球星杜蘭特（Kevin Durant）並未關上再次披上美國男籃戰袍的大門，他近日表示，自己仍希望能入選2028年洛杉磯奧運美國隊名單，若最終成行並幫助美國隊再次登頂，他將成為奧運男籃史上首位拿下5面金牌的球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193108.jpg&M=1&s=Y&x=8&y=0&sw=1272&sh=848&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:54", "link": "/news/story/7002/9666228"}, {"article_id": "9666208", "title": "MLB／賺翻？道奇3農場新秀換塞揚史庫柏 韓媒：交易代價不算重", "summary": "洛杉磯道奇再度在交易市場投下震撼彈，根據大聯盟官網報導，道奇已從底特律老虎換來左投王牌史庫柏（Tarik Skubal），這名連續2年拿下美聯塞揚獎的強投，將加入道奇原本就星光熠熠的先發輪值，協助球隊挑戰世界大賽3連霸。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193051.jpg&M=1&s=Y&x=0&y=3&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:23", "link": "/news/story/6999/9666208"}, {"article_id": "9666210", "title": "中職／羅戈先發7局無失分 兄弟終於中斷對戰龍隊9連敗", "summary": "中信兄弟隊今天在台北大巨蛋再戰味全龍隊，洋投羅戈先發7局無失分，打線火力全開，首局就以5支安打攻下4分奠定勝基，終場以7：0獲勝，中斷對戰龍隊9連勝，也終止大巨蛋4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193053.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:23", "link": "/news/story/7001/9666210"}, {"article_id": "9666205", "title": "中職／蔡其昌致賀周玲妏當選 期待棒協加強改革力道", "summary": "中華棒球協會第14屆理事長選舉結果出爐，中信育樂公司副總經理周玲妏成為棒協首位女領導人，中華職棒會長蔡其昌表示，恭喜周玲妏當選棒協理事長，也感謝前理事長辜仲諒多年來對台灣棒球發展的投入與奉獻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193046.jpg&M=1&s=Y&x=53&y=33&sw=1178&sh=785&exp=3600&sl=W&fw=360", "date": "2026-08-02 18:13", "link": "/news/story/7001/9666205"}, {"article_id": "9666174", "title": "棒球／郭智輝落選棒協理事長 經濟部前部長吐露心聲", "summary": "中華棒球協會第14屆理事長選舉結果出爐，經濟部前部長、科技企業家郭智輝無緣獲選，今天發表聲明「坦然接受，也虛心檢討」，強調職務可以不同，初心始終不變。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192996.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:41", "link": "/news/story/7001/9666174"}, {"article_id": "9666165", "title": "棒球／辜仲諒獲聘棒協名譽理事長 未來目標爭取WBSC會長", "summary": "中華棒球協會新任理事長出爐，中信育樂公司副總經理周玲妏成為棒協首位女領導人，原任理事長辜仲諒完成8年任務，獲聘成為名譽理事長，未來目標將爭取世界棒壘球總會（WBSC）會長。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193017.jpg&M=1&s=Y&x=0&y=207&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:32", "link": "/news/story/7001/9666165"}, {"article_id": "9666160", "title": "MLB／貧窮才限制想像！道奇搶史庫柏組夢幻輪值 豪華稅猛飆1.8億美元", "summary": "洛杉磯道奇在交易截止日前再度展現「霸道總裁級」補強大法，重磅網羅底特律老虎王牌左投史庫柏（Tarik Skubal）後，原本已經星光熠熠的先發輪值再添一名連霸塞揚強投。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192982.jpg&M=1&s=Y&x=0&y=12&sw=1069&sh=713&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:31", "link": "/news/story/6999/9666160"}, {"article_id": "9666161", "title": "棒球／首位女性棒協理事長誕生 周玲妏綽號「周董」個性直率、坦言頭還在暈", "summary": "中華民國棒球協會今天改選，中信育樂公司副總經理周玲妏當選第14屆棒協理事長，今年58歲的她成為史上首位女性棒協理事長。人稱「周董」的周玲妏個性直率、豪爽，也是民進黨立委邱議瑩的好姐妹，過去擔任高雄市政府觀光局長時很會找資源，頗受高雄市長陳其邁重用。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192978.jpg&M=1&s=Y&x=0&y=0&sw=885&sh=590&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:27", "link": "/news/story/7001/9666161"}, {"article_id": "9666158", "title": "台北羽賽／165公分沖本優大首度參賽就奪冠 日本包3冠成最大贏家", "summary": "身高僅165公分的日本好手沖本優大，首度參加台北羽球公開賽就一路奪冠，且是昨天瓦解我國「一哥」周天成兩個賽末點逆轉勝，今天面對從會外賽晉級的韓國黑馬俞泰彬再以21：19、21：12奪勝，迎接生涯第二座BWF超級300冠軍，也是今天第三組登頂的日本選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192954.jpg&M=1&s=Y&x=0&y=112&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 17:22", "link": "/news/story/7005/9666158"}, {"article_id": "9666091", "title": "TPBL／唐維傑續約海神 勤明慶轉任體能教練", "summary": "高雄全家海神職業籃球隊今天宣布兩項人事異動及球員續約消息，助理教練朱永弘新賽季將接下助理教練兼顧問，禁區悍將勤明慶轉任體能教練，「港都之子」唐維傑也與球隊完成續約，復健調整不間斷，以自身堅毅精神實踐永不放棄信念，為重返高雄巨蛋努力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192861.jpg&M=1&s=Y&x=1&y=58&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-02 16:21", "link": "/news/story/7003/9666091"}, {"article_id": "9666088", "title": "棒球／周玲妏成為棒協首位女領導人 誓言打造棒球人之家", "summary": "中華棒球協會第14屆理事長選舉結果出爐，中信育樂公司副總經理周玲妏成為棒協首位女領導人，她在當選後也發表感言，強調將會「傳承基石開新局，打造棒球人之家」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192856.jpg&M=1&s=Y&x=0&y=497&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-08-02 16:16", "link": "/news/story/7001/9666088"}, {"article_id": "9666002", "title": "NBA／冠軍成員被送走 雷霆主戰前鋒：就像少了家庭成員", "summary": "雷霆隊尋求衛冕失利後陣容異動，包括多特（Luguentz Dort）、維金斯（Aaron Wiggins）和喬伊（Isaiah Joe）都離隊，當家中鋒霍姆葛倫（Chet Holmgren）今天形容，這些成員的離隊就像是少了家庭成員一樣難受。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192739.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-02 15:45", "link": "/news/story/7002/9666002"}, {"article_id": "9666049", "title": "東引軍事越野障礙賽登場 跑者穿越坑道據點挑戰國境之北", "summary": "一年一度的東引軍事越野障礙賽登場，來自全國各地及海外的越野跑好手齊聚國境之北，從東引忠誠門前出發，挑戰結合戰地文化、軍事設施及自然景觀的特色賽道。連江縣長王忠銘表示，盼透過賽事串聯觀光、文化與運動，讓更多人認識東引獨特的戰地風貌及島嶼景觀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192779.jpg&M=1&s=Y&x=0&y=428&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 15:38", "link": "/news/story/7005/9666049"}, {"article_id": "9666032", "title": "棒球／周玲妏當選棒協理事長 經濟部前部長郭智輝無緣出線", "summary": "中華棒球協會第14屆理事長選舉結果出爐，中信育樂公司副總經理周玲妏確定當選，成為棒協首位女領導人，最近動作積極的經濟部前部長、科技企業家郭智輝無緣獲選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192790.jpg&M=1&s=Y&x=0&y=85&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-02 15:24", "link": "/news/story/7001/9666032"}, {"article_id": "9666021", "title": "Run For Dad爸趣迷你馬拉松 任賢齊、九孔亮相星味十足", "summary": "約900名親子今到彰化縣高鐵二號公園，參加田中馬系列活動-爸趣迷你馬拉松的3公里路跑，田中子弟歌手任賢齊帶父母，藝人「九孔」和家人現身，和民眾一起挑戰HYROX和趣味競賽，藍、綠縣長參選人到場一起做暖身操，讓人看見藝人親民的一面，也感受2026選舉到來的較勁氣氛。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192755.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=851&exp=3600&sl=W&fw=360", "date": "2026-08-02 15:12", "link": "/news/story/7005/9666021"}]}, {"name": "棒球", "articles": [{"article_id": "9666032", "title": "棒球／周玲妏當選棒協理事長 經濟部前部長郭智輝無緣出線", "date": "2026-08-02 15:24", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192790.jpg&M=1&s=Y&x=0&y=85&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9666032"}, {"article_id": "9666264", "title": "日職／林安可又有2安、1打點 對歐力士3連戰貢獻5安", "date": "2026-08-02 19:14", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193148.jpg&M=1&s=Y&x=44&y=0&sw=1115&sh=743&exp=3600&w=300", "link": "/news/story/7001/9666264"}, {"article_id": "9666210", "title": "中職／羅戈先發7局無失分 兄弟終於中斷對戰龍隊9連敗", "date": "2026-08-02 18:23", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35193053.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9666210"}, {"article_id": "9666016", "title": "中職／江坤宇連5場安打本季最長 張政禹、曾子祐相爭金手套有看頭", "date": "2026-08-02 15:06", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192738.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/7001/9666016"}, {"article_id": "9666327", "title": "日職／張峻瑋優質先發飆速156公里 奪二軍本季第5勝", "date": "2026-08-02 20:58", "thumbnail": "https://pgw.udn.com.tw/gw/phot