53"}, {"article_id": "9667721", "title": "史庫柏交易看似離譜 實則是豪門與小市場球隊現實差距", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35195501.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9667721"}, {"article_id": "9668273", "title": "綠衫軍想掀交易大浪？勇士FA市場零補強又浪費柯瑞一季", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35196090.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9668273"}, {"article_id": "9665984", "title": "中職／江坤宇挑戰游擊金手套7連霸 先跨過張政禹這一關", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192909.jpg&M=1&s=Y&x=32&y=0&sw=1226&sh=817&exp=3600&w=300", "link": "/news/story/122629/9665984"}, {"article_id": "9666138", "title": "慘到被移出先發輪值 從日職挑戰大聯盟今井達也困境是什麼？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192948.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9666138"}, {"article_id": "9666157", "title": "日職／扳倒世仇決定成敗 巨人大躍進、火腿大失速", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/02/35192985.jpg&M=1&s=Y&x=0&y=194&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9666157"}]}, {"name": "最新文章", "articles": [{"article_id": "9671485", "title": "MLB／洋基游擊新希望？隆巴德初登場就開轟助隊完封紅雀", "summary": "洋基隊農場頭號大物隆巴德（George Lombard Jr.）生涯初登場，成為全場球迷焦點，歡呼聲響徹整座洋基球場，隆巴德沒讓球迷失望，不只上演美技守備，還擊出生涯首轟，幫助洋基終場以2：0完封紅雀隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200561.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 10:00", "link": "/news/story/6999/9671485"}, {"article_id": "9671497", "title": "MLB／費爾柴德再遭水手DFA 莊陳仲敖通過讓渡程序續留運動家3A", "summary": "30歲台美混血外野手「費仔」費爾柴德（Stuart Fairchild）上個月轉戰水手隊，本月2日被叫上大聯盟，但僅待了3天、代跑出賽1場，今天再次遭到DFA（指定讓渡），日前遭到運動家隊DFA的25歲台灣投手莊陳仲敖則是續留3A。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200572.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-05 09:54", "link": "/news/story/6999/9671497"}, {"article_id": "9671442", "title": "NBA／球員工會打造洛城訓練大本營 助球員擺脫尋場、奔波困擾", "summary": "每年休賽季，眾多NBA頂尖球星都選擇在洛杉磯展開開季前訓，但過去繁重的交通轉乘與分散各地的球場、重訓室，總讓各路好手勞心勞力，為了解決這項長期困擾，球員工會（NBPA）在今天宣布，將於洛杉磯正式啟用打造的全新訓練中心「PLYRS UNTD」，為聯盟球星提供一站式的頂級訓練環境。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200503.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 09:32", "link": "/news/story/7002/9671442"}, {"article_id": "9671335", "title": "網球／手腕傷勢未癒 阿爾卡拉斯退出辛辛那提大師賽", "summary": "主辦單位今天表示，男網世界排名第2的阿爾卡拉斯（Carlos Alcaraz）自4月起因手腕受傷缺賽各大賽事，他為了養傷也...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200490.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-05 09:26", "link": "/news/story/7005/9671335"}, {"article_id": "9671311", "title": "棒球／美國小馬聯盟世界青棒錦標賽 中華隊奪亞軍", "summary": "美國小馬聯盟（PONY）帕馬級世界青棒錦標賽決賽昨天在德州拉雷多（Laredo）登場，代表亞太區赴美參賽的桃園市青棒代表...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200433.jpg&M=1&s=Y&x=49&y=178&sw=1172&sh=782&exp=3600&sl=W&fw=360", "date": "2026-08-05 09:12", "link": "/news/story/7001/9671311"}, {"article_id": "9671398", "title": "嘉義羽球賽事斷層體育用品店老闆掏腰包辦比賽　為基層選手找回舞台", "summary": "嘉義縣市近年地方羽球賽事減少，讓基層選手與羽球愛好者苦無舞台展現實力，也少了與各路好手切磋交流的機會。為了不讓在地羽球熱情就此降溫，嘉義在地體育用品店「嘉友體育」決定挺身而出，自掏腰包舉辦「2026第一屆嘉友體育－波力盃羽球賽」，希望點燃羽球風氣，賽事22日在嘉縣中埔鄉嘉得羽球館熱血開打。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200410.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-05 09:04", "link": "/news/story/7005/9671398"}, {"article_id": "9671375", "title": "NBA／要唐西奇付撫養費 前未婚妻撤回申請", "summary": "湖人隊當家球星唐西奇（Luka Doncic）和前未婚妻戈爾特斯（Anamaria Goltes）為爭取兩名女兒監護權不惜要對鋪公堂，不過原定8月14日開庭審理前，戈爾特斯撤回了請願書，被視為釋出善意的舉動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200416.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-05 08:38", "link": "/news/story/7002/9671375"}, {"article_id": "9671080", "title": "中職／洋砲對決！威克首局就轟三分砲 樂天桃猿8：1大勝台鋼雄鷹", "summary": "下半季戰績暫居領先的樂天桃猿今天與台鋼雄鷹在嘉義棒球場交手，首局樂天洋砲威克就擊出三分砲給台鋼先發投手黃子豪迎頭痛擊，加上先發投手威能帝主投6局僅被擊出2支安打、失1分，最終樂天就以8：1輕取台鋼。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35199955.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-08-04 23:24", "link": "/news/story/7001/9671080"}, {"article_id": "9670855", "title": "中職／德保拉先發7局無失分 中信兄弟5：0退富邦擺脫墊底", "summary": "下半季戰績墊底的中信兄弟與富邦悍將今天在洲際棒球場交手，第二局中信就趁著富邦先發投手阿部雄大遭遇控球亂流攻下2分，最終中信也在先發的德保拉主投7局0失分，以及牛棚接力封鎖下，以5：0完封富邦，擺脫戰績墊底。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35199712.jpg&M=1&s=Y&x=0&y=9&sw=1217&sh=811&exp=3600&sl=W&fw=360", "date": "2026-08-04 21:35", "link": "/news/story/7001/9670855"}, {"article_id": "9670787", "title": "韓職／王彥程第10勝到手 創亞洲外援首位雙位數勝投紀錄", "summary": "韓職韓華鷹隊25歲台灣左投王彥程，今天對三星獅隊上演好投，主投6局、106球無失分，飆出7次三振與2個保送，僅被擊出3支安打，率隊以4：1獲勝，王彥程順利奪下本季第10勝，不僅登上勝投王榜首，更寫下韓職實施亞洲外援制度後，史上首位拿下單季雙位數勝投的亞洲外援，並持續刷新台灣投手單季最多勝紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200492.jpg&M=1&s=Y&x=0&y=16&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 20:57", "link": "/news/story/7001/9670787"}, {"article_id": "9670538", "title": "棒球／亞運棒球培訓赴日交流賽 鄭俊瑋1安1打點跑2盜", "summary": "亞運棒球項目台灣培訓隊赴日移地訓練，與日本社會人隊交流賽今天第2戰，培訓隊打線受制，僅在首局靠著鄭俊瑋適時安打攻下唯一1...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35199446.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-04 18:42", "link": "/news/story/7001/9670538"}, {"article_id": "9670502", "title": "影／陳鏞基引退哽咽謝3個媽媽 最大遺憾無緣大聯盟", "summary": "43歲統一獅老將陳鏞基今天舉行引退記者會，回顧22年棒球生涯時一度哽咽，特別感謝生命中的「三個媽媽」母親、岳母與妻子，讓他一路無後顧之憂追逐棒球夢。他表示，母親從小鼓勵他勇敢追夢，岳母從學生時代一路照顧他，而妻子獨立扛起家庭，更是他的「心靈諮商師」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35199413.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 18:19", "link": "/news/story/7001/9670502"}, {"article_id": "9670334", "title": "NBA／傳國王想替阿卡夫找導師 有意簽下衛少或歐拉迪波", "summary": "國王隊今年休賽季沒有太多操作，如今傳出想找一名資深控衛擔任新秀阿卡夫（Darius Acuff Jr.）的導師，傳出對衛斯特布魯克（Russell Westbrook）和歐拉迪波（Victor Oladipo）有興趣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35199137.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-04 17:05", "link": "/news/story/7002/9670334"}, {"article_id": "9670212", "title": "中職／引退不是結束而是換個角色 陳鏞基懷感恩心迎最後舞台", "summary": "隨著職棒生涯正式邁入倒數階段，統一獅隊43歲老將陳鏞基今天在引退記者會上面對即將到來的「畢業典禮」，內心充滿感恩與不捨。面對兒女對於「引退」的懵懂，他溫柔向孩子解釋，「以後在電視上看不到爸爸打球了，但對我來說引退不是結束，只是換個方式為棒球付出。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198953.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 16:07", "link": "/news/story/7001/9670212"}, {"article_id": "9670180", "title": "TVPL／韓啦「律女王」吳瑞律改當桃氣女孩 首件女孩Tee競標超過6萬得標兩天拍出近10萬", "summary": "韓籍啦啦隊「律女王」吳瑞律以新藝名「RuRu」於桃氣女孩見面會宣布加盟，首件桃氣女孩Tee以$66,707拍出，兩天內總競標價達$96,707，展現她在球迷中的高人氣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198916.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-04 16:05", "link": "/news/story/7005/9670180"}, {"article_id": "9670204", "title": "PLG／勇士掰了國民姐夫 吳永盛約滿離隊", "summary": "台北富邦勇士隊今天宣布，球員吳永盛合約期滿離隊，球團由衷感謝吳永盛效力期間的努力與貢獻，誠摯祝福他未來有更好的發展。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198957.jpg&M=1&s=Y&x=42&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-04 16:05", "link": "/news/story/7003/9670204"}, {"article_id": "9670184", "title": "MLB／洋基只發動3筆交易被評價C級 紐媒批：10月會付出代價", "summary": "洋基隊在今年交易大限前只做3筆交易，捕手、游擊和牛棚都沒有補強，讓許多球迷感到失望。紐約媒體「SNY」給洋基今年交易大限操作僅C級評價。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198922.jpg&M=1&s=Y&x=225&y=35&sw=1013&sh=675&exp=3600&sl=W&fw=360", "date": "2026-08-04 16:03", "link": "/news/story/6999/9670184"}, {"article_id": "9670159", "title": "NBA／杜蘭特盛讚詹皇領軍的76人！ 「比2017宇宙勇還強」", "summary": "杜蘭特日前表示，詹姆斯領軍的76人整體實力超越他曾效力的2017年勇士，並強調76人陣容均衡，擁有明星球員如安比德和布朗。儘管如此，76人仍面臨詹姆斯健康及陣容磨合等挑戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198854.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 15:53", "link": "/news/story/7002/9670159"}, {"article_id": "9670110", "title": "MLB／菅野智之奪11勝仍續留洛磯 美職高層點出乏人問津殘酷現實", "summary": "菅野智之雖在本季繳出11勝4敗的佳績，卻未能吸引爭冠球隊的青睞，因其進階數據評價不佳。美國球團高層指出，菅野的三振能力偏低，且多項指標位於聯盟後段，限制其在季後賽的重要價值。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198772.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 15:40", "link": "/news/story/6999/9670110"}, {"article_id": "9670089", "title": "中職／陳鏞基將引退感謝生命中的三個媽媽 稱只要笑好事就會發生", "summary": "43歲的統一7-eleven獅老將陳鏞基即將在季後引退，在今天的引退記者會上陳鏞基也特別感謝生命中的「三個媽媽」，包括自己的母親、岳母以及老婆，讓他能在棒球路上一路安心追夢，最後他也用「Amazing」來形容自己的球員生涯，儘管一路充滿未知與挑戰，但仍用趕走了過來，才有如此精彩的棒球人生。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198705.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 15:18", "link": "/news/story/7001/9670089"}, {"article_id": "9670010", "title": "MLB／道奇補強史庫柏志在3連霸 世界大賽最新賠率大熱門", "summary": "美國職棒季中交易截止，洛杉磯道奇與紐約洋基均有補強。市場目前看好兩支豪門將是今年世界大賽奪冠熱門。特別是道奇網羅明星左投...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198674.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 15:09", "link": "/news/story/6999/9670010"}, {"article_id": "9670012", "title": "NBA／湯普森加入湖人？美媒曝樂於回家鄉洛杉磯、獨行俠積極尋求交易", "summary": "達拉斯獨行俠正積極尋求交易老將射手湯普森，並不打算以買斷方式與其分道揚鑣。湯普森對重返洛杉磯持開放態度，合約剩最後一年，薪資約1750萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198592.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 15:00", "link": "/news/story/7002/9670012"}, {"article_id": "9669892", "title": "MLB／道奇兩大主戰捕手都進傷兵名單！交易大限前連補2名即戰力", "summary": "洛杉磯道奇在交易截止日前連番交易，補強捕手陣容。隨著主戰捕手史密斯及新秀拉辛相繼進入傷兵名單，道奇引入捕手費杜西亞和洛維特，希望強化蹲捕戰力，並同時增強投手深度。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198394.jpg&M=1&s=Y&x=0&y=0&sw=1145&sh=763&exp=3600&sl=W&fw=360", "date": "2026-08-04 14:53", "link": "/news/story/6999/9669892"}, {"article_id": "9670003", "title": "MLB／ESPN評交易大限道奇是最大贏家 主要對手釀酒人成最大輸家", "summary": "今年大聯盟交易大限熱鬧，ESPN撰文評選贏家和輸家，尋求3連霸的道奇隊被視為最大贏家，捲土重來的釀酒人隊則是最大輸家。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198595.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-04 14:51", "link": "/news/story/6999/9670003"}]}, {"name": "棒球", "articles": [{"article_id": "9671311", "title": "棒球／美國小馬聯盟世界青棒錦標賽 中華隊奪亞軍", "date": "2026-08-05 09:12", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200433.jpg&M=1&s=Y&x=49&y=178&sw=1172&sh=782&exp=3600&w=300", "link": "/news/story/7001/9671311"}, {"article_id": "9670212", "title": "中職／引退不是結束而是換個角色 陳鏞基懷感恩心迎最後舞台", "date": "2026-08-04 16:07", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35198953.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9670212"}, {"article_id": "9670855", "title": "中職／德保拉先發7局無失分 中信兄弟5：0退富邦擺脫墊底", "date": "2026-08-04 21:35", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/04/35199712.jpg&M=1&s=Y&x=0&y=9&sw=1217&sh=811&exp=3600&w=300", "link": "/news/story/7001/9670855"}, {"a