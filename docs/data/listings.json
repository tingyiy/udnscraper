": "/news/story/122629/9724848"}, {"article_id": "9726511", "title": "勇士已老化終將重建 沒理由提前給柯瑞2年頂薪續約 ！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35284442.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9726511"}, {"article_id": "9725032", "title": "中職／在重建與拚季後賽間掙扎 悍將即使想拚但戰力也難突圍", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/31/35280922.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9725032"}, {"article_id": "9723098", "title": "中職／英雄不怕出身低 4大選秀落榜生「霸榜」", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35277985.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9723098"}, {"article_id": "9723127", "title": "美聯MVP毫無懸念 太空人阿瓦瑞茲如何成為無解進攻機器？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35278017.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9723127"}, {"article_id": "9723369", "title": "日職／阪神虎新速球王狂救援 有望誕生獨聯出身新人王第一人", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/30/35278386.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9723369"}]}, {"name": "最新文章", "articles": [{"article_id": "9727680", "title": "中職／黃保羅大限前遭註銷 後藤光尊：身體狀況+投球平衡跑掉", "summary": "富邦悍將隊在831註冊大限前的異動，確定昔日第一指名投手黃保羅今年在一軍留下0出賽，總教練後藤光尊指出，黃保羅的身體狀況不是那麼好，加上投球平衡跑點，判斷無法在下半季提供戰力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286346.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 17:02", "link": "/news/story/7001/9727680"}, {"article_id": "9727667", "title": "足球／企甲迎十周年盼明年擴編至十隊 木蘭聯賽為亞運女足集結應援", "summary": "2026-27賽季台灣企業甲級足球聯賽與台灣木蘭足球聯賽即將登場，中華民國足球協會今天舉辦開賽記者會，正式揭曉新賽季主視覺與Slogan，各隊球員代表身穿全新戰袍亮相，並公開指定比賽用球，宣告國內兩大頂級聯賽正式啟動。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286328.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 16:59", "link": "/news/story/7003/9727667"}, {"article_id": "9727666", "title": "中職／洋投5取4淘汰泰威 後藤談抉擇點：沒有比現有4人好", "summary": "富邦悍將隊在洋投選擇題最終決定不改答案，淘汰未在一軍「開箱」的泰威，談到最終抉擇關鍵，總教練後藤光尊指出，以泰威的二軍出賽內容來看，比起一軍現有洋投還是差一點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286352.jpg&M=1&s=Y&x=0&y=0&sw=1092&sh=728&exp=3600&sl=W&fw=360", "date": "2026-09-01 16:58", "link": "/news/story/7001/9727666"}, {"article_id": "9727655", "title": "MLB／李灝宇競爭對手+1 老虎教頭讚新秀佩克：成熟的球員", "summary": "老虎隊今天將自家農場第20名的內野手佩克（John Peck）拉上大聯盟，他也在今天比賽代守，預計美國時間周二和周三擔任先發游擊手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286315.jpg&M=1&s=Y&x=0&y=15&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 16:56", "link": "/news/story/6999/9727655"}, {"article_id": "9727553", "title": "MLB／曾放話砸大谷！高祐錫重返韓職 依規定無法投季後賽", "summary": "韓國28歲右投高祐錫日前被雙城隊指定讓渡（DFA），沒有球隊認領他的合約，如今確定成為自由球員，傳出將返韓加入LG雙子隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286107.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 16:17", "link": "/news/story/6999/9727553"}, {"article_id": "9727496", "title": "NBA／3屆MVP慘變「冷凍小丑」？球爸狂言金塊跑轟用不著約柯奇", "summary": "金塊3屆MVP約柯奇（Nikola Jokic）已被視為現今NBA最強中鋒，然而「球爸」老鮑爾（LaVar Ball）日前與前NBA球星霍華德（Dwight Howard）一同參與《The LaVar Ball Show》節目，談到心目中的理想籃球體系時，驚人表示即使約柯奇擁有無庸置疑的超強實力，但因為不符合快節奏戰術需求，自己不會讓他上場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286049.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 16:06", "link": "/news/story/7002/9727496"}, {"article_id": "9727473", "title": "東超／開幕戰10月3日宿霧燃戰火 富邦勇士首戰對新軍澳門昊駿", "summary": "2026-2027賽季東亞超級聯賽（EASL）今天宣布，開幕戰正式確認將在10月3日於菲律賓全新落成的宿霧SM濱海體育館登場，廣大亞洲球迷引頸期盼等來的不僅是雙賽日，而且兩場比賽均是重磅級較量。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286012.png&M=1&s=Y&x=113&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-01 15:48", "link": "/news/story/7003/9727473"}, {"article_id": "9727429", "title": "中職／831走一趟機場慘遭網友註銷 鈴木駿輔：好可怕", "summary": "富邦悍將隊日籍洋投鈴木駿輔桃園機場一遊掀起漣漪，今天還原為何出現在機場，原來是為二軍育成洋投山崎正義送機，對於整起事件也直呼「還滿可怕的」。受訪當下，總教練後藤光尊路過，朝他喊話：「趕快去搭飛機！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285945.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 15:37", "link": "/news/story/7001/9727429"}, {"article_id": "9727425", "title": "美網／搶7大戰開紅盤 大坂直美戰袍向艾佛森致敬", "summary": "4度大滿貫得主大坂直美，今天再將美網亞瑟艾許球場化身時尚伸展台，她穿著連帽衣搭配紗裙進場，再身著向NBA傳奇球星艾佛森（Allen Iverson）致敬的黑色勁裝上場，最終在兩盤「搶7」擊敗俄羅斯對手扎哈羅娃（Anastasia Zakharova），挺進第二輪。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285946.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 15:33", "link": "/news/story/121623/9727425"}, {"article_id": "9727389", "title": "中職／台鋼雄鷹、中信兄弟比賽 因雨延至補賽週", "summary": "中華職棒例行賽原訂台鋼雄鷹今天將與中信兄弟交手，因雨勢影響宣布延賽，比賽將延至補賽週、原場地進行", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2024/09/21/98/30576189.jpg&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 15:29", "link": "/news/story/7001/9727389"}, {"article_id": "9727391", "title": "世界俱樂部龍舟錦標賽花蓮登場 菲律賓隊食宿出問題在地業者慷慨支援", "summary": "全球規模最大的「世界俱樂部龍舟錦標賽」（CCWC）正在花蓮舉行，卻傳出菲律賓籍龍舟選手因失去贊助，錢也沒帶夠，食宿都有問題。花蓮縣府協助媒合宮廟住宿，多個在地公益團體、餐飲業者也慷慨解囊，盼協助選手順利在台灣完成賽事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285875.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-01 15:22", "link": "/news/story/7005/9727391"}, {"article_id": "9727305", "title": "NBA／親眼見證1：3史詩逆轉！布朗難忘2016總冠軍賽：史上最偉大之一", "summary": "NBA即將邁入81周年，其中創造不少總決賽名場面，近日布朗（Jaylen Brown）也談到「最偉大總冠軍賽」，並選擇了2016年騎士與勇士的經典大戰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285757.jpg&M=1&s=Y&x=0&y=15&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 15:16", "link": "/news/story/7002/9727305"}, {"article_id": "9727325", "title": "世界盃男籃／土耳其8勝0敗率先晉級正賽！約柯奇「8+8」塞爾維亞險勝義大利", "summary": "土耳其在2027年世界盃男籃資格賽第二輪以110：73痛宰冰島，成為首支拿下世界盃正賽門票的國家。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285793.jpg&M=1&s=Y&x=0&y=30&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-01 15:05", "link": "/news/story/7002/9727325"}, {"article_id": "9727215", "title": "體記協會主辦青年記者營237人搶報 擴編48席台日學員跨國交流", "summary": "體記協會青年記者營吸引237人次報名，名額由32席擴增至48席，錄取45名來自25校的台灣學員及3名日本立命館大學學員，展開跨國交流。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285631.jpg&M=1&s=Y&x=155&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-01 14:31", "link": "/news/story/7005/9727215"}, {"article_id": "9727185", "title": "NBA／談2011總冠軍賽扳倒熱火三王 基德：詹姆斯總說我們只是運氣好", "summary": "2011年NBA總冠軍賽至今仍是詹姆斯（LeBron James）生涯最難忘的挫敗之一，當年率領獨行俠扳倒熱火三巨頭的基德（Jason Kidd），多年後甚至成為詹姆斯的教練。近日基德也透露，兩人共事期間偶爾還是會聊到那輪系列賽，而詹姆斯始終堅稱獨行俠當年只是「運氣好」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285574.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 14:25", "link": "/news/story/7002/9727185"}, {"article_id": "9727162", "title": "世界盃男籃／美國三節被追到5分差 詹姆斯7失誤仍戰勝哥倫比亞", "summary": "2027世界盃男籃美洲區資格賽第二輪，美國男籃回主場迎戰哥倫比亞，終場以104：80拿下勝利，以7勝1敗穩居E組第1，下一輪賽事將在11月下旬進行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285535.jpg&M=1&s=Y&x=157&y=0&sw=682&sh=455&exp=3600&sl=W&fw=360", "date": "2026-09-01 14:21", "link": "/news/story/7002/9727162"}, {"article_id": "9727038", "title": "世界盃男籃／楊瀚森致勝球助中國氣走黎巴嫩！八村壘砍30分率日本虐卡達", "summary": "快艇隊日本混血前鋒八村壘再度發威，昨天2027年世界盃男籃亞洲區資格賽第二輪，八村壘對上卡達狂轟30分，率領日本以123：70大勝。另外，拓荒者隊中國中鋒楊瀚森打進致勝球，全場拿下19分，幫助中國以89：87氣走黎巴嫩。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285360.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 13:31", "link": "/news/story/7002/9727038"}, {"article_id": "9726989", "title": "羽球／台灣混雙葉宏蔚、詹又蓁拉尾盤 中國大師賽驚險晉16強", "summary": "BWF超級750的中國羽球大師賽今天進行首日賽事，台灣混雙組合葉宏蔚、詹又蓁激戰46分鐘，才以6比21、21比12、24...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285329.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-01 13:23", "link": "/news/story/7005/9726989"}, {"article_id": "9727000", "title": "女籃／33歲跳脫舒適圈 黃湘婷加入WKBL新韓銀行", "summary": "剛打完瓊斯盃的中華隊前鋒黃湘婷，將在33歲展開籃球新旅程，名古屋亞運後轉戰南韓女子職籃（WKBL），加盟新韓銀行隊，和中華隊隊友韓雅恩異國再當對手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285226.jpg&M=1&s=Y&x=0&y=0&sw=798&sh=532&exp=3600&sl=W&fw=360", "date": "2026-09-01 13:08", "link": "/news/story/7003/9727000"}, {"article_id": "9726954", "title": "NBA／離隊揭金塊復健內幕！華森曝傷勢惡化原因：感到復出壓力", "summary": "23歲年輕前鋒華森（Peyton Watson）在休賽季透過先簽後換加盟騎士，並簽下4年8800萬美元延長合約。他近日則談到上季右大腿後側肌傷勢的復健過程，透露當時曾感受球隊希望他趕在季後賽前復出的壓力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285129.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 13:01", "link": "/news/story/7002/9726954"}, {"article_id": "9726924", "title": "美網／約克維奇爆冷一輪遊 阿爾卡拉斯也意外", "summary": "西班牙「小蠻牛」阿爾卡拉斯（Carlos Alcaraz）腕傷復出第一站就到美網挑戰衛冕，今天順利開出紅盤後表示，24度大滿貫得主、塞爾維亞名將約克維奇（Novak Djokovic）首輪意外落馬讓人驚訝，強調並沒注意這半區可能遭遇的對手會是誰。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285097.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 12:33", "link": "/news/story/121623/9726924"}, {"article_id": "9726898", "title": "TPBL／台新戰神教練團異動 情蒐教練謝一謙正式加入", "summary": "台北台新戰神隊今宣布情蒐教練謝一謙加入教練團，未來將透過數據、影像分析等專業，協助教練團掌握比賽細節，並從不同角度提供球隊戰術調整參考。台北戰神營運長楊勝凱表示，謝一謙具備豐富的國家隊及職業球隊情蒐經驗，熟悉球隊運作且具備高度專業能力，相信他能夠協助團隊在備戰及比賽調整上更加順暢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285042.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 12:25", "link": "/news/story/7003/9726898"}, {"article_id": "9726877", "title": "中職／味全龍獵人主題日第二彈來了 換上幻影旅團黑色戰袍", "summary": "味全龍於9月11到13日推出重量級跨界合作HUNTER×HUNTER獵人聯名主題日第二彈，延續首波獵人試驗的熱潮，第二波活動將帶領球迷進入戰況最白熱化的經典核心篇章。天母棒球場全面解鎖，化身為黑幫與旅團交鋒的「友克鑫市」、賭上人類存亡的「嵌合蟻篇」以及暗潮洶湧的「會長選舉」，號召全台制約獵人與龍迷再次集結。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285014.jpg&M=1&s=Y&x=117&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-09-01 12:17", "link": "/news/story/7001/9726877"}, {"article_id": "9726824", "title": "MLB／小熊血洗龍頭釀酒人！單場9轟、單月62轟都創隊史首見", "summary": "小熊隊三壘手布萊格曼（Alex Bregman）單場三響砲，小熊全隊9轟破隊史紀錄，終場以17：3血洗大聯盟龍頭釀酒人隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35284940.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-01 12:11", "link": "/news/story/6999/9726824"}]}, {"name": "棒球", "articles": [{"article_id": "9727429", "title": "中職／831走一趟機場慘遭網友註銷 鈴木駿輔：好可怕", "date": "2026-09-01 15:37", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35285945.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9727429"}, {"article_id": "9727680", "title": "中職／黃保羅大限前遭註銷 後藤光尊：身體狀況+投球平衡跑掉", "date": "2026-09-01 17:02", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286346.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9727680"}, {"article_id": "9727666", "title": "中職／洋投5取4淘汰泰威 後藤談抉擇點：沒有比現有4人好", "date": "2026-09-01 16:58", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/01/35286352.jpg&M=1&s=Y&x=0&y=0&sw=1092&sh=728&exp=3600&w=300", "lin