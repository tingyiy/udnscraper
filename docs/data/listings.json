php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35482304.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9855350"}, {"article_id": "9855034", "title": "末日級傷兵海嘯來襲 雷霆能走出近年最艱難開季嗎？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481887.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9855034"}]}, {"name": "最新文章", "articles": [{"article_id": "9859916", "title": "中職／教頭難為！葉君璋不戀棧 恐連兩年出現奪冠成畢業秀？", "summary": "味全龍奪冠後，葉君璋透露有意卸下總教練職務，球團將再討論安排；古久保健二去年奪冠後也未續約，中職可能連兩年更換冠軍教頭。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489427.jpg&M=1&s=Y&x=0&y=34&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-06 07:00", "link": "/news/story/122629/9859916"}, {"article_id": "9860320", "title": "約柯奇脫下「外星人」外衣 金塊是否已從「奪冠列車」下車？", "summary": "金塊開季4勝3敗，約柯奇攻守效率下滑，防守聯盟倒數第六，球隊爭冠競爭力受質疑；穆雷則打出高效表現力挺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35490141.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-06 07:00", "link": "/news/story/122629/9860320"}, {"article_id": "9860333", "title": "足球／C羅正式宣布退出葡萄牙國家隊 親發影片：該交還7號球衣了", "summary": "C羅宣布退出葡萄牙國家隊，結束23年國際賽生涯；他累計234場攻入146球，曾率隊勇奪2016歐國盃與2019歐國聯冠軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35490040.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-05 20:15", "link": "/news/story/7005/9860333"}, {"article_id": "9860319", "title": "青奧／4局橫掃球王胞妹！陳忞昕勇闖桌球女單金牌戰", "summary": "先在桌球混雙奪下銅牌，寶島小將陳忞昕確定女單也登上頒獎台，今天她先在2026第四屆達卡青年奧林匹克運動會桌球女單4強賽4局「橫掃」日本女將松島美空，搶下台灣時間明天凌晨1點半的金牌戰門票，確定為代表團再進帳一面獎牌，也是個人本屆青奧的第二面獎牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35490025.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 19:48", "link": "/news/story/7005/9860319"}, {"article_id": "9859976", "title": "NBA／唐西奇開季飆分秀寫63年新高紀錄 里夫斯：沒睡覺能拿60分", "summary": "湖人隊一哥唐西奇（Luka Doncic）今天面對國王隊拿下40分9籃板7助攻，幫助球隊以116：103輕鬆取勝，隊友里夫斯（Austin Reaves）笑稱，要是唐西奇沒睡覺能拿60分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489455.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 17:14", "link": "/news/story/7002/9859976"}, {"article_id": "9859855", "title": "NBA／小丑竟是我自己？國王拉文「暗酸」隊友防守爛 自己數據卻慘不忍睹", "summary": "國王今日在主場以103：116不敵湖人，不僅開季繳出1勝7敗的慘澹戰績，休息室問題更逐漸浮上檯面，包括陣中明星後衛拉文（Zach LaVine）輸球受訪時，疑似暗酸隊友防守不力。然而，攤開拉文本季的個人及進階防守數據，他似乎也沒有太多本錢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489270.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 17:06", "link": "/news/story/7002/9859855"}, {"article_id": "9859957", "title": "NBA／溫班亞瑪13秒搧連3火鍋、數據比肩傳奇 哈波：根本是張伯倫本人", "summary": "馬刺隊球星溫班亞瑪（Victor Wembanyama）狂轟生涯新高52分、24籃板，外加8次阻攻，率領馬刺以112：111驚險擊敗獨行俠隊。溫班亞瑪賽後透露自己最近有小感冒，隊友哈波（Dylan Harper）則是對他讚不絕口。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489420.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 17:04", "link": "/news/story/7002/9859957"}, {"article_id": "9859953", "title": "羽球／世青金牌領銜捍衛主場 高雄大師賽10日開戰", "summary": "2026高雄羽球大師賽將於11月10日至15日在高雄巨蛋體育館點燃戰火，本屆賽事吸引來自19個國家、345位羽球好手齊聚高雄，展開為期六天的精彩對決。台灣新戰力由奪下我國第一面世青男雙金牌的陳秉軒／李威霆領軍出擊，迎戰各國勁敵，全力爭取冠軍，捍衛主場榮耀。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489411.jpg&M=1&s=Y&x=0&y=0&sw=940&sh=627&exp=3600&sl=W&fw=360", "date": "2026-11-05 17:02", "link": "/news/story/7005/9859953"}, {"article_id": "9859801", "title": "MLB／費爾柴德返台加盟中職？「能被球隊欣賞都要非常感謝」", "summary": "「費仔」費爾柴德（Stuart Fairchild）打完本屆世界棒球經典賽後人氣暴漲，擁有不少台灣死忠球迷，未來有機會來台打球嗎？他說：「交給經紀公司處理。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489178.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 16:11", "link": "/news/story/6999/9859801"}, {"article_id": "9859703", "title": "MLB／太美了！「費仔妻」台北101甜蜜放閃 6小時狂吸17萬人朝聖", "summary": "台灣混血好手「費仔」費爾柴德（Stuart Fairchild）近日帶著愛妻漢娜（Hanna Fairchild）及家人重返台灣，除了參與公益活動與棒球訓練營，也不忘享受夫妻倆的甜蜜時光。近日費嫂也在社群平台曬出一系列台北約會美照，立刻引發台灣網友熱烈討論，短短6小時便吸引超過17萬次瀏覽、1.8萬人按讚，留言區更湧入大批球迷，直呼兩人根本是「神仙組合」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488998.jpg&M=1&s=Y&x=0&y=146&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-05 15:57", "link": "/news/story/6999/9859703"}, {"article_id": "9859737", "title": "NBA／湯普森轟30分、上次是勇士時期 熱火主帥：證明人可以對抗歲月", "summary": "36歲湯普森（Klay Thompson）今天投進「準絕殺」三分球，幫助熱火隊在延長賽以117：116氣走快艇隊。湯普森全場狂飆30分，上次拿下30分，要追溯至2024年4月8日，當時他還身披勇士隊戰袍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489054.jpg&M=1&s=Y&x=26&y=64&sw=996&sh=663&exp=3600&sl=W&fw=360", "date": "2026-11-05 15:53", "link": "/news/story/7002/9859737"}, {"article_id": "9859732", "title": "MLB／驚訝台灣有這麼多好選手 費爾柴德直接點名李灝宇", "summary": "「費仔」費爾柴德（Stuart Fairchild）結束3月經典賽任務後，回到美職在大聯盟守護者、水手隊出賽15場，他說：「今年是大聯盟出賽較少的一季， 3A每天出賽是新體驗，也有一些幫助。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489050.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 15:49", "link": "/news/story/6999/9859732"}, {"article_id": "9859682", "title": "影／經典賽國手費爾柴德訪台 不愛臭豆腐但會給第二次機會", "summary": "經典賽國手費爾柴德與老婆、父母、弟弟訪台，受訪時表示代表台灣隊之前，對台灣的了解沒有到很深入，參與經典賽之後，他發現台灣的球迷對棒球真的非常熱情。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488968.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 15:29", "link": "/news/story/6999/9859682"}, {"article_id": "9859678", "title": "MLB／費仔驚訝在台中也被認出來 下周會和老友陳傑憲碰面", "summary": "本屆世界棒球經典賽國手「費仔」費爾柴德（Stuart Fairchild）今天在返台記者會亮相，爸媽和妻子開心合影，他多次感謝台灣球迷從經典賽到美國職棒例行賽期間的熱情支持，甚至這次返台到台中逛街還被認出來，費仔說：「在台中小市集有球迷希望一起拍照，很驚訝在台北之外也被認出來，太太覺得很開心。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488952.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-05 15:27", "link": "/news/story/6999/9859678"}, {"article_id": "9859552", "title": "NBA／浪花兄弟明重逢！湯普森作客對勇士 柯爾感慨當年奪冠歲月", "summary": "昔日「浪花兄弟」成員湯普森（Klay Thompson）與維金斯（Andrew Wiggins）明日將一同披上熱火戰袍，重返熟悉的勇士主場。對此，勇士總教練柯爾（Steve Kerr）談到兩位昔日愛將時，難掩懷念之情，強調兩人不僅是勇士奪冠的重要功臣，更為球隊文化留下深遠影響。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488793.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 15:03", "link": "/news/story/7002/9859552"}, {"article_id": "9859609", "title": "NBA／湯普森延長賽「準絕殺」 熱火扭轉20分落後賞快艇7連敗", "summary": "熱火隊今天上演戲劇性逆轉，先克服正規賽最多20分劣勢，延長賽再扭轉最後3.3秒還落後2分局勢，湯普森（Klay Thompson）從籃下繞到底角找到外線出手空檔，單場命中的第8記三分彈助隊踢館成功，以117：116氣走快艇隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35489130.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 14:59", "link": "/news/story/7002/9859609"}, {"article_id": "9859588", "title": "NBA／溜馬出戰球員比上一場多兩倍 灰熊開季6連勝後吞2連敗", "summary": "前一場只有6人出戰的溜馬隊今天迎來中鋒祖巴茲（Ivica Zubac）歸隊，全場12名球員上陣，終場以107：103擊敗灰熊隊，讓灰熊苦吞2連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488785.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 14:56", "link": "/news/story/7002/9859588"}, {"article_id": "9859489", "title": "NBA／寧願留布朗尼？「湖人棄將」首秀10分7籃板 補灌引爆尼克主場", "summary": "湖人今年休賽季為了精簡陣容，最終留下詹姆斯（LeBron James）兒子布朗尼（Bronny James），卻將昔日首輪17順位的射手肯奈特（Dalton Knecht）釋出。沒想到，這位25歲湖人棄將轉戰衛冕軍尼克後，今日首秀僅替補出賽16分鐘，就繳出10分、7籃板的亮眼表現，更以一記華麗補灌點燃主場氣氛，幫助尼克以135：105痛宰公牛。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488582.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 14:27", "link": "/news/story/7002/9859489"}, {"article_id": "9859516", "title": "MLB／費爾柴德大秀中文打招呼 最難忘台日大戰球迷瘋狂支持", "summary": "3月代表中華隊參加經典賽的美國職棒好手費爾柴德（Stuart Fairchild），今天出席返台記者會，一開始就用中文向大家打招呼：「大家好，很是費仔，很開心又回到台灣了，謝謝大家一直支持我。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488639.jpg&M=1&s=Y&x=0&y=224&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 14:26", "link": "/news/story/6999/9859516"}, {"article_id": "9859476", "title": "棒球／台日韓職棒三強桃園交鋒！DAZN雙11祭56折優惠", "summary": "台日韓職棒11月7、8日桃園交鋒，DAZN獨家直播；雙11年約首年890元享56折優惠，另可註冊收看黑豹旗、TPBL等賽事。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488572.png&M=1&s=Y&x=106&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-05 14:23", "link": "/news/story/7001/9859476"}, {"article_id": "9859438", "title": "NBA／唐西奇連三場40＋ 追上喬丹神紀錄率湖人退國王", "summary": "湖人隊當家球星唐西奇（Luka Doncic）持續展現可怕的得分能力，今天碰國王隊再有40分演出，以連6場比賽得分都破35分的強勢表現率隊以116：103奪勝，3連勝入袋。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488484.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 14:05", "link": "/news/story/7002/9859438"}, {"article_id": "9859417", "title": "中職／王威晨宣布行使自由球員權利 在兄弟11年首次動用", "summary": "中信兄弟隊35歲老將王威晨，今天宣布行使自由球員權利，聯盟已經正式公告。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488425.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-05 14:02", "link": "/news/story/7001/9859417"}, {"article_id": "9859338", "title": "NBA／溫班亞瑪寫「52+24+8」史詩級數據！馬刺險勝獨行俠1分", "summary": "馬刺隊今天在主場迎來德州內戰對決獨行俠隊，溫班亞瑪（Victor Wembanyama）得分和籃板創生涯新高，繳出52分24籃板8火鍋的史詩級數據，帶隊以112：111拿下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/05/35488252.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-05 13:37", "link": "/news/story/7002/9859338"}, {"article_id": "9859080", "title": "NBA ／火箭墜落！小鮑爾、庫明加末節發威領灰狼擊敗西區龍頭", "summary": "灰狼與火箭今日上演激烈拉鋸戰，雙方前三節始終難分高下，火箭甚至帶著2分