, "articles": [{"article_id": "9774286", "title": "亞運桌球／林昀儒惜敗王楚欽未過魔王關 桌球男團收銅", "summary": "名古屋亞運全面開戰第四天，中華代表團在軟網、體操、射擊、武術及桌球再添五面銅牌獎牌進帳。桌球男子團體連續四屆挺進四強，昨晚對戰挑戰九連霸的大陸隊，「小林同學」林昀儒帶著兩名學弟馮翊新、十七歲新星郭冠宏依序出擊，但沒能闖過「魔王關」，以直落三點吞敗，銅牌收場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35358381.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 00:30", "link": "/news/story/124981/9774286"}, {"article_id": "9774256", "title": "體操男團亞運連兩屆摘銅 「世界貓王」唐嘉鴻慶生", "summary": "名古屋亞運體操男子團體決賽昨天登場，「世界貓王」唐嘉鴻與「鞍馬王子」李智凱領軍學弟蕭佑然、洪源禧、莊佳龍出擊，在場上展現強韌韌性與絕佳默契，最終以僅次於中國大陸和日本的總分二三九點八九六分，連續兩屆亞運奪下銅牌，同時也是本屆亞運我國代表團收穫的首面奧運比賽項目獎牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35358242.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-24 00:27", "link": "/news/story/124981/9774256"}, {"article_id": "9774289", "title": "亞運射擊／李孟遠定向飛靶射銅 獻給天上爸爸", "summary": "我國射擊好手李孟遠昨在名古屋亞運男子定向飛靶摘下銅牌，雖如願抱回個人首面亞運獎牌、一吐上屆因扣分僅拿第五名的悶氣，但未奪金仍讓他直呼遺憾，賽後也手指天空，要將這面銅牌獻給已經過世的父親、也是教練謝志培。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35358341.jpg&M=1&s=Y&x=0&y=44&sw=930&sh=620&exp=3600&sl=W&fw=360", "date": "2026-09-24 00:22", "link": "/news/story/124981/9774289"}, {"article_id": "9774315", "title": "名古屋隨筆／比賽突熄燈、毛巾晾場邊 亞運第一周天天有「驚喜」", "summary": "2026年名古屋亞運自19日正式開幕，本屆賽會為響應低碳與節能，同時也因各種「省錢」考量，導致各項規劃及安排都是負評不斷，就記者實際採訪的過程，也可說是天天有驚喜，軟、硬體狀況層出不窮，還有不少令人滿頭問號的場景出現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35358330.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 00:11", "link": "/news/story/124981/9774315"}, {"article_id": "9774017", "title": "亞運桌球／5局不敵王楚欽嘆可惜 林昀儒自認做得不錯「落後時沒放棄」", "summary": "名古屋亞運中華桌球男團今天在4強戰以0：3不敵中國，連4屆銅牌收場，林昀儒扛第一點力戰世界排名第一的王楚欽，差點上演「讓二追三」逆轉秀，可惜最終激戰5局落敗，林昀儒也坦言有些可惜。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357971.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 22:03", "link": "/news/story/124981/9774017"}, {"article_id": "9773948", "title": "亞運／24日中華隊續拚獎牌 李智凱鞍馬單項力搶金牌3連霸", "summary": "名古屋亞運明天進入開幕後第6天，中華男子體操個人單項接續登場，李智凱、蕭佑然將於鞍馬上陣，李智凱要力拚金牌3連霸；男子銳...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357892.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 21:16", "link": "/news/story/124981/9773948"}, {"article_id": "9773908", "title": "亞運桌球／林昀儒扛第一點5局惜敗 中華男團不敵中國獲銅牌", "summary": "名古屋亞運桌球男子團體賽，中華隊連4屆挺進4強，今天迎戰力拚男團9連霸的中國大陸，林昀儒打頭陣對決世界球王王楚欽，但激戰5局惜敗，之後登場的馮翊新、郭冠宏也沒能拿下勝利，最終遭直落三點落敗無緣爭金，銅牌收場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357840.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 20:47", "link": "/news/story/124981/9773908"}, {"article_id": "9773867", "title": "亞運卡巴迪／中華迎「雙喜」　男、女代表隊均奏捷", "summary": "台灣卡巴迪代表隊今天在名古屋亞運迎來「雙喜」，女子代表隊以37比18擊敗尼泊爾，分組預賽拉出2連勝；男子代表隊晚間則靠著...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/09/35120093.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-23 20:33", "link": "/news/story/124981/9773867"}, {"article_id": "9773872", "title": "亞運棒球／郭子銓先發6局10K+打線3轟 中華隊7局11：0退香港晉級", "summary": "名古屋亞運棒球賽，中華隊今天晚間在預賽最終戰對上香港隊，郭子銓先發6局送出10次三振，打線則自第5局起拉開差距，還有陳孝允、劉基鴻、陳敏賜敲3轟，終場中華隊提前7局以11：0收下勝利，預賽戰績2勝1敗取得分組第二，晉級超級循環賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357754.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 20:25", "link": "/news/story/124981/9773872"}, {"article_id": "9773858", "title": "亞運散打／眼角縫9針帶傷拚到最後 張煥宜連兩屆摘銅將退休", "summary": "我國武術散打好手張煥宜今天在男亞運散打4強賽不敵哈薩克對手，最終收下銅牌，在首戰後右眼眉骨才剛縫了9針、傷口長達6公分的他，今天在場上再次遭到對手擊中傷處血流不止，最終經大會裁判考量選手安全後裁定擊倒終止比賽。雖然沒能挺進金牌戰，但連續兩屆亞運都抱回銅牌的張煥宜賽後坦言「真的盡力了」，並宣布將正式退役轉任教練。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357741.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 20:16", "link": "/news/story/124981/9773858"}, {"article_id": "9773794", "title": "亞運桌球／林昀儒男團4強大戰王楚欽 決勝局激鬥到13：15落敗丟第一點", "summary": "生涯過去只贏過王楚欽3次，「小林同學」今天在名古屋亞運男子團體賽4強戰，面對中國大陸扛第一點單打對決王楚欽，先丟2局後急起直追，決勝局逃過賽末點後與王楚欽一路糾纏，但最終連丟3分讓勝利溜手，以2：3讓出第一點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357700.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 19:53", "link": "/news/story/124981/9773794"}, {"article_id": "9773749", "title": "籃球／登峰造極邀請賽 大專女子組大勢底定文化提前奪冠台師大亞軍", "summary": "文化大學118比45擊敗中信學院，4戰全勝提前奪得大專女子組冠軍；台師確定亞軍。男子組健行87比81勝福建華僑，黎明82比85不敵台藝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357657.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 19:38", "link": "/news/story/7003/9773749"}, {"article_id": "9773691", "title": "亞運武術／遭哈薩克強敵擊倒 掌旗官張煥宜再度濺血摘銅", "summary": "今年擔任我國亞運開幕式進場掌旗官的張煥宜，今天在武術散打男子75公斤級賽事面對哈薩克強敵阿卜杜拉耶夫（Abdurashid Abdullayev），最終遭WKO敗下陣來，以銅牌作收。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357610.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-23 18:59", "link": "/news/story/124981/9773691"}, {"article_id": "9773679", "title": "MLB／村上宗隆扛33轟平岡本和真 並列大聯盟最多轟日本新人", "summary": "美國職棒大聯盟MLB芝加哥白襪日本籍重砲村上宗隆今天扛出本季第33轟，幫助球隊終場以14比11擊倒堪薩斯皇家，他與多倫多...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357587.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-23 18:50", "link": "/news/story/6999/9773679"}, {"article_id": "9773655", "title": "亞運／歡迎儀式有豐臣秀吉 組委會回應韓國抗議", "summary": "愛知名古屋亞運15日的歡迎儀式上，有工作人員扮成日本戰國武將豐臣秀吉，引發韓國強烈反彈後，本屆亞運組織委員會高層今天表示...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35357527.jpg&M=1&s=Y&x=60&y=0&sw=12