, {"article_id": "9775503", "title": "NBA／雷納德續約暴龍有「魔鬼細節」 降薪與球員選擇權造就雙贏", "summary": "雷納德降薪1100萬美元續約暴龍2年、總值1.15億美元，末年握球員選擇權，兼顧球隊薪資空間與生涯規劃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360821.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 15:11", "link": "/news/story/7002/9775503"}, {"article_id": "9775518", "title": "桃園盃／蔣智賢「感覺對了」神調度 鶯歌石正侑延長賽代打建功", "summary": "鶯歌工商教練團加入職棒退役球員蔣智賢協助打擊調整，桃園盃青棒季軍戰，蔣智賢在延長賽「感覺對了」派石正侑上場代打建功，石正...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360763.jpg&M=1&s=Y&x=0&y=115&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:58", "link": "/news/story/7001/9775518"}, {"article_id": "9775317", "title": "桃園盃／陳冠亨後援穩守 鶯歌延長賽搶勝奪季軍", "summary": "桃園盃棒球賽青棒組賽事，鶯歌工商今天與北市大附中交手鏖戰至延長賽，8局上鶯歌攻下3分、8局下雖然守備有狀況，但陳冠亨及時...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360754.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:57", "link": "/news/story/7001/9775317"}, {"article_id": "9775324", "title": "亞運游泳／中國19歲「奇蹟之子」張展碩3天奪4金 蒙古選手自帶「泳圈」引關注", "summary": "名古屋亞運中國泳軍昨再添6金3銀，其中19歲的張展碩、13歲的于子迪是最亮眼的兩顆超新星；被稱為「奇蹟之子」的張展碩，男子200米自由泳決賽打破亞洲紀錄奪冠，他開賽三天橫掃四金，並兩度刷新亞洲紀錄，有機會邁向「七金王」，央視形容「恐怖如斯」。「小孩姐」于子迪昨則拿下本屆亞運個人第三金，她三天三金、兩破紀錄，亞運之旅堪稱夢幻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360208.png&M=1&s=Y&x=0&y=0&sw=1023&sh=682&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:55", "link": "/news/story/124981/9775324"}, {"article_id": "9775320", "title": "亞運體操／中國逆轉日本霸團體雙金 男子連贏3屆、女子14連冠", "summary": "在9月23日進行的名古屋亞運會體操男、女子團體賽決賽中，中國國家隊展現強勢實力，雙雙逆轉擊敗東道主日本隊，成功包辦兩面金牌。其中，男子體操隊後來居上實現三連冠，拿下隊史第13面亞運男團金牌；女子體操隊則延續強勢表現，締造自1974年以來在亞運該項目上的14連冠霸業。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360728.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:50", "link": "/news/story/124981/9775320"}, {"article_id": "9775480", "title": "亞運卡巴迪／女子隊3連勝晉4強 確保連2屆摘牌", "summary": "台灣女子卡巴迪代表隊今天再以43比31擊敗強敵泰國，小組預賽以3連勝登上龍頭寶座，不僅順利挺進名古屋亞運4強，也確保有連...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360712.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:48", "link": "/news/story/124981/9775480"}, {"article_id": "9775587", "title": "亞運擊劍／關鍵一分遭翻盤 台法混血劍手葛屹盧坦言「做了很破選擇」", "summary": "我國台法混血擊劍好手葛屹盧，今天在名古屋亞運男子銳劍16強賽陷入苦戰，面對哈薩克世錦賽男團金牌強敵波荷多夫（Kirill Prokhodov），一路纏鬥至14：14平手，但關鍵最後一劍，葛屹盧因猶豫變招遭到對手刺中得分，無緣晉級8強，賽後談到關鍵失分，他懊悔表示，「我真的做了很破的選擇，最後那一劍打得太卡了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360642.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:40", "link": "/news/story/124981/9775587"}, {"article_id": "9775582", "title": "亞運3X3籃球／男籃換血拚衛冕先闖8強 葉惟捷：合作很熱血像回到HBL", "summary": "名古屋亞運3X3籃球，我國3X3男籃今天順利挺過8強附加賽，拿下8強門票，朝衛冕之路又近了一步。張俊生、葉惟捷、徐堂琪、鄒子羲 4名年紀相仿的隊友互相磨合出好的化學效應，葉惟捷說：「合作起來很熱血，感覺又回到HBL的感覺。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360635.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:38", "link": "/news/story/124981/9775582"}, {"article_id": "9775539", "title": "NBA／勇士新秀從義大利開啟職業生涯 與2022冠軍前鋒同隊", "summary": "勇士隊日前以雙向合約簽下長人艾克（Graham Ike），填滿雙向合約最後一個席次，今年選秀二輪第54順位新秀瓊斯（Lajae Jones）則是將從義大利展開職業生涯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360602.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:31", "link": "/news/story/7002/9775539"}, {"article_id": "9775522", "title": "MLB／在洛磯「打者天堂」6勝0敗 凱利率響尾蛇4連勝續拚國聯外卡", "summary": "美國職棒大聯盟亞利桑那響尾蛇今晚客場以5比3擊敗科羅拉多洛磯，全力爭奪國家聯盟外卡晉級門票。台美混血球星卡洛爾首局就擊出...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360598.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:29", "link": "/news/story/6999/9775522"}, {"article_id": "9775394", "title": "NBA／尼克續約唐斯談判陷入停滯 第二層豪華稅壓力恐成留人關鍵", "summary": "尼克與冠軍中鋒唐斯提前續約談判陷入停滯，雙方有意續合作，卻受薪資結構與第二層豪華稅壓力牽制，年薪成關鍵。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360584.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:26", "link": "/news/story/7002/9775394"}, {"article_id": "9775531", "title": "亞運擊劍／開賽優勢遭東奧金牌翻盤 李讓遭逆轉無緣8強續拚團體獎牌", "summary": "相隔36年重返亞運舞台的我國男子銳劍代表隊，今年帶著衝擊擊劍隊首面獎牌的決心來到名古屋，其中19歲的李讓與台法混血好手葛屹盧在今天雙雙挺進16強賽後，最終都遭到世界級名將擋道無緣爭牌，其中李讓更是在對戰日本奧運金牌名將山田優的賽事中一度領先，但最終仍是以12：15敗下陣來，止步於8強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360581.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-24 14:26", "link": "/news/story/124981/9775531"}]}, {"name": "名古屋亞運", "articles": [{"article_id": "9775927", "title": "亞運籃球／蕭豫玟14分、17籃板主宰禁區 中華女籃退菲律賓晉級4強", "date": "2026-09-24 16:52", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35361315.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/124981/9775927"}, {"article_id": "9775190", "title": "亞運電競／《永劫無間》奪銅電競隊首牌 顏慨恩：成績上最好安排", "date": "2026-09-24 12:28", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35359911.jpg&M=1&s=Y&x=0&y=107&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124981/9775190"}, {"article_id": "9775582", "title": "亞運3X3籃球／男籃換血拚衛冕先闖8強 葉惟捷：合作很熱血像回到HBL", "date": "2026-09-24 14:38", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360635.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/124981/9775582"}, {"article_id": "9775409", "title": "亞運3X3籃球／女籃闖8強出場手勢場場換 蔡佑蓮：到金牌戰都準備好了", "date": "2026-09-24 13:44", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/2