", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/26/35455514.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9838016"}, {"article_id": "9837712", "title": "湖人開季3連勝 ！少了詹皇卻造就唐西奇、里夫斯、凱斯勒三巨頭", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/26/35454928.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9837712"}]}, {"name": "最新文章", "articles": [{"article_id": "9847176", "title": "NBA／送走莫蘭特灰熊卻更強！ 19歲布瑟狂送大三元 超越詹皇紀錄", "summary": "美國職籃NBA曼菲斯灰熊今天靠菜鳥布瑟繳出大三元的歷史級表現，終場以124比103擊敗波特蘭拓荒者，保住開季不敗金身。拓...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469856.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 15:39", "link": "/news/story/7002/9847176"}, {"article_id": "9847187", "title": "MLB／鄭宗哲為老虎游擊添深度但打擊弱 美媒：與李灝宇同隊更安心", "summary": "老虎隊今天透過交易得到台灣內野手鄭宗哲，將與李灝宇當隊友。美國媒體《Bless You Boys》認為，鄭宗哲的加盟將為老虎游擊防區增添更多板凳深度，但打擊仍相對薄弱。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2024/03/06/0/29127998.jpg&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 15:12", "link": "/news/story/6999/9847187"}, {"article_id": "9847159", "title": "日職／西武獅放行！防禦率王平良海馬挑戰大聯盟 美媒預估身價曝光", "summary": "西武獅同意防禦率王平良海馬透過入札制度挑戰大聯盟，本季先發23場繳出12勝5敗、防禦率1.36，美媒預估他可獲3年6000萬美元合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469727.jpg&M=1&s=Y&x=0&y=43&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-30 15:07", "link": "/news/story/7001/9847159"}, {"article_id": "9847071", "title": "MLB／鄭宗哲轉戰老虎！22歲大物卡位 台灣黃金二遊合體有難度", "summary": "鄭宗哲遭紅襪交易至老虎，將有機會與李灝宇重聚；但內野大物麥高尼格爾坐鎮，他具多守位能力，爭取大聯盟席位仍不易。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469472.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 14:35", "link": "/news/story/6999/9847071"}, {"article_id": "9847105", "title": "NBA／雷霆開季遇傷兵大海嘯！主力悍將接連倒下 SGA淡定不擔心", "summary": "上季衛冕失利的雷霆新賽季捲土重來，沒想到才剛起步，就面臨嚴峻的傷兵考驗，包括明星前鋒威廉斯（Jalen Williams）、中鋒霍姆葛倫（Chet Holmgren）及後衛華勒斯（Cason Wallace）接連倒下，讓球隊原本引以為傲的防守體系受到衝擊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469530.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 14:33", "link": "/news/story/7002/9847105"}, {"article_id": "9847104", "title": "中職／悍將連兩年安排林哲瑄赴日進修 擔任火腿二軍秋訓研習教練", "summary": "隨著日職秋訓率續展開，富邦悍將隊今年持續派遣教練赴日交流，連續兩年安排林哲瑄前往日職火腿隊位於在沖繩國頭的二軍秋訓營擔任研習教練，將進行為期2周的觀摩與學習。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469526.jpg&M=1&s=Y&x=1&y=300&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-10-30 14:29", "link": "/news/story/7001/9847104"}, {"article_id": "9846789", "title": "足球／「辱華」效應 姆巴佩代言的商品 不是被遮眼就是被挖臉", "summary": "中國對西甲皇馬球員姆巴佩「辱華」事件展開連串制裁效應持續擴大，趙一鳴等數家連鎖店昨也宣布姆巴佩商品下架，東鵬飲料被爆緊急發送專用遮蓋貼紙，要求各賣場貼在「補水啦」瓶身蓋住姆巴佩頭像的雙眼。廣州有商家稱姆巴佩代言飲品昨單日銷量為0，多地公交車站廣告的姆巴佩頭像眼睛被挖。曾效力中超的前巴西國腳奧斯卡昨發聲，稱他在華八年，深知要尊重中國人，盼愈來愈多外籍球員尊重中國。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35468934.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 14:25", "link": "/news/story/7005/9846789"}, {"article_id": "9847075", "title": "棒球／花蓮光復災後一年 球芽基金持續送暖陪伴孩子走過重建之路", "summary": "花蓮光復鄉在去年9月因颱風造成馬太鞍溪上游堰塞湖溢流，引發嚴重災情，球芽基金在災害發生初期就為服務學校的受災家庭提供第一批慰問禮券；如今於洪災滿一周年之際，再次送上第二批關懷，為受災孩子提供實際的生活支持。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469471.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 14:10", "link": "/news/story/7001/9847075"}, {"article_id": "9847070", "title": "NBA／19歲飆大三元寫多項紀錄 灰熊探花布瑟：感覺前景一片光明", "summary": "灰熊今天作客拓荒者主場，在新科探花布瑟（Cameron Boozer）展現全能身手，僅上場28分鐘就高效轟下18分、12籃板、12助攻外帶2抄截，不僅收穫個人NBA生涯首個大三元，更以19歲104天之齡超越詹姆斯（LeBron James），締造史上最年輕達成大三元的前鋒紀錄，終場灰熊也以124：103輕取拓荒者，豪取開季5連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469510.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 14:10", "link": "/news/story/7002/9847070"}, {"article_id": "9847025", "title": "NBA／厄文若上架交易恐引各方爭搶！獨行俠高層揭未來計畫：我們相信他", "summary": "達拉斯獨行俠近年經歷重大陣容變動，隨著球隊逐漸圍繞年輕新星佛雷格（Cooper Flagg）打造未來，明星後衛厄文（Kyrie Irving）的去留也成為外界關注焦點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469442.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-30 14:04", "link": "/news/story/7002/9847025"}, {"article_id": "9846993", "title": "MLB／大谷翔平帶傷拚二刀流 美媒批道奇傷勢管理「太天真」", "summary": "大谷翔平左膝受傷仍於8月重啟投球訓練，美媒批評道奇過度信任其判斷，傷勢管理恐不夠謹慎；其投打表現下滑，明年仍盼重返投手丘。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469293.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 13:58", "link": "/news/story/6999/9846993"}, {"article_id": "9847045", "title": "棒球／新竹棒球場交流賽本周末登場！市府公布觀賽攻略、交通接駁及限定好禮", "summary": "新竹市政府將於11月1日至3日舉辦「2026新竹市立棒球場50週年交流賽COMEBACK 竹風再起」，邀請台灣、日本及韓國球隊齊聚新竹，以精彩賽事迎接球場50周年。為讓民眾及全國球迷安心觀賽，市府今公布觀賽懶人包，整合入場方式、觀賽動線、交通接駁、周邊活動及限量好禮等資訊，邀請大家一同重溫棒球熱情。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469430.jpg&M=1&s=Y&x=1&y=58&sw=1167&sh=778&exp=3600&sl=W&fw=360", "date": "2026-10-30 13:57", "link": "/news/story/7001/9847045"}, {"article_id": "9847044", "title": "中職／龍隊6名奪冠成員啟程赴日 參與日職軟銀隊秋訓", "summary": "味全龍隊奪下中職總冠軍賽，今天派出6位選手以及教練團和後勤人員出發前往日本福岡，參與日職軟銀隊秋訓，持續深化與今年奪下「日本一」的軟銀隊的交流，並進行經驗分享及技術交流。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469427.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 13:57", "link": "/news/story/7001/9847044"}, {"article_id": "9847040", "title": "PLG／揚科維奇「冠名」為洋基維奇 加盟洋基工程方舟", "summary": "洋基工程方舟職業籃球隊今天宣布，正式簽下來自塞爾維亞的中鋒洋基維奇（Stefan Jankovic）。現年33歲的洋基維奇身高211公分，具備外線投射、高位策應與禁區對抗能力，使團隊戰力再升級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469414.jpg&M=1&s=Y&x=0&y=0&sw=1143&sh=762&exp=3600&sl=W&fw=360", "date": "2026-10-30 13:56", "link": "/news/story/7003/9847040"}, {"article_id": "9847012", "title": "NBA／勇士倫德伯格自認打太軟！格林提點、柯爾給機會衝撞庫明加", "summary": "勇士隊首輪第11順位新秀倫德伯格（Yaxel Lendeborg）昨天面對灰狼隊砍下26分，但也發生7次失誤，倫德伯格坦言自己打得太軟。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469344.jpg&M=1&s=Y&x=231&y=224&sw=692&sh=462&exp=3600&sl=W&fw=360", "date": "2026-10-30 13:49", "link": "/news/story/7002/9847012"}, {"article_id": "9847015", "title": "TPBL／海神重返高雄巨蛋迎主場開幕 三人氣韓援將首度亮相", "summary": "TPBL高雄全家海神職業籃球隊26-27賽季「ALL AHEAD 湧往直前」開幕周，31日及11月1日高雄巨蛋登場，11位Aqua Mermaids 全員到齊，包含3位南韓人氣啦啦隊女神柳辰京、韓志恩、李夏恩，將首度亮相帶來中場表演。高雄巨蛋首秀的還有單場寫下「40-20」聯盟新猷的洛斯柯，期待與神隊友相見歡。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469346.jpg&M=1&s=Y&x=1&y=255&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 13:48", "link": "/news/story/7003/9847015"}, {"article_id": "9846926", "title": "NBA／一場都沒打恐報銷！西蒙斯仍自比「獨角獸」：我不是普通球員", "summary": "西蒙斯季前右腳阿基里斯腱撕裂、恐整季報銷，仍自信稱有能力立足NBA，自比球場「獨角獸」；國王將協助其復健。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469150.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-10-30 13:20", "link": "/news/story/7002/9846926"}, {"article_id": "9846861", "title": "NBA／灰狼輸球還爆內訌？小鮑爾、庫明加疑怒斥戈貝爾 當事人否認不和", "summary": "灰狼在面臨愛德華（Anthony Edwards）長期缺陣的情況下，昨日以5分之差不敵勇士，不僅開季戰績下滑至3勝2敗，比賽期間更出現令人關注的板凳席爭執畫面。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469068.png&M=1&s=Y&x=0&y=37&sw=983&sh=655&exp=3600&sl=W&fw=360", "date": "2026-10-30 12:54", "link": "/news/story/7002/9846861"}, {"article_id": "9846821", "title": "MLB／今井達也執行5.8億選擇權續留太空人 旅美首季跌跌撞撞盼反彈", "summary": "今井達也預計執行1800萬美元球員選擇權，2027年續留太空人；他首季受傷勢、適應與控球不穩影響，23場防禦率4.93。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469024.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 12:48", "link": "/news/story/6999/9846821"}, {"article_id": "9846826", "title": "NBA／19歲布瑟轟大三元打退前一哥莫蘭特 灰熊開季驚奇5連勝", "summary": "開季拉出4連勝的灰熊今天作客拓荒者主場，也是他們本季與球隊前一哥莫蘭特（Ja Morant）首度交手，儘管兩隊在賽前都處在連勝狀態，但灰熊靠著年僅19歲的選秀探花布瑟（Cameron Boozer）全場猛轟18分、11籃板、12助攻，生涯首度的大三元，以124：103擊敗拓荒者，拉出5連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469040.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 12:35", "link": "/news/story/7002/9846826"}, {"article_id": "9846817", "title": "日職／甲斐拓也坦言待二軍不甘心 被交易至樂天與3台將當隊友", "summary": "日本職棒讀賣巨人隊發動交易，將前明星捕手甲斐拓也交易至樂天金鷲隊，將與宋家豪、劉致榮和陽柏翔當隊友。甲斐拓也坦言今年長期待在二軍，非常不甘心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469020.jpg&M=1&s=Y&x=0&y=0&sw=1100&sh=734&exp=3600&sl=W&fw=360", "date": "2026-10-30 12:34", "link": "/news/story/7001/9846817"}, {"article_id": "9846781", "title": "日職／巨人秋訓第一天就交易 甲斐拓轉戰樂天金鷲本人也訝異", "summary": "日職讀賣巨人隊秋訓開訓第一天，球團宣布重磅交易，透過FA來到巨人僅兩年的捕手甲斐拓也，被交易至樂天金鷲隊，回到太平洋聯盟，巨人隊則換來現金。對於這個突然的消息，甲斐拓也也坦言有點驚訝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469002.jpg&M=1&s=Y&x=81&y=0&sw=1144&sh=762&exp=3600&sl=W&fw=360", "date": "2026-10-30 12:23", "link": "/news/story/7001/9846781"}, {"article_id": "9846692", "title": "NBA／鵜鶘雙悍將成交易市場搶手貨 雷霆滿手選秀權傳可能進場", "summary": "紐奧良鵜鶘近年戰績始終未能有所突破，也讓陣中多名主力球員持續受到其他球隊關注。其中，鋒線好手墨菲（Trey Murphy III）與防守悍將瓊斯（Herb Jones），一直以來更是交易市場上的熱門目標。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35468771.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-10-30 12:06", "link": "/news/story/7002/9846692"}, {"article_id": "9846716", "title": "中職／味全龍感謝祭11月登場 11月22日下午舉辦封王大遊行", "summary": "味全龍奪下2026中職總冠軍，球團將於11月21日、22日在天母棒球場舉辦「2026味全龍球迷感謝祭」，今年以「草地音樂會」與「星空露營」為核心主軸，並在22日下午舉行封王大遊行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35468806.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-10-30 11:59", "link": "/news/story/7001/9846716"}]}, {"name": "棒球", "articles": [{"article_id": "9846781", "title": "日職／巨人秋訓第一天就交易 甲斐拓轉戰樂天金鷲本人也訝異", "date": "2026-10-30 12:23", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469002.jpg&M=1&s=Y&x=81&y=0&sw=1144&sh=762&exp=3600&w=300", "link": "/news/story/7001/9846781"}, {"article_id": "9846716", "title": "中職／味全龍感謝祭11月登場 11月22日下午舉辦封王大遊行", "date": "2026-10-30 11:59", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35468806.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9846716"}, {"article_id": "9847159", "title": "日職／西武獅放行！防禦率王平良海馬挑戰大聯盟 美媒預估身價曝光", "date": "2026-10-30 15:07", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469727.jpg&M=1&s=Y&x=0&y=43&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9847159"}, {"article_id": "9847104", "title": "中職／悍將連兩年安排林哲瑄赴日進修 擔任火腿二軍秋訓研習教練", "date": "2026-10-30 14:29", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469526.jpg&M=1&s=Y&x=1&y=300&sw=1107&sh=738&exp=3600&w=300", "link": "/news/story/7001/9847104"}, {"article_id": "9847075", "title": "棒球／花蓮光復災後一年 球芽基金持續送暖陪伴孩子走過重建之路", "date": "2026-10-30 14:10", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35469471.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/7001/9847075"}]}, {"name": "MLB", "articles": [{"article_id": "9846449", "title": "MLB／鄭宗哲被紅襪交易至老虎 有望與李灝宇組台灣內野搭檔", "date": "2026-10-30 10:30", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/20/35