ttps://uc.udn.com.tw/photo/t3/2026/07/08/35118014.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 23:16", "link": "/news/story/7001/9616106"}, {"article_id": "9616003", "title": "中職／岳政華單場雙安3打點 兄弟7：5勝獅隊止敗", "summary": "中信兄弟今天繼續在台南亞太棒球場作客，打線手感回溫，全場共掃出12支安打，在比賽前段就打下4分大局，雖一度遭逆轉，但在7局上成功要回領先，再靠牛棚合力守成，最終以7：5擊敗統一獅隊，終止近期2連敗，岳政華單場雙安3打點，拿下單場MVP 。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117873.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-08 22:01", "link": "/news/story/7001/9616003"}, {"article_id": "9615993", "title": "中職／陳克羿6.1局6K無失分率桃猿收3連勝 悍將吞本季首次4連敗", "summary": "樂天桃猿隊今天客場出戰富邦悍將隊，陳克羿與洋投威戈神同場較勁，表現絲毫不遜色，繳出6.1局無失分的出色表現，靠著猿隊打線在7局上攻進關鍵分，在這場投手戰中以1：0打下勝利，下半季收下3連勝；悍將隊則是吞下本季首次4連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117904.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 21:59", "link": "/news/story/7001/9615993"}, {"article_id": "9615753", "title": "中職／獅隊周三「下班歇歇席」獲好評 「塔吊哥」結束高空任務來開球", "summary": "統一7-ELEVEN獅隊今天在亞太成棒主球場迎戰中信兄弟，適逢周三，球團針對上班族球迷特別推出「下班歇歇席」，每場將近200席座位，開賣之後均搶購完畢，賽前還邀請獅迷「塔吊哥」鄭忠祥替賽事揭開序幕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117655.jpg&M=1&s=Y&x=0&y=547&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 19:34", "link": "/news/story/7001/9615753"}, {"article_id": "9615646", "title": "中職／經歷大傷重返職棒 桃猿新洋砲道威聖要忍住不哭", "summary": "樂天桃猿外籍打者道威聖今天迎接中華職棒初登場，出戰富邦悍將隊擔任先發第3棒、左外野手，回憶起先前遇到大傷以為棒球人生就此...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117593.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 18:39", "link": "/news/story/7001/9615646"}, {"article_id": "9615643", "title": "世足賽／比利時粉色球衣搶眼 設計源於超現實主義畫作", "summary": "比利時在2026年世界盃足球賽穿著的客場球衣以淺藍與粉紅做出罕見搭配，在綠茵球場上相當顯眼。這款球衣以超現實主義畫家馬格...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117578.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-08 18:37", "link": "/news/story/123107/9615643"}, {"article_id": "9615546", "title": "中職／轉戰悍將首安球放在醒目處 林岱安拿來提醒自己", "summary": "經歷19個打數的掙扎，中職捕手林岱安昨天終於敲出轉戰富邦悍將隊的第1支安打，看到隊友幫他要回的首安球，平常不太收藏紀念球...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117559.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 18:20", "link": "/news/story/7001/9615546"}, {"article_id": "9615588", "title": "世足賽／梅西、C 羅、哈蘭德居Yahoo運動熱搜球星前三 維德角成最受關注國家", "summary": "2026全球足球盛會16強賽結束，黑馬「維德角」成為關注焦點，搜尋熱度超越多個傳統勁旅。同時，Yahoo運動推出互動遊戲「PK 吧！魔王」，增強球迷觀賽體驗，實時報導將伴隨賽事進入8強階段。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117552.jpg&M=1&s=Y&x=0&y=0&sw=1224&sh=816&exp=3600&sl=W&fw=360", "date": "2026-07-08 18:18", "link": "/news/story/123107/9615588"}, {"article_id": "9615515", "title": "棒球／「四國菁英對抗賽」中華隊名單揭曉 許庭綸等6名中職新秀參戰", "summary": "第一屆四國菁英對抗賽將在7月11至15日在台中洲際棒球場展開，中華隊派出亞運培訓隊參賽，名單也在今天揭曉，以業餘及大學球員為主體外，今年選秀首輪獲指名的大學投手陳趙羿勳也入列，還有包括許庭綸、曾聖安等6名中職年輕野手參賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117423.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-08 17:36", "link": "/news/story/7001/9615515"}, {"article_id": "9615459", "title": "籃球／雷蒙恩努力復健拚亞運國手 先和跆拳道「國民女友」學兩招", "summary": "5月因腳趾過度伸展造成韌帶撕裂，讓籃球好手雷蒙恩無緣參與中華隊世界盃亞洲區資格賽第三階段，看到中華隊淘汰讓他直呼難過，現在只盼腳趾傷勢快恢復，9月名古屋亞運能披上國手戰袍，登上目標殿堂。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117336.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 17:10", "link": "/news/story/7003/9615459"}, {"article_id": "9615378", "title": "MLB／史肯斯虧「太自私」！歐赫恩10打點神紀錄 頭盔獲名人堂典藏", "summary": "海盜今天以12：4擊敗勇士，歐赫恩（Ryan O'Hearn）上演生涯代表作，單場5打數4安打、狂轟3發全壘打，灌進10分打點，不僅成為海盜隊史首位單場10打點的球員，也讓王牌投手史肯斯（Paul Skenes）開玩笑表示歐赫恩「有點自私」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117327.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 16:55", "link": "/news/story/6999/9615378"}, {"article_id": "9615381", "title": "溫網／39歲偉大球星同天創奇蹟！約克維奇羨慕梅西：只有90分鐘很棒", "summary": "塞爾維亞網球名將約克維奇（Novak Djokovic）和阿根廷足球天王梅西（Lionel Messi），都在今天以39歲年齡，再次創造體壇奇蹟。約克維奇在溫布頓網球公開賽8強戰後，談到梅西時笑稱，如果網球只打90分鐘就好。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117252.jpg&M=1&s=Y&x=69&y=205&sw=1130&sh=754&exp=3600&sl=W&fw=360", "date": "2026-07-08 16:43", "link": "/news/story/124935/9615381"}, {"article_id": "9615372", "title": "空手道／三度出征亞運 辜翠萍：目標超越上屆銀牌成績", "summary": "2014年首度參加亞運就在仁川一舉奪金，台灣空手道好手辜翠萍名古屋亞運將第三度出征，她笑說：「目標比上屆更上一層樓。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117239.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 16:37", "link": "/news/story/7005/9615372"}, {"article_id": "9615343", "title": "2026新北市耶誕馬拉松接力賽 早鳥開搶7月9日上午10時開放報名", "summary": "「耶誕快追！2026新北市耶誕馬拉松接力賽」，將於12月6日在新北市民廣場登場，新北市觀旅局指出，今年活動全面升級，包含限量早早鳥報名8折優惠、早鳥報名送限量保溫杯、接力信物耶誕鈴鐺繽紛續響、街頭人氣變裝組，將創意變獎金。另紀念跑衣、耶誕毛帽、完賽提袋、完賽毛巾等設計均結合耶誕氛圍作為整體設計。接力賽7月9日上午10時開放報名。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117182.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 16:24", "link": "/news/story/7005/9615343"}, {"article_id": "9615326", "title": "霹靂舞／從扯鈴隊到亞運國手 許馥雅期待出征名古屋", "summary": "8歲接觸霹靂舞，下月要滿20歲的許馥雅今年將出征名古屋亞運，她盼能像奪下巴黎奧運金牌的日本偶像「Ami」湯淺亞實，在國際賽場綻放光芒。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117159.jpg&M=1&s=Y&x=0&y=0&sw=1194&sh=796&exp=3600&sl=W&fw=360", "date": "2026-07-08 16:17", "link": "/news/story/7005/9615326"}, {"article_id": "9615264", "title": "MLB／洋基連2場吞17K破美聯紀錄！布恩：總會遇到被壓制的夜晚", "summary": "洋基隊今天以4：6輸給光芒隊，全場苦吞17次三振，成為美聯史上首支球隊，連2場9局比賽都至少被三振17次。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117095.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 16:08", "link": "/news/story/6999/9615264"}, {"article_id": "9615219", "title": "世足賽／梅西衛冕路受惠賽程？阿根廷對手平均世界排名8強最低", "summary": "2026年世界盃16強賽今天全部落幕，阿根廷靠著梅西（Lionel Messi）1射1傳，克服兩球落後劣勢，以3：2逆轉擊敗埃及，驚險挺進8強。不過，根據外媒統計，阿根廷本屆世界盃一路走來的賽程難度，是8強球隊中最低。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35117016.jpg&M=1&s=Y&x=15&y=0&sw=1099&sh=733&exp=3600&sl=W&fw=360", "date": "2026-07-08 15:45", "link": "/news/story/123107/9615219"}, {"article_id": "9615159", "title": "MLB／山本由伸耐戰秘訣曝光？貝茲透露春訓親自拜師學習訓練方式", "summary": "道奇當家游擊手貝茲（Mookie Betts）近日在個人Podcast節目中，大讚隊友山本由伸的穩定性與耐戰度，直言自己從未看過有投手能在長時間維持健康的同時，還能持續繳出如此頂尖的表現。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116932.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-08 15:19", "link": "/news/story/6999/9615159"}, {"article_id": "9615148", "title": "MLB／道奇教頭看好大谷500轟！挨第300轟的投手：我故意被轟", "summary": "大谷翔平今天從前隊友羅倫佐（Michael Lorenzen）手中轟出生涯第300發全壘打，羅倫佐賽後開玩笑表示，「我故意的。」道奇總教練羅伯茲（Dave Roberts）則看好大谷，未來能完成500轟里程碑。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116915.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 15:14", "link": "/news/story/6999/9615148"}, {"article_id": "9614973", "title": "MLB／皇家守備亂成一鍋粥！投手前滾地球變「少棒全壘打」", "summary": "大都會隊今天在主場迎戰皇家隊，1局下班吉（Carson Benge）靠著皇家守備亂成一鍋粥，擊出「少棒式全壘打」。這場比賽形成打擊大戰，大都會以12：16輸球，創隊史首見不名譽紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116566.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 14:14", "link": "/news/story/6999/9614973"}, {"article_id": "9614947", "title": "世足賽／8強賽前挪威出現感冒潮！ 總教練怪罪空調、飛機惹禍", "summary": "2026年世界盃8強賽將於台灣時間7月12日凌晨5點登場，「維京軍團」挪威將迎戰「三獅軍團」英格蘭。不過，挪威賽前卻傳出隊內出現感冒症狀，總教練索爾巴肯（Ståle Solbakken）透露，球隊有多名球員及工作人員出現咳嗽、喉嚨沙啞等情況，而頻繁搭機與長途移動，可能是造成身體不適的原因之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116494.jpg&M=1&s=Y&x=0&y=0&sw=1245&sh=830&exp=3600&sl=W&fw=360", "date": "2026-07-08 14:07", "link": "/news/story/123107/9614947"}, {"article_id": "9614856", "title": "NBA／勇士為了詹皇不匹配報價！荷蘭中鋒轉戰灰熊當周志豪替補", "summary": "荷蘭中鋒波斯特（Quinten Post）是受限制自由球員，日前接受灰熊隊3年3000萬美元合約報價。據ESPN報導，勇士隊選擇不匹配，因此他確定轉戰灰熊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116345.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 13:32", "link": "/news/story/7002/9614856"}, {"article_id": "9614851", "title": "世足賽／質疑川普介入禁賽關說 歐洲議員怒批FIFA要求徹查主席", "summary": "世足賽賽場外掀起政治干預風暴，國際足球總會（FIFA）主席英凡提諾（Gianni Infantino）日前因暫緩美國隊前鋒巴洛根（Folarin Balogun）的紅牌禁賽令，遭質疑是受到美國總統川普（Donald Trump）施壓。對此，數十名歐洲議會議員正串聯發起調查，痛批FIFA此舉破壞運動公平性，「簡直是向川普政府低頭」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35116346.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-08 13:30", "link": "/news/story/123107/9614851"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9614231", "title": "世足賽／8強對戰賽程出爐！法國強碰「北非雄獅」 阿根廷拚衛冕壓軸迎戰瑞士", "date": "2026-07-08 10:50", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115434.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9614231"}, {"article_id": "9614048", "title": "世足賽／梅西拯救阿根廷 隊友讚「世界最佳球員」", "date": "2026-07-08 09:24", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115041.jpg&M=1&s=Y&x=0&y=0&sw=1261&sh=841&exp=3600&w=300", "link": "/news/story/123107/9614048"}, {"article_id": "9614576", "title": "世足賽／外媒統計8強球隊籤表難度 阿根廷最低、挪威最高", "date": "2026-07-08 12:04", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/08/35115908.jpg&M=1&s