d": "9741923", "title": "國聯塞揚獎還有懸念！37歲「拍賣哥」塞爾球速為何能再進化？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/08/35308375.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9741923"}, {"article_id": "9741856", "title": "日職／軟銀一指魔咒？醜聞頻傳多人離隊 前田悠伍成唯一亮點", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35310719.jpg&M=1&s=Y&x=0&y=107&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9741856"}, {"article_id": "9740130", "title": "被評為今夏最糟操作之一 塞爾蒂克拆雙槍是聰明還是沒得選？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/07/35305747.jpg&M=1&s=Y&x=0&y=138&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9740130"}]}, {"name": "最新文章", "articles": [{"article_id": "9747542", "title": "新聞眼／改革體壇 李洋不能只當救火員", "summary": "運動部去年九月九日掛牌上路，並由高人氣的「金牌部長」李洋掌舵，當時各界無不期盼這股新氣象能撕下傳統體育署時代的弊病標籤。但一年飛逝，回頭檢視周年成績單，體育行政與各單項協會卻依然陷在「出包、澄清、再檢討」的惡性循環，讓當初改革熱情漸被現實磨耗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-09-11 00:01", "link": "/news/story/7005/9747542"}, {"article_id": "9747539", "title": "體操選手世錦賽「被棄賽」 家屬告體操協會秘書長背信", "summary": "屏東體操選手潘采宸、李佳蔚取得今年荷蘭世界競技體操錦標賽參賽機會，體操協會在未告知選手及教練下回覆放棄。民進黨立委徐富癸昨偕選手家屬赴屏東地檢署，按鈴告發體協秘書長江建東涉嫌背信罪。潘采宸阿嬤蔡玉華說，她不懂體協長官為何這麼做？她有太多心酸，提告就是嚥不下這口氣，一定幫孫子討公道，「體協敢做就要敢承擔」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316667.jpg&M=1&s=Y&x=0&y=0&sw=1277&sh=851&exp=3600&sl=W&fw=360", "date": "2026-09-11 00:00", "link": "/news/story/7005/9747539"}, {"article_id": "9747304", "title": "中職／布雷克主宰戰場讓兄弟掛零 57勝超越王漢獨居獅隊洋投第1", "summary": "統一獅隊作客台中洲際球場，洋投布雷克今天對中信兄弟隊先發7局無失分，優質表現幫助獅隊6：0獲勝，奪下本季第7勝、生涯第57勝，獲選單場MVP，超越傳奇洋投王漢，獨居隊史最多勝外籍投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316499.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 21:28", "link": "/news/story/7001/9747304"}, {"article_id": "9747094", "title": "亞運棒球／總教練預想最壞場景 點名陳敏賜待命當第3號捕手", "summary": "名古屋亞運棒球中華隊陣中僅2名捕手，總教練湯登凱預想最壞場景，若需要第3號捕手上場，隊長陳敏賜是優先選擇，朱迦恩也具蹲捕...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316404.jpg&M=1&s=Y&x=0&y=35&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-10 20:39", "link": "/news/story/124981/9747094"}, {"article_id": "9747190", "title": "排球／登峰造極上海格致中學還在適應 中山工商直落三贏得首勝", "summary": "2026登峰造極青年排球邀請賽今天賽程，高中女子組的中山工商和上海格致中學昨天休兵，今天都是首戰。兩岸勁旅交鋒，中山工商最終以25：22、25：14、25：21拿下首勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316361.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 20:19", "link": "/news/story/7005/9747190"}, {"article_id": "9747033", "title": "亞運棒球／打國際賽是榮譽 陳晨威：彌補學生時期沒打過", "summary": "2026年愛知‧名古屋亞運會開幕倒數，我國棒球隊目前仍在國訓中心進行最後備戰，5名中職球員今天正式報到展開集訓，其中樂天桃猿隊陳晨威今年繼經典賽後再次為國效力，他說：「打國家隊就是一個榮譽，算是彌補我學生時期沒打過國家隊。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316164.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 18:47", "link": "/news/story/124981/9747033"}, {"article_id": "9746970", "title": "棒球／日本九州亞洲聯盟選拔隊來訪 對台3場交流賽誓言3連勝", "summary": "2026台日棒球國際交流賽明起在台南市亞太棒球場副球場開打，日本九州亞洲聯盟選拔隊集結5支球隊精英，將和全越運動、南市成棒、台電隊交手，今天在賽前訂下3連勝目標，球隊代表也向台灣致謝：「感謝台灣人在熊本大地震後第一時間的援助！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35316074.jpg&M=1&s=Y&x=0&y=0&sw=1275&sh=850&exp=3600&sl=W&fw=360", "date": "2026-09-10 18:19", "link": "/news/story/7001/9746970"}, {"article_id": "9746900", "title": "亞運棒球／黃韋盛國家隊初體驗 平野惠一特別提點：想像我隨時在身邊", "summary": "中信兄弟內野手黃韋盛獲徵召參與今年愛知・名古屋亞運，也是他生涯首次披上國家隊戰袍，與大學時的教頭湯登凱再續前緣。向中華隊報到之前，母隊中信兄弟總教練平野惠一特別向他提點一番，並告訴他「要想像我隨時都在身邊」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315960.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:46", "link": "/news/story/124981/9746900"}, {"article_id": "9746830", "title": "美網／打到半夜顧人願 小蠻牛團隊批評：一點也不健康", "summary": "挑戰美網連霸的西班牙「小蠻牛」阿爾卡拉斯（Carlos Alcaraz）昨天男單八強賽但地主謝爾頓（Ben Shelton）激戰五盤，謝爾頓最後發出「再見愛司」淘汰衛冕軍時，當地時間已經是凌晨3點33分，寫下賽史最晚結束紀錄。儘管現場仍有許多觀眾為兩位選手歡呼，但今年頻繁出現的跨日大戰也飽受詬病，阿爾卡拉斯團隊更直批如此狀況「不健康」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315884.jpg&M=1&s=Y&x=0&y=38&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:27", "link": "/news/story/121623/9746830"}, {"article_id": "9746806", "title": "亞運棒球／劉基鴻扛國家隊4棒 最想對決和遇到的都是「古林的朋友」", "summary": "中華隊在今年愛知名古屋亞運爭取暌違20年的亞運棒球金牌，5名中職球員今天正式報到，其中味全龍隊三壘手劉基鴻也被教練團點名，將扛起中華隊的第4棒，對此他笑說：「不陌生，但是滿困難的。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315808.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:13", "link": "/news/story/124981/9746806"}, {"article_id": "9746780", "title": "NBA／上季膝傷只打2場就報銷 勇士簽回22歲澳洲前鋒圖希", "summary": "據勇士隨隊記者史雷特（Anthony Slater）報導，勇士將和22歲澳洲前鋒圖希（Alex Toohey）簽下Exhibit 10合約，將在季前訓練營爭取正式合約名額。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315762.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 17:03", "link": "/news/story/7002/9746780"}, {"article_id": "9746740", "title": "金門馬拉松休閒組來了！9/16五鄉鎮同步報名 限額400名額滿為止", "summary": "眾所矚目的「2027第20屆金門馬拉松」將於明年1月16日登場，為方便服務不熟悉網路報名的鄉親、長輩參加，金門縣政府協調五鄉鎮公所設置現場報名服務台，9月16日上午10時至下午4時同步受理休閒組報名，中午不休息，限額400名，額滿即止。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315721.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 16:50", "link": "/news/story/7005/9746740"}, {"article_id": "9746679", "title": "亞運棒球／遭釋出曾閃過最壞念頭... 劉致榮想證明能健康回到投手丘", "summary": "27歲旅外投手劉致榮因傷兩年沒有登板，今年6月遭紅襪隊釋出，告別6年半的旅美生涯，返台後加入亞運中華隊集訓，並靠好表現遞補進入正選名單。連續兩屆亞運參賽，比起想證明自己的能力，他說：「只想證明我是可以健康地回到投手丘上。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315853.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 16:27", "link": "/news/story/124981/9746679"}, {"article_id": "9746630", "title": "TPBL／許時清加入戰神 和南山幫學生再合體", "summary": "昨天才和新北中信特攻隊正式「分手」的教練許時清，今天新東家就出爐，台北台新戰神隊宣布許時清加入教練團，擔任球隊的助理教練。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315527.jpg&M=1&s=Y&x=1&y=78&sw=1143&sh=762&exp=3600&sl=W&fw=360", "date": "2026-09-10 16:09", "link": "/news/story/7003/9746630"}, {"article_id": "9746600", "title": "MLB／洋基沃爾普「變成邦茲」重返大聯盟 隆巴德：我不尷尬", "summary": "洋基隊當家二壘手奇森姆（Jazz Chisholm Jr.）因右手拇指扭傷，進10天傷兵名單，因此決定將從3A拉上「變成邦茲」的沃爾普（Anthony Volpe）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315480.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 16:02", "link": "/news/story/6999/9746600"}, {"article_id": "9746576", "title": "亞運棒球／中職球員報到！ 中華隊備妥旅外雙先發+火球後援", "summary": "備戰愛知名古屋亞運棒球賽，中華隊要力拚暌違20年的金牌，面對最多6場的賽事，中華隊投手安排已有規畫，每場備妥「雙先發」，人選包括旅外投手林昱珉、王彥程、劉致榮、徐翔聖及黃仲翔，後援則交給「火球男」潘文輝及業餘速球男王宇傑、王政浩。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315736.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-09-10 15:52", "link": "/news/story/124981/9746576"}, {"article_id": "9746542", "title": "馬英九告別日月潭泳渡12度參賽成句點 76歲日本泳者接棒", "summary": "前總統馬英九去年完成第12度日月潭萬人泳渡，今年卻確定缺席。南投縣政府表示，今年報名已截止，馬英九方面始終未主動聯繫，確定不會參加，也讓他連續多屆參與的泳渡紀錄暫告一段落。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315393.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 15:34", "link": "/news/story/7005/9746542"}, {"article_id": "9746512", "title": "MLB／山本由伸勝投秘訣包括泡熱水澡 節制飲食但想吃紅豆麵包", "summary": "山本由伸今天對紅人隊先發7局失1分，優質表現奪下本季第13勝，締造個人單季最多勝紀錄，幫助道奇隊14：1獲勝，拚出7連勝，賽後談到投球表現，他說：「沒有做什麼特別改變，就像往常一樣，專注每一局投球。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315365.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 15:25", "link": "/news/story/6999/9746512"}, {"article_id": "9746510", "title": "排球／企業、台體聯手 三福產業男排進軍企業聯賽", "summary": "三福產業集團與台灣體大今天舉行「三福產業男子排球隊（SUNFORD Volleyball Team）」成軍記者會，正式進軍新賽季企業排球聯賽，球隊以實力堅強的臺體大男排為班底，結合校方運動產業學院跨系所營運資源，打造臺灣首座「大學型企業排球品牌」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315339.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 15:24", "link": "/news/story/7005/9746510"}, {"article_id": "9746494", "title": "NBA／執行球員選項仍可能被賣掉 美媒：拉文不在國王未來藍圖", "summary": "國王明星扣將拉文（Zach LaVine）日前執行最後一年高達4897萬美元（約台幣15.4億）的球員選項，決定續留母隊，不過《ESPN》記者溫德霍斯特（Brian Windhorst）與麥克馬洪（Tim MacMahon）近期在《The Hoop Collective》節目中直言，這位31歲後衛絕對不在沙加緬度的未來藍圖，甚至會成為季中買斷的大人門人選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315330.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 15:20", "link": "/news/story/7002/9746494"}, {"article_id": "9746425", "title": "NBA／「英雄哥」風波不斷！赫洛傳與模特兒女友分手 雙方告上法院爭奪扶養權", "summary": "休賽季被熱火交易至公鹿的後衛赫洛（Tyler Herro）風波不斷，6月才因與前隊友阿德巴約（Bam Adebayo）發生肢體衝突受外界關注，根據《TMZ》報導，近日這位明星射手又因與女友亨利（Katya Elise Henry）分手鬧上法庭，展開爭奪子女監護權的官司。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315219.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-10 14:56", "link": "/news/story/7002/9746425"}, {"article_id": "9746406", "title": "MiLB／好慘！道奇狄亞茲復健賽控球又壞掉 0.2局失1分", "summary": "狄亞茲（Edwin Diaz）休賽季以3年6900萬美元合約加盟道奇隊，卻繳出防禦率11.85的慘澹成績，8月19日因傷進傷兵名單，今天在3A復健賽控球又崩盤，0.2局丟1分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/10/35315187.jpg&M=1&s=Y&x=478&y=49&sw=767&sh=512&exp=3600&sl=W&fw=360", "date": "2026-09-10 14:54", "link": "/news/story/6999/9746406"}, {"article_id": "9746419"