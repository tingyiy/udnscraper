{"全球": {"slider": [{"article_id": "9776674", "title": "川習會 美中貿易休兵延長2個月", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362302.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/125026/9776674"}, {"article_id": "9776750", "title": "24日川習會結束 川普讚會面很棒", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362434.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/125026/9776750"}, {"article_id": "9776578", "title": "Fed官員放鷹 推高升息預期…市場押注下月再出手機率升至77.5%", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35245997.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600", "link": "/news/story/6811/9776578"}, {"article_id": "9776525", "title": "OpenAI傳推「龍蝦」 點火新需求…挹注鴻海、廣達等動能", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312166.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/6811/9776525"}, {"article_id": "9776666", "title": "魯比歐談對台軍售：美須考量全球需求", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362295.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/125026/9776666"}, {"article_id": "9776635", "title": "美中兩強求穩 習近平稱雙方是夥伴非對手", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362260.jpg&M=1&s=Y&x=0&y=28&sw=1238&sh=825&exp=3600", "link": "/news/story/125026/9776635"}], "subsections": [{"name": "最新文章", "articles": [{"article_id": "9776621", "title": "川習會登場AI管控聚焦 雙方將進一步討論安全、科技、貿易等議題", "summary": "中國大陸國家主席習近平在美東時間23日傍晚抵達美國，展開三天的國是訪問，習近平與美國總統川普24日在白宮的歡迎儀式上，均強調美中關係的重要性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362237.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:52", "link": "/news/story/125026/9776621"}, {"article_id": "9776578", "title": "Fed官員放鷹 推高升息預期…市場押注下月再出手機率升至77.5%", "summary": "最新商業活動指標顯示美國9月經濟強勁，再加上通膨壓力日增，交易員已紛紛加碼押注美國聯準會（Fed）將在10月下旬決策會議上，連續第二次升息，市場押注聯準會10月升息的機率為77.5%。紐約聯準銀行總裁威廉斯等Fed重要官員，也陸續放鷹。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35245997.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:48", "link": "/news/story/6811/9776578"}, {"article_id": "9776591", "title": "美債拋售潮 殖利率衝高", "summary": "美債出現拋售潮，美國30年期公債殖利率升至5.44%，為2004年來最高，這股賣壓也蔓延至亞洲，日本10年期公債殖利率升至30年來最高，全球公債平均殖利率也逼近2007年以來首見的4%。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_9.jpg", "date": "2026-09-25 02:45", "link": "/news/story/6811/9776591"}, {"article_id": "9776579", "title": "習近平：中美競爭有度分歧可控 可以相互成就、造福世界", "summary": "中國大陸國家主席習近平專機於台灣時間24日凌晨5時40分降落在華府近郊的安德魯聯合基地，對美國展開時隔11年的國是訪問。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362210.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:42", "link": "/news/story/125026/9776579"}, {"article_id": "9776593", "title": "安排沒共識 陸企未隨行川習會", "summary": "中國大陸國家主席習近平抵達華盛頓。訪美前，外界一度傳出比亞迪、寧德時代及小米等企業高層可能隨行，惟預期中的大型商團未見成行，多家外媒指出，中美對相關安排存在分歧。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_0.jpg", "date": "2026-09-25 02:40", "link": "/news/story/125026/9776593"}, {"article_id": "9776584", "title": "美財長貝森特宣布 貿易戰休兵再延兩個月", "summary": "美國財政部長貝森特宣布，美中同意將延長貿易戰休兵期兩個月，從原本的今年11月10日，延至明年1月10日，比先前媒體報導的六個月更短。中國大陸國家主席習近平已抵達華府，展開11年來首見的訪美國是訪問，美國總統川普親自接機，為24日的會談揭開序幕。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35358758.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:40", "link": "/news/story/125026/9776584"}, {"article_id": "9776597", "title": "美軍跪地擦紅毯", "summary": "中國大陸國家主席習近平攜夫人彭麗媛抵達華府展開三天國是訪問，就在習近平步出專機前，多名美軍人員跪在地上緊急整理、擦拭紅毯畫面曝光後，迅速在美國社群瘋傳，引發部分網友反彈，甚至有人直呼「太丟臉」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362221.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:37", "link": "/news/story/125026/9776597"}, {"article_id": "9776581", "title": "台灣提防再成川普籌碼 專家點出兩大因素", "summary": "川習會登場，美國總統川普期待中國大陸國家主席習近平到訪，能為共和黨在11月的期中選舉贏得選票，由此也讓朝野憂心，台灣是否再次成為川普運用的籌碼。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/31/35188877.png&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:36", "link": "/news/story/125026/9776581"}, {"article_id": "9776595", "title": "魯比歐：軍售不能只看台灣", "summary": "美國國務卿魯比歐表示，軍售不能只看台灣，美方還必須考量自身在全球各地的軍事需求，以及美國的工業產能與國防工業基礎。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_5.jpg", "date": "2026-09-25 02:35", "link": "/news/story/125026/9776595"}, {"article_id": "9776588", "title": "川習二會 華府罕見高規格接待", "summary": "中國大陸國家主席習近平台灣時間24日凌晨抵達華盛頓，美國總統川普給予習近平罕見高規格接待。紐約時報報導，在習近平到訪前數周，北京在多個議題被指損害美國利益，包括中國企業向伊朗提供衛星影像，以及持續與伊朗維持商業往來。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_3.jpg", "date": "2026-09-25 02:35", "link": "/news/story/125026/9776588"}, {"article_id": "9776522", "title": "Muse Charm驚艷 享受隨時互動", "summary": "Meta本次「Connect大會」發表的產品當中，以掌上型裝置Muse Charm最讓人驚艷。Muse Charm主打讓使用者不必戴上智慧眼鏡，也能隨時與Muse AI助理互動。這款產品外型小巧，設計風格讓人聯想到1990年代的電子寵物，Meta執行長祖克柏形容，這是與Muse對話最快速、最直接的方式之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_0.jpg", "date": "2026-09-25 02:15", "link": "/news/story/6811/9776522"}, {"article_id": "9776525", "title": "OpenAI傳推「龍蝦」 點火新需求…挹注鴻海、廣達等動能", "summary": "OpenAI傳出將推出以OpenClaw為基礎打造的AI代理工具，內部代號暫訂為「Codex Bot」，後續將成為進攻AI代理市場的新利器，最快有望在一周內亮相。法人看好，OpenAI端出新AI代理產品，將催動算力需求持續增溫，鴻海、廣達、緯創等協力廠接單動能同步看俏。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/09/35312166.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:11", "link": "/news/story/6811/9776525"}, {"article_id": "9776527", "title": "Agent應用服務 成新戰場", "summary": "Meta最新AI代理工具Muse掀起全球新一波AI代理熱潮，OpenAI傳出有意推出新產品迎戰之際，SpaceXAI的Grok Bot用戶數也持續成長，Google AI Agent產品則在企業端市場正大展身手，顯示AI代理應用成為AI廠商的新賽道。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_4.jpg", "date": "2026-09-25 02:10", "link": "/news/story/6811/9776527"}, {"article_id": "9776756", "title": "習近平敦促川普慎重處理台灣問題 堅持「反對台獨」立場", "summary": "今年第二度川習會於美東時間24日上午在白宮登場，大陸國家主席習近平與美國總統川普會談時提及台灣問題，他敦促美方堅持「反對台獨」立場，慎重處理台灣問題。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362449.jpg&M=1&s=Y&x=28&y=38&sw=1224&sh=815&exp=3600&sl=W&fw=360", "date": "2026-09-25 02:08", "link": "/news/story/6809/9776756"}, {"article_id": "9776750", "title": "24日川習會結束 川普讚會面很棒", "summary": "美國總統川普24日在白宮和中國大陸國家主席習近平舉行會談。路透同日報導，兩位領袖會面後，川普表示，他與習近平有1場「很棒的會面」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362434.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-25 01:55", "link": "/news/story/125026/9776750"}, {"article_id": "9776554", "title": "全球債務365兆美元新高 上半年增逾10兆美元…新興市場占大宗", "summary": "國際金融研究所（IIF）最新報告指出，新興市場債務暴增，使全球債務上半年增加逾10兆美元，達到破紀錄的365兆美元。這份報告並指出，目前人工智慧（AI）相關投資尚未排擠公債，但終將推升長債殖利率。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362187.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-25 01:49", "link": "/news/story/6811/9776554"}, {"article_id": "9776550", "title": "英代幣化存款完成跨行交易", "summary": "英國主要銀行完成全球首批利用代幣化存款進行銀行間轉帳的交易，代表區塊鏈技術從銀行內部測試進一步跨越至金融機構之間的實際應用。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_1.jpg", "date": "2026-09-25 01:46", "link": "/news/story/6811/9776550"}, {"article_id": "9776547", "title": "伊朗對美放狠話…油價上漲 華府擬減少柴油出口", "summary": "伊朗總統在聯大發表演說時，雖然對談判持開放態度，但揚言不會向美國屈服。法斯通訊社（Fars）則報導，伊朗的一名軍事顧問表示，若美國或以色列再次發動攻擊，德黑蘭可能會將這場戰事擴大至印度洋，這些言論削弱了市場的樂觀情緒，引發國際油價上漲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362181.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-25 01:46", "link": "/news/story/124061/9776547"}, {"article_id": "9776552", "title": "白宮擬推海外美元穩定幣", "summary": "彭博資訊報導，知情人士透露，美國政府正考慮推動一項計畫，促進以美元計價的穩定幣在海外的使用，以鞏固美元作為全球準備貨幣的地位，同時提振美國公債的需求。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_4.jpg", "date": "2026-09-25 01:45", "link": "/news/story/6811/9776552"}, {"article_id": "9776560", "title": "全球第一樁…AI代理驚爆駭進政府網站 加深外界擔憂潛在風險疑慮", "summary": "OpenAI一個AI代理6月入侵澳洲政府醫療服務網站，但8月才偵測到、9月才通知澳洲政府，成為最新一起涉及AI的高知名度資安事件，也是目前首例已知AI代理入侵政府網站。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362194.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-25 01:41", "link": "/news/story/6811/9776560"}, {"article_id": "9776562", "title": "美資料中心投資占比衝高", "summary": "美國AI資料中心投資熱潮占國內生產毛額（GDP）比率將超越鐵公路建設、電氣化和網際網路建設，成為史上最大押注，影響所及，牽動經濟、就業與物價。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_3.jpg", "date": "2026-09-25 01:41", "link": "/news/story/6811/9776562"}, {"article_id": "9776561", "title": "賓利推純電車叫陣法拉利 瞄準年輕族群荷包", "summary": "賓利（Bentley）推出首款純電車Torcal，以比法拉利電動車低逾六成的起價，爭取年輕及首次購買賓利的顧客。Torcal是賓利第四款車系，也是目前價格最低的車款。這輛純電休旅車在英國售價從17.33萬英鎊（約新台幣730萬元）起，續航里程最長約600公里；法拉利5月推出的首款電動車Luce，起價則為55萬歐元，約47.2萬英鎊（約新台幣1,989萬元）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362195.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-25 01:41", "link": "/news/story/6811/9776561"}, {"article_id": "9776565", "title": "歐洲電動車 買氣噴發", "summary": "地緣政治衝擊觸動歐洲汽油價格漲到每加侖10美元，讓多年來買氣疲弱的電動車銷售為之一振，抵銷汽油和柴油車銷量銳減對車市的衝擊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7225_7.jpg", "date": "2026-09-25 01:40", "link": "/news/story/6811/9776565"}, {"article_id": "9776634", "title": "川習會登場前…美中經貿磋商 達多項共識", "summary": "川習二會廿四日登場前，大陸國務院副總理何立峰與美國財政部長貝森特分別於廿日與廿三日在紐約與華盛頓舉行會談。大陸商務部昨表示，中美兩國經貿團隊在美國舉行第八輪經貿磋商，圍繞落實已有共識、對等降稅等議題達成「多項共識」，雙方還在經貿磋商機制下首次就人工智慧（ＡＩ）展開對話。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362424.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-25 01:34", "link": "/news/story/125026/9776634"}]}, {"name": "川習二會聚焦", "articles": [{"article_id": "9776674", "title": "川習會 美中貿易休兵延長2個月", "date": "2026-09-25 00:09", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362302.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/125026/9776674"}, {"article_id": "9776750", "title": "24日川習會結束 川普讚會面很棒", "date": "2026-09-25 01:55", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362434.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/125026/9776750"}, {"article_id": "9776666", "title": "魯比歐談對台軍售：美須考量全球需求", "date": "2026-09-25 01:14", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362295.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/125026/9776666"}, {"article_id": "9776635", "title": "美中兩強求穩 習近平稱雙方是夥伴非對手", "date": "2026-09-25 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362260.jpg&M=1&s=Y&x=0&y=28&sw=1238&sh=825&exp=3600&w=300", "link": "/news/story/125026/9776635"}, {"article_id": "9776637", "title": "觀察站／北京以商止戈 拋大協議扭轉美中貿戰", "date": "2026-09-25 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362474.jpg&M=1&s=Y&x=0&y=18&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/125026/9776637"}]}, {"name": "中東戰火連綿", "articles": [{"article_id": "9776547", "title": "伊朗對美放狠話…油價上漲 華府擬減少柴油出口", "date": "2026-09-25 01:46", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35362181.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&w=300", "link": "/news/story/124061/9776547"}, {"article_id": "9775530", "title": "川習會倒數…陸遭爆支援伊朗成「秘密武器」川普為習近平優先冷處理", "date": "2026-09-24 14:25", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/24/35360580.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124061/9775530"}, {"article_id": "9774227", "title": "川普喊殲滅伊斯蘭共和國 聯合國演說發出強硬警告", "date": "2026-09-24 02:54", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35358197.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&w=300", "link": "/news/story/124061/9774227"}, {"article_id": "9774264", "title": "重燃希望！7月來首次 美伊重啟會談", "date": "2026-09-24 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35358248.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124061/9774264"}, {"article_id": "9774280", "title": "聯大演說 伊朗總統斥美恐怖主義", "date": "2026-09-24 00:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/23/35358301.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/124061/9774280"}]}, {"name": "國際焦點", "articles": [{"article_id": "9776756", "title": "習近平敦促川普慎重處理台灣問題 堅持「反對台獨」立場", "date": "2026-09-25 02:08", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362449.jpg&M=1&s=Y&x=28&y=38&sw=1224&sh=815&exp=3600&w=300", "link": "/news/story/6809/9776756"}, {"article_id": "9776737", "title": "習近平支持美伊回歸14點諒解備忘錄", "date": "2026-09-25 01:27", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/25/35362421.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/new