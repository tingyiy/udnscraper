://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214374.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9680460"}, {"article_id": "9680760", "title": "日職／163公里火球男+WBC國手歸隊 猛虎鐵牛棚再成形", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/09/35214734.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9680760"}, {"article_id": "9675473", "title": "76人比2017年KD的「宇宙勇士」強？老詹年輕10歲才有可能", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35207017.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9675473"}, {"article_id": "9674902", "title": "中職／熱昏了！韓職取消比賽 聯盟也應及早訂定高溫規定", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35206059.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9674902"}, {"article_id": "9672404", "title": "交易大限5大Win Now贏家 道奇奪史庫柏、教士迎麥茲最成功", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35202794.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9672404"}, {"article_id": "9671568", "title": "續約杜倫難解又沒第二持球點 活塞無作為的休賽季打什麼算盤？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200680.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9671568"}]}, {"name": "最新文章", "articles": [{"article_id": "9682475", "title": "排球／首屆亞排聯合會年度頒獎盛典 中華排協獲獎", "summary": "中華民國排球協會副理事長黃國光、秘書長黃弘欽日前赴泰國曼谷，代表協會出席首屆「亞洲排球聯合會年度頒獎盛典（AVC Gala）」及亞洲排球聯合會（AVC）會員大會，與來自亞洲各會員協會及國際排壇人士交流。中華排協近年積極投入國際賽事主辦及推廣，此次相關成果亦獲得肯定，獲頒賽事推廣有功單位獎項。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217323.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 17:05", "link": "/news/story/7005/9682475"}, {"article_id": "9682400", "title": "韓職／熱浪衝擊後重新開戰！王彥程明先發對決王牌郭彬 挑戰獨居勝投王", "summary": "受到極端高溫熱浪衝擊，KBO韓職直接休兵一整個星期，明（11日）所有賽事將在晚間重新開打，效力韓華鷹的台灣左投王彥程將扛下首戰先發重任，挑戰獨居本季勝投王寶座。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217242.jpg&M=1&s=Y&x=0&y=0&sw=860&sh=573&exp=3600&sl=W&fw=360", "date": "2026-08-10 16:49", "link": "/news/story/7001/9682400"}, {"article_id": "9682391", "title": "MLB／E-Rod改變配球徹底壓制大谷 官網：季後賽首位先發就是他", "summary": "響尾蛇隊左投「E-Rod」羅德里奎茲（Eduardo Rodriguez）對付道奇隊有一套，今天先發7局失兩分，飆出9次三振，領軍4：2獲勝，隊史近8年單季對戰道奇占上風，響尾蛇總教練羅夫洛（Torey Lovullo）說：「他正處於極佳狀態，這絕非偶然。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217228.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 16:36", "link": "/news/story/6999/9682391"}, {"article_id": "9682312", "title": "網球／華裔新星蒙特婁闖8強 寫洛迪克後最年輕紀錄", "summary": "美國華裔20歲新星勒納．田（Learner Tien），今年不斷締造紀錄，今天蒙特婁名人賽他以兩個6：4拍下阿根廷蒂蘭特（Thiago Agustin Tirante），闖進8強，成為2002年同胞傳奇洛迪克（Andy Roddick）後最年輕打進加拿大大賽最終8強的美國選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217153.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 16:09", "link": "/news/story/7005/9682312"}, {"article_id": "9682265", "title": "日職／徐若熙復健有進展！傳接拉長40公尺 腰部感覺不再卡卡", "summary": "效力日本職棒軟銀鷹隊的台灣投手徐若熙，7月中進行腰部手術，已在上周展開傳接球，逐步拉長距離，徐若熙接受日本媒體訪問時透露，最嚴重時連走路都吃力，但如今透過手術已經掃除不適感，「腰部卡卡的感覺，已經完全消失了。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217149.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 15:56", "link": "/news/story/7001/9682265"}, {"article_id": "9682236", "title": "NBA／跑轟名帥尼爾森離世 諾威茨基悼念恩師：沒有他就沒有現在的我", "summary": "名人堂級傳奇教頭尼爾森（Don Nelson）傳出過世消息，享年86歲，而過去在小牛（現名獨行俠）與這位跑轟戰術宗師共事、情同父子的名宿「德國坦克」諾威茨基（Dirk Nowitzki）也立即發文哀悼，更感性直言當初若不是尼爾森，自己絕不會有如此精彩的成就。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217062.jpg&M=1&s=Y&x=0&y=3&sw=683&sh=455&exp=3600&sl=W&fw=360", "date": "2026-08-10 15:45", "link": "/news/story/7002/9682236"}, {"article_id": "9682198", "title": "NBA／挑戰張伯倫單場100分神話？ 溫班亞瑪自信：我可以", "summary": "馬刺當家少主溫班亞瑪（Victor Wembanyama）對自己的得分爆發力充滿信心，他近日在接受法國內容創作者Rookicks快問快答訪問時，被問到是否相信自己有能力單場攻下100分，溫班亞瑪給出簡短但直接的回答：「我可以。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217012.jpg&M=1&s=Y&x=53&y=0&sw=1083&sh=722&exp=3600&sl=W&fw=360", "date": "2026-08-10 15:31", "link": "/news/story/7002/9682198"}, {"article_id": "9682151", "title": "MiLB／捕手轉職火球男 洋基農場新星本季初登板狂飆百公里速球", "summary": "從捕手轉戰投手的洋基農場新星葛梅茲（Antonio Gomez）本季初登板就技驚四座，將捕手強肩轉換為火球特質，四縫線速球均速達99.9英里（約160.8公里），更有5球飆破百英里，用實力證明這個選擇沒有錯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216947.jpg&M=1&s=Y&x=0&y=285&sw=1242&sh=828&exp=3600&sl=W&fw=360", "date": "2026-08-10 15:09", "link": "/news/story/6999/9682151"}, {"article_id": "9682096", "title": "MLB／大谷翔平MVP寶座不穩？ 美媒點出「二刀流」回歸成關鍵變數", "summary": "洛杉磯道奇球星大谷翔平本季持續繳出國聯頂尖的打擊成績，但美國媒體認為，若他想爭取生涯第5座MVP，關鍵不能只靠「翔平」的打擊表現，而是「投手大谷」能否在例行賽結束前重新歸隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216839.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 14:48", "link": "/news/story/6999/9682096"}, {"article_id": "9682051", "title": "中職／中信兄弟本季首次3連勝橫掃 羅戈瞄準季後賽：現在換我們氣勢上來", "summary": "中信兄弟終於打出本季最振奮士氣的一波攻勢，隨著昨天在澄清湖球場以10：2擊敗台鋼雄鷹，完成3連勝橫掃，這也是他們本季首次在系列賽橫掃對手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216806.jpg&M=1&s=Y&x=0&y=44&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-10 14:32", "link": "/news/story/7001/9682051"}, {"article_id": "9682049", "title": "MLB／李灝宇勝打幫老虎升至外卡第4 台將3人球隊都有機會進季後賽", "summary": "李灝宇今天10局上代打，揮出關鍵安打攻下致勝分，幫助老虎隊以3：1擊敗巨人隊，在美聯中區排名升至第2、外卡躍居第4，全力爭取連續3年季後賽門票；鄧愷威所屬的太空人隊、鄭宗哲效力的紅襪隊，目前分別是分區龍頭和外卡第2，闖進季後賽的機會更大。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216807.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 14:28", "link": "/news/story/6999/9682049"}, {"article_id": "9681851", "title": "MiLB／費爾柴德3A敲安1打點1盜 潘文輝2A中繼奪勝投", "summary": "美國職棒西雅圖水手隊台美混血好手「費仔」費柴德今天在小聯盟3A先發出賽，單場1安1打點跑出1次盜壘成功；費城人隊投手潘文...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216670.jpg&M=1&s=Y&x=0&y=1&sw=680&sh=453&exp=3600&sl=W&fw=360", "date": "2026-08-10 14:10", "link": "/news/story/6999/9681851"}, {"article_id": "9681951", "title": "雙溪國小帶領學童走讀家鄉 定向探索夏令營培育新世代行動力", "summary": "暑假接近尾聲，新北市雙溪國小訂於12日攜手中華民國定向越野協會及北極星定向探索俱樂部，辦理「山海GO雙溪老街定向探索夏令營」，帶領高年級學童走出校園，展開一堂「會移動的家鄉探索課」。孩子們將依循地圖線索，走訪雙溪街區，透過觀察、訪查與任務挑戰，認識老街街屋、歷史建築、地方信仰及河川環境，從熟悉的生活場景重新發現家鄉特色。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216599.jpg&M=1&s=Y&x=0&y=222&sw=1254&sh=836&exp=3600&sl=W&fw=360", "date": "2026-08-10 13:57", "link": "/news/story/7005/9681951"}, {"article_id": "9681875", "title": "亞運棒球／中華培訓赴日交流賽 劉致榮投2局飆速152公里", "summary": "亞運棒球培訓隊赴日交流賽第6戰，與日本社會人隊東海理化交手，培訓隊中具旅美資歷的投手劉致榮逐步拉長投球局數，今天中繼2局...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216517.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 13:50", "link": "/news/story/124981/9681875"}, {"article_id": "9681876", "title": "日職／火球男張峻瑋先發突然球速驟降 身體不適被迫提前退場", "summary": "效力福岡軟銀鷹的20歲台灣火球男張峻瑋，7月底才正式升格為支配下球員，今天在二軍迎來升格後第2場先發，面對橫濱DeNA二軍主投2.2局無失分，被敲2支安打，送出2次三振與2次保送，最快球速達155公里，防禦率降至2.50。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216436.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 13:47", "link": "/news/story/7001/9681876"}, {"article_id": "9681883", "title": "籃網球／亞洲錦標賽 中華隊贏南韓隊 勝場「開胡」", "summary": "2026亞洲籃網球錦標賽中華隊今天（10日）在分組預賽第三場比賽，以58：38擊敗南韓隊，拿到中華隊在預賽的首場勝利，目前戰績1勝2敗，明天（11日）中華隊休兵一天，12日預賽最後一場將迎戰巴基斯坦隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216433.jpg&M=1&s=Y&x=2&y=574&sw=783&sh=522&exp=3600&sl=W&fw=360", "date": "2026-08-10 13:38", "link": "/news/story/7003/9681883"}, {"article_id": "9681801", "title": "MLB／休息室大到會迷路！豪門道奇設備太頂 塞揚巨投嚇到「竟有專屬飛機」", "summary": "洛杉磯道奇之所以被許多球員視為最嚮往加盟的球隊之一，並非沒有原因。交易截止日前轉戰道奇的兩屆塞揚獎巨投史庫柏（Tarik Skubal），近日就被球團壓倒性的硬體與後勤規格震撼，從球員專屬飛機到重新裝修後的豪華休息室，都讓這名過去長期待在底特律老虎的左投大開眼界。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216313.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 13:04", "link": "/news/story/6999/9681801"}, {"article_id": "9681674", "title": "NBA／若和柯瑞對調也能建立勇士王朝 艾利斯自信言論引熱議", "summary": "前NBA球星艾利斯（Monta Ellis）近日受訪直言，他認為如果當年金州勇士選擇讓他站在柯瑞（Stephen Curry）後來所處的位置，並搭配同樣具備爭冠實力的陣容，勇士仍然能夠拿下多座總冠軍。艾利斯這番說法也引來不少熱議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216140.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 12:31", "link": "/news/story/7002/9681674"}, {"article_id": "9681723", "title": "MLB／官網慶幸不再對決響尾蛇 道奇未獲分區冠軍就是歷史性崩盤", "summary": "道奇隊陷入本季最大低潮，今天在客場以2：4不敵響尾蛇隊，吞下最近9場比賽第8敗；官網直言，道奇帶著系列賽失利離開亞利桑納州，如果要說「有什麼值得慶幸之處」，或許就是例行賽不會再碰到響尾蛇。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216210.jpg&M=1&s=Y&x=0&y=5&sw=1193&sh=795&exp=3600&sl=W&fw=360", "date": "2026-08-10 12:24", "link": "/news/story/6999/9681723"}, {"article_id": "9681709", "title": "TPBL／雲豹洋將補強 簽下澳洲國手、游艾喆日本前隊友", "summary": "桃園台啤永豐雲豹隊今天宣布，正式簽下2016年里約奧運澳洲男籃國手莫騰（Brock Motum）與美籍全能前鋒溫布許（Thomas Wimbush）。兩位洋將上季皆效力於日本B.LEAGUE一級聯賽，總經理顏行書說：「兩位球員都擁有極佳的得分能力，這波補強符合我們新賽季『一內一外』的完美配置，不僅能大幅提升團隊的外線威脅，更要以極具侵略性的攻守轉換摧毀對手防線！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216175.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 12:20", "link": "/news/story/7003/9681709"}, {"article_id": "9681686", "title": "NBA／想打洛杉磯奧運 西蒙斯自費參加澳洲隊訓練營", "summary": "2018年獲得NBA年度最佳新秀的西蒙斯（Ben Simmons），上季沒有任何NBA球隊青睞，不過他仍希望從背傷和其他傷勢中回歸，美國《ESPN》更接到消息人士表示，西蒙斯將全程參與由澳洲男籃主導的私人迷你訓練營，這場訓練營今天在墨爾本開始，且西蒙斯「沒有任何限制」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216173.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 12:11", "link": "/news/story/7002/9681686"}, {"article_id": "9681599", "title": "NBA／灰狼把握開季前磨合時間 愛德華、小鮑爾加入巴黎之旅", "summary": "今年休賽季堪稱「瘋狂暑假」，出現多組「明星換東家」大交易，為了與新同學提前適應，各隊也把握開季前的時間展開活動，其中當家愛德華（Anthony Edwards）和「球三弟」小鮑爾（LaMeloBall）等灰狼球員就加入戈貝爾（Rudy Gobert），在巴黎展開旅程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216126.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 11:44", "link": "/news/story/7002/9681599"}, {"article_id": "9681514", "title": "MLB／勇士歐森第34轟逮中100英里速球 金河成跑回致勝分終結洋基", "summary": "洋基隊今天在紐約主場對勇士隊進行3連戰最後一戰，雙方形成投手戰，各只有4支安打，勇士在延長10局上，哈里斯（Michael Harris II）關鍵安打送回代跑的金河成，攻下致勝分，終場以2：1險勝，逃過3連戰被清盤的命運。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35215837.jpg&M=1&s=Y&x=48&y=0&sw=1206&sh=804&exp=3600&sl=W&fw=360", "date": "2026-08-10 11:14", "link": "/news/story/6999/9681514"}, {"article_id": "9681757", "title": "NBA／「釣魚王」強勢回歸？ 美媒曝西蒙斯吸引多支球隊關注", "summary": "前狀元西蒙斯（Ben Simmons）受心理因素與背傷影響逐漸淡出籃壇，甚至轉職為釣魚選手，不過根據記者史皮爾斯（Marc J. Spears）報導，這位前明星將以健康狀態參加澳洲男籃的迷你訓練營，且吸引多支NBA球隊關注。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35216263.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-10 11:13", "link": "/news/story/7002/9681757"}]}, {"name": "棒球", "articles": [{"article_id": "9682265", "title": "日職／徐若熙復健有進展！傳接拉長40公尺 腰部感覺不再卡卡", "date": "2026-08-10 15:56", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217149.jpg&M=1&s=Y&x=0&y=