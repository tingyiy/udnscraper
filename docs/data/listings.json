nail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225857.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/7002/9688339"}, {"article_id": "9688355", "title": "桌球／林昀儒鄭怡靜橫掃美國組合 闖WTT歐洲大滿貫8強", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225406.jpg&M=1&s=Y&x=288&y=143&sw=921&sh=614&exp=3600", "link": "/news/story/7005/9688355"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9687416", "title": "中職／江少慶、林岱安互換結局均不如預期 悍將、獅隊雙輸？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224197.jpg&M=1&s=Y&x=0&y=142&sw=930&sh=620&exp=3600&w=300", "link": "/news/story/122629/9687416"}, {"article_id": "9687689", "title": "去年塞揚史肯斯本季大幅衰退 原來原因這麼多！", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9687689"}, {"article_id": "9684672", "title": "日職／林安可手感正好卻受傷 西武死守A段班傷兵潮來得不是時候", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/03/31/34815827.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684672"}, {"article_id": "9685328", "title": "中職／全季排名戰局詭譎富邦還在線！831大限成突圍關鍵", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35219029.jpg&M=1&s=Y&x=0&y=0&sw=1107&sh=738&exp=3600&w=300", "link": "/news/story/122629/9685328"}, {"article_id": "9684466", "title": "金鶯震撼出清狀元拉契曼 第二代「面具鐵爺」再次遺憾收場", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/11/35220091.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9684466"}, {"article_id": "9682402", "title": "日職／洋將及捕手戰力考量 火腿林家正或有上一軍開箱機會", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/10/35217245.jpg&M=1&s=Y&x=0&y=0&sw=927&sh=618&exp=3600&w=300", "link": "/news/story/122629/9682402"}]}, {"name": "最新文章", "articles": [{"article_id": "9688863", "title": "MLB／岡本和真致勝安助藍鳥3連勝 紅襪大起大落9連勝後5連敗", "summary": "岡本和真8局下關鍵安打攻下超前分，帶動藍鳥隊這半局5分攻勢，終場以6：4擊敗紅襪隊，不但在多倫多主場搶下4連戰前3勝，也讓紅襪吞下5連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226078.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:47", "link": "/news/story/6999/9688863"}, {"article_id": "9688822", "title": "NBA／雷霆總管讚衛少是球團根基！效力過球隊僅「湖人」未致敬", "summary": "現年37歲的「大三元製造機」衛斯特布魯克（Russell Westbrook）今天在社群平台宣布退休，雷霆總管普雷斯帝（Sam Presti）發聲明向衛少致敬，衛少待過的球團也發聲致敬，獨缺湖人隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226002.jpg&M=1&s=Y&x=0&y=157&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:38", "link": "/news/story/7002/9688822"}, {"article_id": "9688803", "title": "NBA／衛少拒絕老東家報價後退休 經紀人諷球員工會：沒人簽老將", "summary": "前MVP「忍者龜」衛斯特布魯克（Russell Westbrook）今天在社群宣布退休，結束18年職業征程。而根據《ESPN》知名記者查拉尼亞（Shams Charania）報導，這位37歲老將其實不是「無球可打」，而是自願拒絕球隊報價選擇退休。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225994.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:30", "link": "/news/story/7002/9688803"}, {"article_id": "9688788", "title": "TPBL／注入歐陸新戰力 中信特攻簽下斯洛伐克籍長人", "summary": "新北中信特攻籃球隊持續強化新賽季整體戰力配置，球團今天宣布與斯洛伐克籍禁區長人法拉帝（Vladimir Brodziansky）簽約。法拉帝預計於九月上旬抵台，新賽季將披上20號黃衫戰袍，憑藉豐富的歐洲職業賽場經驗與多元進攻能力，為特務軍團注入全新戰力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225953.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:28", "link": "/news/story/7003/9688788"}, {"article_id": "9688783", "title": "MLB／大谷翔平第27支全壘打出爐 再度獨居日本球員最多轟", "summary": "道奇隊今天在洛杉磯主場對皇家隊進行3連戰最後一戰，大谷翔平3局下轟出兩分砲，本季第27轟出爐，幫助道奇3：2領先，道奇全力爭取系列賽橫掃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35226056.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:26", "link": "/news/story/6999/9688783"}, {"article_id": "9688339", "title": "NBA／湖人1年內二度易主天價售出 前老闆華特爽賺25億美元", "summary": "美國職籃NBA最有價值球隊洛杉磯湖人隊(Los Angeles Lakers)一年內第二次易主；此次將以125億元賣給川普總統女婿庫許納(Jared Kushner)的商人弟弟喬許．庫許納(Josh Kushner)和迪士尼前執行長艾格(Bob Iger)。這筆天價交易創下美國職業運動球隊轉讓紀錄，也刷新了NBA球隊價值飆漲新紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225857.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 11:05", "link": "/news/story/7002/9688339"}, {"article_id": "9688670", "title": "棒球／陳義信回應「咆哮、差點揮拳」霸凌指控 打斷4顆門牙黑歷史被翻出", "summary": "「假日飛刀手」陳義信去年9月接任原住民委員會副主委，如今卻被爆出3起職場霸凌爭議。陳義信和原民會都做出回應，陳義信強調，「我可能很嚴肅，但絕對沒有打人。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225778.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 10:55", "link": "/news/story/7001/9688670"}, {"article_id": "9688675", "title": "MLB／光芒場均10分痛宰運動家 創大聯盟127年來罕見紀錄", "summary": "光芒今天在客場用15支安打的猛烈攻勢，以8：4在系列戰橫掃運動家。而這場勝利不僅為坦帕灣的客場之旅畫下9勝0敗的完美句點，更是創下隊史首見的瘋狂紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225779.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 10:46", "link": "/news/story/6999/9688675"}, {"article_id": "9688673", "title": "MLB／布萊格曼3響砲7分打點 追上道奇史密斯寫下罕見紀錄", "summary": "小熊隊重砲布萊格曼（Alex Bregman）今天上演全壘打秀，對國民隊狂轟3支全壘打，全場包辦7分打點，幫助小熊12：6大勝，他也成為隊史第29位締造單場3響砲紀錄的球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225806.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 10:46", "link": "/news/story/6999/9688673"}, {"article_id": "9688589", "title": "MLB／道奇將昨天奪勝的火球男下放3A 道奇教頭說明原因", "summary": "道奇隊今天再度做出球員異動，下放昨天登板奪勝的26歲火球男哈爾沃森（Seth Halvorsen），拉上29歲右投納克（Landon Knack）。道奇總教練羅伯茲（Dave Roberts）今天賽前受訪說明升降原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225625.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 10:16", "link": "/news/story/6999/9688589"}, {"article_id": "9688538", "title": "MLB／李灝宇先發扛四棒3支1 離台灣球員單季安打紀錄只差1支", "summary": "旅美好手李灝宇今天重返老虎隊先發打線，扛起第4棒重任，3次打數揮出1支安打、跑回1分，本季累積53安離大聯盟台灣球員紀錄只差1安，老虎終場4：6不敵守護者隊，終止最近3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225579.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 10:01", "link": "/news/story/6999/9688538"}, {"article_id": "9688491", "title": "NBA／冠軍隊每人獨得千萬獎金 NBA盃開幕戰尼克再戰76人", "summary": "NBA今天公布新賽季的NBA盃完整賽程，美國時間10月30日開幕日的兩場比賽將由衛冕軍尼克隊迎戰「小皇帝」詹姆斯（LeBron James）加入的76人隊，另場比賽將由勇士隊和湖人隊上演西岸人氣球隊對決。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225500.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 09:44", "link": "/news/story/7002/9688491"}, {"article_id": "9688355", "title": "桌球／林昀儒鄭怡靜橫掃美國組合 闖WTT歐洲大滿貫8強", "summary": "在瑞典舉行的WTT歐洲大滿貫賽，台灣黃金混雙林昀儒、鄭怡靜今天在次輪以3比0橫掃美國組合梁吉善、陳伊依，挺進混雙8強，接...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225406.jpg&M=1&s=Y&x=288&y=143&sw=921&sh=614&exp=3600&sl=W&fw=360", "date": "2026-08-13 09:18", "link": "/news/story/7005/9688355"}, {"article_id": "9688423", "title": "排球／海峽大戰不敵衛冕軍 中華隊今和日本拚4強門票", "summary": "中華女排在2026年亞洲東區女子排球錦標賽第二戰強碰上屆冠軍中國隊，激戰4局吞下首敗，今天下午5點將和日本上演小組賽壓軸對決，勝隊就能前進4強，敗隊只能落入5、6名排名賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225394.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 09:12", "link": "/news/story/7005/9688423"}, {"article_id": "9688360", "title": "足球／世足拚進決賽仍等不到摯愛 梅西悲傷悼父：我該如何走下去", "summary": "阿根廷球王梅西（Lionel Messi）近日送摯愛的父親荷黑．梅西（Jorge Messi）走完人生最後一程，在低調辦完喪禮後，首度於社群媒體發聲，道盡對父親的思念。他提到父親在世足賽前已病重，無法到場看他比賽，也遺憾未能獻上新的獎盃，更沉痛道失去父親後「不知道該如何走下去」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225303.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 08:51", "link": "/news/story/7005/9688360"}, {"article_id": "9687416", "title": "中職／江少慶、林岱安互換結局均不如預期 悍將、獅隊雙輸？", "summary": "中職本季「慶安互換」成為雙輸局面，富邦與統一的合作成效低迷。林岱安在富邦的表現不佳，安打稀少，江少慶在統一則因傷病無法穩定發揮，雙方皆未達預期，最終形成不利局面。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224197.jpg&M=1&s=Y&x=0&y=142&sw=930&sh=620&exp=3600&sl=W&fw=360", "date": "2026-08-13 07:00", "link": "/news/story/122629/9687416"}, {"article_id": "9687689", "title": "去年塞揚史肯斯本季大幅衰退 原來原因這麼多！", "summary": "去年塞揚獎得主史肯斯在2026賽季大幅衰退，自責分率飆升至接近4。多種因素，包括球速下降、被打擊強度提高及防守弱化，導致他的表現未如理想。盡管如此，他仍是海盜隊的王牌投手，WAR值在聯盟排名第七。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224535.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-13 07:00", "link": "/news/story/122629/9687689"}, {"article_id": "9688217", "title": "NBA／史上最強大三元製造機 衛斯布魯克宣布退休結束18年生涯", "summary": "美國職籃NBA球星衛斯布魯克今天在社群媒體上宣布退休，結束18年職業生涯。他昔日以勁爆體能著稱，曾以場均「大三元」表現奪...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225145.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 06:40", "link": "/news/story/7002/9688217"}, {"article_id": "9688149", "title": "NBA／湖人又要易主？傳將以125億美元破紀錄價格出售", "summary": "多名消息人士向體育媒體ESPN透露，美國職籃NBA洛杉磯湖人隊將以125億美元（約新台幣4031億元）的破紀錄價格，出售...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/13/35225001.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-13 00:28", "link": "/news/story/7002/9688149"}, {"article_id": "9687924", "title": "中職／本季首轟棒打德保拉 董子恩盼未來更多支「有一就有二」", "summary": "富邦悍將隊今天在主場迎戰中信兄弟，首局就攻破洋投德保拉，靠董子恩的2分砲攻回勝利打點，用個人本季首轟力挺新洋投瑪帝斯拿勝投，董子恩也盼「有一就有二」，未來能有更多轟陸續出爐。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224800.jpg&M=1&s=Y&x=0&y=131&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 22:27", "link": "/news/story/7001/9687924"}, {"article_id": "9687894", "title": "中職／瑪帝斯首局飆速153展球威 悍將教頭給好評「比想像中好」", "summary": "富邦悍將新洋投瑪帝斯今迎中職初登板，先發5.2局失2分，靠著隊友的火力相挺，拿下來台首勝，開賽就飆速153公里展現球威，他也坦言自己雖然有些緊張，但感覺不錯，出現2次保送是較不滿意之處。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224748.jpg&M=1&s=Y&x=0&y=89&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 22:03", "link": "/news/story/7001/9687894"}, {"article_id": "9687861", "title": "中職／陳克羿7局無失分封鎖獅隊 陳鏞基台東引退系列賽G2遭完封", "summary": "統一獅隊陳鏞基引退系列賽回到家鄉台東，今天第二戰沒能以勝利收尾，獅隊打線遭封鎖，全場僅5支零星安打，終場0：4落敗，本季第14度遭到完封繼續堆高隊史紀錄，也終止近期3連勝；猿隊本土投手陳克羿則繳出7局無失分的表現，拿下單場MVP。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224717.jpg&M=1&s=Y&x=0&y=272&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 21:39", "link": "/news/story/7001/9687861"}, {"article_id": "9687814", "title": "中職／瑪帝斯初登板5.2局失2分奪首勝 董子恩敲本季首轟首局定江山", "summary": "富邦悍將隊新洋投瑪帝斯今天順利「開箱」，中職初登板對中信兄弟先發5.2局失2分，隊友也在首局就由董子恩開轟迎接「新同學」，單局進帳3分奠定勝基，終場悍將隊以3：2勝出，斬斷兄弟3連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/12/35224611.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 21:05", "link": "/news/story/7001/9687814"}, {"article_id": "9687771", "title": "日職／孫易磊後援1局挨2安無失分 飆158公里平生涯最速", "summary": "日職火腿隊今天在主場迎戰西武隊，21歲台灣投手孫易磊相隔4天再登板，第8局上場後援，主投1局被敲2支安打，沒有失分，最快球速飆平生涯最快的158公里，但火腿隊最終以2：5落敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212693.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-12 20:35", "link": "/news/story/7001/9687771"}]}, {"name": "棒球", "articles": [{"article_id": "9688670", "title": "棒球／陳義信回應「咆哮、差點揮拳」霸凌指控 打斷4顆門牙黑歷史被翻出", "date": "2026-08-13 10:55", "thumbnail": "https://pgw.udn.