https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/01/35474783.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9850308"}, {"article_id": "9850346", "title": "日職／松井、工藤兩大咖同時降臨 央聯明年成超級戰區", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/01/35474821.jpg&M=1&s=Y&x=0&y=479&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/122629/9850346"}, {"article_id": "9847524", "title": "從板凳浪人變身灰熊砍分悍將 傑洛姆大爆發背後深藏驚人秘密", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/10/30/35470456.jpg&M=1&s=Y&x=87&y=7&sw=1193&sh=795&exp=3600&w=300", "link": "/news/story/122629/9847524"}]}, {"name": "最新文章", "articles": [{"article_id": "9855240", "title": "中職／冬季聯盟參賽名單亮牌！高國輝、張建銘扛教頭 林佳緯也入列", "summary": "2026亞洲冬季棒球聯盟將於11月14日開打，集結台灣、日本、韓國共六支球隊參賽，為今年冬天再掀棒球熱潮。中職六隊兵分兩路，組成台灣山林隊與台灣海洋隊，兩隊參賽名單正式公布，年輕好手將透過冬盟實戰累積經驗、提升實力，力拚將冠軍留在台灣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35482160.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-03 20:24", "link": "/news/story/7001/9855240"}, {"article_id": "9855060", "title": "TPBL／阿巴西奪本土MVP 德魯獲外援最有價值球員肯定", "summary": "台灣職業籃球大聯盟（TPBL）今天公布2026-27賽季的第三周MVP，本土外援最有價值球員由新北中信特攻「黑豹」阿巴西獲得，洋將MVP由新竹御嵿攻城獅德魯（Drew Pember）獲選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481935.jpg&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-03 18:45", "link": "/news/story/7003/9855060"}, {"article_id": "9854839", "title": "NBA／贏球還被找麻煩？杜蘭特出手太少遭追問 賽後怒嗆記者：為何針對我", "summary": "火箭今日以109：93擊敗塞爾蒂克，不僅開季取得7勝1敗，還成功登上西區龍頭。不過，38歲球星杜蘭特（Kevin Durant）賽後卻與記者爆發爭論，原因是他全場僅出手6次並攻下12分，從而被記者追問出手次數為何之少，讓杜蘭特當場反問，「我們贏球了，為什麼你只針對我？」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481507.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 18:12", "link": "/news/story/7002/9854839"}, {"article_id": "9854788", "title": "NBA／「苦命」也能出頭天！灰狼教頭盛讚昔日勇士棄將：球隊沒他不行", "summary": "昔日勇士新星庫明加（Jonathan Kuminga）轉戰灰狼後，逐漸找到適合的球場定位，儘管今日攻下8分，卻繳出10籃板、4火鍋的亮眼防守數據，幫助球隊以112：100擊敗公鹿，讓總教練芬奇（Chris Finch）讚賞他正扮演「完美的角色」，強調團隊無法失去他的重要性。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481411.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 18:12", "link": "/news/story/7002/9854788"}, {"article_id": "9854975", "title": "路跑／萬金石馬拉松萬聖節出任務！全能遊樂場熱鬧登場 跑步結合綜合健身玩出新樂趣", "summary": "萬金石馬拉松結合跑步與綜合健身，萬聖節於淡水漁人碼頭登場；2027賽事抽籤結果公布，中籤者須於11月10日前繳費。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481790.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 18:09", "link": "/news/story/7005/9854975"}, {"article_id": "9854889", "title": "中職／捕手陳重羽有望複數年約續留 獅領隊：合約大致達共識", "summary": "中職統一7-ELEVEn獅隊捕手陳重羽取得自由球員（FA）資格，有望獲得複數年約續留獅隊。獅隊領隊蘇泰安證實，與陳重羽合...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481693.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 17:54", "link": "/news/story/7001/9854889"}, {"article_id": "9854879", "title": "日職／「沒有樂天，就沒有現在的我們」 宋家豪妻子感性發文令人動容", "summary": "宋家豪結束與樂天金鷲合約成自由球員，妻子發文感謝仙台11年陪伴，感性告別獲球迷打氣，並回顧他旅日11年的奮鬥與成就。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481671.jpg&M=1&s=Y&x=0&y=14&sw=888&sh=592&exp=3600&sl=W&fw=360", "date": "2026-11-03 17:50", "link": "/news/story/7001/9854879"}, {"article_id": "9854896", "title": "共創健康活力社區 全台336里獲115年運動村里認證", "summary": "為讓運動深入社區，帶動民眾養成規律運動習慣，運動部全民運動署持續推動「運動村里認證」計畫，鼓勵各地善用在地場域、整合社區資源，發展符合不同年齡與族群需求的運動活動，讓運動融入日常生活，促進鄰里交流與社區凝聚。全民署今天舉辦「115年運動村里認證表揚典禮暨認證分享會」，表揚長期推廣運動的村里，並促進各地實務經驗與成果的交流分享。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481580.jpg&M=1&s=Y&x=0&y=0&sw=657&sh=438&exp=3600&sl=W&fw=360", "date": "2026-11-03 17:24", "link": "/news/story/7005/9854896"}, {"article_id": "9854827", "title": "NBA／勇士暌違1年多5連勝！柯瑞談格林被驅逐：必須支持兄弟", "summary": "勇士隊一哥柯瑞（Stephen Curry）今天轟下34分，幫助勇士克服17分落後，以116：113擊敗太陽。柯瑞賽後將贏球功勞歸給格林（Draymond Green），認為格林提前離場激起全隊強烈的求勝意志。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481493.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 16:55", "link": "/news/story/7002/9854827"}, {"article_id": "9854755", "title": "青奧／游出我國第一面牌 李瀚：開心也沒想到", "summary": "2026第4屆達卡青年奧林匹克運動會，中華代表團於達卡時間11月2日在游泳池畔誕生本屆首面獎牌，開幕典禮擔任掌旗官的李瀚在男子100公尺自由式決賽以50秒26成績獲得銅牌，也是史上第一面青奧游泳獎牌，他坦言超出預期。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481340.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 16:24", "link": "/news/story/7005/9854755"}, {"article_id": "9854712", "title": "NBA／格林被驅逐後勇士順起來！奈及利亞中鋒：衝突都是假強硬", "summary": "勇士隊老將格林（Draymond Green）被驅逐出場，奈及利亞中鋒貝西（Charles Bassey）把握機會，上場23分鐘攻下19分8籃板，幫助勇士以116：113擊敗太陽隊，收下5連勝。貝西賽後談到肢體衝突，直言許多球員在場上只是「假裝強硬」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481266.jpg&M=1&s=Y&x=0&y=331&sw=1275&sh=850&exp=3600&sl=W&fw=360", "date": "2026-11-03 16:07", "link": "/news/story/7002/9854712"}, {"article_id": "9854691", "title": "NBA／超越「阿舍哥」！灰狼小鮑爾千顆三分球創史上最快紀錄", "summary": "原本因右手腕挫傷被列為出賽存疑的灰狼主控小鮑爾（LaMelo Ball），最終還是確定上陣，並且在開賽後迅速進入狀況，包辦灰狼全隊前17分中的13分，全場攻下本季新高34分，搭配全隊6人得分雙位數，灰狼在主場以112：100擊敗公鹿。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481261.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-03 16:06", "link": "/news/story/7002/9854691"}, {"article_id": "9854637", "title": "NBA／教小孩喝醉打球？美媒老闆痛批詹姆斯「喝酒特權」：換別人早被送去戒酒", "summary": "41歲的76人球星詹姆斯（LeBron James）在今日7以126：107擊敗公牛的比賽中，因救球不慎撞翻場邊球迷的紅酒，並喝了一口才返回球場。對此，美國知名體育媒體《Barstool Sports》創辦人波特諾伊（Dave Portnoy）公開砲轟，認為這樣的行為恐對年輕球迷帶來不良示範。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481155.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 15:45", "link": "/news/story/7002/9854637"}, {"article_id": "9854568", "title": "中職／雙獎到手再添喜訊！亞冠賽「台灣隊長」郭天信發文明年迎二寶", "summary": "味全龍外野手郭天信近期可說是喜事連連，不僅獲選為2026年亞冠賽「台灣隊長」，更在昨日中職年度頒獎典禮，抱回生涯第5座外野金手套，更睽違3年獲選最佳九人雙獎。沒想到他今日又透過社群分享好消息，宣布妻子預計明年迎接第二胎，開心表示「明年會有第二個小皮蛋」，讓他在球場上收穫榮耀之餘，家庭也將迎來新成員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481065.jpg&M=1&s=Y&x=0&y=359&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-11-03 15:31", "link": "/news/story/7001/9854568"}, {"article_id": "9854515", "title": "NBA／球場上「酒駕」畫面曝光？詹姆斯撞翻球迷紅酒順口品嚐", "summary": "將年滿42歲的NBA傳奇球星詹姆斯（LeBron James），本季轉戰76人後依舊樂在其中，不僅在今日以126：107擊敗公牛的比賽中，在進算加罰後開心跳舞，與馬克西（Tyrese Maxey）一同慶祝，更為了救球不慎衝進觀眾席，撞翻一名球迷手中的紅酒，並拿起杯子喝了一口才返回球場，逗趣畫面不僅迅速在社群媒體瘋傳，賽後更當起「品酒師」，笑稱味道還可以。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480965.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 15:12", "link": "/news/story/7002/9854515"}, {"article_id": "9854528", "title": "MLB／小熊要幹大事？傳有意和道奇爭取塞揚左投史庫柏", "summary": "小熊隊連2年打進季後賽，但都敗在先發投手戰力不如人。如今傳出他們將出手爭取2屆塞揚左投史庫柏（Tarik Skubal）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480984.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 15:05", "link": "/news/story/6999/9854528"}, {"article_id": "9854463", "title": "NBA／阿夫迪亞末節發威逆轉金塊 拓荒者迎開季客場4連勝", "summary": "拓荒者作客面對狀態欠佳的金塊，阿夫迪亞（Deni Avdija）攻下全隊最高28分，其中9分集中在第四節，加上哈勒戴（Jrue Holiday）替補出賽繳出17分10助攻8籃板接近大三元的全面表現，最終以118：110逆轉擊敗金塊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480876.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-11-03 14:47", "link": "/news/story/7002/9854463"}, {"article_id": "9854426", "title": "NBA／痛失總冠軍仍難忘！溫班亞瑪談上季G4遭逆轉是生涯「最心碎」一戰", "summary": "馬刺當家球星溫班亞瑪（Victor Wembanyama）上季率隊闖進NBA總冠軍賽，卻以1勝4敗不敵尼克，其中第4戰更在最多領先29分的情況下，慘遭對手以107：106逆轉，寫下總冠軍賽史上最大逆轉紀錄。對此，溫班亞瑪坦言，這場失利至今仍讓他難以釋懷，更直言是職業生涯最「心碎的」一刻。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480916.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-03 14:45", "link": "/news/story/7002/9854426"}, {"article_id": "9854435", "title": "桌球／WTT法蘭克福冠軍賽將開打 林昀儒力拚3年後第2冠", "summary": "WTT法蘭克福冠軍賽今天登場，台灣男單有林昀儒，女單有鄭怡靜、彭郁涵參賽，其中林昀儒曾在2023年奪冠，今年要力拚賽史個...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480867.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 14:42", "link": "/news/story/7005/9854435"}, {"article_id": "9854429", "title": "NBA／格林動手摔人被驅逐 柯瑞飆34分驚險射太陽奪5連勝", "summary": "勇士隊當家球星柯瑞（Stephen Curry）休息一場再上陣，今天面對太陽隊砍下34分、7助攻和6籃板，儘管連續罰球命中紀錄在最後5秒告終，仍率勇士以116：113驚險擊敗太陽隊，開季3連敗後拉出5連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480838.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-11-03 14:33", "link": "/news/story/7002/9854429"}, {"article_id": "9854398", "title": "高球／泰國15歲少女球員比賽遭雷擊身亡 家屬質疑主辦單位太晚停賽", "summary": "泰國高爾夫球界傳出憾事，今年15歲的青少年高球選手艾雅瓦琳，上週末參加在泰國北柳府（Chachoengsao）舉行的青少...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480778.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 14:30", "link": "/news/story/7005/9854398"}, {"article_id": "9854395", "title": "NBA／尼克末節25比5猛攻轟垮籃網 紐約內戰豪取15連勝", "summary": "開季以來狀態呈現劇烈起伏的紐約尼克，今天面對同城的籃網，前三節打完仍落後4分，卻在第四節開局打出驚人的25：5攻勢，一口氣扭轉戰局，最終以103：90獲勝。雖然過程不輕鬆，但尼克還是取得近4場比賽的第3勝，更將對籃網的連勝紀錄推進至15場，延續近年在紐約內戰中的絕對優勢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480755.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 14:24", "link": "/news/story/7002/9854395"}, {"article_id": "9854397", "title": "NBA／康寧漢創史上首見數據 活塞主帥：見過最出色的領袖", "summary": "活塞隊今天在客場以124：91輕取黃蜂隊，活塞一哥康寧漢（Cade Cunningham）成為史上首位上場不到30分鐘，就至少拿下30分5籃板5助攻5抄截的控球後衛，活塞本季6勝1敗，暫居東區第2。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480757.jpg&M=1&s=Y&x=0&y=32&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-11-03 14:23", "link": "/news/story/7002/9854397"}, {"article_id": "9853991", "title": "路跑／英超足球傳奇退役跑馬拉松 40歲米爾納紐約稱王", "summary": "40歲英超傳奇米爾納退役後首度挑戰馬拉松，在紐約以3小時9分4秒完賽；他曾因膝蓋手術後神經受損，仍重返球場並完成24年職業生涯。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35480095.jpg&M=1&s=Y&x=0&y=0&sw=249&sh=166&exp=3600&sl=W&fw=360", "date": "2026-11-03 13:59", "link": "/news/story/7227/9853991"}]}, {"name": "棒球", "articles": [{"article_id": "9854879", "title": "日職／「沒有樂天，就沒有現在的我們」 宋家豪妻子感性發文令人動容", "date": "2026-11-03 17:50", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481671.jpg&M=1&s=Y&x=0&y=14&sw=888&sh=592&exp=3600&w=300", "link": "/news/story/7001/9854879"}, {"article_id": "9853805", "title": "日職／宋家豪與樂天金鷲11年緣斷 下一步仍盼留在日職尋找其他機會", "date": "2026-11-03 11:24", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35479724.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9853805"}, {"article_id": "9854889", "title": "中職／捕手陳重羽有望複數年約續留 獅領隊：合約大致達共識", "date": "2026-11-03 17:54", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35481693.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9854889"}, {"article_id": "9855240", "title": "中職／冬季聯盟參賽名單亮牌！高國輝、張建銘扛教頭 林佳緯也入列", "date": "2026-11-03 20:24", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/11/03/35482160.png&M=1&s=Y&x=0&y=0&sw=1080&sh=720&exp=3600&w=300", "link": "/news/story/7001/9855240"}, {"ar