nail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/15/35138904.jpg&M=1&s=Y&x=0&y=39&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9629922"}, {"article_id": "9630390", "title": "煮茶論戰／「無敵艦隊」團隊傳控 給傲慢巨星軍團上一課", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35139569.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9630390"}, {"article_id": "9629335", "title": "VAR讓阿根廷不再有「上帝之手」 提防英格蘭「機會主義達人」貝林漢", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/15/35138172.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9629335"}, {"article_id": "9629348", "title": "世足攻略／英格蘭準決賽強碰宿敵阿根廷 延長、PK大戰恐成終極舞台", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/15/35137839.jpg&M=1&x=0&y=0&sw=0&sh=0&exp=3600&w=300", "link": "/news/story/122629/9629348"}, {"article_id": "9627838", "title": "亞運棒球名單大張旗鼓徵召旅外球星 星光熠熠卻忘了分級制", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/14/35135701.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9627838"}, {"article_id": "9627384", "title": "從墊底一壘手到金手套二壘手 巨人向阿拉斯下了什麼魔咒？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/14/35135399.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9627384"}]}, {"name": "最新文章", "articles": [{"article_id": "9632810", "title": "中職／李勛傑雙安突破銳力獅 桃猿終止對戰獅隊4連敗", "summary": "中職明星賽前最後一戰，樂天桃猿隊今天靠著由曾家輝由本土投手撐住場面，曾家輝先發5局失1分、陳克羿中繼3局無失分，再由陳冠宇登板關門守成；打線則有李勛傑在6局下敲回超前分，終場以2：1逆轉統一獅隊，終止對戰4連敗，下半季續居龍頭，也讓獅隊中斷3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142991.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=852&exp=3600&sl=W&fw=360", "date": "2026-07-16 21:29", "link": "/news/story/7001/9632810"}, {"article_id": "9632713", "title": "日職／林安可連兩場開轟後近兩戰5支0 西武終止3連勝", "summary": "日職西武獅隊今天在主場對上羅德隊，台灣強打外野手林安可重回先發打線，擔任第6棒、左外野手，3打數沒有敲出安打。此戰西武雖一度將比數扳平，但最終在9局下反撲失利，以3：4落敗，終止3連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/04/21/34877187.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 20:25", "link": "/news/story/7001/9632713"}, {"article_id": "9632664", "title": "日職／張峻瑋二軍再進化 8局9K無失分飆速158公里", "summary": "軟銀鷹隊台灣投手張峻瑋再進化，今天在日職二軍先發8局無失分、投出9次三振，最快球速158公里平生涯紀錄，助球隊3比0獲勝...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142878.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 20:22", "link": "/news/story/7001/9632664"}, {"article_id": "9632623", "title": "中職／宋柏翰全壘打大賽找宋嘉翔餵球 若奪冠要幫哥哥組新電腦", "summary": "台鋼雄鷹20歲新秀宋柏翰，今年將參與明星賽全壘打大賽，也是8位參賽者中年紀最輕的選手，他找上哥哥、樂天桃猿隊捕手宋嘉翔替他餵球，且若是能勝出拿到獎金，就要替哥哥組一台新電腦，邀哥哥一起打遊戲。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142810.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 19:45", "link": "/news/story/7001/9632623"}, {"article_id": "9632561", "title": "TPBL／郭嘉安獲特攻青睞 建中男籃史上首名職籃球員", "summary": "台灣職業籃球大聯盟TPBL今天舉行新人選秀會，其中前鋒郭嘉安獲得新北中信特攻青睞，將成為建中男籃史上首名進軍職籃的球員，...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142745.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-16 19:28", "link": "/news/story/7003/9632561"}, {"article_id": "9632585", "title": "TPBL／雲豹、夢想家沒選人 顏行書曝被「攔胡」", "summary": "TPBL選秀會今天登場，總計28位報名新秀共8人獲選，混血國手賀丹沒有意外成為高雄全家海神欽點的「狀元」，台北台新戰神的「榜眼」籤給了UBA冠軍隊政治大學唯一報名的吳志鍇，握有第三順位的新北中信特攻將「探花」給了國體大的郭嘉安；桃園台啤永豐雲豹和福爾摩沙夢想家都是首輪就放棄指名，沒有補進任何新人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142741.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 19:22", "link": "/news/story/7003/9632585"}, {"article_id": "9632571", "title": "TPBL／吳志鍇兩聯盟都中選 CBA選秀會後決定下一步", "summary": "UBA冠軍隊政治大學主力前鋒吳志鍇今天TPBL選秀會被第二順位的台新戰神隊指名，成選秀會「榜眼」，日前PLG選秀會也獲選的他還有報名中國CBA選秀會，下一步將等28日的CBA選秀會後再決定。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142723.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 19:13", "link": "/news/story/7003/9632571"}, {"article_id": "9632567", "title": "中職／全壘打大賽原想找馬傑森餵球 李勛傑：不要對到魚柱就好", "summary": "樂天桃猿隊21歲新生代砲手李勛傑，上半季累積5發全壘打，今年將首次在中職全壘打大賽亮相，他笑說，沒有預設要打幾轟，「希望不要對到魚柱（曾頌恩）就好。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142717.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 19:11", "link": "/news/story/7001/9632567"}, {"article_id": "9632548", "title": "TPBL／知道高雄「很熱」 賀丹期待對決國家隊隊友點名這兩人", "summary": "台美混血好手賀丹完成常春藤名校康乃爾大學學業，選擇投入國內職籃TPBL選秀，今天選秀會沒意外被握有「狀元籤」的高雄全家海神隊挑中，成為新科狀元的他直呼期待加入海神，除可以和中華隊隊友胡瓏貿再聯手，也期待對決國家隊同隊過的阿巴西和馬建豪等人，準備迎接籃球生涯新旅程。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142700.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 19:02", "link": "/news/story/7003/9632548"}, {"article_id": "9632522", "title": "影／賀丹獲海神青睞成選秀狀元 全家一同到場見證", "summary": "TPBL2026選秀會今晚登場，混血國手賀丹獲得高雄全家海神隊青睞成為選秀狀元，台北台新戰神隊的「榜眼」籤選擇政治大學吳志鍇，新北中信特攻隊則將「探花」給了國體大郭嘉安。本屆選秀總計28位報名新秀共8人獲選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142633.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-16 18:47", "link": "/news/story/7003/9632522"}, {"article_id": "9632485", "title": "中職／獅隊明星賽前拚4連勝 前役MVP朱迦恩大腿緊繃待命代打", "summary": "統一獅隊昨天在延長賽逆轉贏球收下3連勝，今天在桃園球場續戰樂天桃猿隊，也是明星賽前最後一戰，兩名外野手朱迦恩、邱智呈因身體有些不適沒有先發，另拉上田子杰擔任外野預備選手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142712.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 18:36", "link": "/news/story/7001/9632485"}, {"article_id": "9632462", "title": "蔣萬安施政報告 綠營杯葛搭足球熱", "summary": "台北市議會新會期開議，市長蔣萬安今天進行施政報告，報告前民進黨團提權宜問題，針對近日淹水、天坑、砍樹等議題輪番砲轟，高舉「淹水天坑加砍樹，萬安施政沒半步」標語抗議，並送上山蘇、足球、鏟子、紅黃牌等道具。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142554.jpg&M=1&s=Y&x=0&y=0&sw=1258&sh=839&exp=3600&sl=W&fw=360", "date": "2026-07-16 18:28", "link": "/news/story/7005/9632462"}, {"article_id": "9632440", "title": "中職／27歲邱邦堅持4年一圓和天上爸爸之約 初登一軍先打給王勝偉", "summary": "樂天桃猿隊昨天將27歲新秀邱邦拉上一軍，進入職棒近4年終於等到初登一軍的機會，並對上統一獅隊之戰於9局下被換上場代打，生涯首打席就敲出首安，一圓他和已故父親的約定，邱邦說：「爸爸一定有跟我們一起見證那一刻。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142495.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 18:15", "link": "/news/story/7001/9632440"}, {"article_id": "9632338", "title": "TPBL／賀丹成選秀狀元 28人報名、8人獲選", "summary": "TPBL選秀會今天登場，混血國手賀丹沒有意外成為高雄全家海神隊欽點的「狀元」，台北台新戰神隊的「榜眼」籤給了UBA冠軍隊政治大學唯一報名的吳志鍇，握有第三順位的新北中信特攻隊將「探花」給了國體大的郭嘉安；總計28位報名新秀共8人獲選。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142348.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 17:47", "link": "/news/story/7003/9632338"}, {"article_id": "9632290", "title": "世足賽／冠軍隊獎金創下賽史96年新高 48強保底1050萬美元", "summary": "本屆世界盃足球賽進行102場比賽後，終於產生冠軍賽的對戰組合，阿根廷、西班牙將在台灣時間20日凌晨3點對決，爭取史上最高的冠軍獎金5000萬美元（約合台幣16億1077萬），亞軍則獲3300萬美元。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142320.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 17:36", "link": "/news/story/123107/9632290"}, {"article_id": "9632249", "title": "TPBL／沒有意外！賀丹獲海神青睞成選秀狀元 賀博與一家人現場見證", "summary": "TPBL選秀會今天登場，混血國手賀丹沒有意外成為「狀元」，獲得高雄全家海神隊青睞；台北台新戰神隊的「榜眼」籤給了UBA冠軍隊政治大學唯一報名的吳志鍇，握有第三順位的新北中信特攻隊將「探花」給了國體大的郭嘉安。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142192.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 17:18", "link": "/news/story/7003/9632249"}, {"article_id": "9632205", "title": "NBA／17勝墊底巫師將翻身？林書豪坦言：沒進附加賽我會很驚訝", "summary": "林書豪近日擔任夏季聯賽球評時，談到巫師新賽季前景給出高度評價，直言若華盛頓連附加賽都打不進，自己會感到非常意外。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142117.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 17:00", "link": "/news/story/7002/9632205"}, {"article_id": "9632144", "title": "MLB／道奇全明星一壘手談退休規劃！弗里曼盼完成20年生涯：想打到40歲", "summary": "道奇明星一壘手弗里曼（Freddie Freeman）日前在明星賽媒體日受訪時，談到自己的退休規劃。現年36歲的他表示，希望能打到40歲，同時完成20年大聯盟生涯，為自己的職業生涯畫下完美句點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142035.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 16:47", "link": "/news/story/6999/9632144"}, {"article_id": "9631978", "title": "MLB／大谷翔平是男的？拳王泰森頒獎失言引網友眾怒：看不出幽默在哪", "summary": "有「體壇奧斯卡」之稱的「年度體育卓越表現獎（ESPY）」於今日登場，道奇日本巨星大谷翔平榮獲「年度最佳MLB球員」與「最佳單場表現」兩大獎項。然而，拳王泰森（Mike Tyson）一句，「翔平是男的喔？（Shohei is a guy?）」，令網友不禁表示，「要多無知才會這樣問 ?」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35141786.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 16:44", "link": "/news/story/6999/9631978"}, {"article_id": "9632126", "title": "卡廸那熱舞賽圓山花博炸裂周末開跳 嘻小瓜魔性唱跳、K-POP即播即跳頂尖對決！", "summary": "圓山花博將於7月18至19日舉辦第七屆「卡廸那NON-STOP熱舞賽」，年度盛事將吸引全台頂尖舞者參賽。開幕當天特邀「嘻小瓜」現場唱跳《水晶晶》，K-POP即播即跳賽事更將挑戰選手即時還原舞步。多元活動期待將現場氣氛推向高潮！", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142048.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 16:42", "link": "/news/story/7005/9632126"}, {"article_id": "9632149", "title": "足球／FIFA首辦U15世界盃 中華足協規劃代表團選拔參賽", "summary": "國際足球總會（FIFA）日前正式邀請各會員協會參與首屆「2026 FIFA U15 World Cup and Festival（2026年FIFA U15世界盃暨嘉年華）」，賽事將於10月22日至31日在亞塞拜然舉行，參賽資格為2011年1月1日至2012年12月31日出生之青年球員。中華民國足球協會表示，已著手規劃代表隊選拔、集訓及相關備戰工作，希望透過此次國際舞台，提供台灣青年球員更多國際競賽與交流機會。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142045.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-16 16:36", "link": "/news/story/7005/9632149"}, {"article_id": "9632140", "title": "NBA／向戈貝爾請教後夏聯虐菜！太陽南蘇丹中鋒：連詹皇都還有東西要學", "summary": "太陽隊南蘇丹籍中鋒馬魯阿奇（Khaman Maluach）統治夏季聯賽，4場比賽場均攻下19.5分12.8籃板2火鍋，投籃命中率53%，三分命中率40%。他受訪時提到，休賽季有向灰狼隊法國中鋒戈貝爾（Rudy Gobert）請教。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35142034.jpg&M=1&s=Y&x=330&y=33&sw=868&sh=579&exp=3600&sl=W&fw=360", "date": "2026-07-16 16:35", "link": "/news/story/7002/9632140"}, {"article_id": "9632081", "title": "世足賽／穿鮮紅露背裝採訪西班牙 辣妹場邊主播被封為幸運神", "summary": "西班牙在世足賽4強賽中擊敗法國，挺進冠軍戰。場邊主播波拉麗亞因其穿著鮮紅露背裝被球迷譽為「幸運神」，IG粉絲數量激增，留言盛讚其美貌與運氣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35141951.jpg&M=1&s=Y&x=0&y=172&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-16 16:26", "link": "/news/story/123107/9632081"}, {"article_id": "9632026", "title": "NBA／國王首節僅4分創史上最爛紀錄！馬刺「韓國湯普森」狂轟22分", "summary": "NBA夏季聯賽國王隊與塞爾蒂克隊交手，首節只拿4分打破歷史紀錄。馬刺隊韓國神射手李賢重打出今年夏聯代表作，上場22分鐘狂轟22分。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35141888.jpg&M=1&s=Y&x=425&y=275&sw=855&sh=570&exp=3600&sl=W&fw=360", "date": "2026-07-16 15:55", "link": "/news/story/7002/9632026"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9631093", "title": "世足賽／三闖決賽成賽史第二人 梅西有望締造神紀錄", "date": "2026-07-16 10:32", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35140335.jpg&M=1&s=Y&x=0&y=0&sw=1236&sh=824&exp=3600&w=300", "link": "/news/story/123107/9631093"}, {"article_id": "9631662", "title": "世足賽／英格蘭教頭把「龜縮」責任推給球員 韓媒形容「洪明甫式」甩鍋", "date": "2026-07-16 13:33", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35141285.