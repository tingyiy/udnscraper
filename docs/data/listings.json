"thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102453.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9605552"}, {"article_id": "9605538", "title": "世足攻略／技術流與身體對抗的交鋒 哥倫比亞牢握主動權迦納難爆冷", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102423.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9605538"}, {"article_id": "9603366", "title": "中職／上半季打出兩張關鍵好牌 悍將下半季拚季後賽仍待考驗", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/02/35098938.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9603366"}, {"article_id": "9603930", "title": "煮茶論戰／4關鍵因素 比利時上演驚天逆轉勝", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35100330.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9603930"}, {"article_id": "9603099", "title": "世足攻略／瑞士即使對抗前任教頭仍占優 看好小勝阿爾及利亞一球", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/02/35098543.jpg&M=1&s=Y&x=0&y=2&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9603099"}]}, {"name": "最新文章", "articles": [{"article_id": "9606433", "title": "MLB／史上首次日籍重砲接力獲獎 岡本和真獲6月美聯最佳新人", "summary": "大聯盟今天揭曉6月個人獎項，藍鳥隊日籍重砲岡本和真獲選美聯單月最佳新人，是他今年轉戰大聯盟後拿下的首座個人獎項，也是繼白襪隊村上宗隆5月獲獎後，連續兩個月由日本選手榮獲單月最佳新人獎，寫下大聯盟史上第一次。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://p.udn.com.tw/upf/2017_news/noimg_cid7227_8.jpg", "date": "2026-07-04 10:27", "link": "/news/story/6999/9606433"}, {"article_id": "9606359", "title": "NBA／尼克補進4屆籃板王！佐蒙德一年390萬美元轉當唐斯替補", "summary": "衛冕軍尼克在失去冠軍中鋒羅賓森（Mitchell Robinson）後。根據《ESPN》權威記者查拉尼亞（Shams Charania）報導，尼克已與兩屆明星中鋒佐蒙德（Andre Drummond）達成1年390萬美元（約新台幣1.1億元）合約，新賽季將擔任唐斯（Karl-Anthony Towns）的替補中鋒，補上禁區輪替空缺。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103579.jpg&M=1&x=&y=&sw=&sh=&exp=3600&sl=W&fw=360", "date": "2026-07-04 10:10", "link": "/news/story/7002/9606359"}, {"article_id": "9606396", "title": "NBA／湖人禁區戰力又有異動 送艾頓去巫師換回後衛與2次輪籤", "summary": "NBA禁區戰力補強持續暗潮洶湧，今天市場再度傳出兩起重磅長人異動消息。湖人與巫師達成交易協議，將中鋒艾頓（Deandre Ayton）送往巫師，換回後衛哈迪（Jaden Hardy）與兩個二輪選秀權；而衛冕軍尼克則火速在市場上補進佐蒙德（Andre Drummond），雙方預計簽下一紙1年390萬美元的合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103633.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 10:08", "link": "/news/story/7002/9606396"}, {"article_id": "9606368", "title": "MLB／讓大谷多休息與表現無關 羅伯茲曝大谷難在明星賽登板", "summary": "道奇隊日籍球星大谷翔平今天「二刀流」出賽，在主場對上教士隊，下周預計還會再投一場，之後以國聯先發指定打擊的身份參與15日在費城舉行的明星賽，道奇總教練羅伯茲（Dave Roberts）也透露，「很難想像」他能夠在明星賽登板投球，預計只會單刀出擊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103610.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 09:59", "link": "/news/story/6999/9606368"}, {"article_id": "9606358", "title": "世足賽／維德角未完成擊敗阿根廷奇蹟 仍創賽史超罕見紀錄", "summary": "2026美加墨世足賽32強賽今天上演黑馬維德角，對上衛冕軍阿根廷的戲碼。維德角雖未能完成奇蹟，但仍創下罕見紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103590.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-04 09:59", "link": "/news/story/123107/9606358"}, {"article_id": "9606338", "title": "世足賽／「藍鯊」譜寫非洲狂想曲 梅西：維德角表現絕非偶然", "summary": "首度登上世足賽舞台的非洲黑馬維德角（Cape Verde），今天在32強淘汰賽中展現出令世界震驚的韌性，硬是將衛冕軍阿根廷逼入延長賽，儘管最終以2：3惜敗，但這群「藍鯊」戰士已經在足球歷史上寫下最壯麗的初登場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103554.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 09:44", "link": "/news/story/123107/9606338"}, {"article_id": "9606330", "title": "MLB／下一站在哪？費爾柴德不去守護者3A 正式成為自由球員", "summary": "台美混血球星費爾柴德（Stuart Fairchild）走完7天讓渡程序，並無球隊承接，今天拒絕守護者隊下放，選擇成為自由球員，下一步動向未定。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103540.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-04 09:30", "link": "/news/story/6999/9606330"}, {"article_id": "9606318", "title": "MLB／有摩擦更能幫助關係升級 道奇教頭相信大谷和拉辛搭配沒問題", "summary": "大谷翔平、捕手拉辛（Dalton Rushing）前一場搭配溝通斷線，引發極大話題，兩人今天繼續作為投捕搭檔面對教士隊。賽前被問到兩人的關係，道奇教頭羅伯茲（Dave Roberts）認為沒有問題，有時經過一些特定事件摩擦，反而能幫助他們邁向下一階段。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103524.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 09:22", "link": "/news/story/6999/9606318"}, {"article_id": "9606311", "title": "NBA／詹姆斯10選項包含勇士、76人 經紀人曝排除衛冕軍尼克主因", "summary": "「詹皇」詹姆斯（LeBron James）拋下離開湖人的震撼彈後，自由市場隨即掀起滔天巨浪，他的經紀人保羅（Rich Paul）日前在播客節目上，直接拿出白板與指標，洋洋灑灑列出高達10支潛在球隊，並逐一分析利弊。保羅透露，目前已與多達27支球隊進行過對話，並強調即將邁入生涯第24年的詹姆斯，這次做決定將毫無壓力，「純粹是為了他自己的快樂而戰。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103516.jpg&M=1&s=Y&x=297&y=206&sw=971&sh=647&exp=3600&sl=W&fw=360", "date": "2026-07-04 09:14", "link": "/news/story/7002/9606311"}, {"article_id": "9606307", "title": "世足賽／連墨西哥主帥都公開反對 墨英16強賽避雷提前開踢申請遭打槍", "summary": "2026年世足賽16強淘汰賽即將點燃戰火，其中地主墨西哥與英格蘭的「墨英大戰」在開賽前就引發波瀾。先前傳出因擔心墨西哥城6日晚間的惡劣天氣，墨西哥政府曾向FIFA爭取將比賽提前6小時至中午開踢，不過在FIFA與兩國足協展開漫長協商後，因遭到雙方足協反對，FIFA已決定拒絕變更申請，比賽將維持原訂的當地時間晚間6點進行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103512.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 09:11", "link": "/news/story/123107/9606307"}, {"article_id": "9606282", "title": "世足賽／維德角兩度扳平仍不夠 梅西進球+關鍵角球阿根廷驚險晉級", "summary": "2026美加墨世足賽32強賽今天進入最後一天賽程，並上演眾所矚目的衛冕軍阿根廷與黑馬維德角之戰，儘管開賽第29分鐘阿根廷球王梅西（Lionel Messi）就踢進個人本屆賽事第7顆進球，幫助球隊取得領先。不過本場比賽維德角2度扳平戰局，最終阿根廷也在延長賽第111分鐘靠著羅梅洛（Cristian Romero）頭錘造成維德角烏龍球，以3：2擊敗韌性十足的維德角，晉級到16強賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103478.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 08:48", "link": "/news/story/123107/9606282"}, {"article_id": "9606274", "title": "世足賽／PK戰大膽換門將受質疑 澳洲遭埃及淘汰亞洲最後希望止步32強", "summary": "2026世足賽首度闖進淘汰賽階段的埃及，今天在32強賽遭遇「袋鼠軍團」澳洲，雙方在正規賽與延長賽踢完1：1平手。隨後展開的點球大戰中，埃及以4：2氣走澳洲，收下隊史在世足淘汰賽階段的首場勝利，也讓今年亞洲區最後希望澳洲抱憾出局。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103469.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 08:36", "link": "/news/story/123107/9606274"}, {"article_id": "9606256", "title": "世足賽／梅西第20顆進球續寫紀錄 阿根廷遭黑馬維德角扳平進入延長賽", "summary": "2026美加墨世足賽32強賽今天進入最後一天賽程，並上演眾所矚目的衛冕軍阿根廷與黑馬維德角之戰，儘管開賽第29分鐘阿根廷球王梅西（Lionel Messi）就踢進個人本屆賽事第7顆進球，幫助球隊取得領先，不過第59分鐘維德角杜阿爾特（Deroy Duarte）也踢進維德角隊史在淘汰賽的首顆進球，兩隊在正規賽踢完後也以1：1進入延長加時。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103431.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 08:14", "link": "/news/story/123107/9606256"}, {"article_id": "9606183", "title": "世足賽／PK大戰分勝負 埃及4比2力克澳洲挺進16強", "summary": "2026年世界盃足球賽32強淘汰賽於7月4日凌晨2時開踢，由澳洲對決埃及。兩隊在正規賽與延長賽中戰成1比1平手，最終埃及在關鍵的十二碼罰球大戰中以4比2勝出，成功奪下晉級門票，澳洲則遺憾止步32強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103327.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-04 05:16", "link": "/news/story/123107/9606183"}, {"article_id": "9606175", "title": "溫網／兩大奪冠熱門穩步前進 約克維奇、辛納挺進16強", "summary": "7屆溫布頓網球錦標賽冠軍約克維奇（Novak Djokovic）再度寫下溫網歷史，成功晉級男單第4輪，而衛冕冠軍的辛納（...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103299.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-04 04:42", "link": "/news/story/124935/9606175"}, {"article_id": "9605939", "title": "中職／獲單場MVP賽後訪問怎麼拍？ 「小編」范國宸苦惱：比打球還難", "summary": "富邦悍將隊長范國宸自今年5月中旬起，在球隊贏球的賽後當起「小編」，對單場MVP進行訪問，影片發出後獲得不錯的迴響，拍了16場比賽之後，今天輪到他自己成為單場MVP，賽後該怎麼進行今天的賽後訪問？范國宸也笑說很煩腦，「這比打球還難。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102881.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 22:29", "link": "/news/story/7001/9605939"}, {"article_id": "9605924", "title": "溫網／大坂直美直落二克敵 生涯首闖溫布頓16強", "summary": "日本女將大坂直美（Naomi Osaka）今天在溫網女單第3輪，以6比1、6比3直落二，擊敗澳洲好手卡薩金娜，生涯首度闖...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102878.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 22:28", "link": "/news/story/124935/9605924"}, {"article_id": "9605879", "title": "中職／劉時豪相隔2098天開轟 雄鷹9局守住滿壘危機收拾獅隊", "summary": "台鋼雄鷹隊休息整整1周迎戰下半季，今天攻勢一波接一波，連劉時豪都時隔6年開轟，林詩翔九局上驚險守住滿壘危機，雄鷹終場以6：3擊敗統一獅隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102815.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 21:46", "link": "/news/story/7001/9605879"}, {"article_id": "9605871", "title": "中職／范國宸3安2打點帶頭 悍將掃14安下半季首戰6：3屠龍", "summary": "中華職棒下半季賽事今天開戰，上半季排名前二的味全龍隊、富邦悍將隊在天母棒球場進行交手，悍將打線單場掃出14支安打，在隊長范國宸單場3安2打點的帶頭之下，終場以6：3拿下勝利，延續上半季尾聲的好狀況，拉出4連勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102811.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 21:43", "link": "/news/story/7001/9605871"}, {"article_id": "9605850", "title": "中職／林泓育1支超前安不夠再補超前犧牲打 兄弟3度4連敗只比1隊少", "summary": "中信兄弟隊上半季以3連敗收尾，今天在下半季首戰又以3：5不敵樂天桃猿隊，吞下本季第3次4連敗，次數僅次於猿隊的5次。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102766.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 21:26", "link": "/news/story/7001/9605850"}, {"article_id": "9605847", "title": "世界盃男籃／19分逆轉南韓保晉級生機 圖奇讚中華男籃打出近2年最精彩一戰", "summary": "中華男籃今天在男籃世界盃亞洲區資格賽第三階段賽事首戰，於南韓主場迎戰地主，在最多19分落後的情況下於延長賽逆轉勝出，保住晉級機會，賽後總教練圖奇也直言，這一勝是他接掌中華隊兵符兩年多來贏下最精彩的一戰，球員展現了十足的韌性、勇氣與自信。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102762.png&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&sl=W&fw=360", "date": "2026-07-03 21:25", "link": "/news/story/7003/9605847"}, {"article_id": "9605835", "title": "中職／張政禹又騙到對手？ 池恩齊一個move錯愕出局", "summary": "味全龍隊內野手張政禹3天前用守備「假動作」騙到弟弟張士綸，今天對上富邦悍將隊，5局上又用巧妙的守備反應，成功騙到出局數，也替球隊化解該局的危機，苦主則是悍將內野手池恩齊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102736.jpg&M=1&s=Y&x=0&y=14&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 21:12", "link": "/news/story/7001/9605835"}, {"article_id": "9605779", "title": "世界盃男籃／林庭謙關鍵三分、高柏鎧再見火鍋 中華隊落後19分大逆轉南韓", "summary": "男籃世界盃亞洲區資格賽最後一階段賽事，中華男籃今天在南韓高陽市出戰地主隊，在輸球就可能無緣晉級的情況下，中華隊在外線熄火的情況下一度落後到19分差，不過第四節中華隊在陳盈駿領軍下展開反撲，加上林庭謙的三分球將比賽帶入延長賽，最終中華隊也以82：80逆轉南韓，保住晉級希望。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102698.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 20:37", "link": "/news/story/7003/9605779"}, {"article_id": "9605718", "title": "中職／岳政華生涯首支場內全壘打 兄弟球團史第5人", "summary": "中信兄弟隊岳政華的本季第3轟、生涯第26轟，跑出生涯首支場內全壘打，第三局面對樂天桃猿隊洋投威能帝直擊中外野全壘打牆，連衝4個壘包跑回分數，用腿開砲幫助黃衫軍以3：3追平戰局。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/03/35102650.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-03 19:52", "link": "/news/story/7001/9605718"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9606282", "title": "世足賽／維德角兩度扳平仍不夠 梅西進球+關鍵角球阿根廷驚險晉級", "date": "2026-07-04 08:48", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103478.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9606282"}, {"article_id": "9606358", "title": "世足賽／維德角未完成擊敗阿根廷奇蹟 仍創賽史超罕見紀錄", "date": "2026-07-04 09:59", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/04/35103590.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&