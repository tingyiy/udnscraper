mbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211739.jpg&M=1&s=Y&x=78&y=0&sw=1112&sh=742&exp=3600", "link": "/news/story/7002/9678817"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9675473", "title": "76人比2017年KD的「宇宙勇士」強？老詹年輕10歲才有可能", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35207017.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9675473"}, {"article_id": "9674902", "title": "中職／熱昏了！韓職取消比賽 聯盟也應及早訂定高溫規定", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/06/35206059.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9674902"}, {"article_id": "9672404", "title": "交易大限5大Win Now贏家 道奇奪史庫柏、教士迎麥茲最成功", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35202794.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9672404"}, {"article_id": "9671568", "title": "續約杜倫難解又沒第二持球點 活塞無作為的休賽季打什麼算盤？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200680.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9671568"}, {"article_id": "9671549", "title": "中職／擴編選秀CP值最高球員！ 陳文杰蛻變雄鷹王牌球星", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/05/35200626.jpg&M=1&s=Y&x=0&y=49&sw=1055&sh=703&exp=3600&w=300", "link": "/news/story/122629/9671549"}, {"article_id": "9668253", "title": "中職／至今找不到第4名可用洋投 中信洋投海戰術面臨失敗", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/03/35196038.jpg&M=1&s=Y&x=0&y=33&sw=800&sh=533&exp=3600&w=300", "link": "/news/story/122629/9668253"}]}, {"name": "最新文章", "articles": [{"article_id": "9679086", "title": "中職／兄弟一次增加2位重大傷兵 張志豪手腕、許基宏右膝動刀", "summary": "中信兄弟隊今天公布重大傷兵，兩位主力球星張志豪與許基宏都傳傷情，近期在經過主治醫師、教練團以及醫療防護團隊的審慎檢查與評估後，張志豪已完成手腕鉤狀骨手術，許基宏則是即將進行右膝關節鏡半月板修復手術。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212169.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&sl=W&fw=360", "date": "2026-08-08 14:22", "link": "/news/story/7001/9679086"}, {"article_id": "9679014", "title": "亞運籃球／分組賽程出爐！男籃與中東3隊競爭、女籃第3戰碰南韓", "summary": "2026名古屋亞運公布五人制籃球分組及預賽賽程出爐，中華男籃、女籃首戰比賽時間與對手確定。男籃預賽9月10日點燃戰火，女籃預賽則是9月17日登場。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212077.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:36", "link": "/news/story/124981/9679014"}, {"article_id": "9679002", "title": "MLB／佐佐木朗希先發投球依舊優質 羅伯茲不排除季後賽兩頭燒", "summary": "道奇日籍投手佐佐木朗希今天在客場先發對戰響尾蛇，主投6局被敲4支安打失2分，雖然第7局道奇追平比數，讓他無關勝敗，但整體內容仍展現近期回穩狀態。不過近況低迷的道奇又是面臨未能守成的窘境，終結者迪亞茲（Edwin Díaz）慘遭瓦德史密特（Ryan Waldschmidt）敲出再見兩分砲，最終苦吞7連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212059.jpg&M=1&s=Y&x=76&y=33&sw=1144&sh=762&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:29", "link": "/news/story/6999/9679002"}, {"article_id": "9678977", "title": "足球／2012世界盃被爆曾性招待裁判 韓國足協今天公開致歉", "summary": "韓國足球國家代表隊在世足賽慘遭淘汰後，足球協會接連爆發多項醜聞，並被媒體...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212056.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:28", "link": "/news/story/7005/9678977"}, {"article_id": "9679001", "title": "MLB／迪亞茲砸鍋是否換人關門？道奇教頭：換別人投得也沒多好", "summary": "道奇隊有機會畫上句點的連敗，今天在九局下遭瓦德史密特（Ryan Waldschmidt）兩分砲一棒摧毀，終場以3：4不敵響尾蛇隊。守護神迪亞茲（Edwin Díaz）關門砸鍋，賽後被問到是否考慮終結者換人，總教練羅伯茲（Dave Roberts）直白回應：「其他人投得也沒多好。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212063.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:24", "link": "/news/story/6999/9679001"}, {"article_id": "9678965", "title": "MLB／楚奧特每逢生日超會轟！教頭鈴木清笑：希望明後天也當生日過", "summary": "天使隊球星楚奧特（Mike Trout）的生日似乎總少不了全壘打相伴。今日迎來35歲生日的「神鱒」，在天使作客馬林魚之戰再度展現自己的「生日限定」火力，首局就將一顆96.8英里速球轟向中左外野，形成一發飛行距離400英尺的陽春砲，不僅敲出本季第19轟，也幫助天使最終以4比3驚險帶走勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211995.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:09", "link": "/news/story/6999/9678965"}, {"article_id": "9678969", "title": "MLB／村上宗隆25轟超越岡本和真 獨佔日本球員大聯盟新秀全壘打紀錄", "summary": "白襪日籍重砲村上宗隆今天在主場面對守護者敲出本季第25號全壘打，超越多藍鳥強打岡本和真，獨居日本球員大聯盟新人球季全壘打紀錄第一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212000.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 13:00", "link": "/news/story/6999/9678969"}, {"article_id": "9678946", "title": "MLB／6支「生日砲」追平A-Rod！楚奧特：能排在那個位置滿酷的", "summary": "天使球星「神鱒」楚奧特（Mike Trout）今日為自己送上一份特別的「35歲生日禮物」，在天使作客馬林魚的比賽首局中，楚奧特敲出一發Statcast預估飛行距離400英尺的中左外野陽春砲，幫助天使最終以4比3擊敗馬林魚。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212001.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:58", "link": "/news/story/6999/9678946"}, {"article_id": "9678971", "title": "MLB／李灝宇連4戰未先發代打選保送 老虎11安不敵巨人單場5安", "summary": "老虎隊台灣內野手李灝宇近期連4場比賽沒先發，今天客場出戰巨人隊，在8局上被換上場代打，選到四壞球保送上壘，但沒能跑回分數，後續也沒有上場守備，終場老虎以2：5不敵巨人。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212004.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:55", "link": "/news/story/6999/9678971"}, {"article_id": "9678952", "title": "MLB／洋基死屍打線9下終於爆發！延長賽再見高飛犧牲斷勇士8連勝", "summary": "打擊狀態低迷的洋基隊今天前8局對勇士隊又掛蛋，9下開啟絕地大反攻先追平，延長賽麥馬漢（Ryan McMahon）敲再見高飛犧牲打，以3：2險勝，中止勇士8連勝，也勉強守住美聯外卡第1的位置。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211958.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:40", "link": "/news/story/6999/9678952"}, {"article_id": "9678942", "title": "MLB／藍色球隊陷地獄8月…迪亞茲挨再見兩分砲 道奇慘吞7連敗", "summary": "道奇隊的地獄8月還沒看到終點，今天以3：2領先進入九局下，守護神迪亞茲（Edwin Díaz）遭瓦德史密特（Ryan Waldschmidt）敲出再見兩分砲，終場以3：4輸給響尾蛇隊，慘吞7連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212022.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:34", "link": "/news/story/6999/9678942"}, {"article_id": "9678908", "title": "NBA／華森不滿金塊報價傳傾向先簽後換 老鷹公鹿快艇騎士感興趣", "summary": "丹佛金塊受限制自由球員華森（Peyton Watson）的去向仍未明朗，這名23歲前鋒與球團遲遲無法就新合約達成共識，甚至傳出對金塊報價感到不被尊重，因此更傾向透過先簽後換離隊。目前包括老鷹、公鹿、快艇與騎士，都被點名對華森感興趣。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211873.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:19", "link": "/news/story/7002/9678908"}, {"article_id": "9678907", "title": "NBA／「愛神」勒夫盼赴費城重聚詹姆斯 經紀人已主動聯繫", "summary": "根據《ESPN》記者麥克曼奈明（Dave McMenamin）報導，自傳奇球星詹姆斯（LeBron James）決定加盟76人後，「愛神」勒夫（Kevin Love）便表達加盟意願，盼與昔日騎士奪冠拍檔再度聯手，勒夫的經紀人施沃茲（Jeff Schwartz）也已與76人球團高層取得聯繫。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211874.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:18", "link": "/news/story/7002/9678907"}, {"article_id": "9678918", "title": "NBA／柯瑞崛起前的勇士基石！艾利斯獲聘大學男籃總管", "summary": "現年40歲的前勇士隊球星艾利斯（Monta Ellis）淡出聯盟多年，如今成為奧爾康州立大學男籃隊總管。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211880.jpg&M=1&s=Y&x=0&y=138&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:17", "link": "/news/story/7002/9678918"}, {"article_id": "9678872", "title": "籃網賽／2026亞洲錦標賽 中華隊首戰不敵泰國隊", "summary": "在香港舉行的2026亞洲籃網球錦標賽，中華隊今天（8日）在預賽首戰泰國隊，中華隊全場雖苦苦追趕，不過終場仍以31：59不敵泰國隊，中華隊將在明天（9日）出戰日本隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211815.jpg&M=1&s=Y&x=1&y=575&sw=1107&sh=738&exp=3600&sl=W&fw=360", "date": "2026-08-08 12:00", "link": "/news/story/7005/9678872"}, {"article_id": "9678838", "title": "NBA／找到爽看32年！獨行俠祭超狂「懸賞大禮包」 只為佛雷格200萬美元簽名卡", "summary": "近日《Topps》推出一張全球僅有1張的「旗子哥」佛雷格（Cooper Flagg）「1-of-1親筆簽名Debut Patch球員卡」，由於卡片極度稀有，被收藏界視為「聖杯級」逸品，市場預估價值最高甚至可能達到200萬美元。如今就連獨行俠球團都親自加入尋卡行列，公開對這張球員卡祭出「懸賞」，更開出一系列堪稱瘋狂的交換條件。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211777.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 11:56", "link": "/news/story/7002/9678838"}, {"article_id": "9678817", "title": "NBA／活塞杜倫續約卡關可能接受合格報價 美媒警告：對生涯等同判死刑", "summary": "底特律活塞與明星中鋒杜倫（Jalen Duren）的續約談判仍陷入停滯，這名受限制自由球員至今尚未與球團達成新合約協議。隨著市場空間逐漸被其他球隊用盡，外界開始討論一種較極端的可能性：杜倫是否會選擇接受「合格報價（Qualifying Offer）」，明年夏天再成為完全自由球員，爭取想要的合約。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211739.jpg&M=1&s=Y&x=78&y=0&sw=1112&sh=742&exp=3600&sl=W&fw=360", "date": "2026-08-08 11:33", "link": "/news/story/7002/9678817"}, {"article_id": "9678778", "title": "MLB／兩大塞揚左投正式合體！史庫柏、史奈爾確定下周接力登板", "summary": "道奇才透過重磅交易迎來兩屆塞揚左投史庫柏（Tarik Skubal），今日總教練羅伯茲（Dave Roberts）在對戰響尾蛇的系列賽首戰前宣布，另一名兩屆塞揚左投史奈爾（Blake Snell）將從60天傷兵名單中正式歸隊，並於下周三主場迎戰皇家時擔任先發。至於史庫柏則會下周二先發。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211677.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 11:23", "link": "/news/story/6999/9678778"}, {"article_id": "9678760", "title": "NBA／詹姆斯、布朗加盟助點然鬥志 76人總裁：安比德動力滿滿", "summary": "費城76人籃球事務總裁甘西（Mike Gansey）近日接受訪問時透露，安比德（Joel Embiid）目前身體狀況良好，且在詹姆斯（LeBron James）與布朗（Jaylen Brown）加入後，備戰新賽季的動力比以往更強。對76人來說，這名明星中鋒能否維持健康，將是球隊豪華陣容能否真正衝擊總冠軍的最大關鍵之一。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211679.jpg&M=1&s=Y&x=0&y=13&sw=1080&sh=720&exp=3600&sl=W&fw=360", "date": "2026-08-08 11:17", "link": "/news/story/7002/9678760"}, {"article_id": "9678787", "title": "中職／「聲」援兄弟！飛天小女警主題日 花花、毛毛、泡泡配音員開球", "summary": "中信兄弟隊8月15日、16日舉辦「飛天小女警 × 中信兄弟女孩日」主題活動，以「守護你的星」為主題，邀請球迷一同前往神秘星球B-Star，展開充滿勇氣、智慧與力量的宇宙冒險，主題日首日邀請《飛天小女警》三位中文配音員老師擔任開球嘉賓。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211687.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-08-08 11:14", "link": "/news/story/7001/9678787"}, {"article_id": "9678783", "title": "MLB／西格勒穿「鄭宗哲T恤」練球！紅襪記者曝如何拿到", "summary": "紅襪隊台灣好手鄭宗哲日前被下放3A，不過紅襪內野手西格勒（Anthony Seigler）近日仍穿上印有鄭宗哲圖案的衣服，《波士頓環球報》記者希利（Tim Healey）好奇詢問原因。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211684.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 11:12", "link": "/news/story/6999/9678783"}, {"article_id": "9678784", "title": "MLB／就問怎麼輸！托勒6局猛飆14K挺身而出 紅襪拉出9連勝", "summary": "紅襪隊昨天歷經13局大戰幾乎燒光牛棚，今天23歲左投托勒（Payton Tolle）為球隊挺身而出，先發6局飆14次三振，加上打線的超強火力發揮，終場紅襪以13：1擊敗運動家隊，延續9連勝之旅，拿下近30場比賽的第27勝。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211688.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 11:12", "link": "/news/story/6999/9678784"}, {"article_id": "9678673", "title": "NBA／前灰熊悍將驟逝真相出爐！法醫：海洛因、古柯鹼「意外過量」奪命", "summary": "前灰熊前鋒克拉克（Brandon Clarke）於今年5月11日驟逝，如今死因也正式出爐。根據洛杉磯郡法醫辦公室公布的報告，年僅29歲的克拉克死於海洛因與古柯鹼意外過量，此外，「多種處方藥物的綜合作用」也被列為導致死亡的重要因素，目前尚未公布涉及哪些處方藥物，相關名稱將會在之後公布的完整驗屍報告中揭露。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211517.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 10:50", "link": "/news/story/7002/9678673"}, {"article_id": "9678679", "title": "MLB／「宇宙道奇」連敗低潮狀態亮黃燈 3大警訊拖垮勝利方程式", "summary": "洛杉磯道奇雖然迎來塞揚巨投史庫柏（Tarik Skubal），然而近期卻陷入本季最大低潮，不僅寫下球隊最長6連敗，更連續輸掉2個系列賽。美媒《CBS Sports》撰文分析，道奇雖然仍是大聯盟帳面戰力最豪華的球隊，但近期打線集體降溫、原本一度表現穩定的牛棚更是崩解，加上先發輪值深度被傷兵潮逼到極限，讓這支尋求3連霸的「宇宙艦隊」暫時迷失勝利方程式。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211530.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-08 10:36", "link": "/news/story/6999/9678679"}]}, {"name": "棒球", "articles": [{"article_id": "9679086", "title": "中職／兄弟一次增加2位重大傷兵 張志豪手腕、許基宏右膝動刀", "date": "2026-08-08 14:22", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212169.jpg&M=1&s=Y&x=0&y=0&sw=900&sh=600&exp=3600&w=300", "link": "/news/story/7001/9679086"}, {"article_id": "9678787", "title": "中職／「聲」援兄弟！飛天小女警主題日 花花、毛毛、泡泡配音員開球", "date": "2026-08-08 11:14", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211687.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/7001/9678787"}, {"article_id": "9678261", "title": "中職／隊友前兩局罕見給援護 布雷克：告訴自己不要搞砸", "date": "2026-08-07 23:23", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211423.jpg&M=1&s=Y&x=0&y=0&sw=1210&sh=807&exp=3600&w=300", "link": "/news/story/7001/9678261"}, {"article_id": "9678196", "title": "中職／助林岳平執教400勝達陣 布雷克大讚：選手都喜歡餅總", "date": "2026-08-07 22:55", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/07/35210862.jpg&M=1&s=Y&x=72&y=0&sw=965&sh=624&exp=3600&w=300", "link": "/news/story/7001/9678196"}, {"article_id": "9678158", "title": "中職／頸部不適後花了太多時間調整 艾菩樂表現回穩感謝家人相伴", "date": "2026-08-07 22:30", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35211779.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/7001/9678158"}]}, {"name": "MLB", "articles": [{"article_id": "9678942", "title": "MLB／藍色球隊陷地獄8月…迪亞茲挨再見兩分砲 道奇慘吞7連敗", "date": "2026-08-08 12:34", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/08/35212022.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/6999/9678942"}, {"article_id": "9679001", "title": "MLB／迪亞茲砸鍋是否換人關門？道奇教頭：換別人投得也沒多好", "date": "202