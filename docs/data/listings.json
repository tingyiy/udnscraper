https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/16/35139569.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9630390"}]}, {"name": "最新文章", "articles": [{"article_id": "9635969", "title": "世足賽／柯納特不想踢季軍戰仍別無選擇 盼為教頭最後一舞奪銅", "summary": "世界盃足球賽法國隊總教練德尚今天表示，雖然全隊對於明天要在邁阿密與英格蘭進行季軍賽感到不悅，但為國奪下銅牌是球隊的義務。...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147633.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 13:59", "link": "/news/story/123107/9635969"}, {"article_id": "9635998", "title": "世足賽／美國再搶世界盃主辦權？川普想單獨作東 放眼2038年", "summary": "2026世足賽決賽將於19日由西班牙對陣阿根廷，國際足球總會（FIFA）17日在紐約川普大樓舉行招待會。美國總統川普對本屆賽事非常滿意，希望美國再次取得主辦權，但這一次不要讓加拿大和墨西哥來搶鎂光燈。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147613.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 13:43", "link": "/news/story/123107/9635998"}, {"article_id": "9635961", "title": "NBA／詹姆斯新東家持續神秘 笑談「相信過程」引爆費城球迷歡呼", "summary": "詹姆斯（LeBron James）完成Fanatics Fest前2天安排的第4場公開活動，但就像前3次現身一樣，他仍把即將到來的自由市場決定留給自己，沒有公開下一支球隊答案。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147600.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 13:37", "link": "/news/story/7002/9635961"}, {"article_id": "9635926", "title": "世足賽／把凱恩當防守球員川普質疑戰術 英格蘭教頭強調不後悔", "summary": "英格蘭在世足賽4強賽遭阿根廷逆轉，總教練圖赫爾因戰術調度受到批評，甚至連川普也發表意見。圖赫爾堅稱不後悔換人決策，強調比賽的複雜性，並期待季軍戰展現實力。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147565.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 13:29", "link": "/news/story/123107/9635926"}, {"article_id": "9635935", "title": "WNBA／史上第一人！克拉克狂轟45分10助攻 改寫多項驚人紀錄", "summary": "印第安納狂熱隊超級球星克拉克（Caitlin Clark）在今天面對西雅圖風暴的比賽中，上演一個不可思議的紀錄之夜。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147535.jpg&M=1&s=Y&x=0&y=4&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 13:11", "link": "/news/story/7002/9635935"}, {"article_id": "9635872", "title": "世足賽／西班牙備戰決賽 主帥笑稱沒壓力但只怕搭直升機", "summary": "西班牙總教練戴拉佛恩特在決賽前輕鬆應對，僅對搭直升機感到緊張。他強調將享受與阿根廷的對決，並指出兩隊風格相似。面對梅西，他表示會特別留意這位獨特的球員。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147516.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 13:02", "link": "/news/story/123107/9635872"}, {"article_id": "9635921", "title": "世足賽／亞馬爾傷勢無虞恢復練習 西班牙主帥：身體狀態絕佳", "summary": "眾所矚目的世界盃足球賽決賽將在台灣時間20日凌晨3點開踢，西班牙19歲超新星亞馬爾（Lamine Yamal）昨天因大腿傷勢缺席訓練，但西班牙隊主帥德拉富恩特（Luis de la Fuente）今天表示，他已經恢復正常訓練，現在「身體狀況絕佳」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147517.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:57", "link": "/news/story/123107/9635921"}, {"article_id": "9635862", "title": "世足賽／39歲梅西再戰世界盃決賽 阿根廷主帥籲球迷珍惜傳奇", "summary": "衛冕軍阿根廷週末在世界盃迎戰西班牙時將力拚蟬聯冠軍，梅西將以39歲之姿再次率隊征戰世足決賽，主帥斯卡洛尼呼籲球迷好好珍惜...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147510.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:57", "link": "/news/story/123107/9635862"}, {"article_id": "9635887", "title": "世足賽／讚「維德角驚奇」讓人感動 貝克漢：會激勵更多孩子踢足球", "summary": "前英格蘭球星貝克漢（David Beckham）近日現身紐約市賈維茨中心（Javits Center）舉行的Fanatics Fest活動，與現場大批觀眾分享自己對本屆世界盃的觀察。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147477.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:45", "link": "/news/story/123107/9635887"}, {"article_id": "9635879", "title": "MLB／超強！李灝宇9局敲致勝二壘打 一棒率老虎擊墜天使", "summary": "效力老虎隊的台灣強打李灝宇，今天直接一棒撼動勝負，第九局的二壘打將比分從0：1落後扭轉為2：1領先，幫助老虎最終就以1分差擊退天使隊。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147527.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:28", "link": "/news/story/6999/9635879"}, {"article_id": "9635869", "title": "世足賽／足球熱潮帶旺美國啤酒銷售 球迷狂歡背後仍藏市場寒冬", "summary": "2026美加墨世界盃在北美掀起足球熱潮，也意外帶動美國啤酒買氣。比賽期間，不少主辦城市的酒吧、餐廳與球場湧入大量球迷，波士頓甚至傳出有酒吧因人潮太旺，不得不緊急補貨，避免啤酒被喝到斷貨。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147429.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:23", "link": "/news/story/123107/9635869"}, {"article_id": "9635870", "title": "棒球／劉致榮留美訓練影片曝光！ 投球姿勢改變神似山本由伸", "summary": "台灣旅美火球男劉致榮近2年飽受傷勢困擾，最終在今年6月遭紅襪釋出，結束6年的合作關係，不過他並未返台投入中職季中選秀，而是選擇在美國持續訓練。昨天劉致榮在個人社群發布訓練影片，神似道奇日本王牌山本由伸的投球姿勢也引發熱議。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147432.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:18", "link": "/news/story/7001/9635870"}, {"article_id": "9635866", "title": "日職／暌違近1個月 亞運國手孫易磊重返一軍", "summary": "日職火腿隊今天作客大阪京瓷巨蛋與歐力士隊展開二連戰，賽前將21歲台灣投手孫易磊登錄一軍，是他相隔近一個月後重返一軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147452.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:14", "link": "/news/story/7001/9635866"}, {"article_id": "9635826", "title": "世足賽／季軍戰還沒開打 法國足協宣布傳奇名宿席丹接任新教頭", "summary": "法國4強戰不敵西班牙，台灣時間7月19日上午5時將與英格蘭進行季軍賽，不過在「高盧雄雞」結束世界盃征程前，自家足球協會就宣布，下任總教練將由傳奇名宿席丹（Zinedine Zidane）接任。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147367.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-18 12:04", "link": "/news/story/123107/9635826"}, {"article_id": "9635781", "title": "世足賽／ESPN預測一面倒看好西班牙奪冠 僅2人挺梅西完成二連霸", "summary": "2026年美加墨世界盃足球賽將於台灣時間20日凌晨3點迎來最終決戰，衛冕冠軍阿根廷將和睽違16年重返冠軍賽的西班牙爭奪大力神盃。賽前美媒《ESPN》邀集9名記者進行冠軍預測，結果有7人看好西班牙奪下隊史第2座世界盃冠軍，僅2人認為阿根廷能完成2連霸大業。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147291.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=945&exp=3600&sl=W&fw=360", "date": "2026-07-18 11:59", "link": "/news/story/123107/9635781"}, {"article_id": "9635822", "title": "MLB／連續飆速160封鎖洋基打線 佐佐木朗希提「下半身」重要性", "summary": "道奇日籍投手佐佐木朗希今天客場對紐約洋基，先發主投5.2局退場，繳出5安打失1分、自責分0的優質內容。雖然最終無緣勝投，但他此役飆出轉戰大聯盟後個人最快的101.8英里、約163.8公里速球，更是連續投出超過100英里的火球，賽後也對自己的狀態回升表達信心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147356.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 11:57", "link": "/news/story/6999/9635822"}, {"article_id": "9635774", "title": "世足攻略／英法大戰卸下金盃枷鎖對攻 法國體能、戰術、對戰三重剋制", "summary": "法國與英格蘭在世足季軍戰相遇，體能、戰術與心理因素讓法國在此役中佔優。法國主力無延長賽消耗，英格蘭核心疲勞，將影響比賽結果。雙方期待激烈對攻，法國有望以2:1或3:2贏得銅牌。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147296.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 11:51", "link": "/news/story/122629/9635774"}, {"article_id": "9635775", "title": "世足賽／梅西接班人對決梅西 西班牙教頭：亞馬爾只要當亞馬爾就好", "summary": "「無敵艦隊」西班牙擊敗奪冠熱門法國後，將在世界盃決賽交手衛冕軍阿根廷，其中19歲超新星前鋒亞馬爾（Lamine Yamal）與39歲球王梅西（Lionel Messi）跨世代天才球員的「澡盆之戰」更是受外界矚目的看點。對於子弟兵是否會因此感到壓力，西班牙主帥德拉富恩特（Luis de la Fuente）表示，亞馬爾只需要踢亞馬爾的足球就行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147290.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 11:35", "link": "/news/story/123107/9635775"}, {"article_id": "9635753", "title": "世足賽／決賽迎戰阿根廷 西班牙隊長預期是高強度身體對抗", "summary": "西班牙將於19日下午（台灣時間20日凌晨）在世界盃足球賽冠軍戰對決阿根廷，西班牙隊長羅德里（Rodri Hernande...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147245.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 11:22", "link": "/news/story/123107/9635753"}, {"article_id": "9635733", "title": "MLB／佐佐木朗希飆生涯最快163.8公里 火球連發狂寫道奇近18年紀錄", "summary": "洛杉磯道奇日籍投手佐佐木朗希今天在紐約客場登板先發對決洋基，繳出近期代表作，主投5.2局被敲5安打、失1分但自責分為0，另有5次三振、1次保送的內容。道奇靠著孟西（Max Muncy）在7局上轟出逆轉戰局的兩分砲，加上8局下精彩守備演出，最終以2比1拿下勝利。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147206.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 11:02", "link": "/news/story/6999/9635733"}, {"article_id": "9635737", "title": "世足賽／法國變陣換7人姆巴佩仍先發 季軍戰力拚生涯第二座金靴獎", "summary": "法國在世界盃4強不敵西班牙，無緣再闖冠軍賽，只能和英格蘭爭老三。先前就傳出由於傷病問題，總教練德尚（Didier Deschamps）可能會派出全替補做為先發，《RMC電台》近期就曝光「高盧雄雞」季軍戰的先發陣容，雖不如傳言全替補上陣，但也一口氣換7人，至於當家前鋒姆巴佩（Kylian Mbappe）仍掛帥先發，力拼金靴獎。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147223.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 11:00", "link": "/news/story/123107/9635737"}, {"article_id": "9635681", "title": "世足賽／梅西決賽前神級自拍曝光！杜蘭特掌鏡 布雷迪、約克維奇也同框", "summary": "阿根廷球星梅西（Lionel Messi）即將在2026年美加墨世界盃決賽代表阿根廷出戰西班牙，賽前他先在紐約留下話題畫面，與多名體壇傳奇和名人同框自拍，成為社群焦點。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147095.jpg&M=1&s=Y&x=0&y=149&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-18 10:38", "link": "/news/story/123107/9635681"}, {"article_id": "9635630", "title": "MLB／鄭宗哲雙重賽先發都敲安 紅襪拉出近10年最長11連勝", "summary": "紅襪隊今天與美聯龍頭光芒隊進行雙重賽，台灣內野手鄭宗哲連兩戰先發上陣，連兩場都有安打表現，紅襪也先後以10：0及5：3擊敗對手，單日兩勝，寫下隊史近10年來最長11連勝，近18場比賽拿下16勝，勝率回到5成。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147039.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-07-18 10:12", "link": "/news/story/6999/9635630"}, {"article_id": "9635584", "title": "世足賽／如何圍堵亞馬爾？ 阿根廷教頭有1計：鎖在房間", "summary": "阿根廷爭取世界盃足球賽連霸之路，冠軍賽遭逢「無敵艦隊」西班牙，如何圍堵對手陣中的19歲天才球星亞馬爾（Lamine Yamal）？阿根廷總教練斯卡洛尼（Lionel Scaloni）幽默回應：「把他鎖在他的房間吧！」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35146997.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-07-18 09:55", "link": "/news/story/123107/9635584"}]}, {"name": "2026美加墨世足", "articles": [{"article_id": "9635781", "title": "世足賽／ESPN預測一面倒看好西班牙奪冠 僅2人挺梅西完成二連霸", "date": "2026-07-18 11:59", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147291.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=945&exp=3600&w=300", "link": "/news/story/123107/9635781"}, {"article_id": "9635541", "title": "世足賽／澡盆裡的小baby如今冠軍賽交手 梅西：太不可思議", "date": "2026-07-18 09:30", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35146927.jpg&M=1&s=Y&x=0&y=35&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9635541"}, {"article_id": "9635584", "title": "世足賽／如何圍堵亞馬爾？ 阿根廷教頭有1計：鎖在房間", "date": "2026-07-18 09:55", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35146997.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9635584"}, {"article_id": "9635681", "title": "世足賽／梅西決賽前神級自拍曝光！杜蘭特掌鏡 布雷迪、約克維奇也同框", "date": "2026-07-18 10:38", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147095.jpg&M=1&s=Y&x=0&y=149&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/123107/9635681"}, {"article_id": "9635737", "title": "世足賽／法國變陣換7人姆巴佩仍先發 季軍戰力拚生涯第二座金靴獎", "date": "2026-07-18 11:00", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/18/35147223.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/123107/9635737"}]}, {"name": "世足運彩大預測", "articles": [{"article_id": "9629594", "title": "世足運彩／莊家寧給三獅軍低水也不給受讓空間 看好英格蘭正規時間不敗", "date": "2026-07-15 16:31", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/07/15/35138321.jpg&M=1&s=Y&x=159&y=0&sw=909&sh=606&exp=3600&w=300", "link": "/news/story/123105/9629594"}, {"article_id": "9629415", "title": "世足運彩／世仇英阿大戰體能極限隱憂 梅西首度對決三獅軍團Gemini看雙方和局", "date": "2026-07-15 15:32", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https:/