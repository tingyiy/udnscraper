o.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35336172.jpg&M=1&s=Y&x=0&y=17&sw=1280&sh=853&exp=3600", "link": "/news/story/7002/9760019"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9758358", "title": "2026球季7大最佳季前補強 藍鳥希斯領銜、紅襪三星齊入列", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35333742.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9758358"}, {"article_id": "9757998", "title": "沒「大物」靠團隊 U15中華隊盼突破世界盃最佳成績", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332989.jpg&M=1&s=Y&x=67&y=0&sw=1152&sh=768&exp=3600&w=300", "link": "/news/story/122629/9757998"}, {"article_id": "9756739", "title": "中職／本土奇兵崛起成亮點 富邦滿手好牌卻接連放槍", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/15/35331229.jpg&M=1&s=Y&x=0&y=73&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9756739"}, {"article_id": "9755985", "title": "「毀滅性打擊」快艇背後 NBA如何從密約事件重建公信力？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332284.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9755985"}, {"article_id": "9753748", "title": "36歲球速沒變快卻老來俏 格雷到波士頓究竟改變了什麼？", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35326825.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9753748"}, {"article_id": "9754113", "title": "中職／831後洋投都出狀況 統一、悍將卻分處天堂與地獄", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/14/35327435.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&w=300", "link": "/news/story/122629/9754113"}]}, {"name": "最新文章", "articles": [{"article_id": "9759949", "title": "亞運／中華隊訓練據點遭塗鴉 愛知警方調查", "summary": "愛知名古屋亞運開幕在即，中華隊在名古屋市的訓練據點，傳出代表團相關布條遭人塗鴉。日本警方目前已以涉嫌毀損器物方向展開調查", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35336200.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 10:31", "link": "/news/story/124981/9759949"}, {"article_id": "9760019", "title": "NBA／前勇士榜眼威斯曼、冠軍後衛布朗加盟尼克 正式球員名單5搶1", "summary": "衛冕軍尼克隊今天再度發動補強，簽下2020年勇士隊榜眼中鋒威斯曼（James Wiseman）、2023年金塊隊冠軍後衛布朗（Bruce Brown）以及26歲側翼阿巴吉（Ochai Agbaji）。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35336172.jpg&M=1&s=Y&x=0&y=17&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 10:26", "link": "/news/story/7002/9760019"}, {"article_id": "9759989", "title": "亞運男籃／準備下課？圖奇發文感謝中華隊", "summary": "2024年來台接掌中華男籃隊兵符的義大利籍總教練圖奇（Gianluca Tucci），率隊出征名古屋亞運雖晉級8強，但昨天關鍵晉級戰碰地主日本隊，最多落後22分，雖靠第四節一波15：0攻勢縮小差距，最終仍以78：85吞敗，無緣4強。圖奇今天特別在社群發文道謝，頗有「下課」告別意味。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35336094.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 10:09", "link": "/news/story/124981/9759989"}, {"article_id": "9759946", "title": "MLB／紅人克魯茲對戰6場瘋狂5轟 史奈爾傷退讓道奇輸球停在M1", "summary": "道奇隊今天進行分區封王戰，先發左投史奈爾（Blake Snell）只投1局，就因左側鼠蹊部緊繃退場，教練團啟動投手車輪戰，終場2：6不敵紅人隊，封王魔術數字停在1，想要完成國聯西區5連霸還要等一等。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35336061.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 10:00", "link": "/news/story/6999/9759946"}, {"article_id": "9759940", "title": "NBA／洛杉磯野火受災戶 瑞迪克募款助社區重建", "summary": "2025年1月，洛杉磯的太平洋帕利塞德地區遭受野火肆虐，數千名受災戶流離失所，NBA湖人隊總教練瑞迪克（JJ Redick）的住家也被燒毀，當地娛樂中心也付之一炬。本周帕利塞德舉行新娛樂中心的動土儀式，瑞迪克親自出席，他創立的「洛杉磯體育強健基金會（LA Sports Strong）」舉辦多場募款活動，幫助娛樂中心的重建。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35336076.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 09:57", "link": "/news/story/7002/9759940"}, {"article_id": "9759828", "title": "網球／WTA承認財務問題 年終賽明年搬到黃蜂主場", "summary": "網壇年終盛事WTA年終賽今年將在印地安泉舉行，明年將移師夏洛特，一連三年在NBA黃蜂隊的主場光譜中心（Spectrum Center）舉行。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335919.jpg&M=1&s=Y&x=0&y=0&sw=1278&sh=852&exp=3600&sl=W&fw=360", "date": "2026-09-17 09:05", "link": "/news/story/7005/9759828"}, {"article_id": "9759758", "title": "影／名古屋亞運代表團陸續啟程 林昀儒、李智凱等今早出發", "summary": "2026年愛知・名古屋亞運將於19日正式開幕，中華代表團最大團今（17）天一早啟程，共8支隊伍搭乘上午7時35分班機，從桃園國際機場飛往名古屋。中華奧會主席蔡家福、運動部次長洪志昌率團出發，運動部次長黃啟煌也前往機場送行，期勉選手自我挑戰、發揮實力，創造最好成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335681.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 08:09", "link": "/news/story/124981/9759758"}, {"article_id": "9759731", "title": "MLB／道奇準備迎接分區5連霸 羅伯茲證實大谷將會重返例行賽", "summary": "道奇隊在國聯西區封王魔術數字降到1，今天只要擊敗紅人隊，或是同區排名第2的教士隊不敵洛磯隊，就可完成分區5連霸，總教練羅伯茲（Dave Roberts）也透露，確實打算讓大谷翔平回到例行賽調整狀況，全力備戰季後賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335881.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 07:30", "link": "/news/story/6999/9759731"}, {"article_id": "9759717", "title": "亞運／中華代表團最大團今早啟程 8隊伍合計96人飛往名古屋", "summary": "2026年名古屋亞運將在19日開幕，本屆中華代表團最大團今天一早啟程，共8支隊伍搭乘上午7點35分的班機從桃園機場飛往名古屋，中華奧會主席蔡家福親自送行，並期勉每位選手自我挑戰、創造最好成績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335618.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 07:01", "link": "/news/story/124981/9759717"}, {"article_id": "9758358", "title": "2026球季7大最佳季前補強 藍鳥希斯領銜、紅襪三星齊入列", "summary": "2026大聯盟季前補強初步評選七大成功案例，藍鳥希斯領銜，紅襪康崔拉斯、格雷與蘇亞雷斯三人入列；希斯投出2.38防禦率。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35333742.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 07:00", "link": "/news/story/122629/9758358"}, {"article_id": "9757998", "title": "沒「大物」靠團隊 U15中華隊盼突破世界盃最佳成績", "summary": "2026年第7屆U15世界盃青少棒錦標賽將於9月25日至10月4日在墨西哥舉行，中華代表隊已經集訓一個多月，預計9月22日出發，總教練邱耀宇表示，今年團隊戰力平均，先發、板凳球員落差不大，沒有「大物」，目標突破隊史最佳成績季軍。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35332989.jpg&M=1&s=Y&x=67&y=0&sw=1152&sh=768&exp=3600&sl=W&fw=360", "date": "2026-09-17 07:00", "link": "/news/story/122629/9757998"}, {"article_id": "9759711", "title": "亞運桌球／林昀儒征戰名古屋成桌球隊老大哥 透露賽後最想嚐鰻魚飯", "summary": "我國「桌球一哥」林昀儒今天隨代表團啟程前往日本名古屋為亞運進行最後備戰，雖然日本對他而言並不陌生，但他也透露是初次造訪名古屋，直言感覺相當新鮮，希望能有好的發揮。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335609.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 06:57", "link": "/news/story/124981/9759711"}, {"article_id": "9759710", "title": "MLB／「法官」復出9天又出問題 洋基延長13局遭雙城再見安打", "summary": "「法官」賈吉（Aaron Judge）今天對雙城隊之戰吞下兩次三振，6局上因為右小腿緊繃提前退場，洋基隊拚到延長13局被卡拉提尼（Victor Caratini）揮出再見安打，終場以4：5落敗，未能完成客場3連勝橫掃。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335610.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 06:56", "link": "/news/story/6999/9759710"}, {"article_id": "9759709", "title": "亞運體操／雙星領軍出擊 李智凱、唐嘉鴻啟程名古屋尋求突破", "summary": "名古屋亞運即將在19日開幕，我國體操代表隊今天隨代表團大團齊聚機場啟程，今年在「世界貓王」唐嘉鴻與「鞍馬王子」李智凱領軍下，體操隊也將放眼頒獎台，兩人皆坦言極為期待團隊凝聚力，盼能帶著學弟妹一舉衝出佳績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335608.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-17 06:55", "link": "/news/story/124981/9759709"}, {"article_id": "9759665", "title": "MLB／李灝宇4支0遭薛則解決3次 還有最後10戰拚二位數全壘打", "summary": "旅美好手李灝宇昨天追平張育成單季9轟紀錄，今天再戰藍鳥隊4次打數沒有安打，吞下1次三振，老虎隊終場以1：5落敗，未能在多倫多完成3連戰橫掃，也終止最近6連勝紀錄。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/17/35335566.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-17 06:01", "link": "/news/story/6999/9759665"}, {"article_id": "9759274", "title": "中職／林岱安單場2長打轉隊首轟炸裂 悍將6：0完封龍隊終止4連敗", "summary": "富邦悍將隊昨天在主場遭味全龍隊完封後，今天前進天母棒球場再次交手，主戰捕手戴培峰在觸身球風波後休兵，今天由林岱安先發蹲捕，單場2支長打包括本季首轟，終場悍將以6：0完封龍隊，終止近期4連敗；龍隊則是近6戰吞5敗，下半季勝率跌破5成。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35335175.jpg&M=1&s=Y&x=0&y=0&sw=1241&sh=827&exp=3600&sl=W&fw=360", "date": "2026-09-16 21:59", "link": "/news/story/7001/9759274"}, {"article_id": "9759105", "title": "亞運男籃／陳盈駿燃燒不夠 中華隊7分不敵日本無緣4強", "summary": "名古屋亞運闖進男籃8強的中華隊，今天8強壓軸戰出戰地主日本隊，首節進攻熄火僅拿9分，半場打完陷入32：44劣勢，第四節最多更落後達21分，雖以一波15：0強攻回到比賽，無奈讀秒階段追到6分差仍沒能逆轉，最終以78：85吞敗，無緣晉級4強。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35334926.jpg&M=1&s=Y&x=0&y=0&sw=1279&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 20:19", "link": "/news/story/124981/9759105"}, {"article_id": "9759057", "title": "亞運排球／中華女排強攻狂轟 預賽首戰直落3輕取吉爾吉斯", "summary": "名古屋亞運女子排球今天進行預賽首日賽事，中華女排對上實力有段差距的吉爾吉斯，輕鬆以25比14、25比15、25比9直落3...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/2023/10/04/1/25810611.jpg&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 20:17", "link": "/news/story/124981/9759057"}, {"article_id": "9759011", "title": "籃球／歐妮回來了！李亨淑暌違10年返台飯局被約滿", "summary": "曾為台灣籃球奉獻23年的韓國奧運銀牌「歐妮」李亨淑，10年來首度重返台灣，她以助理教練身分率濟源一中參加2026興富發登峰造極青年籃球邀請賽，今天更拋開昨天遭到北一女中「準絕殺」的陰霾，以83：68大勝永仁高中，保住4強希望。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35334826.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-09-16 19:21", "link": "/news/story/7003/9759011"}, {"article_id": "9759002", "title": "亞運男籃／第一節僅拿9分 中華隊8強賽半場落後日本12分", "summary": "名古屋亞運闖進男籃8強的中華隊，今天8強壓軸戰出戰地主日本隊，中華隊首節進攻熄火僅拿9分，半場打完陷入32：44落後。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/09/16/35334821.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-09-16 19:14", "link": "/news/story/124981/975900