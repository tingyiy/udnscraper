php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245493.jpg&M=1&s=Y&x=0&y=146&sw=1182&sh=788&exp=3600", "link": "/news/story/7001/9702146"}, {"article_id": "9702207", "title": "中職／劉時豪驚天3分砲助雄鷹逆轉勝 陳鏞基台東告別戰2打點謝幕", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245568.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600", "link": "/news/story/7001/9702207"}], "subsections": [{"name": "專欄", "articles": [{"article_id": "9701544", "title": "山本由伸投球策略改變依舊強 不求三振只求出局投更長", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35244967.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9701544"}, {"article_id": "9701580", "title": "投手沒王牌靠打擊 中華隊征戰女棒世界盃分組賽大解析", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35244804.jpg&M=1&s=Y&x=67&y=0&sw=1183&sh=789&exp=3600&w=300", "link": "/news/story/122629/9701580"}, {"article_id": "9699688", "title": "中職／用了才知本土投手的好 桃猿成最大贏家", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/18/35241874.png&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&w=300", "link": "/news/story/122629/9699688"}, {"article_id": "9696645", "title": "台灣野手站穩大聯盟已非問號 李灝宇驚奇球季有新課題", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237780.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&w=300", "link": "/news/story/122629/9696645"}, {"article_id": "9696801", "title": "日職／一軍表現佳、成正式球員 孫易磊等小將本季已收穫滿滿", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35237990.jpg&M=1&s=Y&x=0&y=0&sw=929&sh=619&exp=3600&w=300", "link": "/news/story/122629/9696801"}, {"article_id": "9696821", "title": "高國豪圈粉！瓊斯盃是台灣籃壇世紀資產 不是世代悲歌", "date": "", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/17/35238035.jpg&M=1&s=Y&x=0&y=0&sw=1276&sh=851&exp=3600&w=300", "link": "/news/story/122629/9696821"}]}, {"name": "最新文章", "articles": [{"article_id": "9702898", "title": "瓊斯盃／中華藍分組墊底仍晉4強惹議 籃協道歉了", "summary": "第45屆威廉瓊斯盃籃球邀請賽分組循環賽已近尾聲，中華藍隊目前5戰打完只拿1勝，分組名次墊底，但因「保障名額」仍能晉級4強，引發外界與球迷間對於本屆賽制諸多討論。中華籃球協會早上發出聲明，對於賽制改變造成各方熱議表達歉意，未來將持續改進瓊斯盃賽程編排方案，符合球迷期待也讓來訪的國外球隊享受比賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246435.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:30", "link": "/news/story/7003/9702898"}, {"article_id": "9702856", "title": "MLB／道奇終結者正式換人！羅伯茲盛讚史考特擁有「超能力」", "summary": "隨著道奇終結者迪亞茲（Edwin Diaz）因頸部發炎進入15天傷兵名單，道奇季末衝刺階段的終結者人選也正式出現變化。總教練羅伯茲（Dave Roberts）今日明確表示，以目前的投球狀態來看，史考特（Tanner Scott）就是球隊現階段最好的後援投手，並將他定位為道奇終結者。甚至認為史考特擁有真正的「超能力」。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246313.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:23", "link": "/news/story/6999/9702856"}, {"article_id": "9702840", "title": "MLB／道奇狄亞茲MRI結果出爐！羅伯茲透露：最理想的情況", "summary": "道奇終結者迪亞茲（Edwin Diaz）昨日因頸部發炎被放進傷兵名單，考量到他本季已多次受到傷勢影響，加上近期投球狀況持續低迷，一度讓外界擔心是否又出現更嚴重的身體問題。不過今日檢查結果出爐，總教練羅伯茲（Dave Roberts）也終於帶來好消息。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246270.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:18", "link": "/news/story/6999/9702840"}, {"article_id": "9702836", "title": "NBA／金塊沒留住替補悍將！華森5隊交易案轉戰騎士", "summary": "騎士、金塊和快艇隊達成交易協議，華森（Peyton Watson）將從金塊被送去騎士，史特魯斯（Max Strus）從騎士轉戰快艇，這筆交易還包括巫師隊和國王隊，是一筆牽涉5隊的交易案。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246274.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 10:06", "link": "/news/story/7002/9702836"}, {"article_id": "9702798", "title": "NBA／沒想到那麼快！22歲溫班亞瑪接法國隊長", "summary": "雖只有22歲，馬刺隊長人溫班亞瑪（Victor Wembanyama）已經展現領袖氣息，他的領導力也將延續到法國國家隊，以隊長身分率隊出征FIBA世界盃的歐洲區資格賽。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246233.jpg&M=1&s=Y&x=0&y=39&sw=820&sh=547&exp=3600&sl=W&fw=360", "date": "2026-08-20 09:53", "link": "/news/story/7002/9702798"}, {"article_id": "9702665", "title": "MLB／跑打守俱佳！李灝宇對決海盜王牌史肯斯敲安 三度上壘跑回2分", "summary": "老虎隊前進匹茲堡對決海盜隊3連戰最後一場比賽，台灣內野手李灝宇先發上陣，對決海盜塞揚強投史肯斯（Paul Skenes）首打席就敲安，單場還選到2次保送上壘、跑回2分，跑、打、守都有好表現，但終場海盜以3：4遭逆轉吞敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246036.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 08:31", "link": "/news/story/6999/9702665"}, {"article_id": "9702610", "title": "MLB／李灝宇對賽揚強投史肯斯敲安、積極跑壘 惜老虎遭逆轉", "summary": "台灣好手李灝宇今天面對美國職棒頂級強投、去年賽揚獎得主史肯斯，不僅敲出安打，更展現積極的跑壘態度，為球隊貢獻分數。可惜李...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246220.jpg&M=1&s=Y&x=0&y=0&sw=1230&sh=820&exp=3600&sl=W&fw=360", "date": "2026-08-20 08:03", "link": "/news/story/6999/9702610"}, {"article_id": "9701544", "title": "山本由伸投球策略改變依舊強 不求三振只求出局投更長", "summary": "你有沒有發現山本由伸今年三振變少了？他的三振率由去年的10.4下滑到8.4，但這並不代表他的投球能力下滑，因為他的防禦率仍為國聯第5的2.60，WHIP更是高居全聯盟第2的0.89。他不求三振只求出局的投球策略反而讓他用球數更精簡、投得更長，依舊是大聯盟頂尖的王牌投手。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35244967.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-20 07:00", "link": "/news/story/122629/9701544"}, {"article_id": "9701580", "title": "投手沒王牌靠打擊 中華隊征戰女棒世界盃分組賽大解析", "summary": "2026女棒世界盃台南分組賽8月23日開打，中華隊投手缺王牌，將靠打擊與車輪戰搶勝，力拚前三戰全勝爭取晉級。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35244804.jpg&M=1&s=Y&x=67&y=0&sw=1183&sh=789&exp=3600&sl=W&fw=360", "date": "2026-08-20 07:00", "link": "/news/story/122629/9701580"}, {"article_id": "9702504", "title": "羽球世錦賽／美國羽球新星陳翝櫟爆冷晉級 家族與台灣淵源偶赴台訓練", "summary": "美國18歲羽球男單新星陳翝櫟（Garret Tan）今天在印度新德里舉行的世界羽球錦標賽中，爆冷擊敗印度好手森恩，讓主場...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/20/35246033.jpg&M=1&s=Y&x=317&y=148&sw=768&sh=512&exp=3600&sl=W&fw=360", "date": "2026-08-20 03:16", "link": "/news/story/7005/9702504"}, {"article_id": "9702207", "title": "中職／劉時豪驚天3分砲助雄鷹逆轉勝 陳鏞基台東告別戰2打點謝幕", "summary": "「台灣轟炸機」陳鏞基生涯在家鄉台東的最後一場出賽，所屬的統一獅隊兩度領先都沒能守成；台鋼雄鷹在8局下靠著捕手劉時豪轟出驚天3分砲一棒逆轉，終場以8：6擊敗獅隊，終止主場6連敗。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245568.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 22:25", "link": "/news/story/7001/9702207"}, {"article_id": "9702185", "title": "瓊斯盃／中華藍慘輸日本小組墊底 保障名額照進4強", "summary": "中華藍今天瓊斯盃碰日本隊，上半場靠宋昕澔投進壓哨三分球才將差距咬在10分，但第三節被日本打出20：8的單節攻勢，領先徹底拉開，最終中華藍以62：90慘敗，1勝4敗戰績落到A組最後一位。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245531.jpg&M=1&s=Y&x=0&y=102&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 22:06", "link": "/news/story/7003/9702185"}, {"article_id": "9702146", "title": "中職／岳政華逆轉3分彈大巨蛋留名 兄弟屠龍下半季勝率爬上5成", "summary": "中信兄弟本周首場賽事，今天前進台北大巨蛋作客，面對下半季戰績領先的味全龍隊，羅戈先發7局失2分屠龍，並靠岳政華在6局上轟出逆轉3分彈，終場兄弟以6：2勝出，下半季戰績14勝14敗，勝率爬上5成。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245493.jpg&M=1&s=Y&x=0&y=146&sw=1182&sh=788&exp=3600&sl=W&fw=360", "date": "2026-08-19 21:41", "link": "/news/story/7001/9702146"}, {"article_id": "9702128", "title": "瓊斯盃／不只當200公分射手 陳子威對劉耕灝有更高期待", "summary": "中華白今天拉鋸戰以69：74敗給約旦，不過旅美長人劉耕灝成比賽亮點，第二節投進3記三分球、單節攻下13分，第四節連飆外線更助隊一度超前，未來性備受教練陳子威期待。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245473.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-19 21:32", "link": "/news/story/7003/9702128"}, {"article_id": "9702109", "title": "舉重／第二屆原住民族舉重賽高雄圓滿落幕 高展宏教練選手雙重身分膝傷後重逐奧運夢", "summary": "第二屆原住民族舉重錦標賽在高雄落幕，吸引49個單位、170名選手參賽；東京奧運國手高展宏勇奪男子65公斤級冠軍，傷後重返國家隊，續逐奧運夢。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245464.jpg&M=1&s=Y&x=0&y=0&sw=1051&sh=701&exp=3600&sl=W&fw=360", "date": "2026-08-19 21:21", "link": "/news/story/7227/9702109"}, {"article_id": "9702082", "title": "瓊斯盃／落敗後球員自主開會 陳子威喊感動", "summary": "中華白沒能延續瓊斯盃第一輪擊敗約旦的氣勢，今天拉鋸戰在籃板落後10顆下以69：74吞敗，教練陳子威強調「輸球是教練責任」，肯定球員的拚勁和態度，尤其肯定球員賽後自主開會，展現出對勝負的企圖心。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245421.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-19 20:40", "link": "/news/story/7003/9702082"}, {"article_id": "9702078", "title": "亞運體操／熬過課業、訓練兩頭燒的日子 丁華恬衝刺期卻受傷重調步調", "summary": "「體操精靈」丁華恬結束去年課業、訓練兩頭燒的日子，今年回到國訓中心專心備戰9月登場的愛知・名古屋亞運，卻在7月訓練時不慎受傷造成韌帶撕裂，如今已逐漸恢復練習，期許能在亞運前做好準備，再寫佳績。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245467.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 20:36", "link": "/news/story/124981/9702078"}, {"article_id": "9702015", "title": "中職／WBC澳洲投手杰克到兄弟一軍隨隊 盼再遇陳傑憲", "summary": "世界棒球經典賽（WBC）澳洲隊左投杰克與中信兄弟隊一軍會合，在洋將大限前隨隊待命，他希望有機會再次見到台灣隊長陳傑憲，好...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245414.jpg&M=1&s=Y&x=0&y=85&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 20:35", "link": "/news/story/7001/9702015"}, {"article_id": "9701975", "title": "瓊斯盃／劉耕灝打出代表作 沒能助中華白再贏約旦", "summary": "中華白今天瓊斯盃第5日賽程和約旦隊上演激戰，中華白旅外小將劉耕灝飆進5記三分球在內的24分，打出瓊斯盃代表作，可惜第四節團隊陷入將近4分鐘的得分荒，最終以69：74敗給約旦，想闖4強明天碰馬來西亞非勝不可。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245341.jpg&M=1&s=Y&x=0&y=171&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-19 19:52", "link": "/news/story/7003/9701975"}, {"article_id": "9701891", "title": "中職／和田毅觀察台灣棒球轉變 已是日本難擊敗隊伍", "summary": "日本職棒福岡軟銀鷹隊傳奇左投和田毅來台，生涯曾在國際賽場參與多次台日大戰的他認為，台灣選手實力逐漸提升，「現在對日本來說...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245286.jpg&M=1&s=Y&x=0&y=97&sw=1280&sh=854&exp=3600&sl=W&fw=360", "date": "2026-08-19 19:26", "link": "/news/story/7001/9701891"}, {"article_id": "9701917", "title": "中職／黃暐傑重返龍隊一軍先發 葉總思考季後賽角色", "summary": "中華職棒味全龍隊投手黃暐傑今在一軍隨隊，備戰預定的週末先發，不過之後可能轉戰後援，總教練葉君璋透露，主要是考量到季後賽", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245285.jpg&M=1&s=Y&x=0&y=64&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 19:25", "link": "/news/story/7001/9701917"}, {"article_id": "9701865", "title": "亞運女壘／重返國家隊再拚亞運金牌 隊長沈嘉玟：準備好對抗其他國家", "summary": "中華女壘在上屆杭州亞運無緣無緣爭金、銅牌作收，本屆名古屋亞運捲土重來，陣容與上屆相差不大，多添幾位新秀補強戰力，沈嘉玟重返國家隊並接任隊長，她說：「我們已經準備好對抗其他國家。」", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245202.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 18:38", "link": "/news/story/124981/9701865"}, {"article_id": "9701766", "title": "亞運射箭／反曲弓添新血 鄭祥輝「大心臟」扛第3棒沒在怕", "summary": "名古屋亞運射箭反曲弓代表隊今年參賽陣容添新血，男子隊包括鄭祥輝、林子翔都是首度參賽，女子隊則是3人都迎接亞運初體驗，其中最年輕的則是曾被封「最強高中生」的18歲女將許芯慈。", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245071.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 17:44", "link": "/news/story/124981/9701766"}, {"article_id": "9701587", "title": "亞運射箭／李彩綺拚站頒獎台 教練承諾奪牌跑10公里", "summary": "名古屋亞運射箭反曲弓代表隊今年捲土重來，女子隊由年輕陣容組軍，其中21歲的李彩綺在訓練之餘熱愛路跑，她的教練徐梓益更約定...", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245014.jpg&M=1&s=Y&x=0&y=0&sw=1280&sh=853&exp=3600&sl=W&fw=360", "date": "2026-08-19 17:31", "link": "/news/story/124981/9701587"}]}, {"name": "棒球", "articles": [{"article_id": "9702146", "title": "中職／岳政華逆轉3分彈大巨蛋留名 兄弟屠龍下半季勝率爬上5成", "date": "2026-08-19 21:41", "thumbnail": "https://pgw.udn.com.tw/gw/photo.php?u=https://uc.udn.com.tw/photo/t3/2026/08/19/35245493.jpg&M=1&s=Y&x=0&y=146&sw=1182&sh=788&exp=3600&w=300", "link": "/news/story/7001/9702146"}, {"ar